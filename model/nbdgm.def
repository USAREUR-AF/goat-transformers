# The nbdgm module: NetBIOS Datagram Service fields (RFC 1002 section 4.4). Written by tools/gen/dirnaming-pack.py.
module        nbdgm
version       0.1.0
distribution  public
source        "IETF RFC 1002, Protocol Standard for a NetBIOS Service on a TCP/UDP Transport: Detailed Specifications, March 1987, sections 4.1, 4.2.1, 4.2.18 and 4.4, https://www.rfc-editor.org/rfc/rfc1002.txt; layouts restated"
key   msg_type                 int     -  "message type: 0x10 direct unique, 0x11 direct group, 0x12 broadcast, 0x13 error, 0x14 query request, 0x15 positive and 0x16 negative query response"
key   reserved                 int     -  "the four reserved flag bits, 0"
key   source_node_type         int     -  "SNT: 0 B node, 1 P node, 2 M node, 3 NBDD"
key   first                    int     -  "F: the first (and possibly only) fragment"
key   more                     int     -  "M: more fragments follow"
key   dgm_id                   int     -  "datagram ID"
key   source_ip                int     -  "source IPv4 address, as an unsigned 32-bit integer"
key   source_port              int     -  "source UDP port"
key   dgm_length               int     -  "datagram length, as sent (not computed)"
key   packet_offset            int     -  "packet offset of this fragment, as sent"
key   error_code               int     -  "error packet: 0x82 destination name not present, 0x83 invalid source name format, 0x84 invalid destination name format"
list  user_data                "the user data, as octets"
key   octet                    int     -  "one octet"
key   source_name_t1           int     -  "source name, label 1: tag, 0 a label"
key   source_name_len1         int     -  "source name, label 1: length in octets (0 ends the name)"
key   source_name_label1       string  -  "source name, label 1: its characters (the first label is the NetBIOS name in first-level encoding: 32 letters A to P, two per octet of the name)"
key   source_name_t2           int     -  "source name, label 2: tag, 0 a label"
key   source_name_len2         int     -  "source name, label 2: length in octets (0 ends the name)"
key   source_name_label2       string  -  "source name, label 2: its characters (scope)"
key   source_name_t3           int     -  "source name, label 3: tag, 0 a label"
key   source_name_len3         int     -  "source name, label 3: length in octets (0 ends the name)"
key   source_name_label3       string  -  "source name, label 3: its characters (scope)"
key   source_name_t4           int     -  "source name, label 4: tag, 0 a label"
key   source_name_len4         int     -  "source name, label 4: length in octets (0 ends the name)"
key   source_name_label4       string  -  "source name, label 4: its characters (scope)"
key   source_name_t5           int     -  "source name, label 5: tag, 0 a label"
key   source_name_len5         int     -  "source name, label 5: length in octets (0 ends the name)"
key   destination_name_t1      int     -  "destination name, label 1: tag, 0 a label"
key   destination_name_len1    int     -  "destination name, label 1: length in octets (0 ends the name)"
key   destination_name_label1  string  -  "destination name, label 1: its characters (the first label is the NetBIOS name in first-level encoding: 32 letters A to P, two per octet of the name)"
key   destination_name_t2      int     -  "destination name, label 2: tag, 0 a label"
key   destination_name_len2    int     -  "destination name, label 2: length in octets (0 ends the name)"
key   destination_name_label2  string  -  "destination name, label 2: its characters (scope)"
key   destination_name_t3      int     -  "destination name, label 3: tag, 0 a label"
key   destination_name_len3    int     -  "destination name, label 3: length in octets (0 ends the name)"
key   destination_name_label3  string  -  "destination name, label 3: its characters (scope)"
key   destination_name_t4      int     -  "destination name, label 4: tag, 0 a label"
key   destination_name_len4    int     -  "destination name, label 4: length in octets (0 ends the name)"
key   destination_name_label4  string  -  "destination name, label 4: its characters (scope)"
key   destination_name_t5      int     -  "destination name, label 5: tag, 0 a label"
key   destination_name_len5    int     -  "destination name, label 5: length in octets (0 ends the name)"
