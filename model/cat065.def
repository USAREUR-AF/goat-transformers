# The cat065 module: the values of ASTERIX Category 065 (SDPS Service Status Reports), edition 1.6,
# as the category holds them. Used by the pack `asterix-cat065`. Generated by
# tools/gen/asterix2pack.py; do not edit by hand. A key is named after its item
# and subitems; a repetitive item is a list and its keys are the keys of one
# repetition.
module        cat065
version       0.1.0
distribution  public
source        "ASTERIX Category 065, SDPS Service Status Reports, edition 1.6 (2023-03-21), as transcribed in github.com/zoranbosnjak/asterix-specs (BSD-3-Clause), commit 64e9ffba964b92a1af3157bc6bdf7852a63bf700, specs/cat065/cats/cat1.6/definition.json. The category is specified by EUROCONTROL"
key   i010_sac   int     -       "I065/010/SAC: System Area Code (Data Source Identifier)"
key   i010_sic   int     -       "I065/010/SIC: System Identification Code (Data Source Identifier)"
key   i000       int     -       "I065/000: Message Type. 1 = SDPS Status, 2 = End of Batch, 3 = Service Status Report"
key   i015       int     -       "I065/015: Service Identification"
key   i030       float   s       "I065/030: Time of Message. LSB 1/128 s"
key   i020       int     -       "I065/020: Batch Number"
key   i040_nogo  int     -       "I065/040/NOGO (SDPS Configuration and Status). 0 = Operational, 1 = Degraded, 2 = Not currently connected, 3 = Unknown"
key   i040_ovl   int     -       "I065/040/OVL (SDPS Configuration and Status). 0 = Default, 1 = Overload"
key   i040_tsv   int     -       "I065/040/TSV (SDPS Configuration and Status). 0 = Default, 1 = Invalid Time Source"
key   i040_pss   int     -       "I065/040/PSS: Processing System Status (SDPS Configuration and Status). 0 = Not applicable, 1 = SDPS-1 selected, 2 = SDPS-2 selected, 3 = SDPS-3 selected"
key   i040_sttn  int     -       "I065/040/STTN: Track Re-numbering Indication (SDPS Configuration and Status)"
key   i050       int     -       "I065/050: Service Status Report. 1 = Service degradation, 2 = Service degradation ended, 3 = Main radar out of service, 4 = Service interrupted by the operator, 5 = Service interrupted due to contingency, 6 = Ready for service restart after contingency, 7 = Service ended by the operator, 8 = Failure of user main radar, 9 = Service restarted by the operator, 10 = Main radar becoming operational,..."
