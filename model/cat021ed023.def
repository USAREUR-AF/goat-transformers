# The cat021ed023 module: the values of ASTERIX Category 021 (ADS-B Target Reports), edition 0.23,
# as the category holds them. Used by the pack `asterix-cat021-ed023`. Generated by
# tools/gen/asterix2pack.py; do not edit by hand. A key is named after its item
# and subitems; a repetitive item is a list and its keys are the keys of one
# repetition.
module        cat021ed023
version       0.1.0
distribution  public
source        "ASTERIX Category 021, ADS-B Target Reports, edition 0.23 (2003-11-01), as transcribed in github.com/zoranbosnjak/asterix-specs (BSD-3-Clause), commit 64e9ffba964b92a1af3157bc6bdf7852a63bf700, specs/cat021/cats/cat0.23/definition.json. The category is specified by EUROCONTROL"
key   i010_sac       int     -       "I021/010/SAC: System Area Code (Data Source Identification)"
key   i010_sic       int     -       "I021/010/SIC: System Identification Code (Data Source Identification)"
key   i040_dcr       int     -       "I021/040/DCR: Differential Correction (Target Report Descriptor). 0 = No differential correction (ADS-B), 1 = Differential correction (ADS-B)"
key   i040_gbs       int     -       "I021/040/GBS: Ground Bit Setting (Target Report Descriptor). 0 = Ground Bit not set, 1 = Ground Bit set"
key   i040_sim       int     -       "I021/040/SIM: Simulated Target (Target Report Descriptor). 0 = Actual target report, 1 = Simulated target report"
key   i040_tst       int     -       "I021/040/TST: Test Target (Target Report Descriptor). 0 = Default, 1 = Test Target"
key   i040_rab       int     -       "I021/040/RAB: Report Type (Target Report Descriptor). 0 = Report from target transponder, 1 = Report from field monitor (fixed transponder)"
key   i040_saa       int     -       "I021/040/SAA: Selected Altitude Available (Target Report Descriptor). 0 = Equipment capable to provide Selected Altitude, 1 = Equipment not capable to provide Selected Altitude"
key   i040_spi       int     -       "I021/040/SPI: Special Position Identification (Target Report Descriptor). 0 = Absence of SPI, 1 = Special Position Identification"
key   i040_atp       int     -       "I021/040/ATP: Address Type (Target Report Descriptor). 0 = Non unique address, 1 = 24-Bit ICAO address, 2 = Surface vehicle address, 3 = Anonymous address, 4 = Reserved for future use, 5 = Reserved for future use, 6 = Reserved for future use, 7 = Reserved for future use"
key   i040_arc       int     -       "I021/040/ARC: Altitude Reporting Capability (Target Report Descriptor). 0 = Unknown, 1 = 25 ft, 2 = 100 ft"
key   i030           float   s       "I021/030: Time of Day. LSB 1/128 s"
key   i130_lat       float   deg     "I021/130/LAT: Latitude (Position in WGS-84 Co-ordinates). LSB 45/2097152 deg"
key   i130_lon       float   deg     "I021/130/LON: Longitude (Position in WGS-84 Co-ordinates). LSB 45/2097152 deg"
key   i080           int     -       "I021/080: Target Address"
key   i090_ac        int     -       "I021/090/AC: ACAS Capabilities (Figure of Merit). 0 = Unknown, 1 = ACAS not operational, 2 = ACAS operartional, 3 = Invalid"
key   i090_mn        int     -       "I021/090/MN: Multiple Navigation Aids (Figure of Merit). 0 = Unknown, 1 = Multiple Navigation not operational, 2 = Multiple Navigation operartional, 3 = Invalid"
key   i090_dc        int     -       "I021/090/DC: Differential Correction (Figure of Merit). 0 = Unknown, 1 = Differential Correction, 2 = NO Differential Correction, 3 = Invalid"
key   i090_pa        float   -       "I021/090/PA: Position Accuracy (Figure of Merit). LSB 1"
key   i210_dti       int     -       "I021/210/DTI: Cockpit Display of Traffic Information (Link Technology Indicator). 0 = Unknown, 1 = Aircraft equiped with CDTI"
key   i210_mds       int     -       "I021/210/MDS: Mode-S Extended Squitter (Link Technology Indicator). 0 = Not used, 1 = Used"
key   i210_uat       int     -       "I021/210/UAT: UAT (Link Technology Indicator). 0 = Not used, 1 = Used"
key   i210_vdl       int     -       "I021/210/VDL: VDL Mode 4 (Link Technology Indicator). 0 = Not used, 1 = Used"
key   i210_otr       int     -       "I021/210/OTR: Other Technology (Link Technology Indicator). 0 = Not used, 1 = Used"
key   i230           float   deg     "I021/230: Roll Angle. LSB 1/100 deg"
key   i145           float   FL      "I021/145: Flight Level. LSB 1/4 FL"
key   i150_im        int     -       "I021/150/IM (Air Speed). 0 = Air Speed = IAS, LSB (Bit-1) = 2 -14 NM/s, 1 = Air Speed = Mach, LSB (Bit-1) = 0.001"
key   i150_as        int     -       "I021/150/AS: Air Speed (IAS or Mach) (Air Speed). raw value; its content depends on the value of 150/IM"
key   i151           float   kt      "I021/151: True Airspeed. LSB 1 kt"
key   i152           float   deg     "I021/152: Magnetic Heading. LSB 45/8192 deg"
key   i155           float   ft/min  "I021/155: Barometric Vertical Rate. LSB 25/4 ft/min"
key   i157           float   ft/min  "I021/157: Geometric Vertical Rate. LSB 25/4 ft/min"
key   i160_gs        float   NM/s    "I021/160/GS: Ground Speed in Two's Complement Form Referenced to WGS84 (Ground Vector). LSB 1/16384 NM/s"
key   i160_ta        float   deg     "I021/160/TA: Track Angle (Ground Vector). LSB 45/8192 deg"
key   i165_ti        int     -       "I021/165/TI: Turn Indicator (Rate Of Turn). 0 = Not available, 1 = Left, 2 = Right, 3 = Straight"
key   i165_rot       float   deg/s   "I021/165/ROT: Rate of Turn (Rate Of Turn). LSB 1/4 deg/s"
key   i170           int     -       "I021/170: Target Identification. raw value: 8 characters of 6 bits each in the ICAO character set (ICAO Annex 10)"
key   i095           int     -       "I021/095: Velocity Accuracy"
key   i032           float   s       "I021/032: Time of Day Accuracy. LSB 1/256 s"
key   i200           int     -       "I021/200: Target Status. 0 = No emergency / not reported, 1 = General emergency, 2 = Lifeguard / medical, 3 = Minimum fuel, 4 = No communications, 5 = Unlawful interference"
key   i020           int     -       "I021/020: Emitter Category. 1 = Light aircraft <= 7000 kg, 2 = Reserved, 3 = 7000 kg < Medium aircraft < 136000 kg, 4 = Reserved, 5 = 136000 kg <= Heavy aircraft, 6 = Highly manoeuvrable (5g acceleration capability) and high speed (>400 knots cruise), 7 = Reserved, 8 = Reserved, 9 = Reserved, 10 = Rotocraft, 11 = Glider / sailplane, 12 = Lighter-than-air, 13 = Unmanned aerial vehicle, 14 = Spac..."
key   i220_ws        float   kt      "I021/220/WS: Wind Speed (Met Information). LSB 1 kt"
key   i220_wd        float   deg     "I021/220/WD: Wind Direction (Met Information). LSB 1 deg"
key   i220_tmp       float   degC    "I021/220/TMP: Temperature (Met Information). LSB 1/4 degC"
key   i220_trb       int     -       "I021/220/TRB: Turbulence (Met Information)"
key   i146_sas       int     -       "I021/146/SAS: Source Availability (Intermediate State Selected Altitude). 0 = No source information provided, 1 = Source Information provided"
key   i146_src       int     -       "I021/146/SRC: Source (Intermediate State Selected Altitude). 0 = Unknown, 1 = Aircraft Altitude (Holding Altitude), 2 = MCP/FCU Selected Altitude, 3 = FMS Selected Altitude"
key   i146_alt       float   ft      "I021/146/ALT: Altitude (Intermediate State Selected Altitude). LSB 25 ft"
key   i148_mv        int     -       "I021/148/MV: Manage Vertical Mode (Final State Selected Altitude). 0 = Not active, 1 = Active"
key   i148_ah        int     -       "I021/148/AH: Altitude Hold Mode (Final State Selected Altitude). 0 = Not active, 1 = Active"
key   i148_am        int     -       "I021/148/AM: Approach Mode (Final State Selected Altitude). 0 = Not active, 1 = Active"
key   i148_alt       float   ft      "I021/148/ALT: Altitude (Final State Selected Altitude). LSB 25 ft"
key   i110_tis_nav   int     -       "I021/110/TIS/NAV: Trajectory Intent Status (Trajectory Intent). 0 = Trajectory Intent Data is available for this aircraft, 1 = Trajectory Intent Data is not available for this aircraft"
key   i110_tis_nvb   int     -       "I021/110/TIS/NVB: Trajectory Intent Status (Trajectory Intent). 0 = Trajectory Intent Data is valid, 1 = Trajectory Intent Data is not valid"
list  i110_tid       "I021/110/TID: Trajectory Intent Data, one item per repetition"
key   i110_tid_tca   int     -       "I021/110/TID/TCA: Trajectory Intent Data (Trajectory Intent). 0 = TCP number available, 1 = TCP number not available"
key   i110_tid_nc    int     -       "I021/110/TID/NC: Trajectory Intent Data (Trajectory Intent). 0 = TCP compliance, 1 = TCP non-compliance"
key   i110_tid_tcpn  int     -       "I021/110/TID/TCPN: Trajectory Intent Data (Trajectory Intent)"
key   i110_tid_alt   float   ft      "I021/110/TID/ALT: Trajectory Intent Data; Altitude in Two's Complement Form (Trajectory Intent). LSB 10 ft"
key   i110_tid_lat   float   deg     "I021/110/TID/LAT: Trajectory Intent Data; In WGS.84 in Two's Complement (Trajectory Intent). LSB 45/2097152 deg"
key   i110_tid_lon   float   deg     "I021/110/TID/LON: Trajectory Intent Data; In WGS.84 in Two's Complement (Trajectory Intent). LSB 45/2097152 deg"
key   i110_tid_pt    int     -       "I021/110/TID/PT: Trajectory Intent Data; Point Type (Trajectory Intent). 0 = Unknown, 1 = Fly by waypoint (LT), 2 = Fly over waypoint (LT), 3 = Hold pattern (LT), 4 = Procedure hold (LT), 5 = Procedure turn (LT), 6 = RF leg (LT), 7 = Top of climb (VT), 8 = Top of descent (VT), 9 = Start of level (VT), 10 = Cross-over altitude (VT), 11 = Transition altitude (VT)"
key   i110_tid_td    int     -       "I021/110/TID/TD: Trajectory Intent Data (Trajectory Intent). 0 = N/A, 1 = Turn right, 2 = Turn left, 3 = No turn"
key   i110_tid_tra   int     -       "I021/110/TID/TRA: Trajectory Intent Data (Trajectory Intent). 0 = TTR not available, 1 = TTR available"
key   i110_tid_toa   int     -       "I021/110/TID/TOA: Trajectory Intent Data (Trajectory Intent). 0 = TOV available, 1 = TOV not available"
key   i110_tid_tov   float   s       "I021/110/TID/TOV: Trajectory Intent Data; Time Over Point (Trajectory Intent). LSB 1 s"
key   i110_tid_ttr   float   NM      "I021/110/TID/TTR: Trajectory Intent Data; TCP Turn Radius (Trajectory Intent). LSB 1/100 NM"
