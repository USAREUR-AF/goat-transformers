# The inet module: the fixed header fields of IETF protocols (IPv4, IPv6, UDP,
# TCP, ICMP, NTP, the DNS message header; RTP and RTCP, ARP, GRE, VXLAN, the
# MPLS label stack entry, IGMPv2 and IGMPv3, ICMPv6, the SCTP common header,
# BFD; CoAP, the TLS and DTLS record headers, BGP-4, OSPFv2, VRRPv3, RIPv2,
# Geneve; Ethernet II with the 802.1Q tag, PPP, L2TPv3, IPsec ESP and AH, the QUIC
# invariants), as the wire
# integer unless the description says otherwise. A flag is 0 or 1. Keys of one protocol carry its
# name; the three keys without a protocol name hold the same quantity in more than
# one header (pack.md of each pack gives the evidence).
module        inet
version       0.5.0
distribution  public
source        "IETF RFC 791, RFC 8200, RFC 768, RFC 9293, RFC 792, RFC 5905, RFC 1035, RFC 3550, RFC 826, RFC 894, RFC 2784, RFC 2890, RFC 7348, RFC 3032, RFC 5462, RFC 2236, RFC 9260, RFC 5880, RFC 3376, RFC 4443, RFC 4861, RFC 7252, RFC 8446, RFC 9147, RFC 4271, RFC 2328, RFC 9568, RFC 2453, RFC 8926, RFC 7042, RFC 1661, RFC 1662, RFC 3931, RFC 4303, RFC 4302, RFC 8999 and RFC 6325, https://www.rfc-editor.org/, IETF Trust (BCP 78); layouts restated"

# Shared between headers
key  src_port                  int     -     "transport port of the sending process, 0-65535 (UDP, TCP and SCTP)"
key  dst_port                  int     -     "transport port of the receiving process, 0-65535 (UDP, TCP and SCTP)"
key  ip_protocol               int     -     "number of the header or protocol that follows the IP header, from the IANA protocol numbers registry (IPv4 protocol, IPv6 next header)"

# IPv4, RFC 791 section 3.1
key  ipv4_version              int     -     "IP version number, 4"
key  ipv4_ihl                  int     -     "header length in 32-bit words, 5 when there are no options"
key  ipv4_tos                  int     -     "type of service octet, as one integer"
key  ipv4_total_length         int     -     "length of the datagram, header and data, in octets"
key  ipv4_identification       int     -     "value set by the sender to group the fragments of one datagram"
key  ipv4_flag_reserved        int     -     "first flag bit, reserved, 0"
key  ipv4_dont_fragment        int     -     "flag: 1 = the datagram must not be fragmented"
key  ipv4_more_fragments       int     -     "flag: 1 = more fragments follow this one"
key  ipv4_fragment_offset      int     -     "place of this fragment in the datagram, in units of 8 octets"
key  ipv4_ttl                  int     -     "time to live; each module that processes the datagram lowers it, and the datagram is dropped at 0"
key  ipv4_header_checksum      int     -     "ones' complement checksum of the header"
key  ipv4_src_addr             int     -     "source address, the 32-bit integer (192.0.2.1 is 3221225985)"
key  ipv4_dst_addr             int     -     "destination address, the 32-bit integer"

# IPv6, RFC 8200 section 3
key  ipv6_version              int     -     "IP version number, 6"
key  ipv6_traffic_class        int     -     "traffic class octet, as one integer"
key  ipv6_flow_label           int     -     "flow label, 20 bits"
key  ipv6_payload_length       int     -     "length of what follows the 40-octet header, in octets"
key  ipv6_hop_limit            int     -     "hop limit; each forwarding node lowers it by 1, and the packet is dropped at 0"
key  ipv6_src_g0               int     -     "source address, 16-bit group 1 of 8 (the first group of the text form)"
key  ipv6_src_g1               int     -     "source address, 16-bit group 2 of 8"
key  ipv6_src_g2               int     -     "source address, 16-bit group 3 of 8"
key  ipv6_src_g3               int     -     "source address, 16-bit group 4 of 8"
key  ipv6_src_g4               int     -     "source address, 16-bit group 5 of 8"
key  ipv6_src_g5               int     -     "source address, 16-bit group 6 of 8"
key  ipv6_src_g6               int     -     "source address, 16-bit group 7 of 8"
key  ipv6_src_g7               int     -     "source address, 16-bit group 8 of 8 (the last group of the text form)"
key  ipv6_dst_g0               int     -     "destination address, 16-bit group 1 of 8"
key  ipv6_dst_g1               int     -     "destination address, 16-bit group 2 of 8"
key  ipv6_dst_g2               int     -     "destination address, 16-bit group 3 of 8"
key  ipv6_dst_g3               int     -     "destination address, 16-bit group 4 of 8"
key  ipv6_dst_g4               int     -     "destination address, 16-bit group 5 of 8"
key  ipv6_dst_g5               int     -     "destination address, 16-bit group 6 of 8"
key  ipv6_dst_g6               int     -     "destination address, 16-bit group 7 of 8"
key  ipv6_dst_g7               int     -     "destination address, 16-bit group 8 of 8"

# UDP, RFC 768
key  udp_length                int     -     "length of the datagram, header and data, in octets; at least 8"
key  udp_checksum              int     -     "ones' complement checksum over a pseudo header, the header and the data; 0 = none computed"

# TCP, RFC 9293 section 3.1
key  tcp_seq                   int     -     "sequence number of the first data octet of the segment (of the SYN when SYN is set)"
key  tcp_ack                   int     -     "next sequence number the sender of the segment expects to receive, meaningful when ACK is set"
key  tcp_data_offset           int     -     "header length in 32-bit words, 5 when there are no options"
key  tcp_reserved              int     -     "four reserved bits after the data offset, 0"
key  tcp_cwr                   int     -     "control bit CWR, congestion window reduced"
key  tcp_ece                   int     -     "control bit ECE, ECN echo"
key  tcp_urg                   int     -     "control bit URG: the urgent pointer is significant"
key  tcp_ack_flag              int     -     "control bit ACK: the acknowledgment number is significant"
key  tcp_psh                   int     -     "control bit PSH, push"
key  tcp_rst                   int     -     "control bit RST, reset the connection"
key  tcp_syn                   int     -     "control bit SYN, synchronize sequence numbers"
key  tcp_fin                   int     -     "control bit FIN, the sender has no more data"
key  tcp_window                int     -     "number of octets the sender of the segment will accept, from the acknowledgment number on"
key  tcp_checksum              int     -     "ones' complement checksum over a pseudo header, the header and the data"
key  tcp_urgent_pointer        int     -     "offset from the sequence number to the octet after the urgent data, meaningful when URG is set"

# ICMP, RFC 792
key  icmp_type                 int     -     "message type (0 echo reply, 3 destination unreachable, 4 source quench, 5 redirect, 8 echo, 11 time exceeded, 12 parameter problem, 13 timestamp, 14 timestamp reply, 15 information request, 16 information reply)"
key  icmp_code                 int     -     "code, whose meaning depends on the type"
key  icmp_checksum             int     -     "ones' complement checksum of the ICMP message"
key  icmp_unused               int     -     "the 32 bits after the checksum that the type leaves unused (24 after the pointer of a parameter problem), 0"
key  icmp_identifier           int     -     "identifier that helps match replies to requests (echo, timestamp and information messages)"
key  icmp_sequence             int     -     "sequence number that helps match replies to requests (echo, timestamp and information messages)"
key  icmp_gateway_addr         int     -     "redirect: address of the gateway to use, the 32-bit integer"
key  icmp_pointer              int     -     "parameter problem: octet of the original header where the error was found"
key  icmp_rest                 int     -     "the 32 bits after the checksum of a type this pack has no kind for"
key  icmp_originate_ms         int     ms    "timestamp messages: time the sender last touched the message, milliseconds since midnight UT; with the high-order bit set, a time the sender could not give that way (RFC 792), not milliseconds since midnight"
key  icmp_receive_ms           int     ms    "timestamp messages: time the echoer first touched it, milliseconds since midnight UT; with the high-order bit set, a time the sender could not give that way (RFC 792), not milliseconds since midnight"
key  icmp_transmit_ms          int     ms    "timestamp messages: time the echoer last touched it, milliseconds since midnight UT; with the high-order bit set, a time the sender could not give that way (RFC 792), not milliseconds since midnight"

# NTP, RFC 5905 section 7.3
key  ntp_leap                  int     -     "leap indicator (0 no warning, 1 last minute has 61 seconds, 2 last minute has 59 seconds, 3 clock unsynchronized)"
key  ntp_version               int     -     "NTP version number, 4 for NTPv4"
key  ntp_mode                  int     -     "association mode (1 symmetric active, 2 symmetric passive, 3 client, 4 server, 5 broadcast, 6 control, 7 private)"
key  ntp_stratum               int     -     "stratum (0 unspecified or invalid, 1 primary server, 2-15 secondary server, 16 unsynchronized)"
key  ntp_poll                  int     -     "largest interval between successive messages, as a power of two in seconds (signed)"
key  ntp_precision             int     -     "precision of the system clock, as a power of two in seconds (signed)"
key  ntp_root_delay            float   s     "total round-trip delay to the reference clock, seconds (16.16 fixed point on the wire)"
key  ntp_root_dispersion       float   s     "total dispersion to the reference clock, seconds (16.16 fixed point on the wire)"
key  ntp_kiss_code             string  -     "stratum 0: the reference ID read as a four-character ASCII kiss code"
key  ntp_ref_clock             string  -     "stratum 1: the reference ID read as the ASCII name of the reference clock, left-justified and zero-padded"
key  ntp_ref_id                int     -     "stratum 2 and above: the reference ID as a 32-bit integer (an IPv4 address of the upstream server, or the first 32 bits of a hash of its IPv6 address)"
key  ntp_ref_ts_sec            int     s     "reference timestamp: whole seconds since 1900-01-01 00:00 UTC, modulo 2^32 (NTP era)"
key  ntp_ref_ts_frac           int     -     "reference timestamp: fraction of a second, in units of 2^-32 s"
key  ntp_org_ts_sec            int     s     "origin timestamp: whole seconds since 1900-01-01 00:00 UTC, modulo 2^32"
key  ntp_org_ts_frac           int     -     "origin timestamp: fraction of a second, in units of 2^-32 s"
key  ntp_rec_ts_sec            int     s     "receive timestamp: whole seconds since 1900-01-01 00:00 UTC, modulo 2^32"
key  ntp_rec_ts_frac           int     -     "receive timestamp: fraction of a second, in units of 2^-32 s"
key  ntp_xmt_ts_sec            int     s     "transmit timestamp: whole seconds since 1900-01-01 00:00 UTC, modulo 2^32"
key  ntp_xmt_ts_frac           int     -     "transmit timestamp: fraction of a second, in units of 2^-32 s"

# DNS message header, RFC 1035 section 4.1.1
key  dns_id                    int     -     "identifier set by the requester and copied into the reply"
key  dns_qr                    int     -     "flag: 0 = query, 1 = response"
key  dns_opcode                int     -     "kind of query (0 standard, 1 inverse, 2 server status)"
key  dns_aa                    int     -     "flag: authoritative answer"
key  dns_tc                    int     -     "flag: the message was truncated"
key  dns_rd                    int     -     "flag: recursion desired"
key  dns_ra                    int     -     "flag: recursion available"
key  dns_z                     int     -     "three bits reserved for future use, 0 in RFC 1035"
key  dns_rcode                 int     -     "response code (0 no error, 1 format error, 2 server failure, 3 name error, 4 not implemented, 5 refused)"
key  dns_qdcount               int     -     "number of entries in the question section"
key  dns_ancount               int     -     "number of resource records in the answer section"
key  dns_nscount               int     -     "number of name server resource records in the authority section"
key  dns_arcount               int     -     "number of resource records in the additional records section"

# RTP fixed header, RFC 3550 section 5.1
key  rtp_version               int     -     "RTP version, 2"
key  rtp_padding               int     -     "flag: 1 = padding octets end the packet, the last one counting them"
key  rtp_extension             int     -     "flag: 1 = one header extension follows the fixed header"
key  rtp_csrc_count            int     -     "number of contributing source identifiers after the fixed header, 0-15"
key  rtp_marker                int     -     "marker bit, its meaning set by the profile"
key  rtp_payload_type          int     -     "payload type, 0-127, its meaning set by the profile"
key  rtp_sequence              int     -     "sequence number, 16 bits, one more for each data packet sent"
key  rtp_timestamp             int     -     "sampling instant of the first payload octet, in units of the payload's clock, 32 bits"
key  rtp_ssrc                  int     -     "synchronization source identifier, 32 bits"

# RTCP sender and receiver reports, RFC 3550 sections 6.4.1 and 6.4.2
key  rtcp_packet_type          int     -     "packet type, in packets other than a sender report (201 to 204)"
key  rtcp_version              int     -     "RTP version, 2"
key  rtcp_padding              int     -     "flag: 1 = padding octets end this RTCP packet"
key  rtcp_report_count         int     -     "number of reception report blocks in the packet, 0-31"
key  rtcp_length               int     -     "length of the RTCP packet in 32-bit words, less one, header and padding included"
key  rtcp_ssrc                 int     -     "synchronization source identifier of the sender of the report"
key  rtcp_ntp_ts_sec           int     s     "sender report: whole seconds of the NTP-format time the report was sent (may be relative, or 0)"
key  rtcp_ntp_ts_frac          int     -     "sender report: fraction of a second of that time, in units of 2^-32 s"
key  rtcp_rtp_timestamp        int     -     "sender report: the same instant in the units and offset of the RTP timestamps"
key  rtcp_packet_count         int     -     "sender report: RTP data packets sent since the start of transmission"
key  rtcp_octet_count          int     -     "sender report: payload octets sent since the start of transmission"

# ARP for IPv4 over Ethernet, RFC 826 (and RFC 894 for the IPv4 type)
key  arp_operation             int     -     "operation, 1 request or 2 reply"
key  arp_sender_hw_addr        int     -     "Ethernet address of the sender, the 48-bit integer"
key  arp_sender_ip_addr        int     -     "IPv4 address of the sender, the 32-bit integer"
key  arp_target_hw_addr        int     -     "Ethernet address of the target, the 48-bit integer; in a request any value, often 0 or all ones (RFC 826 gives no not-known value)"
key  arp_target_ip_addr        int     -     "IPv4 address of the target, the 32-bit integer"

# GRE, RFC 2784 with the key and sequence number of RFC 2890
key  gre_bit1                  int     -     "bit 1 of the first word: routing present in RFC 1701, reserved (0) in RFC 2784"
key  gre_reserved0             int     -     "bits 4-12 of the first word, 0"
key  gre_version               int     -     "GRE version, 0"
key  gre_protocol_type         int     -     "EtherType of the payload packet"
key  gre_checksum              int     -     "present when the C bit is 1: ones' complement checksum of the GRE header and payload"
key  gre_reserved1             int     -     "present when the C bit is 1: 16 bits after the checksum, 0"
key  gre_key                   int     -     "present when the K bit is 1: 32-bit key set by the encapsulator, naming a traffic flow"
key  gre_sequence              int     -     "present when the S bit is 1: 32-bit sequence number"

# VXLAN, RFC 7348 section 5
key  vxlan_i_flag              int     -     "flag: 1 = the VNI is valid"
key  vxlan_reserved1           int     -     "the 24 reserved bits after the flags, 0"
key  vxlan_vni                 int     -     "VXLAN network identifier, 24 bits"
key  vxlan_reserved2           int     -     "the 8 reserved bits after the VNI, 0"

# MPLS label stack entry, RFC 3032 section 2.1 (TC named by RFC 5462)
key  mpls_label                int     -     "label value, 20 bits (0-15 reserved)"
key  mpls_tc                   int     -     "traffic class, 3 bits (named experimental use in RFC 3032)"
key  mpls_bottom_of_stack      int     -     "flag: 1 = the last entry of the label stack"
key  mpls_ttl                  int     -     "time to live"

# IGMPv2, RFC 2236 section 2
key  igmp_type                 int     -     "message type; in IGMPv3 of a membership query"
key  igmp_max_resp_time        int     -     "membership query: longest time before a report is sent, in tenths of a second; 0 in other messages"
key  igmp_checksum             int     -     "ones' complement checksum of the IGMP message"
key  igmp_group_addr           int     -     "multicast group address, the 32-bit integer (0 in a general query)"

# SCTP common header, RFC 9260 section 3.1
key  sctp_verification_tag     int     -     "verification tag, 32 bits, set from the peer's initiate tag"
key  sctp_checksum             int     -     "CRC32c checksum of the SCTP packet"

# BFD control packet, mandatory section, RFC 5880 section 4.1
key  bfd_version               int     -     "BFD version, 1"
key  bfd_diag                  int     -     "diagnostic code: reason for the last change of session state (0 none, 1-8 defined)"
key  bfd_state                 int     -     "session state as the sender sees it (0 AdminDown, 1 Down, 2 Init, 3 Up)"
key  bfd_poll                  int     -     "flag: poll, the sender asks for verification"
key  bfd_final                 int     -     "flag: final, the reply to a poll"
key  bfd_cpi                   int     -     "flag: control plane independent"
key  bfd_auth_present          int     -     "flag: an authentication section follows"
key  bfd_demand                int     -     "flag: demand mode"
key  bfd_multipoint            int     -     "flag: multipoint, reserved, 0"
key  bfd_detect_mult           int     -     "detection time multiplier"
key  bfd_length                int     -     "length of the control packet in octets"
key  bfd_my_disc               int     -     "my discriminator: nonzero, chosen by the sender for the session"
key  bfd_your_disc             int     -     "your discriminator: the peer's my discriminator, or 0 when not known"
key  bfd_desired_min_tx        int     us    "desired minimum transmit interval, microseconds"
key  bfd_required_min_rx       int     us    "required minimum receive interval, microseconds"
key  bfd_required_min_echo_rx  int     us    "required minimum echo receive interval, microseconds (0: no echo)"

# RTP contributing sources, RFC 3550 section 5.1
list rtp_csrcs                         "the CSRC list after the fixed header, counted by the CSRC count; each item holds inet.rtp_csrc"
key  rtp_csrc                  int     -     "one contributing source identifier, 32 bits"

# RTCP report blocks and the SDES, BYE and APP packets, RFC 3550 sections 6.4.1, 6.5, 6.6 and 6.7
list rtcp_report_blocks                "the reception report blocks of a sender or receiver report, counted by the report count; each item holds the inet.rtcp_rb_* keys"
key  rtcp_rb_ssrc              int     -     "report block: the source the block reports on"
key  rtcp_rb_fraction_lost     int     -     "report block: packets lost since the last report, as a fraction of those expected, in units of 1/256"
key  rtcp_rb_cumulative_lost   int     -     "report block: packets lost since reception began, 24-bit signed (negative when duplicates arrive)"
key  rtcp_rb_ext_highest_seq   int     -     "report block: highest sequence number received, with the count of its wraps in the high 16 bits"
key  rtcp_rb_jitter            int     -     "report block: interarrival jitter estimate, in RTP timestamp units"
key  rtcp_rb_lsr               int     -     "report block: middle 32 bits of the NTP timestamp of the last sender report received from the source, 0 if none"
key  rtcp_rb_dlsr              int     -     "report block: delay since that sender report was received, in units of 1/65536 s, 0 if none"
key  rtcp_source_count         int     -     "source description and goodbye: the number of chunks or of SSRC/CSRC identifiers, 0-31"
list rtcp_bye_sources                  "goodbye: the SSRC/CSRC identifiers leaving, counted by the source count; each item holds inet.rtcp_bye_ssrc"
key  rtcp_bye_ssrc             int     -     "goodbye: one SSRC or CSRC identifier"
key  rtcp_app_subtype          int     -     "application-defined packet: the 5-bit subtype"
key  rtcp_app_name             string  -     "application-defined packet: the four ASCII characters naming the application"

# IGMPv3, RFC 3376 sections 4.1 and 4.2
key  igmp3_max_resp_code       int     -     "query: max response code; below 128 the time in tenths of a second, from 128 a floating-point code"
key  igmp3_reserved            int     -     "query: the 4 reserved bits before the S flag, 0"
key  igmp3_suppress            int     -     "query: S flag, 1 = routers suppress their timer updates"
key  igmp3_qrv                 int     -     "query: querier's robustness variable, 0-7"
key  igmp3_qqic                int     -     "query: querier's query interval code; below 128 seconds, from 128 a floating-point code"
key  igmp3_num_sources         int     -     "number of source addresses that follow (query, or one group record)"
list igmp3_query_sources               "query: the source addresses, counted by the number of sources; each item holds inet.igmp3_source_addr"
key  igmp3_source_addr         int     -     "one source address, the 32-bit integer"
key  igmp3_report_reserved1    int     -     "report: the octet after the type, 0"
key  igmp3_report_reserved2    int     -     "report: the 16 bits after the checksum, 0"
key  igmp3_num_records         int     -     "report: number of group records"
list igmp3_group_records               "report: the group records, counted by the number of records; each item holds the igmp3 record keys and inet.igmp3_record_sources"
key  igmp3_record_type         int     -     "group record type (1 mode is include, 2 mode is exclude, 3 change to include, 4 change to exclude, 5 allow new sources, 6 block old sources)"
key  igmp3_aux_data_len        int     -     "group record: length of the auxiliary data in 32-bit words, 0 in IGMPv3"
key  igmp3_multicast_addr      int     -     "group record: the multicast address, the 32-bit integer"
list igmp3_record_sources              "group record: the source addresses, counted by its number of sources; each item holds inet.igmp3_source_addr"

# ICMPv6, RFC 4443 sections 2.1, 3 and 4, and the router messages of RFC 4861 sections 4.1 and 4.2
key  icmpv6_type               int     -     "message type (1-127 errors, 128-255 informational)"
key  icmpv6_code               int     -     "code, its meaning set by the type"
key  icmpv6_checksum           int     -     "ones' complement checksum over the message and an IPv6 pseudo header"
key  icmpv6_unused             int     -     "destination unreachable and time exceeded: the 32 bits after the checksum, 0"
key  icmpv6_mtu                int     -     "packet too big: the MTU of the next-hop link, octets"
key  icmpv6_pointer            int     -     "parameter problem: offset in the invoking packet of the octet in error"
key  icmpv6_identifier         int     -     "echo request and reply: identifier to match replies with requests"
key  icmpv6_sequence           int     -     "echo request and reply: sequence number to match replies with requests"
key  icmpv6_reserved           int     -     "router solicitation: the 32 bits after the checksum, 0"
key  icmpv6_rest               int     -     "any other type: the 32 bits after the checksum"
key  icmpv6_ra_cur_hop_limit   int     -     "router advertisement: hop limit hosts should use, 0 = not set by this router"
key  icmpv6_ra_managed         int     -     "router advertisement: M flag, addresses are available by DHCPv6"
key  icmpv6_ra_other           int     -     "router advertisement: O flag, other configuration is available by DHCPv6"
key  icmpv6_ra_reserved        int     -     "router advertisement: the 6 bits after the flags, 0 in RFC 4861"
key  icmpv6_ra_router_lifetime int     s     "router advertisement: lifetime as a default router, seconds; 0 = not a default router"
key  icmpv6_ra_reachable_time  int     ms    "router advertisement: time a neighbor is taken as reachable after a confirmation, milliseconds; 0 = not set"
key  icmpv6_ra_retrans_timer   int     ms    "router advertisement: time between retransmitted neighbor solicitations, milliseconds; 0 = not set"

# CoAP, RFC 7252 section 3
key  coap_version              int     -     "CoAP version, 1"
key  coap_type                 int     -     "message type (0 confirmable, 1 non-confirmable, 2 acknowledgement, 3 reset)"
key  coap_token_length         int     -     "token length in octets, 0-8 (9-15 reserved)"
key  coap_code_class           int     -     "code class, the high 3 bits of the code (0 request, 2 success, 4 client error, 5 server error)"
key  coap_code_detail          int     -     "code detail, the low 5 bits of the code"
key  coap_message_id           int     -     "message ID, to detect duplicates and match acknowledgements and resets"
list coap_token                        "the token octets, counted by the token length; each item holds inet.coap_token_octet"
key  coap_token_octet          int     -     "one octet of the token, 0-255"

# TLS record header, RFC 8446 section 5.1, and the DTLS record headers, RFC 9147 section 4
key  tls_content_type          int     -     "record content type (20 change_cipher_spec, 21 alert, 22 handshake, 23 application_data; DTLS 26 ack)"
key  tls_legacy_version        int     -     "legacy record version, 16 bits (0x0303 in TLS 1.3, 0xFEFD in DTLS 1.3); ignored by receivers"
key  tls_record_length         int     -     "length of the record body in octets, after the header"
key  tls_ccs_value             int     -     "change_cipher_spec record: its one octet, 1"
key  tls_alert_level           int     -     "plaintext alert record: level (1 warning, 2 fatal)"
key  tls_alert_description     int     -     "plaintext alert record: alert description code"
key  tls_handshake_type        int     -     "handshake record: type of the first handshake message (1 client_hello, 2 server_hello, ...)"
key  tls_handshake_length      int     -     "handshake record: length of the first handshake message body, 24 bits"
key  dtls_epoch                int     -     "DTLS plaintext record: the low 16 bits of the connection epoch"
key  dtls_sequence             int     -     "DTLS plaintext record: the low 48 bits of the record sequence number"
key  dtls_cid_present          int     -     "DTLS unified header: C bit, a connection ID follows the first octet"
key  dtls_seq_16bit            int     -     "DTLS unified header: S bit, 1 = the sequence number is 16 bits, 0 = 8 bits"
key  dtls_length_present       int     -     "DTLS unified header: L bit, a 16-bit length follows the sequence number"
key  dtls_epoch_low            int     -     "DTLS unified header: the low 2 bits of the epoch"
key  dtls_seq_low              int     -     "DTLS unified header: the low 8 or 16 bits of the record sequence number as sent, XORed with a mask from the ciphertext (RFC 9147 4.2.3), so not the sequence number itself"

# BGP-4, RFC 4271 section 4
key  bgp_length                int     -     "total length of the message in octets, header included, 19-4096"
key  bgp_type                  int     -     "message type, in a KEEPALIVE (4)"
key  bgp_version               int     -     "OPEN: BGP version, 4"
key  bgp_my_as                 int     -     "OPEN: autonomous system number of the sender, 16 bits"
key  bgp_hold_time             int     s     "OPEN: proposed hold time, seconds (0, or at least 3)"
key  bgp_identifier            int     -     "OPEN: BGP identifier of the sender, a 32-bit IPv4 address as integer"
key  bgp_opt_param_length      int     -     "OPEN: total length of the optional parameters in octets"
key  bgp_withdrawn_routes_length int   -     "UPDATE: length of the withdrawn routes field in octets"
key  bgp_error_code            int     -     "NOTIFICATION: error code"
key  bgp_error_subcode         int     -     "NOTIFICATION: error subcode"

# OSPFv2, RFC 2328 appendix A.3
key  ospf_type                 int     -     "packet type, in a link state request (3) and a link state acknowledgment (5)"
key  ospf_version              int     -     "OSPF version, 2"
key  ospf_packet_length        int     -     "length of the packet in octets, header included"
key  ospf_router_id            int     -     "router ID of the source, the 32-bit integer"
key  ospf_area_id              int     -     "area ID the packet belongs to, the 32-bit integer (0 backbone)"
key  ospf_checksum             int     -     "ones' complement checksum of the packet, authentication field excluded"
key  ospf_autype               int     -     "authentication type (0 none, 1 simple password, 2 cryptographic)"
key  ospf_auth_hi              int     -     "authentication field, first 32 bits"
key  ospf_auth_lo              int     -     "authentication field, last 32 bits"
key  ospf_network_mask         int     -     "Hello: network mask of the interface, the 32-bit integer"
key  ospf_hello_interval       int     s     "Hello: seconds between Hello packets"
key  ospf_options              int     -     "Hello and Database Description: optional capabilities octet"
key  ospf_router_priority      int     -     "Hello: router priority, 0 = never designated router"
key  ospf_router_dead_interval int     s     "Hello: seconds before a silent router is declared down"
key  ospf_dr                   int     -     "Hello: designated router, the 32-bit integer (0 none)"
key  ospf_bdr                  int     -     "Hello: backup designated router, the 32-bit integer (0 none)"
key  ospf_interface_mtu        int     -     "Database Description: largest IP datagram the interface sends unfragmented, octets"
key  ospf_dd_reserved          int     -     "Database Description: the 5 bits before I, M and MS, 0"
key  ospf_dd_init              int     -     "Database Description: I bit, the first packet of the sequence"
key  ospf_dd_more              int     -     "Database Description: M bit, more packets follow"
key  ospf_dd_master            int     -     "Database Description: MS bit, the sender is the master"
key  ospf_dd_sequence          int     -     "Database Description: DD sequence number"
key  ospf_lsa_count            int     -     "Link State Update: number of LSAs in the packet"

# VRRPv3, RFC 9568 section 5
key  vrrp_version              int     -     "VRRP version, 3"
key  vrrp_type                 int     -     "packet type, 1 advertisement"
key  vrrp_vrid                 int     -     "virtual router identifier"
key  vrrp_priority             int     -     "priority of the sender for the virtual router (255 address owner, 0 the active router stops)"
key  vrrp_addr_count           int     -     "number of addresses that follow"
key  vrrp_reserved             int     -     "the 4 reserved bits before the interval, 0"
key  vrrp_max_adver_int        int     cs    "maximum advertisement interval, centiseconds, 12 bits"
key  vrrp_checksum             int     -     "ones' complement checksum of the VRRP message (with a pseudo header for IPv6)"
list vrrp_ipv4_addrs                   "the IPv4 addresses of the virtual router, counted by the address count; each item holds inet.vrrp_ipv4_addr"
key  vrrp_ipv4_addr            int     -     "one IPv4 address, the 32-bit integer"
list vrrp_ipv6_addrs                   "the IPv6 addresses of the virtual router, counted by the address count; each item holds inet.vrrp_ipv6_g0 to g7"
key  vrrp_ipv6_g0              int     -     "IPv6 address, 16-bit group 1 of 8 (the first group of the text form)"
key  vrrp_ipv6_g1              int     -     "IPv6 address, 16-bit group 2 of 8"
key  vrrp_ipv6_g2              int     -     "IPv6 address, 16-bit group 3 of 8"
key  vrrp_ipv6_g3              int     -     "IPv6 address, 16-bit group 4 of 8"
key  vrrp_ipv6_g4              int     -     "IPv6 address, 16-bit group 5 of 8"
key  vrrp_ipv6_g5              int     -     "IPv6 address, 16-bit group 6 of 8"
key  vrrp_ipv6_g6              int     -     "IPv6 address, 16-bit group 7 of 8"
key  vrrp_ipv6_g7              int     -     "IPv6 address, 16-bit group 8 of 8"

# RIPv2, RFC 2453 sections 3.6 and 4
key  rip_command               int     -     "command (1 request, 2 response)"
key  rip_version               int     -     "RIP version (1 or 2)"
key  rip_zero                  int     -     "the 16 bits after the version, 0 (unused)"

# Geneve, RFC 8926 section 3.4
key  geneve_version            int     -     "Geneve version, 0"
key  geneve_opt_len            int     -     "length of the options in 4-octet words, 0-63"
key  geneve_control            int     -     "O bit: the packet carries a control message"
key  geneve_critical           int     -     "C bit: one or more options are critical"
key  geneve_reserved1          int     -     "the 6 reserved bits after C, 0"
key  geneve_protocol_type      int     -     "EtherType of the payload (0x6558 Ethernet)"
key  geneve_vni                int     -     "virtual network identifier, 24 bits"
key  geneve_reserved2          int     -     "the 8 reserved bits after the VNI, 0"
list geneve_option_words               "the options as raw 4-octet words, counted by the option length; each item holds inet.geneve_option_word"
key  geneve_option_word        int     -     "one 4-octet word of the options, the 32-bit integer"

# Ethernet II and the 802.1Q C-tag, RFC 894, RFC 7042 section 3 and RFC 7348 section 5
key  eth_dst_addr              int     -     "destination MAC address, the 48-bit integer"
key  eth_src_addr              int     -     "source MAC address, the 48-bit integer"
key  eth_type                  int     -     "EtherType of the payload, 0x0600 and above (below 0x0600 the field is an IEEE 802.3 length)"
key  vlan_tag_info             int     -     "C-tag: the 16 bits of VLAN tag information after the 0x8100 EtherType (priority and VLAN ID, as IEEE 802.1Q divides them), as one integer"
# The C-tag information split, RFC 6325 section 4.1.1 (Figure 8)
key  vlan_pcp                  int     -     "C-tag: priority, the 3 most significant bits of the tag information, 0 to 7 (1 lowest, 7 highest, 0 the default between 1 and 2)"
key  vlan_dei                  int     -     "C-tag: the bit after the priority, drawn as C in RFC 6325 Figure 8 (the drop eligible indicator of later IEEE 802.1Q editions)"
key  vlan_vid                  int     -     "C-tag: VLAN ID, the 12 least significant bits; 0 no VLAN (a priority-tagged frame), 0xFFF reserved"

# PPP, RFC 1661 section 2 and RFC 1662 section 3
key  ppp_protocol              int     -     "protocol field: the protocol of the information field (0x0021 IPv4, 0x0057 IPv6, 0xC021 LCP, ...), 1 or 2 octets"

# L2TPv3, RFC 3931 sections 3.2.1, 4.1.1 and 4.1.2
key  l2tp_session_id           int     -     "session ID, 32 bits (over IP, 0 marks a control message)"
key  l2tp_length_bit           int     -     "control message: L bit, 1 = the length field is present"
key  l2tp_sequence_bit         int     -     "control message: S bit, 1 = Ns and Nr are present"
key  l2tp_version              int     -     "version of the header, 3"
key  l2tp_length               int     -     "control message: length of the message in octets from the T bit"
key  l2tp_control_connection_id int    -     "control message: control connection ID of the intended recipient"
key  l2tp_ns                   int     -     "control message: sequence number of this message"
key  l2tp_nr                   int     -     "control message: sequence number expected in the next message received"
key  l2tp_reserved             int     -     "data message over UDP: the 16 reserved bits, 0"

# IPsec ESP and AH, RFC 4303 section 2 and RFC 4302 section 2
key  ipsec_spi                 int     -     "security parameters index: identifies the security association of the packet, 32 bits (ESP and AH)"
key  ipsec_seq                 int     -     "sequence number: the low 32 bits of the anti-replay counter (ESP and AH)"
key  ah_next_header            int     -     "AH: next header, the protocol of the payload after the AH header, from the IANA protocol numbers registry (RFC 4302 2.1); not the protocol after the IP header, which is 51 for AH"
key  ah_payload_len            int     -     "AH: length of the header in 32-bit words, minus 2"
key  ah_reserved               int     -     "AH: the 16 reserved bits, 0"

# QUIC invariants, RFC 8999 section 5
key  quic_version_specific     int     -     "the 7 bits after the header form bit, version specific"
key  quic_version              int     -     "long header: the 32-bit version (0 = version negotiation)"
list quic_dcid                         "long header: the destination connection ID, counted by its length octet; each item holds inet.quic_cid_octet"
list quic_scid                         "long header: the source connection ID, counted by its length octet; each item holds inet.quic_cid_octet"
key  quic_cid_octet            int     -     "one octet of a connection ID, 0-255"
