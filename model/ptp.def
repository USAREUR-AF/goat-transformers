# The ptp module: PTP (IEEE 1588) message fields as linuxptp lays them out. Written by tools/gen/gnss-time-pack.py.
module        ptp
version       0.1.0
distribution  public
source        "linuxptp v4.4 (commit 0188667308e62b6ac61151193320ec052e2fd023), msg.h (sha256 4fcb3192f77ca15ab848857f21854bf3ac3d3d849ce47b97b071180cbb387c55), ddt.h and tlv.h, GPL-2.0-or-later, https://github.com/richardcochran/linuxptp; the IEEE 1588 message layouts as linuxptp packs them; restated, no code copied"
key   transport_specific             int     -  "transportSpecific (majorSdoId), the high nibble of the first octet"
key   message_type                   int     -  "message type: 0 Sync, 1 Delay_Req, 2 Pdelay_Req, 3 Pdelay_Resp, 8 Follow_Up, 9 Delay_Resp, 10 Pdelay_Resp_Follow_Up, 11 Announce, 12 Signaling, 13 Management"
key   minor_version                  int     -  "minorVersionPTP"
key   version                        int     -  "versionPTP (2)"
key   domain_number                  int     -  "domain number"
key   reserved1                      int     -  "the reserved octet after the domain"
key   flags0_other                   int     -  "the other five bits of the first flag octet"
key   unicast                        int     -  "flag: unicast"
key   two_step                       int     -  "flag: two-step clock"
key   alternate_master               int     -  "flag: alternate master"
key   flags1_reserved                int     -  "the reserved bit of the second flag octet"
key   sync_uncertain                 int     -  "flag: synchronization uncertain"
key   frequency_traceable            int     -  "flag: frequency traceable"
key   time_traceable                 int     -  "flag: time traceable"
key   ptp_timescale                  int     -  "flag: the PTP timescale (TAI) is used"
key   utc_offset_valid               int     -  "flag: currentUtcOffset is valid"
key   leap59                         int     -  "flag: the last minute of the day has 59 seconds"
key   leap61                         int     -  "flag: the last minute of the day has 61 seconds"
key   correction                     int     -  "correction field, nanoseconds times 2^16, signed"
key   reserved2                      int     -  "the 32 reserved bits after the correction"
key   sequence_id                    int     -  "sequence ID"
key   control                        int     -  "control field (deprecated)"
key   log_message_interval           int     -  "log2 of the message interval, seconds, signed"
key   source_clock_identity          string  -  "source port identity: clock identity, as hex"
key   source_port_number             int     -  "source port identity: port number"
key   origin_seconds                 int     -  "origin timestamp: seconds (48 bits), in the PTP timescale unless the flag says otherwise"
key   origin_nanoseconds             int     -  "origin timestamp: nanoseconds"
key   reserved_clock_identity        string  -  "Pdelay_Req reserved port identity: clock identity, as hex"
key   reserved_port_number           int     -  "Pdelay_Req reserved port identity: port number"
key   request_receipt_seconds        int     -  "request receipt timestamp: seconds (48 bits), in the PTP timescale unless the flag says otherwise"
key   request_receipt_nanoseconds    int     -  "request receipt timestamp: nanoseconds"
key   requesting_clock_identity      string  -  "requesting port identity: clock identity, as hex"
key   requesting_port_number         int     -  "requesting port identity: port number"
key   precise_origin_seconds         int     -  "precise origin timestamp: seconds (48 bits), in the PTP timescale unless the flag says otherwise"
key   precise_origin_nanoseconds     int     -  "precise origin timestamp: nanoseconds"
key   receive_seconds                int     -  "receive timestamp: seconds (48 bits), in the PTP timescale unless the flag says otherwise"
key   receive_nanoseconds            int     -  "receive timestamp: nanoseconds"
key   response_origin_seconds        int     -  "response origin timestamp: seconds (48 bits), in the PTP timescale unless the flag says otherwise"
key   response_origin_nanoseconds    int     -  "response origin timestamp: nanoseconds"
key   target_clock_identity          string  -  "target port identity: clock identity, as hex"
key   target_port_number             int     -  "target port identity: port number"
key   gm_identity                    string  -  "Announce: grandmaster clock identity, as hex"
key   current_utc_offset             int     -  "Announce: current UTC offset, seconds (TAI - UTC)"
key   announce_reserved              int     -  "Announce: reserved octet"
key   gm_priority1                   int     -  "Announce: grandmaster priority 1"
key   gm_clock_class                 int     -  "Announce: grandmaster clock class"
key   gm_clock_accuracy              int     -  "Announce: grandmaster clock accuracy code"
key   gm_offset_scaled_log_variance  int     -  "Announce: grandmaster offset scaled log variance"
key   gm_priority2                   int     -  "Announce: grandmaster priority 2"
key   steps_removed                  int     -  "Announce: steps removed from the grandmaster"
key   time_source                    int     -  "Announce: time source code (0x20 GNSS, 0x40 PTP, 0x50 NTP, 0xA0 internal oscillator ...)"
key   starting_boundary_hops         int     -  "Management: starting boundary hops"
key   boundary_hops                  int     -  "Management: boundary hops"
key   management_reserved            int     -  "Management: the reserved nibble"
key   action                         int     -  "Management action: 0 GET, 1 SET, 2 RESPONSE, 3 COMMAND, 4 ACKNOWLEDGE"
key   management_reserved2           int     -  "Management: the reserved octet"
key   tlv_type                       int     -  "TLV type (1 management, 2 management error, 3 organization extension, 8 path trace, 0x4000/0x8000 organization extensions ...)"
key   management_id                  int     -  "management TLV: the management ID"
key   organization_id                string  -  "organization extension: the organization ID (OUI), as hex"
key   organization_subtype           string  -  "organization extension: the subtype, as hex"
key   path_clock_identity            string  -  "path trace: one clock identity, as hex"
key   octet                          int     -  "one octet"
list  tlvs                           "the suffix TLVs, in order"
list  tlv_data                       "the rest of a TLV's value, as octets"
list  path_trace                     "path trace TLV: the clock identities"
