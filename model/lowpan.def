# The lowpan module: the fields of 6LoWPAN frames (RFC 4944, RFC 6282, RFC 7400). Written by tools/gen/mesh-pack.py.
module        lowpan
version       0.1.0
distribution  public
source        "IETF RFC 4944, RFC 6282 and RFC 7400; restated by goat-transformers"
key   s0_a               int     -  "the first 2 bits of the first header: 0 not a LoWPAN frame, 1 IPv6 or IPHC or a dispatch, 2 mesh, 3 fragment or other"
key   s0_b               int     -  "after 01: 1 for IPHC (011), 0 for a 6-bit dispatch"
key   s0_c               int     -  "after 010: the rest of the dispatch (1 IPv6, 2 HC1, 16 BC0, 31 ESC)"
key   s0_d               int     -  "after 11: the next 3 bits (0 FRAG1, 4 FRAGN)"
key   s1_a               int     -  "as s0_a, for the header after a mesh header"
key   s1_b               int     -  "as s0_b, after a mesh header"
key   s1_c               int     -  "as s0_c, after a mesh header"
key   s1_d               int     -  "as s0_d, after a mesh header"
key   s2_a               int     -  "as s0_a, for the header after a broadcast header"
key   s2_b               int     -  "as s0_b, after a broadcast header"
key   s2_c               int     -  "as s0_c, after a broadcast header"
key   s2_d               int     -  "as s0_d, after a broadcast header"
key   s3_a               int     -  "as s0_a, for the header after a first fragment header"
key   s3_b               int     -  "as s0_b, after a first fragment header"
key   s3_c               int     -  "as s0_c, after a first fragment header"
key   s3_d               int     -  "as s0_d, after a first fragment header"
key   nalp_bits          int     -  "not a LoWPAN frame: the 6 bits after 00"
key   dispatch_bits      int     -  "a pattern not allowed at its place: the 6 bits after its first 2"
key   dispatch_low3      int     -  "a pattern 11 then 3 bits other than a fragment header allowed here: the last 3 bits of the octet"
list  frame_octets       "the rest of a frame whose header is not laid out here (LOWPAN_HC1, ESC, page switch, reserved patterns), as octets"
list  ipv6_packet        "dispatch 0x41: the uncompressed IPv6 packet, as octets"
key   mesh_v             int     -  "mesh header V: 0 the originator is a 64-bit address, 1 a 16-bit short address"
key   mesh_f             int     -  "mesh header F: 0 the final destination is a 64-bit address, 1 a 16-bit short address"
key   hops_left          int     -  "mesh header: hops left, 0 to 14; 15 means a deep hops left octet follows"
key   deep_hops_left     int     -  "mesh header: the 8-bit deep hops left"
key   originator         string  -  "mesh header: the originator's link-layer address, as hexadecimal digits"
key   final              string  -  "mesh header: the final destination's link-layer address, as hexadecimal digits"
key   bc0_sequence       int     -  "LOWPAN_BC0: the broadcast sequence number"
key   datagram_size      int     -  "fragment header: the size of the whole IP packet before fragmentation, octets"
key   datagram_tag       int     -  "fragment header: the tag shared by the fragments of one packet"
key   datagram_offset    int     -  "FRAGN: the offset of the fragment in 8-octet units"
list  fragment_octets    "FRAGN: the fragment's octets"
key   tf                 int     -  "IPHC TF: 0 ECN, DSCP and flow label inline; 1 ECN and flow label; 2 ECN and DSCP; 3 all elided"
key   nh                 int     -  "IPHC NH: 0 the next header inline, 1 compressed by NHC"
key   hlim               int     -  "IPHC HLIM: 0 the hop limit inline; 1, 2, 3 the hop limit 1, 64, 255"
key   cid                int     -  "IPHC CID: 1 a context identifier octet follows"
key   sac                int     -  "IPHC SAC: 0 stateless, 1 context-based source address compression"
key   sam                int     -  "IPHC SAM: source address mode (the inline size by SAC)"
key   m                  int     -  "IPHC M: the destination is a multicast address"
key   dac                int     -  "IPHC DAC: 0 stateless, 1 context-based destination address compression"
key   dam                int     -  "IPHC DAM: destination address mode (the inline size by M and DAC)"
key   sci                int     -  "IPHC source context identifier"
key   dci                int     -  "IPHC destination context identifier"
key   ecn                int     -  "IPHC inline ECN bits"
key   dscp               int     -  "IPHC inline DSCP"
key   tf_pad             int     -  "IPHC: the pad bits of the inline traffic class and flow label, 0"
key   flow_label         int     -  "IPHC inline flow label"
key   next_header        int     -  "IPHC inline next header"
key   hop_limit          int     -  "IPHC inline hop limit"
key   src_inline         string  -  "IPHC: the source address bits carried inline (128, 64 or 16), as hexadecimal digits"
key   dst_inline         string  -  "IPHC: the destination address bits carried inline (128, 64, 48, 32, 16 or 8), as hexadecimal digits"
list  ipv6_payload       "IPHC with an inline next header: the IPv6 payload, as octets"
key   nhc_a              int     -  "the first 4 bits of the NHC octet: 15 UDP, 14 extension header, 13 GHC UDP or ICMPv6, 11 GHC extension header"
key   nhc_b              int     -  "after 1111: 0 for UDP (11110)"
key   nhc_d              int     -  "after 1101: 0 for GHC UDP (11010), 1 for 11011"
key   nhc_e              int     -  "after 11011: the last 3 bits (7 for GHC ICMPv6)"
key   nhc_f              int     -  "after 1011: 0 for GHC extension header (10110)"
key   nhc_low            int     -  "an NHC pattern not laid out: the last 3 bits of its octet"
key   nhc_rest           int     -  "an NHC pattern not laid out: the last 4 bits of its octet"
list  nhc_octets         "the rest of a packet whose NHC pattern is not laid out, as octets"
key   udp_c              int     -  "UDP NHC C: 1 the checksum is elided"
key   udp_p              int     -  "UDP NHC P: 0 both ports inline, 1 the destination's low 8 bits, 2 the source's low 8 bits, 3 the low 4 bits of both"
key   ghc_udp_c          int     -  "GHC UDP NHC C: 1 the checksum is elided"
key   ghc_udp_p          int     -  "GHC UDP NHC P, as for UDP"
key   udp_src_port       int     -  "UDP source port, inline"
key   udp_dst_port       int     -  "UDP destination port, inline"
key   udp_src_port_low8  int     -  "UDP source port: the low 8 bits (the high 8 are 0xF0)"
key   udp_dst_port_low8  int     -  "UDP destination port: the low 8 bits (the high 8 are 0xF0)"
key   udp_src_port_low4  int     -  "UDP source port: the low 4 bits (the high 12 are 0xF0B)"
key   udp_dst_port_low4  int     -  "UDP destination port: the low 4 bits (the high 12 are 0xF0B)"
key   udp_checksum       int     -  "UDP checksum, inline"
list  udp_payload        "the UDP payload, as octets"
list  ghc_payload        "a payload or header compressed by GHC (RFC 7400 bytecodes), as octets"
key   ghc_ext_eid        int     -  "GHC extension header NHC: the extension header ID (2 bits)"
key   ghc_ext_nh         int     -  "GHC extension header NHC: the NH bit"
key   ext_eid            int     -  "extension header NHC: 0 hop-by-hop, 1 routing, 2 fragment, 3 destination options, 4 mobility, 7 IPv6 header"
key   ext_nh             int     -  "extension header NHC NH: 0 the next header inline, 1 compressed by NHC"
key   ext_next_header    int     -  "extension header: the inline next header"
list  ext_header         "extension header: its octets after the length (the length counts octets, RFC 6282 section 4.2)"
list  after_ext          "what follows the extension header (an NHC header or the payload), as octets"
list  inner_packet       "extension header NHC with EID 7: the encapsulated IPHC-compressed IPv6 packet, as octets"
key   octet              int     -  "one octet"
