# The mqtt module: the fields of MQTT 3.1.1 and 5.0 control packets (OASIS). Written by
# tools/gen/messaging-pack.py; do not edit by hand. Strings are lists of their octets.
module        mqtt
version       0.1.0
distribution  public
source        "OASIS MQTT Version 3.1.1 and MQTT Version 5.0; restated by goat-transformers"
key   flags                       int     -  "the four flag bits of the fixed header (0 or 2 by packet type; PUBLISH has its own)"
key   remaining_length_c1         int     -  "Remaining Length: continuation bit of octet 1 (1 when another octet follows)"
key   remaining_length_c2         int     -  "Remaining Length: continuation bit of octet 2 (1 when another octet follows)"
key   remaining_length_c3         int     -  "Remaining Length: continuation bit of octet 3 (1 when another octet follows)"
key   remaining_length_v0         int     -  "Remaining Length: the 7 value bits of octet 1; the length is v0 + 128 v1 + 16384 v2 + 2097152 v3"
key   remaining_length_v1         int     -  "Remaining Length: the 7 value bits of octet 2; the length is v0 + 128 v1 + 16384 v2 + 2097152 v3"
key   remaining_length_v2         int     -  "Remaining Length: the 7 value bits of octet 3; the length is v0 + 128 v1 + 16384 v2 + 2097152 v3"
key   remaining_length_v3         int     -  "Remaining Length: the 7 value bits of octet 4; the length is v0 + 128 v1 + 16384 v2 + 2097152 v3"
key   octet                       int     -  "one octet"
list  protocol_name               "CONNECT: the protocol name, as its UTF-8 octets (MQTT)"
key   protocol_level              int     -  "CONNECT: protocol level, 4 for 3.1.1 and 5 for 5.0"
key   username_flag               int     -  "CONNECT: 1 when a user name is in the payload"
key   password_flag               int     -  "CONNECT: 1 when a password is in the payload"
key   will_retain                 int     -  "CONNECT: 1 when the will message is retained"
key   will_qos                    int     -  "CONNECT: QoS of the will message"
key   will_flag                   int     -  "CONNECT: 1 when the payload holds a will"
key   clean_start                 int     -  "CONNECT: clean session (3.1.1) or clean start (5.0)"
key   connect_reserved            int     -  "CONNECT: reserved flag, 0"
key   keep_alive                  int     s  "CONNECT: the longest gap in seconds between two packets from the client"
list  client_id                   "CONNECT: client identifier, as its UTF-8 octets"
list  will_topic                  "CONNECT: will topic, as its UTF-8 octets"
list  will_payload                "CONNECT: will message, as its octets"
list  username                    "CONNECT: user name, as its UTF-8 octets"
list  password                    "CONNECT: password, as its octets"
key   connack_reserved            int     -  "CONNACK: the seven reserved bits of the acknowledge flags, 0"
key   session_present             int     -  "CONNACK: 1 when the server holds a session for the client"
key   reason_code                 int     -  "return code (3.1.1 CONNACK) or reason code (5.0): below 128 success, 128 and above failure"
key   dup                         int     -  "PUBLISH: 1 when this may be a resend"
key   qos                         int     -  "PUBLISH: quality of service, 0, 1 or 2"
key   retain                      int     -  "PUBLISH: 1 when the server is to retain the message"
list  topic                       "PUBLISH: topic name, as its UTF-8 octets"
key   packet_id                   int     -  "packet identifier (PUBLISH with QoS above 0, the acknowledgements, SUBSCRIBE, UNSUBSCRIBE and their acknowledgements)"
list  payload                     "PUBLISH: the application message, as its octets"
list  subscriptions               "SUBSCRIBE: the topic filters and their options, in order"
list  unsubscriptions             "UNSUBSCRIBE: the topic filters, in order"
list  topic_filter                "a topic filter, as its UTF-8 octets"
key   options_reserved            int     -  "SUBSCRIBE: reserved bits of the options octet, 0"
key   retain_handling             int     -  "SUBSCRIBE (5.0): 0 send retained messages, 1 only for a new subscription, 2 never"
key   retain_as_published         int     -  "SUBSCRIBE (5.0): 1 when forwarded messages keep their RETAIN flag"
key   no_local                    int     -  "SUBSCRIBE (5.0): 1 when the client's own messages are not sent back to it"
key   requested_qos               int     -  "SUBSCRIBE: the highest QoS the client asks for"
list  reason_codes                "SUBACK, UNSUBACK: the return or reason codes, one per filter"
key   code                        int     -  "one return or reason code"
key   properties_length_c         int     -  "MQTT 5: continuation bit of the first octet of the packet's property length; 1 when the length takes more than one octet"
key   properties_length_low       int     -  "MQTT 5: when the packet's property length takes more than one octet, the 7 bits of its first octet"
list  properties                  "MQTT 5: the packet's properties, in order"
key   will_properties_length_c    int     -  "MQTT 5: continuation bit of the first octet of the will's property length; 1 when the length takes more than one octet"
key   will_properties_length_low  int     -  "MQTT 5: when the will's property length takes more than one octet, the 7 bits of its first octet"
list  will_properties             "MQTT 5: the will's properties, in order"
key   property_id                 int     -  "MQTT 5 property identifier (all identifiers of 5.0 take one octet)"
key   property_byte               int     -  "value of a property of one octet (identifiers 1, 23, 25, 36, 37, 40, 41, 42)"
key   property_u16                int     -  "value of a property of two octets (19, 33, 34, 35)"
key   property_u32                int     -  "value of a property of four octets (2, 17, 24, 39)"
list  property_string             "value of a UTF-8 string property (3, 8, 18, 21, 26, 28, 31), as its octets"
list  property_binary             "value of a binary property (9, 22), as its octets"
list  property_name               "user property (38): its name, as its UTF-8 octets"
list  property_value              "user property (38): its value, as its UTF-8 octets"
key   property_vbi_c1             int     -  "subscription identifier (11): continuation bit of octet 1"
key   property_vbi_c2             int     -  "subscription identifier (11): continuation bit of octet 2"
key   property_vbi_c3             int     -  "subscription identifier (11): continuation bit of octet 3"
key   property_vbi_v0             int     -  "subscription identifier (11): the 7 value bits of octet 1"
key   property_vbi_v1             int     -  "subscription identifier (11): the 7 value bits of octet 2"
key   property_vbi_v2             int     -  "subscription identifier (11): the 7 value bits of octet 3"
key   property_vbi_v3             int     -  "subscription identifier (11): the 7 value bits of octet 4"
list  property_rest               "a property of an identifier 5.0 does not define, and the properties after it, as octets"
list  packet_rest                 "MQTT 5: when a property length takes more than one octet, the rest of the packet from its second octet, as octets"
