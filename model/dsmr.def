# The dsmr module: values of the lines of a DSMR 5.0.2 P1 telegram.
module        dsmr
version       0.1.0
distribution  public
source        "DSMR 5.0.2 P1 Companion Standard (Dutch Smart Meter Requirements), Netbeheer Nederland WG DSMR, final, 26 February 2016, netbeheernederland.nl; no licence stated; layouts restated"
list  power_failure_log  "the entries of the power failure event log"
key   current_l1_a                   int    -  "instantaneous current L1, A"
key   current_l2_a                   int    -  "instantaneous current L2, A"
key   current_l3_a                   int    -  "instantaneous current L3, A"
key   end                            string -  "the end line as sent: '!' and the four hexadecimal digits of the CRC16 of the telegram (not checked)"
key   energy_delivered_tariff1_kwh   float  -  "meter reading, electricity delivered to the client, tariff 1, kWh"
key   energy_delivered_tariff2_kwh   float  -  "meter reading, electricity delivered to the client, tariff 2, kWh"
key   energy_returned_tariff1_kwh    float  -  "meter reading, electricity delivered by the client, tariff 1, kWh"
key   energy_returned_tariff2_kwh    float  -  "meter reading, electricity delivered by the client, tariff 2, kWh"
key   equipment_id                   string -  "equipment identifier, hexadecimal text, with its ')'"
key   header                         string -  "the header line as sent: '/', three letters of the manufacturer, the baud rate character and the identification"
key   long_power_failures            int    -  "number of long power failures in any phase"
key   mbus_capture_time              string -  "capture time of the M-Bus value as YYMMDDhhmmssX, local time"
key   mbus_channel                   int    -  "the M-Bus channel n of the OBIS code, 1 to 4"
key   mbus_device_type               int    -  "device type of the M-Bus device (F3(0,0))"
key   mbus_equipment_id              string -  "equipment identifier of the M-Bus device, hexadecimal text, with its ')'"
key   mbus_value                     string -  "the M-Bus value with its unit and ')', as sent (the width and unit depend on the medium)"
key   power_delivered_kw             float  -  "actual electricity power delivered (+P), kW"
key   power_delivered_l1_kw          float  -  "instantaneous active power L1 (+P), kW"
key   power_delivered_l2_kw          float  -  "instantaneous active power L2 (+P), kW"
key   power_delivered_l3_kw          float  -  "instantaneous active power L3 (+P), kW"
key   power_failure_duration         string -  "duration of a power failure with its unit and ')', as sent"
key   power_failure_end_time         string -  "end time of a power failure, YYMMDDhhmmssX local time, with its ')'"
key   power_failure_log_count        string -  "number of entries of the log, as sent with its ')'"
key   power_failure_log_id           string -  "OBIS code of the logged value, as sent with its ')'"
key   power_failures                 int    -  "number of power failures in any phase"
key   power_returned_kw              float  -  "actual electricity power received (-P), kW"
key   power_returned_l1_kw           float  -  "instantaneous active power L1 (-P), kW"
key   power_returned_l2_kw           float  -  "instantaneous active power L2 (-P), kW"
key   power_returned_l3_kw           float  -  "instantaneous active power L3 (-P), kW"
key   tariff_indicator               string -  "tariff indicator"
key   text_message                   string -  "text message, hexadecimal text, with its ')'"
key   timestamp                      string -  "date and time of the telegram as YYMMDDhhmmssX, local time, X S (summer) or W (winter)"
key   version                        string -  "version of the P1 output (S2)"
key   voltage_l1_v                   float  -  "instantaneous voltage L1, V"
key   voltage_l2_v                   float  -  "instantaneous voltage L2, V"
key   voltage_l3_v                   float  -  "instantaneous voltage L3, V"
key   voltage_sags_l1                int    -  "number of voltage sags in phase L1"
key   voltage_sags_l2                int    -  "number of voltage sags in phase L2"
key   voltage_sags_l3                int    -  "number of voltage sags in phase L3"
key   voltage_swells_l1              int    -  "number of voltage swells in phase L1"
key   voltage_swells_l2              int    -  "number of voltage swells in phase L2"
key   voltage_swells_l3              int    -  "number of voltage swells in phase L3"
