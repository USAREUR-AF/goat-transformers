# The ccsdstc module: the fields of the CCSDS TC Transfer Frame primary header, each as
# the wire integer. The pack ccsds-tc-frame maps them. Bit numbers count from 0 at the
# first transmitted bit.
module        ccsdstc
version       0.1.0
distribution  public
source        "CCSDS 232.0-B-4 TC Space Data Link Protocol, Blue Book, October 2021 with Technical Corrigendum 1 (October 2023), https://ccsds.org/Pubs/232x0b4e1c1.pdf, section 4.1.2; reuse with attribution under the CCSDS reproduction permission statement"
key  bypass_flag             int  -  "bit 2: 0 = type-A frame, subject to the receiver's frame acceptance checks; 1 = type-B frame, checks bypassed"
key  control_command_flag    int  -  "bit 3: 0 = the data field carries a frame data unit (type-D), 1 = control commands (type-C)"
key  spacecraft_id           int  -  "bits 6-15: spacecraft identifier, assigned by CCSDS"
key  virtual_channel_id      int  -  "bits 16-21: virtual channel identifier, 0-63"
key  frame_length            int  -  "bits 22-31: total octets of the frame, error control field included, minus one"
key  frame_sequence_number   int  -  "bits 32-39: frame sequence number N(S) of the virtual channel, modulo 256"
