# The nmea0183 module: values of NMEA 0183 sentences that the core module has
# no key for, in the units the sentences carry them. Written from the gpsd
# document "NMEA Revealed"; packs/nmea0183/pack.md states which sentence holds
# each key. Letter-coded fields (status, modes) hold the letter as sent.
module        nmea0183
version       0.2.0
distribution  public
source        "gpsd project, NMEA Revealed (www/NMEA.adoc, dated 12 July 2025), https://gitlab.com/gpsd/gpsd commit c59fc6de479d06620c8b2ba395b728e10a71527b; gpsd COPYING: BSD-2-Clause"
source        "pynmea2 (https://github.com/Knio/pynmea2, MIT License) at commit d8240dca51bd3f731b3fb7af8f0f9978c9b08f1a, pynmea2/types/talker.py: fields of the added sentences (GNS, HDM, HDG, THS, ROT, VHW, MWV, MWD, DBT, DPT, MTW, TTM, TLL, OSD, DTM)"
source        "gpsd drivers/driver_nmea0183.c (BSD-2-Clause) at commit c59fc6de479d06620c8b2ba395b728e10a71527b: units and meanings of the added sentences it handles"

# Every sentence
key  talker           string  -     "talker id: the first two characters of the tag (GP, GN, GL, GA, ...)"

# Time and validity
key  utc_s            float   s     "UTC time of day of the report, seconds since midnight (GGA, GLL, ZDA); no date"
key  status           string  -     "validity letter: A data valid, V void or warning (RMC, GLL)"
key  faa_mode         string  -     "FAA mode indicator letter, NMEA 2.3 and later (A, D, E, F, M, N, P, R, S, ...)"
key  nav_status       string  -     "navigational status letter of RMC, NMEA 4.1 and later"

# GGA fix data
key  quality          int     -     "GGA fix quality indicator (0 no fix, 1 GPS, 2 differential; 3 to 8 from NMEA 2.3)"
key  sats_used        int     -     "number of satellites in use (GGA)"
key  hdop             float   -     "horizontal dilution of precision (GGA, GSA)"
key  alt_msl_m        float   m     "antenna altitude above mean sea level (geoid), not above the ellipsoid (GGA)"
key  geoid_sep_m      float   m     "geoidal separation: height of mean sea level (geoid) above the WGS 84 ellipsoid, negative when below (GGA)"
key  dgps_age_s       float   s     "age of the differential correction data (GGA)"
key  dgps_station     int     -     "differential reference station id, 0 to 1023 (GGA)"

# Course and speed
key  sog_kn           float   kn    "speed over ground in knots (RMC, VTG)"
key  sog_kmh          float   km/h  "speed over ground in kilometres per hour (VTG)"
key  course_mag_deg   float   deg   "course over ground, degrees magnetic (VTG)"
key  magvar_deg       float   deg   "magnetic variation, unsigned degrees; magvar_dir gives the side (RMC)"
key  magvar_dir       string  -     "side of the magnetic variation: E or W (RMC)"
key  heading_true_deg float   deg   "heading of the vessel, degrees true; not the course over ground (HDT)"

# GSA
key  sel_mode         string  -     "GSA selection mode letter: M manual, A automatic"
key  fix_mode         int     -     "GSA fix mode: 1 no fix, 2 2D, 3 3D"
key  sat_used_01      int     -     "GSA: id of the 1st satellite used for the fix"
key  sat_used_02      int     -     "GSA: id of the 2nd satellite used for the fix"
key  sat_used_03      int     -     "GSA: id of the 3rd satellite used for the fix"
key  sat_used_04      int     -     "GSA: id of the 4th satellite used for the fix"
key  sat_used_05      int     -     "GSA: id of the 5th satellite used for the fix"
key  sat_used_06      int     -     "GSA: id of the 6th satellite used for the fix"
key  sat_used_07      int     -     "GSA: id of the 7th satellite used for the fix"
key  sat_used_08      int     -     "GSA: id of the 8th satellite used for the fix"
key  sat_used_09      int     -     "GSA: id of the 9th satellite used for the fix"
key  sat_used_10      int     -     "GSA: id of the 10th satellite used for the fix"
key  sat_used_11      int     -     "GSA: id of the 11th satellite used for the fix"
key  sat_used_12      int     -     "GSA: id of the 12th satellite used for the fix"
key  pdop             float   -     "position dilution of precision (GSA)"
key  vdop             float   -     "vertical dilution of precision (GSA)"
key  system_id        int     -     "GNSS system id, NMEA 4.11 (GSA)"

# GSV: one sentence of a group; the satellites are a list
key  gsv_total        int     -     "number of GSV sentences in this group"
key  gsv_number       int     -     "number of this GSV sentence within its group, from 1"
key  sats_in_view     int     -     "total number of satellites in view (GSV)"
list satellites                     "satellites described by one GSV sentence; each item holds sv_id, elevation_deg, azimuth_deg and snr_db"
key  sv_id            int     -     "item of satellites: satellite id or PRN number"
key  elevation_deg    int     deg   "item of satellites: elevation, -90 to 90"
key  azimuth_deg      int     deg   "item of satellites: azimuth from true north, 0 to 359"
key  snr_db           int     dB    "item of satellites: signal-to-noise ratio, 0 to 99; absent when the satellite is not tracked"

# ZDA
key  day              int     -     "UTC day of the month, 1 to 31 (ZDA)"
key  month            int     -     "UTC month, 1 to 12 (ZDA)"
key  year             int     -     "UTC year, four digits (ZDA)"
key  zone_hours       int     h     "local time zone offset, hours, -13 to 13 (ZDA)"
key  zone_minutes     int     min   "local time zone offset, minutes, same sign as zone_hours (ZDA)"

# Added sentences: GNS (with the GGA keys above), HDM, HDG, THS, ROT, VHW, MWV,
# MWD, DBT, DPT, MTW, TTM, TLL, OSD, DTM
key  gns_mode           string  -      "GNS mode letters, one per constellation (N no fix, A autonomous, D differential, ...)"
key  heading_mag_deg    float   deg    "heading of the vessel, degrees magnetic (HDM, VHW)"
key  heading_sensor_deg float   deg    "magnetic sensor heading, before deviation and variation are applied (HDG)"
key  deviation_deg      float   deg    "magnetic deviation, unsigned degrees; deviation_dir gives the side (HDG)"
key  deviation_dir      string  -      "side of the magnetic deviation: E or W (HDG)"
key  ths_mode           string  -      "THS heading mode letter (A autonomous, E estimated, M manual, S simulator, V not valid)"
key  rot_deg_min        float   deg/min "rate of turn, degrees per minute, negative when turning to port (ROT)"
key  stw_kn             float   kn     "speed through the water in knots; not over ground (VHW)"
key  stw_kmh            float   km/h   "speed through the water in kilometres per hour (VHW)"
key  wind_angle_deg     float   deg    "wind angle, 0 to 359, relative to the bow or true per wind_reference (MWV)"
key  wind_reference     string  -      "MWV reference letter: R relative, T true (theoretical)"
key  wind_speed         float   -      "wind speed in the unit wind_speed_unit names (MWV)"
key  wind_speed_unit    string  -      "MWV wind speed unit letter: K km/h, M m/s, N knots"
key  wind_dir_true_deg  float   deg    "wind direction, degrees from true north (MWD)"
key  wind_dir_mag_deg   float   deg    "wind direction, degrees from magnetic north (MWD)"
key  wind_speed_kn      float   kn     "wind speed in knots (MWD)"
key  wind_speed_ms      float   m/s    "wind speed in metres per second (MWD)"
key  dbt_depth_ft       float   ft     "depth below the transducer, feet (DBT)"
key  dbt_depth_m        float   m      "depth below the transducer, metres (DBT)"
key  dbt_depth_fathom   float   fathom "depth below the transducer, fathoms (DBT)"
key  dpt_depth_m        float   m      "water depth relative to the transducer, metres (DPT)"
key  dpt_offset_m       float   m      "offset of the transducer: positive to the waterline, negative to the keel (DPT)"
key  dpt_range_m        float   m      "maximum range scale in use, metres (DPT)"
key  water_temp         float   -      "water temperature in the unit water_temp_unit names (MTW)"
key  water_temp_unit    string  -      "MTW temperature unit letter: C degrees Celsius"
key  target_number      int     -      "number of the tracked target, 00 to 99 (TTM, TLL)"
key  target_distance    float   -      "target distance from own ship, in target_dist_unit (TTM)"
key  target_bearing_deg float   deg    "bearing of the target from own ship (TTM); true or relative per target_bearing_ref"
key  target_bearing_ref string  -      "TTM bearing reference letter: T true, R relative"
key  target_speed       float   -      "target speed in target_dist_unit per hour (TTM)"
key  target_course_deg  float   deg    "course of the tracked target (TTM); true or relative per target_course_ref"
key  target_course_ref  string  -      "TTM course reference letter: T true, R relative"
key  target_cpa_dist    float   -      "distance of the closest point of approach, in target_dist_unit (TTM)"
key  target_tcpa_min    float   min    "time to the closest point of approach, minutes, negative when past (TTM)"
key  target_dist_unit   string  -      "TTM distance and speed unit letter: K kilometres, N nautical miles, S statute miles"
key  target_status      string  -      "target status letter: L lost, Q acquiring, T tracking (TTM, TLL)"
key  target_reference   string  -      "R when the target is a reference target, else empty (TTM, TLL)"
key  target_acquisition string  -      "TTM acquisition letter: A automatic, M manual, R reported"
key  osd_course_deg     float   deg    "own ship course (OSD), with reference osd_course_ref"
key  osd_course_ref     string  -      "OSD course reference letter"
key  osd_speed          float   -      "own ship speed in osd_speed_unit (OSD), with reference osd_speed_ref"
key  osd_speed_ref      string  -      "OSD speed reference letter"
key  osd_set_deg        float   deg    "own ship set, degrees true (OSD)"
key  osd_drift          float   -      "own ship drift (speed of the set), in osd_speed_unit (OSD)"
key  osd_speed_unit     string  -      "OSD speed unit letter: K km/h, N knots, S statute miles per hour"
key  datum_local        string  -      "DTM local datum code (W84 WGS 84, W72 WGS 72, S85 SGS 85, P90 PE 90, 999 user defined)"
key  datum_subdivision  string  -      "DTM local datum subdivision code"
key  datum_lat_offset   string  -      "DTM latitude offset in minutes, as written"
key  datum_lat_dir      string  -      "DTM latitude offset side: N positive, S negative"
key  datum_lon_offset   string  -      "DTM longitude offset in minutes, as written"
key  datum_lon_dir      string  -      "DTM longitude offset side: E positive, W negative"
key  datum_alt_offset_m float   m      "DTM altitude offset, metres"
key  datum_reference    string  -      "DTM reference datum code"

# Proprietary sentences (packs/nmea0183/pack.md, "Proprietary sentences"): meanings from gpsd
# drivers/driver_nmea0183.c. A key whose unit or reference the driver does not state says so.
key  proprietary_tag        string  -      "tag of a proprietary sentence as sent: P, a three-letter manufacturer code and the vendor's sentence name"
key  pashr_pos_type         int     -      "PASHR,POS position type: 0 autonomous, 1 RTCM differential, 2 carrier-phase float, 3 carrier-phase fixed"
key  pashr_track_deg        float   deg    "PASHR,POS track, degrees; the reference is not stated"
key  pashr_climb            float   -      "PASHR,POS vertical speed as sent; the unit is not stated"
key  tdop                   float   -      "time dilution of precision (PASHR,POS, PGRMF)"
key  pashr_sat_count        int     -      "PASHR,SAT number of satellites listed"
key  pashr_snr              float   -      "PASHR,SAT signal strength of one satellite, as sent"
key  pashr_sat_used         string  -      "PASHR,SAT U when the satellite is used in the solution"
key  receiver_model         string  -      "receiver product, model or software text (PASHR,RID field 2, PGRMT field 1)"
key  receiver_version       string  -      "receiver firmware version (PASHR,RID)"
key  pgrme_hpe_m            float   m      "PGRME estimated horizontal position error, metres; the confidence level is not stated"
key  pgrme_vpe_m            float   m      "PGRME estimated vertical position error, metres; the confidence level is not stated"
key  pgrme_spe_m            float   m      "PGRME estimated spherical position error, metres; the confidence level is not stated"
key  gps_week               int     -      "GPS week number as sent (PGRMF)"
key  gps_tow_s              int     s      "GPS seconds of the week (PGRMF)"
key  leap_seconds           int     s      "GPS to UTC leap seconds (PGRMF)"
key  pgrmf_mode             string  -      "PGRMF mode letter: M manual, A automatic"
key  pgrmf_fix_type         int     -      "PGRMF fix type code: 0 no fix, 1 2D, 2 3D"
key  map_datum              string  -      "name of the map datum the receiver uses (PGRMM)"
key  pgrmt_rom_test         string  -      "PGRMT ROM checksum test: P pass, F fail"
key  pgrmt_receiver         string  -      "PGRMT receiver failure discrete: P pass, F fail"
key  pgrmt_stored           string  -      "PGRMT stored data: R retained, L lost"
key  pgrmt_clock            string  -      "PGRMT real-time clock: R retained, L lost"
key  pgrmt_oscillator       string  -      "PGRMT oscillator drift: P pass, F excessive drift"
key  pgrmt_collecting       string  -      "PGRMT data collection: C collecting, empty if not"
key  pgrmt_temp_c           string  -      "PGRMT sensor temperature in degrees C, as sent"
key  pgrmt_config           string  -      "PGRMT sensor configuration data: R retained, L lost"
key  pgrmz_alt_ft           int     ft     "PGRMZ altitude in feet; gpsd reads it as above mean sea level"
key  pgrmz_fix_mode         int     -      "PGRMZ fix mode: 1 no fix, 2 2D, 3 3D"
key  mtk_command            int     -      "PMTK001 number of the command acknowledged"
key  mtk_ack_flag           int     -      "PMTK001 result: 0 invalid, 1 unsupported, 2 valid but failed, 3 valid and succeeded"
key  mtk_tsip               int     -      "PMTK424 TSIP output: 0 off, 1 on"
key  mtk_antenna            int     -      "PMTK424 antenna detection: 0 off, 1 on"
key  mtk_pps                int     -      "PMTK424 PPS output: 0 off, 1 on"
key  mtk_pps_timing         int     -      "PMTK424 PPS timing: 0 always, 1 only with a position fix"
key  mtk_pps_width          int     -      "PMTK424 PPS pulse width in the receiver's clock units"
key  sirf_ehpe_m            float   m      "PSRFEPE estimated horizontal position error, metres"
key  sirf_evpe_m            float   m      "PSRFEPE estimated vertical position error, metres"
key  sirf_ehve              float   -      "PSRFEPE estimated horizontal velocity error, as sent"
key  sirf_ehe_deg           float   deg    "PSRFEPE estimated heading error, degrees"
key  rtk_age_s              float   s      "PSTI,030 age of the RTK corrections, seconds"
key  rtk_ratio              float   -      "PSTI,030 RTK ratio"
key  rtk_mode               string  -      "PSTI,032 and 035 mode letter: F or O float RTK, R fixed RTK"
key  baseline_east_m        float   m      "PSTI,032 and 035 east projection of the baseline, metres"
key  baseline_north_m       float   m      "PSTI,032 and 035 north projection of the baseline, metres"
key  baseline_up_m          float   m      "PSTI,032 and 035 up projection of the baseline, metres"
key  baseline_length_m      float   m      "PSTI,032 and 035 baseline length, metres"
key  baseline_course_deg    float   deg    "PSTI,032 and 035 baseline course, degrees true"
key  attitude_heading_deg   float   deg    "heading of the attitude solution, degrees (PSTI,036, PQTMINS); the reference is not stated"
key  attitude_pitch_deg     float   deg    "pitch, degrees (PSTI,036, PQTMINS)"
key  attitude_roll_deg      float   deg    "roll, degrees (PSTI,036, PQTMINS)"
key  isync_datetime         string  -      "PTNTA date and time, YYYYMMDDhhmmss as sent"
key  isync_osc_quality      int     -      "PTNTA oscillator quality: 0 warming up, 1 free run, 2 disciplined"
key  isync_pps_interval_ns  int     ns     "PTNTA interval from the reference PPS to the output PPS, nanoseconds"
key  isync_fine_phase_ns    int     ns     "PTNTA fine phase comparator, about nanoseconds"
key  isync_status           int     -      "PTNTA iSync status code (0 to 9)"
key  isync_gps_messages     int     -      "PTNTA GPS messages indicator (0 to 3)"
key  isync_transfer_quality int     -      "PTNTA date and time transfer quality (0 to 3)"
key  htm_heading            string  -      "PTNTHTM true heading in the compass's integer units, as sent"
key  htm_mag_status         string  -      "PTNTHTM magnetometer status letter"
key  htm_pitch              string  -      "PTNTHTM pitch in the compass's integer units, as sent"
key  htm_pitch_status       string  -      "PTNTHTM pitch status letter"
key  htm_roll               string  -      "PTNTHTM roll in the compass's integer units, as sent"
key  htm_roll_status        string  -      "PTNTHTM roll status letter"
key  htm_dip                string  -      "PTNTHTM dip angle in the compass's integer units, as sent"
key  htm_horizontal         string  -      "PTNTHTM relative magnitude of the horizontal field, as sent"
key  uptime_ms              int     ms     "milliseconds since the receiver started (PQTMGPS, PQTMINS, PQTMIMU)"
key  quectel_tow_s          float   s      "PQTMGPS GPS time of week, seconds"
key  heading_2d_deg         float   deg    "PQTMGPS 2D heading, degrees; the reference is not stated"
key  h_acc_m                float   m      "PQTMGPS horizontal accuracy estimate, metres"
key  quectel_fix_type       int     -      "PQTMGPS fix type: 0 no fix, 2 2D, 3 3D"
key  ins_solution           int     -      "PQTMINS solution type: 0 pitch and roll, 1 GNSS with attitude, 2 GNSS and dead reckoning, 3 dead reckoning only"
key  ins_height_m           float   m      "PQTMINS height, metres; whether above the ellipsoid or mean sea level is not stated"
key  ins_vel_north          float   -      "PQTMINS northward velocity; the unit is not stated"
key  ins_vel_east           float   -      "PQTMINS eastward velocity; the unit is not stated"
key  ins_vel_down           float   -      "PQTMINS downward velocity; the unit is not stated"
key  imu_acc_x_g            float   -      "PQTMIMU acceleration along x, in g"
key  imu_acc_y_g            float   -      "PQTMIMU acceleration along y, in g"
key  imu_acc_z_g            float   -      "PQTMIMU acceleration along z, in g"
key  imu_rate_x_dps         float   deg/s  "PQTMIMU angular rate about x, degrees per second"
key  imu_rate_y_dps         float   deg/s  "PQTMIMU angular rate about y, degrees per second"
key  imu_rate_z_dps         float   deg/s  "PQTMIMU angular rate about z, degrees per second"
key  imu_ticks              int     -      "PQTMIMU cumulative wheel ticks"
key  imu_tick_ms            int     ms     "PQTMIMU time of the last tick, as sent"
list pashr_satellites   "PASHR,SAT satellites, one item per satellite: sv_id, azimuth_deg, elevation_deg, pashr_snr, pashr_sat_used"

# Speed in the sentence's units and in the core unit. One knot is 1852 m per
# 3600 s; one km/h is 1000 m per 3600 s. Applied by `convert` only (engine-spec
# 0.6), so a same-format round trip keeps the sentence's own digits.
derive  speed_ms          scale:1852/3600  nmea0183.sog_kn
derive  speed_ms          scale:1000/3600  nmea0183.sog_kmh
derive  nmea0183.sog_kn   scale:3600/1852  speed_ms
derive  nmea0183.sog_kmh  scale:3600/1000  speed_ms
