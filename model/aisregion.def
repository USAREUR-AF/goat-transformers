# The aisregion module: St. Lawrence Seaway and USCG PAWSS AIS binary messages. Written by tools/gen/ais-regional-pack.py.
module        aisregion
version       0.1.0
distribution  public
source        "St. Lawrence Seaway AIS Data Messaging Formats and Specifications, Harmonized with U.S. Coast Guard PAWSS AIS Messages, Revision 4.1, April 9, 2010 (U.S. DOT Volpe Center for the SLSDC and SLSMC), https://greatlakes-seaway.com/wp-content/uploads/2020/05/Seaway-AIS-message-specifications-R41.pdf (sha256 79da3b8f29acf7543ff440903769a702c98bd7dc4dba438720c75150262b917d), no licence stated; layout restated"
key   reserved           int     -  "the 2 reserved bits after the FI"
key   message_id         int     -  "the Seaway message ID within the FI (FI 1: 1 weather, 2 wind, 3 water level, 4 hydro current, 5 hydro salinity and temperature, 6 water flow; FI 2: 1 lockage order, 2 estimated lock times; FI 32: 1 version)"
key   month              int     -  "time tag month, UTC; month 1-12 (0 not available), day 1-31 (0), hour 0-23 (24), minute 0-59 (60)"
key   day                int     -  "time tag day"
key   hour               int     -  "time tag hour"
key   minute             int     -  "time tag minute"
list  reports            "FI 1: the station reports, 1 to 6 (1 to 4 for weather), to the end of the payload"
key   station_id         string  -  "station ID, seven six-bit characters"
key   lon                int     -  "longitude, thousandths of a minute, signed, east positive; 181 degrees not available"
key   lat                int     -  "latitude, thousandths of a minute, signed, north positive; 91 degrees not available"
key   wind_speed         int     -  "average wind speed, tenths of a knot; 1022 is 102.2 knots or more, 1023 not available"
key   wind_gust          int     -  "wind gust, tenths of a knot; 1022 is 102.2 knots or more, 1023 not available"
key   wind_dir           int     -  "wind direction, degrees (quantized to 16 points by the Seaway); 511 not available"
key   pressure           int     -  "atmospheric pressure, tenths of a millibar; 16383 not available"
key   air_temp           int     -  "air temperature, tenths of a degree Celsius, signed; -512 not available"
key   dew_point          int     -  "dew point, tenths of a degree Celsius, signed; -512 not available"
key   visibility         int     -  "visibility, tenths of a kilometre; 254 is 25.4 km or more, 255 not available"
key   water_temp         int     -  "water temperature, tenths of a degree Celsius, signed; -512 not available"
key   report_spare       int     -  "the reserved bits at the end of a report"
key   level_type         int     -  "water level type: 0 relative to the datum, 1 water depth"
key   level              int     -  "water level, centimetres, signed; -32768 not available"
key   level_datum        int     -  "reference datum: 0 MLLW, 1 IGLD-85"
key   reading_type       int     -  "reading type: 0 average of actual readings, 1 estimated from adjacent sensors"
key   current_speed      int     -  "PAWSS current speed, tenths of a knot"
key   current_dir        int     -  "PAWSS current direction (travelling toward), degrees"
key   salinity           int     -  "PAWSS salinity, tenths of a practical salinity unit"
key   water_flow         int     -  "water flow, cubic metres per second; 16383 not available"
key   lock_id            string  -  "lockage order: the lock, seven six-bit characters"
key   lock_spare         int     -  "lockage order: the 9 reserved bits before the schedule"
list  schedule           "lockage order: the lock schedule reports, 1 to 6"
key   vessel_name        string  -  "vessel name, fifteen six-bit characters"
key   upbound            int     -  "lock schedule: 1 upbound, 0 downbound"
key   eta_month          int     -  "lock schedule ETA month"
key   eta_day            int     -  "lock schedule ETA day"
key   eta_hour           int     -  "lock schedule ETA hour"
key   eta_minute         int     -  "lock schedule ETA minute"
key   schedule_spare     int     -  "lock schedule: the 9 reserved bits"
key   last_location      string  -  "estimated lock times: the last location, seven six-bit characters"
key   ata_month          int     -  "estimated lock times: last ATA month"
key   ata_day            int     -  "last ATA day"
key   ata_hour           int     -  "last ATA hour"
key   ata_minute         int     -  "last ATA minute"
key   first_lock         string  -  "estimated lock times: the first lock, seven six-bit characters"
key   first_eta_month    int     -  "first lock ETA month"
key   first_eta_day      int     -  "first lock ETA day"
key   first_eta_hour     int     -  "first lock ETA hour"
key   first_eta_minute   int     -  "first lock ETA minute"
key   second_lock        string  -  "estimated lock times: the second lock, seven six-bit characters"
key   second_eta_month   int     -  "second lock ETA month"
key   second_eta_day     int     -  "second lock ETA day"
key   second_eta_hour    int     -  "second lock ETA hour"
key   second_eta_minute  int     -  "second lock ETA minute"
key   delay_lock         string  -  "estimated lock times: the first lock where a vessel is delayed, seven six-bit characters"
key   locktimes_spare    int     -  "estimated lock times: the 4 reserved bits"
key   major_version      int     -  "version message: major revision of the specification in use"
key   minor_version      int     -  "version message: minor revision"
key   version_spare      int     -  "version message: the 8 reserved bits"
