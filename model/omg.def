# The omg module: members of OpenMQTTGateway's BTtoMQTT and RFtoMQTT payloads.
module        omg
version       0.1.0
distribution  public
source        "OpenMQTTGateway (https://github.com/1technophile/OpenMQTTGateway, GPL-3.0) release v1.9.1, commit 1b28de93a4853020e4ad39c4a25562c23218d818: main/gatewayBT.cpp and main/gatewayRF.cpp (the JSON members of BTtoMQTT and RFtoMQTT); member names restated, no code copied"
key   bt_adv_type                              int    -  "advertisement type"
key   bt_batt                                  float  -  "battery, percent (decoded)"
key   bt_brand                                 string -  "brand, as the decoder names it"
key   bt_hum                                   float  -  "humidity, percent (decoded)"
key   bt_id                                    string -  "MAC address of the BLE device"
key   bt_mac_type                              int    -  "address type"
key   bt_manufacturerdata                      string -  "manufacturer data, hexadecimal"
key   bt_model                                 string -  "model, as the decoder names it"
key   bt_model_id                              string -  "model id of the decoder"
key   bt_name                                  string -  "advertised name"
key   bt_rssi                                  int    -  "received signal strength, dBm"
key   bt_servicedata                           string -  "service data, hexadecimal"
key   bt_servicedatauuid                       string -  "UUID of the service data"
key   bt_tempc                                 float  -  "temperature, degrees C (decoded)"
key   bt_tempf                                 float  -  "temperature, degrees F (decoded)"
key   bt_txpower                               int    -  "advertised transmit power, dBm"
key   bt_type                                  string -  "device type of the decoder"
key   bt_volt                                  float  -  "battery voltage, V (decoded)"
key   rf_binary                                string -  "code as binary text"
key   rf_delay                                 int    -  "pulse length, microseconds"
key   rf_frequency                             float  -  "receiver frequency, MHz"
key   rf_length                                int    -  "code length, bits"
key   rf_protocol                              int    -  "RCSwitch protocol number"
key   rf_raw                                   string -  "raw timings"
key   rf_tre_state                             string -  "code as tri-state text"
key   rf_value                                 int    -  "received code value"
