# The sbas module: the fields of SBAS L1 messages as RTKLIB decodes them. Generated by
# tools/gen/sbas2pack.py.
module        sbas
version       0.1.0
distribution  public
source        "RTKLIB, https://github.com/tomojitakasu/RTKLIB commit 71db0ffa0d9735697c6adfd06fdf766d0e5ce807, src/sbas.c (sha256 73eeed8538cc78112d0addc2ca9c86a381ce497a9657cf220ff2362f9cfa64e2); BSD 2-Clause License, Copyright (c) 2007-2013 T. Takasu (readme.txt)"
key  preamble  int  -  "the 8-bit preamble: 0x53, 0x9A and 0xC6 in turn, one per message"
key  crc  int  -  "the 24-bit CRC-24Q of the 226 bits before it; carried, not computed"
key  iodp  int  -  "issue of data of the PRN mask the message refers to"
key  iodf  int  -  "issue of data of the fast corrections"
key  mask_bit  int  -  "item of prn_mask: 1 when the slot (item index + 1) is monitored: 1-37 GPS, 38-61 GLONASS, 120-138 SBAS, 183-202 QZSS as RTKLIB reads them"
key  prc_m  float  m  "fast correction (pseudorange correction) of a monitored satellite, 0.125 m steps"
key  udrei  int  -  "user differential range error indicator, a code 0 to 15 (14 not monitored, 15 do not use)"
key  iodf_2  int  -  "type 6: issue of data of the fast corrections of type 2"
key  iodf_3  int  -  "type 6: issue of data of the fast corrections of type 3"
key  iodf_4  int  -  "type 6: issue of data of the fast corrections of type 4"
key  iodf_5  int  -  "type 6: issue of data of the fast corrections of type 5"
key  latency_s  int  s  "type 7: system latency t_lat, seconds"
key  spare  int  -  "spare bits, as sent"
key  ai  int  -  "item of degradation_factors: fast correction degradation factor indicator, a code 0 to 15"
key  geo_reserved  int  -  "type 9: the 8 bits before t0, which RTKLIB does not read"
key  geo_t0_s  int  s  "type 9: time of applicability, seconds of the GPS day (16 s steps)"
key  geo_ura  int  -  "type 9: user range accuracy index (15: do not use)"
key  geo_x_m  float  m  "type 9: GEO position X, earth-centred earth-fixed, 0.08 m steps"
key  geo_y_m  float  m  "type 9: GEO position Y, 0.08 m steps"
key  geo_z_m  float  m  "type 9: GEO position Z, 0.4 m steps"
key  geo_vx_ms  float  m/s  "type 9: GEO velocity X, 0.000625 m/s steps"
key  geo_vy_ms  float  m/s  "type 9: GEO velocity Y, 0.000625 m/s steps"
key  geo_vz_ms  float  m/s  "type 9: GEO velocity Z, 0.004 m/s steps"
key  geo_ax_mss  float  m/s^2  "type 9: GEO acceleration X, 0.0000125 m/s^2 steps"
key  geo_ay_mss  float  m/s^2  "type 9: GEO acceleration Y, 0.0000125 m/s^2 steps"
key  geo_az_mss  float  m/s^2  "type 9: GEO acceleration Z, 0.0000625 m/s^2 steps"
key  geo_af0_s  float  s  "type 9: GEO clock offset, 2^-31 s steps"
key  geo_af1_ss  float  s/s  "type 9: GEO clock drift, 2^-40 s/s steps"
key  band_count  int  -  "type 18: number of IGP bands being broadcast"
key  band  int  -  "types 18 and 26: IGP band number, 0 to 10"
key  iodi  int  -  "types 18 and 26: issue of data of the ionospheric grid point mask"
key  igp_bit  int  -  "item of igp_mask: 1 when the ionospheric grid point (item index + 1) of the band is monitored"
key  block  int  -  "type 24: block of 13 satellites the fast corrections are for; type 26: block of 15 grid points"
key  vel_code  int  -  "long-term correction half: velocity code, 0 position only for two satellites, 1 position and velocity for one"
key  sat1_slot  int  -  "velocity code 0, first satellite: PRN mask number (1-51), 0 none"
key  sat1_iode  int  -  "velocity code 0, first satellite: issue of data of the ephemeris"
key  sat1_dx_m  float  m  "velocity code 0, first satellite: delta X, 0.125 m steps"
key  sat1_dy_m  float  m  "velocity code 0, first satellite: delta Y, 0.125 m steps"
key  sat1_dz_m  float  m  "velocity code 0, first satellite: delta Z, 0.125 m steps"
key  sat1_daf0_s  float  s  "velocity code 0, first satellite: clock offset correction, 2^-31 s steps"
key  sat2_slot  int  -  "velocity code 0, second satellite: PRN mask number"
key  sat2_iode  int  -  "velocity code 0, second satellite: issue of data of the ephemeris"
key  sat2_dx_m  float  m  "velocity code 0, second satellite: delta X"
key  sat2_dy_m  float  m  "velocity code 0, second satellite: delta Y"
key  sat2_dz_m  float  m  "velocity code 0, second satellite: delta Z"
key  sat2_daf0_s  float  s  "velocity code 0, second satellite: clock offset correction"
key  lt_slot  int  -  "velocity code 1: PRN mask number of the satellite"
key  lt_iode  int  -  "velocity code 1: issue of data of the ephemeris"
key  lt_dx_m  float  m  "velocity code 1: delta X, 0.125 m steps"
key  lt_dy_m  float  m  "velocity code 1: delta Y"
key  lt_dz_m  float  m  "velocity code 1: delta Z"
key  lt_daf0_s  float  s  "velocity code 1: clock offset correction, 2^-31 s steps"
key  lt_ddx_ms  float  m/s  "velocity code 1: delta X rate, 2^-11 m/s steps"
key  lt_ddy_ms  float  m/s  "velocity code 1: delta Y rate"
key  lt_ddz_ms  float  m/s  "velocity code 1: delta Z rate"
key  lt_daf1_ss  float  s/s  "velocity code 1: clock drift correction, 2^-39 s/s steps"
key  lt_t0_s  int  s  "velocity code 1: time of applicability, seconds of the GPS day (16 s steps)"
key  giv_delay_m  float  m  "item of grid_points: vertical delay estimate at the grid point, 0.125 m steps; 511 (not monitored) is absent"
key  givei  int  -  "item of grid_points: grid ionospheric vertical error indicator, a code 0 to 15"
list prn_mask  "type 1: the 210 slots of the PRN mask, one item each"
list fast_corrections  "fast corrections of the satellites of the message, in PRN mask order"
list udreis  "UDREIs of the satellites of the message, in PRN mask order"
list degradation_factors  "type 7: the 51 degradation factor indicators, in PRN mask order"
list igp_mask  "type 18: the 201 grid points of the band, one item each"
list long_term  "long-term correction halves of the message (106 bits each)"
list grid_points  "type 26: the 15 grid points of the block"
