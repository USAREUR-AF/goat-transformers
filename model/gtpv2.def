# The gtpv2 module: the fields of GTPv2-C messages (3GPP TS 29.274). Written by tools/gen/gtp-pack.py.
module        gtpv2
version       0.1.0
distribution  public
source        "ETSI TS 129 274 V19.6.0 (3GPP TS 29.274 Release 19); restated by goat-transformers; no licence stated"
key   flag_p            int     -  "P: 1 when another GTP-C message is piggybacked after this one"
key   flag_t            int     -  "T: 1 when the header holds a TEID (0 for echo and version not supported)"
key   flag_mp           int     -  "MP: 1 when the header holds a message priority"
key   flags_spare       int     -  "the two spare bits of the first octet"
key   message_type      int     -  "message type: 1 echo request, 2 echo response, 32 create session request, 33 create session response, 34 modify bearer request, 35 modify bearer response, 36 delete session request, 37 delete session response, ..."
key   teid              int     -  "tunnel endpoint identifier (the header's, or an F-TEID's)"
key   sequence          int     -  "sequence number, 24 bits"
key   message_priority  int     -  "message priority, 0 highest to 15"
list  ies               "the IEs of the message, in order"
list  grouped_ies       "the IEs inside a grouped IE (Bearer Context, PDN Connection, SCEF PDN Connection), in order"
key   ie_type           int     -  "IE type: 1 IMSI, 2 Cause, 3 Recovery, 73 EBI, 87 F-TEID, 93 Bearer Context, ..."
key   ie_spare          int     -  "the four spare bits before the instance"
key   instance          int     -  "instance, telling apart IEs of the same type in one message"
list  imsi_digits       "IMSI: the digits, two per octet (TBCD); a 15-digit IMSI ends with the filler 15"
key   digit_even        int     -  "IMSI: the high nibble of an octet, the later digit (15 for the filler)"
key   digit_odd         int     -  "IMSI: the low nibble of an octet, the earlier digit"
key   cause             int     -  "Cause: cause value (16 request accepted, 64 context not found, ...)"
key   cause_spare       int     -  "Cause: the five spare bits"
key   cause_pce         int     -  "Cause: PCE, the cause comes from the PDN connection"
key   cause_bce         int     -  "Cause: BCE, the cause comes from a bearer context"
key   cause_cs          int     -  "Cause: CS, the cause comes from the remote node, not this one"
list  offending_ie      "Cause: the type, length and instance of the offending IE, as octets"
key   restart_counter   int     -  "Recovery: restart counter"
key   ebi_spare         int     -  "EBI: the four spare bits"
key   ebi               int     -  "EPS bearer ID, 5 to 15"
key   fteid_v4          int     -  "F-TEID: 1 when an IPv4 address follows"
key   fteid_v6          int     -  "F-TEID: 1 when an IPv6 address follows"
key   interface_type    int     -  "F-TEID: interface type (0 S1-U eNodeB GTP-U, 1 S1-U SGW GTP-U, ..., 10 S11 MME GTP-C, 11 S11/S4 SGW GTP-C, ...)"
key   ipv4              int     -  "F-TEID: IPv4 address, as an unsigned 32-bit integer"
key   ipv6              string  -  "F-TEID: IPv6 address, 32 hexadecimal digits"
list  extra             "octets after the defined fields of an extendable IE"
list  ie_value          "value of an IE the pack does not lay out, as octets"
key   octet             int     -  "one octet"
