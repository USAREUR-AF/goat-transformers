# The cat009 module: the values of ASTERIX Category 009 (Composite Weather Reports), edition 2.1,
# as the category holds them. Used by the pack `asterix-cat009`. Generated by
# tools/gen/asterix2pack.py; do not edit by hand. A key is named after its item
# and subitems; a repetitive item is a list and its keys are the keys of one
# repetition.
module        cat009
version       0.1.0
distribution  public
source        "ASTERIX Category 009, Composite Weather Reports, edition 2.1 (2014-10-22), as transcribed in github.com/zoranbosnjak/asterix-specs (BSD-3-Clause), commit 64e9ffba964b92a1af3157bc6bdf7852a63bf700, specs/cat009/cats/cat2.1/definition.json. The category is specified by EUROCONTROL"
key   i010_sac  int     -       "I009/010/SAC: System Area Code (Data Source Identifier)"
key   i010_sic  int     -       "I009/010/SIC: System Identification Code (Data Source Identifier)"
key   i000      int     -       "I009/000: Message Type. 2 = Cartesian vector, 253 = Intermediate-update-step message, 254 = Start-of-picture message, 255 = End-of-picture message"
key   i020_org  int     -       "I009/020/ORG (Vector Qualifier). 0 = Local Coordinates, 1 = System Coordinates"
key   i020_i    int     -       "I009/020/I: Intensity Level (Vector Qualifier)"
key   i020_s    int     -       "I009/020/S: Shading Orientation with Respect to North (Vector Qualifier). 0 = 0 deg, 1 = 22.5 deg, 2 = 45 deg, 3 = 67.5 deg, 4 = 90 deg, 5 = 112.5 deg, 6 = 135 deg, 7 = 157.5 deg"
list  i030      "I009/030: Sequence of Cartesian Vectors, one item per repetition"
key   i030_x    int     -       "I009/030/X: X-coordinate (Sequence of Cartesian Vectors)"
key   i030_y    int     -       "I009/030/Y: Y-coordinate (Sequence of Cartesian Vectors)"
key   i030_l    int     -       "I009/030/L: Vector Length (Sequence of Cartesian Vectors)"
key   i060_sn   int     -       "I009/060/SN: Step Number (Synchronisation/Control Signal)"
key   i070      float   s       "I009/070: Time of Day. LSB 1/128 s"
key   i080_f    int     -       "I009/080/F: Scaling Factor (Processing Status)"
key   i080_r    int     -       "I009/080/R: Current Reduction Stage in Use (Processing Status)"
key   i080_q    int     -       "I009/080/Q: Processing Parameters (Processing Status)"
list  i090      "I009/090: Radar Configuration and Status, one item per repetition"
key   i090_sac  int     -       "I009/090/SAC: SAC of Radar Concerned (Radar Configuration and Status)"
key   i090_sic  int     -       "I009/090/SIC: SIC of Radar Concerned (Radar Configuration and Status)"
key   i090_cp   int     -       "I009/090/CP: Circular Polarisation (Radar Configuration and Status)"
key   i090_wo   int     -       "I009/090/WO: Weather Channel Overload (Radar Configuration and Status)"
key   i090_r    int     -       "I009/090/R: Reduction Step in Use By Radar Concerned (Radar Configuration and Status)"
key   i100      int     -       "I009/100: Vector Count"
# Derived keys (engine-spec 0.6 and 0.8), applied by `convert` between decode and encode.
derive  cat009.i070  day_seconds  time_ms
