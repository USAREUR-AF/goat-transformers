key  center      string  -    "tazType.@center (positionType, xs:string) at @center; an item of 1 group"
key  color       string  -    "tazType.@color (colorType, xs:string) at @color; an item of 1 group"
key  edges       string  -    "tazType.@edges (xs:string) at @edges; an item of 1 group"
key  fill        string  -    "tazType.@fill (boolType, xs:string) at @fill; an item of 1 group"
key  id          string  -    "tazType.@id (xs:string) at @id; an item of 3 groups"
key  key         string  -    "paramType.@key (xs:string) at @key; an item of 1 group"
key  name        string  -    "tazType.@name (xs:string) at @name; an item of 1 group"
key  shape       string  -    "tazType.@shape (shapeType, xs:string) at @shape; an item of 1 group"
key  value       string  -    "paramType.@value (xs:string) at @value; an item of 1 group"
key  weight      string  -    "tazSubType.@weight (floatType, xs:string) at @weight; an item of 2 groups"
list param       "tazType.param (paramType), repeated, at param; 1 group"
list taz         "tazsType.taz (tazType), repeated, at taz; 1 group"
list taz_sink    "tazType.tazSink (tazSubType), repeated, at tazSink; 1 group"
list taz_source  "tazType.tazSource (tazSubType), repeated, at tazSource; 1 group"
