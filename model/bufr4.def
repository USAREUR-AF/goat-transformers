# The bufr4 module: the fields of a BUFR edition 4 message that the bufr4 pack reads.
module        bufr4
version       0.1.0
distribution  public
source        "ecCodes BUFR section definitions (Apache-2.0) and WMO BUFR edition 4 tables (wmo-im/BUFR4, MIT); restated by goat-transformers"
key   master_table                  int  -  "section 1: BUFR master table (0 meteorology)"
key   centre                        int  -  "section 1: originating centre (common code table C-11)"
key   sub_centre                    int  -  "section 1: originating sub-centre"
key   update_sequence_number        int  -  "section 1: update sequence number (0 for an original message)"
key   optional_section              int  -  "section 1: 1 when section 2 is present"
key   section1_flags_low            int  -  "section 1: the seven other bits of the flag octet (0)"
key   data_category                 int  -  "section 1: data category (BUFR Table A: 0 surface data on land, 2 vertical soundings, ...)"
key   international_sub_category    int  -  "section 1: international data sub-category (common code table C-13)"
key   local_sub_category            int  -  "section 1: local data sub-category"
key   master_table_version          int  -  "section 1: version of the master table"
key   local_table_version           int  -  "section 1: version of the local tables"
key   year                          int  -  "section 1: typical time of the data, year (not composed into time_ms: pack.md)"
key   month                         int  -  "section 1: typical time, month"
key   day                           int  -  "section 1: typical time, day"
key   hour                          int  -  "section 1: typical time, hour"
key   minute                        int  -  "section 1: typical time, minute"
key   second                        int  -  "section 1: typical time, second"
list  section1_local                       "section 1: octets after the second, for local use"
key   section1_local_octet          int  -  "one of those octets"
key   section2_reserved             int  -  "section 2: reserved octet"
list  section2_data                        "section 2: data for local use, as octets"
key   section2_octet                int  -  "one octet of section 2"
key   section3_reserved             int  -  "section 3: reserved octet"
key   number_of_subsets             int  -  "section 3: number of data subsets"
key   observed_data                 int  -  "section 3: 1 for observed data, 0 for other data"
key   compressed_data               int  -  "section 3: 1 for compressed data"
key   section3_flags_low            int  -  "section 3: the six other bits of the flag octet (0)"
list  descriptors                          "section 3: the descriptors that define the data, in order"
key   descriptor_f                  int  -  "descriptor F: 0 element (Table B), 1 replication, 2 operator (Table C), 3 sequence (Table D)"
key   descriptor_x                  int  -  "descriptor X: class or operator"
key   descriptor_y                  int  -  "descriptor Y: entry within the class"
key   section4_reserved             int  -  "section 4: reserved octet"
list  data                                 "section 4: the data bits, as octets (decoding them needs the descriptors expanded)"
key   data_octet                    int  -  "one octet of section 4"
