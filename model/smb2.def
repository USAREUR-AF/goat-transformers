# The smb2 module: SMB2/3 header and command fields ([MS-SMB2]). Written by tools/gen/remote-pack.py.
module        smb2
version       0.1.0
distribution  public
source        "Microsoft, [MS-SMB2]: Server Message Block (SMB) Protocol Versions 2 and 3, revision 88.0, 2026-09-28, sections 2.2.1, 2.2.2-2.2.14, 2.2.41 and 2.2.42, https://winprotocoldocs-bhdugrdyduf5h2e4.b02.azurefd.net/MS-SMB2/%5bMS-SMB2%5d.pdf (sha256 fef3a06507679130a8cfdcaeaed581482d7f235435dd904f6c794f113ff04bd1), Microsoft Open Specifications copyright permission; layout restated"
key   structure_size_header             int     -  "header StructureSize, 64"
key   credit_charge                     int     -  "credits the request consumes"
key   status                            int     -  "response: the NT status (0 success, 0xC0000016 more processing required ...); request: channel sequence and reserved"
key   command                           int     -  "command (0 NEGOTIATE, 1 SESSION_SETUP, 2 LOGOFF, 3 TREE_CONNECT, 4 TREE_DISCONNECT, 5 CREATE, 6 CLOSE, 8 READ, 9 WRITE, 11 IOCTL ...)"
key   credits                           int     -  "credits requested (request) or granted (response)"
key   response                          int     -  "flag SERVER_TO_REDIR: the message is a response"
key   async                             int     -  "flag ASYNC_COMMAND: the header is the async form"
key   related                           int     -  "flag RELATED_OPERATIONS: a related operation in a compound"
key   signed                            int     -  "flag SIGNED"
key   priority                          int     -  "flags PRIORITY_MASK (SMB 3.1.1): the I/O priority, 0-7"
key   flags_bits7_27                    int     -  "flag bits 7-27, unused"
key   dfs_operation                     int     -  "flag DFS_OPERATIONS"
key   replay_operation                  int     -  "flag REPLAY_OPERATION (SMB 3.x)"
key   flags_bits30_31                   int     -  "flag bits 30-31, unused"
key   next_command                      int     -  "offset of the next header in a compound, 0 for the last"
key   message_id                        int     -  "message ID"
key   async_id                          int     -  "async header: async ID"
key   reserved_sync                     int     -  "sync header: the reserved 32 bits (process ID)"
key   tree_id                           int     -  "sync header: tree ID"
key   session_id                        int     -  "session ID"
key   signature                         string  -  "signature, as hexadecimal digits, each octet low nibble first (0 when not signed)"
key   structure_size                    int     -  "the command's StructureSize (fixed by the command and direction)"
key   security_mode                     int     -  "NEGOTIATE: security mode (1 signing enabled, 2 signing required)"
key   security_mode8                    int     -  "SESSION_SETUP request: security mode"
key   reserved16                        int     -  "a 16-bit reserved field"
key   reserved8                         int     -  "an 8-bit reserved field"
key   reserved32                        int     -  "a 32-bit reserved field"
key   reserved64                        int     -  "a 64-bit reserved field"
key   capabilities                      int     -  "capabilities (1 DFS, 2 leasing, 4 large MTU, 8 multi-channel, 0x10 persistent handles, 0x20 directory leasing, 0x40 encryption)"
key   client_guid                       string  -  "NEGOTIATE request: client GUID, as hexadecimal digits, each octet low nibble first (the pack is bit_order lsb)"
key   negotiate_context_or_start_time   int     -  "NEGOTIATE request: negotiate context offset, count and reserved (3.1.1), or client start time, as one 64-bit value"
list  dialects                          "NEGOTIATE request: the dialects (their count is written from the list)"
key   dialect                           int     -  "a dialect (0x0202, 0x0210, 0x0300, 0x0302, 0x0311)"
key   dialect_revision                  int     -  "NEGOTIATE response: the selected dialect"
key   negotiate_context_count           int     -  "NEGOTIATE response: negotiate context count (3.1.1) or reserved"
key   server_guid                       string  -  "NEGOTIATE response: server GUID, as hexadecimal digits, each octet low nibble first (the pack is bit_order lsb)"
key   max_transact_size                 int     -  "NEGOTIATE response: maximum transact size"
key   max_read_size                     int     -  "NEGOTIATE response: maximum read size"
key   max_write_size                    int     -  "NEGOTIATE response: maximum write size"
key   system_time                       int     -  "NEGOTIATE response: system time, FILETIME (100 ns since 1601-01-01 UTC)"
key   server_start_time                 int     -  "NEGOTIATE response: server start time, FILETIME"
key   security_buffer_offset            int     -  "security buffer offset from the header start"
key   security_buffer_length            int     -  "security buffer length"
key   negotiate_context_offset          int     -  "NEGOTIATE response: negotiate context offset (3.1.1) or reserved"
key   session_setup_flags               int     -  "SESSION_SETUP request: flags (1 binding)"
key   channel                           int     -  "SESSION_SETUP request: channel, 0"
key   previous_session_id               int     -  "SESSION_SETUP request: previous session ID"
key   session_flags                     int     -  "SESSION_SETUP response: session flags (1 guest, 2 null, 4 encrypt data)"
key   tree_connect_flags                int     -  "TREE_CONNECT request: flags (3.1.1) or reserved"
key   path_offset                       int     -  "TREE_CONNECT request: path offset"
key   path_length                       int     -  "TREE_CONNECT request: path length, octets"
key   share_type                        int     -  "TREE_CONNECT response: share type (1 disk, 2 pipe, 3 print)"
key   share_flags                       int     -  "TREE_CONNECT response: share flags"
key   share_capabilities                int     -  "TREE_CONNECT response: share capabilities"
key   maximal_access                    int     -  "TREE_CONNECT response: maximal access mask"
key   security_flags                    int     -  "CREATE request: security flags, 0"
key   requested_oplock_level            int     -  "CREATE request: requested oplock level"
key   impersonation_level               int     -  "CREATE request: impersonation level"
key   smb_create_flags                  int     -  "CREATE request: SmbCreateFlags, 0"
key   desired_access                    int     -  "CREATE request: desired access mask"
key   file_attributes                   int     -  "CREATE: file attributes"
key   share_access                      int     -  "CREATE request: share access (1 read, 2 write, 4 delete)"
key   create_disposition                int     -  "CREATE request: disposition (0 supersede, 1 open, 2 create, 3 open if, 4 overwrite, 5 overwrite if)"
key   create_options                    int     -  "CREATE request: create options"
key   name_offset                       int     -  "CREATE request: name offset"
key   name_length                       int     -  "CREATE request: name length, octets"
key   create_contexts_offset            int     -  "CREATE: create contexts offset"
key   create_contexts_length            int     -  "CREATE: create contexts length"
key   oplock_level                      int     -  "CREATE response: oplock level granted"
key   create_response_flags             int     -  "CREATE response: flags"
key   create_action                     int     -  "CREATE response: action taken (0 superseded, 1 opened, 2 created, 3 overwritten)"
key   creation_time                     int     -  "CREATE response: creation time, FILETIME"
key   last_access_time                  int     -  "CREATE response: last access time, FILETIME"
key   last_write_time                   int     -  "CREATE response: last write time, FILETIME"
key   change_time                       int     -  "CREATE response: change time, FILETIME"
key   allocation_size                   int     -  "CREATE response: allocation size"
key   end_of_file                       int     -  "CREATE response: end of file"
key   file_id_persistent                int     -  "CREATE response: file ID, persistent part"
key   file_id_volatile                  int     -  "CREATE response: file ID, volatile part"
key   error_context_count               int     -  "error response: error context count (3.1.1)"
key   byte_count                        int     -  "error response: error data length"
list  buffer                            "the variable part after the fixed part (dialects' padding and negotiate contexts, security buffer, path, name, create contexts, error data), as octets"
list  body                              "a command not laid out here, or the encrypted or compressed message, as octets"
key   nonce                             string  -  "transform header: nonce, as hexadecimal digits, each octet low nibble first"
key   original_message_size             int     -  "transform header: size of the original message"
key   encryption_flags                  int     -  "transform header: flags (1 encrypted) or encryption algorithm"
key   original_compressed_segment_size  int     -  "compression transform header: original size"
key   compression_algorithm             int     -  "compression transform header: algorithm"
key   compression_flags                 int     -  "compression transform header: flags (1 chained)"
key   offset_or_length                  int     -  "compression transform header: offset (unchained) or length"
key   octet                             int     -  "one octet"
