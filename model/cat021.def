key   i090_sil            int     -       "I021/090/SIL: Surveillance (version 1) or Source (version 2) Integrity Level (Quality Indicators)"
key   i090_nacp           int     -       "I021/090/NACP: Navigation Accuracy Category for Position (Quality Indicators)"
key   i090_sils           int     -       "I021/090/SILS: SIL-Supplement (Quality Indicators). 0 = Measured per flight-hour, 1 = Measured per sample"
