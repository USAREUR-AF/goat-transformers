# The cat021 module: the values of ASTERIX Category 021 (ADS-B Target Reports), edition 2.7,
# as the category holds them. Used by the pack `asterix-cat021`. Generated by
# tools/gen/asterix2pack.py; do not edit by hand. A key is named after its item
# and subitems; a repetitive item is a list and its keys are the keys of one
# repetition.
module        cat021
version       0.1.0
distribution  public
source        "ASTERIX Category 021, ADS-B Target Reports, edition 2.7 (2025-07-02), as transcribed in github.com/zoranbosnjak/asterix-specs (BSD-3-Clause), commit 64e9ffba964b92a1af3157bc6bdf7852a63bf700, specs/cat021/cats/cat2.7/definition.json. The category is specified by EUROCONTROL"
key   i010_sac            int     -       "I021/010/SAC: System Area Code (Data Source Identification)"
key   i010_sic            int     -       "I021/010/SIC: System Identification Code (Data Source Identification)"
key   i040_atp            int     -       "I021/040/ATP: Address Type (Target Report Descriptor). 0 = 24-Bit ICAO address, 1 = Duplicate address, 2 = Surface vehicle address, 3 = Anonymous address, 4 = Reserved for future use, 5 = Reserved for future use, 6 = Reserved for future use, 7 = Reserved for future use"
key   i040_arc            int     -       "I021/040/ARC: Altitude Reporting Capability (Target Report Descriptor). 0 = 25 ft, 1 = 100 ft, 2 = Unknown, 3 = Invalid"
key   i040_rc             int     -       "I021/040/RC: Range Check (Target Report Descriptor). 0 = Default, 1 = Range Check passed, CPR Validation pending"
key   i040_rab            int     -       "I021/040/RAB: Report Type (Target Report Descriptor). 0 = Report from target transponder, 1 = Report from field monitor (fixed transponder)"
key   i040_dcr            int     -       "I021/040/DCR: Differential Correction (Target Report Descriptor). 0 = No differential correction (ADS-B), 1 = Differential correction (ADS-B)"
key   i040_gbs            int     -       "I021/040/GBS: Ground Bit Setting (Target Report Descriptor). 0 = Ground Bit not set, 1 = Ground Bit set"
key   i040_sim            int     -       "I021/040/SIM: Simulated Target (Target Report Descriptor). 0 = Actual target report, 1 = Simulated target report"
key   i040_tst            int     -       "I021/040/TST: Test Target (Target Report Descriptor). 0 = Default, 1 = Test Target"
key   i040_saa            int     -       "I021/040/SAA: Selected Altitude Available (Target Report Descriptor). 0 = Equipment capable to provide Selected Altitude, 1 = Equipment not capable to provide Selected Altitude"
key   i040_cl             int     -       "I021/040/CL: Confidence Level (Target Report Descriptor). 0 = Report valid, 1 = Report suspect, 2 = No information, 3 = Reserved for future use"
key   i040_llc            int     -       "I021/040/LLC: List Lookup Check (Target Report Descriptor). 0 = Default, 1 = List Lookup failed (see note)"
key   i040_ipc            int     -       "I021/040/IPC: Independent Position Check (Target Report Descriptor). 0 = Default (see note), 1 = Independent Position Check failed"
key   i040_nogo           int     -       "I021/040/NOGO: No-go Bit Status (Target Report Descriptor). 0 = NOGO-bit not set, 1 = NOGO-bit set"
key   i040_cpr            int     -       "I021/040/CPR: Compact Position Reporting (Target Report Descriptor). 0 = CPR Validation correct, 1 = CPR Validation failed"
key   i040_ldpj           int     -       "I021/040/LDPJ: Local Decoding Position Jump (Target Report Descriptor). 0 = LDPJ not detected, 1 = LDPJ detected"
key   i040_rcf            int     -       "I021/040/RCF: Range Check (Target Report Descriptor). 0 = Default, 1 = Range Check failed"
key   i040_tbc_ep         int     -       "I021/040/TBC/EP: Total Bits Corrected; Element Populated Bit (Target Report Descriptor). 0 = Element not populated, 1 = Element populated"
key   i040_tbc_val        int     -       "I021/040/TBC/VAL: Total Bits Corrected; Value (Target Report Descriptor)"
key   i040_mbc_ep         int     -       "I021/040/MBC/EP: Maximum Bits Corrected; Element Populated Bit (Target Report Descriptor). 0 = Element not populated, 1 = Element populated"
key   i040_mbc_val        int     -       "I021/040/MBC/VAL: Maximum Bits Corrected; Value (Target Report Descriptor)"
key   i161_trnum          int     -       "I021/161/TRNUM: Track Number (Track Number)"
key   i015                int     -       "I021/015: Service Identification"
key   i071                float   s       "I021/071: Time of Applicability for Position. LSB 1/128 s"
key   i130_lat            float   deg     "I021/130/LAT: Latitude (Position in WGS-84 Co-ordinates). LSB 45/2097152 deg"
key   i130_lon            float   deg     "I021/130/LON: Longitude (Position in WGS-84 Co-ordinates). LSB 45/2097152 deg"
key   i131_lat            float   deg     "I021/131/LAT: Latitude (High-Resolution Position in WGS-84 Co-ordinates). LSB 45/268435456 deg"
key   i131_lon            float   deg     "I021/131/LON: Longitude (High-Resolution Position in WGS-84 Co-ordinates). LSB 45/268435456 deg"
key   i072                float   s       "I021/072: Time of Applicability for Velocity. LSB 1/128 s"
key   i150_im             int     -       "I021/150/IM (Air Speed). 0 = Air Speed = IAS, LSB (Bit-1) = 2 -14 NM/s, 1 = Air Speed = Mach, LSB (Bit-1) = 0.001"
key   i150_as             int     -       "I021/150/AS: Air Speed (IAS or Mach) (Air Speed). raw value; its content depends on the value of 150/IM"
key   i151_re             int     -       "I021/151/RE: Range Exceeded Indicator (True Airspeed). 0 = Value in defined range, 1 = Value exceeds defined range"
key   i151_tas            float   kt      "I021/151/TAS: True Air Speed (True Airspeed). LSB 1 kt"
key   i080                int     -       "I021/080: Target Address"
key   i073                float   s       "I021/073: Time of Message Reception for Position. LSB 1/128 s"
key   i074_fsi            int     -       "I021/074/FSI: Full Second Indication (Time of Message Reception of Position-High Precision). 3 = Reserved, 2 = TOMRp whole seconds = (I021/073) Whole seconds - 1, 1 = TOMRp whole seconds = (I021/073) Whole seconds + 1, 0 = TOMRp whole seconds = (I021/073) Whole seconds"
key   i074_tomrp          float   s       "I021/074/TOMRP: Fractional Part of the Time of Message Reception for Position in the Ground Station (Time of Message Reception of Position-High Precision). LSB 1/1073741824 s"
