key   i090_gva            int     -       "I021/090/GVA: Geometric Altitude Accuracy (Quality Indicators)"
key   i090_pic            int     -       "I021/090/PIC: Position Integrity Category (Quality Indicators)"
key   i090_src            int     -       "I021/090/SRC: Source of the PIC (Quality Indicators). 0 = PIC mapped from FTC and NIC Supplements, 1 = 1 PIC directly received in HVA or Phase Overlay"
key   i090_valstate_ep    int     -       "I021/090/VALSTATE/EP: Position Validation State; VAL_STATE Element Populated Bit (Quality Indicators). 0 = Element not populated, 1 = Element populated"
key   i090_valstate_val   int     -       "I021/090/VALSTATE/VAL: Position Validation State; VAL_STATE Value (Quality Indicators). 0 = Validation not performed, 1 = Validation performed without Pass/Fail (see Note), 2 = Validation Pass (see Note), 3 = Validation Fail (see Note)"
key   i090_vd             int     -       "I021/090/VD: Validation Distance Availability (Quality Indicators). 0 = Item not available, 1 = Item available"
key   i090_vq             int     -       "I021/090/VQ: Validation Distance Quality Availability (Quality Indicators). 0 = Item not available, 1 = Item available"
key   i090_valdistp1      float   m       "I021/090/VALDISTP1: Position Validation Distance P1 (Quality Indicators). LSB 128 m"
key   i090_valdistp2      float   m       "I021/090/VALDISTP2: Position Validation Distance P2 (Quality Indicators). LSB 1 m"
