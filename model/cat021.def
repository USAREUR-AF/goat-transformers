key   i090_valdistqualp2  float   m       "I021/090/VALDISTQUALP2: Position Validation Distance Quality P2 (Quality Indicators). LSB 1 m"
key   i210_vns            int     -       "I021/210/VNS: Version Not Supported (MOPS Version). 0 = The MOPS Version is supported by the GS, 1 = The MOPS Version is not supported by the GS"
key   i210_vn             int     -       "I021/210/VN: Version Number (MOPS Version). 0 = ED102/DO-260 [Ref. 7], 1 = DO-260A [Ref. 8], 2 = ED102A/DO-260B [Ref. 10], 3 = ED-102B/DO-260C [Ref. 11]"
key   i210_ltt            int     -       "I021/210/LTT: Link Technology Type (MOPS Version). 0 = Other, 1 = UAT, 2 = 1090 ES, 3 = VDL 4, 4 = Not assigned, 5 = Not assigned, 6 = Not assigned, 7 = Not assigned"
key   i070_mode3a         int     -       "I021/070/MODE3A: Mode-3/A Reply in Octal Representation (Mode 3/A Code in Octal Representation). raw value: 4 octal digits of 3 bits each"
key   i230                float   deg     "I021/230: Roll Angle. LSB 1/100 deg"
key   i145                float   FL      "I021/145: Flight Level. LSB 1/4 FL"
key   i152                float   deg     "I021/152: Magnetic Heading. LSB 45/8192 deg"
key   i200_icf            int     -       "I021/200/ICF: Intent Change Flag (see Note) (Target Status). 0 = No intent change active, 1 = Intent change flag raised"
key   i200_lnav           int     -       "I021/200/LNAV: LNAV Mode (Target Status). 0 = LNAV Mode engaged, 1 = LNAV Mode not engaged"
key   i200_me             int     -       "I021/200/ME: Military Emergency (Target Status). 0 = No military emergency, 1 = Military emergency"
key   i200_ps             int     -       "I021/200/PS: Priority Status (Target Status). 0 = No emergency / not reported, 1 = General emergency, 2 = Lifeguard / medical emergency, 3 = Minimum fuel, 4 = No communications, 5 = Unlawful interference, 6 = DOWNED Aircraft"
key   i200_ss             int     -       "I021/200/SS: Surveillance Status (Target Status). 0 = No condition reported, 1 = Permanent Alert (Emergency condition), 2 = Temporary Alert (change in Mode 3/A Code other than emergency), 3 = SPI set"
key   i155_re             int     -       "I021/155/RE: Range Exceeded Indicator (Barometric Vertical Rate). 0 = Value in defined range, 1 = Value exceeds defined range"
key   i155_bvr            float   ft/min  "I021/155/BVR: Barometric Vertical Rate (Barometric Vertical Rate). LSB 25/4 ft/min"
key   i157_re             int     -       "I021/157/RE: Range Exceeded Indicator (Geometric Vertical Rate). 0 = Value in defined range, 1 = Value exceeds defined range"
key   i157_gvr            float   ft/min  "I021/157/GVR: Geometric Vertical Rate (Geometric Vertical Rate). LSB 25/4 ft/min"
key   i160_re             int     -       "I021/160/RE: Range Exceeded Indicator (Airborne Ground Vector). 0 = Value in defined range, 1 = Value exceeds defined range"
key   i160_ta             float   deg     "I021/160/TA: Track Angle Clockwise Reference to True North (Airborne Ground Vector). LSB 45/8192 deg"
key   i165_tar            float   deg/s   "I021/165/TAR: Track Angle Rate (Track Angle Rate). LSB 1/32 deg/s"
key   i077                float   s       "I021/077: Time of ASTERIX Report Transmission. LSB 1/128 s"
key   i170                int     -       "I021/170: Target Identification. raw value: 8 characters of 6 bits each in the ICAO character set (ICAO Annex 10)"
key   i020                int     -       "I021/020: Emitter Category. 0 = No ADS-B Emitter Category Information, 1 = Light aircraft <= 15500 lbs, 2 = 15500 lbs < small aircraft <75000 lbs, 3 = 75000 lbs < medium a/c < 300000 lbs, 4 = High Vortex Large, 5 = 300000 lbs <= heavy aircraft, 6 = Highly manoeuvrable (5g acceleration capability) and high speed (>400 knots cruise), 7 = Reserved, 8 = Reserved, 9 = Reserved, 10 = Rotocraft, 11 = ..."
key   i220_ws             float   kt      "I021/220/WS: Wind Speed (Met Information). LSB 1 kt"
