# The eaflood module: the members of the Environment Agency (England) real-time flood-monitoring
# API responses, as they hold them. packs/ea-flood-station/pack.md states the evidence for lat and lon.
module        eaflood
version       0.1.0
distribution  public
source        "Environment Agency real-time flood-monitoring API reference, https://environment.data.gov.uk/flood-monitoring/doc/reference (read 2026-11-21); restated by goat-transformers"
key   context                string  -    "@context of the response: the JSON-LD context document"
key   station_uri            string  -    "URI of the station (@id)"
key   station_lat            float   deg  "latitude of the station, WGS 84 (lat)"
key   station_long           float   deg  "longitude of the station, WGS 84 (long)"
key   notation               string  -    "identifier of the station, unique (notation)"
key   label                  string  -    "name of the station (label)"
key   rloi_id                string  -    "identifier of the station in River Levels On the Internet (RLOIid)"
key   catchment_name         string  -    "river catchment of the station (catchmentName)"
key   date_opened            string  -    "date the station opened (dateOpened)"
key   datum_offset           float   m    "offset between the Ordnance datum and the station's stage datum (datumOffset)"
key   ea_area_name           string  -    "Environment Agency area (eaAreaName)"
key   ea_region_name         string  -    "Environment Agency region (eaRegionName)"
key   easting                int     m    "easting of the station on the British National Grid (easting)"
key   northing               int     m    "northing of the station on the British National Grid (northing)"
key   river_name             string  -    "river of the station (riverName)"
key   station_reference      string  -    "identifier of the station's telemetry feed in the National Flood Forecasting System (stationReference)"
key   town                   string  -    "nearest town or named place (town)"
key   wiski_id               string  -    "identifier of the station in the WISKI hydrology dataset (wiskiID)"
list  measures                            "measurements the station provides"
key   measure_uri            string  -    "URI of the measure (@id)"
key   measure_label          string  -    "name of the measure (label)"
key   parameter              string  -    "short name of the quantity: level, flow, temperature, ... (parameter)"
key   parameter_name         string  -    "name of the quantity (parameterName)"
key   period                 float   s    "time between readings (period)"
key   qualifier              string  -    "qualifier of the quantity: Stage, Downstream Stage, Tidal Level, Groundwater, ... (qualifier)"
key   unit_name              string  -    "unit with its datum: mAOD, mASD, m, m3/s, ... (unitName)"
key   datum_type             string  -    "reference point of a level: Ordnance datum, local stage datum, ... (datumType, a URI)"
key   latest_reading_time    string  -    "date and time of the latest reading, as written (latestReading.dateTime)"
key   latest_reading_value   float   -    "value of the latest reading, in the measure's unit (latestReading.value)"
list  readings                            "readings of a readings response, in order"
key   reading_uri            string  -    "URI of the reading (@id)"
key   reading_time           string  -    "date and time of the reading, as written (dateTime)"
key   reading_measure        string  -    "URI of the measure the reading belongs to (measure)"
key   reading_value          float   -    "value of the reading, in the measure's unit; absent when the reading is not a number (value)"
list  floods                              "flood alerts and warnings in force, in order"
key   flood_uri              string  -    "URI of the warning (@id)"
key   flood_description      string  -    "name of the flood area affected (description)"
key   flood_area_id          string  -    "identifier of the flood alert or warning area (floodAreaID)"
key   flood_message          string  -    "situation message (message)"
key   severity               string  -    "severity as text: Flood Alert, Flood Warning, Severe Flood Warning, Warning no Longer in Force (severity)"
key   severity_level         int     -    "severity level: 1 severe flood warning, 2 flood warning, 3 flood alert, 4 no longer in force (severityLevel)"
key   time_message_changed   string  -    "when the message last changed (timeMessageChanged)"
key   time_raised            string  -    "when the warning was last reviewed (timeRaised)"
key   time_severity_changed  string  -    "when the severity last changed (timeSeverityChanged)"
key   flood_area_county      string  -    "counties of the flood area (floodArea.county)"
key   flood_area_notation    string  -    "identifier of the flood area (floodArea.notation)"
key   flood_area_polygon     string  -    "URI of the flood area's boundary, a GeoJSON polygon (floodArea.polygon)"
key   flood_area_river_or_sea string -    "river or sea of the flood area (floodArea.riverOrSea)"
