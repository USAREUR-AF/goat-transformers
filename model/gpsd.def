# The gpsd module: the members of gpsd's JSON responses and reports (gpsd_json(5)) that
# have no shared-model key, in the units the document states. packs/gpsd-json/pack.md says
# why each member that looks like a shared key is or is not bound.
module        gpsd
version       0.1.0
distribution  public
source        "gpsd_json(5), gitlab.com/gpsd/gpsd commit a9266948f59b3785ad93bb28f487f0308ed03cfe, man/gpsd_json.adoc (BSD-2-Clause)"
key   device         string -       "name of the device the report comes from (a path or address)"
key   mode           int    -       "fix mode: 0 unknown, 1 no fix, 2 two-dimensional, 3 three-dimensional"
key   alt            float  m       "deprecated altitude member, of no stated reference; use hae or alt_msl"
key   alt_msl        float  m       "altitude above mean sea level (geoid), metres; the geoid is seldom stated"
key   ant            int    -       "antenna status: 2 short circuit, 3 open circuit"
key   ant_pwr        int    -       "antenna power: 0 unknown, 1 off, 2 on"
key   climb          float  m/s     "vertical speed, positive upward"
key   clockbias      float  ns      "offset of the receiver clock from UTC"
key   clockdrift     float  ns/s    "rate of change of the receiver clock offset"
key   datum          string -       "datum the receiver reports, as text"
key   depth          float  m       "depth reported with the fix (TPV), as the receiver gives it"
key   dgps_age       float  s       "age of the differential corrections"
key   dgps_sta       int    -       "differential reference station identifier"
key   ecefx          float  m       "ECEF X position"
key   ecefy          float  m       "ECEF Y position"
key   ecefz          float  m       "ECEF Z position"
key   ecef_p_acc     float  m       "ECEF position error, confidence not stated"
key   ecefvx         float  m/s     "ECEF X velocity"
key   ecefvy         float  m/s     "ECEF Y velocity"
key   ecefvz         float  m/s     "ECEF Z velocity"
key   ecef_v_acc     float  m/s     "ECEF velocity error, confidence not stated"
key   epc            float  m/s     "climb error estimate, confidence not stated"
key   epd            float  deg     "track error estimate, confidence not stated"
key   eph            float  m       "horizontal position error estimate, confidence not stated"
key   eps            float  m/s     "speed error estimate, confidence not stated"
key   ept            float  s       "time stamp error estimate, confidence not stated"
key   epx            float  m       "longitude error estimate, confidence not stated"
key   epy            float  m       "latitude error estimate, confidence not stated"
key   epv            float  m       "vertical error estimate, confidence not stated"
key   geoid_sep      float  m       "height of the geoid above the WGS 84 ellipsoid"
key   jam            int    -       "jamming indicator, 0 none to 255 severe, -1 unset"
key   leapseconds    int    s       "current GPS-UTC leap seconds"
key   magdev         float  deg     "magnetic deviation of the vehicle, positive west"
key   magtrack       float  deg     "course over ground from magnetic north"
key   magvar         float  deg     "magnetic variation, positive west"
key   rel_d          float  m       "down component of the relative position vector"
key   rel_e          float  m       "east component of the relative position vector"
key   rel_n          float  m       "north component of the relative position vector"
key   sep            float  m       "spherical (3D) position error estimate, confidence not stated"
key   status         int    -       "fix status: 2 DGPS, 3 RTK fixed, 4 RTK float, 5 dead reckoning, 6 GNSS and DR, 7 surveyed time, 8 simulated, 9 P(Y)"
key   temp           float  degC    "receiver temperature"
key   vel_d          float  -       "down velocity component; the document gives its unit as metres"
key   vel_e          float  -       "east velocity component; the document gives its unit as metres"
key   vel_n          float  -       "north velocity component; the document gives its unit as metres"
key   wanglem        float  deg     "wind angle from magnetic north"
key   wangler        float  deg     "wind angle relative to the vessel"
key   wanglet        float  deg     "wind angle from true north"
key   wspeedr        float  m/s     "relative wind speed"
key   wspeedt        float  m/s     "true wind speed"
key   wtemp          float  degC    "water temperature"
key   n_sat          int    -       "number of satellites in the satellites list"
key   gdop           float  -       "geometric dilution of precision"
key   hdop           float  -       "horizontal dilution of precision"
key   pdop           float  -       "position dilution of precision"
key   pr             float  m       "pseudorange"
key   pr_rate        float  m/s     "pseudorange rate"
key   pr_res         float  m       "pseudorange residual"
key   qual           int    -       "signal quality indicator, 0 to 7"
key   prn            int    -       "PRN identifier of the satellite (gpsd numbering)"
key   az             float  deg     "satellite azimuth from true north"
key   el             float  deg     "satellite elevation"
key   freqid         int    -       "GLONASS frequency slot plus 7"
key   gnssid         int    -       "constellation identifier of the satellite"
key   health         int    -       "satellite health: 0 unknown, 1 healthy, 2 unhealthy"
key   ss             float  dBHz    "signal to noise ratio"
key   sigid          int    -       "signal identifier"
key   svid           int    -       "satellite number within its constellation"
key   used           int    -       "1 when the satellite is used in the solution, 0 when not (JSON boolean)"
list  satellites     "satellites of the sky view"
key   tdop           float  -       "time dilution of precision"
key   u_sat          int    -       "number of satellites used in the solution"
key   vdop           float  -       "vertical dilution of precision"
key   xdop           float  -       "longitudinal dilution of precision"
key   ydop           float  -       "latitudinal dilution of precision"
key   gst_rms        float  -       "RMS of the range inputs to the navigation solution"
key   gst_major      float  m       "standard deviation of the error ellipse semi-major axis"
key   gst_minor      float  m       "standard deviation of the error ellipse semi-minor axis"
key   gst_orient     float  deg     "orientation of the error ellipse semi-major axis from true north"
key   gst_alt        float  m       "standard deviation of the altitude error"
key   gst_lat        float  m       "standard deviation of the latitude error"
key   gst_lon        float  m       "standard deviation of the longitude error"
key   gst_ve         float  m/s     "standard deviation of the east velocity error"
key   gst_vn         float  m/s     "standard deviation of the north velocity error"
key   gst_vu         float  m/s     "standard deviation of the up velocity error"
key   time_tag       string -       "arbitrary time tag of an attitude measurement, as text"
key   heading        float  deg     "attitude heading from true north"
key   mag_st         string -       "magnetometer status code"
key   mheading       float  deg     "attitude heading from magnetic north"
key   pitch          float  deg     "pitch"
key   pitch_st       string -       "pitch sensor status code"
key   rot            float  deg/min "rate of turn"
key   yaw            float  deg     "yaw"
key   yaw_st         string -       "yaw sensor status code"
key   roll           float  deg     "roll"
key   roll_st        string -       "roll sensor status code"
key   dip            float  deg     "magnetic inclination, positive downward"
key   mag_len        float  -       "magnetic field strength, unit not stated"
key   mag_x          float  -       "magnetic field X component, unit not stated"
key   mag_y          float  -       "magnetic field Y component, unit not stated"
key   mag_z          float  -       "magnetic field Z component, unit not stated"
key   acc_len        float  -       "acceleration magnitude, unit not stated"
key   acc_x          float  m/s2    "acceleration X component"
key   acc_y          float  m/s2    "acceleration Y component"
key   acc_z          float  m/s2    "acceleration Z component"
key   gyro_x         float  deg/s   "angular rate about X"
key   gyro_y         float  deg/s   "angular rate about Y"
key   gyro_z         float  deg/s   "angular rate about Z"
key   att_depth      float  m       "water depth reported with attitude"
key   att_temp       float  degC    "temperature at the attitude sensor"
key   real_sec       int    s       "seconds part of the GNSS (or PPS) time, Unix epoch"
key   real_nsec      int    ns      "nanoseconds part of the GNSS (or PPS) time"
key   clock_sec      int    s       "seconds part of the system clock time, Unix epoch"
key   clock_nsec     int    ns      "nanoseconds part of the system clock time"
key   precision      int    -       "NTP-style precision estimate of the PPS (log2 seconds)"
key   shm            string -       "shared memory key of the PPS source"
key   q_err          float  ps      "quantization error of the PPS"
key   running        int    -       "1 when the oscillator runs (JSON boolean)"
key   reference      int    -       "1 when the oscillator receives a PPS (JSON boolean)"
key   disciplined    int    -       "1 when the oscillator is disciplined by the PPS (JSON boolean)"
key   delta          float  ns      "time from the oscillator's PPS output to the last GNSS PPS"
key   release        string -       "gpsd release"
key   rev            string -       "gpsd internal revision"
key   proto_major    int    -       "protocol major version"
key   proto_minor    int    -       "protocol minor version"
key   remote         string -       "address of the remote daemon the response comes from"
key   bps            int    bit/s   "serial speed"
key   cycle          float  s       "device cycle time"
key   driver         string -       "gpsd driver name"
key   flags          int    -       "bit set of packet types seen: 1 GPS, 2 RTCM2, 4 RTCM3, 8 AIS"
key   hexdata        string -       "bytes to send to the receiver, hexadecimal"
key   mincycle       float  s       "shortest cycle time the device supports"
key   native         int    -       "0 NMEA mode, 1 the device's own mode"
key   parity         string -       "N, O or E"
key   path           string -       "device path or address"
key   readonly       int    -       "1 when the device is read-only (JSON boolean)"
key   sernum         string -       "device serial number"
key   stopbits       int    -       "serial stop bits, 1 or 2"
key   subtype        string -       "device version information"
key   subtype1       string -       "further device version information"
list  devices        "device descriptions of a DEVICES response"
key   enable         int    -       "watcher mode on (1) or off (0), JSON boolean"
key   json           int    -       "JSON reports on (1) or off (0), JSON boolean"
key   nmea           int    -       "pseudo-NMEA dumping on (1) or off (0), JSON boolean"
key   raw            int    -       "raw mode: 0 off, 1 hex-dumped, 2 verbatim"
key   scaled         int    -       "1 when values are scaled (WATCH: apply scaling; SUBFRAME: values are scaled), JSON boolean"
key   split24        int    -       "1 to report the parts of AIS type 24 apart (JSON boolean)"
key   pps            int    -       "1 to send TOFF and PPS reports (JSON boolean)"
key   active         int    -       "count of active devices"
list  poll_tpv       "TPV reports of a POLL response"
list  poll_sky       "SKY reports of a POLL response"
key   message        string -       "error text"
key   frame          int    -       "subframe number"
key   gnss_id        int    -       "constellation of the transmitting satellite"
key   t_sv           int    -       "identifier of the transmitting satellite (not its PRN)"
key   tow17          int    -       "17 most significant bits of the next GPS time of week"
key   ack            string -       "never mapped: the ACK kind requires it, so an entity of another format never encodes as ACK"
