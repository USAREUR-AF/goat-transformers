# The tls13 module: TLS 1.3 handshake fields (RFC 8446). Written by tools/gen/webframes-pack.py.
module        tls13
version       0.1.0
distribution  public
source        "IETF RFC 8446, The Transport Layer Security (TLS) Protocol Version 1.3, August 2018, sections 4, 4.1.2, 4.1.3, 4.2, 4.2.1, 5.1 and 6, https://www.rfc-editor.org/rfc/rfc8446.txt; IETF RFC 6066 section 3 (server_name); layout restated"
list  handshakes                   "the handshake messages of the record, in order"
key   handshake_type               int     -  "handshake type: 1 client_hello, 2 server_hello, 4 new_session_ticket, 8 encrypted_extensions, 11 certificate, 13 certificate_request, 15 certificate_verify, 20 finished, 24 key_update"
key   legacy_version               int     -  "ClientHello, ServerHello: legacy_version (0x0303)"
key   random                       string  -  "ClientHello, ServerHello: the 32-octet random, as hexadecimal digits"
list  legacy_session_id            "ClientHello, ServerHello: the legacy session ID, as octets (its length is written from the list)"
list  cipher_suites                "ClientHello: the offered cipher suites"
key   cipher_suite                 int     -  "a cipher suite code (0x1301 TLS_AES_128_GCM_SHA256 ...)"
list  compression_methods          "ClientHello: legacy compression methods (one, 0)"
key   compression_method           int     -  "a compression method"
list  client_extensions            "ClientHello: the extensions"
list  server_extensions            "ServerHello: the extensions"
key   extension_type               int     -  "extension type (0 server_name, 10 supported_groups, 13 signature_algorithms, 16 ALPN, 43 supported_versions, 45 psk_key_exchange_modes, 51 key_share ...)"
list  server_names                 "server_name: the names"
key   name_type                    int     -  "server_name: name type (0 host_name)"
list  host_name                    "server_name: the host name, as its ASCII octets"
list  supported_versions           "ClientHello supported_versions: the versions offered"
key   version                      int     -  "a protocol version (0x0304 TLS 1.3)"
key   selected_version             int     -  "ServerHello supported_versions: the selected version"
list  extension_data               "an extension of another type: its data, as octets"
key   selected_cipher_suite        int     -  "ServerHello: the selected cipher suite"
key   selected_compression_method  int     -  "ServerHello: legacy compression method (0)"
list  handshake_body               "a handshake message of another type: its body, as octets"
list  record_data                  "a record of another content type (application data, encrypted records): its body, as octets"
key   octet                        int     -  "one octet"
