# The cat002 module: the values of ASTERIX Category 002 (Transmission of Monoradar Service Messages), edition 1.2,
# as the category holds them. Used by the pack `asterix-cat002`. Generated by
# tools/gen/asterix2pack.py; do not edit by hand. A key is named after its item
# and subitems; a repetitive item is a list and its keys are the keys of one
# repetition.
module        cat002
version       0.1.0
distribution  public
source        "ASTERIX Category 002, Transmission of Monoradar Service Messages, edition 1.2 (2024-03-15), as transcribed in github.com/zoranbosnjak/asterix-specs (BSD-3-Clause), commit 64e9ffba964b92a1af3157bc6bdf7852a63bf700, specs/cat002/cats/cat1.2/definition.json. The category is specified by EUROCONTROL"
key   i010_sac      int     -       "I002/010/SAC: System Area Code (Data Source Identifier)"
key   i010_sic      int     -       "I002/010/SIC: System Identification Code (Data Source Identifier)"
key   i000          int     -       "I002/000: Message Type. 1 = North marker message, 2 = Sector crossing message, 3 = South marker message, 8 = Activation of blind zone filtering, 9 = Stop of blind zone filtering"
key   i020          float   deg     "I002/020: Sector Number. LSB 45/32 deg"
key   i030          float   s       "I002/030: Time of Day. LSB 1/128 s"
key   i041          float   s       "I002/041: Antenna Rotation Speed. LSB 1/128 s"
list  i050          "I002/050: Station Configuration Status, one item per repetition"
key   i050_val      int     -       "I002/050: Station Configuration Status"
list  i060          "I002/060: Station Processing Mode, one item per repetition"
key   i060_val      int     -       "I002/060: Station Processing Mode"
list  i070          "I002/070: Plot Count Values, one item per repetition"
key   i070_a        int     -       "I002/070/A: Aerial Identification (Plot Count Values). 0 = Counter for antenna 1, 1 = Counter for antenna 2"
key   i070_ident    int     -       "I002/070/IDENT (Plot Count Values). 1 = Sole primary plots, 2 = Sole SSR plots, 3 = Combined plots"
key   i070_counter  int     -       "I002/070/COUNTER (Plot Count Values)"
key   i100_rs       float   NM      "I002/100/RS: Rho Start (Dynamic Window Type 1). LSB 1/128 NM"
key   i100_re       float   NM      "I002/100/RE: Rho End (Dynamic Window Type 1). LSB 1/128 NM"
key   i100_ts       float   deg     "I002/100/TS: Theta Start (Dynamic Window Type 1). LSB 45/8192 deg"
key   i100_te       float   deg     "I002/100/TE: Theta End (Dynamic Window Type 1). LSB 45/8192 deg"
key   i090_re       float   NM      "I002/090/RE: Range Error (Collimation Error). LSB 1/128 NM"
key   i090_ae       float   deg     "I002/090/AE: Azimuth Error (Collimation Error). LSB 45/2048 deg"
list  i080          "I002/080: Warning/Error Conditions, one item per repetition"
key   i080_val      int     -       "I002/080: Warning/Error Conditions"
# Derived keys (engine-spec 0.6 and 0.8), applied by `convert` between decode and encode.
derive  cat002.i030  day_seconds  time_ms
