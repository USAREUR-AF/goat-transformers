# The covjson module: the members of OGC CoverageJSON documents (Domain, Coverage,
# CoverageCollection) that the json wire can address, as the documents hold them. Every
# key is raw: packs/covjson-domain/pack.md says why no axis is bound to lat or lon.
module        covjson
version       0.1.0
distribution  public
source        "OGC CoverageJSON Community Standard 1.0 (OGC 21-069r2), github.com/opengeospatial/CoverageJSON tag V1.0.0, commit 5e9b6f5e8eec77d60d6338b3d4d9a152f98429c0, standard/clause_specification_text.adoc (Apache-2.0)"
key   id                                 string -  "identifier of a coverage (member id)"
key   coverage_domain_type               string -  "domainType member of a coverage: the domain type of the domain it names, when the domain is given as a URL"
key   collection_domain_type             string -  "domainType member of a coverage collection: the domain type every coverage in it has"
key   coverage_type                      string -  "type member of a coverage inside a collection; Coverage"
key   domain_object                      string -  "type member of a domain written inline in a coverage; Domain"
key   domain_url                         string -  "domain of a coverage given as a URL in place of a domain object"
key   domain_type                        string -  "domainType member of a domain object: Grid, Point, PointSeries, Trajectory, ... or a custom type"
list  axis_x_values                      "values of axis x; in the common domain types the first horizontal coordinate (longitude under a geographic CRS), in order"
key   axis_x_value                       float  -  "one value of axis x; in the common domain types the first horizontal coordinate (longitude under a geographic CRS); the reference system that gives it a meaning is in the domain's referencing"
key   axis_x_start                       float  -  "first value of a regularly spaced axis x (member start)"
key   axis_x_stop                        float  -  "last value of a regularly spaced axis x (member stop)"
key   axis_x_num                         int    -  "number of values of a regularly spaced axis x (member num), above zero"
list  axis_x_bounds                      "bounds of axis x: a lower and an upper bound per value, in order"
key   axis_x_bound                       float  -  "one bound of axis x"
list  axis_y_values                      "values of axis y; in the common domain types the second horizontal coordinate (latitude under a geographic CRS), in order"
key   axis_y_value                       float  -  "one value of axis y; in the common domain types the second horizontal coordinate (latitude under a geographic CRS); the reference system that gives it a meaning is in the domain's referencing"
key   axis_y_start                       float  -  "first value of a regularly spaced axis y (member start)"
key   axis_y_stop                        float  -  "last value of a regularly spaced axis y (member stop)"
key   axis_y_num                         int    -  "number of values of a regularly spaced axis y (member num), above zero"
list  axis_y_bounds                      "bounds of axis y: a lower and an upper bound per value, in order"
key   axis_y_bound                       float  -  "one bound of axis y"
list  axis_z_values                      "values of axis z; in the common domain types the vertical coordinate, in order"
key   axis_z_value                       float  -  "one value of axis z; in the common domain types the vertical coordinate; the reference system that gives it a meaning is in the domain's referencing"
key   axis_z_start                       float  -  "first value of a regularly spaced axis z (member start)"
key   axis_z_stop                        float  -  "last value of a regularly spaced axis z (member stop)"
key   axis_z_num                         int    -  "number of values of a regularly spaced axis z (member num), above zero"
list  axis_z_bounds                      "bounds of axis z: a lower and an upper bound per value, in order"
key   axis_z_bound                       float  -  "one bound of axis z"
list  axis_t_values                      "values of axis t; in the common domain types time, as text in the notation of its temporal reference system, in order"
key   axis_t_value                       string -  "one value of axis t; in the common domain types time, as text in the notation of its temporal reference system; the reference system that gives it a meaning is in the domain's referencing"
key   axis_t_start                       float  -  "first value of a regularly spaced axis t (member start)"
key   axis_t_stop                        float  -  "last value of a regularly spaced axis t (member stop)"
key   axis_t_num                         int    -  "number of values of a regularly spaced axis t (member num), above zero"
list  axis_t_bounds                      "bounds of axis t: a lower and an upper bound per value, in order"
key   axis_t_bound                       string -  "one bound of axis t"
key   axis_composite_data_type           string -  "dataType member of the composite axis: tuple or polygon"
list  axis_composite_coordinates         "coordinate identifiers of the composite axis, in the order of each tuple"
key   axis_composite_coordinate          string -  "one coordinate identifier of the composite axis (t, x, y or z in the common domain types)"
list  referencing                        "reference system connections: which coordinate identifiers a reference system gives a meaning"
list  ref_coordinates                    "coordinate identifiers a reference system connection refers to, in the order of the system's axes"
key   ref_coordinate                     string -  "one coordinate identifier of a reference system connection"
key   ref_system_type                    string -  "type member of the reference system: GeographicCRS, ProjectedCRS, VerticalCRS, TemporalRS, IdentifierRS or a custom type"
key   ref_system_id                      string -  "id member of the reference system, a URI such as an OGC CRS identifier"
key   ref_system_calendar                string -  "calendar member of a temporal reference system: Gregorian or a URI"
key   ref_system_time_scale              string -  "timeScale member of a temporal reference system, a URI; absent for UTC"
list  parameter_groups                   "parameter groups of a coverage or collection"
key   parameter_group_type               string -  "type member of a parameter group; ParameterGroup"
key   parameter_group_id                 string -  "id member of a parameter group"
list  parameter_group_members            "names of the parameters a parameter group holds"
key   parameter_group_member             string -  "one parameter name of a parameter group"
list  coverages                          "coverages of a coverage collection, in order"
