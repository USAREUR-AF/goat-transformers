# The uat module: fields of UAT (978 MHz) ADS-B downlink payloads, each as the wire
# integer unless the line says otherwise. Bytes and bits are numbered as dump978 numbers
# them: byte 1 is the first payload byte, bit 1 its most significant bit.
module        uat
version       0.1.0
distribution  public
source        "dump978 (https://github.com/flightaware/dump978, BSD-2-Clause, Copyright 2015 Oliver Jowett, 2019 FlightAware LLC) at commit f40aa9a0d2d0a0067c0c628b44ba316f7049b8ce: uat_message.cc (AdsbMessage, DecodeSV, DecodeMS, DecodeAUXSV, DecodeTS), uat_message.h (RawMessage::Bits, the enumerations), uat_protocol.h; layouts restated, no code copied"
key  altitude_type                      int   -  "byte 10 bit 8: 0 when the state vector's altitude is pressure altitude, 1 when it is geometric"
key  pressure_altitude_ft               int   -  "pressure altitude in feet: (raw - 41) x 25; raw 0 means no altitude"
key  geometric_altitude_ft              int   -  "geometric altitude in feet: (raw - 41) x 25; raw 0 means no altitude; its height reference is not stated by the source"
key  nic                                int   -  "navigation integrity category, 4 bits"
key  air_ground_state                   int   -  "0 airborne subsonic, 1 airborne supersonic, 2 on the ground, 3 reserved"
key  sv_reserved_98                     int   -  "byte 13 bit 3, reserved"
key  north_south_sign                   int   -  "1 when the north/south velocity is toward south"
key  north_south_velocity_raw           int   -  "north/south velocity: 0 no data, else the magnitude in knots plus 1 (times 4 when supersonic)"
key  east_west_sign                     int   -  "1 when the east/west velocity is toward west"
key  east_west_velocity_raw             int   -  "east/west velocity: 0 no data, else the magnitude in knots plus 1 (times 4 when supersonic)"
key  vertical_velocity_source           int   -  "0 geometric, 1 barometric"
key  vertical_velocity_sign             int   -  "1 when the vertical velocity is downward"
key  vertical_velocity_raw              int   -  "vertical rate: 0 no data, else the magnitude in units of 64 ft/min plus 1"
key  ground_reserved_99                 int   -  "byte 13 bit 4 on the ground, reserved"
key  ground_speed_raw                   int   -  "ground speed: 0 no data, else knots plus 1"
key  track_heading_type                 int   -  "0 no data, 1 true track, 2 magnetic heading, 3 true heading"
key  track_heading_raw                  int   -  "track or heading angle in units of 360/512 degree"
key  aircraft_size                      int   -  "aircraft length and width code, 0 no data"
key  ground_reserved_125                int   -  "byte 16 bit 6 on the ground, reserved"
key  gps_offset_longitudinal            int   -  "1 when the GPS offset bits are the longitudinal offset, 0 when lateral"
key  gps_offset_raw                     int   -  "GPS antenna offset code (longitudinal 5 bits, lateral the first 3)"
key  air_ground_reserved_bits           int   -  "bits 99-131 when the air/ground state is reserved"
key  utc_coupled                        int   -  "1 when the transmitter is coupled to UTC time"
key  uplink_feedback                    int   -  "uplink feedback, 3 bits"
key  tisb_site_id                       int   -  "TIS-B or ADS-R site id, 4 bits"
key  sv_aq_reserved                     int   -  "byte 17 bits 5-8 when the address qualifier is reserved"
key  callsign_word1                     int   -  "bytes 18-19: emitter category x 1600 + the first two callsign characters in base 40"
key  callsign_word2                     int   -  "bytes 20-21: callsign characters 3 to 5 in base 40"
key  callsign_word3                     int   -  "bytes 22-23: callsign characters 6 to 8 in base 40"
key  emergency_status                   int   -  "emergency/priority status, 0 none"
key  mops_version                       int   -  "UAT MOPS version"
key  sil                                int   -  "source integrity level"
key  transmit_mso                       int   -  "transmit MSO"
key  sda                                int   -  "system design assurance"
key  nac_p                              int   -  "navigation accuracy category for position"
key  nac_v                              int   -  "navigation accuracy category for velocity"
key  nic_baro                           int   -  "barometric altitude integrity"
key  cc_uat_in                          int   -  "capability: UAT receiver"
key  cc_es_in                           int   -  "capability: 1090 ES receiver"
key  cc_tcas_operational                int   -  "capability: TCAS operational"
key  om_tcas_ra_active                  int   -  "operational mode: TCAS resolution advisory active"
key  om_ident_active                    int   -  "operational mode: IDENT active"
key  om_atc_services                    int   -  "operational mode: receiving ATC services"
key  csid                               int   -  "1 when the callsign words hold a callsign, 0 when a flight plan id (squawk)"
key  sil_supplement                     int   -  "0 SIL per hour, 1 per sample"
key  gva                                int   -  "geometric vertical accuracy"
key  single_antenna                     int   -  "single antenna flag"
key  nic_supplement                     int   -  "NIC supplement"
key  ms_reserved                        int   -  "bytes 28 bit 5 to 29, reserved"
key  auxsv_reserved                     int   -  "byte 31 bit 5 to byte 34, reserved"
key  reserved_bits_136_183              int   -  "bits 136-183, reserved or not decoded by the source"
key  reserved_bits_184_231              int   -  "bits 184-231, reserved or not decoded by the source"
key  selected_altitude_type             int   -  "0 MCP/FCU selected altitude, 1 FMS selected altitude"
key  selected_altitude_ft               int   -  "selected altitude in feet: (raw - 1) x 32; raw 0 means no data"
key  barometric_pressure_setting_hpa    float -  "barometric pressure setting in hectopascals (millibars): 800 + (raw - 1) x 0.8; raw 0 means no data"
key  selected_heading_valid             int   -  "1 when the selected heading is given"
key  selected_heading_sign              int   -  "1 when the selected heading is negative"
key  selected_heading_raw               int   -  "selected heading magnitude in units of 180/256 degree"
key  mode_indicators_valid              int   -  "1 when the mode indicators are given"
key  mode_autopilot                     int   -  "autopilot engaged"
key  mode_vnav                          int   -  "VNAV mode engaged"
key  mode_altitude_hold                 int   -  "altitude hold engaged"
key  mode_approach                      int   -  "approach mode engaged"
key  mode_lnav                          int   -  "LNAV mode engaged"
key  ts_reserved                        int   -  "the last three bits of the target state, reserved"
key  reserved_bits_136_191              int   -  "bits 136-191, reserved or not decoded by the source"
key  reserved_bits_136_199              int   -  "bits 136-199, reserved or not decoded by the source"
key  reserved_bits_200_263              int   -  "bits 200-263, reserved or not decoded by the source"
key  reserved_bits_264_271              int   -  "bits 264-271, reserved or not decoded by the source"
key  reserved_bits_136_143              int   -  "bits 136-143, reserved or not decoded by the source"
key  reserved_bits_32_91                int   -  "bits 32-91, reserved or not decoded by the source"
key  reserved_bits_92_151               int   -  "bits 92-151, reserved or not decoded by the source"
key  reserved_bits_152_211              int   -  "bits 152-211, reserved or not decoded by the source"
key  reserved_bits_212_271              int   -  "bits 212-271, reserved or not decoded by the source"
key  payload_type                       int   -  "payload type code, 5 bits: which parts follow the state vector"
key  address_qualifier                  int   -  "0 ADS-B ICAO, 1 ADS-B other, 2 TIS-B ICAO, 3 TIS-B track file, 4 surface vehicle, 5 fixed beacon, 6 ADS-R other, 7 reserved"
key  address                            int   -  "24-bit address"
