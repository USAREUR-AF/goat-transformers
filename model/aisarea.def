# The aisarea module: the IMO289 area notice (AIS DAC 1 FI 22 and 23). Written by tools/gen/maritime-pack.py.
module        aisarea
version       0.1.0
distribution  public
source        "gpsd, AIVDM/AIVDO protocol decoding, sections IMO289 Area Notice (addressed and broadcast), Area Notice Description, Subarea Types and Subarea Payloads, www/AIVDM.adoc (sha256 a55511139751f5b9385166143443c0353f64fc77155b4ef4026f4ab03e3dffbd) at https://gitlab.com/gpsd/gpsd commit c59fc6de479d06620c8b2ba395b728e10a71527b, BSD-2-Clause (gpsd COPYING); layout restated"
key   linkage           int     -  "message linkage ID: names the area, and links to a text message with the same ID"
key   notice            int     -  "notice description, 0-127 (0-21 caution, 23-30 environmental caution, 32-38 restricted, 40-45 anchorage, 56-58 security, 64-76 distress, 80-85 instruction, 88-95 information, 96-108 chart feature, 112-114 report from ship, 125 other, 126 cancellation, 127 undefined)"
key   month             int     -  "start month, UTC, 1-12; 0 not available"
key   day               int     -  "start day, UTC, 1-31; 0 not available"
key   hour              int     -  "start hour, UTC, 0-23; 24 not available"
key   minute            int     -  "start minute, UTC, 0-59; 60 not available"
key   duration          int     -  "duration, minutes; 262143 not available, 0 cancels the notice"
list  subareas          "the sub-areas, 1 to 10, in order (87 bits each)"
key   shape             int     -  "sub-area shape: 0 circle or point, 1 rectangle, 2 sector, 3 polyline, 4 polygon, 5 associated text; 6-7 reserved"
key   scale             int     -  "power of ten applied to the sub-area's dimensions (metres)"
key   lon               int     -  "longitude of the centre or south-west corner, thousandths of a minute, signed; 181000 not available"
key   lat               int     -  "latitude of the centre or south-west corner, thousandths of a minute, signed; 91000 not available"
key   precision         int     -  "decimal places of precision of the position"
key   radius            int     -  "circle or sector radius, times 10^scale metres; 0 a point"
key   circle_spare      int     -  "circle: the 18 spare bits"
key   east              int     -  "rectangle: east dimension, times 10^scale metres"
key   north             int     -  "rectangle: north dimension, times 10^scale metres"
key   orientation       int     -  "rectangle: rotation, degrees clockwise from true north"
key   rect_spare        int     -  "rectangle: the 5 spare bits"
key   left              int     -  "sector: left boundary, degrees clockwise from true north"
key   right             int     -  "sector: right boundary, degrees clockwise from true north"
key   bearing_1         int     -  "polyline or polygon point 1: bearing from the previous point, half-degrees; 720 not available"
key   distance_1        int     -  "polyline or polygon point 1: distance from the previous point, times 10^scale metres; 0 no point"
key   bearing_2         int     -  "point 2: bearing, half-degrees"
key   distance_2        int     -  "point 2: distance, times 10^scale metres"
key   bearing_3         int     -  "point 3: bearing, half-degrees"
key   distance_3        int     -  "point 3: distance, times 10^scale metres"
key   bearing_4         int     -  "point 4: bearing, half-degrees"
key   distance_4        int     -  "point 4: distance, times 10^scale metres"
key   poly_spare        int     -  "polyline or polygon: the 2 unused bits"
key   text              string  -  "associated text: 14 six-bit characters"
key   reserved_payload  string  -  "a reserved shape (6, 7): its 84 bits, as hexadecimal digits"
