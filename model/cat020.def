# The cat020 module: the values of ASTERIX Category 020 (Multilateration Target Reports), edition 1.11,
# as the category holds them. Used by the pack `asterix-cat020`. Generated by
# tools/gen/asterix2pack.py; do not edit by hand. A key is named after its item
# and subitems; a repetitive item is a list and its keys are the keys of one
# repetition.
module        cat020
version       0.1.0
distribution  public
source        "ASTERIX Category 020, Multilateration Target Reports, edition 1.11 (2025-07-02), as transcribed in github.com/zoranbosnjak/asterix-specs (BSD-3-Clause), commit 64e9ffba964b92a1af3157bc6bdf7852a63bf700, specs/cat020/cats/cat1.11/definition.json. The category is specified by EUROCONTROL"
key   i010_sac      int     -       "I020/010/SAC: System Area Code (Data Source Identifier)"
key   i010_sic      int     -       "I020/010/SIC: System Identification Code (Data Source Identifier)"
key   i020_ssr      int     -       "I020/020/SSR (Target Report Descriptor). 0 = Non-Mode S 1090MHz multilateration, 1 = No Non-Mode S 1090MHz multilat"
key   i020_ms       int     -       "I020/020/MS (Target Report Descriptor). 0 = Mode-S 1090 MHz multilateration, 1 = No Mode-S 1090 MHz multilateration"
key   i020_hf       int     -       "I020/020/HF (Target Report Descriptor). 0 = HF multilateration, 1 = No HF multilateration"
key   i020_vdl4     int     -       "I020/020/VDL4 (Target Report Descriptor). 0 = VDL Mode 4 multilateration, 1 = No VDL Mode 4 multilateration"
key   i020_uat      int     -       "I020/020/UAT (Target Report Descriptor). 0 = UAT multilateration, 1 = No UAT multilateration"
key   i020_dme      int     -       "I020/020/DME (Target Report Descriptor). 0 = DME/TACAN multilateration, 1 = No DME/TACAN multilateration"
key   i020_ot       int     -       "I020/020/OT (Target Report Descriptor). 0 = Other Technology Multilateration, 1 = No Other Technology Multilateration"
key   i020_rab      int     -       "I020/020/RAB (Target Report Descriptor). 0 = Report from target transponder, 1 = Report from field monitor (element transponder)"
key   i020_spi      int     -       "I020/020/SPI (Target Report Descriptor). 0 = Absence of SPI, 1 = Special Position Identification"
key   i020_chn      int     -       "I020/020/CHN (Target Report Descriptor). 0 = Chain 1, 1 = Chain 2"
key   i020_gbs      int     -       "I020/020/GBS (Target Report Descriptor). 0 = Transponder Ground bit not set, 1 = Transponder Ground bit set"
key   i020_crt      int     -       "I020/020/CRT (Target Report Descriptor). 0 = No Corrupted reply in multilateration, 1 = Corrupted replies in multilateration"
key   i020_sim      int     -       "I020/020/SIM (Target Report Descriptor). 0 = Actual target report, 1 = Simulated target report"
key   i020_tst      int     -       "I020/020/TST (Target Report Descriptor). 0 = Default, 1 = Test Target"
key   i020_cf       int     -       "I020/020/CF (Target Report Descriptor). 0 = Target with 24-bit ICAO address, 1 = Target with a non-ICAO 24-bit address, 2 = Non-ADS-B Message, 3 = Information not available"
key   i140          float   s       "I020/140: Time of Day. LSB 1/128 s"
key   i041_lat      float   deg     "I020/041/LAT: Latitude (Position In WGS-84 Coordinates). LSB 45/8388608 deg"
key   i041_lon      float   deg     "I020/041/LON: Longitude (Position In WGS-84 Coordinates). LSB 45/8388608 deg"
key   i042_x        float   m       "I020/042/X: X-coordinate (Position in Cartesian Coordinates). LSB 1/2 m"
key   i042_y        float   m       "I020/042/Y: Y-coordinate (Position in Cartesian Coordinates). LSB 1/2 m"
key   i161_trn      int     -       "I020/161/TRN: Track Number (Track Number)"
key   i170_cnf      int     -       "I020/170/CNF (Track Status). 0 = Confirmed track, 1 = Track in initiation phase"
key   i170_tre      int     -       "I020/170/TRE (Track Status). 0 = Default, 1 = Last report for a track"
key   i170_cst      int     -       "I020/170/CST (Track Status). 0 = Not Coasted, 1 = Coasted"
key   i170_cdm      int     -       "I020/170/CDM (Track Status). 0 = Maintaining, 1 = Climbing, 2 = Descending, 3 = Invalid"
key   i170_mah      int     -       "I020/170/MAH (Track Status). 0 = Default, 1 = Horizontal manoeuvre"
key   i170_sth      int     -       "I020/170/STH (Track Status). 0 = Measured position, 1 = Smoothed position"
key   i170_gho      int     -       "I020/170/GHO (Track Status). 0 = Default, 1 = Ghost track"
key   i070_v        int     -       "I020/070/V: Validated (Mode-3/A Code in Octal Representation). 0 = Code validated, 1 = Code not validated"
key   i070_g        int     -       "I020/070/G: Garbled (Mode-3/A Code in Octal Representation). 0 = Default, 1 = Garbled code"
key   i070_l        int     -       "I020/070/L (Mode-3/A Code in Octal Representation). 0 = Mode-3/A code derived from the reply of the transponder, 1 = Mode-3/A code not extracted during the last update period"
key   i070_mode3a   int     -       "I020/070/MODE3A: Mode-3/A Reply in Octal Representation (Mode-3/A Code in Octal Representation). raw value: 4 octal digits of 3 bits each"
key   i202_vx       float   m/s     "I020/202/VX (Calculated Track Velocity in Cartesian Coordinates). LSB 1/4 m/s"
key   i202_vy       float   m/s     "I020/202/VY (Calculated Track Velocity in Cartesian Coordinates). LSB 1/4 m/s"
key   i090_v        int     -       "I020/090/V: Validated (Flight Level in Binary Representation). 0 = Code validated, 1 = Code not validated"
key   i090_g        int     -       "I020/090/G: Garbled (Flight Level in Binary Representation). 0 = Default, 1 = Garbled code"
key   i090_fl       float   FL      "I020/090/FL: Flight Level (Flight Level in Binary Representation). LSB 1/4 FL"
key   i100_v        int     -       "I020/100/V: Validated (Mode C Code). 0 = Code validated, 1 = Code not validated"
key   i100_g        int     -       "I020/100/G: Garbled (Mode C Code). 0 = Default, 1 = Garbled code"
key   i100_modec    int     -       "I020/100/MODEC: Mode-C Reply in Gray Notation (Mode C Code)"
key   i100_qc1      int     -       "I020/100/QC1: Quality Pulse C1 (Mode C Code). 0 = High quality pulse C1, 1 = Low quality pulse C1"
key   i100_qa1      int     -       "I020/100/QA1: Quality Pulse A1 (Mode C Code). 0 = High quality pulse A1, 1 = Low quality pulse A1"
key   i100_qc2      int     -       "I020/100/QC2: Quality Pulse C2 (Mode C Code). 0 = High quality pulse C2, 1 = Low quality pulse C2"
key   i100_qa2      int     -       "I020/100/QA2: Quality Pulse A2 (Mode C Code). 0 = High quality pulse A2, 1 = Low quality pulse A2"
key   i100_qc4      int     -       "I020/100/QC4: Quality Pulse C4 (Mode C Code). 0 = High quality pulse C4, 1 = Low quality pulse C4"
key   i100_qa4      int     -       "I020/100/QA4: Quality Pulse A4 (Mode C Code). 0 = High quality pulse A4, 1 = Low quality pulse A4"
key   i100_qb1      int     -       "I020/100/QB1: Quality Pulse B1 (Mode C Code). 0 = High quality pulse B1, 1 = Low quality pulse B1"
key   i100_qd1      int     -       "I020/100/QD1: Quality Pulse D1 (Mode C Code). 0 = High quality pulse D1, 1 = Low quality pulse D1"
key   i100_qb2      int     -       "I020/100/QB2: Quality Pulse B2 (Mode C Code). 0 = High quality pulse B2, 1 = Low quality pulse B2"
key   i100_qd2      int     -       "I020/100/QD2: Quality Pulse D2 (Mode C Code). 0 = High quality pulse B2, 1 = Low quality pulse B2"
key   i100_qb4      int     -       "I020/100/QB4: Quality Pulse B4 (Mode C Code). 0 = High quality pulse B4, 1 = Low quality pulse B4"
key   i100_qd4      int     -       "I020/100/QD4: Quality Pulse D4 (Mode C Code). 0 = High quality pulse D4, 1 = Low quality pulse D4"
key   i220          int     -       "I020/220: Target Address"
key   i245_sti      int     -       "I020/245/STI (Target Identification). 0 = Callsign or registration not downlinked from transponder, 1 = Registration downlinked from transponder, 2 = Callsign downlinked from transponder, 3 = Not defined"
key   i245_chr      int     -       "I020/245/CHR: Characters 1-8 (coded on 6 Bits Each) Defining Target Identification (Target Identification). raw value: 8 characters of 6 bits each in the ICAO character set (ICAO Annex 10)"
key   i110          float   ft      "I020/110: Measured Height (Local Cartesian Coordinates). LSB 25/4 ft"
key   i210_ax       float   m/s2    "I020/210/AX (Calculated Acceleration). LSB 1/4 m/s2"
key   i210_ay       float   m/s2    "I020/210/AY (Calculated Acceleration). LSB 1/4 m/s2"
key   i300          int     -       "I020/300: Vehicle Fleet Identification. 0 = Unknown, 1 = ATC equipment maintenance, 2 = Airport maintenance, 3 = Fire, 4 = Bird scarer, 5 = Snow plough, 6 = Runway sweeper, 7 = Emergency, 8 = Police, 9 = Bus, 10 = Tug (push/tow), 11 = Grass cutter, 12 = Fuel, 13 = Baggage, 14 = Catering, 15 = Aircraft maintenance, 16 = Flyco (follow me)"
key   i310_trb      int     -       "I020/310/TRB (Pre-programmed Message). 0 = Default, 1 = In Trouble"
key   i310_msg      int     -       "I020/310/MSG (Pre-programmed Message). 1 = Towing aircraft, 2 = FOLLOW-ME operation, 3 = Runway check, 4 = Emergency operation (fire, medical...), 5 = Work in progress (maintenance, birds scarer, sweepers...)"
key   i500_dop_x    float   -       "I020/500/DOP/X: DOP of Position; DOP (X-Component) (Position Accuracy). LSB 1/4"
key   i500_dop_y    float   -       "I020/500/DOP/Y: DOP of Position; DOP (Y-Component) (Position Accuracy). LSB 1/4"
key   i500_dop_xy   float   -       "I020/500/DOP/XY: DOP of Position; DOP (Correlation XY) (Position Accuracy). LSB 1/4"
key   i500_sdp_x    float   m       "I020/500/SDP/X: Standard Deviation of Position; SDP (X-Component) (Position Accuracy). LSB 1/4 m"
key   i500_sdp_y    float   m       "I020/500/SDP/Y: Standard Deviation of Position; SDP (Y-Component) (Position Accuracy). LSB 1/4 m"
key   i500_sdp_xy   float   -       "I020/500/SDP/XY: Standard Deviation of Position; SDP (Correlation XY) (Position Accuracy). LSB 1/4"
key   i500_sdh      float   m       "I020/500/SDH: Standard Deviation of Geometric Height (WGS 84) (Position Accuracy). LSB 1/2 m"
list  i400          "I020/400: Contributing Devices, one item per repetition"
key   i400_bit1     int     -       "I020/400/BIT1: TU1/RU1 Contribution (Contributing Devices). 0 = TU1/RU1 has NOT contributed to the target detection, 1 = TU1/RU1 has contributed to the target detection"
key   i400_bit2     int     -       "I020/400/BIT2: TU2/RU2 Contribution (Contributing Devices). 0 = TU2/RU2 has NOT contributed to the target detection, 1 = TU2/RU2 has contributed to the target detection"
key   i400_bit3     int     -       "I020/400/BIT3: TU3/RU3 Contribution (Contributing Devices). 0 = TU3/RU3 has NOT contributed to the target detection, 1 = TU3/RU3 has contributed to the target detection"
key   i400_bit4     int     -       "I020/400/BIT4: TU4/RU4 Contribution (Contributing Devices). 0 = TU4/RU4 has NOT contributed to the target detection, 1 = TU4/RU4 has contributed to the target detection"
key   i400_bit5     int     -       "I020/400/BIT5: TU5/RU5 Contribution (Contributing Devices). 0 = TU5/RU5 has NOT contributed to the target detection, 1 = TU5/RU5 has contributed to the target detection"
key   i400_bit6     int     -       "I020/400/BIT6: TU6/RU6 Contribution (Contributing Devices). 0 = TU6/RU6 has NOT contributed to the target detection, 1 = TU6/RU6 has contributed to the target detection"
key   i400_bit7     int     -       "I020/400/BIT7: TU7/RU7 Contribution (Contributing Devices). 0 = TU7/RU7 has NOT contributed to the target detection, 1 = TU7/RU7 has contributed to the target detection"
key   i400_bit8     int     -       "I020/400/BIT8: TU8/RU8 Contribution (Contributing Devices). 0 = TU8/RU8 has NOT contributed to the target detection, 1 = TU8/RU8 has contributed to the target detection"
list  i250          "I020/250: BDS Register Data, one item per repetition"
key   i250_bdsdata  int     -       "I020/250/BDSDATA: 56-bit Message Conveying BDS Register Data (BDS Register Data)"
key   i250_bds1     int     -       "I020/250/BDS1: BDS Register Address 1 (BDS Register Data)"
key   i250_bds2     int     -       "I020/250/BDS2: BDS Register Address 2 (BDS Register Data)"
key   i230_com      int     -       "I020/230/COM: Communications Capability of the Transponder (Communications/ACAS Capability and Flight Status). 0 = No communications capability (surveillance only), 1 = Comm. A and Comm. B capability, 2 = Comm. A, Comm. B and Uplink ELM, 3 = Comm. A, Comm. B, Uplink ELM and Downlink ELM, 4 = Level 5 Transponder capability, 5 = Not assigned, 6 = Not assigned, 7 = Not assigned"
key   i230_stat     int     -       "I020/230/STAT: Flight Status (Communications/ACAS Capability and Flight Status). 0 = No alert, no SPI, aircraft airborne, 1 = No alert, no SPI, aircraft on ground, 2 = Alert, no SPI, aircraft airborne, 3 = Alert, no SPI, aircraft on ground, 4 = Alert, SPI, aircraft airborne or on ground, 5 = No alert, SPI, aircraft airborne or on ground, 6 = Not assigned, 7 = Information not yet extracted"
key   i230_casevn   int     -       "I020/230/CASEVN: CAS Extended Version Number (Communications/ACAS Capability and Flight Status). 0 = Non-extended version, 1 = ACAS Xa Version 1, 2 = ACAS Xu Version 1, 3 = Reserved for future use"
key   i230_mssc     int     -       "I020/230/MSSC: Mode-S Specific Service Capability (Communications/ACAS Capability and Flight Status). 0 = No, 1 = Yes"
key   i230_arc      int     -       "I020/230/ARC: Altitude Reporting Capability (Communications/ACAS Capability and Flight Status). 0 = 100 ft resolution, 1 = 25 ft resolution"
key   i230_aic      int     -       "I020/230/AIC: Aircraft Identification Capability (Communications/ACAS Capability and Flight Status). 0 = No, 1 = Yes"
key   i230_b1a      int     -       "I020/230/B1A: BDS 1,0 Bit 16 (Communications/ACAS Capability and Flight Status)"
key   i230_b1b      int     -       "I020/230/B1B: BDS 1,0 Bits 37/40 (Communications/ACAS Capability and Flight Status)"
key   i260          int     -       "I020/260: ACAS Resolution Advisory Report"
list  i030          "I020/030: Warning/Error Conditions, one item per repetition"
key   i030_val      int     -       "I020/030: Warning/Error Conditions. 0 = Not defined; never used, 1 = Multipath Reply (Reflection), 3 = Split plot, 10 = Phantom SSR plot, 11 = Non-Matching Mode-3/A Code, 12 = Mode C code / Mode S altitude code abnormal value compared to the track, 15 = Transponder anomaly detected, 16 = Duplicated or Illegal Mode S Aircraft Address, 17 = Mode S error correction applied, 18 = Undecodable Mode C..."
key   i055_v        int     -       "I020/055/V: Validated (Mode-1 Code in Octal Representation). 0 = Code validated, 1 = Code not validated"
key   i055_g        int     -       "I020/055/G: Garbled (Mode-1 Code in Octal Representation). 0 = Default, 1 = Garbled code"
key   i055_l        int     -       "I020/055/L (Mode-1 Code in Octal Representation). 0 = Mode-1 code derived from the reply of the transponder, 1 = Smoothed Mode-1 code as provided by a local tracker"
key   i055_mode1    int     -       "I020/055/MODE1: Mode-1 Code in Octal Representation (Mode-1 Code in Octal Representation)"
key   i050_v        int     -       "I020/050/V: Validated (Mode-2 Code in Octal Representation). 0 = Code validated, 1 = Code not validated"
key   i050_g        int     -       "I020/050/G: Garbled (Mode-2 Code in Octal Representation). 0 = Default, 1 = Garbled code"
key   i050_l        int     -       "I020/050/L (Mode-2 Code in Octal Representation). 0 = Mode-2 code derived from the reply of the transponder, 1 = Smoothed Mode-2 code as provided by a local tracker n"
key   i050_mode2    int     -       "I020/050/MODE2: Mode-2 Reply in Octal Representation (Mode-2 Code in Octal Representation). raw value: 4 octal digits of 3 bits each"
# Derived keys (engine-spec 0.6 and 0.8), applied by `convert` between decode and encode.
derive  cat020.i140  day_seconds  time_ms
