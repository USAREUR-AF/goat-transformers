# The nitf module: the fixed fields of the NITF 2.1 file header (fh_) and image
# subheader (is_), each as the text the file holds (int for BCS-N integer fields).
module        nitf
version       0.1.0
distribution  public
source        "MIL-STD-2500C, National Imagery Transmission Format Version 2.1, 01 May 2006, appendix A tables A-1 (file header) and A-3 (image subheader); Distribution Statement A per the ASSIST listing; field order, sizes and types restated, no text copied"
key  fh_fhdr        string  -  "file profile name: NITF or NSIF"
key  fh_fver        string  -  "file version: 02.10 (NITF) or 01.00 (NSIF)"
key  fh_clevel      int     -  "complexity level"
key  fh_stype       string  -  "standard type, BF01"
key  fh_ostaid      string  -  "originating station identifier"
key  fh_fdt         string  -  "file date and time, CCYYMMDDhhmmss, UTC"
key  fh_ftitle      string  -  "file title"
key  fh_fsclas      string  -  "file security classification code"
key  fh_fsclsy      string  -  "file security classification system"
key  fh_fscode      string  -  "file codewords"
key  fh_fsctlh      string  -  "file control and handling"
key  fh_fsrel       string  -  "file releasing instructions"
key  fh_fsdctp      string  -  "file declassification type"
key  fh_fsdcdt      string  -  "file declassification date, CCYYMMDD"
key  fh_fsdcxm      string  -  "file declassification exemption"
key  fh_fsdg        string  -  "file downgrade"
key  fh_fsdgdt      string  -  "file downgrade date, CCYYMMDD"
key  fh_fscltx      string  -  "file classification text"
key  fh_fscatp      string  -  "file classification authority type"
key  fh_fscaut      string  -  "file classification authority"
key  fh_fscrsn      string  -  "file classification reason"
key  fh_fssrdt      string  -  "file security source date, CCYYMMDD"
key  fh_fsctln      string  -  "file security control number"
key  fh_fscop       int     -  "file copy number"
key  fh_fscpys      int     -  "file number of copies"
key  fh_encryp      int     -  "encryption, 0 = not encrypted"
key  fh_fbkgc       string  -  "file background colour: three unsigned binary bytes (red, green, blue), held as text (pack.md)"
key  fh_oname       string  -  "originator's name"
key  fh_ophone      string  -  "originator's phone number"
key  fh_fl          int     -  "file length in bytes"
key  fh_hl          int     -  "file header length in bytes"
key  fh_numi        int     -  "number of image segments"
key  is_im          string  -  "file part type: IM"
key  is_iid1        string  -  "image identifier 1"
key  is_idatim      string  -  "image date and time, CCYYMMDDhhmmss, UTC"
key  is_tgtid       string  -  "target identifier"
key  is_iid2        string  -  "image identifier 2"
key  is_isclas      string  -  "image security classification code"
key  is_isclsy      string  -  "image security classification system"
key  is_iscode      string  -  "image codewords"
key  is_isctlh      string  -  "image control and handling"
key  is_isrel       string  -  "image releasing instructions"
key  is_isdctp      string  -  "image declassification type"
key  is_isdcdt      string  -  "image declassification date, CCYYMMDD"
key  is_isdcxm      string  -  "image declassification exemption"
key  is_isdg        string  -  "image downgrade"
key  is_isdgdt      string  -  "image downgrade date, CCYYMMDD"
key  is_iscltx      string  -  "image classification text"
key  is_iscatp      string  -  "image classification authority type"
key  is_iscaut      string  -  "image classification authority"
key  is_iscrsn      string  -  "image classification reason"
key  is_issrdt      string  -  "image security source date, CCYYMMDD"
key  is_isctln      string  -  "image security control number"
key  is_encryp      int     -  "encryption, 0 = not encrypted"
key  is_isorce      string  -  "image source"
key  is_nrows       int     -  "number of significant rows"
key  is_ncols       int     -  "number of significant columns"
key  is_pvtype      string  -  "pixel value type"
key  is_irep        string  -  "image representation"
key  is_icat        string  -  "image category"
key  is_abpp        int     -  "actual bits per pixel per band"
key  is_pjust       string  -  "pixel justification, L or R"
key  is_icords      string  -  "image coordinate representation: U, G, N, S, D or a space"
key  is_igeolo      string  -  "image geographic location: four corners, 60 characters, in the form ICORDS names"
key  is_nicom       int     -  "number of image comments, 0 to 9"
