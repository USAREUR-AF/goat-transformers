# The ccsdsmal module: the MAL Space Packet secondary header (CCSDS 524.1-B-1). Written by tools/gen/sdls-ep-pack.py.
module        ccsdsmal
version       0.1.0
distribution  public
source        "CCSDS 524.1-B-1 Mission Operations, MAL Space Packet Transport Binding and Binary Encoding, Blue Book, August 2015, https://ccsds.org/Pubs/524x1b1.pdf (sha256 6daa871c4f1298fbd0789dd6073841f5c71e7860e44a0b613c17b156939332a4), sections 3.1 and 3.4, with the primary header of CCSDS 133.0-B-2; reuse with attribution under the CCSDS reproduction permission statement"
key   version                   int     -  "MAL Space Packet binding version, 0"
key   sdu_type                  int     -  "the MAL interaction type and stage (SEND, SUBMIT, REQUEST, INVOKE, PROGRESS, PUBSUB stages ...), 5 bits"
key   service_area              int     -  "MAL service area number"
key   service                   int     -  "MAL service number within the area"
key   operation                 int     -  "MAL operation number within the service"
key   area_version              int     -  "version of the service area"
key   is_error                  int     -  "1 for an error message"
key   qos_level                 int     -  "MAL QoS level: 0 best effort, 1 assured, 2 queued, 3 timely"
key   session                   int     -  "MAL session type: 0 live, 1 simulation, 2 replay"
key   secondary_apid            int     -  "the other peer's APID (the source's in a request, the destination's in a reply)"
key   secondary_apid_qualifier  int     -  "the other peer's APID qualifier"
key   transaction_id            int     -  "MAL transaction identifier, signed 64-bit"
key   source_id_flag            int     -  "1: the source ID field is present"
key   destination_id_flag       int     -  "1: the destination ID field is present"
key   priority_flag             int     -  "1: the priority field is present"
key   timestamp_flag            int     -  "1: the timestamp field is present"
key   network_zone_flag         int     -  "1: the network zone field is present"
key   session_name_flag         int     -  "1: the session name field is present"
key   domain_flag               int     -  "1: the domain field is present"
key   authentication_id_flag    int     -  "1: the authentication ID field is present"
key   source_id                 int     -  "source identifier within the APID, 8 bits"
key   destination_id            int     -  "destination identifier within the APID, 8 bits"
key   segment_counter           int     -  "segment counter of a segmented MAL message (present unless the packet is unsegmented)"
list  rest_octets               "the priority, timestamp, network zone, session name, domain and authentication ID fields when present, then the MAL message body, as octets"
key   octet                     int     -  "one octet"
