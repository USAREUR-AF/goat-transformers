# The nbns module: NetBIOS Name Service fields (RFC 1002 section 4.2). Written by tools/gen/dirnaming-pack.py.
module        nbns
version       0.1.0
distribution  public
source        "IETF RFC 1002, Protocol Standard for a NetBIOS Service on a TCP/UDP Transport: Detailed Specifications, March 1987, sections 4.1, 4.2.1, 4.2.18 and 4.4, https://www.rfc-editor.org/rfc/rfc1002.txt; layouts restated"
key   opcode                    int     -  "operation: 0 query, 5 registration, 6 release, 7 WACK, 8 refresh"
key   nm_reserved               int     -  "the two reserved flag bits, 0"
key   broadcast                 int     -  "flag B: the packet was broadcast or multicast"
key   rcode                     int     -  "result code of a response (0 none, 1 format error, 2 server failure, 3 name error, 4 unsupported, 5 refused, 6 active, 7 conflict)"
list  questions                 "the question entries (their count is written from the list)"
key   question_type             int     -  "question type: 0x20 NB, 0x21 NBSTAT"
key   question_class            int     -  "question class: 1 IN"
list  answers                   "the answer resource records"
list  authority                 "the authority resource records"
list  additional                "the additional resource records"
key   rr_type                   int     -  "record type: 1 A, 2 NS, 10 NULL, 0x20 NB, 0x21 NBSTAT"
key   rr_class                  int     -  "record class: 1 IN"
key   ttl                       int     -  "time to live of the name, in seconds"
list  nb_entries                "NB record data: the entries, each flags and an address"
key   nb_group                  int     -  "NB entry: G, 1 a group name, 0 a unique name"
key   nb_ont                    int     -  "NB entry: owner node type, 0 B node, 1 P node, 2 M node"
key   nb_reserved               int     -  "NB entry: the 13 reserved flag bits, 0"
key   nb_address                int     -  "NB entry: the owner's IPv4 address, as an unsigned 32-bit integer"
list  node_names                "NBSTAT record data: the node name array (its count is written from the list)"
key   node_name                 string  -  "node name entry: the 16-octet NetBIOS name, as hexadecimal digits"
key   node_group                int     -  "node name entry: G, group name"
key   node_ont                  int     -  "node name entry: owner node type"
key   node_deregister           int     -  "node name entry: DRG, being deleted"
key   node_conflict             int     -  "node name entry: CNF, in conflict"
key   node_active               int     -  "node name entry: ACT, active (always 1)"
key   node_permanent            int     -  "node name entry: PRM, the permanent node name"
key   node_reserved             int     -  "node name entry: the 9 reserved flag bits, 0"
key   unit_id                   string  -  "NBSTAT statistics: unique unit ID, 6 octets as hexadecimal digits"
key   jumpers                   int     -  "NBSTAT statistics: jumpers"
key   test_result               int     -  "NBSTAT statistics: test result"
key   version_number            int     -  "NBSTAT statistics: version number"
key   period_of_statistics      int     -  "NBSTAT statistics: period of statistics"
key   crcs                      int     -  "NBSTAT statistics: number of CRC errors"
key   alignment_errors          int     -  "NBSTAT statistics: number of alignment errors"
key   collisions                int     -  "NBSTAT statistics: number of collisions"
key   send_aborts               int     -  "NBSTAT statistics: number of send aborts"
key   good_sends                int     -  "NBSTAT statistics: number of good sends"
key   good_receives             int     -  "NBSTAT statistics: number of good receives"
key   retransmits               int     -  "NBSTAT statistics: number of retransmits"
key   no_resource_conditions    int     -  "NBSTAT statistics: number of no-resource conditions"
key   free_command_blocks       int     -  "NBSTAT statistics: free command blocks"
key   total_command_blocks      int     -  "NBSTAT statistics: total command blocks"
key   max_total_command_blocks  int     -  "NBSTAT statistics: maximum total command blocks"
key   pending_sessions          int     -  "NBSTAT statistics: pending sessions"
key   max_pending_sessions      int     -  "NBSTAT statistics: maximum pending sessions"
key   max_total_sessions        int     -  "NBSTAT statistics: maximum total sessions possible"
key   session_data_packet_size  int     -  "NBSTAT statistics: session data packet size"
key   a_address                 int     -  "A record data: an IPv4 address, as an unsigned 32-bit integer"
list  rdata                     "record data of another type (NULL, as in the WACK response, included), as octets"
key   octet                     int     -  "one octet"
key   question_name_t1          int     -  "question name, label 1: tag, 0 a label, 3 a compression pointer"
key   question_name_len1        int     -  "question name, label 1: length in octets (0 ends the name)"
key   question_name_label1      string  -  "question name, label 1: its characters (the first label is the NetBIOS name in first-level encoding: 32 letters A to P, two per octet of the name)"
key   question_name_t2          int     -  "question name, label 2: tag, 0 a label, 3 a compression pointer"
key   question_name_len2        int     -  "question name, label 2: length in octets (0 ends the name)"
key   question_name_label2      string  -  "question name, label 2: its characters (scope)"
key   question_name_t3          int     -  "question name, label 3: tag, 0 a label, 3 a compression pointer"
key   question_name_len3        int     -  "question name, label 3: length in octets (0 ends the name)"
key   question_name_label3      string  -  "question name, label 3: its characters (scope)"
key   question_name_t4          int     -  "question name, label 4: tag, 0 a label, 3 a compression pointer"
key   question_name_len4        int     -  "question name, label 4: length in octets (0 ends the name)"
key   question_name_label4      string  -  "question name, label 4: its characters (scope)"
key   question_name_t5          int     -  "question name, label 5: tag, 0 a label, 3 a compression pointer"
key   question_name_len5        int     -  "question name, label 5: length in octets (0 ends the name)"
key   question_name_pointer     int     -  "question name: the compression pointer, the offset in the packet of the rest of the name (not followed)"
key   rr_name_t1                int     -  "record name, label 1: tag, 0 a label, 3 a compression pointer"
key   rr_name_len1              int     -  "record name, label 1: length in octets (0 ends the name)"
key   rr_name_label1            string  -  "record name, label 1: its characters (the first label is the NetBIOS name in first-level encoding: 32 letters A to P, two per octet of the name)"
key   rr_name_t2                int     -  "record name, label 2: tag, 0 a label, 3 a compression pointer"
key   rr_name_len2              int     -  "record name, label 2: length in octets (0 ends the name)"
key   rr_name_label2            string  -  "record name, label 2: its characters (scope)"
key   rr_name_t3                int     -  "record name, label 3: tag, 0 a label, 3 a compression pointer"
key   rr_name_len3              int     -  "record name, label 3: length in octets (0 ends the name)"
key   rr_name_label3            string  -  "record name, label 3: its characters (scope)"
key   rr_name_t4                int     -  "record name, label 4: tag, 0 a label, 3 a compression pointer"
key   rr_name_len4              int     -  "record name, label 4: length in octets (0 ends the name)"
key   rr_name_label4            string  -  "record name, label 4: its characters (scope)"
key   rr_name_t5                int     -  "record name, label 5: tag, 0 a label, 3 a compression pointer"
key   rr_name_len5              int     -  "record name, label 5: length in octets (0 ends the name)"
key   rr_name_pointer           int     -  "record name: the compression pointer, the offset in the packet of the rest of the name (not followed)"
key   ns_name_t1                int     -  "NS record data: the name server's name, label 1: tag, 0 a label, 3 a compression pointer"
key   ns_name_len1              int     -  "NS record data: the name server's name, label 1: length in octets (0 ends the name)"
key   ns_name_label1            string  -  "NS record data: the name server's name, label 1: its characters (the first label is the NetBIOS name in first-level encoding: 32 letters A to P, two per octet of the name)"
key   ns_name_t2                int     -  "NS record data: the name server's name, label 2: tag, 0 a label, 3 a compression pointer"
key   ns_name_len2              int     -  "NS record data: the name server's name, label 2: length in octets (0 ends the name)"
key   ns_name_label2            string  -  "NS record data: the name server's name, label 2: its characters (scope)"
key   ns_name_t3                int     -  "NS record data: the name server's name, label 3: tag, 0 a label, 3 a compression pointer"
key   ns_name_len3              int     -  "NS record data: the name server's name, label 3: length in octets (0 ends the name)"
key   ns_name_label3            string  -  "NS record data: the name server's name, label 3: its characters (scope)"
key   ns_name_t4                int     -  "NS record data: the name server's name, label 4: tag, 0 a label, 3 a compression pointer"
key   ns_name_len4              int     -  "NS record data: the name server's name, label 4: length in octets (0 ends the name)"
key   ns_name_label4            string  -  "NS record data: the name server's name, label 4: its characters (scope)"
key   ns_name_t5                int     -  "NS record data: the name server's name, label 5: tag, 0 a label, 3 a compression pointer"
key   ns_name_len5              int     -  "NS record data: the name server's name, label 5: length in octets (0 ends the name)"
key   ns_name_pointer           int     -  "NS record data: the name server's name: the compression pointer, the offset in the packet of the rest of the name (not followed)"
