# The aisbin module: values of the AIS binary application messages (types 6
# and 8 with a fixed DAC/FI layout) that neither core nor the ais module has a
# key for. Used by the pack `ais-binary`. Every key holds the wire value: an
# integer as on the wire (its step is in the description where the source gives
# one), a code, a flag (0 or 1) or six-bit text. Not-available codes are as the
# source states them per field; packs/ais-binary/pack.md says where to find them.
# A key named <prefix>_<field> belongs to the kind the description names.
module        aisbin
version       0.1.0
distribution  public
source        "gpsd, AIVDM/AIVDO protocol decoding, v1.58 (24 June 2023), www/AIVDM.adoc at https://gitlab.com/gpsd/gpsd commit c59fc6de479d06620c8b2ba395b728e10a71527b, BSD-2-Clause (gpsd COPYING); binary application messages of types 6 and 8"

# Every binary message
key  seqno                     int     -     "type 6: sequence number of the addressed message, 0 to 3"
key  retransmit                int     -     "type 6: flag, 1 = the message was retransmitted"
key  dac                       int     -     "designated area code of the application message (1 international, 200 inland waterways, 235 United Kingdom, 250 Ireland)"
key  fid                       int     -     "function identifier of the application message within its DAC"
key  linkage                   int     -     "message linkage ID, which ties related application messages together"
key  wmo                       int     -     "type 8 DAC 1 FI 21: variant flag, 0 = free-format observation, 1 = WMO-coded observation"

# dangerous-cargo-imo236
key  dc236_lastport            string  -     "last port of call, 5 six-bit characters, trailing @ removed (dangerous-cargo-imo236)"
key  dc236_lmonth              int     -     "eta month (utc), wire integer (dangerous-cargo-imo236)"
key  dc236_lday                int     -     "eta day (utc), wire integer (dangerous-cargo-imo236)"
key  dc236_lhour               int     -     "eta hour (utc), wire integer (dangerous-cargo-imo236)"
key  dc236_lminute             int     -     "eta minute (utc), wire integer (dangerous-cargo-imo236)"
key  dc236_nextport            string  -     "next port of call, 5 six-bit characters, trailing @ removed (dangerous-cargo-imo236)"
key  dc236_nmonth              int     -     "eta month (utc), wire integer (dangerous-cargo-imo236)"
key  dc236_nday                int     -     "eta day (utc), wire integer (dangerous-cargo-imo236)"
key  dc236_nhour               int     -     "eta hour (utc), wire integer (dangerous-cargo-imo236)"
key  dc236_nminute             int     -     "eta minute (utc), wire integer (dangerous-cargo-imo236)"
