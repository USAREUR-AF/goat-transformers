# The dnsmsg module: the sections and records of a DNS message. Written by tools/gen/inet-more-pack.py.
module        dnsmsg
version       0.1.0
distribution  public
source        "IETF RFC 1035 sections 3.1, 3.2, 3.3, 3.4, 4.1; RFC 3596 section 2.2 (AAAA); RFC 2782 (SRV); RFC 6891 section 6 (OPT); RFC 8659 section 4.1 (CAA); https://www.rfc-editor.org/; layouts restated"
list  questions         "the question section (its count is written from the list)"
key   qtype             int     -  "question type (1 A, 28 AAAA, 15 MX, 255 ANY ...)"
key   qclass            int     -  "question class (1 IN; mDNS sets the top bit for a unicast reply)"
key   qname_t1          int     -  "question name, label 1: tag, 0 a label, 3 a compression pointer"
key   qname_len1        int     -  "question name, label 1: length in octets (0 ends the name)"
key   qname_label1      string  -  "question name, label 1: its characters"
key   qname_t2          int     -  "question name, label 2: tag, 0 a label, 3 a compression pointer"
key   qname_len2        int     -  "question name, label 2: length in octets (0 ends the name)"
