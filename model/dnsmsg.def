key   qname_len10       int     -  "question name, label 10: length in octets (0 ends the name)"
key   qname_label10     string  -  "question name, label 10: its characters"
key   qname_t11         int     -  "question name, label 11: tag, 0 a label, 3 a compression pointer"
key   qname_len11       int     -  "question name, label 11: length in octets (0 ends the name)"
key   qname_pointer     int     -  "question name: the compression pointer, the offset in the message of the rest of the name (not followed)"
