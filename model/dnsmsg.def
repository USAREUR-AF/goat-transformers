key   qname_len6        int     -  "question name, label 6: length in octets (0 ends the name)"
key   qname_label6      string  -  "question name, label 6: its characters"
key   qname_t7          int     -  "question name, label 7: tag, 0 a label, 3 a compression pointer"
key   qname_len7        int     -  "question name, label 7: length in octets (0 ends the name)"
key   qname_label7      string  -  "question name, label 7: its characters"
