# The cap module: the elements of an OASIS Common Alerting Protocol 1.2 alert
# message, as text where the standard gives text. packs/cap/pack.md says why
# the times are kept as written beside time_ms and stale_ms, and why the area
# geometry is carried as text.
module        cap
version       0.1.0
distribution  public
source        "OASIS Common Alerting Protocol Version 1.2, OASIS Standard, 01 July 2010, http://docs.oasis-open.org/emergency/cap/v1.2/CAP-v1.2-os.pdf, and schema CAP-v1.2.xsd"
# alert
key   identifier     string  -    "identifier of the alert message, assigned by the sender"
key   sender         string  -    "globally unique identifier of the originator"
key   sent           string  -    "time of origination as written (date-time with a numeric offset; UTC is -00:00)"
key   status         string  -    "Actual, Exercise, System, Test or Draft"
key   msg_type       string  -    "Alert, Update, Cancel, Ack or Error"
key   source         string  -    "text identifying the source of the alert"
key   scope          string  -    "Public, Restricted or Private"
key   restriction    string  -    "rule for limiting distribution of a Restricted alert"
key   addresses      string  -    "intended recipients of a Private alert, as written"
key   note           string  -    "message note"
key   references     string  -    "earlier messages this one refers to, as written"
key   incidents      string  -    "incident names this message refers to, as written"
list  codes                       "special handling codes of the alert"
key   code           string  -    "one special handling code"
# info
list  infos                       "information blocks of the alert, in order"
key   language       string  -    "language code of the information block"
list  categories                  "categories of the event"
key   category       string  -    "Geo, Met, Safety, Security, Rescue, Fire, Health, Env, Transport, Infra, CBRNE or Other"
key   event          string  -    "text denoting the type of event"
list  response_types              "recommended responses"
key   response_type  string  -    "Shelter, Evacuate, Prepare, Execute, Avoid, Monitor, Assess, AllClear or None"
key   urgency        string  -    "Immediate, Expected, Future, Past or Unknown"
key   severity       string  -    "Extreme, Severe, Moderate, Minor or Unknown"
key   certainty      string  -    "Observed, Likely, Possible, Unlikely or Unknown"
key   audience       string  -    "intended audience, as text"
list  event_codes                 "system-specific codes for the event type"
list  parameters                  "system-specific parameters"
key   value_name     string  -    "name of the code domain or parameter (eventCode, parameter, geocode)"
key   value          string  -    "value in that domain (eventCode, parameter, geocode)"
key   effective      string  -    "effective time of the information, as written"
key   onset          string  -    "expected onset time, as written"
key   expires        string  -    "expiry time of the information, as written"
key   sender_name    string  -    "human-readable name of the issuing agency"
key   headline       string  -    "brief headline"
key   description    string  -    "description of the event"
key   instruction    string  -    "recommended action"
key   web            string  -    "address of further information"
key   contact        string  -    "contact for follow-up"
list  resources                   "supplementary files"
key   resource_desc  string  -    "description of the resource"
key   mime_type      string  -    "MIME type of the resource"
key   size           int     byte "size of the resource"
key   uri            string  -    "address of the resource"
key   deref_uri      string  -    "the resource content, base-64 encoded"
key   digest         string  -    "SHA-1 hash of the resource, as written"
list  areas                       "affected areas"
key   area_desc      string  -    "description of the affected area"
list  polygons                    "polygons of the area"
key   polygon        string  -    "a polygon as written: whitespace-separated latitude,longitude pairs, WGS 84, first equal to last"
list  circles                     "circles of the area"
key   circle         string  -    "a circle as written: latitude,longitude, a space, and the radius in kilometres"
list  geocodes                    "geographic codes of the area"
key   altitude       float   ft   "specific or lower altitude of the area, feet above mean sea level"
key   ceiling        float   ft   "upper altitude of the area, feet above mean sea level"
