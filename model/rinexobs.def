# The rinexobs module: the columns of RINEX observation file lines, as their text. Written by tools/gen/rinex-pack.py.
module        rinexobs
version       0.1.0
distribution  public
source        "IGS/RTCM RINEX WG, RINEX The Receiver Independent Exchange Format Version 4.01, 10 July 2023, https://files.igs.org/pub/data/format/rinex_4.01.pdf (sha256 5e917eb6d2224021c5f05adb333b5311b6cde0f58c3ca4e0ae5871ccd15ce0c8), Tables A2, A3, A7, A9 and A30-A34; and Version 3.05, https://files.igs.org/pub/data/format/rinex305.pdf (sha256 05de6c898e1cf4102d6d0ef8b2710a98a16a5105c49a6d972757d647c7593918); no licence stated (IGS terms of use: open use with attribution); layouts restated"
key   format_version         string  -  "format version, as written (F9.2: 3.05, 4.01 ...)"
key   file_type              string  -  "file type: O for observation data"
key   file_type_text         string  -  "the text after the file type letter in the version line (OBSERVATION DATA ...)"
key   satellite_system       string  -  "satellite system letter (G GPS, R GLONASS, E Galileo, C BeiDou, J QZSS, I NavIC, S SBAS; M mixed in the version line)"
key   satellite_system_text  string  -  "the text after the system letter in the version line"
key   program                string  -  "program that created the file"
key   run_by                 string  -  "agency that created the file"
key   created                string  -  "creation date and time, as written"
key   comment                string  -  "a comment line's text"
key   marker_name            string  -  "antenna marker name"
key   marker_number          string  -  "antenna marker number"
key   marker_type            string  -  "marker type (GEODETIC, NON_GEODETIC, SPACEBORNE ...)"
key   observer               string  -  "observer"
key   agency                 string  -  "agency"
key   receiver_number        string  -  "receiver serial number"
key   receiver_type          string  -  "receiver type"
key   receiver_version       string  -  "receiver version"
key   antenna_number         string  -  "antenna serial number"
key   antenna_type           string  -  "antenna type"
key   approx_x               string  -  "approximate marker position, geocentric (ECEF) X, metres, as written"
key   approx_y               string  -  "approximate marker position, ECEF Y, metres, as written"
key   approx_z               string  -  "approximate marker position, ECEF Z, metres, as written"
key   delta_h                string  -  "antenna height above the marker, metres, as written"
key   delta_e                string  -  "antenna eccentricity east, metres, as written"
key   delta_n                string  -  "antenna eccentricity north, metres, as written"
key   delta_x                string  -  "antenna reference point in the body frame, X, metres"
key   delta_y                string  -  "antenna reference point, Y, metres"
key   delta_z                string  -  "antenna reference point, Z, metres"
key   pc_system              string  -  "phase centre: satellite system"
key   pc_code                string  -  "phase centre: observation code"
key   pc_1                   string  -  "phase centre: north or X, metres"
key   pc_2                   string  -  "phase centre: east or Y, metres"
key   pc_3                   string  -  "phase centre: up or Z, metres"
key   bsight_x               string  -  "antenna vertical axis direction, X"
key   bsight_y               string  -  "antenna vertical axis direction, Y"
key   bsight_z               string  -  "antenna vertical axis direction, Z"
key   zerodir_azi            string  -  "azimuth of the antenna zero direction, degrees"
key   zerodir_x              string  -  "antenna zero direction, X"
key   zerodir_y              string  -  "antenna zero direction, Y"
key   zerodir_z              string  -  "antenna zero direction, Z"
key   com_x                  string  -  "centre of mass, X, metres"
key   com_y                  string  -  "centre of mass, Y, metres"
key   com_z                  string  -  "centre of mass, Z, metres"
key   doi                    string  -  "digital object identifier for citing the data"
key   license                string  -  "data licence line"
key   station_information    string  -  "station metadata link"
key   obs_system             string  -  "SYS / # / OBS TYPES: satellite system (blank on a continuation line)"
key   obs_type_count         string  -  "SYS / # / OBS TYPES: number of observation types for the system (blank on a continuation line)"
key   obs_type_1             string  -  "observation descriptor 1 of the line (type, band, attribute: C1C, L1C ...)"
key   obs_type_2             string  -  "observation descriptor 2 of the line (type, band, attribute: C1C, L1C ...)"
key   obs_type_3             string  -  "observation descriptor 3 of the line (type, band, attribute: C1C, L1C ...)"
key   obs_type_4             string  -  "observation descriptor 4 of the line (type, band, attribute: C1C, L1C ...)"
key   obs_type_5             string  -  "observation descriptor 5 of the line (type, band, attribute: C1C, L1C ...)"
key   obs_type_6             string  -  "observation descriptor 6 of the line (type, band, attribute: C1C, L1C ...)"
key   obs_type_7             string  -  "observation descriptor 7 of the line (type, band, attribute: C1C, L1C ...)"
key   obs_type_8             string  -  "observation descriptor 8 of the line (type, band, attribute: C1C, L1C ...)"
key   obs_type_9             string  -  "observation descriptor 9 of the line (type, band, attribute: C1C, L1C ...)"
key   obs_type_10            string  -  "observation descriptor 10 of the line (type, band, attribute: C1C, L1C ...)"
key   obs_type_11            string  -  "observation descriptor 11 of the line (type, band, attribute: C1C, L1C ...)"
key   obs_type_12            string  -  "observation descriptor 12 of the line (type, band, attribute: C1C, L1C ...)"
key   obs_type_13            string  -  "observation descriptor 13 of the line (type, band, attribute: C1C, L1C ...)"
key   signal_strength_unit   string  -  "unit of the carrier-to-noise observations (DBHZ ...)"
key   interval               string  -  "observation interval, seconds, as written"
key   first_year             string  -  "time of first observation: year, as written"
key   first_month            string  -  "time of first observation: month, as written"
key   first_day              string  -  "time of first observation: day, as written"
key   first_hour             string  -  "time of first observation: hour, as written"
key   first_minute           string  -  "time of first observation: minute, as written"
key   first_second           string  -  "time of first observation: second, as written"
key   first_time_system      string  -  "time of first observation: time system (GPS, GLO, GAL, BDT, QZS, IRN)"
key   last_year              string  -  "time of last observation: year, as written"
key   last_month             string  -  "time of last observation: month, as written"
key   last_day               string  -  "time of last observation: day, as written"
key   last_hour              string  -  "time of last observation: hour, as written"
key   last_minute            string  -  "time of last observation: minute, as written"
key   last_second            string  -  "time of last observation: second, as written"
key   last_time_system       string  -  "time of last observation: time system (GPS, GLO, GAL, BDT, QZS, IRN)"
key   clock_offset_applied   string  -  "1 if epochs and observations are corrected by the receiver clock offset"
key   corr_system            string  -  "DCB or PCV corrections: satellite system"
key   corr_program           string  -  "DCB or PCV corrections: program"
key   corr_source            string  -  "DCB or PCV corrections: source"
key   content                string  -  "the first 60 columns of a header line the pack does not divide"
key   leap_seconds           string  -  "current number of leap seconds since 6 January 1980"
key   leap_seconds_future    string  -  "future or past leap seconds (blank if unknown)"
key   leap_week              string  -  "week number of that leap second (blank if unknown)"
key   leap_day               string  -  "day number of that leap second (blank if unknown)"
key   leap_time_system       string  -  "time system of the leap second record (GPS, or blank)"
key   satellite_count        string  -  "number of satellites in the file"
key   year                   string  -  "epoch year, in the file's time system"
key   month                  string  -  "epoch month"
key   day                    string  -  "epoch day"
key   hour                   string  -  "epoch hour"
key   minute                 string  -  "epoch minute"
key   second                 string  -  "epoch second, as written (F11.7)"
key   epoch_flag             string  -  "epoch flag: 0 OK, 1 power failure since the previous epoch, 2-5 events (header lines follow), 6 cycle slips"
key   satellite_count_epoch  string  -  "number of satellites in the epoch (or of special records after an event)"
key   clock_offset           string  -  "receiver clock offset, seconds (optional), as written"
key   satellite_number       string  -  "satellite number (PRN or slot) within its system"
key   obs_1                  string  -  "observation 1 of the line, in the order of the system's SYS / # / OBS TYPES, as written (F14.3)"
key   lli_1                  string  -  "loss of lock indicator of observation 1"
key   ssi_1                  string  -  "signal strength indicator of observation 1 (1-9)"
