# The mpegts module: the fields of an MPEG-2 transport stream packet. Written by tools/gen/media-pack.py.
module        mpegts
version       0.1.0
distribution  public
source        "Restated from FFmpeg libavformat/mpegts.c and GStreamer mpegtspacketizer.c (LGPL); no code copied"
key   transport_error           int     -  "transport error indicator: 1 when the packet has an uncorrectable error"
key   payload_unit_start        int     -  "payload unit start indicator: 1 when a PES packet or a PSI section starts in this packet"
key   transport_priority        int     -  "transport priority"
key   pid                       int     -  "packet identifier, 13 bits: 0 PAT, 1 CAT, 0x1FFF null packets, others by the PMT"
key   scrambling                int     -  "transport scrambling control: 0 not scrambled"
key   adaptation_field_control  int     -  "1 payload only, 2 adaptation field only, 3 adaptation field then payload"
key   continuity_counter        int     -  "continuity counter, 4 bits, per PID"
key   discontinuity             int     -  "adaptation field: discontinuity indicator"
key   random_access             int     -  "adaptation field: random access indicator"
key   es_priority               int     -  "adaptation field: elementary stream priority indicator"
key   pcr_flag                  int     -  "adaptation field: 1 when a PCR follows"
key   opcr_flag                 int     -  "adaptation field: 1 when an original PCR follows"
key   splicing_point_flag       int     -  "adaptation field: 1 when a splice countdown follows"
key   private_data_flag         int     -  "adaptation field: 1 when transport private data follows"
key   extension_flag            int     -  "adaptation field: 1 when an adaptation field extension follows"
key   pcr_base                  int     -  "program clock reference base, 33 bits, in 90 kHz units"
key   pcr_reserved              int     -  "the six reserved bits between the PCR base and extension"
key   pcr_extension             int     -  "program clock reference extension, 9 bits, in 27 MHz units (0-299)"
key   opcr_base                 int     -  "original PCR base, 90 kHz units"
key   opcr_reserved             int     -  "the six reserved bits of the original PCR"
key   opcr_extension            int     -  "original PCR extension, 27 MHz units"
key   splice_countdown          int     -  "packets of this PID until the splicing point (signed)"
list  private_data              "transport private data, as octets"
list  af_extension              "the adaptation field extension after its length (flags and fields), as octets"
list  stuffing                  "stuffing octets at the end of the adaptation field (0xFF)"
list  payload                   "the payload: a part of a PES packet or of PSI sections, as octets"
key   octet                     int     -  "one octet"
