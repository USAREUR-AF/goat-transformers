# The sflow module: the sFlow(R) version 5 datagram as sflow.org states it (sflow_version_5.txt):
# the datagram header, the samples, the flow records and the counter records the sflow5-datagram
# pack lays out. Every value is the XDR integer of the wire.
module        sflow
version       0.1.0
distribution  public
source        "sFlow.org, sFlow Version 5, July 2004, https://sflow.org/sflow_version_5.txt, Copyright (C) sFlow.org (2004); use under the sFlow License Agreement of InMon Corp.; layouts restated"

# Datagram header
key  agent_address_type     int  -  "0 unknown, 1 IPv4, 2 IPv6: the kind of the agent address that follows"
key  agent_ipv4             int  -  "IPv4 address of the agent, as a 32-bit integer"
key  agent_ipv6_g0  int  -  "IPv6 address of the agent, 16-bit group 1 of 8"
key  agent_ipv6_g1  int  -  "IPv6 address of the agent, 16-bit group 2 of 8"
key  agent_ipv6_g2  int  -  "IPv6 address of the agent, 16-bit group 3 of 8"
key  agent_ipv6_g3  int  -  "IPv6 address of the agent, 16-bit group 4 of 8"
key  agent_ipv6_g4  int  -  "IPv6 address of the agent, 16-bit group 5 of 8"
key  agent_ipv6_g5  int  -  "IPv6 address of the agent, 16-bit group 6 of 8"
key  agent_ipv6_g6  int  -  "IPv6 address of the agent, 16-bit group 7 of 8"
key  agent_ipv6_g7  int  -  "IPv6 address of the agent, 16-bit group 8 of 8"
key  sub_agent_id           int  -  "identifier of the sub-agent that sent the datagram, within the agent"
key  datagram_sequence      int  -  "count of the datagrams the sub-agent has sent"
key  uptime                 int  -  "milliseconds since the device last booted, when the datagram was sent"

# Samples
list samples                     "the sample records of the datagram, in order"
key  sample_type            int  -  "data format of the sample: enterprise number in the upper 20 bits, format in the lower 12; 1 flow sample, 2 counter sample, 3 and 4 their expanded forms (enterprise 0)"
list sample_octets               "the content of a sample of a format the pack does not lay out, one item per octet"
key  octet                  int  -  "one octet, 0-255"
key  sample_sequence        int  -  "count of the samples this source has generated"
key  source_id_type         int  -  "kind of data source: 0 ifIndex, 1 smonVlanDataSource, 2 entPhysicalEntry"
key  source_id_index        int  -  "index of the data source"
key  sampling_rate          int  -  "one packet in this many is sampled"
key  sample_pool            int  -  "packets that could have been sampled: those skipped and those sampled"
key  drops                  int  -  "samples lost for lack of resources since the agent was last reset"
key  input_format           int  -  "format of the input interface value: 0 one interface"
key  input_value            int  -  "input interface: its ifIndex when the format is 0; 0 unknown"
key  output_format          int  -  "format of the output interface value: 0 one interface, 1 packet discarded, 2 several interfaces"
key  output_value           int  -  "output interface: ifIndex, a discard reason or a number of interfaces, by the format"

# Flow records
list flow_records                "the flow records of a flow sample, in order"
key  flow_format            int  -  "data format of the flow record: 1 raw packet header, 3 IPv4 data, 4 IPv6 data (enterprise 0)"
list record_octets               "the content of a flow or counter record of a format the pack does not lay out, one item per octet"
key  header_protocol        int  -  "protocol of the sampled header: 1 Ethernet, 11 IPv4, 12 IPv6 and the other numbers of the specification"
key  frame_length           int  -  "length of the packet before sampling, in octets"
key  stripped               int  -  "octets removed from the packet before the header was taken"
list header_octets               "the sampled header, one item per octet"
key  ip_length              int  -  "length of the IP packet without lower-layer encapsulation"
key  ip_protocol            int  -  "IP protocol number (IPv4) or next header (IPv6)"
key  src_ipv4               int  -  "IPv4 source address, as a 32-bit integer"
key  dst_ipv4               int  -  "IPv4 destination address, as a 32-bit integer"
key  src_ipv6_g0  int  -  "IPv6 source address, 16-bit group 1 of 8"
key  src_ipv6_g1  int  -  "IPv6 source address, 16-bit group 2 of 8"
key  src_ipv6_g2  int  -  "IPv6 source address, 16-bit group 3 of 8"
key  src_ipv6_g3  int  -  "IPv6 source address, 16-bit group 4 of 8"
key  src_ipv6_g4  int  -  "IPv6 source address, 16-bit group 5 of 8"
key  src_ipv6_g5  int  -  "IPv6 source address, 16-bit group 6 of 8"
key  src_ipv6_g6  int  -  "IPv6 source address, 16-bit group 7 of 8"
key  src_ipv6_g7  int  -  "IPv6 source address, 16-bit group 8 of 8"
key  dst_ipv6_g0  int  -  "IPv6 destination address, 16-bit group 1 of 8"
key  dst_ipv6_g1  int  -  "IPv6 destination address, 16-bit group 2 of 8"
key  dst_ipv6_g2  int  -  "IPv6 destination address, 16-bit group 3 of 8"
key  dst_ipv6_g3  int  -  "IPv6 destination address, 16-bit group 4 of 8"
key  dst_ipv6_g4  int  -  "IPv6 destination address, 16-bit group 5 of 8"
key  dst_ipv6_g5  int  -  "IPv6 destination address, 16-bit group 6 of 8"
key  dst_ipv6_g6  int  -  "IPv6 destination address, 16-bit group 7 of 8"
key  dst_ipv6_g7  int  -  "IPv6 destination address, 16-bit group 8 of 8"
key  src_port               int  -  "TCP or UDP source port, or the equivalent"
key  dst_port               int  -  "TCP or UDP destination port, or the equivalent"
key  tcp_flags              int  -  "TCP flags"
key  tos                    int  -  "IPv4 type of service"
key  ipv6_priority          int  -  "IPv6 priority"

# Counter records
list counter_records             "the counter records of a counter sample, in order"
key  counter_format         int  -  "data format of the counter record: 1 generic interface, 2 Ethernet (enterprise 0)"

# Generic interface counters (counter format 1)
key  if_index                 int  -  "ifIndex of the interface"
key  if_type                  int  -  "ifType of the interface"
key  if_speed                 int  -  "speed of the interface in bits per second"
key  if_direction             int  -  "0 unknown, 1 full-duplex, 2 half-duplex, 3 in, 4 out"
key  if_status                int  -  "bit 0 administrative status, bit 1 operational status (1 up)"
key  if_in_octets             int  -  "octets received"
key  if_in_ucast_pkts         int  -  "unicast packets received"
key  if_in_multicast_pkts     int  -  "multicast packets received"
key  if_in_broadcast_pkts     int  -  "broadcast packets received"
key  if_in_discards           int  -  "received packets discarded"
key  if_in_errors             int  -  "received packets in error"
key  if_in_unknown_protos     int  -  "received packets of an unknown protocol"
key  if_out_octets            int  -  "octets sent"
key  if_out_ucast_pkts        int  -  "unicast packets sent"
key  if_out_multicast_pkts    int  -  "multicast packets sent"
key  if_out_broadcast_pkts    int  -  "broadcast packets sent"
key  if_out_discards          int  -  "packets to send that were discarded"
key  if_out_errors            int  -  "packets not sent because of errors"
key  if_promiscuous_mode      int  -  "1 when the interface is in promiscuous mode"

# Ethernet interface counters (counter format 2)
key  dot3_alignment_errors              int  -  "frames with an alignment error"
key  dot3_fcs_errors                    int  -  "frames with a frame check error"
key  dot3_single_collision_frames       int  -  "frames sent after one collision"
key  dot3_multiple_collision_frames     int  -  "frames sent after more than one collision"
key  dot3_sqe_test_errors               int  -  "SQE test errors"
key  dot3_deferred_transmissions        int  -  "frames whose first send was deferred"
key  dot3_late_collisions               int  -  "late collisions"
key  dot3_excessive_collisions          int  -  "frames not sent after too many collisions"
key  dot3_internal_mac_transmit_errors  int  -  "frames not sent because of an internal MAC error"
key  dot3_carrier_sense_errors          int  -  "times the carrier sense was lost while sending"
key  dot3_frame_too_longs               int  -  "frames longer than allowed"
key  dot3_internal_mac_receive_errors   int  -  "frames not received because of an internal MAC error"
key  dot3_symbol_errors                 int  -  "symbol errors"
