# The cat001 module: the values of ASTERIX Category 001 (Transmission of Monoradar Data Target Reports), edition 1.4,
# as the category holds them. Used by the pack `asterix-cat001`. Generated by
# tools/gen/asterix2pack.py; do not edit by hand. A key is named after its item
# and subitems; a repetitive item is a list and its keys are the keys of one
# repetition.
module        cat001
version       0.1.0
distribution  public
source        "ASTERIX Category 001, Transmission of Monoradar Data Target Reports, edition 1.4 (2022-08-18), as transcribed in github.com/zoranbosnjak/asterix-specs (BSD-3-Clause), commit 64e9ffba964b92a1af3157bc6bdf7852a63bf700, specs/cat001/cats/cat1.4/definition.json. The category is specified by EUROCONTROL"
key   i010_sac     int     -       "I001/010/SAC: System Area Code (Data Source Identifier)"
key   i010_sic     int     -       "I001/010/SIC: System Identification Code (Data Source Identifier)"
key   i020_typ     int     -       "I001/020/TYP (Target Report Descriptor). 0 = Plot, 1 = Track"
key   i020_sim     int     -       "I001/020/SIM (Target Report Descriptor). 0 = Actual plot or track, 1 = Simulated plot or track"
key   i020_ssrpsr  int     -       "I001/020/SSRPSR: Radar Detection in Last Antenna Scan (Target Report Descriptor). 0 = No detection, 1 = Sole primary detection, 2 = Sole secondary detection, 3 = Combined primary and secondary detection"
key   i020_ant     int     -       "I001/020/ANT (Target Report Descriptor). 0 = Target report from antenna 1, 1 = Target report from antenna 2"
key   i020_spi     int     -       "I001/020/SPI (Target Report Descriptor). 0 = Default, 1 = Special Position Identification"
key   i020_rab     int     -       "I001/020/RAB (Target Report Descriptor). 0 = Default, 1 = Plot or track from a fixed transponder"
key   i020_tst     int     -       "I001/020/TST (Target Report Descriptor). 0 = Default, 1 = Test target indicator"
key   i020_ds1ds2  int     -       "I001/020/DS1DS2: Radar Detection in Last Antenna Scan (Target Report Descriptor). 0 = Default, 1 = Unlawful interference (code 7500), 2 = Radio-communication failure (code 7600), 3 = Emergency (code 7700)"
key   i020_me      int     -       "I001/020/ME (Target Report Descriptor). 0 = Default, 1 = Military emergency"
key   i020_mi      int     -       "I001/020/MI (Target Report Descriptor). 0 = Default, 1 = Military identification"
key   i040_rho     float   NM      "I001/040/RHO (Measured Position in Polar Co-ordinates). LSB 1/128 NM"
key   i040_theta   float   deg     "I001/040/THETA (Measured Position in Polar Co-ordinates). LSB 45/8192 deg"
key   i070_v       int     -       "I001/070/V (Mode-3/A Code in Octal Representation). 0 = Code validated, 1 = Code not validated"
key   i070_g       int     -       "I001/070/G (Mode-3/A Code in Octal Representation). 0 = Default, 1 = Garbled code"
key   i070_l       int     -       "I001/070/L (Mode-3/A Code in Octal Representation). 0 = Mode-3/A code derived from the reply of the transponder, 1 = Smoothed Mode-3/A code as provided by a local tracker"
key   i070_mode3a  int     -       "I001/070/MODE3A: Mode-3/A Reply in Octal Representation (Mode-3/A Code in Octal Representation). raw value: 4 octal digits of 3 bits each"
key   i090_v       int     -       "I001/090/V (Mode-C Code in Binary Representation). 0 = Code validated, 1 = Code not validated"
key   i090_g       int     -       "I001/090/G (Mode-C Code in Binary Representation). 0 = Default, 1 = Garbled code"
key   i090_hgt     float   FL      "I001/090/HGT: Mode-C HEIGHT (Mode-C Code in Binary Representation). LSB 1/4 FL"
list  i130         "I001/130: Radar Plot Characteristics, one item per repetition"
key   i130_val     int     -       "I001/130: Radar Plot Characteristics"
key   i141         float   s       "I001/141: Truncated Time of Day. LSB 1/128 s"
key   i050_v       int     -       "I001/050/V (Mode-2 Code in Octal Representation). 0 = Code validated, 1 = Code not validated"
key   i050_g       int     -       "I001/050/G (Mode-2 Code in Octal Representation). 0 = Default, 1 = Garbled code"
key   i050_l       int     -       "I001/050/L (Mode-2 Code in Octal Representation). 0 = Mode-2 code as derived from the reply of the transponder, 1 = Smoothed Mode-2 code as provided by a local tracker"
key   i050_mode2   int     -       "I001/050/MODE2: Mode-2 Code in Octal Representation (Mode-2 Code in Octal Representation). raw value: 4 octal digits of 3 bits each"
key   i120         float   NM/s    "I001/120: Measured Radial Doppler Speed. LSB 1/256 NM/s"
key   i131         float   dBm     "I001/131: Received Power. LSB 1 dBm"
key   i080_qa4     int     -       "I001/080/QA4 (Mode-3/A Code Confidence Indicator). 0 = High quality pulse A4, 1 = Low quality pulse A4"
key   i080_qa2     int     -       "I001/080/QA2 (Mode-3/A Code Confidence Indicator). 0 = High quality pulse A2, 1 = Low quality pulse A2"
key   i080_qa1     int     -       "I001/080/QA1 (Mode-3/A Code Confidence Indicator). 0 = High quality pulse A1, 1 = Low quality pulse A1"
key   i080_qb4     int     -       "I001/080/QB4 (Mode-3/A Code Confidence Indicator). 0 = High quality pulse B4, 1 = Low quality pulse B4"
