key   i080_qb1     int     -       "I001/080/QB1 (Mode-3/A Code Confidence Indicator). 0 = High quality pulse B1, 1 = Low quality pulse B1"
key   i080_qc4     int     -       "I001/080/QC4 (Mode-3/A Code Confidence Indicator). 0 = High quality pulse C4, 1 = Low quality pulse C4"
key   i080_qc2     int     -       "I001/080/QC2 (Mode-3/A Code Confidence Indicator). 0 = High quality pulse C2, 1 = Low quality pulse C2"
key   i080_qc1     int     -       "I001/080/QC1 (Mode-3/A Code Confidence Indicator). 0 = High quality pulse C1, 1 = Low quality pulse C1"
key   i080_qd4     int     -       "I001/080/QD4 (Mode-3/A Code Confidence Indicator). 0 = High quality pulse D4, 1 = Low quality pulse D4"
key   i080_qd2     int     -       "I001/080/QD2 (Mode-3/A Code Confidence Indicator). 0 = High quality pulse D2, 1 = Low quality pulse D2"
key   i080_qd1     int     -       "I001/080/QD1 (Mode-3/A Code Confidence Indicator). 0 = High quality pulse D1, 1 = Low quality pulse D1"
key   i100_v       int     -       "I001/100/V (Mode-C Code and Code Confidence Indicator). 0 = Code validated, 1 = Code not validated"
key   i100_g       int     -       "I001/100/G (Mode-C Code and Code Confidence Indicator). 0 = Default, 1 = Garbled code"
key   i100_modec   int     -       "I001/100/MODEC: Mode-C Reply in Gray Notation (Mode-C Code and Code Confidence Indicator)"
key   i100_qc1     int     -       "I001/100/QC1 (Mode-C Code and Code Confidence Indicator). 0 = High quality pulse C1, 1 = Low quality pulse C1"
key   i100_qa1     int     -       "I001/100/QA1 (Mode-C Code and Code Confidence Indicator). 0 = High quality pulse A1, 1 = Low quality pulse A1"
key   i100_qc2     int     -       "I001/100/QC2 (Mode-C Code and Code Confidence Indicator). 0 = High quality pulse C2, 1 = Low quality pulse C2"
key   i100_qa2     int     -       "I001/100/QA2 (Mode-C Code and Code Confidence Indicator). 0 = High quality pulse A2, 1 = Low quality pulse A2"
key   i100_qc4     int     -       "I001/100/QC4 (Mode-C Code and Code Confidence Indicator). 0 = High quality pulse C4, 1 = Low quality pulse C4"
key   i100_qa4     int     -       "I001/100/QA4 (Mode-C Code and Code Confidence Indicator). 0 = High quality pulse A4, 1 = Low quality pulse A4"
key   i100_qb1     int     -       "I001/100/QB1 (Mode-C Code and Code Confidence Indicator). 0 = High quality pulse B1, 1 = Low quality pulse B1"
key   i100_qd1     int     -       "I001/100/QD1 (Mode-C Code and Code Confidence Indicator). 0 = High quality pulse D1, 1 = Low quality pulse D1"
key   i100_qb2     int     -       "I001/100/QB2 (Mode-C Code and Code Confidence Indicator). 0 = High quality pulse B2, 1 = Low quality pulse B2"
key   i100_qd2     int     -       "I001/100/QD2 (Mode-C Code and Code Confidence Indicator). 0 = High quality pulse D2, 1 = Low quality pulse D2"
key   i100_qb4     int     -       "I001/100/QB4 (Mode-C Code and Code Confidence Indicator). 0 = High quality pulse B4, 1 = Low quality pulse B4"
key   i100_qd4     int     -       "I001/100/QD4 (Mode-C Code and Code Confidence Indicator). 0 = High quality pulse D4, 1 = Low quality pulse D4"
key   i060_qa4     int     -       "I001/060/QA4 (Mode-2 Code Confidence Indicator). 0 = High quality pulse A4, 1 = Low quality pulse A4"
key   i060_qa2     int     -       "I001/060/QA2 (Mode-2 Code Confidence Indicator). 0 = High quality pulse A2, 1 = Low quality pulse A2"
key   i060_qa1     int     -       "I001/060/QA1 (Mode-2 Code Confidence Indicator). 0 = High quality pulse A1, 1 = Low quality pulse A1"
key   i060_qb4     int     -       "I001/060/QB4 (Mode-2 Code Confidence Indicator). 0 = High quality pulse B4, 1 = Low quality pulse B4"
key   i060_qb2     int     -       "I001/060/QB2 (Mode-2 Code Confidence Indicator). 0 = High quality pulse B2, 1 = Low quality pulse B2"
key   i060_qb1     int     -       "I001/060/QB1 (Mode-2 Code Confidence Indicator). 0 = High quality pulse B1, 1 = Low quality pulse B1"
key   i060_qc4     int     -       "I001/060/QC4 (Mode-2 Code Confidence Indicator). 0 = High quality pulse C4, 1 = Low quality pulse C4"
key   i060_qc2     int     -       "I001/060/QC2 (Mode-2 Code Confidence Indicator). 0 = High quality pulse C2, 1 = Low quality pulse C2"
key   i060_qc1     int     -       "I001/060/QC1 (Mode-2 Code Confidence Indicator). 0 = High quality pulse C1, 1 = Low quality pulse C1"
key   i060_qd4     int     -       "I001/060/QD4 (Mode-2 Code Confidence Indicator). 0 = High quality pulse D4, 1 = Low quality pulse D4"
key   i060_qd2     int     -       "I001/060/QD2 (Mode-2 Code Confidence Indicator). 0 = High quality pulse D2, 1 = Low quality pulse D2"
key   i060_qd1     int     -       "I001/060/QD1 (Mode-2 Code Confidence Indicator). 0 = High quality pulse D1, 1 = Low quality pulse D1"
list  i030         "I001/030: Warning/Error Conditions, one item per repetition"
key   i030_val     int     -       "I001/030: Warning/Error Conditions. 0 = No warning nor error condition, 1 = Garbled reply, 2 = Reflection, 3 = Sidelobe reply, 4 = Split plot, 5 = Second time around reply, 6 = Angels, 7 = Terrestrial vehicles, 64 = Possible wrong code in Mode-3/A, 65 = Possible wrong altitude information, transmitted when the Code C credibility check fails together with the Mode-C code in binary notation, 66 =..."
key   i150_xa      int     -       "I001/150/XA (Presence of X-Pulse). 0 = Default, 1 = X-pulse received in Mode-3/A reply"
key   i150_xc      int     -       "I001/150/XC (Presence of X-Pulse). 0 = Default, 1 = X-pulse received in Mode-C reply"
key   i150_x2      int     -       "I001/150/X2 (Presence of X-Pulse). 0 = Default, 1 = X-pulse received in Mode-2 reply"
