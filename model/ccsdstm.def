# The ccsdstm module: the fields of the CCSDS TM Transfer Frame primary header and of
# the identification octet of its secondary header, each as the wire integer. The pack
# ccsds-tm-frame maps them. Bit numbers count from 0 at the first transmitted bit.
module        ccsdstm
version       0.1.0
distribution  public
source        "CCSDS 132.0-B-3 TM Space Data Link Protocol, Blue Book, October 2021, https://ccsds.org/Pubs/132x0b3.pdf, sections 4.1.2 and 4.1.3.2; reuse with attribution under the CCSDS reproduction permission statement"
key  spacecraft_id               int  -  "bits 2-11: spacecraft identifier"
key  virtual_channel_id          int  -  "bits 12-14: virtual channel identifier, 0-7"
key  ocf_flag                    int  -  "bit 15: 1 = the frame ends with an operational control field, 0 = it has none"
key  mc_frame_count              int  -  "bits 16-23: count of the frames of the master channel, modulo 256"
key  vc_frame_count              int  -  "bits 24-31: count of the frames of the virtual channel, modulo 256"
key  secondary_header_flag       int  -  "bit 32: 1 = a transfer frame secondary header follows the primary header"
key  sync_flag                   int  -  "bit 33: 0 = the data field holds octet-synchronized, forward-ordered packets or idle data; 1 = it holds a virtual channel access service data unit (VCA_SDU)"
key  packet_order_flag           int  -  "bit 34: reserved, 0 when sync_flag is 0; undefined when sync_flag is 1"
key  segment_length_id           int  -  "bits 35-36: kept from earlier editions; 3 when sync_flag is 0, undefined when it is 1"
key  first_header_pointer        int  -  "bits 37-47: octet offset in the data field of the first packet that starts there; 2047 = no packet starts, 2046 = only idle data"
key  secondary_header_version    int  -  "bits 0-1 of the secondary header: its version number, 0 in this edition"
key  secondary_header_length     int  -  "bits 2-7 of the secondary header: its length in octets, minus one"
