# The crsf module: values of CRSF telemetry frames that have no shared-model key, in the
# units the specification states. packs/crsf/pack.md says why each is or is not bound.
module        crsf
version       0.1.0
distribution  public
source        "TBS CRSF protocol specification (CRSFv3), https://github.com/tbs-fpv/tbs-crsf-spec commit a73f7dc5386e5b8744aa4a23b3af5354ee0d4c92, crsf.md (sha256 58293cefb558425729b749f5d9700ba51a83cb578e9867dd1f94224303b6f918); CC BY-SA 4.0, TBS Avionics Co LTD"
key   sync                 int    -      "first byte of the frame: the serial sync byte 0xC8 or a device address"
key   gps_heading          int    -      "GPS frame: heading, hundredths of a degree (reference not stated)"
key   gps_altitude         int    m      "GPS frame: altitude in metres plus 1000 (reference not stated)"
key   gps_satellites       int    -      "GPS frame: satellites in view"
key   gpsx_fix_type        int    -      "GPS extended frame: fix quality"
key   gpsx_h_speed_acc     int    cm/s   "GPS extended frame: horizontal speed accuracy"
key   gpsx_track_acc       int    -      "GPS extended frame: heading accuracy, tenths of a degree"
key   gpsx_h_acc           int    cm     "GPS extended frame: horizontal accuracy"
key   gpsx_v_acc           int    cm     "GPS extended frame: vertical accuracy"
key   gpsx_reserved        int    -      "GPS extended frame: reserved byte"
key   gpsx_hdop            int    -      "GPS extended frame: horizontal dilution of precision, tenths"
key   gpsx_vdop            int    -      "GPS extended frame: vertical dilution of precision, tenths"
key   vario_v_speed        int    cm/s   "variometer frame: vertical speed (sign convention not stated)"
key   battery_voltage      int    -      "battery frame: voltage, tenths of a volt"
key   battery_current      int    -      "battery frame: current, tenths of an ampere"
key   battery_capacity_used  int  -      "battery frame: capacity used, mAh"
key   battery_remaining    int    -      "battery frame: remaining, percent"
key   battery_id           int    -      "battery frame: identifier of the sensor (0 when the byte is absent)"
key   link_up_rssi_ant1    int    -      "link statistics: uplink RSSI of antenna 1, dBm negated"
key   link_up_rssi_ant2    int    -      "link statistics: uplink RSSI of antenna 2, dBm negated"
key   link_up_quality      int    -      "link statistics: uplink link quality, percent"
key   link_up_snr          int    dB     "link statistics: uplink signal-to-noise ratio"
key   link_active_antenna  int    -      "link statistics: number of the best antenna"
key   link_rf_profile      int    -      "link statistics: RF profile code"
key   link_up_rf_power     int    -      "link statistics: uplink RF power code"
key   link_down_rssi       int    -      "link statistics: downlink RSSI, dBm negated"
key   link_down_quality    int    -      "link statistics: downlink link quality, percent"
key   link_down_snr        int    dB     "link statistics: downlink signal-to-noise ratio"
key   attitude_pitch       int    -      "attitude frame: pitch, units of 100 microradians"
key   attitude_roll        int    -      "attitude frame: roll, units of 100 microradians"
key   attitude_yaw         int    -      "attitude frame: yaw, units of 100 microradians"
