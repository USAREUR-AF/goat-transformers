# The semtechudp module: Semtech UDP packet forwarder fields. Written by tools/gen/lpwan2-pack.py.
module        semtechudp
version       0.1.0
distribution  public
source        "Lora-net/packet_forwarder, https://github.com/Lora-net/packet_forwarder at commit d0226eae6e7b6bbaec6117d0d2372bf17819c438, PROTOCOL.TXT (Copyright (C) 2013 Semtech S.A., the repository licence, BSD-3-Clause terms); layout restated, no text copied"
key   protocol_version  int     -  "protocol version (2)"
key   token             int     -  "random token, repeated in the acknowledgement"
key   identifier        int     -  "packet type: 0 PUSH_DATA, 1 PUSH_ACK, 2 PULL_DATA, 3 PULL_RESP, 4 PULL_ACK, 5 TX_ACK"
key   gateway_eui       string  -  "gateway unique identifier (MAC address), the 8 octets as hexadecimal digits"
list  json              "the JSON object (rxpk and stat for PUSH_DATA, txpk for PULL_RESP, txpk_ack for TX_ACK), its UTF-8 octets"
key   octet             int     -  "one octet"
