# The m17 module: M17 LSF, stream and packet frame fields. Written by tools/gen/hamdig-pack.py.
module        m17
version       0.1.0
distribution  public
source        "M17 Protocol Specification, https://github.com/M17-Project/M17_spec at commit 9ae2874d8bd44e2d32fae85f7650a23f6bcee5d3, M17_spec.tex, chapters Data Link Layer (Link Setup, CRC, Stream Frames, Packet Frames) and Application Layer (LSF TYPE and META) (GNU FDL 1.3 or later, Copyright 2023-2026 M17 Project); layouts restated, no text copied"
key   destination            string  -  "LSF DST: the encoded destination address, 6 octets as hexadecimal digits (base-40 callsign or special identifier)"
key   source                 string  -  "LSF SRC: the encoded source address, 6 octets as hexadecimal digits"
key   type_reserved          int     -  "LSF TYPE: the four reserved bits"
key   signed_stream          int     -  "LSF TYPE: signed stream (stream mode)"
key   channel_access_number  int     -  "LSF TYPE: channel access number, 0-15"
key   encryption_subtype     int     -  "LSF TYPE: encryption subtype (the META type when unencrypted: 0 text, 1 GNSS, 2 extended callsign; the key length otherwise)"
key   encryption_type        int     -  "LSF TYPE: encryption type (0 none, 1 scrambler, 2 AES, 3 other)"
key   data_type              int     -  "LSF TYPE: data type (stream mode: 1 data, 2 voice, 3 voice and data)"
key   packet_stream          int     -  "LSF TYPE: 0 packet mode, 1 stream mode"
key   text_control           int     -  "META text: control octet (block bitmap and block index)"
key   text_block             string  -  "META text: the 13 text octets as hexadecimal digits (UTF-8, space padded)"
key   gnss_data_source       int     -  "META GNSS: data source (0 M17 client, 1 OpenRTX, 15 other)"
key   gnss_station_type      int     -  "META GNSS: station type (0 fixed, 1 mobile, 2 handheld, 15 other)"
key   gnss_validity          int     -  "META GNSS: validity bits (8 position, 4 altitude, 2 velocity, 1 radius)"
key   gnss_radius            int     -  "META GNSS: radius code (an estimate of lateral uncertainty from HDOP)"
key   gnss_bearing           int     -  "META GNSS: bearing, degrees from north"
key   gnss_latitude          float   -  "META GNSS: latitude, degrees (+-90 at +-8388607), positive north; the datum is not stated"
key   gnss_longitude         float   -  "META GNSS: longitude, degrees (+-180 at +-8388607), positive east; the datum is not stated"
key   gnss_altitude          float   -  "META GNSS: altitude, metres (0.5 m steps from -500 m); the reference is not stated"
key   gnss_speed             float   -  "META GNSS: speed, km/h"
key   gnss_reserved          int     -  "META GNSS: the 12 reserved bits"
key   extended_callsign_1    string  -  "META extended callsign: the first encoded callsign (originator)"
key   extended_callsign_2    string  -  "META extended callsign: the second encoded callsign (reflector), or zeros"
key   extended_unused        string  -  "META extended callsign: the two unused octets"
key   meta                   string  -  "META, encrypted or of a reserved type: the 14 octets as hexadecimal digits"
key   crc                    string  -  "LSF CRC (polynomial 0x5935, initial 0xFFFF), as sent, as hexadecimal digits (not computed)"
key   lich_chunk             string  -  "stream frame: the 40-bit chunk of the LSF, as hexadecimal digits"
key   lich_counter           int     -  "stream frame: which LSF chunk (0-5)"
key   lich_reserved          int     -  "stream frame: the five reserved LICH bits"
key   end_of_stream          int     -  "stream frame: the frame number's top bit, set in the last frame"
key   frame_number           int     -  "stream frame: the frame number, 0 to 0x7FFF"
key   stream_data            string  -  "stream frame: the 16 octets of stream data (Codec 2 speech or data), as hexadecimal digits"
key   packet_chunk           string  -  "packet frame: the 25-octet chunk of the packet data, as hexadecimal digits"
key   end_of_frame           int     -  "packet frame: set in the last frame"
key   packet_counter         int     -  "packet frame: the frame number (end_of_frame 0) or the number of valid octets, 1-25 (end_of_frame 1)"
key   packet_reserved        int     -  "packet frame: the two reserved bits"
