# The sunspec160 module: the points of SunSpec model 160 (mppt).
# Generated by tools/gen/sunspec2pack.py; do not edit by hand. A key is
# <model>_<point path> in lower case with underscores. A point scaled by a
# scale-factor point is carried unscaled; a point with a fixed scale factor
# is scaled, in the unit the model states.
module        sunspec160
version       0.1.0
distribution  public
source        "https://github.com/sunspec/models json/model_*.json at v2026-04-20 (commit a0b3e732ca9c163889a9c33f41c9315668a2488c); unimplemented values from https://github.com/sunspec/pysunspec2 sunspec2/mb.py at v1.3.7 (commit bbe9e044c2ae06af54b49e5ef042493eddb7e2b8)"
key   mppt_dca_sf  int  -  "model 160, point: DCA_SF"
key   mppt_dcv_sf  int  -  "model 160, point: DCV_SF"
key   mppt_dcw_sf  int  -  "model 160, point: DCW_SF"
key   mppt_dcwh_sf  int  -  "model 160, point: DCWH_SF"
key   mppt_evt  int  -  "model 160, point: Evt"
key   mppt_n  int  -  "model 160, point: N"
key   mppt_tms_per  int  -  "model 160, point: TmsPer"
key   l  int  registers  "point L, the model length in registers"
