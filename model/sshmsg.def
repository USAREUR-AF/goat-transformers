# The sshmsg module: SSH message fields (RFC 4253, 4252, 4254, 8308). Written by tools/gen/remote-pack.py.
module        sshmsg
version       0.1.0
distribution  public
source        "IETF RFC 4253 sections 7, 11, 12 and 10; RFC 4251 section 5 (data types); RFC 4252 sections 5, 5.1 and 5.4; RFC 4254 sections 4, 5 and 6; RFC 8308 section 2.3; https://www.rfc-editor.org/; layout restated"
key   message_number              int     -  "message number (1 DISCONNECT, 2 IGNORE, 3 UNIMPLEMENTED, 4 DEBUG, 5 SERVICE_REQUEST, 6 SERVICE_ACCEPT, 7 EXT_INFO, 20 KEXINIT, 21 NEWKEYS, 30-49 key exchange method, 50-53 userauth, 60-79 userauth method, 80-82 global requests, 90-100 channels)"
key   reason_code                 int     -  "DISCONNECT or CHANNEL_OPEN_FAILURE reason code"
list  description                 "a description string, as UTF-8 octets"
list  language_tag                "a language tag string, as octets"
list  data                        "IGNORE, CHANNEL_DATA, CHANNEL_EXTENDED_DATA: the data, as octets"
key   rejected_sequence           int     -  "UNIMPLEMENTED: the sequence number of the rejected packet"
key   always_display              int     -  "DEBUG: always display"
list  service_name                "SERVICE_REQUEST, SERVICE_ACCEPT, USERAUTH_REQUEST: the service name, as octets"
list  extensions                  "EXT_INFO: the extensions (their count is written from the list)"
list  extension_name              "an extension name, as octets"
list  extension_value             "an extension value, as octets"
key   cookie                      string  -  "KEXINIT: the 16 random octets, as hexadecimal digits"
list  kex_algorithms              "KEXINIT: the key exchange algorithms name-list, as its comma-separated octets"
list  server_host_key_algorithms  "KEXINIT: server host key algorithms name-list"
list  encryption_c2s              "KEXINIT: encryption algorithms client to server"
list  encryption_s2c              "KEXINIT: encryption algorithms server to client"
list  mac_c2s                     "KEXINIT: MAC algorithms client to server"
list  mac_s2c                     "KEXINIT: MAC algorithms server to client"
list  compression_c2s             "KEXINIT: compression algorithms client to server"
list  compression_s2c             "KEXINIT: compression algorithms server to client"
list  languages_c2s               "KEXINIT: languages client to server"
list  languages_s2c               "KEXINIT: languages server to client"
key   first_kex_packet_follows    int     -  "KEXINIT: a guessed key exchange packet follows"
key   kexinit_reserved            int     -  "KEXINIT: the reserved uint32, 0"
list  user_name                   "USERAUTH_REQUEST: the user name, as octets"
list  method_name                 "USERAUTH_REQUEST: the method name (password, publickey, none ...)"
list  method_data                 "USERAUTH_REQUEST: the method-specific fields, as octets"
list  authentications             "USERAUTH_FAILURE: the methods that can continue, a name-list"
key   partial_success             int     -  "USERAUTH_FAILURE: partial success"
list  request_name                "GLOBAL_REQUEST or CHANNEL_REQUEST: the request name, as octets"
key   want_reply                  int     -  "GLOBAL_REQUEST or CHANNEL_REQUEST: want reply"
list  request_data                "the request- or channel-type-specific fields, as octets"
list  channel_type                "CHANNEL_OPEN: the channel type (session, direct-tcpip ...)"
key   sender_channel              int     -  "the sender's channel number"
key   recipient_channel           int     -  "the recipient's channel number"
key   initial_window_size         int     -  "initial window size, octets"
key   maximum_packet_size         int     -  "maximum packet size, octets"
key   bytes_to_add                int     -  "CHANNEL_WINDOW_ADJUST: octets to add to the window"
key   data_type_code              int     -  "CHANNEL_EXTENDED_DATA: data type (1 stderr)"
list  message_data                "a message of another number (key exchange methods, userauth methods ...): its fields, as octets"
key   octet                       int     -  "one octet"
