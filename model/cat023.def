# The cat023 module: the values of ASTERIX Category 023 (CNS/ATM Ground Station and Service Status Reports), edition 1.3,
# as the category holds them. Used by the pack `asterix-cat023`. Generated by
# tools/gen/asterix2pack.py; do not edit by hand. A key is named after its item
# and subitems; a repetitive item is a list and its keys are the keys of one
# repetition.
module        cat023
version       0.1.0
distribution  public
source        "ASTERIX Category 023, CNS/ATM Ground Station and Service Status Reports, edition 1.3 (2021-09-27), as transcribed in github.com/zoranbosnjak/asterix-specs (BSD-3-Clause), commit 64e9ffba964b92a1af3157bc6bdf7852a63bf700, specs/cat023/cats/cat1.3/definition.json. The category is specified by EUROCONTROL"
key   i010_sac   int     -       "I023/010/SAC: System Area Code (Data Source Identifier)"
key   i010_sic   int     -       "I023/010/SIC: System Identification Code (Data Source Identifier)"
key   i000       int     -       "I023/000: Report Type. 1 = Ground station status report, 2 = Service status report, 3 = Service statistics report"
key   i015_sid   int     -       "I023/015/SID: Service Identification (Service Type and Identification)"
key   i015_styp  int     -       "I023/015/STYP: Type of Service (Service Type and Identification). 1 = ADS-B VDL4, 2 = ADS-B Ext Squitter, 3 = ADS-B UAT, 4 = TIS-B VDL4, 5 = TIS-B Ext Squitter, 6 = TIS-B UAT, 7 = FIS-B VDL4, 8 = GRAS VDL4, 9 = MLT"
key   i070       float   s       "I023/070: Time of Day. LSB 1/128 s"
key   i100_nogo  int     -       "I023/100/NOGO: Operational Release Status of the Data (Ground Station Status). 0 = Data is released for operational use, 1 = Data must not be used operationally"
key   i100_odp   int     -       "I023/100/ODP: Data Processor Overload Indicator (Ground Station Status). 0 = Default, no overload, 1 = Overload in DP"
key   i100_oxt   int     -       "I023/100/OXT: Ground Interface Data Communications Overload (Ground Station Status). 0 = Default, no overload, 1 = Overload in transmission subsystem"
key   i100_msc   int     -       "I023/100/MSC: Monitoring System Connected Status (Ground Station Status). 0 = Monitoring system not connected or unknown, 1 = Monitoring system connected"
key   i100_tsv   int     -       "I023/100/TSV: Time Source Validity (Ground Station Status). 0 = Valid, 1 = Invalid"
key   i100_spo   int     -       "I023/100/SPO: Indication of Spoofing Attack (Ground Station Status). 0 = No spoofing detected, 1 = Potential spoofing attack"
key   i100_rn    int     -       "I023/100/RN: Renumbering Indication for Track ID (Ground Station Status). 0 = Default, 1 = Track numbering has restarted"
key   i100_gssp  float   s       "I023/100/GSSP: Ground Station Status Reporting Period (Ground Station Status). LSB 1 s"
key   i101_rp    float   s       "I023/101/RP: Report Period for Category 021 Reports (Service Configuration). LSB 1/2 s"
key   i101_sc    int     -       "I023/101/SC: Service Class (Service Configuration). 0 = No information, 1 = NRA class, 2 = Reserved for future use, 3 = Reserved for future use, 4 = Reserved for future use, 5 = Reserved for future use, 6 = Reserved for future use, 7 = Reserved for future use"
key   i101_ssrp  float   s       "I023/101/SSRP: Service Status Reporting Period (Service Configuration). LSB 1 s"
key   i200       float   NM      "I023/200: Operational Range. LSB 1 NM"
key   i110_stat  int     -       "I023/110/STAT: Status of the Service (Service Status). 0 = Unknown, 1 = Failed, 2 = Disabled, 3 = Degraded, 4 = Normal, 5 = Initialisation"
list  i120       "I023/120: Service Statistics, one item per repetition"
key   i120_type  int     -       "I023/120/TYPE: Type of Report Counter (Service Statistics). 0 = Number of unknown messages received, 1 = Number of too old messages received, 2 = Number of failed message conversions, 3 = Total Number of messages received, 4 = Total Number of messages transmitted, 20 = Number of TIS-B management messages received, 21 = Number of Basic messages received, 22 = Number of High Dynamic messages rece..."
key   i120_ref   int     -       "I023/120/REF: Reference from which the Messages Are Countered (Service Statistics). 0 = From midnight, 1 = From the last report"
key   i120_cv    int     -       "I023/120/CV: 32-bit Counter Value (Service Statistics)"
# Derived keys (engine-spec 0.6 and 0.8), applied by `convert` between decode and encode.
derive  cat023.i070  day_seconds  time_ms
