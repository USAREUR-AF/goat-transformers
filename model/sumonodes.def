key  value                    string  -    "paramType.@value (xs:string) at @value; an item of 2 groups"
key  version                  string  -    "nodesType.@version (version#1, xs:string) at @version; 1 kind"
key  x                        string  -    "nodeType.@x (floatType, xs:string) at @x; an item of 2 groups"
key  y                        string  -    "nodeType.@y (floatType, xs:string) at @y; an item of 2 groups"
