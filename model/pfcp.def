# The pfcp module: the fields of PFCP messages (3GPP TS 29.244). Written by tools/gen/gtp-pack.py.
module        pfcp
version       0.1.0
distribution  public
source        "ETSI TS 129 244 V19.6.0 (3GPP TS 29.244 Release 19); restated by goat-transformers; no licence stated"
key   flags_spare          int     -  "the two spare bits of the first octet"
key   flag_fo              int     -  "FO: 1 when another PFCP message follows in the same datagram"
key   flag_mp              int     -  "MP: 1 when the header holds a message priority"
key   flag_s               int     -  "S: 1 when the header holds a SEID (session messages)"
key   message_type         int     -  "message type: 1 heartbeat request, 2 heartbeat response, 5 association setup request, 6 association setup response, ..., 50 session establishment request, 51 session establishment response, 52 session modification request, ..."
key   header_seid          int     -  "session endpoint identifier of the receiver (as uint reads 64 bits: negative when the top bit is set)"
key   sequence             int     -  "sequence number, 24 bits"
key   message_priority     int     -  "message priority, 0 highest to 15"
list  ies                  "the IEs of the message, in order"
list  grouped_ies          "the IEs inside a grouped IE (Create PDR, PDI, Create FAR and the others of types 1 to 18, 51, 54, 58, 59), in order"
key   ie_vendor            int     -  "1 when the IE is vendor-specific (an enterprise ID follows the length)"
key   ie_type              int     -  "IE type: 19 Cause, 20 Source Interface, 29 Precedence, 42 Destination Interface, 56 PDR ID, 57 F-SEID, 60 Node ID, 96 Recovery Time Stamp, ..."
key   enterprise_id        int     -  "IANA enterprise number of a vendor-specific IE"
key   cause                int     -  "Cause: cause value (1 request accepted, 64 request rejected, ...)"
key   interface_spare      int     -  "Source and Destination Interface: the four spare bits"
key   interface_value      int     -  "Source and Destination Interface: 0 access, 1 core, 2 SGi-LAN/N6-LAN, 3 CP function, ..."
key   precedence           int     -  "Precedence: the precedence of a PDR (lower is higher precedence)"
key   rule_id              int     -  "PDR ID: the rule identifier"
key   fseid_spare          int     -  "F-SEID: the six spare bits"
key   fseid_v4             int     -  "F-SEID: 1 when an IPv4 address follows"
key   fseid_v6             int     -  "F-SEID: 1 when an IPv6 address follows"
key   seid                 int     -  "F-SEID: session endpoint identifier (as uint reads 64 bits)"
key   ipv4                 int     -  "an IPv4 address (F-SEID, Node ID), as an unsigned 32-bit integer"
key   ipv6                 string  -  "an IPv6 address (F-SEID, Node ID), 32 hexadecimal digits"
key   node_id_spare        int     -  "Node ID: the four spare bits"
key   node_id_type         int     -  "Node ID: 0 IPv4 address, 1 IPv6 address, 2 FQDN"
list  node_id_fqdn         "Node ID: the FQDN in DNS label form, as octets"
key   recovery_time_stamp  int     -  "Recovery Time Stamp: when the node last started, seconds since 1900-01-01 00:00 UTC (NTP)"
list  extra                "octets after the defined fields of an extendable IE"
list  ie_value             "value of an IE the pack does not lay out, as octets"
key   octet                int     -  "one octet"
