# The cat007 module: the values of ASTERIX Category 007 (Transmission of Directed Interrogation Messages), edition 1.12,
# as the category holds them. Used by the pack `asterix-cat007`. Generated by
# tools/gen/asterix2pack.py; do not edit by hand. A key is named after its item
# and subitems; a repetitive item is a list and its keys are the keys of one
# repetition.
module        cat007
version       0.1.0
distribution  public
source        "ASTERIX Category 007, Transmission of Directed Interrogation Messages, edition 1.12 (2024-07-01), as transcribed in github.com/zoranbosnjak/asterix-specs (BSD-3-Clause), commit 64e9ffba964b92a1af3157bc6bdf7852a63bf700, specs/cat007/cats/cat1.12/definition.json. The category is specified by EUROCONTROL"
key   i010_sac           int     -       "I007/010/SAC: System Area Code (Data Source Identifier)"
key   i010_sic           int     -       "I007/010/SIC: System Identification Code (Data Source Identifier)"
key   i025_sac           int     -       "I007/025/SAC: System Area Code (Data Destination Identifier)"
key   i025_sic           int     -       "I007/025/SIC: System Identification Code (Data Destination Identifier)"
key   i410               int     -       "I007/410: Directed Interrogation Message Type. 0 = Acknowledge, 1 = Reject, 2 = Interrogation Finished, 3 = Interrogation Completed, 4 = Target Report, 5 = Interrogation Request Type A, 6 = Interrogation Request Type B, 7 = Interrogation Request Type C, 8 = Selective BDS-Register Request"
key   i140               float   s       "I007/140: Time of Day. LSB 1/128 s"
key   i400_pri           int     -       "I007/400/PRI: Priority of Command (Directed Interrogation Request Number). 0 = Normal Priority, surveillance function has priority, 1 = High Priority, Directed interrogation has priority over surveillance"
key   i400_rn            int     -       "I007/400/RN: Request Number (Directed Interrogation Request Number)"
key   i020_typ           int     -       "I007/020/TYP (Type and Properties of the Target Report and Target Capabilities). 0 = No detection, 1 = Single PSR detection, 2 = Single SSR detection, 3 = SSR + PSR detection, 4 = Single ModeS All-Call, 5 = Single ModeS Roll-Call, 6 = ModeS All-Call + PSR, 7 = ModeS Roll-Call + PSR"
key   i020_sim           int     -       "I007/020/SIM (Type and Properties of the Target Report and Target Capabilities). 0 = Actual target report, 1 = Simulated target report"
key   i020_rdp           int     -       "I007/020/RDP (Type and Properties of the Target Report and Target Capabilities). 0 = Report from RDP Chain 1, 1 = Report from RDP Chain 2"
key   i020_spi           int     -       "I007/020/SPI (Type and Properties of the Target Report and Target Capabilities). 0 = Absence of SPI, 1 = Special Position Identification"
key   i020_rab           int     -       "I007/020/RAB (Type and Properties of the Target Report and Target Capabilities). 0 = Report from aircraft transponder, 1 = Report from field monitor (fixed transponder)"
key   i020_tst           int     -       "I007/020/TST (Type and Properties of the Target Report and Target Capabilities). 0 = Real target report, 1 = Test target report"
key   i020_err           int     -       "I007/020/ERR (Type and Properties of the Target Report and Target Capabilities). 0 = No Extended Range, 1 = Extended Range present"
key   i020_xpp           int     -       "I007/020/XPP (Type and Properties of the Target Report and Target Capabilities). 0 = No X-Pulse present, 1 = X-Pulse present"
key   i020_me            int     -       "I007/020/ME (Type and Properties of the Target Report and Target Capabilities). 0 = No military emergency, 1 = Military emergency"
key   i020_mi            int     -       "I007/020/MI (Type and Properties of the Target Report and Target Capabilities). 0 = No military identification, 1 = Military identification"
key   i020_foefri        int     -       "I007/020/FOEFRI (Type and Properties of the Target Report and Target Capabilities). 0 = No Mode 4 interrogation, 1 = Friendly target, 2 = Unknown target, 3 = No reply"
key   i020_adsb_ep       int     -       "I007/020/ADSB/EP: On-Site ADS-B Information; ADSB Element Populated Bit (Type and Properties of the Target Report and Target Capabilities). 0 = ADSB not populated, 1 = ADSB populated"
key   i020_adsb_val      int     -       "I007/020/ADSB/VAL: On-Site ADS-B Information; On-Site ADS-B Information (Type and Properties of the Target Report and Target Capabilities). 0 = Not available, 1 = Available"
key   i020_scn_ep        int     -       "I007/020/SCN/EP: Surveillance Cluster Network Information; SCN Element Populated Bit (Type and Properties of the Target Report and Target Capabilities). 0 = SCN not populated, 1 = SCN populated"
key   i020_scn_val       int     -       "I007/020/SCN/VAL: Surveillance Cluster Network Information; Surveillance Cluster Network Information (Type and Properties of the Target Report and Target Capabilities). 0 = Not available, 1 = Available"
key   i020_pai_ep        int     -       "I007/020/PAI/EP: Passive Acquisition Interface Information; PAI Element Populated Bit (Type and Properties of the Target Report and Target Capabilities). 0 = PAI not populated, 1 = PAI populated"
key   i020_pai_val       int     -       "I007/020/PAI/VAL: Passive Acquisition Interface Information; Passive Acquisition Interface Information (Type and Properties of the Target Report and Target Capabilities). 0 = Not available, 1 = Available"
key   i020_acasvx_ep     int     -       "I007/020/ACASVX/EP: ACAS Extended Version; ACASVX Element Populated Bit (Type and Properties of the Target Report and Target Capabilities). 0 = ACASVX not populated, 1 = ACASVX populated"
key   i020_acasvx_val    int     -       "I007/020/ACASVX/VAL: ACAS Extended Version; ACAS Extended Version Value (Type and Properties of the Target Report and Target Capabilities). 0 = Non-Extended Version, 1 = ACAS Xa Version 1, 2 = ACAS Xu Version 1, 3 = Reserved for future versions, 4 = Reserved for future versions, 5 = Reserved for future versions, 6 = Reserved for future versions, 7 = Reserved for future versions, 8 = Reserved fo..."
key   i020_poxpr_ep      int     -       "I007/020/POXPR/EP: PO Transponder Capability; POXPR Element Populated Bit (Type and Properties of the Target Report and Target Capabilities). 0 = POXPR not populated, 1 = POXPR populated"
key   i020_poxpr_val     int     -       "I007/020/POXPR/VAL: PO Transponder Capability; PO Transponder Capability (Type and Properties of the Target Report and Target Capabilities). 0 = PO not supported (PPM only), 1 = PO supported"
key   i020_poact_ep      int     -       "I007/020/POACT/EP: PO Active for Current Plot; POACT Element Populated Bit (Type and Properties of the Target Report and Target Capabilities). 0 = POACT not populated, 1 = POACT populated"
