key   i020_dtfxpr_ep     int     -       "I007/020/DTFXPR/EP: Basic Dataflash Transponder Capability; DTFXPR Element Populated Bit (Type and Properties of the Target Report and Target Capabilities). 0 = DTFXPR not populated, 1 = DTFXPR populated"
key   i020_dtfxpr_val    int     -       "I007/020/DTFXPR/VAL: Basic Dataflash Transponder Capability; Basic Dataflash Transponder Capability (Type and Properties of the Target Report and Target Capabilities). 0 = Basic Dataflash not supported, 1 = Basic Dataflash supported"
key   i020_dtfact_ep     int     -       "I007/020/DTFACT/EP: Basic Dataflash Active for Current Plot; DTFACT Element Populated Bit (Type and Properties of the Target Report and Target Capabilities). 0 = DTFACT not populated, 1 = DTFACT populated"
key   i020_dtfact_val    int     -       "I007/020/DTFACT/VAL: Basic Dataflash Active for Current Plot; Basic Dataflash in Current Plot (Type and Properties of the Target Report and Target Capabilities). 0 = Basic Dataflash not active, 1 = Basic Dataflash active"
key   i020_irmxpr_ep     int     -       "I007/020/IRMXPR/EP: IRM Transponder Capability; IRMXPR Element Populated Bit (Type and Properties of the Target Report and Target Capabilities). 0 = IRMXPR not populated, 1 = IRMXPR populated"
key   i020_irmxpr_val    int     -       "I007/020/IRMXPR/VAL: IRM Transponder Capability; Transponder IRM Capability (Type and Properties of the Target Report and Target Capabilities). 0 = Transponder not IRM capable, 1 = Transponder IRM capable"
key   i020_irmact_ep     int     -       "I007/020/IRMACT/EP: IRM Active for Current Plot; IRMACT Element Populated Bit (Type and Properties of the Target Report and Target Capabilities). 0 = IRMACT not populated, 1 = IRMACT populated"
key   i020_irmact_val    int     -       "I007/020/IRMACT/VAL: IRM Active for Current Plot; IRM Active for Current Plot (Type and Properties of the Target Report and Target Capabilities). 0 = IRM not active, 1 = IRM active"
