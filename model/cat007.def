key   i085_pos_lon       float   deg     "I007/085/POS/LON: Subfield #3: Mode 5 Reported Position; Longitude in WGS 84 (Mode 5, Extended Mode 1 and X-Pulse). LSB 45/2097152 deg"
key   i085_ga_res        int     -       "I007/085/GA/RES: Subfield #4: Mode 5 GNSS-derived Altitude; Resolution with which the GNSS-derived Altitude (GA) is Reported (Mode 5, Extended Mode 1 and X-Pulse). 0 = GA reported in 100 ft increments, 1 = GA reported in 25 ft increments"
key   i085_ga_ga         float   ft      "I007/085/GA/GA: Subfield #4: Mode 5 GNSS-derived Altitude; GNSS-derived Altitude of Target, Expressed as Height Above WGS 84 Ellipsoid (Mode 5, Extended Mode 1 and X-Pulse). LSB 25 ft"
