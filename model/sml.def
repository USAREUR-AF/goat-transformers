# The sml module: elements of SML messages (Smart Message Language 1.04), each the wire value.
module        sml
version       0.1.0
distribution  public
source        "BSI TR-03109-1 Anlage IV Teil b, SML - Smart Message Language, version 1.0 of 18.03.2013 (SML 1.04), Bundesamt fuer Sicherheit in der Informationstechnik, bsi.bund.de; (c) BSI 2013, no licence stated; layouts restated"
key   abort_on_error                               int   -  "abortOnError (unsigned integer)"
key   abort_on_error_tl_len                        int   -  "TL field of abortOnError: the length in bytes, the TL byte included"
key   abort_on_error_tl_more                       int   -  "TL field of abortOnError: 1 when a further TL byte follows (not carried beyond this bit)"
key   abort_on_error_tl_type                       int   -  "TL field of abortOnError: the data type (0 octet string, 4 boolean, 5 integer, 6 unsigned, 7 list)"
key   body_count                                   int   -  "number of elements of the list messageBody"
key   body_tag                                     int   -  "the messageBody choice tag (0x0100 open request, 0x0101 open response, 0x0200 close request, 0x0201 close response, 0x0701 get list response) (unsigned integer)"
key   body_tag_tl_len                              int   -  "TL field of the messageBody choice tag (0x0100 open request, 0x0101 open response, 0x0200 close request, 0x0201 close response, 0x0701 get list response): the length in bytes, the TL byte included"
key   body_tag_tl_more                             int   -  "TL field of the messageBody choice tag (0x0100 open request, 0x0101 open response, 0x0200 close request, 0x0201 close response, 0x0701 get list response): 1 when a further TL byte follows (not carried beyond this bit)"
key   body_tag_tl_type                             int   -  "TL field of the messageBody choice tag (0x0100 open request, 0x0101 open response, 0x0200 close request, 0x0201 close response, 0x0701 get list response): the data type (0 octet string, 4 boolean, 5 integer, 6 unsigned, 7 list)"
key   body_tl_more                                 int   -  "TL field of messageBody: 1 when a further TL byte follows (not carried beyond this bit)"
key   body_tl_type                                 int   -  "TL field of messageBody: the data type (0 octet string, 4 boolean, 5 integer, 6 unsigned, 7 list)"
key   close_req_count                              int   -  "number of elements of the list SML_PublicClose.Req"
key   close_req_global_signature_byte              int   -  "one byte of globalSignature"
key   close_req_global_signature_tl_more           int   -  "TL field of globalSignature: 1 when a further TL byte follows (not carried beyond this bit)"
key   close_req_global_signature_tl_type           int   -  "TL field of globalSignature: the data type (0 octet string, 4 boolean, 5 integer, 6 unsigned, 7 list)"
key   close_req_tl_more                            int   -  "TL field of SML_PublicClose.Req: 1 when a further TL byte follows (not carried beyond this bit)"
key   close_req_tl_type                            int   -  "TL field of SML_PublicClose.Req: the data type (0 octet string, 4 boolean, 5 integer, 6 unsigned, 7 list)"
key   close_res_count                              int   -  "number of elements of the list SML_PublicClose.Res"
key   close_res_global_signature_byte              int   -  "one byte of globalSignature"
key   close_res_global_signature_tl_more           int   -  "TL field of globalSignature: 1 when a further TL byte follows (not carried beyond this bit)"
key   close_res_global_signature_tl_type           int   -  "TL field of globalSignature: the data type (0 octet string, 4 boolean, 5 integer, 6 unsigned, 7 list)"
