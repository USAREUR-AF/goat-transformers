# The wifi module: the body of an IEEE 802.11 beacon frame. Written by tools/gen/beacons-pack.py.
module        wifi
version       0.1.0
distribution  public
source        "google/gopacket, https://github.com/google/gopacket commit b7d9dbd15ae4c4621a62119b0c682dc23061a8bc, layers/dot11.go (BSD-3-Clause): the beacon frame body and the information element; opendroneid/opendroneid-core-c, https://github.com/opendroneid/opendroneid-core-c commit a92bd5ffe113edd076c159a06799152aed3b1fb0, libopendroneid/wifi.c and odid_wifi.h (Apache-2.0): the ASTM Remote ID vendor element of a Wi-Fi beacon; restated by goat-transformers"
key   timestamp               int     us    "timer of the transmitter when the beacon was sent (little-endian on the wire; as uint reads 64 bits)"
key   beacon_interval         int     TU    "time between beacons, in time units of 1024 microseconds"
key   capability              int     -     "capability information bits (little-endian on the wire)"
list  elements                "information elements of the frame body, in order"
key   element_id              int     -     "element ID: 0 SSID, 1 Supported Rates, 3 DS Parameter Set, 5 TIM, 221 Vendor Specific, ..."
list  ssid                    "SSID, as octets"
key   ssid_octet              int     -     "one octet of the SSID"
list  rates                   "supported rates, one octet each (units of 500 kbit/s; the top bit marks a basic rate)"
key   rate                    int     -     "one supported rate octet"
key   channel                 int     -     "DS Parameter Set: the current channel"
key   dtim_count              int     -     "TIM: beacons before the next DTIM"
key   dtim_period             int     -     "TIM: beacons between DTIMs"
key   bitmap_control          int     -     "TIM: bitmap control octet"
list  partial_virtual_bitmap  "TIM: partial virtual bitmap, as octets"
key   bitmap_octet            int     -     "one octet of the bitmap"
key   oui                     int     -     "Vendor Specific: the organisationally unique identifier, 24 bits"
key   oui_type                int     -     "Vendor Specific: the vendor's type octet after the OUI"
key   rid_message_counter     int     -     "ASTM Remote ID element: message counter"
list  rid_message_pack        "ASTM Remote ID element: the message pack, as octets; the remote-id pack reads it"
key   rid_message_pack_octet  int     -     "one octet of the message pack"
list  vendor_data             "Vendor Specific data the pack does not read, as octets"
key   vendor_octet            int     -     "one octet of that data"
list  element_data            "data of an element of another ID, as octets"
key   element_octet           int     -     "one octet of that data"
