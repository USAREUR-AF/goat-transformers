# The agopengps module: fields of AgOpenGPS PGN messages, each the wire value unless the line says otherwise.
module        agopengps
version       0.1.0
distribution  public
source        "AgOpenGPS (https://github.com/AgOpenGPS-Official/AgOpenGPS, Apache License 2.0) tag 6.8.6, commit 21be26aa58d09b9b5abacc715d0abcf4a021f1db: docs/pgn-protocol.md (the PGN protocol), cross-checked with SourceCode/AgIO/Source/Forms/NMEA.Designer.cs, SourceCode/GPS_Out/Source/PGNs/PGN54908.cs, SourceCode/GPS/Forms/UDPComm.Designer.cs and PGN.Designer.cs; layouts restated"
key   checksum                           int   -  "the sum of the bytes from the source address to the last data byte, modulo 256 (not checked)"
key   p211_angular_velocity              int   -  "angular velocity, the wire value (the document says divide by -2)"
key   p211_heading_deg                   float -  "IMU heading, degrees (the wire value / 10)"
key   p211_roll_deg                      float -  "IMU roll, degrees (the wire value / 10)"
key   p212_disconnect                    int   -  "1 when the IMU is disconnected"
key   p214_age_x100                      int   -  "age of differential corrections x 100, s"
key   p214_altitude_m                    float -  "altitude in metres, as the GGA sentence gives it (above mean sea level, not hae)"
key   p214_fix_quality                   int   -  "fix quality of the GGA sentence"
key   p214_hdop_x100                     int   -  "HDOP x 100"
key   p214_heading_dual                  float -  "dual antenna heading, degrees (float.MaxValue: none)"
key   p214_heading_true                  float -  "heading from a single antenna (from the VTG or RMC sentence), degrees"
key   p214_imu_heading                   int   -  "external IMU heading (65535: no IMU)"
key   p214_imu_pitch                     int   -  "external IMU pitch"
key   p214_imu_roll                      int   -  "external IMU roll"
key   p214_imu_yaw_rate                  int   -  "external IMU yaw rate"
key   p214_roll                          float -  "roll, degrees"
key   p214_satellites                    int   -  "number of satellites"
key   p214_speed                         float -  "speed from the VTG sentence (AgOpenGPS's speed unit; the document does not state it)"
key   p221_color                         int   -  "0 salmon, other bisque"
key   p221_display_time_s                int   -  "seconds to display"
key   p221_message_byte                  int   -  "one byte of the UTF-8 text of the message"
key   p222_command                       int   -  "command value: bit 0 nudge right, bit 1 cycle backward"
key   p222_mask                          int   -  "command mask"
key   p228_rate0                         int   -  "rate setting 0"
key   p228_rate1                         int   -  "rate setting 1"
key   p228_rate2                         int   -  "rate setting 2"
key   p229_sections_17_24                int   -  "sections 17-24, a bit per section"
key   p229_sections_1_8                  int   -  "sections 1-8, a bit per section"
key   p229_sections_25_32                int   -  "sections 25-32, a bit per section"
key   p229_sections_33_40                int   -  "sections 33-40, a bit per section"
key   p229_sections_41_48                int   -  "sections 41-48, a bit per section"
key   p229_sections_49_56                int   -  "sections 49-56, a bit per section"
key   p229_sections_57_64                int   -  "sections 57-64, a bit per section"
key   p229_sections_9_16                 int   -  "sections 9-16, a bit per section"
key   p229_tool_left_speed               int   -  "left tool speed"
key   p229_tool_right_speed              int   -  "right tool speed"
key   p234_switches_byte                 int   -  "one byte of the section switch states"
key   p235_num_sections                  int   -  "number of sections"
key   p235_section_width_0               int   -  "width of section 0"
key   p235_section_width_1               int   -  "width of section 1"
key   p235_section_width_10              int   -  "width of section 10"
key   p235_section_width_11              int   -  "width of section 11"
key   p235_section_width_12              int   -  "width of section 12"
key   p235_section_width_13              int   -  "width of section 13"
key   p235_section_width_14              int   -  "width of section 14"
key   p235_section_width_15              int   -  "width of section 15"
key   p235_section_width_2               int   -  "width of section 2"
key   p235_section_width_3               int   -  "width of section 3"
key   p235_section_width_4               int   -  "width of section 4"
key   p235_section_width_5               int   -  "width of section 5"
key   p235_section_width_6               int   -  "width of section 6"
key   p235_section_width_7               int   -  "width of section 7"
key   p235_section_width_8               int   -  "width of section 8"
key   p235_section_width_9               int   -  "width of section 9"
key   p236_pins_byte                     int   -  "one byte of the pin configuration of the 24 relays"
key   p238_enable_hyd                    int   -  "hydraulics enabled"
key   p238_lower_time                    int   -  "hydraulic lower time"
key   p238_raise_time                    int   -  "hydraulic raise time"
key   p238_set0                          int   -  "user setting 0"
key   p238_user1                         int   -  "user defined 1"
key   p238_user2                         int   -  "user defined 2"
key   p238_user3                         int   -  "user defined 3"
key   p238_user4                         int   -  "user defined 4"
key   p239_byte10                        int   -  "data byte 10, which the document does not name"
key   p239_geo_stop                      int   -  "geofence stop"
key   p239_hyd_lift                      int   -  "hydraulic lift state"
key   p239_sections_1_8                  int   -  "section states 1-8"
key   p239_sections_9_16                 int   -  "section states 9-16"
key   p239_speed                         int   -  "vehicle speed, the wire value"
key   p239_tram                          int   -  "tramline state"
key   p239_uturn                         int   -  "U-turn state"
key   p240_clients                       int   -  "status bits 1-3: number of clients"
key   p240_num_sections                  int   -  "number of sections, 0 = no implement"
key   p240_section_control_enabled       int   -  "status bit 0: section control enabled"
key   p240_section_states_byte           int   -  "one byte of the section states, one bit per section"
key   p240_status_reserved               int   -  "status bits 4-7"
key   p241_enabled                       int   -  "1 enable, 0 disable"
key   p242_identifier                    int   -  "process data identifier (513 guidance deviation, 397 speed, 597 total distance)"
key   p242_value                         int   -  "process data value"
key   p243_name_byte                     int   -  "one byte of the UTF-8 name of the active field (no bytes: field closed)"
key   p250_sensor                        int   -  "raw sensor value"
key   p251_ackerman_fix                  int   -  "Ackerman fix"
key   p251_angular_velocity              int   -  "maximum angular velocity"
key   p251_max_pulse                     int   -  "maximum pulse count"
key   p251_min_speed                     int   -  "minimum speed for steering"
key   p251_set0                          int   -  "configuration byte 0"
key   p252_ackerman                      int   -  "Ackerman compensation"
key   p252_counts_per_degree             int   -  "WAS sensor counts per degree"
key   p252_gain_proportional             int   -  "Kp"
key   p252_high_pwm                      int   -  "maximum PWM"
key   p252_low_pwm                       int   -  "minimum PWM when driving"
key   p252_min_pwm                       int   -  "absolute minimum PWM"
key   p252_was_offset                    int   -  "WAS offset"
key   p253_actual_steer_angle_deg        float -  "actual steer angle, degrees (the wire value / 100)"
key   p253_heading                       int   -  "module heading, the wire value (9999: none)"
key   p253_pwm                           int   -  "actual PWM output"
key   p253_roll                          int   -  "module roll, the wire value (8888: none)"
key   p253_steer_switch                  int   -  "switch status bit 1: steer switch on"
key   p253_switch_reserved               int   -  "switch status bits 2-7"
key   p253_work_switch                   int   -  "switch status bit 0: work switch on"
key   p254_line_distance                 int   -  "distance from the guidance line, the wire value"
key   p254_sections_1_8                  int   -  "section control 1-8, a bit per section"
key   p254_sections_9_16                 int   -  "section control 9-16"
key   p254_speed                         int   -  "speed, the wire value"
key   p254_status                        int   -  "autosteer status"
key   p254_steer_angle                   int   -  "commanded steer angle, the wire value"
key   source                             int   -  "source address (0x7F AgOpenGPS, 0x7C AgIO, others for the modules)"
list  p221_message                       "the UTF-8 text of the message"
list  p234_switches                      "the section switch states"
list  p236_pins                          "the pin configuration of the 24 relays"
list  p240_section_states                "the section states, one bit per section"
list  p243_name                          "the UTF-8 name of the active field (no bytes: field closed)"
