# The seatalk module: SeaTalk 1 datagram fields. Written by tools/gen/seatalk-pack.py.
module        seatalk
version       0.1.0
distribution  public
source        "SignalK/signalk-parser-nmea0183, https://github.com/SignalK/signalk-parser-nmea0183 at commit 5ab479bcfc1bec0d36f98616e5f9be96f52e3f23, src/hooks/seatalk/0x00.ts to 0x9C.ts (Apache License 2.0, Copyright 2016 Signal K and contributors); layouts restated, no code or comment copied"
key   attribute_high              int     -  "attribute octet, high nibble: data in several datagrams (0x25 total mileage bits 16-19, 0x50/0x51 a tag, 0x53/0x84/0x9C U, 0x54 T, 0x56 month, 0x57 satellite count, 0x85 the high XTE digit)"
key   attribute_length            int     -  "attribute octet, low nibble: the number of data octets after the first, as sent"
key   depth_anchor_alarm          int     -  "0x00: Y bit 3, anchor alarm active"
key   depth_metric_units          int     -  "0x00: Y bit 2, metric (or fathom) display units"
key   depth_flag_y1               int     -  "0x00: Y bit 1"
key   depth_flag_y0               int     -  "0x00: Y bit 0"
key   depth_flag_z3               int     -  "0x00: Z bit 3"
key   depth_transducer_defective  int     -  "0x00: Z bit 2, transducer defective"
key   depth_deep_alarm            int     -  "0x00: Z bit 1, deep alarm"
key   depth_shallow_alarm         int     -  "0x00: Z bit 0, shallow alarm"
key   depth_raw                   int     -  "0x00: depth below transducer in tenths of a foot (the source masks bit 15 before scaling)"
key   apparent_wind_angle         float   -  "0x10: apparent wind angle, degrees right of the bow"
key   apparent_wind_speed_units   int     -  "0x11: display units, 1 m/s, 0 knots"
key   apparent_wind_speed_knots   int     -  "0x11: whole knots"
key   apparent_wind_speed_pad     int     -  "0x11: high nibble of the fourth octet"
key   apparent_wind_speed_tenths  int     -  "0x11: tenths of a knot"
key   speed_through_water         float   -  "0x20: speed through water, knots"
key   trip_low                    int     -  "0x21, 0x25: trip mileage, the low 16 bits (in hundredths of a nautical mile with trip_high)"
key   trip_pad                    int     -  "0x21, 0x25: high nibble of the last octet"
key   trip_high                   int     -  "0x21, 0x25: trip mileage bits 16-19"
key   total_mileage               float   -  "0x22: total mileage, nautical miles"
key   total_pad                   int     -  "0x22: the last octet (0)"
key   total_low                   int     -  "0x25: total mileage, the low 16 bits (in tenths of a nautical mile, with attribute_high as bits 16-19)"
key   speed_sensor_1              float   -  "0x26: speed through water from sensor 1, knots (valid if flag D bit 2)"
key   speed_sensor_2_or_average   float   -  "0x26: average speed, or sensor 2 if flag D bit 3, knots"
key   speed_flags_d               int     -  "0x26: flags D"
key   speed_flags_e               int     -  "0x26: flags E (bit 0 average stopped, bit 1 display in mph)"
key   water_temperature           float   -  "0x27: water temperature, degrees Celsius"
key   latitude_degrees            int     -  "0x50: latitude, whole degrees"
key   latitude_minutes_raw        int     -  "0x50: bit 15 set for south; bits 14-0 the minutes in hundredths"
key   longitude_degrees           int     -  "0x51: longitude, whole degrees"
key   longitude_minutes_raw       int     -  "0x51: bit 15 set for east; bits 14-0 the minutes in hundredths"
key   speed_over_ground           float   -  "0x52: speed over ground, knots"
key   course_vw                   int     -  "0x53: VW octet (magnetic course = (U & 3) x 90 + (VW & 0x3F) x 2 + (U & 0xC) / 8, with U the attribute's high nibble)"
key   time_rs                     int     -  "0x54: RS octet (minutes = RS div 4; seconds = (RS & 3) x 16 + T, with T the attribute's high nibble)"
key   time_hours                  int     -  "0x54: hours"
key   date_day                    int     -  "0x56: day of the month"
key   date_year                   int     -  "0x56: year (two digits)"
key   satellite_hdop              int     -  "0x57: horizontal dilution of position"
key   waypoint_xx                 int     -  "0x82: first name octet"
key   waypoint_xx_complement      int     -  "0x82: its complement"
key   waypoint_yy                 int     -  "0x82: second name octet"
key   waypoint_yy_complement      int     -  "0x82: its complement"
key   waypoint_zz                 int     -  "0x82: third name octet"
key   waypoint_zz_complement      int     -  "0x82: its complement"
key   heading_vw                  int     -  "0x84, 0x9C: VW octet of the compass heading (with U, the attribute's high nibble)"
key   autopilot_course_xy         int     -  "0x84: XY octet of the autopilot course (with the two high bits of V)"
key   autopilot_pad               int     -  "0x84: high nibble of octet 4"
key   autopilot_mode              int     -  "0x84: Z (bit 1 auto, bit 2 vane, bit 3 track)"
key   alarm_pad                   int     -  "0x84: high nibble of octet 5"
key   alarms                      int     -  "0x84: M (bit 2 off course, bit 3 wind shift)"
key   rudder_position             int     -  "0x84, 0x9C: rudder position, degrees (positive to starboard)"
key   autopilot_ss                int     -  "0x84: SS display flags"
key   autopilot_tt                int     -  "0x84: TT"
key   xte_low                     int     -  "0x85: XX, the low octet of the cross-track error in hundredths of a nautical mile"
key   nav_v                       int     -  "0x85: V"
key   nav_u                       int     -  "0x85: U (bits 1-0 bearing quadrant, bit 3 true)"
key   nav_z                       int     -  "0x85: Z"
key   nav_w                       int     -  "0x85: W"
key   nav_zz                      int     -  "0x85: ZZ (distance with Z)"
key   nav_y                       int     -  "0x85: Y (bit 0 distance in hundredths, bit 2 steer right)"
key   nav_f                       int     -  "0x85: F (bits 0-3: XTE, bearing, range present, XTE above 0.3 nm)"
key   nav_zero                    int     -  "0x85: the zero octet"
key   nav_yf_complement           int     -  "0x85: the complement of YF"
key   compass_variation           int     -  "0x99: compass variation, degrees (positive west, negative east)"
key   command                     int     -  "another datagram: the command octet"
key   data_first                  int     -  "another datagram: the first data octet"
list  data_more                   "another datagram: the data octets after the first (their count is the attribute's low nibble)"
key   octet                       int     -  "one octet"
