key  probability    string  -    "edgeRelationType.@probability (floatType, xs:string) at @probability; an item of 1 group"
key  to             string  -    "edgeRelationType.@to (xs:string) at @to; an item of 2 groups"
list edge           "intervalType.edge (edgeDataType), repeated, at edge; 1 group"
list edge_relation  "intervalType.edgeRelation (edgeRelationType), repeated, at edgeRelation; 1 group"
list interval       "data#1.interval (intervalType), repeated, at interval; 1 group"
