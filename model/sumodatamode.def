key  begin          string  -    "intervalType.@begin (timeType, xs:string) at @begin; an item of 1 group"
key  count          string  -    "edgeDataType.@count (floatType, xs:string) at @count; an item of 3 groups"
key  end            string  -    "intervalType.@end (timeType, xs:string) at @end; an item of 1 group"
key  from           string  -    "edgeRelationType.@from (xs:string) at @from; an item of 2 groups"
