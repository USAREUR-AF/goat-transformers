key   i110             int     -       "I034/110: Data Filter. 0 = Invalid value, 1 = Filter for Weather data, 2 = Filter for Jamming Strobe, 3 = Filter for PSR data, 4 = Filter for SSR/Mode S data, 5 = Filter for SSR/Mode S + PSR data, 6 = Enhanced Surveillance data, 7 = Filter for PSR+Enhanced Surveillance data, 8 = Filter for PSR+Enhanced Surveillance + SSR/Mode S data not in Area of Prime Interest, 9 = Filter for PSR+Enhanced Sur..."
key   i120_hgt         float   m       "I034/120/HGT: Height of Data Source (3D-Position Of Data Source). LSB 1 m"
key   i120_lat         float   deg     "I034/120/LAT: Latitude (3D-Position Of Data Source). LSB 45/2097152 deg"
key   i120_lon         float   deg     "I034/120/LON: Longitude (3D-Position Of Data Source). LSB 45/2097152 deg"
