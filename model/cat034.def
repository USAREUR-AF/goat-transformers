key   i060_mds_clu     int     -       "I034/060/MDS/CLU: Specific Processing Mode Information for a Mode S Sensor; Cluster State (System Processing Mode). 0 = Autonomous, 1 = Not autonomous"
list  i070             "I034/070: Message Count Values, one item per repetition"
key   i070_typ         int     -       "I034/070/TYP: Type of Message Counter (Message Count Values). 0 = No detection (number of misses), 1 = Single PSR target reports, 2 = Single SSR target reports (Non-Mode S), 3 = SSR+PSR target reports (Non-Mode S), 4 = Single All-Call target reports (Mode S), 5 = Single Roll-Call target reports (Mode S), 6 = All-Call + PSR (Mode S) target reports, 7 = Roll-Call + PSR (Mode S) target reports, 8 ..."
key   i070_count       int     -       "I034/070/COUNT: COUNTER (Message Count Values)"
