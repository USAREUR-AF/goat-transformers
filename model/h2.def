# The h2 module: HTTP/2 frame fields (RFC 9113). Written by tools/gen/webframes-pack.py.
module        h2
version       0.1.0
distribution  public
source        "IETF RFC 9113, HTTP/2, June 2022, sections 4.1 and 6, https://www.rfc-editor.org/rfc/rfc9113.txt; layout restated"
key   frame_type              int     -  "frame type: 0 DATA, 1 HEADERS, 2 PRIORITY, 3 RST_STREAM, 4 SETTINGS, 5 PUSH_PROMISE, 6 PING, 7 GOAWAY, 8 WINDOW_UPDATE, 9 CONTINUATION"
key   flag_0x80               int     -  "flag bit 0x80 (unused by the frame types of RFC 9113)"
key   flag_0x40               int     -  "flag bit 0x40 (unused)"
key   flag_priority           int     -  "flag 0x20: PRIORITY (HEADERS)"
key   flag_0x10               int     -  "flag bit 0x10 (unused)"
key   flag_padded             int     -  "flag 0x08: PADDED (DATA, HEADERS, PUSH_PROMISE)"
key   flag_end_headers        int     -  "flag 0x04: END_HEADERS (HEADERS, PUSH_PROMISE, CONTINUATION)"
key   flag_0x02               int     -  "flag bit 0x02 (unused)"
key   flag_end_stream_or_ack  int     -  "flag 0x01: END_STREAM (DATA, HEADERS) or ACK (SETTINGS, PING)"
key   stream_reserved         int     -  "the reserved bit before the stream identifier"
key   stream_id               int     -  "stream identifier (0 for the connection)"
key   pad_length              int     -  "PADDED: the length of the padding at the end of the payload"
list  data                    "DATA: the data and any padding, as octets"
key   exclusive               int     -  "priority: E, the dependency is exclusive"
key   stream_dependency       int     -  "priority: the stream depended on"
key   weight                  int     -  "priority: weight minus one"
list  header_block            "HEADERS, PUSH_PROMISE, CONTINUATION: the field block fragment (HPACK) and any padding, as octets"
key   error_code              int     -  "RST_STREAM, GOAWAY: error code (0 NO_ERROR, 1 PROTOCOL_ERROR, 2 INTERNAL_ERROR, 3 FLOW_CONTROL_ERROR, 7 REFUSED_STREAM, 8 CANCEL ...)"
list  settings                "SETTINGS: the settings"
key   setting_id              int     -  "setting identifier (1 HEADER_TABLE_SIZE, 2 ENABLE_PUSH, 3 MAX_CONCURRENT_STREAMS, 4 INITIAL_WINDOW_SIZE, 5 MAX_FRAME_SIZE, 6 MAX_HEADER_LIST_SIZE)"
key   setting_value           int     -  "setting value"
key   promised_reserved       int     -  "PUSH_PROMISE: the reserved bit"
key   promised_stream_id      int     -  "PUSH_PROMISE: the promised stream identifier"
key   opaque_data             string  -  "PING: the 8 octets of opaque data, as hexadecimal digits"
key   goaway_reserved         int     -  "GOAWAY: the reserved bit"
key   last_stream_id          int     -  "GOAWAY: the last stream identifier processed"
list  debug_data              "GOAWAY: additional debug data, as octets"
key   window_reserved         int     -  "WINDOW_UPDATE: the reserved bit"
key   window_size_increment   int     -  "WINDOW_UPDATE: the window size increment"
list  payload                 "a frame of another type: its payload, as octets"
key   octet                   int     -  "one octet"
