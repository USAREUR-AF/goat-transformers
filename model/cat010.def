# The cat010 module: the values of ASTERIX Category 010 (Transmission of Monosensor Surface Movement Data), edition 1.1,
# as the category holds them. Used by the pack `asterix-cat010`. Generated by
# tools/gen/asterix2pack.py; do not edit by hand. A key is named after its item
# and subitems; a repetitive item is a list and its keys are the keys of one
# repetition.
module        cat010
version       0.1.0
distribution  public
source        "ASTERIX Category 010, Transmission of Monosensor Surface Movement Data, edition 1.1 (2007-03-01), as transcribed in github.com/zoranbosnjak/asterix-specs (BSD-3-Clause), commit 64e9ffba964b92a1af3157bc6bdf7852a63bf700, specs/cat010/cats/cat1.1/definition.json. The category is specified by EUROCONTROL"
key   i010_sac          int     -       "I010/010/SAC: System Area Code (Data Source Identifier)"
key   i010_sic          int     -       "I010/010/SIC: System Identification Code (Data Source Identifier)"
key   i000              int     -       "I010/000: Message Type. 1 = Target Report, 2 = Start of Update Cycle, 3 = Periodic Status Message, 4 = Event-triggered Status Message"
key   i020_typ          int     -       "I010/020/TYP (Target Report Descriptor). 0 = SSR multilateration, 1 = Mode S multilateration, 2 = ADS-B, 3 = PSR, 4 = Magnetic Loop System, 5 = HF multilateration, 6 = Not defined, 7 = Other types"
key   i020_dcr          int     -       "I010/020/DCR (Target Report Descriptor). 0 = No differential correction (ADS-B), 1 = Differential correction (ADS-B)"
key   i020_chn          int     -       "I010/020/CHN (Target Report Descriptor). 0 = Chain 1, 1 = Chain 2"
key   i020_gbs          int     -       "I010/020/GBS (Target Report Descriptor). 0 = Transponder Ground bit not set, 1 = Transponder Ground bit set"
key   i020_crt          int     -       "I010/020/CRT (Target Report Descriptor). 0 = No Corrupted reply in multilateration, 1 = Corrupted replies in multilateration"
key   i020_sim          int     -       "I010/020/SIM (Target Report Descriptor). 0 = Actual target report, 1 = Simulated target report"
key   i020_tst          int     -       "I010/020/TST (Target Report Descriptor). 0 = Default, 1 = Test Target"
key   i020_rab          int     -       "I010/020/RAB (Target Report Descriptor). 0 = Report from target transponder, 1 = Report from field monitor (fixed transponder)"
key   i020_lop          int     -       "I010/020/LOP (Target Report Descriptor). 0 = Undetermined, 1 = Loop start, 2 = Loop finish"
key   i020_tot          int     -       "I010/020/TOT (Target Report Descriptor). 0 = Undetermined, 1 = Aircraft, 2 = Ground vehicle, 3 = Helicopter"
key   i020_spi          int     -       "I010/020/SPI (Target Report Descriptor). 0 = Absence of SPI, 1 = Special Position Identification"
key   i140              float   s       "I010/140: Time of Day. LSB 1/128 s"
key   i041_lat          float   deg     "I010/041/LAT: Latitude (Position in WGS-84 Co-ordinates). LSB 45/536870912 deg"
key   i041_lon          float   deg     "I010/041/LON: Longitude (Position in WGS-84 Co-ordinates). LSB 45/536870912 deg"
key   i040_rho          float   m       "I010/040/RHO: RHO (Measured Position in Polar Co-ordinates). LSB 1 m"
key   i040_th           float   deg     "I010/040/TH: Theta (Measured Position in Polar Co-ordinates). LSB 45/8192 deg"
key   i042_x            float   m       "I010/042/X: X Coordinate (Position in Cartesian Co-ordinates). LSB 1 m"
key   i042_y            float   m       "I010/042/Y: Y Coordinate (Position in Cartesian Co-ordinates). LSB 1 m"
key   i200_tra          float   deg     "I010/200/TRA: Track Angle (Calculated Track Velocity in Polar Co-ordinates). LSB 45/8192 deg"
key   i202_vx           float   m/s     "I010/202/VX: X Velocity (Calculated Track Velocity in Cartesian Co-ordinates). LSB 1/16 m/s"
key   i202_vy           float   m/s     "I010/202/VY: Y Velocity (Calculated Track Velocity in Cartesian Co-ordinates). LSB 1/16 m/s"
key   i161_trk          int     -       "I010/161/TRK: Track Number (Track Number)"
key   i170_cnf          int     -       "I010/170/CNF (Track Status). 0 = Confirmed track, 1 = Track in initialisation phase"
key   i170_tre          int     -       "I010/170/TRE (Track Status). 0 = Default, 1 = Last report for a track"
key   i170_cst          int     -       "I010/170/CST (Track Status). 0 = No extrapolation, 1 = Predictable extrapolation due to sensor refresh period (see NOTE), 2 = Predictable extrapolation in masked area, 3 = Extrapolation due to unpredictable absence of detection"
key   i170_mah          int     -       "I010/170/MAH (Track Status). 0 = Default, 1 = Horizontal manoeuvre"
key   i170_tcc          int     -       "I010/170/TCC (Track Status). 0 = Tracking performed in 'Sensor Plane', i.e. neither slant range correction nor projection was applied, 1 = Slant range correction and a suitable projection technique are used to track in a 2D.reference plane, tangential to the earth model at the Sensor Site co-ordinates"
key   i170_sth          int     -       "I010/170/STH (Track Status). 0 = Measured position, 1 = Smoothed position"
key   i170_tom          int     -       "I010/170/TOM (Track Status). 0 = Unknown type of movement, 1 = Taking-off, 2 = Landing, 3 = Other types of movement"
key   i170_dou          int     -       "I010/170/DOU (Track Status). 0 = No doubt, 1 = Doubtful correlation (undetermined reason), 2 = Doubtful correlation in clutter, 3 = Loss of accuracy, 4 = Loss of accuracy in clutter, 5 = Unstable track, 6 = Previously coasted"
key   i170_mrs          int     -       "I010/170/MRS (Track Status). 0 = Merge or split indication undetermined, 1 = Track merged by association to plot, 2 = Track merged by non-association to plot, 3 = Split track"
key   i170_gho          int     -       "I010/170/GHO (Track Status). 0 = Default, 1 = Ghost track"
key   i060_v            int     -       "I010/060/V: Validated (Mode-3/A Code in Octal Representation). 0 = Code validated, 1 = Code not validated"
key   i060_g            int     -       "I010/060/G: Garbled (Mode-3/A Code in Octal Representation). 0 = Default, 1 = Garbled code"
key   i060_l            int     -       "I010/060/L (Mode-3/A Code in Octal Representation). 0 = Mode-3/A code derived from the reply of the transponder, 1 = Mode-3/A code not extracted during the last scan"
key   i060_mode3a       int     -       "I010/060/MODE3A: Mode-3/A Reply in Octal Representation (Mode-3/A Code in Octal Representation). raw value: 4 octal digits of 3 bits each"
key   i220              int     -       "I010/220: Target Address"
key   i245_sti          int     -       "I010/245/STI (Target Identification). 0 = Callsign or registration downlinked from transponder, 1 = Callsign not downlinked from transponder, 2 = Registration not downlinked from transponder"
key   i245_chr          int     -       "I010/245/CHR: Characters 1-8 (Coded on 6 Bits Each) Defining Target Identification (Target Identification). raw value: 8 characters of 6 bits each in the ICAO character set (ICAO Annex 10)"
list  i250              "I010/250: Mode S MB Data, one item per repetition"
key   i250_mbdata       int     -       "I010/250/MBDATA (Mode S MB Data)"
key   i250_bds1         int     -       "I010/250/BDS1 (Mode S MB Data)"
key   i250_bds2         int     -       "I010/250/BDS2 (Mode S MB Data)"
key   i300              int     -       "I010/300: Vehicle Fleet Identification. 0 = Unknown, 1 = ATC equipment maintenance, 2 = Airport maintenance, 3 = Fire, 4 = Bird scarer, 5 = Snow plough, 6 = Runway sweeper, 7 = Emergency, 8 = Police, 9 = Bus, 10 = Tug (push/tow), 11 = Grass cutter, 12 = Fuel, 13 = Baggage, 14 = Catering, 15 = Aircraft maintenance, 16 = Flyco (follow me)"
key   i090_v            int     -       "I010/090/V: Validated (Flight Level in Binary Representation). 0 = Code validated, 1 = Code not validated"
key   i090_g            int     -       "I010/090/G: Garbled (Flight Level in Binary Representation). 0 = Default, 1 = Garbled code"
key   i090_fl           float   FL      "I010/090/FL: Flight Level (Flight Level in Binary Representation). LSB 1/4 FL"
key   i091              float   ft      "I010/091: Measured Height. LSB 25/4 ft"
key   i270_length       float   m       "I010/270/LENGTH: Length (Target Size and Orientation). LSB 1 m"
key   i270_orientation  float   deg     "I010/270/ORIENTATION: Orientation (Target Size and Orientation). LSB 45/16 deg"
key   i270_width        float   m       "I010/270/WIDTH: Width (Target Size and Orientation). LSB 1 m"
key   i550_nogo         int     -       "I010/550/NOGO: Operational Release Status of the System (System Status). 0 = Operational, 1 = Degraded, 2 = NOGO"
key   i550_ovl          int     -       "I010/550/OVL: Overload Indicator (System Status). 0 = No overload, 1 = Overload"
key   i550_tsv          int     -       "I010/550/TSV: Time Source Validity (System Status). 0 = Valid, 1 = Invalid"
key   i550_div          int     -       "I010/550/DIV (System Status). 0 = Normal Operation, 1 = Diversity degraded"
key   i550_ttf          int     -       "I010/550/TTF (System Status). 0 = Test Target Operative, 1 = Test Target Failure"
key   i310_trb          int     -       "I010/310/TRB (Pre-programmed Message). 0 = Default, 1 = In Trouble"
key   i310_msg          int     -       "I010/310/MSG (Pre-programmed Message). 1 = Towing aircraft, 2 = 'Follow me' operation, 3 = Runway check, 4 = Emergency operation (fire, medical...), 5 = Work in progress (maintenance, birds scarer, sweepers...)"
key   i500_devx         float   m       "I010/500/DEVX: Standard Deviation of X Component (Standard Deviation of Position). LSB 1/4 m"
key   i500_devy         float   m       "I010/500/DEVY: Standard Deviation of Y Component (Standard Deviation of Position). LSB 1/4 m"
key   i500_covxy        float   m       "I010/500/COVXY: Covariance in Two's Complement Form (Standard Deviation of Position). LSB 1/4 m"
list  i280              "I010/280: Presence, one item per repetition"
key   i280_drho         float   m       "I010/280/DRHO (Presence). LSB 1 m"
key   i280_dtheta       float   deg     "I010/280/DTHETA (Presence). LSB 3/20 deg"
key   i131              int     -       "I010/131: Amplitude of Primary Plot"
key   i210_ax           float   m/s2    "I010/210/AX: X Acceleration (Calculated Acceleration). LSB 1/16 m/s2"
key   i210_ay           float   m/s2    "I010/210/AY: Y Acceleration (Calculated Acceleration). LSB 1/16 m/s2"
# Derived keys (engine-spec 0.6 and 0.8), applied by `convert` between decode and encode.
derive  cat010.i140  day_seconds  time_ms
