# The dstar module: D-STAR radio header fields. Written by tools/gen/hamdig-pack.py.
module        dstar
version       0.1.0
distribution  public
source        "ircDDBGateway, https://github.com/g4klx/ircDDBGateway at commit f5ab9f7c93c6f28147b84a8f9667f6cc4c027eaa, Common/HeaderData.cpp and Common/DStarDefines.h (GPL-2.0, Copyright (C) 2010-2014 Jonathan Naylor G4KLX); layout restated, no code copied; the JARL D-STAR specification not used"
key   data              int     -  "flag 1 bit 7: data"
key   repeater          int     -  "flag 1 bit 6: repeater"
key   interrupted       int     -  "flag 1 bit 5: interrupted"
key   control_signal    int     -  "flag 1 bit 4: control signal"
key   urgent            int     -  "flag 1 bit 3: urgent"
key   repeater_control  int     -  "flag 1 bits 2-0: 7 repeater control, 6 auto reply, 4 resend requested, 3 ACK, 2 no response, 1 relay unavailable"
key   flag2             int     -  "flag 2"
key   flag3             int     -  "flag 3"
key   rpt2_call         string  -  "RPT2 callsign, 8 characters"
key   rpt1_call         string  -  "RPT1 callsign, 8 characters"
key   your_call         string  -  "YOUR (UR) callsign, 8 characters"
key   my_call           string  -  "MY callsign, 8 characters"
key   my_call_suffix    string  -  "MY callsign suffix, 4 characters"
key   checksum          string  -  "the CCITT checksum over the 39 octets before it, as sent (not computed)"
