# The cat032 module: the values of ASTERIX Category 032 (Miniplan Reports to an SDPS), edition 1.2,
# as the category holds them. Used by the pack `asterix-cat032`. Generated by
# tools/gen/asterix2pack.py; do not edit by hand. A key is named after its item
# and subitems; a repetitive item is a list and its keys are the keys of one
# repetition.
module        cat032
version       0.1.0
distribution  public
source        "ASTERIX Category 032, Miniplan Reports to an SDPS, edition 1.2 (2025-06-05), as transcribed in github.com/zoranbosnjak/asterix-specs (BSD-3-Clause), commit 64e9ffba964b92a1af3157bc6bdf7852a63bf700, specs/cat032/cats/cat1.2/definition.json. The category is specified by EUROCONTROL"
key   i010_sac       int     -       "I032/010/SAC: System Area Code (Server Identification Tag)"
key   i010_sic       int     -       "I032/010/SIC: System Identification Code (Server Identification Tag)"
key   i015           int     -       "I032/015: User Number"
key   i018_sac       int     -       "I032/018/SAC: System Area Code (Data Source Identification Tag)"
key   i018_sic       int     -       "I032/018/SIC: System Identification Code (Data Source Identification Tag)"
key   i035_family    int     -       "I032/035/FAMILY (Type of Message). 0 = Invalid ASTERIX value, 1 = Information sent by an FPPS, 2 = SUC information sent by an FDPS"
key   i035_nature    int     -       "I032/035/NATURE (Type of Message). raw value; its content depends on the value of 035/FAMILY"
key   i020           float   s       "I032/020: Time of ASTERIX Report Generation. LSB 1/128 s"
key   i040           int     -       "I032/040: Track Number"
key   i050_sui       int     -       "I032/050/SUI: System Unit Identification (Composed Track Number)"
key   i050_stn       int     -       "I032/050/STN: System Track Number (Composed Track Number)"
key   i060_mode3a    int     -       "I032/060/MODE3A: (Mode 3/A Code) 4 Digits, Octal Representation (Track Mode 3/A). raw value: 4 octal digits of 3 bits each"
key   i400           string  -       "I032/400: Callsign. 7 ASCII characters"
key   i410           int     -       "I032/410: Plan Number"
key   i420_gatoat    int     -       "I032/420/GATOAT (Flight Category). 0 = Unknown, 1 = General Air Traffic, 2 = Operational Air Traffic, 3 = Not applicable"
key   i420_fr1fr2    int     -       "I032/420/FR1FR2 (Flight Category). 0 = Instrument Flight Rules, 1 = Visual Flight rules, 2 = Not applicable, 3 = Controlled Visual Flight Rules"
key   i420_sp3       int     -       "I032/420/SP3 (Flight Category)"
key   i420_sp2       int     -       "I032/420/SP2 (Flight Category)"
key   i420_sp1       int     -       "I032/420/SP1 (Flight Category)"
key   i440           string  -       "I032/440: Departure Aerodrome. 4 ASCII characters"
key   i450           string  -       "I032/450: Destination Aerodrome. 4 ASCII characters"
key   i480           float   FL      "I032/480: Current Cleared Flight Level. LSB 1/4 FL"
key   i490_cen       int     -       "I032/490/CEN: Centre (Current Control Position)"
key   i490_pos       int     -       "I032/490/POS: Position (Current Control Position)"
key   i430           string  -       "I032/430: Type of Aircraft. 4 ASCII characters"
key   i435           int     -       "I032/435: Wake Turbulence Category. 76 = Light, 77 = Medium, 72 = Heavy, 74 = Super"
list  i460           "I032/460: Allocated SSR Codes, one item per repetition"
key   i460_oct1      int     -       "I032/460/OCT1: 1st Octal Digit (Allocated SSR Codes)"
key   i460_oct2      int     -       "I032/460/OCT2: 2nd Octal Digit (Allocated SSR Codes)"
key   i460_oct3      int     -       "I032/460/OCT3: 3rd Octal Digit (Allocated SSR Codes)"
key   i460_oct4      int     -       "I032/460/OCT4: 4th Octal Digit (Allocated SSR Codes)"
key   i500_ifi_typ   int     -       "I032/500/IFI/TYP: IFPS FLIGHT ID (Supplementary Flight Data). 0 = Plan Number, 1 = Unit 1 internal flight number, 2 = Unit 2 internal flight number, 3 = Unit 3 internal flight number"
key   i500_ifi_nbr   int     -       "I032/500/IFI/NBR: IFPS FLIGHT ID (Supplementary Flight Data)"
key   i500_rvp_rvsm  int     -       "I032/500/RVP/RVSM: RVSM & Flight Priority (Supplementary Flight Data). 0 = Unknown, 1 = Approved, 2 = Exempt, 3 = Not approved"
key   i500_rvp_hpr   int     -       "I032/500/RVP/HPR: RVSM & Flight Priority (Supplementary Flight Data). 0 = Normal Priority Flight, 1 = High Priority Flight"
key   i500_rds_nu1   string  -       "I032/500/RDS/NU1: Runway Designation; First Number (Supplementary Flight Data). 1 ASCII characters"
key   i500_rds_nu2   string  -       "I032/500/RDS/NU2: Runway Designation; Second Number (Supplementary Flight Data). 1 ASCII characters"
key   i500_rds_ltr   string  -       "I032/500/RDS/LTR: Runway Designation; Letter (Supplementary Flight Data). 1 ASCII characters"
list  i500_tod       "I032/500/TOD: Time of Departure / Arrival, one item per repetition"
key   i500_tod_typ   int     -       "I032/500/TOD/TYP: Time of Departure / Arrival (Supplementary Flight Data). 0 = Scheduled Off-Block Time, 1 = Estimated Off-Block Time, 2 = Estimated Take-Off Time, 3 = Actual Off-Block Time, 4 = Predicted Time at Runway Hold, 5 = Actual Time at Runway Hold, 6 = Actual Line-Up Time, 7 = Actual Take-Off Time, 8 = Estimated Time of Arrival, 9 = Predicted Landing Time, 10 = Actual Landing Time, 11 ..."
key   i500_tod_day   int     -       "I032/500/TOD/DAY: Time of Departure / Arrival (Supplementary Flight Data). 0 = Today, 1 = Yesterday, 2 = Tomorrow, 3 = Invalid"
key   i500_tod_hor   int     -       "I032/500/TOD/HOR: Time of Departure / Arrival (Supplementary Flight Data)"
key   i500_tod_min   int     -       "I032/500/TOD/MIN: Time of Departure / Arrival (Supplementary Flight Data)"
key   i500_tod_avs   int     -       "I032/500/TOD/AVS: Time of Departure / Arrival (Supplementary Flight Data). 0 = Seconds available, 1 = Seconds not available"
key   i500_tod_sec   int     -       "I032/500/TOD/SEC: Time of Departure / Arrival (Supplementary Flight Data)"
key   i500_ast       string  -       "I032/500/AST: Aircraft Stand (Supplementary Flight Data). 6 ASCII characters"
key   i500_sts_emp   int     -       "I032/500/STS/EMP: Stand Status (Supplementary Flight Data). 0 = Empty, 1 = Occupied, 2 = Unknown, 3 = Invalid"
key   i500_sts_avl   int     -       "I032/500/STS/AVL: Stand Status (Supplementary Flight Data). 0 = Available, 1 = Not available, 2 = Unknown, 3 = Invalid"
key   i500_sid       string  -       "I032/500/SID: Standard Instrument Departure (Supplementary Flight Data). 7 ASCII characters"
key   i500_star      string  -       "I032/500/STAR: Standard Instrument Arrival (Supplementary Flight Data). 7 ASCII characters"
