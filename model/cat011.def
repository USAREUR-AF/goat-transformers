# The cat011 module: the values of ASTERIX Category 011 (Transmission of A-SMGCS Data), edition 1.3,
# as the category holds them. Used by the pack `asterix-cat011`. Generated by
# tools/gen/asterix2pack.py; do not edit by hand. A key is named after its item
# and subitems; a repetitive item is a list and its keys are the keys of one
# repetition.
module        cat011
version       0.1.0
distribution  public
source        "ASTERIX Category 011, Transmission of A-SMGCS Data, edition 1.3 (2020-05-11), as transcribed in github.com/zoranbosnjak/asterix-specs (BSD-3-Clause), commit 64e9ffba964b92a1af3157bc6bdf7852a63bf700, specs/cat011/cats/cat1.3/definition.json. The category is specified by EUROCONTROL"
key   i010_sac               int     -       "I011/010/SAC: System Area Code Fixed to Zero (Data Source Identifier)"
key   i010_sic               int     -       "I011/010/SIC: System Identification Code (Data Source Identifier)"
key   i000                   int     -       "I011/000: Message Type. 1 = Target reports, flight plan data and basic alerts, 2 = Manual attachment of flight plan to track, 3 = Manual detachment of flight plan to track, 4 = Insertion of flight plan data, 5 = Suppression of flight plan data, 6 = Modification of flight plan data, 7 = Holdbar status"
key   i015                   int     -       "I011/015: Service Identification"
key   i140                   float   s       "I011/140: Time of Track Information. LSB 1/128 s"
key   i041_lat               float   deg     "I011/041/LAT: Latitude in WGS-84 in Two's Complement (Position in WGS-84 Coordinates). LSB 45/536870912 deg"
key   i041_lon               float   deg     "I011/041/LON: Longitude in WGS-84 in Two's Complement (Position in WGS-84 Coordinates). LSB 45/536870912 deg"
key   i042_x                 float   m       "I011/042/X: X-Component (Calculated Position in Cartesian Co-ordinates). LSB 1 m"
key   i042_y                 float   m       "I011/042/Y: Y-Component (Calculated Position in Cartesian Co-ordinates). LSB 1 m"
key   i202_vx                float   m/s     "I011/202/VX: Vx (Calculated Track Velocity in Cartesian Coordinates). LSB 1/4 m/s"
key   i202_vy                float   m/s     "I011/202/VY: Vy (Calculated Track Velocity in Cartesian Coordinates). LSB 1/4 m/s"
key   i210_ax                float   m/s2    "I011/210/AX: Ax (Calculated Acceleration). LSB 1/4 m/s2"
key   i210_ay                float   m/s2    "I011/210/AY: Ay (Calculated Acceleration). LSB 1/4 m/s2"
key   i060_mod3a             int     -       "I011/060/MOD3A: Mode-3/A Reply in Octal Representation (Mode-3/A Code in Octal Representation). raw value: 4 octal digits of 3 bits each"
key   i245_sti               int     -       "I011/245/STI (Target Identification). 0 = Callsign or registration downlinked from transponder, 1 = Callsign not downlinked from transponder, 2 = Registration not downlinked from transponder"
key   i245_tid               int     -       "I011/245/TID: Target Identification (Target Identification). raw value: 8 characters of 6 bits each in the ICAO character set (ICAO Annex 10)"
list  i380_mb                "I011/380/MB: BDS, one item per repetition"
key   i380_mb_val            int     -       "I011/380/MB: BDS (Mode-S / ADS-B Related Data). raw value: a Mode S BDS register with its address"
key   i380_adr               int     -       "I011/380/ADR: 24 Bits Aircraft Address (Mode-S / ADS-B Related Data)"
key   i380_comacas_com       int     -       "I011/380/COMACAS/COM: Communications/ACAS Capability and Flight Status; Communications Capability of the Transponder (Mode-S / ADS-B Related Data). 0 = No communications capability (surveillance only), 1 = Comm. A and Comm. B capability, 2 = Comm. A, Comm. B and Uplink ELM, 3 = Comm. A, Comm. B, Uplink ELM and Downlink ELM, 4 = Level 5 Transponder capability, 5 = Not assigned, 6 = Not assigned,..."
key   i380_comacas_stat      int     -       "I011/380/COMACAS/STAT: Communications/ACAS Capability and Flight Status; Flight Status (Mode-S / ADS-B Related Data). 0 = No alert, no SPI, aircraft airborne, 1 = No alert, no SPI, aircraft on ground, 2 = Alert, no SPI, aircraft airborne, 3 = Alert, no SPI, aircraft on ground, 4 = Alert, SPI, aircraft airborne or on ground, 5 = No alert, SPI, aircraft airborne or on ground, 6 = General Emergenc..."
key   i380_comacas_ssc       int     -       "I011/380/COMACAS/SSC: Communications/ACAS Capability and Flight Status; Specific Service Capability (Mode-S / ADS-B Related Data). 0 = No, 1 = Yes"
key   i380_comacas_arc       int     -       "I011/380/COMACAS/ARC: Communications/ACAS Capability and Flight Status; Altitude Reporting Capability (Mode-S / ADS-B Related Data). 0 = 100 ft resolution, 1 = 25 ft resolution"
key   i380_comacas_aic       int     -       "I011/380/COMACAS/AIC: Communications/ACAS Capability and Flight Status; Aircraft Identification Capability (Mode-S / ADS-B Related Data). 0 = No, 1 = Yes"
key   i380_comacas_b1a       int     -       "I011/380/COMACAS/B1A: Communications/ACAS Capability and Flight Status; BDS 1,0 Bit 16 (Mode-S / ADS-B Related Data)"
key   i380_comacas_b1b       int     -       "I011/380/COMACAS/B1B: Communications/ACAS Capability and Flight Status; BDS 1,0 Bit 37/40 (Mode-S / ADS-B Related Data)"
key   i380_comacas_ac        int     -       "I011/380/COMACAS/AC: Communications/ACAS Capability and Flight Status; ACAS Operational (Mode-S / ADS-B Related Data). 0 = No, 1 = Yes"
key   i380_comacas_mn        int     -       "I011/380/COMACAS/MN: Communications/ACAS Capability and Flight Status; Multiple Navigational Aids Operating (Mode-S / ADS-B Related Data). 0 = No, 1 = Yes"
key   i380_comacas_dc        int     -       "I011/380/COMACAS/DC: Communications/ACAS Capability and Flight Status; Differential Correction (Mode-S / ADS-B Related Data). 0 = Yes, 1 = No"
key   i380_act               string  -       "I011/380/ACT: Aircraft Derived Aircraft Type (Mode-S / ADS-B Related Data). 4 ASCII characters"
key   i380_ecat              int     -       "I011/380/ECAT: Emitter Category (Mode-S / ADS-B Related Data). 1 = Light aircraft <= 7000 kg, 2 = Reserved, 3 = 7000 kg &lt; medium aircraft &lt; 136000 kg, 4 = Reserved, 5 = 136000 kg <= heavy aircraft, 6 = Highly manoeuvrable (5g acceleration capability) and high speed (&gt;400 knots cruise), 7 = Reserved, 8 = Reserved, 9 = Reserved, 10 = Rotocraft, 11 = Glider / sailplane, 12 = Lighter-than-..."
key   i380_avtech_vdl        int     -       "I011/380/AVTECH/VDL: Available Technologies; VDL Mode 4 (Mode-S / ADS-B Related Data). 0 = VDL Mode 4 available, 1 = VDL Mode 4 not available"
key   i380_avtech_mds        int     -       "I011/380/AVTECH/MDS: Available Technologies; Mode S (Mode-S / ADS-B Related Data). 0 = Mode S available, 1 = Mode S not available"
key   i380_avtech_uat        int     -       "I011/380/AVTECH/UAT: Available Technologies; UAT (Mode-S / ADS-B Related Data). 0 = UAT available, 1 = UAT not available"
key   i161_ftn               int     -       "I011/161/FTN: Fusion Track Number (Track Number)"
key   i170_mon               int     -       "I011/170/MON (Track Status). 0 = Multisensor Track, 1 = Monosensor Track"
key   i170_gbs               int     -       "I011/170/GBS (Track Status). 0 = Transponder Ground bit not set or unknown, 1 = Transponder Ground bit set"
key   i170_mrh               int     -       "I011/170/MRH (Track Status). 0 = Barometric altitude (Mode C) more reliable, 1 = Geometric altitude more reliable"
key   i170_src               int     -       "I011/170/SRC (Track Status). 0 = No source, 1 = GPS, 2 = 3d radar, 3 = Triangulation, 4 = Height from coverage, 5 = Speed look-up table, 6 = Default height, 7 = Multilateration"
key   i170_cnf               int     -       "I011/170/CNF (Track Status). 0 = Confirmed track, 1 = Tentative track"
key   i170_sim               int     -       "I011/170/SIM (Track Status). 0 = Actual Track, 1 = Simulated track"
key   i170_tse               int     -       "I011/170/TSE (Track Status). 0 = Default value, 1 = Track service end (i.e. last message transmitted to the user for the track)"
key   i170_tsb               int     -       "I011/170/TSB (Track Status). 0 = Default value, 1 = Track service begin (i.e. first message transmitted to the user for the track)"
key   i170_frifoe            int     -       "I011/170/FRIFOE (Track Status). 0 = No Mode 4 interrogationt, 1 = Friendly target, 2 = Unknown target, 3 = No reply"
key   i170_me                int     -       "I011/170/ME (Track Status). 0 = Default value, 1 = Military Emergency present in the last report received from a sensor capable of decoding this data"
key   i170_mi                int     -       "I011/170/MI (Track Status). 0 = End of Data Item, 1 = Military Identification present in the last report received from a sensor capable of decoding this data"
key   i170_ama               int     -       "I011/170/AMA (Track Status). 0 = Track not resulting from amalgamation process, 1 = Track resulting from amalgamation process"
key   i170_spi               int     -       "I011/170/SPI (Track Status). 0 = Default value, 1 = SPI present in the last report received from a sensor capable of decoding this data"
key   i170_cst               int     -       "I011/170/CST (Track Status). 0 = Default value, 1 = Age of the last received track update is higher than system dependent threshold (coasting)"
key   i170_fpc               int     -       "I011/170/FPC (Track Status). 0 = Not flight-plan correlated, 1 = Flight plan correlated"
key   i170_aff               int     -       "I011/170/AFF (Track Status). 0 = Default value, 1 = ADS-B data inconsistent with other surveillance information"
key   i170_psr               int     -       "I011/170/PSR (Track Status). 0 = Default value, 1 = Age of the last received PSR track update is higher than system dependent threshold"
key   i170_ssr               int     -       "I011/170/SSR (Track Status). 0 = Default value, 1 = Age of the last received SSR track update is higher than system dependent threshold"
key   i170_mds               int     -       "I011/170/MDS (Track Status). 0 = Default value, 1 = Age of the last received Mode S track update is higher than system dependent threshold"
key   i170_ads               int     -       "I011/170/ADS (Track Status). 0 = Default value, 1 = Age of the last received ADS track update is higher than system dependent threshold"
key   i170_suc               int     -       "I011/170/SUC (Track Status). 0 = Default value, 1 = Special Used Code (Mode A codes to be defined in the system to mark a track with special interest)"
key   i170_aac               int     -       "I011/170/AAC (Track Status). 0 = Default value, 1 = Assigned Mode A Code Conflict (same individual Mode A Code assigned to another track)"
key   i290_psr               float   s       "I011/290/PSR: Age of the Last Primary Report Used to Update the Track (System Track Update Ages). LSB 1/4 s"
key   i290_ssr               float   s       "I011/290/SSR: Age of the Last Secondary Report Used to Update the Track (System Track Update Ages). LSB 1/4 s"
key   i290_mda               float   s       "I011/290/MDA: Age of the Last Valid Mode A Report Used to Update the Track (System Track Update Ages). LSB 1/4 s"
key   i290_mfl               float   s       "I011/290/MFL: Age of the Last Valid and Credible Mode C Used to Update the Track (System Track Update Ages). LSB 1/4 s"
key   i290_mds               float   s       "I011/290/MDS: Age of the Last Mode S Report Used to Update the Track (System Track Update Ages). LSB 1/4 s"
key   i290_ads               float   s       "I011/290/ADS: Age of the Last ADS Report Used to Update the Track (System Track Update Ages). LSB 1/4 s"
key   i290_adb               float   s       "I011/290/ADB: Age of the Last ADS-B Report Used to Update the Track (System Track Update Ages). LSB 1/4 s"
key   i290_md1               float   s       "I011/290/MD1: Age of the Last Valid Mode 1 Used to Update the Track (System Track Update Ages). LSB 1/4 s"
key   i290_md2               float   s       "I011/290/MD2: Age of the Last Valid Mode 2 Used to Update the Track (System Track Update Ages). LSB 1/4 s"
key   i290_lop               float   s       "I011/290/LOP: Age of the Last Magentic Loop Detection (System Track Update Ages). LSB 1/4 s"
key   i290_trk               float   s       "I011/290/TRK: Actual Track Age Since First Occurrence (System Track Update Ages). LSB 1/4 s"
key   i290_mul               float   s       "I011/290/MUL: Age of the Last Multilateration Detection (System Track Update Ages). LSB 1/4 s"
key   i430                   int     -       "I011/430: Phase of Flight. 0 = Unknown, 1 = On stand, 2 = Taxiing for departure, 3 = Taxiing for arrival, 4 = Runway for departure, 5 = Runway for arrival, 6 = Hold for departure, 7 = Hold for arrival, 8 = Push back, 9 = On finals"
key   i090                   float   FL      "I011/090: Measured Flight Level. LSB 1/4 FL"
key   i093_qnh               int     -       "I011/093/QNH: QNH Correction Applied (Calculated Track Barometric Altitude). 0 = No QNH Correction Applied, 1 = QNH Correction Applied"
key   i093_ctba              float   FL      "I011/093/CTBA: Calculated Track Barometric Altitude (Calculated Track Barometric Altitude). LSB 1/4 FL"
key   i092                   float   ft      "I011/092: Calculated Track Geometric Altitude. LSB 25/4 ft"
key   i215                   float   ft/min  "I011/215: Calculated Rate Of Climb/Descent. LSB 25/4 ft/min"
key   i270_length            float   m       "I011/270/LENGTH: Length (Target Size and Orientation). LSB 1 m"
key   i270_orientation       float   deg     "I011/270/ORIENTATION: Orientation (Target Size and Orientation). LSB 45/16 deg"
key   i270_width             float   m       "I011/270/WIDTH: Width (Target Size and Orientation). LSB 1 m"
key   i390_fppsid_sac        int     -       "I011/390/FPPSID/SAC: FPPS Identification Tag; System Area Code (Flight Plan Related Data)"
key   i390_fppsid_sic        int     -       "I011/390/FPPSID/SIC: FPPS Identification Tag; System Identity Code (Flight Plan Related Data)"
key   i390_csn               string  -       "I011/390/CSN: Callsign (Flight Plan Related Data). 7 ASCII characters"
key   i390_ifpsflightid_typ  int     -       "I011/390/IFPSFLIGHTID/TYP: IFPS_FLIGHT_ID; IFPS Flight ID Type (Flight Plan Related Data). 0 = Plan number, 1 = Unit 1 internal flight number, 2 = Unit 2 internal flight number, 3 = Unit 3 internal flight number"
key   i390_ifpsflightid_nbr  int     -       "I011/390/IFPSFLIGHTID/NBR: IFPS_FLIGHT_ID; IFPS Flight ID Number (Flight Plan Related Data)"
key   i390_flightcat_gatoat  int     -       "I011/390/FLIGHTCAT/GATOAT: Flight Category; Flight Type (Flight Plan Related Data). 0 = Unknown, 1 = General Air Traffic, 2 = Operational Air Traffic, 3 = Not applicable"
key   i390_flightcat_fr1fr2  int     -       "I011/390/FLIGHTCAT/FR1FR2: Flight Category; Flight Rules (Flight Plan Related Data). 0 = Instrument Flight Rules, 1 = Visual Flight Rules, 2 = Not applicable, 3 = Controlled Visual Flight Rules"
key   i390_flightcat_rvsm    int     -       "I011/390/FLIGHTCAT/RVSM: Flight Category; RVSM (Flight Plan Related Data). 0 = Unknown, 1 = Approved, 2 = Exempt, 3 = Not Approved"
key   i390_flightcat_hpr     int     -       "I011/390/FLIGHTCAT/HPR: Flight Category; Flight Priority (Flight Plan Related Data). 0 = Normal Priority Flight, 1 = High Priority Flight"
key   i390_toa               string  -       "I011/390/TOA: Type of Aircraft (Flight Plan Related Data). 4 ASCII characters"
key   i390_wtc               int     -       "I011/390/WTC: Wake Turbulence Category (Flight Plan Related Data). 76 = Light, 77 = Medium, 72 = Heavy, 74 = Super"
key   i390_adep              string  -       "I011/390/ADEP: Departure Airport (Flight Plan Related Data). 4 ASCII characters"
key   i390_ades              string  -       "I011/390/ADES: Destination Airport (Flight Plan Related Data). 4 ASCII characters"
key   i390_rwy               string  -       "I011/390/RWY: Runway Designation (Flight Plan Related Data). 3 ASCII characters"
key   i390_cfl               float   FL      "I011/390/CFL: Current Cleared Flight Level (Flight Plan Related Data). LSB 1/4 FL"
key   i390_ccp_centre        int     -       "I011/390/CCP/CENTRE: Current Control Position; 8-bit Group Identification Code (Flight Plan Related Data)"
key   i390_ccp_position      int     -       "I011/390/CCP/POSITION: Current Control Position; 8-bit Control Position Identification Code (Flight Plan Related Data)"
list  i390_tod               "I011/390/TOD: Time of Departure, one item per repetition"
key   i390_tod_typ           int     -       "I011/390/TOD/TYP: Time of Departure; Time Type (Flight Plan Related Data). 0 = Scheduled off-block time, 1 = Estimated off-block time, 2 = Estimated take-off time, 3 = Actual off-block time, 4 = Predicted time at runway hold, 5 = Actual time at runway hold, 6 = Actual line-up time, 7 = Actual take-off time, 8 = Estimated time of arrival, 9 = Predicted landing time, 10 = Actual landing time, 11 ..."
key   i390_tod_day           int     -       "I011/390/TOD/DAY: Time of Departure; Day (Flight Plan Related Data). 0 = Today, 1 = Yesterday, 2 = Tomorrow"
key   i390_tod_hor           int     -       "I011/390/TOD/HOR: Time of Departure; Hours, from 0 to 23 (Flight Plan Related Data)"
key   i390_tod_min           int     -       "I011/390/TOD/MIN: Time of Departure; Minutes, from 0 to 59 (Flight Plan Related Data)"
key   i390_tod_avs           int     -       "I011/390/TOD/AVS: Time of Departure; Seconds Available (Flight Plan Related Data). 0 = Seconds available, 1 = Seconds not available"
key   i390_tod_sec           int     -       "I011/390/TOD/SEC: Time of Departure; Seconds, from 0 to 59 (Flight Plan Related Data)"
key   i390_ast               string  -       "I011/390/AST: Aircraft Stand (Flight Plan Related Data). 6 ASCII characters"
key   i390_sts_emp           int     -       "I011/390/STS/EMP: Stand Status; Stand Empty (Flight Plan Related Data). 0 = Empty, 1 = Occupied, 2 = Unknown"
key   i390_sts_avl           int     -       "I011/390/STS/AVL: Stand Status; Stand Available (Flight Plan Related Data). 0 = Available, 1 = Not available, 2 = Unknown"
key   i300                   int     -       "I011/300: Vehicle Fleet Identification. 0 = Flyco (follow me), 1 = ATC equipment maintenance, 2 = Airport maintenance, 3 = Fire, 4 = Bird scarer, 5 = Snow plough, 6 = Runway sweeper, 7 = Emergency, 8 = Police, 9 = Bus, 10 = Tug (push/tow), 11 = Grass cutter, 12 = Fuel, 13 = Baggage, 14 = Catering, 15 = Aircraft maintenance, 16 = Unknown"
key   i310_trb               int     -       "I011/310/TRB: In Trouble (Pre-programmed Message). 0 = Default, 1 = In Trouble"
key   i310_msg               int     -       "I011/310/MSG: Message (Pre-programmed Message). 1 = Towing aircraft, 2 = FOLLOW-ME operation, 3 = Runway check, 4 = Emergency operation (fire, medical...), 5 = Work in progress (maintenance, birds scarer, sweepers...)"
key   i500_apc_x             float   m       "I011/500/APC/X: Estimated Accuracy Of Track Position (Cartesian); Estimated Accuracy of the Calculated Position of X Component (Estimated Accuracies). LSB 1/4 m"
key   i500_apc_y             float   m       "I011/500/APC/Y: Estimated Accuracy Of Track Position (Cartesian); Estimated Accuracy of the Calculated Position of Y Component (Estimated Accuracies). LSB 1/4 m"
key   i500_apw_lat           float   deg     "I011/500/APW/LAT: Estimated Accuracy Of Track Position (WGS84); APW Latitude Component Accuracy (Estimated Accuracies). LSB 45/536870912 deg"
key   i500_apw_lon           float   deg     "I011/500/APW/LON: Estimated Accuracy Of Track Position (WGS84); APW Longitude Component Accuracy (Estimated Accuracies). LSB 45/536870912 deg"
key   i500_ath               float   m       "I011/500/ATH: Estimated Accuracy Of Track Height (Estimated Accuracies). LSB 1/2 m"
key   i500_avc_x             float   m/s     "I011/500/AVC/X: Estimated Accuracy Of Track Velocity (Cartesian); Estimated Accuracy of the Calculated Velocity of X Component (Estimated Accuracies). LSB 1/10 m/s"
key   i500_avc_y             float   m/s     "I011/500/AVC/Y: Estimated Accuracy Of Track Velocity (Cartesian); Estimated Accuracy of the Calculated Velocity of Y Component (Estimated Accuracies). LSB 1/10 m/s"
key   i500_arc               float   m/s     "I011/500/ARC: Estimated Accuracy Of Rate Of Climb / Descent (Estimated Accuracies). LSB 1/10 m/s"
key   i500_aac_x             float   m/s2    "I011/500/AAC/X: Estimated Accuracy Of Acceleration (Cartesian); Estimated Accuracy Of Acceleration of X Component (Estimated Accuracies). LSB 1/100 m/s2"
key   i500_aac_y             float   m/s2    "I011/500/AAC/Y: Estimated Accuracy Of Acceleration (Cartesian); Estimated Accuracy Of Acceleration of Y Component (Estimated Accuracies). LSB 1/100 m/s2"
key   i600_ack               int     -       "I011/600/ACK: Alert Acknowleged (Alert Messages). 0 = Alert acknowledged, 1 = Alert not acknowledged"
key   i600_svr               int     -       "I011/600/SVR: Alert Severity (Alert Messages). 0 = End fo alert, 1 = Pre-alarm, 2 = Severe alert"
key   i600_at                int     -       "I011/600/AT: Alert Type (Alert Messages)"
key   i600_an                int     -       "I011/600/AN: Alert Number (Alert Messages)"
list  i605                   "I011/605: Tracks in Alert, one item per repetition"
key   i605_ftn               int     -       "I011/605/FTN: Fusion Track Number (Tracks in Alert)"
list  i610                   "I011/610: Holdbar Status, one item per repetition"
key   i610_bkn               int     -       "I011/610/BKN: Bank Number (Holdbar Status)"
key   i610_i1                int     -       "I011/610/I1: Indicator 1 (Holdbar Status). 0 = Indicator on, 1 = Indicator off"
key   i610_i2                int     -       "I011/610/I2: Indicator 2 (Holdbar Status). 0 = Indicator on, 1 = Indicator off"
key   i610_i3                int     -       "I011/610/I3: Indicator 3 (Holdbar Status). 0 = Indicator on, 1 = Indicator off"
key   i610_i4                int     -       "I011/610/I4: Indicator 4 (Holdbar Status). 0 = Indicator on, 1 = Indicator off"
key   i610_i5                int     -       "I011/610/I5: Indicator 5 (Holdbar Status). 0 = Indicator on, 1 = Indicator off"
key   i610_i6                int     -       "I011/610/I6: Indicator 6 (Holdbar Status). 0 = Indicator on, 1 = Indicator off"
key   i610_i7                int     -       "I011/610/I7: Indicator 7 (Holdbar Status). 0 = Indicator on, 1 = Indicator off"
key   i610_i8                int     -       "I011/610/I8: Indicator 8 (Holdbar Status). 0 = Indicator on, 1 = Indicator off"
key   i610_i9                int     -       "I011/610/I9: Indicator 9 (Holdbar Status). 0 = Indicator on, 1 = Indicator off"
key   i610_i10               int     -       "I011/610/I10: Indicator 10 (Holdbar Status). 0 = Indicator on, 1 = Indicator off"
key   i610_i11               int     -       "I011/610/I11: Indicator 11 (Holdbar Status). 0 = Indicator on, 1 = Indicator off"
key   i610_i12               int     -       "I011/610/I12: Indicator 12 (Holdbar Status). 0 = Indicator on, 1 = Indicator off"
# Derived keys (engine-spec 0.6 and 0.8), applied by `convert` between decode and encode.
derive  cat011.i140  day_seconds  time_ms
