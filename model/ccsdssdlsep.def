# The ccsdssdlsep module: SDLS Extended Procedures PDUs (CCSDS 355.1-B-1). Written by tools/gen/sdls-ep-pack.py.
module        ccsdssdlsep
version       0.1.0
distribution  public
source        "CCSDS 355.1-B-1 Space Data Link Security Protocol, Extended Procedures, Blue Book, February 2020, https://ccsds.org/Pubs/355x1b1.pdf (sha256 5864d866e9c66fc2e644225d6e61724bc6f2c140359e444377e74ceb1a722483), section 5; reuse with attribution under the CCSDS reproduction permission statement"
key   procedure_type       int     -  "0 a command (from the initiator), 1 a reply (from the recipient)"
key   user_flag            int     -  "0 a CCSDS-defined procedure, 1 a user-defined procedure"
key   service_group        int     -  "0 key management; 1 SA management of initiator-to-recipient SAs; 2 of recipient-to-initiator SAs; 3 security monitoring and control"
key   procedure_id         int     -  "the procedure within the service group (key management: 1 OTAR, 2 activation, 3 deactivation, 4 verification, 6 destruction, 7 inventory; SA management: 0 read ARSN, 1 create, 4 delete, 5 set ARSN window, 6 rekey, 9 expire, 10 set ARSN, 11 start, 14 stop, 15 status request; monitoring and control: 1 ping, 2 log status, 3 dump log, 4 erase log, 5 self-test, 7 alarm flag reset)"
key   spi                  int     -  "the SPI of the security association the procedure acts on"
list  gvc_ids              "start SA: the global virtual channel or MAP identifiers the SA is applied to"
key   gvc_id               int     -  "one global virtual channel or global MAP identifier, 32 bits (its encoding is mission-specific)"
key   encryption_flag      int     -  "create SA: the SA provides encryption"
key   authentication_flag  int     -  "create SA: the SA provides authentication"
key   iv_field_length      int     -  "create SA: the length of the security header's IV field"
key   sn_field_length      int     -  "create SA: the length of the security header's sequence number field"
key   pl_field_length      int     -  "create SA: the length of the security header's pad length field"
key   mac_field_length     int     -  "create SA: the length of the security trailer's MAC field"
key   last_directive       int     -  "SA status reply: the procedure identification of the last state transition directive applied to the SA"
key   total_key_ids        int     -  "key inventory reply: the number of key IDs returned"
key   self_test_failed     int     -  "self-test reply: 1 the self-test failed, 0 it passed"
key   self_test_bits       int     -  "self-test reply: the 7 bits after the result, left to the implementer"
list  data_octets          "the data field (or its part after the fields of fixed length) of a PDU whose fields have managed lengths, or of a user-defined procedure, as octets"
key   octet                int     -  "one octet"
