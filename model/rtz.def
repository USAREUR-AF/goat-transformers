# The rtz module: the fields of an RTZ 1.2 route file. Written by tools/gen/maritime-pack.py.
module        rtz
version       0.1.0
distribution  public
source        "CIRM, Route Exchange Format (RTZ) XML schema, revision 1.2 (IEC PAS 61174-1:2021), https://cirm.org/storage/documents/October2022/bWjrTyyfNGseK9ch3TKf.xsd from https://cirm.org/rtz-xml-schemas (sha256 ba5695107e2b559ea0594eb80f7407b7e4f1c10da8cf09b447b4b920f681ceff), no licence stated; structure restated"
key   route_name               string  -  "the route's name (required)"
key   route_author             string  -  "who made the route"
key   route_status             string  -  "the route's status, free text"
key   validity_start           string  -  "start of the validity period, ISO 8601 date and time as written"
key   validity_stop            string  -  "end of the validity period, ISO 8601 date and time as written"
key   vessel_name              string  -  "the ship's name"
key   vessel_mmsi              int     -  "the ship's MMSI"
key   vessel_imo               int     -  "the ship's IMO number"
key   vessel_voyage            string  -  "voyage number"
key   vessel_displacement      int     -  "displacement, tons"
key   vessel_cargo             int     -  "cargo, tons"
key   vessel_gm                float   -  "metacentric height, metres"
key   optimization_method      string  -  "the performance indicator the route is optimized for"
key   vessel_max_roll          int     -  "largest roll angle allowed, degrees"
key   vessel_max_wave          float   -  "significant wave height limit, metres"
key   vessel_max_wind          float   -  "wind speed limit, knots"
key   vessel_speed_max         float   -  "the ship's top speed, knots"
key   vessel_service_min       float   -  "lower end of the preferred service speed window, knots"
key   vessel_service_max       float   -  "upper end of the preferred service speed window, knots"
key   route_changes_history    string  -  "history of changes to the route, free text"
key   default_radius           float   -  "default waypoint: turn radius, nautical miles"
key   default_starboard_xtd    float   -  "default waypoint: cross-track limit to starboard, nautical miles"
key   default_portside_xtd     float   -  "default waypoint: cross-track limit to port, nautical miles"
key   default_safety_contour   float   -  "default waypoint: safety contour, metres"
key   default_safety_depth     float   -  "default waypoint: safety depth, metres"
key   default_geometry_type    string  -  "default waypoint: the leg's geometry: Loxodrome (rhumb line) or Orthodrome (great circle)"
key   default_speed_min        float   -  "default waypoint: lowest planned speed on the leg, knots"
key   default_speed_max        float   -  "default waypoint: highest speed allowed on the leg, knots"
key   default_draught_forward  float   -  "default waypoint: static draught forward, metres"
key   default_draught_aft      float   -  "default waypoint: static draught aft, metres"
key   default_static_ukc       float   -  "default waypoint: least static under-keel clearance on the leg (the schema states no unit)"
key   default_dynamic_ukc      float   -  "default waypoint: least dynamic under-keel clearance on the leg (the schema states no unit)"
key   default_masthead         float   -  "default waypoint: masthead height (the schema states no unit)"
key   default_leg_report       string  -  "default waypoint: reporting information for the leg"
key   default_leg_info         string  -  "default waypoint: general information for the leg"
key   default_leg_note1        string  -  "default waypoint: notes about the ETD or ETA"
key   default_leg_note2        string  -  "default waypoint: local remarks"
list  waypoints                "the waypoints, in order (at least two)"
key   id                       int     -  "waypoint: its identifier, unique in the route (required)"
key   revision                 int     -  "waypoint: its revision, raised on every change (required)"
key   name                     string  -  "waypoint: its name"
key   radius                   float   -  "waypoint: turn radius, nautical miles"
key   lat                      float   -  "waypoint: latitude, degrees, WGS 84"
key   lon                      float   -  "waypoint: longitude, degrees, WGS 84"
key   starboard_xtd            float   -  "the leg from the previous waypoint: cross-track limit to starboard, nautical miles"
key   portside_xtd             float   -  "the leg from the previous waypoint: cross-track limit to port, nautical miles"
key   safety_contour           float   -  "the leg from the previous waypoint: safety contour, metres"
key   safety_depth             float   -  "the leg from the previous waypoint: safety depth, metres"
key   geometry_type            string  -  "the leg from the previous waypoint: the leg's geometry: Loxodrome (rhumb line) or Orthodrome (great circle)"
key   speed_min                float   -  "the leg from the previous waypoint: lowest planned speed on the leg, knots"
key   speed_max                float   -  "the leg from the previous waypoint: highest speed allowed on the leg, knots"
key   draught_forward          float   -  "the leg from the previous waypoint: static draught forward, metres"
key   draught_aft              float   -  "the leg from the previous waypoint: static draught aft, metres"
key   static_ukc               float   -  "the leg from the previous waypoint: least static under-keel clearance on the leg (the schema states no unit)"
key   dynamic_ukc              float   -  "the leg from the previous waypoint: least dynamic under-keel clearance on the leg (the schema states no unit)"
key   masthead                 float   -  "the leg from the previous waypoint: masthead height (the schema states no unit)"
key   leg_report               string  -  "the leg from the previous waypoint: reporting information for the leg"
key   leg_info                 string  -  "the leg from the previous waypoint: general information for the leg"
key   leg_note1                string  -  "the leg from the previous waypoint: notes about the ETD or ETA"
key   leg_note2                string  -  "the leg from the previous waypoint: local remarks"
key   schedule_id              int     -  "the first schedule's identifier"
key   schedule_name            string  -  "the first schedule's name"
list  manual_elements          "the first schedule's manual schedule elements, in order"
list  calculated_elements      "the first schedule's calculated schedule elements, in order"
key   waypoint_id              int     -  "schedule element: the waypoint the element refers to (required)"
key   etd                      string  -  "schedule element: estimated time of departure, UTC, ISO 8601 as written"
key   etd_window_before        string  -  "schedule element: how much earlier than the ETD departure may be, an XML duration"
key   etd_window_after         string  -  "schedule element: how much later than the ETD departure may be, an XML duration"
key   eta                      string  -  "schedule element: estimated time of arrival, UTC, ISO 8601 as written"
key   eta_window_before        string  -  "schedule element: how much earlier than the ETA arrival may be, an XML duration"
key   eta_window_after         string  -  "schedule element: how much later than the ETA arrival may be, an XML duration"
key   stay                     string  -  "schedule element: time to stay at the waypoint, an XML duration"
key   speed                    float   -  "schedule element: true speed, knots"
key   speed_window             float   -  "schedule element: uncertainty of the predicted speed, knots"
key   wind_speed               float   -  "schedule element: true wind speed, knots"
key   wind_direction           float   -  "schedule element: true wind direction, degrees"
key   current_speed            float   -  "schedule element: current speed, knots"
key   current_direction        float   -  "schedule element: current direction, degrees"
key   wind_loss                float   -  "schedule element: speed loss from wind, knots"
key   wave_loss                float   -  "schedule element: speed loss from waves (the schema states no unit)"
key   total_loss               float   -  "schedule element: total speed loss (the schema states no unit)"
key   rpm                      int     -  "schedule element: advised engine revolutions per minute"
key   pitch                    int     -  "schedule element: advised engine pitch"
key   fuel                     float   -  "schedule element: predicted fuel consumption on the leg (the schema states no unit)"
key   rel_fuel_save            float   -  "schedule element: relative fuel saving from optimization, percent"
key   abs_fuel_save            float   -  "schedule element: absolute fuel saving from optimization (the schema states no unit)"
key   note                     string  -  "schedule element: a note"
