# The cat025 module: the values of ASTERIX Category 025 (CNS/ATM Ground System Status Reports), edition 1.6,
# as the category holds them. Used by the pack `asterix-cat025`. Generated by
# tools/gen/asterix2pack.py; do not edit by hand. A key is named after its item
# and subitems; a repetitive item is a list and its keys are the keys of one
# repetition.
module        cat025
version       0.1.0
distribution  public
source        "ASTERIX Category 025, CNS/ATM Ground System Status Reports, edition 1.6 (2025-10-22), as transcribed in github.com/zoranbosnjak/asterix-specs (BSD-3-Clause), commit 64e9ffba964b92a1af3157bc6bdf7852a63bf700, specs/cat025/cats/cat1.6/definition.json. The category is specified by EUROCONTROL"
key   i010_sac     int     -       "I025/010/SAC: System Area Code (Data Source Identifier)"
key   i010_sic     int     -       "I025/010/SIC: System Identification Code (Data Source Identifier)"
key   i000_rtyp    int     -       "I025/000/RTYP: Report Type (Report Type)"
key   i000_rg      int     -       "I025/000/RG: Report Generation (Report Type). 0 = Periodic Report, 1 = Event Driven Report"
key   i200         int     -       "I025/200: Message Identification"
key   i015         int     -       "I025/015: Service Identification"
key   i020         int     -       "I025/020: Service Designator. raw value: 8 characters of 6 bits each in the ICAO character set (ICAO Annex 10)"
key   i070         float   s       "I025/070: Time of Day. LSB 1/128 s"
key   i100_nogo    int     -       "I025/100/NOGO (System and Service Status). 0 = Data is released for operational use, 1 = Data must not be used operationally"
key   i100_ops     int     -       "I025/100/OPS (System and Service Status). 0 = Operational, 1 = Operational but in Standby, 2 = Maintenance, 3 = Reserved for future use"
key   i100_sstat   int     -       "I025/100/SSTAT (System and Service Status). 0 = Running, 1 = Failed, 2 = Degraded, 3 = Undefined, 4 = Reserved for future use, 5 = Reserved for future use, 6 = Reserved for future use, 7 = Reserved for future use, 8 = Reserved for future use, 9 = Reserved for future use, 10 = Reserved for future use, 11 = Reserved for future use, 12 = Reserved for future use, 13 = Reserved for future use, 14 = ..."
key   i100_systat  int     -       "I025/100/SYSTAT (System and Service Status). 0 = Running / OK, 1 = Failed, 2 = Degraded, 3 = Undefined, 4 = Reserved for future use, 5 = Reserved for future use, 6 = Reserved for future use, 7 = Reserved for future use"
key   i100_sestat  int     -       "I025/100/SESTAT (System and Service Status). 0 = OK, 1 = Failed, 2 = Degraded, 3 = Undefined, 4 = Reserved for future use, 5 = Reserved for future use, 6 = Reserved for future use, 7 = Reserved for future use"
list  i105         "I025/105: System and Service Error Codes, one item per repetition"
key   i105_val     int     -       "I025/105: System and Service Error Codes. 0 = No error detected (shall not be sent), 1 = Error Code Undefined, 2 = Time Source Invalid, 3 = Time Source Coasting, 4 = Track ID numbering has restarted, 5 = Data Processor Overload, 6 = Ground Interface Data Communications Overload, 7 = System stopped by operator, 8 = CBIT failed, 9 = Test Target Failure, 10 = Reserved for allocation by the AMG, 11..."
list  i120         "I025/120: Component Status, one item per repetition"
key   i120_cid     int     -       "I025/120/CID: Component ID (Component Status)"
key   i120_errc    int     -       "I025/120/ERRC: Error Code (Component Status). 0 = No Error Detected, 1 = Error Code Undefined, 2 = Alert, 3 = Alarm, 4 = Reserved for allocation by the AMG, 5 = Reserved for allocation by the AMG, 6 = Reserved for allocation by the AMG, 7 = Reserved for allocation by the AMG, 8 = Reserved for allocation by the AMG, 9 = Reserved for allocation by the AMG, 10 = Reserved for allocation by the AMG,..."
key   i120_cs      int     -       "I025/120/CS: Component State/Mode (Component Status). 0 = Running, 1 = Failed, 2 = Maintenance, 3 = Reserved"
list  i140         "I025/140: Service Statistics, one item per repetition"
key   i140_type    int     -       "I025/140/TYPE: Type of Report Counter (Service Statistics). 0 = Number of unknown messages received, 1 = Number of too old messages received, 2 = Number of failed message conversions, 3 = Total Number of messages received, 4 = Total number of messages transmitted, 5 = Reserved for AMG, 6 = Reserved for AMG, 7 = Reserved for AMG, 8 = Reserved for AMG, 9 = Reserved for AMG, 10 = Reserved for AMG,..."
key   i140_ref     int     -       "I025/140/REF: Reference from which the Messages Are Counted (Service Statistics). 0 = From UTC midnight, 1 = From the previous report"
key   i140_count   int     -       "I025/140/COUNT: Counter Value (Service Statistics)"
key   i600_lat     float   deg     "I025/600/LAT: Latitude (Position of the System Reference Point). LSB 45/1073741824 deg"
key   i600_lon     float   deg     "I025/600/LON: Longitude (Position of the System Reference Point). LSB 45/1073741824 deg"
key   i610         float   m       "I025/610: Height of the System Reference Point. LSB 1/4 m"
# Derived keys (engine-spec 0.6 and 0.8), applied by `convert` between decode and encode.
derive  cat025.i070  day_seconds  time_ms
