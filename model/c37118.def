# The c37118 module: the fields of IEEE C37.118.2 synchrophasor frames as pypmu
# (BSD-3-Clause) writes and reads them; layouts restated in this repository's
# own words. packs/c37118-data-4ph-int-rect/pack.md says what is not mapped.
module        c37118
version       0.1.0
distribution  public
source        "iicsys/pypmu, https://github.com/iicsys/pypmu commit 66e6c495a91efb8a6018061ff7955a6654b1404d, synchrophasor/frame.py: an implementation of IEEE Std C37.118.2-2011; BSD 3-Clause License, Copyright (c) 2016 Tomo Popovic, Stevan Sandi and Bozo Krstajic. The IEEE standard is not used"
# Common header
key  version          int    -     "SYNC word, low 4 bits: version of the frame format (pypmu: 1 to 15, default 1)"
key  idcode           int    -     "IDCODE: number of the data stream (the PMU or PDC) that sends the frame"
key  soc              int    s     "SOC: second of century, seconds since 1970-01-01T00:00:00Z"
key  leap_direction   int    -     "FRACSEC time flags: 1 when the pending leap second is deleted, 0 when added"
key  leap_occurred    int    -     "FRACSEC time flags: 1 for 24 hours after a leap second"
key  leap_pending     int    -     "FRACSEC time flags: 1 from up to 60 s before a leap second until it occurs"
key  time_quality     int    -     "FRACSEC message time quality code, 0 to 15: 0 clock locked to UTC; n from 1 to 11 time within 10^(n-10) s of UTC; 15 clock failure"
key  fracsec          int    -     "FRACSEC fraction of second: SOC plus fracsec / time_base seconds is the frame time (time_base is in the configuration frame)"
key  chk              int    -     "CHK: CRC-CCITT (polynomial 0x1021, initial value 0xFFFF) of every byte before it; carried, not computed"
# Data frame
key  stat_data_error      int  -  "STAT bits 15-14: 0 good measurement data, 1 PMU error, 2 test mode, 3 PMU error with invalid data"
key  stat_sync_lost       int  -  "STAT bit 13: 1 when the PMU is not in sync with a UTC source"
key  stat_sorted_arrival  int  -  "STAT bit 12: 1 when the data are sorted by arrival, 0 by time stamp"
key  stat_trigger         int  -  "STAT bit 11: 1 when a PMU trigger is detected"
key  stat_config_change   int  -  "STAT bit 10: 1 for one minute before a configuration change"
key  stat_data_modified   int  -  "STAT bit 9: 1 when the data were modified by post-processing"
key  stat_time_quality    int  -  "STAT bits 8-6: PMU time quality code (pypmu TIME_QUALITY: 0 n/a, 1 <100 ns, 2 <1 us, 3 <10 us, 4 <100 us, 5 <1 ms, 6 <10 ms, 7 >10 ms)"
key  stat_unlocked_time   int  -  "STAT bits 5-4: time since the PMU lost sync, as a code (0 under 10 s)"
key  stat_trigger_reason  int  -  "STAT bits 3-0: trigger reason code"
list phasors                       "PHASORS: the phasor estimates of the frame, in configuration order"
key  phasor_real      int    -     "phasor, 16-bit integer rectangular form: real part, in the units PHUNIT of the configuration states"
key  phasor_imag      int    -     "phasor, 16-bit integer rectangular form: imaginary part"
key  phasor_magnitude float  -     "phasor, floating-point polar form: magnitude, volts or amperes"
key  phasor_angle     float  rad   "phasor, floating-point polar form: angle in radians"
key  freq_dev_mhz     int    mHz   "FREQ, 16-bit integer form: frequency deviation from nominal, millihertz"
key  freq_hz          float  Hz    "WITHDRAWN, no longer mapped: was FREQ, floating-point form, called frequency in hertz; pypmu, the only source read, does not state that (it reports nominal + FREQ / 1000). Use freq_float"
key  freq_float       float  -     "FREQ, floating-point form, as the frame holds it; pypmu reports nominal frequency plus FREQ / 1000 for it, as for the integer form"
key  rocof_hzs        float  Hz/s  "WITHDRAWN, no longer mapped: was DFREQ in hertz per second, the integer form divided by 100; pypmu, the only source read, states no unit or scale for DFREQ. Use dfreq_raw (integer form) or dfreq_float"
key  dfreq_float      float  -     "DFREQ, floating-point form: rate of change of frequency as the frame holds it (pypmu states no unit or scale)"
key  dfreq_raw        int    -     "DFREQ, 16-bit integer form, as the frame holds it (pypmu passes it unscaled and states no unit)"
list analogs                       "ANALOG: the analog values of the frame, in configuration order"
key  analog_value     float  -     "an analog value, 32-bit floating point, in the units ANUNIT states"
key  digital          int    -     "DIGITAL: one 16-bit word of digital status"
# Command frame
key  command          int    -     "CMD: 1 turn off transmission, 2 turn on, 3 send header frame, 4 send CFG-1, 5 send CFG-2, 6 send CFG-3, 8 extended frame"
# Configuration frames 1 and 2
key  time_base        int    -     "TIME_BASE bits 23-0: the resolution of fracsec, counts per second (pypmu masks the word with 0x00ffffff)"
key  time_base_flags  int    -     "TIME_BASE bits 31-24: flags (pypmu set_time_base), kept as sent"
key  num_pmu          int    -     "NUM_PMU: number of PMUs whose data the data frames carry"
key  station_name     string -     "STN: station name, 16 characters, space padded"
key  pmu_idcode       int    -     "IDCODE of the PMU within the configuration"
key  data_format      int    -     "FORMAT: bit 0 phasors polar, bit 1 phasors floating point, bit 2 analogs floating point, bit 3 frequency floating point"
key  phasor_count     int    -     "PHNMR: number of phasors"
key  analog_count     int    -     "ANNMR: number of analog values"
key  digital_count    int    -     "DGNMR: number of digital status words"
list channel_names                 "CHNAM: 16-character names of the phasors, the analog values and the 16 bits of each digital word, in that order"
key  channel_name     string -     "one channel name, 16 characters, space padded"
list phasor_units                  "PHUNIT: one conversion word per phasor"
key  phasor_unit_type int    -     "PHUNIT byte 1: 0 voltage, 1 current"
key  phasor_unit_scale int   -     "PHUNIT bytes 2-4: unsigned scale of the 16-bit integer phasor, in 10^-5 volt or ampere per count"
list analog_units                  "ANUNIT: one conversion word per analog value"
key  analog_unit_type int    -     "ANUNIT byte 1: 0 single point-on-wave, 1 RMS, 2 peak"
key  analog_unit_scale int   -     "ANUNIT bytes 2-4: signed user-defined scale"
list digital_units                 "DIGUNIT: two 16-bit masks per digital word"
key  digital_normal_mask int -     "DIGUNIT first word: the normal state of each input"
key  digital_valid_mask  int -     "DIGUNIT second word: the inputs that are valid"
key  fnom_50hz        int    -     "FNOM bit 0: 1 for a 50 Hz nominal frequency, 0 for 60 Hz"
key  config_count     int    -     "CFGCNT: configuration change count"
key  data_rate        int    -     "DATA_RATE: frames per second when positive, seconds per frame when negative"
