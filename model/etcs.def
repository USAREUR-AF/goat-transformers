# The etcs module: variables of ERTMS/ETCS balise telegrams and radio messages (SUBSET-026
# chapters 7 and 8), each the wire integer; the line says the unit where it has one.
module        etcs
version       0.1.0
distribution  public
source        "ERA SUBSET-026 (ERTMS/ETCS System Requirements Specification) issue 3.6.0, 13/05/2016, chapter 7 (ERTMS/ETCS language: packets and variables) and chapter 8 (messages), from the CCS TSI set of specifications 3 published by the European Union Agency for Railways (era.europa.eu); no licence stated; layouts restated"
key   lrbg_nid_bg                  int   -  "NID_LRBG, its NID_BG part"
key   lrbg_nid_c                   int   -  "NID_LRBG, its NID_C part"
key   m33_d_ref                    int   -  "D_REF, distance from the LRBG to the shifted location reference, two's complement (Q_SCALE units)"
key   m33_q_scale                  int   -  "Q_SCALE of D_REF"
key   m_ack                        int   -  "M_ACK: 1 the message must be acknowledged"
key   m_dup                        int   -  "M_DUP: 0 no duplicate, 1 duplicate of the next balise, 2 of the previous"
key   m_mcount                     int   -  "M_MCOUNT, message counter"
key   m_version                    int   -  "M_VERSION, ETCS system version"
key   n_pig                        int   -  "N_PIG, position of the balise in its group"
key   n_total                      int   -  "N_TOTAL, balises in the group (the value + 1)"
key   nid_bg                       int   -  "NID_BG, balise group identity"
key   nid_c                        int   -  "NID_C, country or region"
key   nid_packet                   int   -  "NID_PACKET of a packet the pack does not describe"
key   other_packet_bit             int   -  "one bit of a packet body"
key   p0_nid_vbcmk                 int   -  "NID_VBCMK, the virtual balise cover marker (packet 0)"
key   p12_d_dp                     int   -  "D_DP, distance to the danger point"
key   p12_d_endtimerstartloc       int   -  "D_ENDTIMERSTARTLOC"
key   p12_d_ol                     int   -  "D_OL"
key   p12_d_sectiontimerstoploc    int   -  "D_SECTIONTIMERSTOPLOC of a section (Q_SCALE units)"
key   p12_d_startol                int   -  "D_STARTOL"
key   p12_end_d_sectiontimerstoploc int   -  "D_SECTIONTIMERSTOPLOC of the end section"
key   p12_end_t_sectiontimer       int   -  "T_SECTIONTIMER of the end section, s"
key   p12_l_endsection             int   -  "L_ENDSECTION (Q_SCALE units)"
key   p12_l_section                int   -  "L_SECTION of a section (Q_SCALE units)"
key   p12_q_scale                  int   -  "Q_SCALE of the packet: 0 = 10 cm, 1 = 1 m, 2 = 10 m resolution of its distances, 3 spare"
key   p12_t_ema                    int   -  "T_EMA: validity time of V_EMA in s, 1023 = no time-out"
key   p12_t_endtimer               int   -  "T_ENDTIMER, s"
key   p12_t_ol                     int   -  "T_OL, s"
key   p12_t_sectiontimer           int   -  "T_SECTIONTIMER of a section, s"
key   p12_v_ema                    int   -  "V_EMA: target speed at the end of the MA (5 km/h steps)"
key   p12_v_main                   int   -  "V_MAIN, the speed of the MA (5 km/h steps)"
key   p12_v_releasedp              int   -  "V_RELEASEDP, release speed for the danger point"
key   p12_v_releaseol              int   -  "V_RELEASEOL"
key   p15_d_dp                     int   -  "D_DP, distance to the danger point"
key   p15_d_endtimerstartloc       int   -  "D_ENDTIMERSTARTLOC"
key   p15_d_ol                     int   -  "D_OL"
key   p15_d_sectiontimerstoploc    int   -  "D_SECTIONTIMERSTOPLOC of a section (Q_SCALE units)"
key   p15_d_startol                int   -  "D_STARTOL"
key   p15_end_d_sectiontimerstoploc int   -  "D_SECTIONTIMERSTOPLOC of the end section"
key   p15_end_t_sectiontimer       int   -  "T_SECTIONTIMER of the end section, s"
key   p15_l_endsection             int   -  "L_ENDSECTION (Q_SCALE units)"
key   p15_l_section                int   -  "L_SECTION of a section (Q_SCALE units)"
key   p15_q_scale                  int   -  "Q_SCALE of the packet: 0 = 10 cm, 1 = 1 m, 2 = 10 m resolution of its distances, 3 spare"
key   p15_t_ema                    int   -  "T_EMA: validity time of V_EMA in s, 1023 = no time-out"
key   p15_t_endtimer               int   -  "T_ENDTIMER, s"
key   p15_t_ol                     int   -  "T_OL, s"
key   p15_t_sectiontimer           int   -  "T_SECTIONTIMER of a section, s"
key   p15_v_ema                    int   -  "V_EMA: target speed at the end of the MA (5 km/h steps)"
key   p15_v_releasedp              int   -  "V_RELEASEDP, release speed for the danger point"
key   p15_v_releaseol              int   -  "V_RELEASEOL"
key   p21_change_d_gradient        int   -  "D_GRADIENT (Q_SCALE units)"
key   p21_change_g_a               int   -  "G_A, absolute gradient in per mille, 255 = end of the profile"
key   p21_change_q_gdir            int   -  "Q_GDIR: 0 downhill, 1 uphill"
key   p21_d_gradient               int   -  "D_GRADIENT (Q_SCALE units)"
key   p21_g_a                      int   -  "G_A, absolute gradient in per mille, 255 = end of the profile"
key   p21_q_gdir                   int   -  "Q_GDIR: 0 downhill, 1 uphill"
key   p21_q_scale                  int   -  "Q_SCALE of the packet: 0 = 10 cm, 1 = 1 m, 2 = 10 m resolution of its distances, 3 spare"
key   p27_d_static                 int   -  "D_STATIC (Q_SCALE units)"
key   p27_diff_nc_cddiff           int   -  "NC_CDDIFF, cant deficiency category"
key   p27_diff_nc_diff             int   -  "NC_DIFF, other international train category"
key   p27_diff_q_diff              int   -  "Q_DIFF: 0 cant deficiency category, 1 other category (replaces), 2 other category (does not replace)"
key   p27_diff_v_diff              int   -  "V_DIFF, the category's speed (5 km/h steps)"
key   p27_elem_d_static            int   -  "D_STATIC (Q_SCALE units)"
key   p27_elem_diff_nc_cddiff      int   -  "NC_CDDIFF, cant deficiency category"
key   p27_elem_diff_nc_diff        int   -  "NC_DIFF, other international train category"
key   p27_elem_diff_q_diff         int   -  "Q_DIFF: 0 cant deficiency category, 1 other category (replaces), 2 other category (does not replace)"
key   p27_elem_diff_v_diff         int   -  "V_DIFF, the category's speed (5 km/h steps)"
key   p27_elem_q_front             int   -  "Q_FRONT: 0 train length delay applies, 1 no delay"
key   p27_elem_v_static            int   -  "V_STATIC, basic static speed (5 km/h steps)"
key   p27_q_front                  int   -  "Q_FRONT: 0 train length delay applies, 1 no delay"
key   p27_q_scale                  int   -  "Q_SCALE of the packet: 0 = 10 cm, 1 = 1 m, 2 = 10 m resolution of its distances, 3 spare"
key   p27_v_static                 int   -  "V_STATIC, basic static speed (5 km/h steps)"
key   p41_d_leveltr                int   -  "D_LEVELTR (Q_SCALE units), 32767 = now"
key   p41_l_ackleveltr             int   -  "L_ACKLEVELTR, length of the acknowledgement area (Q_SCALE units)"
key   p41_level_l_ackleveltr       int   -  "L_ACKLEVELTR, length of the acknowledgement area (Q_SCALE units)"
key   p41_level_m_leveltr          int   -  "M_LEVELTR: 0 level 0, 1 NTC, 2 level 1, 3 level 2, 4 level 3"
key   p41_level_nid_ntc            int   -  "NID_NTC of the NTC level"
key   p41_m_leveltr                int   -  "M_LEVELTR: 0 level 0, 1 NTC, 2 level 1, 3 level 2, 4 level 3"
key   p41_nid_ntc                  int   -  "NID_NTC of the NTC level"
key   p41_q_scale                  int   -  "Q_SCALE of the packet: 0 = 10 cm, 1 = 1 m, 2 = 10 m resolution of its distances, 3 spare"
key   p44_data_bit                 int   -  "one bit of the application data"
key   p44_nid_ntc                  int   -  "NID_NTC, when NID_XUSER is 102 (national system)"
key   p44_nid_xuser                int   -  "NID_XUSER: the application the data is for"
key   p5_d_link                    int   -  "D_LINK, incremental distance to the next linked balise group"
key   p5_link_d_link               int   -  "D_LINK, incremental distance to the next linked balise group"
key   p5_link_nid_bg               int   -  "NID_BG of the linked balise group"
key   p5_link_nid_c                int   -  "NID_C of the linked balise group, when it differs"
key   p5_link_q_linkorientation    int   -  "Q_LINKORIENTATION"
key   p5_link_q_linkreaction       int   -  "Q_LINKREACTION: 0 train trip, 1 service brake, 2 no reaction"
key   p5_link_q_locacc             int   -  "Q_LOCACC, location accuracy in m"
key   p5_nid_bg                    int   -  "NID_BG of the linked balise group"
key   p5_nid_c                     int   -  "NID_C of the linked balise group, when it differs"
key   p5_q_linkorientation         int   -  "Q_LINKORIENTATION"
key   p5_q_linkreaction            int   -  "Q_LINKREACTION: 0 train trip, 1 service brake, 2 no reaction"
key   p5_q_locacc                  int   -  "Q_LOCACC, location accuracy in m"
key   p5_q_scale                   int   -  "Q_SCALE of the packet: 0 = 10 cm, 1 = 1 m, 2 = 10 m resolution of its distances, 3 spare"
key   q_dir                        int   -  "Q_DIR of a packet: 0 reverse, 1 nominal, 2 both directions"
key   q_link                       int   -  "Q_LINK: 1 linked, 0 unlinked"
key   q_media                      int   -  "Q_MEDIA: 0 balise, 1 loop"
key   q_updown                     int   -  "Q_UPDOWN: 1 up-link (track to train), 0 down-link"
key   t_train                      int   -  "T_TRAIN, RBC time stamp in units of 10 ms, 4294967295 = unknown"
list  optional_packets             "the optional packets of a radio message"
list  other_packet_bits            "the body of a packet the pack does not describe, one item per bit"
list  p12_sections                 "the sections of the MA before the end section"
list  p15_sections                 "the sections of the MA before the end section"
list  p21_changes                  "the further gradient changes"
list  p27_diffs                    "the category-dependent speeds"
list  p27_elem_diffs               "the category-dependent speeds"
list  p27_elements                 "the further static speed profile elements"
list  p41_levels                   "the further levels, by priority"
list  p44_data                     "the application data, one item per bit"
list  p5_links                     "the further linked balise groups"
list  packets                      "the packets of the telegram, one item per packet"
