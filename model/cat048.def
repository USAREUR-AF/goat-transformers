# The cat048 module: the values of ASTERIX Category 048 (Monoradar Target Reports), edition 1.32,
# as the category holds them. Used by the pack `asterix-cat048`. Generated by
# tools/gen/asterix2pack.py; do not edit by hand. A key is named after its item
# and subitems; a repetitive item is a list and its keys are the keys of one
# repetition.
module        cat048
version       0.1.0
distribution  public
source        "ASTERIX Category 048, Monoradar Target Reports, edition 1.32 (2024-07-01), as transcribed in github.com/zoranbosnjak/asterix-specs (BSD-3-Clause), commit 64e9ffba964b92a1af3157bc6bdf7852a63bf700, specs/cat048/cats/cat1.32/definition.json. The category is specified by EUROCONTROL"
key   i010_sac         int     -       "I048/010/SAC: System Area Code (Data Source Identifier)"
key   i010_sic         int     -       "I048/010/SIC: System Identification Code (Data Source Identifier)"
key   i140             float   s       "I048/140: Time of Day. LSB 1/128 s"
key   i020_typ         int     -       "I048/020/TYP (Target Report Descriptor). 0 = No detection, 1 = Single PSR detection, 2 = Single SSR detection, 3 = SSR + PSR detection, 4 = Single ModeS All-Call, 5 = Single ModeS Roll-Call, 6 = ModeS All-Call + PSR, 7 = ModeS Roll-Call +PSR"
key   i020_sim         int     -       "I048/020/SIM (Target Report Descriptor). 0 = Actual target report, 1 = Simulated target report"
key   i020_rdp         int     -       "I048/020/RDP (Target Report Descriptor). 0 = Report from RDP Chain 1, 1 = Report from RDP Chain 2"
key   i020_spi         int     -       "I048/020/SPI (Target Report Descriptor). 0 = Absence of SPI, 1 = Special Position Identification"
key   i020_rab         int     -       "I048/020/RAB (Target Report Descriptor). 0 = Report from aircraft transponder, 1 = Report from field monitor (fixed transponder)"
key   i020_tst         int     -       "I048/020/TST (Target Report Descriptor). 0 = Real target report, 1 = Test target report"
key   i020_err         int     -       "I048/020/ERR (Target Report Descriptor). 0 = No Extended Range, 1 = Extended Range present"
key   i020_xpp         int     -       "I048/020/XPP (Target Report Descriptor). 0 = No X-Pulse present, 1 = X-Pulse present"
key   i020_me          int     -       "I048/020/ME (Target Report Descriptor). 0 = No military emergency, 1 = Military emergency"
key   i020_mi          int     -       "I048/020/MI (Target Report Descriptor). 0 = No military identification, 1 = Military identification"
key   i020_foefri      int     -       "I048/020/FOEFRI (Target Report Descriptor). 0 = No Mode 4 interrogation, 1 = Friendly target, 2 = Unknown target, 3 = No reply"
key   i020_adsb_ep     int     -       "I048/020/ADSB/EP: On-Site ADS-B Information; ADSB Element Populated Bit (Target Report Descriptor). 0 = ADSB not populated, 1 = ADSB populated"
key   i020_adsb_val    int     -       "I048/020/ADSB/VAL: On-Site ADS-B Information; On-Site ADS-B Information (Target Report Descriptor). 0 = Not available, 1 = Available"
key   i020_scn_ep      int     -       "I048/020/SCN/EP: Surveillance Cluster Network Information; SCN Element Populated Bit (Target Report Descriptor). 0 = SCN not populated, 1 = SCN populated"
key   i020_scn_val     int     -       "I048/020/SCN/VAL: Surveillance Cluster Network Information; Surveillance Cluster Network Information (Target Report Descriptor). 0 = Not available, 1 = Available"
key   i020_pai_ep      int     -       "I048/020/PAI/EP: Passive Acquisition Interface Information; PAI Element Populated Bit (Target Report Descriptor). 0 = PAI not populated, 1 = PAI populated"
key   i020_pai_val     int     -       "I048/020/PAI/VAL: Passive Acquisition Interface Information; Passive Acquisition Interface Information (Target Report Descriptor). 0 = Not available, 1 = Available"
key   i020_acasxv_ep   int     -       "I048/020/ACASXV/EP: Extended Version; ACASXV Element Populated Bit (Target Report Descriptor). 0 = ACASXV not populated, 1 = ACASXV populated"
key   i020_acasxv_val  int     -       "I048/020/ACASXV/VAL: Extended Version; ACAS Extended Version Value (Target Report Descriptor). 0 = Non-Extended Version, 1 = ACAS Xa Version 1, 2 = ACAS Xu Version 1"
key   i020_poxpr_ep    int     -       "I048/020/POXPR/EP: PO Transponder Capability; POXPR Element Populated Bit (Target Report Descriptor). 0 = POXPR not populated, 1 = POXPR populated"
key   i020_poxpr_val   int     -       "I048/020/POXPR/VAL: PO Transponder Capability; PO Transponder Capability (Target Report Descriptor). 0 = PO not supported (PPM only), 1 = PO supported"
key   i020_poact_ep    int     -       "I048/020/POACT/EP: PO Active for Current Plot; POACT Element Populated Bit (Target Report Descriptor). 0 = POACT not populated, 1 = POACT populated"
key   i020_poact_val   int     -       "I048/020/POACT/VAL: PO Active for Current Plot; POACT Active for Current Plot (Target Report Descriptor). 0 = PO not active, 1 = PO active"
key   i020_dtfxpr_ep   int     -       "I048/020/DTFXPR/EP: Basic Dataflash Transponder Capability; DTFXPR Element Populated Bit (Target Report Descriptor). 0 = DTFXPR not populated, 1 = DTFXPR populated"
key   i020_dtfxpr_val  int     -       "I048/020/DTFXPR/VAL: Basic Dataflash Transponder Capability; Basic Dataflash Transponder Capability (Target Report Descriptor). 0 = Basic Dataflash not supported, 1 = Basic Dataflash supported"
key   i020_dtfact_ep   int     -       "I048/020/DTFACT/EP: Basic Dataflash Active for Current Plot; DTFACT Element Populated Bit (Target Report Descriptor). 0 = DTFACT not populated, 1 = DTFACT populated"
key   i020_dtfact_val  int     -       "I048/020/DTFACT/VAL: Basic Dataflash Active for Current Plot; Basic Dataflash in Current Plot (Target Report Descriptor). 0 = Basic Dataflash not active, 1 = Basic Dataflash active"
key   i020_irmxpr_ep   int     -       "I048/020/IRMXPR/EP: IRM Transponder Capability; IRMXPR Element Populated Bit (Target Report Descriptor). 0 = IRMXPR not populated, 1 = IRMXPR populated"
key   i020_irmxpr_val  int     -       "I048/020/IRMXPR/VAL: IRM Transponder Capability; Transponder IRM Capability (Target Report Descriptor). 0 = Transponder not IRM capable, 1 = Transponder IRM capable"
key   i020_irmact_ep   int     -       "I048/020/IRMACT/EP: IRM Active for Current Plot; IRM Element Populated Bit (Target Report Descriptor). 0 = IRMACT not populated, 1 = IRMACT populated"
key   i020_irmact_val  int     -       "I048/020/IRMACT/VAL: IRM Active for Current Plot; IRM Active for Current Plot (Target Report Descriptor). 0 = IRM not active, 1 = IRM active"
key   i040_rho         float   NM      "I048/040/RHO (Measured Position in Polar Co-ordinates). LSB 1/256 NM"
key   i040_theta       float   deg     "I048/040/THETA (Measured Position in Polar Co-ordinates). LSB 45/8192 deg"
key   i070_v           int     -       "I048/070/V (Mode-3/A Code in Octal Representation). 0 = Code validated, 1 = Code not validated"
key   i070_g           int     -       "I048/070/G (Mode-3/A Code in Octal Representation). 0 = Default, 1 = Garbled code"
key   i070_l           int     -       "I048/070/L (Mode-3/A Code in Octal Representation). 0 = Mode-3/A code derived from the reply of the transponder, 1 = Mode-3/A code not extracted during the last scan"
key   i070_mode3a      int     -       "I048/070/MODE3A: Mode-3/A Reply in Octal Representation (Mode-3/A Code in Octal Representation). raw value: 4 octal digits of 3 bits each"
