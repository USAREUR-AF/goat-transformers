key   i130_pam         float   dBm     "I048/130/PAM: Amplitude of Primary Plot (Radar Plot Characteristics). LSB 1 dBm"
key   i130_rpd         float   NM      "I048/130/RPD: Difference in Range Between PSR and SSR Plot (Radar Plot Characteristics). LSB 1/256 NM"
key   i130_apd         float   deg     "I048/130/APD: Difference in Azimuth Between PSR and SSR Plot (Radar Plot Characteristics). LSB 45/2048 deg"
key   i220             int     -       "I048/220: Aircraft Address"
key   i240             int     -       "I048/240: Aircraft Identification. raw value: 8 characters of 6 bits each in the ICAO character set (ICAO Annex 10)"
list  i250             "I048/250: BDS Register Data, one item per repetition"
key   i250_mbdata      int     -       "I048/250/MBDATA: Mode S Comm B Message Data (BDS Register Data)"
key   i250_bds1        int     -       "I048/250/BDS1: Comm B Data Buffer Store 1 Address (BDS Register Data)"
key   i250_bds2        int     -       "I048/250/BDS2: Comm B Data Buffer Store 2 Address (BDS Register Data)"
key   i161_trn         int     -       "I048/161/TRN: Track Number (Track Number)"
key   i042_x           float   NM      "I048/042/X: X-Component (Calculated Position in Cartesian Co-ordinates). LSB 1/128 NM"
key   i042_y           float   NM      "I048/042/Y: X-Component (Calculated Position in Cartesian Co-ordinates). LSB 1/128 NM"
key   i200_hdg         float   deg     "I048/200/HDG: Calculated Heading (Calculated Track Velocity in Polar Co-ordinates). LSB 45/8192 deg"
key   i170_cnf         int     -       "I048/170/CNF: Confirmed Vs. Tentative Track (Track Status). 0 = Confirmed Track, 1 = Tentative Track"
key   i170_rad         int     -       "I048/170/RAD: Type of Sensor(s) Maintaining Track (Track Status). 0 = Combined Track, 1 = PSR Track, 2 = SSR/Mode S Track, 3 = Invalid"
key   i170_dou         int     -       "I048/170/DOU: Signals Level of Confidence in Plot to Track Association Process (Track Status). 0 = Normal confidence, 1 = Low confidence in plot to track association"
key   i170_mah         int     -       "I048/170/MAH: Manoeuvre Detection in Horizontal Sense (Track Status). 0 = No horizontal man.sensed, 1 = Horizontal man. sensed"
key   i170_cdm         int     -       "I048/170/CDM: Climbing / Descending Mode (Track Status). 0 = Maintaining, 1 = Climbing, 2 = Descending, 3 = Unknown"
key   i170_tre         int     -       "I048/170/TRE: Signal for End_of_Track (Track Status). 0 = Track still alive, 1 = End of track lifetime(last report for this track)"
key   i170_gho         int     -       "I048/170/GHO: Ghost Vs. True Target (Track Status). 0 = True target track, 1 = Ghost target track"
key   i170_sup         int     -       "I048/170/SUP: Track Maintained with Track Information from Neighbouring Node B on the Cluster, or Network (Track Status). 0 = No, 1 = Yes"
key   i170_tcc         int     -       "I048/170/TCC: Type of Plot Coordinate Transformation Mechanism: (Track Status). 0 = Tracking performed in so-called 'Radar Plane', i.e. neither slant range correction nor stereographical projection was applied, 1 = Slant range correction and a suitable projection technique are used to track in a 2D.reference plane, tangential to the earth model at the Radar Site co-ordinates"
key   i210_sigx        float   NM      "I048/210/SIGX: Sigma (X)) Standard Deviation on the Horizontal Axis of the Local Grid System (Track Quality). LSB 1/128 NM"
key   i210_sigy        float   NM      "I048/210/SIGY: Sigma (Y)) Standard Deviation on the Vertical Axis of the Local Grid System (Track Quality). LSB 1/128 NM"
key   i210_sigv        float   NM/s    "I048/210/SIGV: Sigma (V)) Standard Deviation on the Groundspeed Within the Local Grid System (Track Quality). LSB 1/16384 NM/s"
key   i210_sigh        float   deg     "I048/210/SIGH: Sigma (H)) Standard Deviation on the Heading Within the Local Grid System (Track Quality). LSB 45/512 deg"
list  i030             "I048/030: Warning/Error Conditions and Target Classification, one item per repetition"
key   i030_val         int     -       "I048/030: Warning/Error Conditions and Target Classification. 0 = Not defined; never used, 1 = Multipath Reply (Reflection), 2 = Reply due to sidelobe interrogation/reception, 3 = Split plot, 4 = Second time around reply, 5 = Angel, 6 = Slow moving target correlated with road infrastructure (terrestrial vehicle), 7 = Fixed PSR plot, 8 = Slow PSR target, 9 = Low quality PSR plot, 10 = Phantom SS..."
