# The pubx module: the fields of u-blox PUBX sentences. Written by tools/gen/maritime-pack.py.
module        pubx
version       0.1.0
distribution  public
source        "gpsd, NMEA Revealed, sections PUBX 00, 01, 03 and 04, www/NMEA.adoc (sha256 83192561db3198d46ef249233c689de2c9735af162c840155d11e6157574d29e) at https://gitlab.com/gpsd/gpsd commit c59fc6de479d06620c8b2ba395b728e10a71527b, BSD-2-Clause (gpsd COPYING); field order restated"
key   time_s             float   -  "the hhmmss.ss time field, seconds since midnight"
key   alt                string  -  "PUBX 00 AltRef, PUBX 01 AltMSL: altitude, as written (unit not stated by the source)"
key   nav_status         string  -  "navigation status, as written (G3 ...)"
key   hacc               string  -  "horizontal accuracy estimate, as written"
key   vacc               string  -  "vertical accuracy estimate, as written"
key   sog                string  -  "speed over ground, as written (unit not stated by the source)"
key   cog                string  -  "course over ground, as written"
key   vvel               string  -  "vertical velocity, as written"
key   age_c              string  -  "the field ageC, as written"
key   hdop               string  -  "horizontal dilution of precision, as written"
key   vdop               string  -  "vertical dilution of precision, as written"
key   tdop               string  -  "time dilution of precision, as written"
key   gps_used           string  -  "the field GU, as written"
key   glonass_used       string  -  "the field RU, as written"
key   dr_used            string  -  "the field DR, as written"
key   easting            string  -  "PUBX 01: UTM easting, as written"
key   easting_ew         string  -  "PUBX 01: the letter after the easting"
key   northing           string  -  "PUBX 01: UTM northing, as written"
key   northing_ns        string  -  "PUBX 01: the letter after the northing"
key   sat_count          int     -  "PUBX 03: the field GT, the number of satellites that follow in the example"
list  satellites         "PUBX 03: the satellites, six fields each"
key   sv_id              int     -  "PUBX 03: satellite ID"
key   sv_status          string  -  "PUBX 03: the field s, as written (the source gives examples U and -)"
key   azimuth            int     -  "PUBX 03: the field AZM"
key   elevation          int     -  "PUBX 03: the field EL"
key   cno                int     -  "PUBX 03: the field SN"
key   lock_time          int     -  "PUBX 03: the field LK"
key   date               string  -  "PUBX 04: the date, ddmmyy as written"
key   utc_tow            string  -  "PUBX 04: UTC time of week, as written"
key   week               int     -  "PUBX 04: week number"
key   reserved           string  -  "PUBX 04: the reserved field, as written"
key   clock_bias         string  -  "PUBX 04: the field Clk_B, as written"
key   clock_drift        string  -  "PUBX 04: the field Clk_D, as written"
key   pulse_granularity  string  -  "PUBX 04: the field PG, as written"
