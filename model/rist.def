# The rist module: the RIST main profile fields (VSF TR-06-2:2024). Written by tools/gen/media-pack.py.
module        rist
version       0.1.0
distribution  public
source        "VSF TR-06-2:2024 (CC BY-ND 4.0); restated by goat-transformers, the document not modified"
key   reserved0_high        int     -  "the five high bits of GRE Reserved0 that RIST leaves reserved"
key   h                     int     -  "H: the AES key length of pre-shared key operation, 0 for 128 bits, 1 for 256 bits"
key   rv                    int     -  "RV: the RIST version, 0 TR-06-2:2020, 1 TR-06-2:2021, 2 TR-06-2:2022 and later"
key   vsf_protocol_type     int     -  "VSF protocol type, 0 for RIST"
key   vsf_protocol_subtype  int     -  "VSF protocol subtype: 0 reduced overhead data, 0x8000 keep-alive, 0x8001 future nonce announcement"
key   udp_source_port       int     -  "reduced overhead: the UDP source port of the tunnelled flow"
key   udp_destination_port  int     -  "reduced overhead: the UDP destination port of the tunnelled flow"
list  payload               "reduced overhead: the UDP payload, as octets; ciphertext when a pre-shared key is in use"
key   mac_address           string  -  "keep-alive: the sender's 48-bit MAC address, 12 hexadecimal digits, its identity in the session"
key   cap_x                 int     -  "keep-alive capability X: more capabilities in the JSON message"
key   cap_r                 int     -  "keep-alive capability R: routing of non-RIST traffic"
key   cap_b                 int     -  "keep-alive capability B: bonding"
key   cap_a                 int     -  "keep-alive capability A: adaptive encoding"
key   cap_p                 int     -  "keep-alive capability P: SMPTE 2022 FEC"
key   cap_e                 int     -  "keep-alive capability E: seamless redundancy switch (SMPTE 2022-7)"
key   cap_l                 int     -  "keep-alive capability L: load sharing"
key   cap_n                 int     -  "keep-alive capability N: NULL packet deletion"
key   cap_d                 int     -  "keep-alive flag D: this is a disconnect message"
key   cap_t                 int     -  "keep-alive flag T: this is a reconnect message"
key   cap_v                 int     -  "keep-alive capability V: reduced overhead mode"
key   cap_j                 int     -  "keep-alive capability J: JSON information"
key   cap_f                 int     -  "keep-alive capability F: on-the-fly pre-shared key passphrase change"
key   cap_reserved          int     -  "keep-alive: the three reserved capability bits"
list  json                  "keep-alive: the JSON message payload, as octets"
list  vsf_payload           "the payload of another VSF subtype, as octets"
list  datagram              "the GRE payload of another protocol type (0x0800: a full IPv4 datagram), as octets"
key   octet                 int     -  "one octet"
