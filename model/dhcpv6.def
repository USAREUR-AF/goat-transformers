# The dhcpv6 module: one key per registered option of the dhcpv6-options pack, named
# opt<code>_<registry name>. A value is the option-data as hex unless the line
# says otherwise.
module        dhcpv6
version       0.1.0
distribution  public
source        "RFC 9915, Dynamic Host Configuration Protocol for IPv6 (DHCPv6), section 21 (option format; sizes of options 7, 8, 19, 32, 82, 83); IETF Trust, BCP 78; layouts restated, no text copied"
source        "IANA registry Dynamic Host Configuration Protocol for IPv6 (DHCPv6), Option Codes (https://www.iana.org/assignments/dhcpv6-parameters), CC0 1.0 per the IANA and IETF joint statement of 10 November 2021: option codes and names"
key  opt1_clientid                                  string  -  "option 1, OPTION_CLIENTID ([RFC 9915]): the option-data as lowercase hex"
key  opt2_serverid                                  string  -  "option 2, OPTION_SERVERID ([RFC 9915]): the option-data as lowercase hex"
