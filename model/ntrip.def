# The ntrip module: NTRIP source-table record fields. Written by tools/gen/gnss-time-pack.py.
module        ntrip
version       0.1.0
distribution  public
source        "BKG, Networked Transport of RTCM via Internet Protocol (Ntrip) Version 1.0 (documentation excerpt, not the official RTCM document), section 6 and Appendix A, https://igs.bkg.bund.de/root_ftp/NTRIP/documentation/NtripDocumentation.pdf (sha256 d2399f37643acec3bff35b26cfc873613048a5f65bf4ccb66032eae708d44977), no licence stated; record layouts restated"
key   record_type         string  -  "the record type, in the closing record (ENDSOURCETABLE)"
key   mountpoint          string  -  "STR: the caster mountpoint (up to 100 characters)"
key   str_identifier      string  -  "STR: source identifier, such as the nearest city"
key   format              string  -  "STR: data format (RTCM 2.x, RTCM 3, CMR, RAW, RTCA ...)"
key   format_details      string  -  "STR: format details, such as RTCM message types with update periods in parentheses"
key   carrier             int     -  "STR: carrier phase in the stream: 0 none, 1 L1, 2 L1 and L2"
key   nav_system          string  -  "STR: navigation system(s) (GPS, GPS+GLONASS ...)"
key   network             string  -  "STR: network the stream belongs to"
key   str_country         string  -  "STR: three-letter ISO 3166 country code"
key   str_latitude        string  -  "STR: approximate latitude, degrees north, as written"
key   str_longitude       string  -  "STR: approximate longitude, degrees east, as written (0-360 in many tables)"
key   str_nmea            int     -  "STR: 1 the client must send an NMEA GGA position, 0 it must not"
key   solution            int     -  "STR: 0 single base, 1 network"
key   generator           string  -  "STR: hardware or software generating the stream"
key   compr_encryp        string  -  "STR: compression or encryption applied"
key   str_authentication  string  -  "STR: access protection: N none, B basic, D digest"
key   str_fee             string  -  "STR: user fee: N no, Y yes"
key   bitrate             int     -  "STR: bit rate of the stream, bits per second"
key   str_misc            string  -  "STR: miscellaneous information (the last field)"
key   host                string  -  "CAS: caster host name or IP address"
key   port                int     -  "CAS: caster port"
key   cas_identifier      string  -  "CAS: caster identifier"
key   cas_operator        string  -  "CAS: institution operating the caster"
key   cas_nmea            int     -  "CAS: 1 the caster can take an NMEA GGA position from a client"
key   cas_country         string  -  "CAS: three-letter country code"
key   cas_latitude        string  -  "CAS: latitude, degrees north, as written"
key   cas_longitude       string  -  "CAS: longitude, degrees east, as written"
key   fallback_host       string  -  "CAS: fallback caster address (0.0.0.0 none)"
key   fallback_port       int     -  "CAS: fallback caster port (0 none)"
key   cas_misc            string  -  "CAS: miscellaneous information"
key   net_identifier      string  -  "NET: network identifier"
key   net_operator        string  -  "NET: institution operating the network"
key   net_authentication  string  -  "NET: access protection of the network's streams (N, B, D, or a list)"
key   net_fee             string  -  "NET: user fee of the network's streams (N, Y, or a list)"
key   web_net             string  -  "NET: web address for network information"
key   web_str             string  -  "NET: web address for stream information"
key   web_reg             string  -  "NET: web or mail address for registration"
key   net_misc            string  -  "NET: miscellaneous information"
