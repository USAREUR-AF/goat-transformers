# The netflow5 module: the header of a NetFlow version 5 export packet, as Cisco documents
# it. The flow records are items of ipfix.records with keys of the ipfix module.
module        netflow5
version       0.1.0
distribution  public
source        "Cisco Systems, NetFlow Export Datagram Format (NetFlow Collection Engine 3.6 user guide), https://www.cisco.com/c/en/us/td/docs/net_mgmt/netflow_collection_engine/3-6/user/guide/format.html, updated 2007-09-14; no licence stated; layout restated"

key  sys_uptime              int  -  "milliseconds since the exporting device booted"
key  unix_secs               int  -  "seconds since 1970-01-01 UTC when the packet was exported"
key  unix_nsecs              int  -  "nanoseconds after unix_secs"
key  flow_sequence           int  -  "count of the flows seen before this packet"
key  engine_type             int  -  "type of the flow-switching engine"
key  engine_id               int  -  "slot number of the flow-switching engine"
key  sampling_mode           int  -  "first two bits of the sampling field: the sampling mode"
key  sampling_interval       int  -  "last 14 bits of the sampling field: the sampling interval"

derive  time_ms               ms_of   netflow5.unix_secs netflow5.unix_nsecs
derive  netflow5.unix_secs    sec_of  time_ms
derive  netflow5.unix_nsecs   nsec_of time_ms
