module        cat247
version       0.1.0
distribution  public
source        "ASTERIX Category 247, Version Number Exchange, edition 1.3 (2021-08-31), as transcribed in github.com/zoranbosnjak/asterix-specs (BSD-3-Clause), commit 64e9ffba964b92a1af3157bc6bdf7852a63bf700, specs/cat247/cats/cat1.3/definition.json. The category is specified by EUROCONTROL"
key   i010_sac   int     -       "I247/010/SAC: System Area Code (Data Source Identifier)"
key   i010_sic   int     -       "I247/010/SIC: System Identification Code (Data Source Identifier)"
key   i015       int     -       "I247/015: Service Identification"
key   i140       float   s       "I247/140: Time of Day. LSB 1/128 s"
list  i550       "I247/550: Category Version Number Report, one item per repetition"
