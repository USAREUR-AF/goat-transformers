key   i550_main  int     -       "I247/550/MAIN: Main Version Number (Category Version Number Report)"
key   i550_sub   int     -       "I247/550/SUB: Sub Version Number (Category Version Number Report)"
# Derived keys (engine-spec 0.6 and 0.8), applied by `convert` between decode and encode.
derive  cat247.i140  day_seconds  time_ms
