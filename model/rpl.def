# The rpl module: the fields of RPL control messages (RFC 6550). Written by tools/gen/mesh-pack.py.
module        rpl
version       0.1.0
distribution  public
source        "IETF RFC 6550; restated by goat-transformers"
key   dis_flags               int     -  "DIS: the flags octet, 0"
key   dis_reserved            int     -  "DIS: the reserved octet, 0"
key   instance_id             int     -  "RPLInstanceID"
key   version                 int     -  "DIO: DODAG version number"
key   rank                    int     -  "DIO: the sender's rank"
key   grounded                int     -  "DIO G: the DODAG is grounded"
key   dio_zero                int     -  "DIO: the bit after G, 0"
key   mop                     int     -  "DIO: mode of operation (0 no downward routes, 1 non-storing, 2 storing without multicast, 3 storing with multicast)"
key   preference              int     -  "DIO: DODAG preference, 0 (least) to 7"
key   dtsn                    int     -  "DIO: destination advertisement trigger sequence number"
key   dio_flags               int     -  "DIO: the flags octet, 0"
key   dio_reserved            int     -  "DIO: the reserved octet, 0"
key   dodagid                 string  -  "DODAGID, the IPv6 address of the DODAG root, as hexadecimal digits"
key   dao_k                   int     -  "DAO K: the sender expects a DAO-ACK"
key   dao_d                   int     -  "DAO and DAO-ACK D: the DODAGID is present"
key   dao_flags               int     -  "DAO: the 6 flag bits after D, 0"
key   dao_reserved            int     -  "DAO: the reserved octet, 0"
key   dao_sequence            int     -  "DAO and DAO-ACK: DAO sequence"
key   ack_reserved            int     -  "DAO-ACK: the 7 reserved bits after D, 0"
key   status                  int     -  "DAO-ACK status: 0 unqualified acceptance, 1-127 acceptance with a condition, 128-255 rejection"
key   cc_response             int     -  "consistency check R: the message is a response"
key   cc_flags                int     -  "consistency check: the 7 flag bits after R, 0"
key   cc_nonce                int     -  "consistency check nonce"
key   destination_counter     int     -  "consistency check: the destination counter"
list  secured_octets          "a code other than 0-3 and 0x8A (the secured forms 0x80-0x83 and others): the message after the checksum, as octets"
list  options                 "the options, in order"
key   option_type             int     -  "option type: 0 Pad1, 1 PadN, 2 DAG metric container, 3 route information, 4 DODAG configuration, 5 RPL target, 6 transit information, 7 solicited information, 8 prefix information, 9 target descriptor"
list  metric_container        "DAG metric container (RFC 6551): its data, as octets"
key   prefix_length           int     -  "route information, RPL target, prefix information: the prefix length in bits"
key   route_reserved_a        int     -  "route information: the 3 reserved bits before the preference, 0"
key   route_preference        int     -  "route information: route preference"
key   route_reserved_b        int     -  "route information: the 3 reserved bits after the preference, 0"
key   route_lifetime          int     -  "route information: route lifetime, seconds (0xFFFFFFFF infinity)"
list  prefix_octets           "route information, RPL target: the prefix, as many octets as the option holds"
key   config_flags            int     -  "DODAG configuration: the 4 flag bits before A, 0"
key   authentication          int     -  "DODAG configuration A: authentication is enabled"
key   path_control_size       int     -  "DODAG configuration PCS: the number of bits of path control, less one"
key   dio_interval_doublings  int     -  "DODAG configuration: DIOIntervalDoublings"
key   dio_interval_min        int     -  "DODAG configuration: DIOIntervalMin (the interval is 2 to this power, milliseconds)"
key   dio_redundancy          int     -  "DODAG configuration: DIORedundancyConstant"
key   max_rank_increase       int     -  "DODAG configuration: MaxRankIncrease"
key   min_hop_rank_increase   int     -  "DODAG configuration: MinHopRankIncrease"
key   objective_code_point    int     -  "DODAG configuration: the objective function (OCP)"
key   config_reserved         int     -  "DODAG configuration: the reserved octet, 0"
key   default_lifetime        int     -  "DODAG configuration: default route lifetime, in lifetime units"
key   lifetime_unit           int     -  "DODAG configuration: the lifetime unit, seconds"
key   target_flags            int     -  "RPL target: the flags octet, 0"
key   external                int     -  "transit information E: the target is external to the RPL network"
key   transit_flags           int     -  "transit information: the 7 flag bits after E, 0"
key   path_control            int     -  "transit information: path control"
key   path_sequence           int     -  "transit information: path sequence"
key   path_lifetime           int     -  "transit information: path lifetime, in lifetime units"
list  parent_address          "transit information: the parent address (16 octets, or none), as octets"
key   solicited_instance      int     -  "solicited information: RPLInstanceID"
key   solicited_v             int     -  "solicited information V: the version number must match"
key   solicited_i             int     -  "solicited information I: the instance ID must match"
key   solicited_d             int     -  "solicited information D: the DODAGID must match"
key   solicited_flags         int     -  "solicited information: the 5 flag bits after D, 0"
key   solicited_dodagid       string  -  "solicited information: DODAGID, as hexadecimal digits"
key   solicited_version       int     -  "solicited information: version number"
key   on_link                 int     -  "prefix information L: the prefix is on-link"
key   autonomous              int     -  "prefix information A: the prefix may be used for address autoconfiguration"
key   router_address          int     -  "prefix information R: the prefix field holds the sender's whole address"
key   prefix_reserved1        int     -  "prefix information: the 5 reserved bits after R, 0"
key   valid_lifetime          int     -  "prefix information: valid lifetime, seconds"
key   preferred_lifetime      int     -  "prefix information: preferred lifetime, seconds"
key   prefix_reserved2        int     -  "prefix information: the 32 reserved bits, 0"
key   prefix                  string  -  "prefix information: the prefix (or the router's address), 16 octets, as hexadecimal digits"
key   descriptor              int     -  "RPL target descriptor: an opaque 32-bit descriptor"
list  option_octets           "PadN and options of other types: their data, as octets"
key   octet                   int     -  "one octet"
