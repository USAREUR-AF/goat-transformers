# The slp module: SLPv2 fields (RFC 2608). Written by tools/gen/dirnaming-pack.py.
module        slp
version       0.1.0
distribution  public
source        "IETF RFC 2608, Service Location Protocol, Version 2, June 1999, sections 4.3, 8, 8.1, 8.2, 8.4 and 9.2, https://www.rfc-editor.org/rfc/rfc2608.txt; layouts restated"
key   function_id            int     -  "function: 1 SrvRqst, 2 SrvRply, 3 SrvReg, 4 SrvDeReg, 5 SrvAck, 6 AttrRqst, 7 AttrRply, 8 DAAdvert, 9 SrvTypeRqst, 10 SrvTypeRply, 11 SAAdvert"
key   overflow               int     -  "flag O: the message did not fit in a datagram"
key   fresh                  int     -  "flag F: a new registration"
key   request_mcast          int     -  "flag R: the request was multicast or broadcast"
key   reserved               int     -  "the 13 reserved bits, 0"
key   next_extension_offset  int     -  "offset from the message start of the first extension, 0 when none (the extensions are not read)"
key   xid                    int     -  "transaction ID, copied into the reply"
list  language_tag           "the language tag, as octets"
list  pr_list                "SrvRqst: the previous responder list, as octets"
list  service_type           "SrvRqst: the service type, as octets"
list  scope_list             "SrvRqst: the scope list, as octets"
list  predicate              "SrvRqst: the predicate (an LDAPv3 search filter), as octets"
list  spi                    "SrvRqst: the SLP SPI string, as octets"
key   error_code             int     -  "SrvRply, SrvAck: the error code (0 none)"
list  url_entries            "SrvRply: the URL entries (their count is written from the list)"
key   url_reserved           int     -  "URL entry: the reserved octet"
key   url_lifetime           int     -  "URL entry: lifetime in seconds"
list  url                    "URL entry: the URL, as octets"
list  url_auths              "URL entry: the URL authentication blocks (their count is written from the list)"
key   auth_bsd               int     -  "authentication block: block structure descriptor"
key   auth_timestamp         int     -  "authentication block: expiry, seconds since 1970-01-01T00:00Z (wrapping in 2106)"
list  auth_spi               "authentication block: the SLP SPI string, as octets"
list  auth_data              "authentication block: the structured authentication block, as octets"
list  body                   "the body of another function, as octets"
key   octet                  int     -  "one octet"
