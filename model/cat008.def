# The cat008 module: the values of ASTERIX Category 008 (Monoradar Derived Weather Information), edition 1.3,
# as the category holds them. Used by the pack `asterix-cat008`. Generated by
# tools/gen/asterix2pack.py; do not edit by hand. A key is named after its item
# and subitems; a repetitive item is a list and its keys are the keys of one
# repetition.
module        cat008
version       0.1.0
distribution  public
source        "ASTERIX Category 008, Monoradar Derived Weather Information, edition 1.3 (2021-04-01), as transcribed in github.com/zoranbosnjak/asterix-specs (BSD-3-Clause), commit 64e9ffba964b92a1af3157bc6bdf7852a63bf700, specs/cat008/cats/cat1.3/definition.json. The category is specified by EUROCONTROL"
key   i010_sac     int     -       "I008/010/SAC: System Area Code (Data Source Identifier)"
key   i010_sic     int     -       "I008/010/SIC: System Identification Code (Data Source Identifier)"
key   i000         int     -       "I008/000: Message Type. 1 = Polar vector, 2 = Cartesian vector of start point/length, 3 = Contour record, 4 = Cartesian start point and end point vector, 254 = SOP message, 255 = EOP message"
key   i020_org     int     -       "I008/020/ORG (Vector Qualifier). 0 = Local Coordinates, 1 = System Coordinates"
key   i020_i       int     -       "I008/020/I: Intensity Level (Vector Qualifier)"
key   i020_s       int     -       "I008/020/S: Shading Orientation with Respect to North (Vector Qualifier). 0 = 0 deg, 1 = 22.5 deg, 2 = 45 deg, 3 = 67.5 deg, 4 = 90 deg, 5 = 112.5 deg, 6 = 135 deg, 7 = 157.5 deg"
key   i020_tst     int     -       "I008/020/TST (Vector Qualifier). 0 = Default, 1 = Test vector"
key   i020_er      int     -       "I008/020/ER (Vector Qualifier). 0 = Default, 1 = Error condition encountered"
list  i036         "I008/036: Sequence of Cartesian Vectors in SPF Notation, one item per repetition"
key   i036_x       int     -       "I008/036/X: X-Component (Sequence of Cartesian Vectors in SPF Notation)"
key   i036_y       int     -       "I008/036/Y: Y-Component (Sequence of Cartesian Vectors in SPF Notation)"
key   i036_length  int     -       "I008/036/LENGTH: Length (Sequence of Cartesian Vectors in SPF Notation)"
list  i034         "I008/034: Sequence of Polar Vectors in SPF Notation, one item per repetition"
key   i034_str     int     -       "I008/034/STR: Start Range (Sequence of Polar Vectors in SPF Notation)"
key   i034_endr    int     -       "I008/034/ENDR: End Range (Sequence of Polar Vectors in SPF Notation)"
key   i034_az      float   deg     "I008/034/AZ: Azimuth (Sequence of Polar Vectors in SPF Notation). LSB 45/8192 deg"
key   i040_org     int     -       "I008/040/ORG (Contour Identifier). 0 = Local Coordinates, 1 = System Coordinates"
key   i040_i       int     -       "I008/040/I: Intensity Level (Contour Identifier)"
key   i040_fstlst  int     -       "I008/040/FSTLST (Contour Identifier). 0 = Intermediate record of a contour, 1 = Last record of a contour of at least two records, 2 = First record of a contour of at least two records, 3 = First and only record, fully defining a contour"
key   i040_csn     int     -       "I008/040/CSN: Contour Serial Number (Contour Identifier)"
list  i050         "I008/050: Sequence of Contour Points in SPF Notation, one item per repetition"
key   i050_x1      int     -       "I008/050/X1 (Sequence of Contour Points in SPF Notation)"
key   i050_y1      int     -       "I008/050/Y1 (Sequence of Contour Points in SPF Notation)"
key   i090         float   s       "I008/090: Time of Day. LSB 1/128 s"
key   i100_f       int     -       "I008/100/F: Scaling Factor (Processing Status)"
key   i100_r       int     -       "I008/100/R: Current Reduction Stage in Use (Processing Status)"
key   i100_q       int     -       "I008/100/Q: Processing Parameters (Processing Status)"
list  i110         "I008/110: Station Configuration Status, one item per repetition"
key   i110_val     int     -       "I008/110: Station Configuration Status"
key   i120         int     -       "I008/120: Total Number of Items Constituting One Weather Picture"
list  i038         "I008/038: Sequence of Weather Vectors in SPF Notation, one item per repetition"
key   i038_x1      int     -       "I008/038/X1: X1-Component (Sequence of Weather Vectors in SPF Notation)"
key   i038_y1      int     -       "I008/038/Y1: Y1-Component (Sequence of Weather Vectors in SPF Notation)"
key   i038_x2      int     -       "I008/038/X2: X2-Component (Sequence of Weather Vectors in SPF Notation)"
key   i038_y2      int     -       "I008/038/Y2: Y2-Component (Sequence of Weather Vectors in SPF Notation)"
# Derived keys (engine-spec 0.6 and 0.8), applied by `convert` between decode and encode.
derive  cat008.i090  day_seconds  time_ms
