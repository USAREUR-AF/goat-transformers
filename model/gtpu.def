# The gtpu module: the fields of GTP-U messages (3GPP TS 29.281). Written by tools/gen/gtp-pack.py.
module        gtpu
version       0.1.0
distribution  public
source        "ETSI TS 129 281 V19.2.0 (3GPP TS 29.281 Release 19); restated by goat-transformers; no licence stated"
key   version          int     -  "GTP version, 1"
key   pt               int     -  "protocol type: 1 GTP, 0 GTP' (charging)"
key   spare            int     -  "spare bit, 0"
key   flag_e           int     -  "E: 1 when the next extension header type is to be read"
key   flag_s           int     -  "S: 1 when the sequence number is to be read"
key   flag_pn          int     -  "PN: 1 when the N-PDU number is to be read"
key   message_type     int     -  "message type: 1 echo request, 2 echo response, 26 error indication, 31 supported extension headers notification, 253 tunnel status, 254 end marker, 255 G-PDU"
key   teid             int     -  "tunnel endpoint identifier of the receiving end; 0 in echo and error indication"
key   sequence         int     -  "sequence number (present when E, S or PN is 1; meaningful when S is 1)"
key   npdu             int     -  "N-PDU number (present when E, S or PN is 1; meaningful when PN is 1)"
key   next_type        int     -  "type of the first extension header, 0 for none: 0x40 UDP port, 0x85 PDU session container, 0xC0 PDCP PDU number, ...; the two high bits say who must understand it"
key   ext1_length      int     -  "extension header 1: its length in 4-octet units"
key   ext1_content     string  -  "extension header 1: its content, as hexadecimal digits (its type is the next type before it)"
key   ext1_next_type   int     -  "extension header 1: the type of the extension header after it, 0 for none"
key   ext2_length      int     -  "extension header 2: its length in 4-octet units"
key   ext2_content     string  -  "extension header 2: its content, as hexadecimal digits (its type is the next type before it)"
key   ext2_next_type   int     -  "extension header 2: the type of the extension header after it, 0 for none"
key   ext3_length      int     -  "extension header 3: its length in 4-octet units"
key   ext3_content     string  -  "extension header 3: its content, as hexadecimal digits (its type is the next type before it)"
key   ext3_next_type   int     -  "extension header 3: the type of the extension header after it, 0 for none"
key   ext4_length      int     -  "extension header 4: its length in 4-octet units"
key   ext4_content     string  -  "extension header 4: its content, as hexadecimal digits (its type is the next type before it)"
key   ext4_next_type   int     -  "extension header 4: the type of the extension header after it, 0 for none"
list  t_pdu            "G-PDU: the user packet (T-PDU), as octets"
list  ies              "the information elements of a signalling message, in order"
key   ie_type          int     -  "IE type: 14 recovery, 16 tunnel endpoint identifier data I; 128 and above have a length, of 2 octets except 141 extension header type list, whose length is 1 octet (133 GTP-U peer address, 141, 255 private extension)"
key   restart_counter  int     -  "recovery IE: restart counter"
key   teid_data_i      int     -  "tunnel endpoint identifier data I IE"
list  ie_value         "value of an IE with a length field, as octets"
key   octet            int     -  "one octet"
