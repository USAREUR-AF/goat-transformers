# The mbus module: wired M-Bus frame and data record fields. Written by tools/gen/meter2-pack.py.
module        mbus
version       0.1.0
distribution  public
source        "libmbus, https://github.com/rscada/libmbus at commit 94352715928182d9e1761959f887c6a66e70de93, mbus/mbus-protocol.h and mbus/mbus-protocol.c (Copyright (C) 2010-2012 Raditex AB and contributors; free to use with credit to rSCADA and Raditex Control); layouts restated, no code copied; EN 13757 not used"
key   control_reserved   int     -  "control field bit 7 (0)"
key   control_prm        int     -  "control field bit 6: 1 a message from the master, 0 from a slave"
key   control_fcb_acd    int     -  "control field bit 5: FCB from the master, ACD from a slave"
key   control_fcv_dfc    int     -  "control field bit 4: FCV from the master, DFC from a slave"
key   control_function   int     -  "control field bits 3-0: function (SND_NKE 0x40, SND_UD 0x53, REQ_UD2 0x5B, REQ_UD1 0x5A, RSP_UD 0x08 as whole bytes)"
key   address            int     -  "address (0xFD network layer, 0xFE broadcast with reply, 0xFF broadcast without reply)"
key   checksum           int     -  "the checksum octet, as sent (the sum of the control field to the last data octet, modulo 256; not computed)"
key   length_repeat      int     -  "long and control frame: the second length octet, as sent (equal to the first)"
key   ci                 int     -  "control information field (0x72/0x76 variable data response, 0x73/0x77 fixed data response, 0x51 data send, 0x52 select slave, 0x50 application reset ...)"
key   identification     string  -  "identification number: the 4 octets as sent, as hexadecimal digits (BCD, low octet first: 78563412 is 12345678)"
key   manufacturer       int     -  "manufacturer code, the 16-bit value of three 5-bit letters"
key   version            int     -  "version"
key   medium             int     -  "medium (device type)"
key   access_number      int     -  "access number (fixed data: transmission counter)"
key   status             int     -  "status"
key   signature          int     -  "signature"
list  records            "the data records of the variable data structure"
key   dif_extension      int     -  "DIF bit 7: a DIFE follows"
key   storage_lsb        int     -  "DIF bit 6: storage number, least significant bit"
key   function_field     int     -  "DIF bits 5-4: 0 instantaneous, 1 maximum, 2 minimum, 3 error state"
key   data_field         int     -  "DIF bits 3-0: the data coding (0 none, 1-4 integer of 1-4 octets, 5 real, 6 integer of 6, 7 of 8, 8 no data, 9-12 BCD of 2-8 digits, 13 variable length, 14 BCD of 12 digits, 15 special)"
list  difes              "the DIF extensions"
key   dife_unit          int     -  "DIFE bit 6: device unit"
key   dife_tariff        int     -  "DIFE bits 5-4: tariff"
key   dife_storage       int     -  "DIFE bits 3-0: storage number"
key   vif_extension      int     -  "VIF bit 7: a VIFE follows"
key   vif                int     -  "VIF bits 6-0: the value information (unit and multiplier)"
list  vifes              "the VIF extensions"
key   vife               int     -  "VIFE bits 6-0"
list  vif_text           "plain-text VIF (0x7C, 0xFC): the unit text, as octets"
key   value              int     -  "an integer value, as an unsigned integer of its octets"
key   value_real         float   -  "a 32-bit real value"
key   value_bcd          string  -  "a BCD value: its octets as sent, as hexadecimal digits (low octet first)"
list  value_lvar         "a variable-length value (LVAR 0x00-0xBF: that many characters), as octets"
list  manufacturer_data  "DIF 0x0F or 0x1F: the manufacturer-specific data to the end, as octets"
key   counter1_type      int     -  "fixed data: medium and unit of counter 1"
key   counter2_type      int     -  "fixed data: medium and unit of counter 2"
key   counter1           string  -  "fixed data: counter 1, its 4 octets as sent, as hexadecimal digits (BCD or binary by the status; low octet first)"
key   counter2           string  -  "fixed data: counter 2, as hexadecimal digits"
list  data               "another CI field's data, as octets"
key   octet              int     -  "one octet"
