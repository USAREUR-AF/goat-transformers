# The quicfr module: QUIC frame fields (RFC 9000 section 19). Written by tools/gen/quic-pack.py.
module        quicfr
version       0.1.0
distribution  public
source        "IETF RFC 9000 sections 16 and 19, https://www.rfc-editor.org/rfc/rfc9000.txt; layout restated"
list  frames                     "the frames, in order"
key   frame_type_size            int     -  "frame type (0 PADDING, 1 PING, 2-3 ACK, 4 RESET_STREAM, 5 STOP_SENDING, 6 CRYPTO, 7 NEW_TOKEN, 8-15 STREAM with OFF 0x04, LEN 0x02, FIN 0x01, 16 MAX_DATA, 17 MAX_STREAM_DATA, 18-19 MAX_STREAMS, 20 DATA_BLOCKED, 21 STREAM_DATA_BLOCKED, 22-23 STREAMS_BLOCKED, 24 NEW_CONNECTION_ID, 25 RETIRE_CONNECTION_ID, 26 PATH_CHALLENGE, 27 PATH_RESPONSE, 28-29 CONNECTION_CLOSE, 30 HANDSHAKE_DONE): the variable-length integer's size code (0 one octet, 1 two, 2 four, 3 eight)"
key   frame_type                 int     -  "frame type (0 PADDING, 1 PING, 2-3 ACK, 4 RESET_STREAM, 5 STOP_SENDING, 6 CRYPTO, 7 NEW_TOKEN, 8-15 STREAM with OFF 0x04, LEN 0x02, FIN 0x01, 16 MAX_DATA, 17 MAX_STREAM_DATA, 18-19 MAX_STREAMS, 20 DATA_BLOCKED, 21 STREAM_DATA_BLOCKED, 22-23 STREAMS_BLOCKED, 24 NEW_CONNECTION_ID, 25 RETIRE_CONNECTION_ID, 26 PATH_CHALLENGE, 27 PATH_RESPONSE, 28-29 CONNECTION_CLOSE, 30 HANDSHAKE_DONE)"
key   largest_acknowledged_size  int     -  "ACK: largest packet number acknowledged: the variable-length integer's size code (0 one octet, 1 two, 2 four, 3 eight)"
key   largest_acknowledged       int     -  "ACK: largest packet number acknowledged"
key   ack_delay_size             int     -  "ACK: acknowledgement delay, scaled by the ack_delay_exponent: the variable-length integer's size code (0 one octet, 1 two, 2 four, 3 eight)"
key   ack_delay                  int     -  "ACK: acknowledgement delay, scaled by the ack_delay_exponent"
key   ack_range_count_size       int     -  "ACK: the range count's size code (the count is written from ack_ranges)"
key   first_ack_range_size       int     -  "ACK: the first range, contiguous packets below the largest: the variable-length integer's size code (0 one octet, 1 two, 2 four, 3 eight)"
key   first_ack_range            int     -  "ACK: the first range, contiguous packets below the largest"
list  ack_ranges                 "ACK: the further ranges"
key   gap_size                   int     -  "ACK range: gap: the variable-length integer's size code (0 one octet, 1 two, 2 four, 3 eight)"
key   gap                        int     -  "ACK range: gap"
key   ack_range_length_size      int     -  "ACK range: length: the variable-length integer's size code (0 one octet, 1 two, 2 four, 3 eight)"
key   ack_range_length           int     -  "ACK range: length"
key   ect0_count_size            int     -  "ACK ECN: ECT(0) count: the variable-length integer's size code (0 one octet, 1 two, 2 four, 3 eight)"
key   ect0_count                 int     -  "ACK ECN: ECT(0) count"
key   ect1_count_size            int     -  "ACK ECN: ECT(1) count: the variable-length integer's size code (0 one octet, 1 two, 2 four, 3 eight)"
key   ect1_count                 int     -  "ACK ECN: ECT(1) count"
key   ecn_ce_count_size          int     -  "ACK ECN: ECN-CE count: the variable-length integer's size code (0 one octet, 1 two, 2 four, 3 eight)"
key   ecn_ce_count               int     -  "ACK ECN: ECN-CE count"
key   stream_id_size             int     -  "stream ID: the variable-length integer's size code (0 one octet, 1 two, 2 four, 3 eight)"
key   stream_id                  int     -  "stream ID"
key   error_code_size            int     -  "application or transport error code: the variable-length integer's size code (0 one octet, 1 two, 2 four, 3 eight)"
key   error_code                 int     -  "application or transport error code"
key   final_size_size            int     -  "RESET_STREAM: final size: the variable-length integer's size code (0 one octet, 1 two, 2 four, 3 eight)"
key   final_size                 int     -  "RESET_STREAM: final size"
key   offset_size                int     -  "CRYPTO or STREAM: byte offset: the variable-length integer's size code (0 one octet, 1 two, 2 four, 3 eight)"
key   offset                     int     -  "CRYPTO or STREAM: byte offset"
key   data_length_size           int     -  "CRYPTO or STREAM with LEN: the data length's size code (the length is written from the list)"
list  crypto_data                "CRYPTO: the cryptographic handshake data, as octets"
key   token_length_size          int     -  "NEW_TOKEN: the token length's size code"
list  token                      "NEW_TOKEN: the token, as octets"
list  stream_data                "STREAM: the stream data, as octets (to the end of the payload when LEN is clear)"
key   maximum_data_size          int     -  "MAX_DATA, MAX_STREAM_DATA, DATA_BLOCKED, STREAM_DATA_BLOCKED: the limit, octets: the variable-length integer's size code (0 one octet, 1 two, 2 four, 3 eight)"
key   maximum_data               int     -  "MAX_DATA, MAX_STREAM_DATA, DATA_BLOCKED, STREAM_DATA_BLOCKED: the limit, octets"
key   maximum_streams_size       int     -  "MAX_STREAMS, STREAMS_BLOCKED: the stream count limit: the variable-length integer's size code (0 one octet, 1 two, 2 four, 3 eight)"
key   maximum_streams            int     -  "MAX_STREAMS, STREAMS_BLOCKED: the stream count limit"
key   sequence_number_size       int     -  "NEW_CONNECTION_ID, RETIRE_CONNECTION_ID: sequence number: the variable-length integer's size code (0 one octet, 1 two, 2 four, 3 eight)"
key   sequence_number            int     -  "NEW_CONNECTION_ID, RETIRE_CONNECTION_ID: sequence number"
key   retire_prior_to_size       int     -  "NEW_CONNECTION_ID: retire prior to: the variable-length integer's size code (0 one octet, 1 two, 2 four, 3 eight)"
key   retire_prior_to            int     -  "NEW_CONNECTION_ID: retire prior to"
list  connection_id              "NEW_CONNECTION_ID: the connection ID, as octets (its length is written from the list)"
key   stateless_reset_token      string  -  "NEW_CONNECTION_ID: the stateless reset token, as hexadecimal digits"
key   path_data                  string  -  "PATH_CHALLENGE, PATH_RESPONSE: the 8 octets of data, as hexadecimal digits"
key   frame_type_in_error_size   int     -  "CONNECTION_CLOSE (0x1c): the type of the frame that triggered the error: the variable-length integer's size code (0 one octet, 1 two, 2 four, 3 eight)"
key   frame_type_in_error        int     -  "CONNECTION_CLOSE (0x1c): the type of the frame that triggered the error"
key   reason_length_size         int     -  "CONNECTION_CLOSE: the reason length's size code"
list  reason_phrase              "CONNECTION_CLOSE: the reason phrase, as UTF-8 octets"
key   octet                      int     -  "one octet"
