# The novatel module: NovAtel OEM binary header and BESTPOS fields. Written by tools/gen/gnssbin-pack.py.
module        novatel
version       0.1.0
distribution  public
source        "swri-robotics/novatel_gps_driver, https://github.com/swri-robotics/novatel_gps_driver at commit 63e19e2e3088e80ecceaa18d86022afffb3ccaf3, novatel_gps_driver/include/novatel_gps_driver/binary_header.h, src/parsers/bestpos.cpp, include/.../parsers/bestpos.h (BSD-3-Clause, Copyright (c) 2017 Southwest Research Institute); layout restated, no code copied; NovAtel documentation not used"
key   header_length               int     -     "header length in octets (28)"
key   message_id                  int     -     "message ID (42 BESTPOS ...)"
key   message_type                int     -     "message type octet (format and response bits)"
key   port_address                int     -     "port address"
key   message_length              int     -     "length of the data after the header, octets, as sent"
key   sequence                    int     -     "sequence number"
key   idle_time                   int     -     "processor idle time, as sent"
key   time_status                 int     -     "Receiver time status (20 unknown, 60 approximate, 80 coarse adjusting, 100 coarse, 120 coarse steering, 130 freewheeling, 140 fine adjusting, 160 fine, 170 fine backup steering, 180 fine steering, 200 sattime)"
key   week                        int     -     "GPS week number"
key   gps_milliseconds            int     ms    "milliseconds into the GPS week"
key   receiver_status             int     -     "receiver status word"
key   reserved                    int     -     "reserved"
key   software_version            int     -     "receiver software build"
key   solution_status             int     -     "BESTPOS: solution status"
key   position_type               int     -     "BESTPOS: position type"
key   latitude                    float   -     "BESTPOS: latitude, in the datum of datum_id"
key   longitude                   float   -     "BESTPOS: longitude, in the datum of datum_id"
key   height                      float   -     "BESTPOS: height (the reference is not stated by the source; see pack.md)"
key   undulation                  float   -     "BESTPOS: undulation"
key   datum_id                    int     -     "BESTPOS: datum identifier"
key   latitude_sigma              float   -     "BESTPOS: latitude standard deviation"
key   longitude_sigma             float   -     "BESTPOS: longitude standard deviation"
key   height_sigma                float   -     "BESTPOS: height standard deviation"
key   base_station_id             string  -     "BESTPOS: base station ID, 4 characters"
key   differential_age            float   -     "BESTPOS: differential age"
key   solution_age                float   -     "BESTPOS: solution age"
key   satellites_tracked          int     -     "BESTPOS: satellites tracked"
key   satellites_in_solution      int     -     "BESTPOS: satellites used in the solution"
key   satellites_l1               int     -     "BESTPOS: GPS and GLONASS L1 satellites used"
key   satellites_multi_frequency  int     -     "BESTPOS: GPS and GLONASS L1 and L2 satellites used"
key   reserved_68                 int     -     "BESTPOS: octet 68 (not named by the source)"
key   extended_solution_status    int     -     "BESTPOS: extended solution status"
key   signals_used                int     -     "BESTPOS: signals-used mask"
key   reserved_71                 int     -     "BESTPOS: octet 71 (not named by the source)"
key   crc                         int     -     "the 32-bit CRC after the data, as sent (not computed)"
list  data_and_crc                "another log's data and its 4-octet CRC, as octets"
key   octet                       int     -     "one octet"
