# The tasmota module: members of Tasmota's MQTT JSON payloads.
module        tasmota
version       0.1.0
distribution  public
source        "Tasmota (https://github.com/arendst/Tasmota, GPL-3.0) release v16.0.0, commit 1c2173927cdf1be61759bcc3b064b9511a18e5d7: tasmota_support/support_tasmota.ino (MqttShowState), tasmota_xdrv_driver/xdrv_03_energy.ino, tasmota_xsns_sensor/xsns_05_ds18x20.ino, xsns_09_bmp.ino, xsns_06_dht_v6.ino, include/i18n.h (the JSON member names); member names restated, no code copied"
key   am2301_dewpoint                          float  -  "AM2301 dew point, in TempUnit"
key   am2301_humidity                          float  -  "AM2301 relative humidity, percent"
key   am2301_temperature                       float  -  "AM2301 temperature, in TempUnit"
key   battery_percent                          int    -  "battery level, percent (deep-sleep devices)"
key   bme280_dewpoint                          float  -  "BME280 dew point, in TempUnit"
key   bme280_humidity                          float  -  "BME280 relative humidity, percent"
key   bme280_pressure                          float  -  "BME280 pressure, in PressureUnit"
key   bme280_seapressure                       float  -  "BME280 pressure at sea level, in PressureUnit"
key   bme280_temperature                       float  -  "BME280 temperature, in TempUnit"
key   bmp280_pressure                          float  -  "BMP280 pressure, in PressureUnit"
key   bmp280_seapressure                       float  -  "BMP280 pressure at sea level, in PressureUnit"
key   bmp280_temperature                       float  -  "BMP280 temperature, in TempUnit"
key   ds18b20_1_id                             string -  "DS18B20-1 ROM address, hexadecimal"
key   ds18b20_1_temperature                    float  -  "DS18B20-1 temperature, in TempUnit"
key   ds18b20_2_id                             string -  "DS18B20-2 ROM address, hexadecimal"
key   ds18b20_2_temperature                    float  -  "DS18B20-2 temperature, in TempUnit"
key   ds18b20_3_id                             string -  "DS18B20-3 ROM address, hexadecimal"
key   ds18b20_3_temperature                    float  -  "DS18B20-3 temperature, in TempUnit"
key   ds18b20_4_id                             string -  "DS18B20-4 ROM address, hexadecimal"
key   ds18b20_4_temperature                    float  -  "DS18B20-4 temperature, in TempUnit"
key   ds18b20_id                               string -  "DS18B20 ROM address, hexadecimal"
key   ds18b20_temperature                      float  -  "DS18B20 temperature, in TempUnit"
key   energy_apparentpower                     float  -  "ENERGY apparent power, VA"
key   energy_current                           float  -  "ENERGY current, A"
key   energy_factor                            float  -  "ENERGY power factor"
key   energy_frequency                         float  -  "ENERGY frequency, Hz"
key   energy_period                            float  -  "ENERGY energy in the last period, Wh"
key   energy_power                             float  -  "ENERGY active power, W"
key   energy_reactivepower                     float  -  "ENERGY reactive power, var"
key   energy_today                             float  -  "ENERGY energy today, kWh"
key   energy_total                             float  -  "ENERGY total energy, kWh"
key   energy_totalstarttime                    string -  "ENERGY start of the total counter, local time"
key   energy_voltage                           float  -  "ENERGY voltage, V"
key   energy_yesterday                         float  -  "ENERGY energy yesterday, kWh"
key   fan_speed                                int    -  "fan speed (iFan modules)"
key   heap_kb                                  int    -  "free heap, kB"
key   hostname                                 string -  "host name"
key   ip_address                               string -  "IP address"
key   load_avg                                 int    -  "loop load average"
key   mqtt_count                               int    -  "MQTT connection count"
key   power                                    string -  "power state ON or OFF (single relay)"
key   power1                                   string -  "power state of relay 1"
key   power2                                   string -  "power state of relay 2"
key   power3                                   string -  "power state of relay 3"
key   power4                                   string -  "power state of relay 4"
key   power5                                   string -  "power state of relay 5"
key   power6                                   string -  "power state of relay 6"
key   power7                                   string -  "power state of relay 7"
key   power8                                   string -  "power state of relay 8"
key   pressure_unit                            string -  "pressure unit, hPa or mmHg"
key   sleep_mode                               string -  "Dynamic or Normal"
key   sleep_ms                                 int    -  "sleep time, ms"
key   temp_unit                                string -  "temperature unit, C or F"
key   time_local                               string -  "Time: the device's local time, ISO 8601 without a zone"
key   uptime                                   string -  "Uptime as days T hh:mm:ss"
key   uptime_s                                 int    -  "uptime, seconds"
key   vcc_v                                    float  -  "supply voltage, V"
key   wifi_ap                                  int    -  "Wifi access point index, 1 or 2"
key   wifi_bssid                               string -  "Wifi BSSID"
key   wifi_channel                             int    -  "Wifi channel"
key   wifi_downtime                            string -  "Wifi accumulated Wi-Fi downtime"
key   wifi_linkcount                           int    -  "Wifi number of Wi-Fi connections"
key   wifi_mode                                string -  "Wifi PHY mode, for example 11n"
key   wifi_rssi                                int    -  "Wifi signal quality, percent"
key   wifi_signal                              int    -  "Wifi signal strength, dBm"
key   wifi_ssid                                string -  "Wifi SSID"
