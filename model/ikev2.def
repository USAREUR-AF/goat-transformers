# The ikev2 module: the fields of IKEv2 messages and payloads (RFC 7296). Written by tools/gen/tunnels-pack.py.
module        ikev2
version       0.1.0
distribution  public
source        "IETF RFC 7296; restated by goat-transformers"
key   spi_i                string  -  "IKE SA initiator's SPI, 8 octets, as hexadecimal digits"
key   spi_r                string  -  "IKE SA responder's SPI, 8 octets, as hexadecimal digits (zero in the first message of an initial exchange)"
key   first_payload        int     -  "the type of the first payload after the header (33 SA ... 48 EAP; 0 none)"
key   major_version        int     -  "major version, 2"
key   minor_version        int     -  "minor version, 0"
key   exchange_type        int     -  "exchange type: 34 IKE_SA_INIT, 35 IKE_AUTH, 36 CREATE_CHILD_SA, 37 INFORMATIONAL"
key   flags_reserved_high  int     -  "the two reserved bits before R, 0"
key   response             int     -  "R flag: the message is a response"
key   higher_version       int     -  "V flag: the sender can speak a higher major version"
key   initiator            int     -  "I flag: sent by the original initiator of the IKE SA"
key   flags_reserved_low   int     -  "the three reserved bits after I, 0"
key   message_id           int     -  "message ID"
list  payloads             "ikev2-message: the payloads, in order, each a generic header and body octets"
list  body                 "ikev2-message: the body of a payload (after the generic header), as octets"
key   next_payload         int     -  "the type of the next payload (0 for the last; in an Encrypted payload, the first payload inside)"
key   critical             int     -  "C bit: reject the message when the payload's type is not understood"
key   payload_reserved     int     -  "the seven reserved bits of the generic header, 0"
list  proposals            "SA payload: the proposals, in order"
key   last_substruc        int     -  "proposal or transform: 0 for the last, 2 (proposal) or 3 (transform) when another follows"
key   substruc_reserved    int     -  "the reserved octet of a proposal or transform header, 0"
key   proposal_num         int     -  "proposal number, from 1"
key   protocol_id          int     -  "protocol: 1 IKE, 2 AH, 3 ESP"
list  proposal_spi         "proposal: the sender's SPI, as octets (none in an initial IKE SA negotiation); its size is written from the list"
list  transforms           "proposal: the transforms, in order; their number is written from the list"
key   transform_type       int     -  "transform type: 1 ENCR, 2 PRF, 3 INTEG, 4 D-H group, 5 ESN"
key   transform_reserved   int     -  "the reserved octet after the transform type, 0"
key   transform_id         int     -  "transform ID within its type"
list  attributes           "transform: the attributes, in order"
key   af                   int     -  "attribute format: 1 type and two-octet value, 0 type, length and value"
key   attr_type            int     -  "transform attribute type (14 key length in bits)"
key   attr_value           int     -  "the two-octet value of an attribute in the short form"
list  attr_octets          "the value of an attribute in the long form, or of a configuration attribute, as octets"
key   dh_group             int     -  "KE payload: Diffie-Hellman group number"
key   ke_reserved          int     -  "KE payload: the 16 reserved bits, 0"
list  ke_data              "KE payload: the key exchange data, as octets"
key   id_type              int     -  "ID payload: 1 IPv4 address, 2 FQDN, 3 RFC 822 address, 5 IPv6 address, 9 DER ASN.1 DN, 10 DER ASN.1 GN, 11 key ID"
key   id_reserved          int     -  "ID payload: the 24 reserved bits, 0"
key   id_ipv4              int     -  "ID payload, type 1: the IPv4 address, the 32-bit integer"
key   id_ipv6              string  -  "ID payload, type 5: the IPv6 address, as hexadecimal digits"
list  id_data              "ID payload, other types: the identification data, as octets"
key   cert_encoding        int     -  "CERT or CERTREQ payload: certificate encoding (4 X.509 signature, 12 hash and URL of X.509 ...)"
list  cert_data            "CERT or CERTREQ payload: the certificate data or certification authority, as octets"
key   auth_method          int     -  "AUTH payload: 1 RSA digital signature, 2 shared key MIC, 3 DSS digital signature"
key   auth_reserved        int     -  "AUTH payload: the 24 reserved bits, 0"
list  auth_data            "AUTH payload: the authentication data, as octets"
key   notify_type          int     -  "Notify payload: notify message type (below 16384 errors, from 16384 status)"
list  spi_bytes            "Notify payload: the SPI, as octets; its size is written from the list"
list  notify_data          "Notify payload: the notification data, as octets"
key   spi_size_field       int     -  "Delete payload: the size of each SPI in octets (0 for an IKE SA)"
list  spis                 "Delete payload with SPIs of 4 or 8 octets: the SPIs; their number is written from the list"
key   spi                  string  -  "one SPI, as hexadecimal digits"
key   num_spis_field       int     -  "Delete payload with another SPI size: the number of SPIs, as on the wire"
list  spi_octets           "Delete payload with another SPI size: the SPIs, as octets"
list  selectors            "TS payload: the traffic selectors; their number is written from the list"
key   ts_reserved          int     -  "TS payload: the 24 reserved bits, 0"
key   ts_type              int     -  "traffic selector type: 7 IPv4 address range, 8 IPv6 address range"
key   ip_protocol          int     -  "traffic selector: IP protocol ID (0 any)"
key   start_port           int     -  "traffic selector: the lowest port"
key   end_port             int     -  "traffic selector: the highest port"
key   start_ipv4           int     -  "traffic selector, type 7: the lowest address, the 32-bit integer"
key   end_ipv4             int     -  "traffic selector, type 7: the highest address, the 32-bit integer"
key   start_ipv6           string  -  "traffic selector, type 8: the lowest address, as hexadecimal digits"
key   end_ipv6             string  -  "traffic selector, type 8: the highest address, as hexadecimal digits"
list  selector_octets      "traffic selector of another type: its content after the length, as octets"
key   cfg_type             int     -  "CP payload: 1 CFG_REQUEST, 2 CFG_REPLY, 3 CFG_SET, 4 CFG_ACK"
key   cfg_reserved         int     -  "CP payload: the 24 reserved bits, 0"
list  cfg_attributes       "CP payload: the configuration attributes, in order"
key   cfg_attr_reserved    int     -  "configuration attribute: the reserved bit, 0"
key   cfg_attr_type        int     -  "configuration attribute type (1 INTERNAL_IP4_ADDRESS, 3 INTERNAL_IP4_DNS, 8 INTERNAL_IP6_ADDRESS ...)"
key   eap_code             int     -  "EAP message code: 1 request, 2 response, 3 success, 4 failure"
key   eap_identifier       int     -  "EAP message identifier"
key   eap_type             int     -  "EAP request or response: the method type"
list  eap_data             "EAP request or response: the type data, as octets"
key   eap_length           int     -  "EAP success or failure: the EAP length, as on the wire (4)"
key   octet                int     -  "one octet"
