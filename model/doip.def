# The doip module: DoIP header and payload fields. Written by tools/gen/vehnet-pack.py.
module        doip
version       0.1.0
distribution  public
source        "Wireshark, https://github.com/wireshark/wireshark at commit de1eec95b2007952f7399173d2f0904275a31c6f, epan/dissectors/packet-doip.c (GPL-2.0-or-later); layouts restated, no code copied; ISO 13400-2 not used"
key   version           int     -  "protocol version: 1 ISO 13400-2:2010, 2 :2012, 3 :2019, 4 :2019/Amd1, 0xFF default (vehicle identification request)"
key   inverse_version   int     -  "the version's bitwise inverse"
key   payload_type      int     -  "payload type: 0 generic header NACK, 1-3 vehicle identification request (plain, by EID, by VIN), 4 vehicle announcement or identification response, 5 routing activation request, 6 response, 7 alive check request, 8 response, 0x4001-0x4004 entity status and power mode information request and response, 0x8001 diagnostic message, 0x8002 ACK, 0x8003 NACK"
key   nack_code         int     -  "generic header NACK or diagnostic message NACK: the code"
key   eid               string  -  "entity identifier, 6 octets as hexadecimal digits"
key   gid               string  -  "group identifier, 6 octets as hexadecimal digits"
key   vin               string  -  "vehicle identification number, 17 characters"
key   logical_address   int     -  "vehicle announcement: the entity's logical address"
key   further_action    int     -  "vehicle announcement: further action required"
key   sync_status       int     -  "vehicle announcement: VIN/GID synchronisation status (from version 2, optional)"
key   source_address    int     -  "the source (tester or entity) logical address"
key   target_address    int     -  "diagnostic message: the target logical address"
key   activation_type   int     -  "routing activation request: activation type (16 bits in version 1, 8 bits later)"
key   reserved_iso      int     -  "routing activation: the 4 octets reserved by ISO"
list  reserved_oem      "routing activation: the optional 4 octets reserved for the OEM, as octets"
key   tester_address    int     -  "routing activation response: the tester's logical address"
key   response_code     int     -  "routing activation response: the code (0x10 activated ...)"
key   node_type         int     -  "entity status response: node type (0 gateway, 1 node)"
key   max_sockets       int     -  "entity status response: maximum concurrent TCP sockets"
key   current_sockets   int     -  "entity status response: currently open TCP sockets"
key   max_data_size     int     -  "entity status response: maximum data size (from version 2, optional)"
key   power_mode        int     -  "power mode information response: the power mode"
list  user_data         "diagnostic message: the user data (a UDS message), as octets"
key   ack_code          int     -  "diagnostic message ACK: the code"
list  previous_message  "diagnostic message ACK or NACK: the previous diagnostic message, as octets"
list  payload           "another payload type's payload, as octets"
key   octet             int     -  "one octet"
