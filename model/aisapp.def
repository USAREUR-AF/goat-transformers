# The aisapp module: AIS binary application messages of variable length. Written by tools/gen/ais-apps-pack.py.
module        aisapp
version       0.1.0
distribution  public
source        "gpsd, AIVDM/AIVDO protocol decoding, sections IMO236 Tidal Window, IMO289 Dangerous Cargo Indication, IMO289 Route Information (addressed, broadcast), Tidal Window (IMO289), VTS-Generated/Synthetic targets and IMO289 Environmental, www/AIVDM.adoc (sha256 a55511139751f5b9385166143443c0353f64fc77155b4ef4026f4ab03e3dffbd) at https://gitlab.com/gpsd/gpsd commit c59fc6de479d06620c8b2ba395b728e10a71527b, BSD-2-Clause (gpsd COPYING); layout restated"
key   month              int     -  "month, UTC, 1-12; 0 not available"
key   day                int     -  "day, UTC, 1-31; 0 not available"
key   hour               int     -  "hour, UTC, 0-23; 24 not available"
key   minute             int     -  "minute, UTC, 0-59; 60 not available"
list  tidals             "tidal window: the predictions, 1 to 3"
key   tw_lat             int     -  "tidal window latitude, signed: ten-thousandths of a minute (FI 14, 27 bits) or thousandths (FI 32, 24 bits); 91000 not available as the source gives it"
key   tw_lon             int     -  "tidal window longitude, signed: ten-thousandths of a minute (FI 14, 28 bits) or thousandths (FI 32, 25 bits); 181000 not available as the source gives it"
key   from_hour          int     -  "tidal window from hour, UTC; 24 not available"
key   from_min           int     -  "tidal window from minute, UTC; 60 not available"
key   to_hour            int     -  "tidal window to hour, UTC; 24 not available"
key   to_min             int     -  "tidal window to minute, UTC; 60 not available"
key   cdir               int     -  "predicted current direction, degrees; 360 not available"
key   cspeed             int     -  "predicted current speed, tenths of a knot (FI 14: 127 not available; FI 32: 251 is 25.1 knots or more, 255 not available)"
key   cargo_unit         int     -  "dangerous cargo: unit of quantity code"
key   cargo_amount       int     -  "dangerous cargo: amount; 0 not available"
list  cargos             "dangerous cargo: the cargo types, 1 to 28"
key   cargo_code         int     -  "cargo code: 0 not available, 1 IMDG, 2 IGC, 3 BC (IMSBC), 4 MARPOL Annex I, 5 MARPOL Annex II, 6 regional"
key   cargo_subtype      int     -  "cargo subtype under its code (IMDG class, UN number, MARPOL category ...); 0 not available"
key   linkage            int     -  "message linkage ID"
key   sender             int     -  "route: sender class, 0 ship, 1 authority"
key   route_type         int     -  "route type: 0 undefined, 1 mandatory, 2 recommended, 3 alternative, 4 through ice, 5 ship route plan, 31 cancel"
key   duration           int     -  "route: duration from the start, minutes; 0 cancels, 262143 not available"
list  waypoints          "route: the waypoints, 1 to 16; their number is written from the list"
key   wp_lon             int     -  "waypoint longitude, ten-thousandths of a minute, signed; 181000 not available as the source gives it"
key   wp_lat             int     -  "waypoint latitude, signed: ten-thousandths of a minute (the broadcast table says thousandths for the same 27 bits); 91000 not available as the source gives it"
list  targets            "VTS targets: 1 to 4"
key   idtype             int     -  "target identifier type: 0 MMSI, 1 IMO number, 2 call sign, 3 other"
key   target_id          int     -  "target identifier, types 0 and 1: the number"
key   target_name        string  -  "target identifier, types 2 and 3: seven six-bit characters"
key   target_spare       int     -  "target: the 4 spare bits"
key   target_lat         int     -  "target latitude, thousandths of a minute, signed; 91000 not available"
key   target_lon         int     -  "target longitude, thousandths of a minute, signed; 181000 not available"
key   course             int     -  "target course over ground, degrees; 360 not available"
key   second             int     -  "target time stamp, second of the UTC minute"
key   speed              int     -  "target speed over ground, knots; 255 not available"
list  reports            "environmental: the sensor reports, 1 to 5, 112 bits each"
key   sensor             int     -  "sensor report type: 0 site location, 1 station ID, 2 wind, 3 water level, 4 current 2D, 5 current 3D, 6 horizontal current, 7 sea state, 8 salinity, 9 weather, 10 air gap"
key   site               int     -  "sensor site ID"
key   site_lon           int     -  "site longitude, ten-thousandths of a minute, signed"
key   site_lat           int     -  "site latitude, ten-thousandths of a minute, signed"
key   site_alt           int     -  "sensor altitude above mean sea level, as the wire integer"
key   owner              int     -  "sensor owner code"
key   timeout            int     -  "data timeout code"
key   station_name       string  -  "station ID: fourteen six-bit characters"
key   wind_speed         int     -  "10-minute average wind speed, as the wire integer"
key   wind_gust          int     -  "10-minute maximum wind speed, as the wire integer"
key   wind_dir           int     -  "wind direction, degrees from true north"
key   wind_gust_dir      int     -  "gust direction, degrees from true north"
key   sensor_type        int     -  "sensor description: 0 no data, 1 raw real time, 2 real time with quality control, 3 predicted, 4 forecast, 5 nowcast, 7 not available"
key   fc_wind_speed      int     -  "forecast wind speed, as the wire integer"
key   fc_wind_gust       int     -  "forecast wind gust, as the wire integer"
key   fc_wind_dir        int     -  "forecast wind direction, degrees"
key   fc_day             int     -  "forecast valid time: day, UTC"
key   fc_hour            int     -  "forecast valid time: hour, UTC"
key   fc_minute          int     -  "forecast valid time: minute, UTC"
key   fc_duration        int     -  "forecast duration, minutes"
key   level_absolute     int     -  "water level type: 0 relative to the datum, 1 absolute"
key   level              int     -  "water level, signed, as the wire integer (gpsd: hundredths of a metre)"
key   level_trend        int     -  "water level trend: 0 increasing, 1 decreasing, 2 steady"
key   level_datum        int     -  "vertical reference datum code (0 MLLW ... 10 WGS 84, 11 LAT, 14 not available)"
key   fc_level_absolute  int     -  "forecast water level type"
key   fc_level           int     -  "forecast water level, signed, as the wire integer"
key   cspeed1            int     -  "current speed 1, tenths of a knot"
key   cdir1              int     -  "current direction 1, degrees"
key   cdepth1            int     -  "measurement depth 1, metres"
key   cspeed2            int     -  "current speed 2, tenths of a knot"
key   cdir2              int     -  "current direction 2, degrees"
key   cdepth2            int     -  "measurement depth 2, metres"
key   cspeed3            int     -  "current speed 3, tenths of a knot"
key   cdir3              int     -  "current direction 3, degrees"
key   cdepth3            int     -  "measurement depth 3, metres"
key   cnorth1            int     -  "current north component 1, tenths of a knot"
key   ceast1             int     -  "current east component 1, tenths of a knot"
key   cup1               int     -  "current up component 1, tenths of a knot"
key   cnorth2            int     -  "current north component 2, tenths of a knot"
key   ceast2             int     -  "current east component 2, tenths of a knot"
key   cup2               int     -  "current up component 2, tenths of a knot"
key   hbearing1          int     -  "horizontal current 1: bearing, degrees"
key   hdistance1         int     -  "horizontal current 1: distance, metres"
key   hbearing2          int     -  "horizontal current 2: bearing, degrees"
key   hdistance2         int     -  "horizontal current 2: distance, metres"
key   swell_height       int     -  "swell height, tenths of a metre"
key   swell_period       int     -  "swell period, seconds"
key   swell_dir          int     -  "swell direction, degrees"
key   sea_state          int     -  "sea state, Beaufort 0-12"
key   swell_type         int     -  "swell sensor description"
key   water_temp         int     -  "water temperature, as the wire integer (tenths of a degree with an offset the source gives)"
key   water_temp_depth   int     -  "water temperature depth, tenths of a metre"
key   depth_type         int     -  "depth sensor description"
key   wave_height        int     -  "wave height, tenths of a metre"
key   wave_period        int     -  "wave period, seconds"
key   wave_dir           int     -  "wave direction, degrees"
key   wave_type          int     -  "wave sensor description"
key   salinity           int     -  "salinity, tenths of a percent"
key   conductivity       int     -  "conductivity, as the wire integer (siemens per metre in tenths)"
key   water_pressure     int     -  "water pressure, as the wire integer"
key   salinity_type      int     -  "salinity type: 0 measured, 1 calculated, 2 simulated"
key   air_temp           int     -  "air temperature, tenths of a degree Celsius, signed"
key   precip_type        int     -  "precipitation type code"
key   visibility         int     -  "horizontal visibility, tenths of a nautical mile"
key   dew_point          int     -  "dew point, tenths of a degree Celsius, signed"
key   dew_type           int     -  "dew point sensor description"
key   air_pressure       int     -  "air pressure, as the wire integer (hectopascals with an offset)"
key   pressure_tendency  int     -  "pressure tendency: 0 steady, 1 decreasing, 2 increasing"
key   pressure_type      int     -  "pressure sensor description"
key   air_draught        int     -  "air draught, hundredths of a metre"
key   air_gap            int     -  "air gap, hundredths of a metre"
key   air_gap_trend      int     -  "air gap trend: 0 steady, 1 decreasing, 2 increasing"
key   fc_air_gap         int     -  "forecast air gap, hundredths of a metre"
key   payload_spare      int     -  "the spare bits at the end of a sensor payload"
key   reserved_payload   string  -  "a reserved sensor report type: its first 84 payload bits, as hexadecimal digits"
