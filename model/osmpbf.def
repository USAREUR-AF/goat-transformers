# The osmpbf module: raw keys shared by the packs that name it in a `uses` line,
# one per schema field a pack maps. Extended, never rewritten: a key keeps
# its line once it has one. Last extended for the osm-pbf-primitive format by
# tools/gen/proto2pack.py from the sources below; edit the generator, not this file.
module        osmpbf
version       0.1.0
distribution  public
source        "OpenStreetMap PBF format definitions: github.com/openstreetmap/OSM-binary commit 9f01ad3ece9737503a059d58749e02c9008d5699, osmpbf/fileformat.proto and osmpbf/osmformat.proto; field numbers, names and types only"
source        "osmpbf/LICENSE and the header of both files at that commit: MIT License (Copyright (c) OpenStreetMap developers; Copyright (c) 2010 Scott A. Crosby); the repository's LICENSE is the GNU LGPL, Version 3"
key  blob_header_type      string  -  "BlobHeader.type (string)"
key  blob_header_datasize  int     -  "BlobHeader.datasize (int32)"
key  bbox_left                                         int     -  "HeaderBBox.left (sint64)"
key  bbox_right                                        int     -  "HeaderBBox.right (sint64)"
key  bbox_top                                          int     -  "HeaderBBox.top (sint64)"
key  bbox_bottom                                       int     -  "HeaderBBox.bottom (sint64)"
key  header_block_writingprogram                       string  -  "HeaderBlock.writingprogram (string)"
key  header_block_source                               string  -  "HeaderBlock.source (string)"
key  header_block_osmosis_replication_timestamp        int     -  "HeaderBlock.osmosis_replication_timestamp (int64)"
key  header_block_osmosis_replication_sequence_number  int     -  "HeaderBlock.osmosis_replication_sequence_number (int64)"
key  header_block_osmosis_replication_base_url         string  -  "HeaderBlock.osmosis_replication_base_url (string)"
key  header_block_required_features_item               string  -  "HeaderBlock.required_features (string); one item of the repeated field"
key  header_block_optional_features_item               string  -  "HeaderBlock.optional_features (string); one item of the repeated field"
list header_block_required_features  "HeaderBlock.required_features (repeated string); each item holds osmpbf.header_block_required_features_item"
list header_block_optional_features  "HeaderBlock.optional_features (repeated string); each item holds osmpbf.header_block_optional_features_item"
key  primitive_block_granularity       int     -  "PrimitiveBlock.granularity (int32)"
key  primitive_block_lat_offset        int     -  "PrimitiveBlock.lat_offset (int64)"
key  primitive_block_lon_offset        int     -  "PrimitiveBlock.lon_offset (int64)"
key  primitive_block_date_granularity  int     -  "PrimitiveBlock.date_granularity (int32)"
key  node_id                           int     -  "Node.id (sint64)"
key  node_info_version                 int     -  "Info.version (int32)"
key  node_info_timestamp               int     -  "Info.timestamp (int64)"
key  node_info_changeset               int     -  "Info.changeset (int64)"
key  node_info_uid                     int     -  "Info.uid (int32)"
key  node_info_user_sid                int     -  "Info.user_sid (uint32)"
key  node_info_visible                 int     -  "Info.visible (bool)"
key  node_lat                          int     -  "Node.lat (sint64)"
key  node_lon                          int     -  "Node.lon (sint64)"
key  node_keys_item                    int     -  "Node.keys (uint32); one item of the repeated field"
key  node_vals_item                    int     -  "Node.vals (uint32); one item of the repeated field"
key  dense_nodes_id_item               int     -  "DenseNodes.id (sint64); one item of the repeated field"
key  dense_info_version_item           int     -  "DenseInfo.version (int32); one item of the repeated field"
key  dense_info_timestamp_item         int     -  "DenseInfo.timestamp (sint64); one item of the repeated field"
key  dense_info_changeset_item         int     -  "DenseInfo.changeset (sint64); one item of the repeated field"
key  dense_info_uid_item               int     -  "DenseInfo.uid (sint32); one item of the repeated field"
key  dense_info_user_sid_item          int     -  "DenseInfo.user_sid (sint32); one item of the repeated field"
key  dense_info_visible_item           int     -  "DenseInfo.visible (bool); one item of the repeated field"
key  dense_nodes_lat_item              int     -  "DenseNodes.lat (sint64); one item of the repeated field"
key  dense_nodes_lon_item              int     -  "DenseNodes.lon (sint64); one item of the repeated field"
key  dense_nodes_keys_vals_item        int     -  "DenseNodes.keys_vals (int32); one item of the repeated field"
key  way_id                            int     -  "Way.id (int64)"
key  way_info_version                  int     -  "Info.version (int32)"
key  way_info_timestamp                int     -  "Info.timestamp (int64)"
key  way_info_changeset                int     -  "Info.changeset (int64)"
key  way_info_uid                      int     -  "Info.uid (int32)"
key  way_info_user_sid                 int     -  "Info.user_sid (uint32)"
key  way_info_visible                  int     -  "Info.visible (bool)"
key  way_keys_item                     int     -  "Way.keys (uint32); one item of the repeated field"
key  way_vals_item                     int     -  "Way.vals (uint32); one item of the repeated field"
key  way_refs_item                     int     -  "Way.refs (sint64); one item of the repeated field"
key  way_lat_item                      int     -  "Way.lat (sint64); one item of the repeated field"
key  way_lon_item                      int     -  "Way.lon (sint64); one item of the repeated field"
key  relation_id                       int     -  "Relation.id (int64)"
key  relation_info_version             int     -  "Info.version (int32)"
key  relation_info_timestamp           int     -  "Info.timestamp (int64)"
key  relation_info_changeset           int     -  "Info.changeset (int64)"
key  relation_info_uid                 int     -  "Info.uid (int32)"
key  relation_info_user_sid            int     -  "Info.user_sid (uint32)"
key  relation_info_visible             int     -  "Info.visible (bool)"
key  relation_keys_item                int     -  "Relation.keys (uint32); one item of the repeated field"
key  relation_vals_item                int     -  "Relation.vals (uint32); one item of the repeated field"
key  relation_roles_sid_item           int     -  "Relation.roles_sid (int32); one item of the repeated field"
key  relation_memids_item              int     -  "Relation.memids (sint64); one item of the repeated field"
key  relation_types_item               int     -  "Relation.types (enum MemberType: 0=NODE, 1=WAY, 2=RELATION); one item of the repeated field"
key  change_set_id                     int     -  "ChangeSet.id (int64)"
list primitive_block_primitivegroup             "PrimitiveBlock.primitivegroup (repeated PrimitiveGroup); each item is one PrimitiveGroup message"
list primitive_group_nodes                      "PrimitiveGroup.nodes (repeated Node); each item is one Node message"
list node_keys                                  "Node.keys (repeated uint32); each item holds osmpbf.node_keys_item"
list node_vals                                  "Node.vals (repeated uint32); each item holds osmpbf.node_vals_item"
list primitive_group_dense_id                   "DenseNodes.id (repeated sint64); each item holds osmpbf.dense_nodes_id_item"
list primitive_group_dense_denseinfo_version    "DenseInfo.version (repeated int32); each item holds osmpbf.dense_info_version_item"
list primitive_group_dense_denseinfo_timestamp  "DenseInfo.timestamp (repeated sint64); each item holds osmpbf.dense_info_timestamp_item"
list primitive_group_dense_denseinfo_changeset  "DenseInfo.changeset (repeated sint64); each item holds osmpbf.dense_info_changeset_item"
list primitive_group_dense_denseinfo_uid        "DenseInfo.uid (repeated sint32); each item holds osmpbf.dense_info_uid_item"
list primitive_group_dense_denseinfo_user_sid   "DenseInfo.user_sid (repeated sint32); each item holds osmpbf.dense_info_user_sid_item"
list primitive_group_dense_denseinfo_visible    "DenseInfo.visible (repeated bool); each item holds osmpbf.dense_info_visible_item"
list primitive_group_dense_lat                  "DenseNodes.lat (repeated sint64); each item holds osmpbf.dense_nodes_lat_item"
list primitive_group_dense_lon                  "DenseNodes.lon (repeated sint64); each item holds osmpbf.dense_nodes_lon_item"
list primitive_group_dense_keys_vals            "DenseNodes.keys_vals (repeated int32); each item holds osmpbf.dense_nodes_keys_vals_item"
list primitive_group_ways                       "PrimitiveGroup.ways (repeated Way); each item is one Way message"
list way_keys                                   "Way.keys (repeated uint32); each item holds osmpbf.way_keys_item"
list way_vals                                   "Way.vals (repeated uint32); each item holds osmpbf.way_vals_item"
list way_refs                                   "Way.refs (repeated sint64); each item holds osmpbf.way_refs_item"
list way_lat                                    "Way.lat (repeated sint64); each item holds osmpbf.way_lat_item"
list way_lon                                    "Way.lon (repeated sint64); each item holds osmpbf.way_lon_item"
list primitive_group_relations                  "PrimitiveGroup.relations (repeated Relation); each item is one Relation message"
list relation_keys                              "Relation.keys (repeated uint32); each item holds osmpbf.relation_keys_item"
list relation_vals                              "Relation.vals (repeated uint32); each item holds osmpbf.relation_vals_item"
list relation_roles_sid                         "Relation.roles_sid (repeated int32); each item holds osmpbf.relation_roles_sid_item"
list relation_memids                            "Relation.memids (repeated sint64); each item holds osmpbf.relation_memids_item"
list relation_types                             "Relation.types (repeated MemberType); each item holds osmpbf.relation_types_item"
list primitive_group_changesets                 "PrimitiveGroup.changesets (repeated ChangeSet); each item is one ChangeSet message"
