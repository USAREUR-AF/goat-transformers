# The shelly module: members of Shelly Gen2+ JSON-RPC frames and component status objects.
module        shelly
version       0.1.0
distribution  public
source        "Shelly Gen2+ device API documentation (Allterco Robotics), https://shelly-api-docs.shelly.cloud/gen2/ pages General/RPCProtocol, General/Notifications and ComponentsAndServices Switch, Cover, Input, Temperature and Sys, read 2026-11-21; Copyright (c) 2026 Allterco Robotics, no licence stated; member names restated"
key   cover0_aenergy_minute_ts                 int    -  "cover:0 start of the current minute, Unix seconds"
key   cover0_aenergy_total                     float  -  "cover:0 total energy, Wh"
key   cover0_apower                            float  -  "cover:0 active power, W"
key   cover0_current                           float  -  "cover:0 current, A"
key   cover0_current_pos                       float  -  "cover:0 position, percent open"
key   cover0_freq                              float  -  "cover:0 frequency, Hz"
key   cover0_id                                int    -  "cover:0 instance id"
key   cover0_last_direction                    string -  "cover:0 open or close"
key   cover0_move_started_at                   float  -  "cover:0 move start, Unix seconds"
key   cover0_move_timeout                      float  -  "cover:0 move timeout, s"
key   cover0_pf                                float  -  "cover:0 power factor"
key   cover0_pos_control                       int    -  "cover:0 calibrated for positions"
key   cover0_slat_pos                          float  -  "cover:0 slat position, percent"
key   cover0_source                            string -  "cover:0 source of the last command"
key   cover0_state                             string -  "cover:0 open, closed, opening, closing, stopped or calibrating"
key   cover0_tag                               string -  "cover:0 tag of the last change"
key   cover0_target_pos                        float  -  "cover:0 target position, percent open"
key   cover0_temperature_tc                    float  -  "cover:0 temperature, degrees C"
key   cover0_temperature_tf                    float  -  "cover:0 temperature, degrees F"
key   cover0_voltage                           float  -  "cover:0 voltage, V"
