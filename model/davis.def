# The davis module: members of the WeatherLink Live local API JSON (current conditions, real-time broadcast).
module        davis
version       0.1.0
distribution  public
source        "WeatherLink Live Local API (Davis Instruments), github.com/weatherlink/weatherlink-live-local-api commit 4383b984b1dcf1ab374fb2c2527aea86cfa523a8, API.md; no licence stated; member names and units restated"
list  conditions  "the condition records, one per logical sensor"
key   cond_lsid                            int    -  "logical sensor ID"
key   cond_data_structure_type             int    -  "record type: 1 ISS, 2 leaf/soil, 3 barometer, 4 inside temperature and humidity"
key   cond_txid                            int    -  "transmitter ID"
key   cond_temp                            float  -  "temperature, degrees Fahrenheit"
key   cond_hum                             float  -  "relative humidity, percent"
key   cond_dew_point                       float  -  "dew point, degrees F"
key   cond_wet_bulb                        float  -  "wet bulb, degrees F"
key   cond_heat_index                      float  -  "heat index, degrees F"
key   cond_wind_chill                      float  -  "wind chill, degrees F"
key   cond_thw_index                       float  -  "THW index, degrees F"
key   cond_thsw_index                      float  -  "THSW index, degrees F"
key   cond_wind_speed_last                 float  -  "latest wind speed, mph"
key   cond_wind_dir_last                   float  -  "latest wind direction, degrees"
key   cond_wind_speed_avg_last_1_min       float  -  "mean wind speed over 1 minute, mph"
key   cond_wind_dir_scalar_avg_last_1_min  float  -  "scalar mean wind direction over 1 minute, degrees"
key   cond_wind_speed_avg_last_2_min       float  -  "mean wind speed over 2 minutes, mph"
key   cond_wind_dir_scalar_avg_last_2_min  float  -  "scalar mean wind direction over 2 minutes, degrees"
key   cond_wind_speed_hi_last_2_min        float  -  "highest wind speed over 2 minutes, mph"
key   cond_wind_dir_at_hi_speed_last_2_min float  -  "direction of that gust, degrees"
key   cond_wind_speed_avg_last_10_min      float  -  "mean wind speed over 10 minutes, mph"
key   cond_wind_dir_scalar_avg_last_10_min float  -  "scalar mean wind direction over 10 minutes, degrees"
key   cond_wind_speed_hi_last_10_min       float  -  "highest wind speed over 10 minutes, mph"
key   cond_wind_dir_at_hi_speed_last_10_min float  -  "direction of that gust, degrees"
key   cond_rain_size                       int    -  "rain collector size: 1 0.01 in, 2 0.2 mm, 3 0.1 mm, 4 0.001 in per count"
key   cond_rain_rate_last                  float  -  "latest rain rate, counts per hour"
key   cond_rain_rate_hi                    float  -  "highest rain rate over 1 minute, counts per hour"
key   cond_rainfall_last_15_min            float  -  "rain over 15 minutes, counts"
key   cond_rain_rate_hi_last_15_min        float  -  "highest rain rate over 15 minutes, counts per hour"
key   cond_rainfall_last_60_min            float  -  "rain over 60 minutes, counts"
key   cond_rainfall_last_24_hr             float  -  "rain over 24 hours, counts"
key   cond_rain_15_min                     float  -  "rain over 15 minutes, counts (UDP record)"
key   cond_rain_60_min                     float  -  "rain over 60 minutes, counts (UDP record)"
key   cond_rain_24_hr                      float  -  "rain over 24 hours, counts (UDP record)"
key   cond_rain_storm                      float  -  "rain since the last 24-hour break in rain, counts"
key   cond_rain_storm_start_at             int    -  "start of the current rain storm, Unix seconds"
key   cond_solar_rad                       float  -  "solar radiation, W/m2"
key   cond_uv_index                        float  -  "UV index"
key   cond_rx_state                        int    -  "radio receiver state: 0 synched and tracking, 1 synched, 2 scanning"
key   cond_trans_battery_flag              int    -  "transmitter battery: 1 low, 0 good"
key   cond_rainfall_daily                  float  -  "rain since local midnight, counts"
key   cond_rainfall_monthly                float  -  "rain since the first of the month, counts"
key   cond_rainfall_year                   float  -  "rain since the first of the chosen month, counts"
key   cond_rain_storm_last                 float  -  "rain of the last storm, counts"
key   cond_rain_storm_last_start_at        int    -  "start of the last rain storm, Unix seconds"
key   cond_rain_storm_last_end_at          int    -  "end of the last rain storm, Unix seconds"
key   cond_temp_1                          float  -  "soil temperature slot 1, degrees F"
key   cond_temp_2                          float  -  "soil temperature slot 2, degrees F"
key   cond_temp_3                          float  -  "soil temperature slot 3, degrees F"
key   cond_temp_4                          float  -  "soil temperature slot 4, degrees F"
key   cond_moist_soil_1                    float  -  "soil moisture slot 1, centibar"
key   cond_moist_soil_2                    float  -  "soil moisture slot 2, centibar"
key   cond_moist_soil_3                    float  -  "soil moisture slot 3, centibar"
key   cond_moist_soil_4                    float  -  "soil moisture slot 4, centibar"
key   cond_wet_leaf_1                      float  -  "leaf wetness slot 1"
key   cond_wet_leaf_2                      float  -  "leaf wetness slot 2"
key   cond_temp_in                         float  -  "inside temperature, degrees F"
key   cond_hum_in                          float  -  "inside humidity, percent"
key   cond_dew_point_in                    float  -  "inside dew point, degrees F"
key   cond_heat_index_in                   float  -  "inside heat index, degrees F"
key   cond_bar_sea_level                   float  -  "barometer adjusted to sea level, inches of mercury"
key   cond_bar_trend                       float  -  "3-hour barometer trend, inches of mercury"
key   cond_bar_absolute                    float  -  "barometer as measured, inches of mercury"
key   broadcast_port                       int    -  "UDP port of the real-time broadcast (real_time response)"
key   duration_s                           int    -  "duration of the real-time broadcast, seconds (real_time response)"
key   error_code                           int    -  "HTTP error code of a failed request"
key   error_message                        string -  "error message of a failed request"
