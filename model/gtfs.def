# The gtfs module: the columns of GTFS Schedule files, one key per column name.
# A name that several files use (stop_id, trip_id, shape_dist_traveled, ...) is one key:
# the reference gives it one meaning. Each line names the files that have the column.
module        gtfs
version       0.1.0
distribution  public
source        "GTFS Schedule Reference, gtfs/spec/en/reference.md of https://github.com/google/transit (Apache-2.0) at commit 2ce6aa79e3fa7bdbaf19d2a12765cee5b9fdd699; the column order of each file as the reference lists it; field names and types"
key  agency_email                   string  -  "e-mail address (agency.txt)"
key  agency_fare_url                string  -  "URL (agency.txt)"
key  agency_id                      string  -  "identifier, unique in its file (agency.txt, routes.txt, attributions.txt)"
key  agency_lang                    string  -  "IETF BCP 47 language code (agency.txt)"
key  agency_name                    string  -  "text for riders (agency.txt)"
key  agency_phone                   string  -  "phone number as written (agency.txt)"
key  agency_timezone                string  -  "IANA time zone name (agency.txt)"
key  agency_url                     string  -  "URL (agency.txt)"
key  arrival_time                   string  -  "time of the service day, H:MM:SS or HH:MM:SS, may pass 24:00:00 (stop_times.txt)"
key  attribution_email              string  -  "e-mail address (attributions.txt)"
key  attribution_id                 string  -  "identifier, unique in its file (attributions.txt)"
key  attribution_phone              string  -  "phone number as written (attributions.txt)"
key  attribution_url                string  -  "URL (attributions.txt)"
key  bikes_allowed                  int     -  "code from the reference's list (trips.txt)"
key  block_id                       string  -  "identifier (trips.txt)"
key  cars_allowed                   int     -  "code from the reference's list (trips.txt)"
key  cemv_support                   int     -  "code from the reference's list (agency.txt, routes.txt)"
key  continuous_drop_off            int     -  "code from the reference's list (routes.txt, stop_times.txt)"
key  continuous_pickup              int     -  "code from the reference's list (routes.txt, stop_times.txt)"
key  date                           string  -  "service date, YYYYMMDD (calendar_dates.txt)"
key  default_lang                   string  -  "IETF BCP 47 language code (feed_info.txt)"
key  departure_time                 string  -  "time of the service day, H:MM:SS or HH:MM:SS, may pass 24:00:00 (stop_times.txt)"
key  direction_id                   int     -  "code from the reference's list (trips.txt)"
key  drop_off_booking_rule_id       string  -  "reference to an identifier of another file (stop_times.txt)"
key  drop_off_type                  int     -  "code from the reference's list (stop_times.txt)"
key  end_date                       string  -  "service date, YYYYMMDD (calendar.txt)"
key  end_pickup_drop_off_window     string  -  "time of the service day, H:MM:SS or HH:MM:SS, may pass 24:00:00 (stop_times.txt)"
key  end_time                       string  -  "time of the service day, H:MM:SS or HH:MM:SS, may pass 24:00:00 (frequencies.txt)"
key  exact_times                    int     -  "code from the reference's list (frequencies.txt)"
key  exception_type                 int     -  "code from the reference's list (calendar_dates.txt)"
key  feed_contact_email             string  -  "e-mail address (feed_info.txt)"
key  feed_contact_url               string  -  "URL (feed_info.txt)"
key  feed_end_date                  string  -  "service date, YYYYMMDD (feed_info.txt)"
key  feed_lang                      string  -  "IETF BCP 47 language code (feed_info.txt)"
key  feed_publisher_name            string  -  "text for riders (feed_info.txt)"
key  feed_publisher_url             string  -  "URL (feed_info.txt)"
key  feed_start_date                string  -  "service date, YYYYMMDD (feed_info.txt)"
key  feed_version                   string  -  "text for riders (feed_info.txt)"
key  friday                         int     -  "code from the reference's list (calendar.txt)"
key  from_route_id                  string  -  "reference to an identifier of another file (transfers.txt)"
key  from_stop_id                   string  -  "reference to an identifier of another file (transfers.txt, pathways.txt)"
key  from_trip_id                   string  -  "reference to an identifier of another file (transfers.txt)"
key  headway_secs                   int     -  "integer, more than 0 (frequencies.txt)"
key  is_authority                   int     -  "code from the reference's list (attributions.txt)"
key  is_bidirectional               int     -  "code from the reference's list (pathways.txt)"
key  is_operator                    int     -  "code from the reference's list (attributions.txt)"
key  is_producer                    int     -  "code from the reference's list (attributions.txt)"
key  length                         float   -  "number, 0 or more (pathways.txt)"
key  level_id                       string  -  "reference to an identifier of another file (stops.txt, levels.txt)"
key  level_index                    float   -  "number (levels.txt)"
key  level_name                     string  -  "text for riders (levels.txt)"
key  location_group_id              string  -  "reference to an identifier of another file (stop_times.txt)"
key  location_id                    string  -  "reference to an identifier of another file (stop_times.txt)"
key  location_type                  int     -  "code from the reference's list (stops.txt)"
key  max_slope                      float   -  "number (pathways.txt)"
key  min_transfer_time              int     -  "integer, 0 or more (transfers.txt)"
key  min_width                      float   -  "number, more than 0 (pathways.txt)"
key  monday                         int     -  "code from the reference's list (calendar.txt)"
key  network_id                     string  -  "identifier (routes.txt)"
key  organization_name              string  -  "text for riders (attributions.txt)"
key  parent_station                 string  -  "reference to an identifier of another file (stops.txt)"
key  pathway_id                     string  -  "identifier, unique in its file (pathways.txt)"
key  pathway_mode                   int     -  "code from the reference's list (pathways.txt)"
key  pickup_booking_rule_id         string  -  "reference to an identifier of another file (stop_times.txt)"
key  pickup_type                    int     -  "code from the reference's list (stop_times.txt)"
key  platform_code                  string  -  "text for riders (stops.txt)"
key  reversed_signposted_as         string  -  "text for riders (pathways.txt)"
key  route_color                    string  -  "colour, six hexadecimal digits (routes.txt)"
key  route_desc                     string  -  "text for riders (routes.txt)"
key  route_id                       string  -  "identifier, unique in its file (routes.txt, trips.txt, attributions.txt)"
key  route_long_name                string  -  "text for riders (routes.txt)"
key  route_short_name               string  -  "text for riders (routes.txt)"
key  route_sort_order               int     -  "integer, 0 or more (routes.txt)"
key  route_text_color               string  -  "colour, six hexadecimal digits (routes.txt)"
key  route_type                     int     -  "code from the reference's list (routes.txt)"
key  route_url                      string  -  "URL (routes.txt)"
key  safe_duration_factor           float   -  "number (trips.txt)"
key  safe_duration_offset           float   -  "number (trips.txt)"
key  saturday                       int     -  "code from the reference's list (calendar.txt)"
key  service_id                     string  -  "reference to an identifier of another file (trips.txt, calendar.txt, calendar_dates.txt)"
key  shape_dist_traveled            float   -  "number, 0 or more (stop_times.txt, shapes.txt)"
key  shape_id                       string  -  "reference to an identifier of another file (trips.txt, shapes.txt)"
key  shape_pt_lat                   float   -  "latitude, WGS 84 decimal degrees (shapes.txt)"
key  shape_pt_lon                   float   -  "longitude, WGS 84 decimal degrees (shapes.txt)"
key  shape_pt_sequence              int     -  "integer, 0 or more (shapes.txt)"
key  signposted_as                  string  -  "text for riders (pathways.txt)"
key  stair_count                    int     -  "integer, not 0 (pathways.txt)"
key  start_date                     string  -  "service date, YYYYMMDD (calendar.txt)"
key  start_pickup_drop_off_window   string  -  "time of the service day, H:MM:SS or HH:MM:SS, may pass 24:00:00 (stop_times.txt)"
key  start_time                     string  -  "time of the service day, H:MM:SS or HH:MM:SS, may pass 24:00:00 (frequencies.txt)"
key  stop_access                    int     -  "code from the reference's list (stops.txt)"
key  stop_code                      string  -  "text for riders (stops.txt)"
key  stop_desc                      string  -  "text for riders (stops.txt)"
key  stop_headsign                  string  -  "text for riders (stop_times.txt)"
key  stop_id                        string  -  "identifier, unique in its file (stops.txt, stop_times.txt)"
key  stop_lat                       float   -  "latitude, WGS 84 decimal degrees (stops.txt)"
key  stop_lon                       float   -  "longitude, WGS 84 decimal degrees (stops.txt)"
key  stop_name                      string  -  "text for riders (stops.txt)"
key  stop_sequence                  int     -  "integer, 0 or more (stop_times.txt)"
key  stop_timezone                  string  -  "IANA time zone name (stops.txt)"
key  stop_url                       string  -  "URL (stops.txt)"
key  sunday                         int     -  "code from the reference's list (calendar.txt)"
key  thursday                       int     -  "code from the reference's list (calendar.txt)"
key  timepoint                      int     -  "code from the reference's list (stop_times.txt)"
key  to_route_id                    string  -  "reference to an identifier of another file (transfers.txt)"
key  to_stop_id                     string  -  "reference to an identifier of another file (transfers.txt, pathways.txt)"
key  to_trip_id                     string  -  "reference to an identifier of another file (transfers.txt)"
key  transfer_type                  int     -  "code from the reference's list (transfers.txt)"
key  traversal_time                 int     -  "integer, more than 0 (pathways.txt)"
key  trip_headsign                  string  -  "text for riders (trips.txt)"
key  trip_id                        string  -  "identifier, unique in its file (trips.txt, stop_times.txt, frequencies.txt, attributions.txt)"
key  trip_short_name                string  -  "text for riders (trips.txt)"
key  tts_stop_name                  string  -  "text for riders (stops.txt)"
key  tuesday                        int     -  "code from the reference's list (calendar.txt)"
key  wednesday                      int     -  "code from the reference's list (calendar.txt)"
key  wheelchair_accessible          int     -  "code from the reference's list (trips.txt)"
key  wheelchair_boarding            int     -  "code from the reference's list (stops.txt)"
key  zone_id                        string  -  "identifier (stops.txt)"
