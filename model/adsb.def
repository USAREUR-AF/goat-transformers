# The adsb module: the fields of a Mode S Extended Squitter (DF17) ADS-B
# message as wire integers. Every key is the unsigned integer in the field's
# bits, most significant bit first. pack.md of the adsb pack states how each
# raw value is read and why it is not converted.
module        adsb
version       0.1.0
distribution  public
source        "Junzi Sun, The 1090 Megahertz Riddle, second edition, TU Delft OPEN Publishing, https://mode-s.org/1090mhz/ (CC BY-NC-SA 4.0); field layouts there are from ICAO Annex 10 Volume IV, ICAO Doc 9871 and RTCA DO-260B"
source        "pyModeS tests (https://github.com/junzis/pyModeS, GPL-3.0): published messages and their decoded values, used as facts"
source        "pyModeS (https://github.com/junzis/pyModeS, GPL-3.0) at commit 4bf083284c0d9878ca0c88f16b9b5f6514ca194a, decoder/adsb.py and decoder/bds/bds30.py, bds61.py: the control field of downlink format 18 and the type code 28 subtype 2 keys, restated; no code copied"
# Frame
key  df                        int  -   "downlink format, 5 bits; 17 in every message this pack decodes"
key  tc                        int  -   "type code, first 5 bits of the ME field"
key  ca                        int  -   "transponder capability, 3 bits"
key  icao                      int  -   "24-bit ICAO aircraft address"
key  parity                    int  -   "24-bit parity / interrogator ID field, carried as received, never computed"
key  reserved                  int  -   "reserved bits of the message kind"
key  reserved2                 int  -   "second run of reserved bits of the message kind"
# Aircraft identification (type codes 1-4)
key  category                  int  -   "aircraft category, 3 bits, read together with the type code"
key  cs_c1                     int  -   "callsign character 1, 6-bit code"
key  cs_c2                     int  -   "callsign character 2, 6-bit code"
key  cs_c3                     int  -   "callsign character 3, 6-bit code"
key  cs_c4                     int  -   "callsign character 4, 6-bit code"
key  cs_c5                     int  -   "callsign character 5, 6-bit code"
key  cs_c6                     int  -   "callsign character 6, 6-bit code"
key  cs_c7                     int  -   "callsign character 7, 6-bit code"
key  cs_c8                     int  -   "callsign character 8, 6-bit code"
# Position (type codes 5-8, 9-18, 20-22)
key  ss                        int  -   "surveillance status (0 none, 1 permanent alert, 2 temporary alert, 3 SPI)"
key  saf                       int  -   "single antenna flag (NIC supplement B in ADS-B version 2)"
key  alt_baro_raw              int  -   "12-bit barometric altitude code including the Q bit"
key  gnss_height_m             int  m   "12-bit GNSS height, whole meters"
key  time_flag                 int  -   "time synchronization bit T"
key  cpr_odd                   int  -   "CPR format: 0 = even frame, 1 = odd frame"
key  cpr_lat                   int  -   "17-bit CPR-encoded latitude"
key  cpr_lon                   int  -   "17-bit CPR-encoded longitude"
key  movement_raw              int  -   "surface movement (ground speed) code, 7 bits, non-linear table"
key  track_valid               int  -   "flag: surface ground track is valid"
key  track_raw                 int  -   "surface ground track, 7 bits, x 360/128 degrees"
# Airborne velocity (type code 19)
key  intent_change             int  -   "intent change flag"
key  ifr                       int  -   "IFR capability flag"
key  nac_v                     int  -   "navigation accuracy category for velocity (NUCr in version 0)"
key  ew_sign                   int  -   "east-west velocity direction: 0 = toward east, 1 = toward west"
key  opstatus_subtype          int  -   "aircraft operational status subtype (type code 31): 0 airborne, 1 surface"
key  velocity_subtype          int  -   "airborne velocity subtype, 1 to 4; 1 and 2 hold ground speed, 3 and 4 airspeed; 2 and 4 are supersonic (speed x 4)"
key  ew_raw                    int  -   "east-west velocity, 10 bits; speed = raw - 1 kt (x 4 in subtype 2); 0 = no information"
key  ns_sign                   int  -   "north-south velocity direction: 0 = toward north, 1 = toward south"
key  ns_raw                    int  -   "north-south velocity, 10 bits; speed = raw - 1 kt (x 4 in subtype 2); 0 = no information"
key  heading_valid             int  -   "flag: magnetic heading is available (subtypes 3-4)"
key  heading_raw               int  -   "magnetic heading, 10 bits, x 360/1024 degrees (subtypes 3-4)"
key  airspeed_true             int  -   "airspeed type: 0 = indicated, 1 = true (subtypes 3-4)"
key  airspeed_raw              int  -   "airspeed, 10 bits; speed = raw - 1 kt (x 4 in subtype 4); 0 = no information"
key  vr_source                 int  -   "vertical rate source: 0 = GNSS, 1 = barometric"
key  vr_sign                   int  -   "vertical rate direction: 0 = up, 1 = down"
key  vr_raw                    int  -   "vertical rate, 9 bits; rate = 64 x (raw - 1) ft/min; 0 = no information"
key  galt_diff_sign            int  -   "GNSS minus barometric altitude sign: 0 = GNSS above, 1 = GNSS below"
key  galt_diff_raw             int  -   "GNSS minus barometric altitude, 7 bits; difference = 25 x (raw - 1) ft; 0 = no information"
# Aircraft status (type code 28, subtype 1)
key  emergency_state           int  -   "emergency / priority status code, 3 bits"
key  squawk_raw                int  -   "13-bit Mode A identity code, bits in the order C1 A1 C2 A2 C4 A4 X B1 D1 B2 D2 B4 D4"
# Target state and status (type code 29, subtype 1)
key  sel_alt_fms               int  -   "selected altitude source: 0 = MCP/FCU, 1 = FMS"
key  sel_alt_raw               int  -   "selected altitude, 11 bits; altitude = 32 x (raw - 1) ft; 0 = no information"
key  baro_setting_raw          int  -   "barometric pressure setting, 9 bits; setting = 800 + 0.8 x (raw - 1) hPa; 0 = no information"
key  sel_heading_valid         int  -   "flag: selected heading is valid"
key  sel_heading_sign          int  -   "selected heading sign bit; 1 adds 180 degrees"
key  sel_heading_raw           int  -   "selected heading, 8 bits, x 180/256 degrees"
key  mode_valid                int  -   "flag: the autopilot mode bits are valid"
key  autopilot                 int  -   "flag: autopilot engaged"
key  vnav                      int  -   "flag: VNAV mode engaged"
key  alt_hold                  int  -   "flag: altitude hold mode engaged"
key  approach                  int  -   "flag: approach mode engaged"
key  tcas_operational          int  -   "flag: TCAS/ACAS operational"
key  lnav                      int  -   "flag: LNAV mode engaged"
# Accuracy and integrity indicators (type codes 29 and 31)
key  nac_p                     int  -   "navigation accuracy category for position, 4 bits"
key  nic_baro                  int  -   "barometric altitude integrity bit"
key  sil                       int  -   "source integrity level, 2 bits"
key  sil_supp                  int  -   "SIL supplement bit"
# Operational status (type code 31)
key  capability_class          int  -   "airborne capability class codes, 16 bits"
key  surface_capability_class  int  -   "surface capability class codes, 12 bits"
key  length_width              int  -   "aircraft length and width code, 4 bits"
key  operational_mode          int  -   "operational mode codes, 16 bits"
key  version                   int  -   "ADS-B version number, 3 bits"
key  nic_supp_a                int  -   "NIC supplement A bit"
key  gva                       int  -   "geometric vertical accuracy, 2 bits (barometric altitude quality in version 1)"
key  track_heading             int  -   "surface: 0 = track angle is reported, 1 = heading is reported"
key  hrd                       int  -   "horizontal reference direction: 0 = true north, 1 = magnetic north"
# Downlink format 18 (pack adsb-df18)
key  cf                        int  -   "DF18 control field, bits 6-8; pyModeS decoder/adsb.py reads it in the place of DF17's capability and does not interpret it"
# Type code 28 subtype 2: ACAS resolution advisory broadcast (pyModeS decoder/bds/bds61.py, bds30.py)
key  ra_active                 int  -   "ACAS resolution advisory: flag, a resolution advisory is active (ME bit 9)"
key  ra_corrective             int  -   "flag: the advisory is corrective (ME bit 10)"
key  ra_downward               int  -   "flag: downward sense (ME bit 11)"
key  ra_increased_rate         int  -   "flag: increased rate (ME bit 12)"
key  ra_sense_reversal         int  -   "flag: sense reversal (ME bit 13)"
key  ra_altitude_crossing      int  -   "flag: altitude crossing (ME bit 14)"
key  ra_positive               int  -   "flag: positive advisory (ME bit 15)"
key  ara_acas3                 int  -   "ME bits 16-22: advisory bits kept for ACAS III, raw"
key  rac_no_below              int  -   "advisory complement flag: do not pass below (ME bit 23)"
key  rac_no_above              int  -   "advisory complement flag: do not pass above (ME bit 24)"
key  rac_no_left               int  -   "advisory complement flag: do not turn left (ME bit 25)"
key  rac_no_right              int  -   "advisory complement flag: do not turn right (ME bit 26)"
key  ra_terminated             int  -   "flag: the advisory has ended (ME bit 27)"
key  multiple_threat           int  -   "flag: more than one threat (ME bit 28)"
key  tti                       int  -   "threat type indicator, ME bits 29-30: 0 no identity, 1 address, 2 altitude, range and bearing; 3 reserved"
key  tid_raw                   int  -   "ME bits 31-56 when the indicator is 0: unused, carried as they are"
key  threat_icao               int  -   "ME bits 31-54 when the indicator is 1: the threat's 24-bit address"
key  threat_alt_code           int  -   "ME bits 31-43 when the indicator is 2: the threat's 13-bit altitude code"
key  threat_range_raw          int  -   "ME bits 44-50 when the indicator is 2: range, (raw - 1) / 10 NM; 0 = not available"
key  threat_bearing_raw        int  -   "ME bits 51-56 when the indicator is 2: bearing, 6 x (raw - 1) + 3 degrees; 0 = not available"
