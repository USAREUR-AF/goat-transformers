# The nhc module: the members of a storm of the NHC Tropical Cyclone Status JSON file
# (CurrentStorms.json) that have no shared key, in the units the file reference states.
# The derive lines convert the movement speed between miles per hour and metres per second
# (1 mph = 0.44704 m/s exactly). packs/nhc-storm/pack.md states the evidence.
module        nhc
version       0.1.0
distribution  public
source        "NHC Tropical Cyclone Status JSON File Reference (last updated 2019-04-08), https://www.nhc.noaa.gov/productexamples/NHC_Tropical_Cyclone_Status_JSON_File_Reference.pdf (US Government work)"
key   bin_number          string  -    "the storm's slot in the basin's set of files: AT1 to AT5 (Atlantic) or EP1 to EP5 (eastern Pacific)"
key   classification      string  -    "storm classification: TD, STD, TS, HU, STS, PTC, TY or PC"
key   latitude_text       string  -    "storm centre latitude as text, with hemisphere letter"
key   longitude_text      string  -    "storm centre longitude as text, with hemisphere letter"
key   movement_speed_mph  float   mph  "storm movement speed, miles per hour"
list  storms                           "the active storms of the file, in order"
key   public_advisory_adv_num  string  -  "advisory number of the latest public advisory (three digits, an optional letter)"
key   public_advisory_issuance  string  -  "issuance time of the latest public advisory, ISO 8601 UTC, as text"
key   public_advisory_url  string  -  "address of the latest public advisory page"
key   forecast_advisory_adv_num  string  -  "advisory number of the latest forecast advisory (three digits, an optional letter)"
key   forecast_advisory_issuance  string  -  "issuance time of the latest forecast advisory, ISO 8601 UTC, as text"
key   forecast_advisory_url  string  -  "address of the latest forecast advisory page"
key   wind_speed_probabilities_adv_num  string  -  "advisory number of the latest wind speed probabilities (three digits, an optional letter)"
key   wind_speed_probabilities_issuance  string  -  "issuance time of the latest wind speed probabilities, ISO 8601 UTC, as text"
key   wind_speed_probabilities_url  string  -  "address of the latest wind speed probabilities page"
key   forecast_discussion_adv_num  string  -  "advisory number of the latest forecast discussion (three digits, an optional letter)"
key   forecast_discussion_issuance  string  -  "issuance time of the latest forecast discussion, ISO 8601 UTC, as text"
key   forecast_discussion_url  string  -  "address of the latest forecast discussion page"
key   forecast_graphics_adv_num  string  -  "advisory number of the latest forecast graphics (three digits, an optional letter)"
key   forecast_graphics_issuance  string  -  "issuance time of the latest forecast graphics, ISO 8601 UTC, as text"
key   forecast_graphics_url  string  -  "address of the latest forecast graphics page"
key   forecast_track_adv_num  string  -  "advisory number of the latest forecast track files"
key   forecast_track_issuance  string  -  "issuance time of the latest forecast track files, ISO 8601 UTC, as text"
key   forecast_track_zip  string  -  "address of the forecast track shapefile ZIP archive"
key   forecast_track_kmz  string  -  "address of the forecast track KMZ file"
key   wind_watches_warnings_adv_num  string  -  "advisory number of the latest wind watches warnings files"
key   wind_watches_warnings_issuance  string  -  "issuance time of the latest wind watches warnings files, ISO 8601 UTC, as text"
key   wind_watches_warnings_zip  string  -  "address of the wind watches warnings shapefile ZIP archive"
key   wind_watches_warnings_kmz  string  -  "address of the wind watches warnings KMZ file"
key   track_cone_adv_num  string  -  "advisory number of the latest track cone files"
key   track_cone_issuance  string  -  "issuance time of the latest track cone files, ISO 8601 UTC, as text"
key   track_cone_zip  string  -  "address of the track cone shapefile ZIP archive"
key   track_cone_kmz  string  -  "address of the track cone KMZ file"
key   initial_wind_extent_adv_num  string  -  "advisory number of the latest initial wind extent files"
key   initial_wind_extent_issuance  string  -  "issuance time of the latest initial wind extent files, ISO 8601 UTC, as text"
key   initial_wind_extent_zip  string  -  "address of the initial wind extent shapefile ZIP archive"
key   initial_wind_extent_kmz  string  -  "address of the initial wind extent KMZ file"
key   forecast_wind_radii_adv_num  string  -  "advisory number of the latest forecast wind radii files"
key   forecast_wind_radii_issuance  string  -  "issuance time of the latest forecast wind radii files, ISO 8601 UTC, as text"
key   forecast_wind_radii_zip  string  -  "address of the forecast wind radii shapefile ZIP archive"
key   forecast_wind_radii_kmz  string  -  "address of the forecast wind radii KMZ file"
key   best_track_zip  string  -  "address of the best track shapefile ZIP archive"
key   best_track_kmz  string  -  "address of the best track KMZ file"
key   earliest_arrival_ts_winds_adv_num  string  -  "advisory number of the latest earliest arrival ts winds arrival-time file"
key   earliest_arrival_ts_winds_issuance  string  -  "issuance time of the latest earliest arrival ts winds arrival-time file, as text"
key   earliest_arrival_ts_winds_kmz  string  -  "address of the earliest arrival ts winds arrival-time KMZ file"
key   most_likely_ts_winds_adv_num  string  -  "advisory number of the latest most likely ts winds arrival-time file"
key   most_likely_ts_winds_issuance  string  -  "issuance time of the latest most likely ts winds arrival-time file, as text"
key   most_likely_ts_winds_kmz  string  -  "address of the most likely ts winds arrival-time KMZ file"
key   wsp_gis_issuance    string  -    "issuance time of the wind speed probabilities GIS files, as text"
key   wsp_gis_zip_5km     string  -    "address of the 5 km wind speed probabilities ZIP archive"
key   wsp_gis_zip_0p5deg  string  -    "address of the 0.5 degree wind speed probabilities ZIP archive"
key   wsp_gis_kmz_34kt    string  -    "address of the 34-knot wind speed probabilities KMZ file"
key   wsp_gis_kmz_50kt    string  -    "address of the 50-knot wind speed probabilities KMZ file"
key   wsp_gis_kmz_64kt    string  -    "address of the 64-knot wind speed probabilities KMZ file"
derive  speed_ms            scale:1609344/3600000  nhc.movement_speed_mph
derive  nhc.movement_speed_mph  scale:3600000/1609344  speed_ms
