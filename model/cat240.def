# The cat240 module: the values of ASTERIX Category 240 (Radar Video Transmission), edition 1.3,
# as the category holds them. Used by the pack `asterix-cat240`. Generated by
# tools/gen/asterix2pack.py; do not edit by hand. A key is named after its item
# and subitems; a repetitive item is a list and its keys are the keys of one
# repetition.
module        cat240
version       0.1.0
distribution  public
source        "ASTERIX Category 240, Radar Video Transmission, edition 1.3 (2015-05-13), as transcribed in github.com/zoranbosnjak/asterix-specs (BSD-3-Clause), commit 64e9ffba964b92a1af3157bc6bdf7852a63bf700, specs/cat240/cats/cat1.3/definition.json. The category is specified by EUROCONTROL"
key   i010_sac      int     -       "I240/010/SAC: System Area Code (Data Source Identifier)"
key   i010_sic      int     -       "I240/010/SIC: System Identification Code (Data Source Identifier)"
key   i000          int     -       "I240/000: Message Type. 1 = Video Summary message, 2 = Video message"
key   i020          int     -       "I240/020: Video Record Header"
list  i030          "I240/030: Video Summary, one item per repetition"
key   i030_val      string  -       "I240/030: Video Summary. 1 ASCII characters"
key   i040_startaz  float   deg     "I240/040/STARTAZ: Start Azimuth of the Cells Group (Video Header Nano). LSB 45/8192 deg"
key   i040_endaz    float   deg     "I240/040/ENDAZ: End Azimuth of the Cells Group (Video Header Nano). LSB 45/8192 deg"
key   i040_startrg  int     -       "I240/040/STARTRG: Starting Range of the Cells Group, Expressed in Number of Cells (Video Header Nano)"
key   i040_celldur  float   ns      "I240/040/CELLDUR: Video Cell Duration in Nano-seconds (Video Header Nano). LSB 1 ns"
key   i041_startaz  float   deg     "I240/041/STARTAZ: Start Azimuth of the Cells Group (Video Header Femto). LSB 45/8192 deg"
key   i041_endaz    float   deg     "I240/041/ENDAZ: End Azimuth of the Cells Group (Video Header Femto). LSB 45/8192 deg"
key   i041_startrg  int     -       "I240/041/STARTRG: Starting Range of the Cells Group, Expressed in Number of Cells (Video Header Femto)"
key   i041_celldur  float   fs      "I240/041/CELLDUR: Video Cell Duration in Femto-seconds (Video Header Femto). LSB 1 fs"
key   i048_c        int     -       "I240/048/C: Data Compression Indicator (Video Cells Resolution & Data Compression Indicator). 0 = No compression applied, 1 = Compression applied"
key   i048_res      int     -       "I240/048/RES: Bit Resolution (Video Cells Resolution & Data Compression Indicator). 1 = Monobit Resolution (1 bit), 2 = Low Resolution (2 bits), 3 = Medium Resolution (4 bits), 4 = High Resolution (8 bits), 5 = Very High Resolution (16 bits), 6 = Ultra High Resolution (32 bits)"
key   i049_nbvb     int     -       "I240/049/NBVB: Number of 'valid' Octets (Video Octets & Video Cells Counters)"
key   i049_nbcells  int     -       "I240/049/NBCELLS: Number of 'valid' Cells (Video Octets & Video Cells Counters)"
list  i050          "I240/050: Video Block Low Data Volume, one item per repetition"
key   i050_val      int     -       "I240/050: Video Block Low Data Volume"
key   i140          float   s       "I240/140: Time of Day. LSB 1/128 s"
# Derived keys (engine-spec 0.6 and 0.8), applied by `convert` between decode and encode.
derive  cat240.i140  day_seconds  time_ms
