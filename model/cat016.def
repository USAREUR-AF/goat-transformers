# The cat016 module: the values of ASTERIX Category 016 (Independent Non-Cooperative Surveillance System Configuration Reports), edition 1.0,
# as the category holds them. Used by the pack `asterix-cat016`. Generated by
# tools/gen/asterix2pack.py; do not edit by hand. A key is named after its item
# and subitems; a repetitive item is a list and its keys are the keys of one
# repetition.
module        cat016
version       0.1.0
distribution  public
source        "ASTERIX Category 016, Independent Non-Cooperative Surveillance System Configuration Reports, edition 1.0 (2019-07-15), as transcribed in github.com/zoranbosnjak/asterix-specs (BSD-3-Clause), commit 64e9ffba964b92a1af3157bc6bdf7852a63bf700, specs/cat016/cats/cat1.0/definition.json. The category is specified by EUROCONTROL"
key   i010_sac  int     -       "I016/010/SAC: System Area Code (Data Source Identifier)"
key   i010_sic  int     -       "I016/010/SIC: System Identification Code (Data Source Identifier)"
key   i015      int     -       "I016/015: Service Identification"
key   i000      int     -       "I016/000: Message Type. 1 = System Configuration, 2 = Transmitter / Receiver Configuration"
key   i140      float   s       "I016/140: Time of Day. LSB 1/128 s"
key   i200      float   s       "I016/200: System Configuration Reporting Period. LSB 1 s"
list  i300      "I016/300: Pair Identification, one item per repetition"
key   i300_pid  int     -       "I016/300/PID: Pair Identification (Pair Identification)"
key   i300_tid  int     -       "I016/300/TID: Transmitter Identification (Pair Identification)"
key   i300_rid  int     -       "I016/300/RID: Receiver Identification (Pair Identification)"
key   i400_lat  float   deg     "I016/400/LAT: Latitude (Position of the System Reference Point). LSB 45/536870912 deg"
key   i400_lon  float   deg     "I016/400/LON: Longitude (Position of the System Reference Point). LSB 45/536870912 deg"
key   i405      float   m       "I016/405: Height of System Reference Point. LSB 1/4 m"
list  i410      "I016/410: Transmitter Properties, one item per repetition"
key   i410_tid  int     -       "I016/410/TID: Transmitter ID (Transmitter Properties)"
key   i410_lat  float   deg     "I016/410/LAT: Latitude (Transmitter Properties). LSB 45/536870912 deg"
key   i410_lon  float   deg     "I016/410/LON: Longitude (Transmitter Properties). LSB 45/536870912 deg"
key   i410_alt  float   m       "I016/410/ALT: Altitude (Transmitter Properties). LSB 1/4 m"
key   i410_tto  float   ns      "I016/410/TTO: Transmission Time Offset (Transmitter Properties). LSB 2 ns"
key   i410_ato  float   ns      "I016/410/ATO: Accuracy of Transmission Time Offset (Transmitter Properties). LSB 1 ns"
key   i410_pci  int     -       "I016/410/PCI: Parallel Transmitter Index (Transmitter Properties)"
list  i420      "I016/420: Receiver Properties, one item per repetition"
key   i420_rid  int     -       "I016/420/RID: Receiver Component ID (Receiver Properties)"
key   i420_lat  float   deg     "I016/420/LAT: Latitude (Receiver Properties). LSB 45/536870912 deg"
key   i420_lon  float   deg     "I016/420/LON: Longitude (Receiver Properties). LSB 45/536870912 deg"
key   i420_alt  float   m       "I016/420/ALT: Altitude (Receiver Properties). LSB 1/4 m"
# Derived keys (engine-spec 0.6 and 0.8), applied by `convert` between decode and encode.
derive  cat016.i140  day_seconds  time_ms
