# The grib2 module: the fields of a GRIB edition 2 message that the grib2 pack reads, as the
# message holds them. Signed fields (sign and magnitude, WMO regulation 92.1.5) are integers.
module        grib2
version       0.1.0
distribution  public
source        "WMO GRIB2 templates (wmo-im/GRIB2, MIT) and ecCodes section definitions (Apache-2.0); restated by goat-transformers"
key   reserved                              int    -    "section 0: reserved octets"
key   discipline                            int    -    "section 0: discipline of the data (code table 0.0: 0 meteorological, 10 oceanographic, ...)"
list  sections                                          "sections 1 to 7 of the message, in order, and section 8 as the last item (kind end)"
key   section_number                        int    -    "number of a section, 1 to 7"
list  section_octets                                    "octets of a section the pack does not read field by field (local use, other templates, a template's optional list, the bitmap, the packed data)"
key   octet                                 int    -    "one octet"
key   centre                                int    -    "section 1: originating centre (common code table C-11)"
key   sub_centre                            int    -    "section 1: originating sub-centre"
key   tables_version                        int    -    "section 1: version of the master tables"
key   local_tables_version                  int    -    "section 1: version of the local tables"
key   significance_of_reference_time        int    -    "section 1: what the reference time is (code table 1.2: 0 analysis, 1 start of forecast, ...)"
key   year                                  int    -    "section 1: reference time, year (the six parts are not composed into time_ms: pack.md)"
key   month                                 int    -    "section 1: reference time, month"
key   day                                   int    -    "section 1: reference time, day"
key   hour                                  int    -    "section 1: reference time, hour"
key   minute                                int    -    "section 1: reference time, minute"
key   second                                int    -    "section 1: reference time, second"
key   production_status                     int    -    "section 1: production status of the data (code table 1.3)"
key   type_of_data                          int    -    "section 1: type of processed data (code table 1.4)"
key   source_of_grid_definition             int    -    "section 3: source of the grid definition (code table 3.0)"
key   number_of_data_points                 int    -    "section 3: number of data points"
key   octets_for_number_of_points           int    -    "section 3: octets of each entry of the optional list of numbers of points"
key   interpretation_of_number_of_points    int    -    "section 3: interpretation of that list (code table 3.11)"
key   grid_template                         int    -    "section 3: grid definition template number (code table 3.1: 0 latitude/longitude, ...)"
key   shape_of_earth                        int    -    "template 3.0: shape of the Earth (code table 3.2)"
key   scale_factor_of_radius                int    -    "template 3.0: scale factor of the radius of a spherical Earth"
key   scaled_value_of_radius                int    -    "template 3.0: scaled value of that radius"
key   scale_factor_of_major_axis            int    -    "template 3.0: scale factor of the major axis of an oblate spheroid Earth"
key   scaled_value_of_major_axis            int    -    "template 3.0: scaled value of that axis"
key   scale_factor_of_minor_axis            int    -    "template 3.0: scale factor of the minor axis"
key   scaled_value_of_minor_axis            int    -    "template 3.0: scaled value of that axis"
key   ni                                    int    -    "template 3.0: number of points along a parallel"
key   nj                                    int    -    "template 3.0: number of points along a meridian"
key   basic_angle                           int    -    "template 3.0: basic angle of the production domain (0 for the usual unit of 1e-6 degree)"
key   subdivisions_of_basic_angle           int    -    "template 3.0: subdivisions of the basic angle (all bits set for the usual unit)"
key   la1                                   int    -    "template 3.0: latitude of the first grid point, in the unit basic angle / subdivisions (1e-6 degree usually)"
key   lo1                                   int    -    "template 3.0: longitude of the first grid point, in that unit"
key   resolution_flags                      int    -    "template 3.0: resolution and component flags (flag table 3.3)"
key   la2                                   int    -    "template 3.0: latitude of the last grid point, in that unit"
key   lo2                                   int    -    "template 3.0: longitude of the last grid point, in that unit"
key   di                                    int    -    "template 3.0: i direction increment, in that unit"
key   dj                                    int    -    "template 3.0: j direction increment, in that unit"
key   scanning_mode                         int    -    "template 3.0: scanning mode (flag table 3.4)"
key   number_of_coordinate_values           int    -    "section 4: number of coordinate values after the template"
key   product_template                      int    -    "section 4: product definition template number (code table 4.0)"
key   parameter_category                    int    -    "template 4.0: parameter category (code table 4.1)"
key   parameter_number                      int    -    "template 4.0: parameter number (code table 4.2)"
key   type_of_generating_process            int    -    "template 4.0: type of generating process (code table 4.3)"
key   background_process                    int    -    "template 4.0: background generating process identifier, defined by the centre"
key   generating_process_identifier         int    -    "template 4.0: analysis or forecast generating process identifier, defined by the centre"
key   hours_after_cutoff                    int    h    "template 4.0: hours of observational data cut-off after the reference time"
key   minutes_after_cutoff                  int    min  "template 4.0: minutes of that cut-off"
key   unit_of_time_range                    int    -    "template 4.0: unit of the forecast time (code table 4.4)"
key   forecast_time                         int    -    "template 4.0: forecast time, in that unit"
key   type_of_first_surface                 int    -    "template 4.0: type of the first fixed surface (code table 4.5)"
key   scale_factor_of_first_surface         int    -    "template 4.0: scale factor of the first fixed surface"
key   scaled_value_of_first_surface         int    -    "template 4.0: scaled value of the first fixed surface"
key   type_of_second_surface                int    -    "template 4.0: type of the second fixed surface"
key   scale_factor_of_second_surface        int    -    "template 4.0: scale factor of the second fixed surface"
key   scaled_value_of_second_surface        int    -    "template 4.0: scaled value of the second fixed surface"
key   number_of_values                      int    -    "section 5: number of data points with values"
key   data_template                         int    -    "section 5: data representation template number (code table 5.0)"
key   reference_value                       float  -    "template 5.0: reference value R, an IEEE single"
key   binary_scale_factor                   int    -    "template 5.0: binary scale factor E"
key   decimal_scale_factor                  int    -    "template 5.0: decimal scale factor D"
key   bits_per_value                        int    -    "template 5.0: bits used for each packed value"
key   type_of_original_values               int    -    "template 5.0: type of the original values (code table 5.1)"
key   bitmap_indicator                      int    -    "section 6: bitmap indicator (code table 6.0: 255 no bitmap)"
