# The cat019 module: the values of ASTERIX Category 019 (Multilateration System Status Messages), edition 1.3,
# as the category holds them. Used by the pack `asterix-cat019`. Generated by
# tools/gen/asterix2pack.py; do not edit by hand. A key is named after its item
# and subitems; a repetitive item is a list and its keys are the keys of one
# repetition.
module        cat019
version       0.1.0
distribution  public
source        "ASTERIX Category 019, Multilateration System Status Messages, edition 1.3 (2010-12-01), as transcribed in github.com/zoranbosnjak/asterix-specs (BSD-3-Clause), commit 64e9ffba964b92a1af3157bc6bdf7852a63bf700, specs/cat019/cats/cat1.3/definition.json. The category is specified by EUROCONTROL"
key   i010_sac     int     -       "I019/010/SAC: System Area Code (Data Source Identifier)"
key   i010_sic     int     -       "I019/010/SIC: System Identification Code (Data Source Identifier)"
key   i000         int     -       "I019/000: Message Type. 1 = Start of Update Cycle, 2 = Periodic Status Message, 3 = Event-triggered Status Message"
key   i140         float   s       "I019/140: Time of Day. LSB 1/128 s"
key   i550_nogo    int     -       "I019/550/NOGO: Operational Release Status of the System (System Status). 0 = Operational, 1 = Degraded, 2 = NOGO, 3 = Undefined"
key   i550_ovl     int     -       "I019/550/OVL: Overload Indicator (System Status). 0 = No overload, 1 = Overload"
key   i550_tsv     int     -       "I019/550/TSV: Time Source Validity (System Status). 0 = Valid, 1 = Invalid"
key   i550_ttf     int     -       "I019/550/TTF: Test Target (System Status). 0 = Test Target Operative, 1 = Test Target Failure"
key   i551_tp1a    int     -       "I019/551/TP1A (Tracking Processor Detailed Status). 0 = Standby, 1 = Exec"
key   i551_tp1b    int     -       "I019/551/TP1B (Tracking Processor Detailed Status). 0 = Faulted, 1 = Good"
key   i551_tp2a    int     -       "I019/551/TP2A (Tracking Processor Detailed Status). 0 = Standby, 1 = Exec"
key   i551_tp2b    int     -       "I019/551/TP2B (Tracking Processor Detailed Status). 0 = Faulted, 1 = Good"
key   i551_tp3a    int     -       "I019/551/TP3A (Tracking Processor Detailed Status). 0 = Standby, 1 = Exec"
key   i551_tp3b    int     -       "I019/551/TP3B (Tracking Processor Detailed Status). 0 = Faulted, 1 = Good"
key   i551_tp4a    int     -       "I019/551/TP4A (Tracking Processor Detailed Status). 0 = Standby, 1 = Exec"
key   i551_tp4b    int     -       "I019/551/TP4B (Tracking Processor Detailed Status). 0 = Faulted, 1 = Good"
list  i552         "I019/552: Remote Sensor Detailed Status, one item per repetition"
key   i552_rsi     int     -       "I019/552/RSI: 8-bit Identification Number of RS (Remote Sensor Detailed Status)"
key   i552_rs1090  int     -       "I019/552/RS1090: Receiver 1090 MHz (Remote Sensor Detailed Status). 0 = Not present, 1 = Present"
key   i552_tx1030  int     -       "I019/552/TX1030: Transmitter 1030 MHz (Remote Sensor Detailed Status). 0 = Not present, 1 = Present"
key   i552_tx1090  int     -       "I019/552/TX1090: Transmitter 1090 MHz (Remote Sensor Detailed Status). 0 = Not present, 1 = Present"
key   i552_rss     int     -       "I019/552/RSS: RS Status (Remote Sensor Detailed Status). 0 = Faulted, 1 = Good"
key   i552_rso     int     -       "I019/552/RSO: RS Operational (Remote Sensor Detailed Status). 0 = Offline, 1 = Online"
key   i553_reftr1  int     -       "I019/553/REFTR1: Ref Trans 1 Status (Reference Transponder Detailed Status). 1 = Warning, 2 = Faulted, 3 = Good"
key   i553_reftr2  int     -       "I019/553/REFTR2: Ref Trans 2 Status (Reference Transponder Detailed Status). 1 = Warning, 2 = Faulted, 3 = Good"
key   i553_reftr3  int     -       "I019/553/REFTR3: Ref Trans 3 Status (Reference Transponder Detailed Status). 1 = Warning, 2 = Faulted, 3 = Good"
key   i553_reftr4  int     -       "I019/553/REFTR4: Ref Trans 4 Status (Reference Transponder Detailed Status). 1 = Warning, 2 = Faulted, 3 = Good"
key   i600_lat     float   deg     "I019/600/LAT: Latitude (Position of the MLT System Reference Point). LSB 45/268435456 deg"
key   i600_lon     float   deg     "I019/600/LON: Longitude (Position of the MLT System Reference Point). LSB 45/268435456 deg"
key   i610         float   m       "I019/610: Height of the MLT System Reference Point. LSB 1/4 m"
key   i620         float   m       "I019/620: WGS-84 Undulation. LSB 1 m"
# Derived keys (engine-spec 0.6 and 0.8), applied by `convert` between decode and encode.
derive  cat019.i140  day_seconds  time_ms
