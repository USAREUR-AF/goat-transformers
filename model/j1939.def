# The j1939 module: SAE J1939 identifier and data fields. Written by tools/gen/j1939-pack.py.
module        j1939
version       0.1.0
distribution  public
source        "Linux kernel at commit c44104f3642da720164042623e4832836aefdd8e: Documentation/networking/j1939.rst (GPL-2.0 OR MIT) and include/uapi/linux/can.h (GPL-2.0-only WITH Linux-syscall-note OR BSD-3-Clause); python-can-j1939, https://github.com/juergenH87/python-can-j1939 at commit 01aba95cca43847bc272ec7ddb12048f587e6554, j1939/message_id.py, name.py, j1939_21.py, controller_application.py, diagnostic_messages.py (MIT License, Copyright (c) 2018 Frank Benkert); layouts restated, no code copied; SAE J1939 not used"
key   source_address                  int     -  "SA: the sender's address (254 null, 255 global)"
key   pdu_specific                    int     -  "PS: with PF below 240 (PDU1) the destination address, not part of the PGN; with PF 240 and above (PDU2) the group extension, part of the PGN"
key   pdu_format                      int     -  "PF: the PDU format"
key   data_page                       int     -  "DP: the data page bit of the PGN"
key   extended_data_page              int     -  "EDP: the extended data page (reserved) bit of the PGN"
key   priority                        int     -  "priority, 3 bits, as sent"
key   can_err_flag                    int     -  "SocketCAN can_id bit 29, error frame (0)"
key   can_rtr_flag                    int     -  "SocketCAN can_id bit 30, remote transmission request (0)"
key   can_eff_flag                    int     -  "SocketCAN can_id bit 31, extended frame format (1 for J1939)"
key   requested_pgn                   int     -  "Request (PGN 59904): the requested PGN"
key   name_identity_number            int     -  "Address Claimed (PGN 60928) NAME: identity number, 21 bits"
key   name_manufacturer_code          int     -  "NAME: manufacturer code, 11 bits"
key   name_ecu_instance               int     -  "NAME: ECU instance, 3 bits"
key   name_function_instance          int     -  "NAME: function instance, 5 bits"
key   name_function                   int     -  "NAME: function, 8 bits"
key   name_reserved                   int     -  "NAME: the reserved bit"
key   name_vehicle_system             int     -  "NAME: vehicle system, 7 bits"
key   name_vehicle_system_instance    int     -  "NAME: vehicle system instance, 4 bits"
key   name_industry_group             int     -  "NAME: industry group, 3 bits"
key   name_arbitrary_address_capable  int     -  "NAME: arbitrary address capable, 1 bit"
key   tp_control                      int     -  "TP.CM (PGN 60416): control byte, 16 RTS, 17 CTS, 19 end of message ACK, 32 BAM, 255 connection abort"
key   tp_message_size                 int     -  "TP.CM RTS, EOMA, BAM: the message size in octets"
key   tp_total_packets                int     -  "TP.CM RTS, EOMA, BAM: the number of packets"
key   tp_max_packets                  int     -  "TP.CM RTS: the maximum number of packets in response to one CTS"
key   tp_packets                      int     -  "TP.CM CTS: the number of packets that can be sent"
key   tp_next_packet                  int     -  "TP.CM CTS: the next packet number to send"
key   tp_abort_reason                 int     -  "TP.CM Abort: the reason (1 busy, 2 resources, 3 timeout ...)"
key   tp_reserved                     int     -  "TP.CM: the reserved octets of the control's layout (0xFF fill), as one integer"
key   tp_control_bytes                int     -  "TP.CM with another control byte: octets 2 to 5, as one integer"
key   tp_pgn                          int     -  "TP.CM: the PGN of the transported message"
key   tp_sequence_number              int     -  "TP.DT (PGN 60160): which packet of the transfer this is, numbered from 1"
key   ack_control                     int     -  "Acknowledgement (PGN 59392): control byte, code as sent"
key   ack_group_function              int     -  "Acknowledgement: group function value"
key   ack_reserved                    int     -  "Acknowledgement: two reserved octets (0xFF), as one integer"
key   ack_address                     int     -  "Acknowledgement: the address acknowledged"
key   ack_pgn                         int     -  "Acknowledgement: the PGN acknowledged"
key   protect_lamp                    int     -  "DM1 (PGN 65226): protect lamp status (0 off, 1 on, 3 not available)"
key   amber_warning_lamp              int     -  "DM1: amber warning lamp status"
key   red_stop_lamp                   int     -  "DM1: red stop lamp status"
key   malfunction_lamp                int     -  "DM1: malfunction indicator lamp status"
key   protect_lamp_flash              int     -  "DM1: protect lamp flash (0 slow, 1 fast, 3 none or not available)"
key   amber_warning_lamp_flash        int     -  "DM1: amber warning lamp flash"
key   red_stop_lamp_flash             int     -  "DM1: red stop lamp flash"
key   malfunction_lamp_flash          int     -  "DM1: malfunction indicator lamp flash"
list  dtcs                            "DM1: the diagnostic trouble codes, four octets each; an item whose low SPN octets are 0xFFFF is read as two octets alone (the padding of a one-DTC frame)"
key   spn_low                         int     -  "DTC: the low 16 bits of the SPN"
key   fmi                             int     -  "DTC: failure mode identifier, 5 bits"
key   spn_high                        int     -  "DTC: the high 3 bits of the SPN (SPN = spn_high x 65536 + spn_low)"
key   occurrence_count                int     -  "DTC: occurrence count, 7 bits"
key   spn_conversion_method           int     -  "DTC: SPN conversion method bit (a set bit is a deprecated method)"
list  data                            "the data of another PGN, or a TP.DT packet's seven data octets, as octets"
key   octet                           int     -  "one octet"
