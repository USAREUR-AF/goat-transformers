# The cat017 module: the values of ASTERIX Category 017 (Mode S Surveillance Coordination Function Messages), edition 1.3,
# as the category holds them. Used by the pack `asterix-cat017`. Generated by
# tools/gen/asterix2pack.py; do not edit by hand. A key is named after its item
# and subitems; a repetitive item is a list and its keys are the keys of one
# repetition.
module        cat017
version       0.1.0
distribution  public
source        "ASTERIX Category 017, Mode S Surveillance Coordination Function Messages, edition 1.3 (2009-01-01), as transcribed in github.com/zoranbosnjak/asterix-specs (BSD-3-Clause), commit 64e9ffba964b92a1af3157bc6bdf7852a63bf700, specs/cat017/cats/cat1.3/definition.json. The category is specified by EUROCONTROL"
key   i010_sac     int     -       "I017/010/SAC: System Area Code (Data Source Identifier)"
key   i010_sic     int     -       "I017/010/SIC: System Identification Code (Data Source Identifier)"
key   i012_sac     int     -       "I017/012/SAC: System Area Code (Data Destination Identifier)"
key   i012_sic     int     -       "I017/012/SIC: System Identification Code (Data Destination Identifier)"
key   i000         int     -       "I017/000: Message Type. 0 = Network information, 10 = Track data, 20 = Track data request, 21 = Track data stop, 22 = Cancel track data request, 23 = Track data stop acknowledgement, 30 = New Node / Change-over Initial or intermediate message segment, 31 = New Node / Change-over Final or only message segment, 32 = New Node / Change-over Initial or intermediate message segment reply, 33 = New No..."
list  i350         "I017/350: Cluster Station/Node List, one item per repetition"
key   i350_sac     int     -       "I017/350/SAC: System Area Code (Cluster Station/Node List)"
key   i350_sic     int     -       "I017/350/SIC: System Identification Code (Cluster Station/Node List)"
key   i220         int     -       "I017/220: Aircraft Address"
key   i221         int     -       "I017/221: Duplicate Address Reference Number (DRN)"
key   i140         float   s       "I017/140: Time of Day. LSB 1/128 s"
key   i045_lat     float   deg     "I017/045/LAT: Latitude (Calculated Position in WGS-84 Coordinates). LSB 45/8388608 deg"
key   i045_lon     float   deg     "I017/045/LON: Longitude (Calculated Position in WGS-84 Coordinates). LSB 45/8388608 deg"
key   i070_v       int     -       "I017/070/V (Mode 3/A Code in Octal Representation). 0 = Code validated, 1 = Code not validated"
key   i070_g       int     -       "I017/070/G (Mode 3/A Code in Octal Representation). 0 = Default, 1 = Garbled code"
key   i070_l       int     -       "I017/070/L (Mode 3/A Code in Octal Representation). 0 = Mode-3/A code derived from the reply of the transponder, 1 = Smoothed Mode-3/A code not extracted during the last scan"
key   i070_mode3a  int     -       "I017/070/MODE3A: Mode 3/A Reply in Octal Representation (Mode 3/A Code in Octal Representation). raw value: 4 octal digits of 3 bits each"
key   i050_v       int     -       "I017/050/V (Flight Level in Binary Representation). 0 = Code validated, 1 = Code not validated"
key   i050_g       int     -       "I017/050/G (Flight Level in Binary Representation). 0 = Default, 1 = Garbled code / Error correction applied"
key   i050_alt     float   FL      "I017/050/ALT: Altitude (Flight Level in Binary Representation). LSB 1/4 FL"
key   i200_hdg     float   deg     "I017/200/HDG: Calculated Heading (Track Velocity in Polar Co-ordinates). LSB 45/8192 deg"
key   i230_ca      int     -       "I017/230/CA: Communications Capability of the Transponder (Transponder Capability). 0 = No communications capability (surveillance only), no ability to set CA code 7 either airborne or on the ground, 1 = Reserved, 2 = Reserved, 3 = Reserved, 4 = At Least Comm. A and Comm. B capability and the ability to set CA code 7 and on the ground, 5 = At Least Comm. A and Comm. B capability and the ability..."
key   i230_si      int     -       "I017/230/SI: SI/II-capabilities of the Transponder (Transponder Capability). 0 = Transponder SI capable, 1 = Transponder not SI capable"
key   i240_cst     int     -       "I017/240/CST: Track Coasted (Track Status). 0 = Measured position, 1 = No measured position (coasted)"
key   i240_flt     int     -       "I017/240/FLT: Flight Level Tracking (Track Status). 0 = Last Measured Flight Level, 1 = Predicted Flight Level"
list  i210         "I017/210: Mode S Address List, one item per repetition"
key   i210_val     int     -       "I017/210: Mode S Address List"
key   i360         int     -       "I017/360: Cluster Controller Command State"
# Derived keys (engine-spec 0.6 and 0.8), applied by `convert` between decode and encode.
derive  cat017.i140  day_seconds  time_ms
