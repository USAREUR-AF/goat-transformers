# The igsssr module: the fields of IGS SSR v1.00 messages. Generated by tools/gen/igsssr2pack.py.
module        igsssr
version       0.1.0
distribution  public
source        "IGS State Space Representation (SSR) Format, Version 1.00, International GNSS Service, 2020-10-05, https://files.igs.org/pub/data/format/igs_ssr_v1.pdf; no licence stated: LicenseRef-unstated"
key  version  int  -  "IDF001 IGS SSR version: 1 to 6"
key  epoch_s  int  s  "IDF003 SSR epoch time: full seconds since the start of the GPS week (of the day for GLONASS, which also counts in UTC); the week is not in the message"
key  update_interval  int  -  "IDF004 SSR update interval code: 0 1 s, 1 2 s, 2 5 s, 3 10 s, 4 15 s, 5 30 s, 6 60 s, 7 120 s, 8 240 s, 9 300 s, 10 600 s, 11 900 s, 12 1800 s, 13 3600 s, 14 7200 s, 15 10800 s"
key  multiple_message  int  -  "IDF005 multiple message indicator: 1 when more messages of the same number and epoch follow"
key  iod_ssr  int  -  "IDF007 issue of data SSR: changes when the generating configuration changes"
key  provider_id  int  -  "IDF008 SSR provider ID, assigned by RTCM"
key  solution_id  int  -  "IDF009 SSR solution ID of the provider"
key  regional_crs  int  -  "IDF006 orbit reference: 0 ITRF, 1 a regional frame"
key  dispersive_consistent  int  -  "IDF032 dispersive bias consistency indicator"
key  mw_consistent  int  -  "IDF033 Melbourne-Wubbena consistency indicator"
key  vtec_quality  float  TECU  "IDF041 VTEC quality indicator, 0.05 TECU steps; 0 unknown"
key  layer_count  int  -  "IDF035 number of ionospheric layers minus 1"
key  sat_id  int  -  "IDF011 GNSS satellite ID (PRN; the slot number for GLONASS)"
key  iod  int  -  "IDF012 GNSS IOD: the issue of data of the broadcast ephemeris the correction applies to"
key  radial_m  float  m  "IDF013 radial orbit correction to the broadcast ephemeris, 0.1 mm steps"
key  along_m  float  m  "IDF014 along-track orbit correction, 0.4 mm steps"
key  cross_m  float  m  "IDF015 cross-track orbit correction, 0.4 mm steps"
key  dot_radial_ms  float  m/s  "IDF016 rate of the radial orbit correction, 0.001 mm/s steps"
key  dot_along_ms  float  m/s  "IDF017 rate of the along-track orbit correction, 0.004 mm/s steps"
key  dot_cross_ms  float  m/s  "IDF018 rate of the cross-track orbit correction, 0.004 mm/s steps"
key  clock_c0_m  float  m  "IDF019 C0 coefficient of the clock correction to the broadcast clock, 0.1 mm steps"
key  clock_c1_ms  float  m/s  "IDF020 C1 coefficient, 0.001 mm/s steps"
key  clock_c2_mss  float  m/s^2  "IDF021 C2 coefficient, 0.00002 mm/s^2 steps"
key  hr_clock_m  float  m  "IDF022 high rate clock correction, added to the polynomial clock correction, 0.1 mm steps"
key  signal_id  int  -  "IDF024 GNSS signal and tracking mode identifier (a table per GNSS)"
key  code_bias_m  float  m  "IDF025 code bias for the signal, 0.01 m steps"
key  yaw_deg  float  deg  "IDF026 yaw angle for the phase wind-up correction, 1/256 semicircle steps (degrees here)"
key  yaw_rate_degs  float  deg/s  "IDF027 yaw rate, 1/8192 semicircle per second steps (degrees per second here)"
key  integer_indicator  int  -  "IDF029 signal integer indicator: 1 when the phase bias has the integer property"
key  widelane_indicator  int  -  "IDF030 signals wide-lane integer indicator"
key  discontinuity  int  -  "IDF031 signal discontinuity counter"
key  phase_bias_m  float  m  "IDF028 phase bias for the signal, 0.1 mm steps"
key  ura  int  -  "IDF034 SSR URA: a 3-bit class and a 3-bit value, as the document defines them"
list orbit_sats  "the satellites of a orbit message, one item each"
list clock_sats  "the satellites of a clock message, one item each"
list orbit_clock_sats  "the satellites of a orbit clock message, one item each"
list hr_clock_sats  "the satellites of a hr clock message, one item each"
list code_bias_sats  "the satellites of a code bias message, one item each"
list phase_bias_sats  "the satellites of a phase bias message, one item each"
list ura_sats  "the satellites of a ura message, one item each"
list biases  "the code or phase biases of one satellite, one item per signal"
