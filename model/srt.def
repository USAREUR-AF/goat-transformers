# The srt module: the fields of SRT packets (draft-sharabayko-srt-01). Written by tools/gen/media-pack.py.
module        srt
version       0.1.0
distribution  public
source        "IETF draft-sharabayko-srt-01; restated by goat-transformers"
key   packet_seq            int     -  "data: packet sequence number, 31 bits"
key   position              int     -  "data: PP, the packet's place in its message: 2 first, 0 middle, 1 last, 3 a single packet"
key   in_order              int     -  "data: O, 1 when the message must be delivered in order"
key   key_flags             int     -  "data: KK, 0 not encrypted, 1 even key, 2 odd key"
key   retransmitted         int     -  "data: R, 1 when the packet is a retransmission"
key   message_number        int     -  "data: message number, 26 bits"
key   timestamp             int     -  "microseconds since the socket was created, 32 bits"
key   dest_socket_id        int     -  "destination socket ID; 0 in a handshake to an unknown peer"
list  payload               "data: the payload, as octets"
key   control_type          int     -  "control: 0 handshake, 1 keep-alive, 2 ACK, 3 NAK, 4 congestion warning, 5 shutdown, 6 ACKACK, 7 drop request, 8 peer error, 0x7FFF user-defined"
key   subtype               int     -  "control: subtype (user-defined types)"
key   type_specific         int     -  "control: type-specific information (the ACK number of an ACK and ACKACK, the message number of a drop request, ...)"
key   hs_version            int     -  "handshake: version, 4 or 5"
key   encryption            int     -  "handshake: encryption field, 0 none, 2 AES-128, 3 AES-192, 4 AES-256"
key   extension_field       int     -  "handshake: extension field (the SRT magic 0x4A17 in an induction response; else the flags of the extensions present)"
key   hs_reserved           int     -  "handshake: the bit before the initial sequence number, 0"
key   initial_seq           int     -  "handshake: initial packet sequence number"
key   mtu                   int     -  "handshake: maximum transmission unit size, octets"
key   flow_window           int     -  "handshake: maximum flow window size, packets"
key   handshake_type        int     -  "handshake: type, 0xFFFFFFFD done, 0xFFFFFFFE agreement, 0xFFFFFFFF conclusion, 0 wavehand, 1 induction"
key   srt_socket_id         int     -  "handshake: the sender's socket ID"
key   syn_cookie            int     -  "handshake: SYN cookie"
key   peer_ip               string  -  "handshake: the peer's IP address, 128 bits as 32 hexadecimal digits (an IPv4 address in the first 32 bits)"
list  extensions            "handshake: the extensions, in order"
key   ext_type              int     -  "handshake extension type: 1 HSREQ, 2 HSRSP, 3 KMREQ, 4 KMRSP, 5 SID, 6 congestion, 7 filter, 8 group"
key   ext_length            int     -  "handshake extension: length in 4-octet units"
key   ext_content           string  -  "handshake extension: the content of an extension other than HSREQ and HSRSP, as hexadecimal digits"
key   srt_version           int     -  "HSREQ, HSRSP: SRT library version"
key   srt_flags             int     -  "HSREQ, HSRSP: SRT flags (TSBPDSND, TSBPDRCV, CRYPT, TLPKTDROP, PERIODICNAK, REXMITFLG, STREAM, PACKET_FILTER)"
key   receiver_tsbpd_delay  int     -  "HSREQ, HSRSP: receiver latency, milliseconds"
key   sender_tsbpd_delay    int     -  "HSREQ, HSRSP: sender latency, milliseconds"
list  cif_words             "ACK and NAK: the control information field as 32-bit words (an ACK's last acknowledged sequence number, RTT, RTT variance, buffer, rates; a NAK's loss list)"
key   word                  int     -  "one 32-bit word"
key   first_seq             int     -  "drop request: first sequence number of the message to drop"
key   last_seq              int     -  "drop request: last sequence number of the message to drop"
list  cif                   "the control information field of another control type, as octets"
key   octet                 int     -  "one octet"
