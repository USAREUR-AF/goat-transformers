# The cat150 module: the values of ASTERIX Category 150 (MADAP Plan Server - Flight Data Message), edition 3.0,
# as the category holds them. Used by the pack `asterix-cat150`. Generated by
# tools/gen/asterix2pack.py; do not edit by hand. A key is named after its item
# and subitems; a repetitive item is a list and its keys are the keys of one
# repetition.
module        cat150
version       0.1.0
distribution  public
source        "ASTERIX Category 150, MADAP Plan Server - Flight Data Message, edition 3.0 (2004-08-20), as transcribed in github.com/zoranbosnjak/asterix-specs (BSD-3-Clause), commit 64e9ffba964b92a1af3157bc6bdf7852a63bf700, specs/cat150/cats/cat3.0/definition.json. The category is specified by EUROCONTROL"
key   i010_cen     int     -       "I150/010/CEN: Centre Identifier (Destination ID)"
key   i010_pos     int     -       "I150/010/POS: Workstation Identifier (Destination ID)"
key   i020_cen     int     -       "I150/020/CEN: Centre Identifier (Source ID)"
key   i020_pos     int     -       "I150/020/POS: Workstation Identifier (Source ID)"
key   i030         int     -       "I150/030: Message Type. 1 = Flight plan creation, 2 = Flight plan modification, 3 = Flight plan repetition, 4 = Manual flight plan deletion, 5 = Automatic flight plan deletion, 6 = Flight is beyond extraction area boundary, 251 = Short term conflict alert, 252 = Correlations, 253 = Decorrelations, 254 = Start of background loop, 255 = End of background loop"
key   i040         int     -       "I150/040: Plan Reference Number"
key   i050         string  -       "I150/050: Callsign. 7 ASCII characters"
key   i060         string  -       "I150/060: Present Mode 3A. 4 ASCII characters"
key   i070         string  -       "I150/070: Next Mode 3A. 4 ASCII characters"
key   i080         string  -       "I150/080: Departure Aerodrome. 4 ASCII characters"
key   i090         string  -       "I150/090: Destination Aerodrome. 4 ASCII characters"
key   i100_gat     int     -       "I150/100/GAT: General Air Traffic (Type Flags)"
key   i100_oat     int     -       "I150/100/OAT: Operational Air Traffic (Type Flags)"
key   i100_cpl     int     -       "I150/100/CPL: Complete Flight Plan (Type Flags)"
key   i100_spn     int     -       "I150/100/SPN: Short Flight Plan (Type Flags)"
key   i110_hld     int     -       "I150/110/HLD: Aircraft is in Hold State (Status Flags)"
key   i110_rvq     int     -       "I150/110/RVQ: Aircraft is RVSM Equipped (Status Flags)"
key   i110_rvc     int     -       "I150/110/RVC: Aircraft is RVSM Capable (Status Flags)"
key   i110_rvx     int     -       "I150/110/RVX: Aircraft is RVSM Exempted (Status Flags)"
key   i120_noa     string  -       "I150/120/NOA: Number of Aircraft (Aircraft Type). 2 ASCII characters"
key   i120_toa     string  -       "I150/120/TOA: Type of Aircraft (Aircraft Type). 4 ASCII characters"
key   i120_wt      string  -       "I150/120/WT: Wake Turbulence (Aircraft Type). 1 ASCII characters"
key   i130         string  -       "I150/130: Cleared Flight Level. 3 ASCII characters"
list  i140         "I150/140: Route Points, Description, one item per repetition"
key   i140_t       int     -       "I150/140/T: Route Point Type (Route Points, Description). 1 = P, point, 2 = B, point with bearing and distance, 3 = LS, latitude/longitude position short format, 4 = LL, latitude/longitude position long format, 5 = X, x/y co-ordinate position, 6 = G, georeference position, 14 = E, airport"
key   i140_e       string  -       "I150/140/E: Route Point Description Element (Route Points, Description). 11 ASCII characters"
list  i150         "I150/150: Route Points, Coordinates, one item per repetition"
key   i150_x       float   NM      "I150/150/X: X Co-ordinate (Route Points, Coordinates). LSB 1/64 NM"
key   i150_y       float   NM      "I150/150/Y: Y Co-ordinate (Route Points, Coordinates). LSB 1/64 NM"
list  i160         "I150/160: Route Points, Time, one item per repetition"
key   i160_hh      string  -       "I150/160/HH: Hours (Route Points, Time). 2 ASCII characters"
key   i160_mm      string  -       "I150/160/MM: Minutes (Route Points, Time). 2 ASCII characters"
list  i170         "I150/170: Route Points, Flight Level, one item per repetition"
key   i170_val     string  -       "I150/170: Route Points, Flight Level. 3 ASCII characters"
list  i180         "I150/180: Route Points, Speed, one item per repetition"
key   i180_val     string  -       "I150/180: Route Points, Speed. 4 ASCII characters"
key   i190         string  -       "I150/190: Controller ID. 2 ASCII characters"
list  i200         "I150/200: Field 18, one item per repetition"
key   i200_val     string  -       "I150/200: Field 18. 1 ASCII characters"
key   i210         int     -       "I150/210: Correlated Track Number"
key   i220         int     -       "I150/220: Maximum Plan Count"
key   i230         int     -       "I150/230: Number of Plans"
list  i240         "I150/240: Newly Correlated Plans, one item per repetition"
key   i240_plan    int     -       "I150/240/PLAN: Plan Number (Newly Correlated Plans)"
key   i240_track   int     -       "I150/240/TRACK: Track Number (Newly Correlated Plans)"
list  i250         "I150/250: Newly De-correlated Plans, one item per repetition"
key   i250_val     int     -       "I150/250: Newly De-correlated Plans"
list  i251         "I150/251: Tracks in Conflict, one item per repetition"
key   i251_track1  int     -       "I150/251/TRACK1: Track Number 1 (Tracks in Conflict)"
key   i251_track2  int     -       "I150/251/TRACK2: Track Number 2 (Tracks in Conflict)"
list  i171         "I150/171: Route Points, Requested Flight Level, one item per repetition"
key   i171_val     string  -       "I150/171: Route Points, Requested Flight Level. 3 ASCII characters"
list  i151         "I150/151: Route Points, Geographic Position, one item per repetition"
key   i151_lat     float   deg     "I150/151/LAT: Latitude in WGS.84 in Two's Complement Form (Route Points, Geographic Position). LSB 45/2097152 deg"
key   i151_lon     float   deg     "I150/151/LON: Longitude in WGS.84 in Two's Complement Form (Route Points, Geographic Position). LSB 45/2097152 deg"
