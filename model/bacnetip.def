# The bacnetip module: BACnet/IP BVLC and NPDU header fields. Written by tools/gen/indauto2-pack.py.
module        bacnetip
version       0.1.0
distribution  public
source        "bacnet-stack, https://github.com/bacnet-stack/bacnet-stack at commit 229ba806601d4459a2b7889ec1280cb0ed4efcb4, src/bacnet/datalink/bvlc.c, bvlc.h and src/bacnet/npdu.c (GPL-2.0-or-later WITH GCC-exception-2.0); layouts restated, no code copied; ASHRAE 135 not used"
key   function              int     -  "BVLC function: 0 result, 1 write BDT, 2 read BDT, 3 read BDT ack, 4 forwarded NPDU, 5 register foreign device, 6 read FDT, 7 read FDT ack, 8 delete FDT entry, 9 distribute broadcast to network, 10 original unicast NPDU, 11 original broadcast NPDU, 12 secure BVLL"
key   result_code           int     -  "BVLC result: 0 successful completion, 0x10, 0x20, 0x30, 0x40, 0x50, 0x60 the NAK of functions 1, 2, 5, 6, 8, 9"
list  bdt_entries           "broadcast distribution table entries"
key   bdt_address           int     -  "BDT entry: the BBMD's IPv4 address, as an unsigned 32-bit integer"
key   bdt_port              int     -  "BDT entry: its UDP port"
key   bdt_mask              int     -  "BDT entry: the broadcast distribution mask, as an unsigned 32-bit integer"
list  fdt_entries           "foreign device table entries"
key   fdt_address           int     -  "FDT entry: the registrant's IPv4 address"
key   fdt_port              int     -  "FDT entry: its UDP port"
key   fdt_ttl               int     -  "FDT entry: the time to live given at registration, seconds"
key   fdt_remaining         int     -  "FDT entry: seconds remaining"
key   ip_address            int     -  "forwarded NPDU: the original source IPv4 address; delete FDT entry: the entry's address"
key   udp_port              int     -  "forwarded NPDU, delete FDT entry: the UDP port with that address"
key   ttl                   int     -  "register foreign device: time to live, seconds"
key   npdu_version          int     -  "NPDU protocol version, 1"
key   network_message       int     -  "NPDU control bit 7: a network layer message (message type present) rather than an APDU"
key   control_reserved6     int     -  "NPDU control bit 6, reserved, 0"
key   destination_present   int     -  "NPDU control bit 5: DNET, DLEN, DADR and the hop count present"
key   control_reserved4     int     -  "NPDU control bit 4, reserved, 0"
key   source_present        int     -  "NPDU control bit 3: SNET, SLEN and SADR present"
key   expecting_reply       int     -  "NPDU control bit 2: a confirmed request, a segment of a complex ACK or a network message expecting a reply"
key   priority              int     -  "NPDU control bits 1-0: 0 normal, 1 urgent, 2 critical equipment, 3 life safety"
key   dnet                  int     -  "destination network number"
list  dadr                  "destination MAC address, as octets (empty: broadcast)"
key   snet                  int     -  "source network number"
list  sadr                  "source MAC address, as octets"
key   hop_count             int     -  "hop count (with a destination)"
key   network_message_type  int     -  "network layer message type"
key   vendor_id             int     -  "vendor ID (message types 0x80 and above)"
list  payload               "the APDU, or the network layer message's data, as octets"
list  body                  "the body of another function (secure BVLL), as octets"
key   octet                 int     -  "one octet"
