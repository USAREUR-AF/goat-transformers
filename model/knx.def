# The knx module: fields of KNX cEMI frames and KNXnet/IP headers, each the wire integer
# unless the line says otherwise. Bits are numbered from the most significant.
module        knx
version       0.1.0
distribution  public
source        "calimero-core (https://github.com/calimero-project/calimero-core, GPL-2.0-or-later with the Classpath Exception) at commit 68c99bffb5d065220410311fbdf8f372fd84555e: cemi/CEMILData.java, knxnetip/servicetype/KNXnetIPHeader.java, ServiceRequest.java, ServiceAck.java, DataUnitBuilder.java, dptxlator/DPTXlatorBoolean, 8BitUnsigned, 2ByteFloat, 4ByteFloat; facts restated, no code copied"
source        "Not used: the KNX Standard (KNX Association), a paid document not held"
list  additional_info  "the cEMI additional information bytes"
list  data  "the data bytes of a TPDU after its first two bytes"
key  dpt5_scaling_percent       float -  "DPT 5.001: the raw value x 100/255, percent (derived)"
key  dpt5_angle_deg             float -  "DPT 5.003: the raw value x 360/255, degrees (derived)"
key  apci_data                  int   -  "the low six bits of the second TPDU byte: a value of six bits or less, or 0"
key  data_byte                  int   -  "one data byte after the TPDU's first two bytes"
key  apci_data_high             int   -  "the five high bits of the six-bit data of a DPT 1 value"
key  dpt1_value                 int   -  "DPT 1 (boolean): the low bit of the six-bit data, 0 or 1"
key  dpt5_value                 float -  "DPT 5 (8-bit unsigned): the raw value 0-255, as a float"
key  dpt9_sign                  int   -  "DPT 9 (2-byte float): the sign bit of the mantissa"
key  dpt9_exponent              int   -  "DPT 9: the exponent E, 4 bits"
key  dpt9_mantissa              int   -  "DPT 9: the low 11 bits of the 12-bit two's-complement mantissa M; value = 0.01 x M x 2^E"
key  dpt14_value                float -  "DPT 14 (4-byte float): IEEE 754 single precision, big-endian"
key  message_code               int   -  "cEMI message code: 0x11 L_Data.req, 0x29 L_Data.ind, 0x2E L_Data.con"
key  additional_info_byte       int   -  "one byte of the cEMI additional information"
key  frame_format               int   -  "control field 1 bit 7: 1 standard frame, 0 extended"
key  ctrl1_reserved             int   -  "control field 1 bit 6"
key  repeat                     int   -  "control field 1 bit 5: in a request or confirmation 1 the default (repetitions allowed), 0 do not repeat; in an indication 0 a repeated frame, 1 not repeated (calimero CEMILData)"
key  system_broadcast           int   -  "control field 1 bit 4: 0 system broadcast, 1 broadcast"
key  priority                   int   -  "control field 1 bits 3-2: 0 system, 1 normal, 2 urgent, 3 low"
key  ack_request                int   -  "control field 1 bit 1: 1 acknowledge requested"
key  confirm                    int   -  "control field 1 bit 0: 1 error (in a confirmation)"
key  destination_is_group       int   -  "control field 2 bit 7: 1 group address, 0 individual address"
key  hop_count                  int   -  "control field 2 bits 6-4: routing counter"
key  extended_frame_format      int   -  "control field 2 bits 3-0"
key  source_area                int   -  "source individual address: area (4 bits)"
key  source_line                int   -  "source individual address: line (4 bits)"
key  source_device              int   -  "source individual address: device (8 bits)"
key  destination                int   -  "destination address, 16 bits: a group address (main 5, middle 3, sub 8 bits) or an individual address"
key  tpci                       int   -  "transport layer control, 6 bits (0 for group communication)"
key  apci                       int   -  "application layer service, 4 bits: 0 GroupValueRead, 1 GroupValueResponse, 2 GroupValueWrite"
key  header_length              int   -  "KNXnet/IP header length, 6"
key  protocol_version           int   -  "KNXnet/IP protocol version, 0x10 for 1.0"
key  connection_header_length   int   -  "connection header structure length, 4"
key  channel_id                 int   -  "communication channel id"
key  sequence_counter           int   -  "sequence counter"
key  connection_reserved        int   -  "reserved byte of the connection header"
key  status                     int   -  "status of the acknowledged request, 0 no error"
derive  knx.dpt5_scaling_percent  scale:100/255  knx.dpt5_value
derive  knx.dpt5_angle_deg        scale:360/255  knx.dpt5_value
