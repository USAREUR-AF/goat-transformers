key   updated_at  string  -  "member `UPDATED_AT` of OPP (JSON string)"
key   supersedes_opp_cid  string  -  "member `SUPERSEDES_OPP_CID` of OPP (JSON string)"
key   notes  string  -  "member `NOTES` of OPP (JSON string)"
list  radar_cross_sections  "array `RADAR_CROSS_SECTIONS` of OPP, one item per element"
list  surfaces  "array `SURFACES` of OPP, one item per element"
list  sources  "array `SOURCES` of OPP, one item per element"
