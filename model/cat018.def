# The cat018 module: the values of ASTERIX Category 018 (Mode S Datalink Function Messages), edition 1.8,
# as the category holds them. Used by the pack `asterix-cat018`. Generated by
# tools/gen/asterix2pack.py; do not edit by hand. A key is named after its item
# and subitems; a repetitive item is a list and its keys are the keys of one
# repetition.
module        cat018
version       0.1.0
distribution  public
source        "ASTERIX Category 018, Mode S Datalink Function Messages, edition 1.8 (2024-05-14), as transcribed in github.com/zoranbosnjak/asterix-specs (BSD-3-Clause), commit 64e9ffba964b92a1af3157bc6bdf7852a63bf700, specs/cat018/cats/cat1.8/definition.json. The category is specified by EUROCONTROL"
key   i036_sac         int     -       "I018/036/SAC: System Area Code (Data Source Identifier)"
key   i036_sic         int     -       "I018/036/SIC: System Identification Code (Data Source Identifier)"
key   i037_sac         int     -       "I018/037/SAC: System Area Code (Data Destination Identifier)"
key   i037_sic         int     -       "I018/037/SIC: System Identification Code (Data Destination Identifier)"
key   i000             int     -       "I018/000: Message Type. 0 = Associate_req, 1 = Associate_resp, 2 = Release_req, 3 = Release_resp, 4 = Abort_req, 5 = Keep_alive, 16 = Aircraft_report, 17 = Aircraft_command, 18 = II_code_change, 32 = Uplink_packet, 33 = Cancel_uplink_packet, 34 = Uplink_packet_ack, 35 = Downlink_packet, 38 = Data_XON, 39 = Data_XOFF, 48 = Uplink_broadcast, 49 = Cancel_uplink_broadcast, 50 = Uplink_broadcast_ack..."
key   i001_cause       int     -       "I018/001/CAUSE: Cause (Result). 0 = Accepted, the request is accepted and is under processing, 1 = Rejected, the request has not been accepted, 2 = Cancelled, the request has been cancelled, 3 = Finished, the request has been accepted and successfully processed, 4 = Delayed, the request processing is temporarily delayed but the request is still valid, 5 = In Progress, the request is being succe..."
key   i001_diag        int     -       "I018/001/DIAG: Diagnostic (Result). 0 = No diagnostic available, 1 = Aircraft Exit, 2 = Incorrect aircraft address, 3 = Impossibility to process the message, 4 = Insufficient or change in data link capability, 5 = Invalid LV field, 6 = Duplicate request number, 7 = Unknown request number, 8 = Timer T3 expiry, 9 = Expiry of I/R delivery timer, 10 = Uplink flow disabled by UC"
key   i005             int     -       "I018/005: Mode S Address"
key   i016             int     -       "I018/016: Packet Number"
list  i017             "I018/017: Packet Number List, one item per repetition"
key   i017_val         int     -       "I018/017: Packet Number List"
key   i018_pr          int     -       "I018/018/PR: Mode S Packet Internal Priority (Mode S Packet Properties)"
key   i018_pt          int     -       "I018/018/PT: Packet Type (Mode S Packet Properties). 0 = SVC packets, 1 = MSP packets, 2 = Route packets"
key   i028             float   s       "I018/028: GICB Extraction Periodicity. LSB 1 s"
key   i030_priority    int     -       "I018/030/PRIORITY: GICB Priority (GICB Properties)"
key   i030_pc          int     -       "I018/030/PC: Periodicity Constraint (GICB Properties). 0 = The periodicity may not be strictly respected, 1 = The periodicity shall be strictly respected"
key   i030_au          int     -       "I018/030/AU: Asynchronous Update (GICB Properties). 0 = GICB extractions should be sent only when required by the periodicity, 1 = If a GICB extraction is done due to external conditions, an update will also be sent, even if it does not match the expected periodicity"
key   i030_ne          int     -       "I018/030/NE: Non Extraction (GICB Properties). 0 = The GICB extraction is attempted according to the periodicity, 1 = There will no GICB attempts"
key   i030_rd          int     -       "I018/030/RD: Reply Destination (GICB Properties). 0 = The extracted GICB must be sent only on the Data Link line, 1 = The extracted GICB must be sent only on the Surveillance line, 2 = The extracted GICB must be sent both on the Data Link and on the Surveillance lines"
key   i025             int     -       "I018/025: GICB Number"
key   i027             int     -       "I018/027: BDS Code"
key   i029             int     -       "I018/029: GICB Extracted. raw value: a Mode S BDS register"
key   i002             float   s       "I018/002: Time of Day. LSB 1/128 s"
list  i006             "I018/006: Mode S Address List, one item per repetition"
key   i006_val         int     -       "I018/006: Mode S Address List"
key   i007_um          int     -       "I018/007/UM: Uplink Mask (Aircraft Data Link Command). 0 = UC shall be ignored, 1 = UC shall be taken into account"
key   i007_dm          int     -       "I018/007/DM: Downlink Mask (Aircraft Data Link Command). 0 = DC shall be ignored, 1 = DC shall be taken into account"
key   i007_uc          int     -       "I018/007/UC: Uplink Command (Aircraft Data Link Command). 0 = the uplink flow shall be enabled, 1 = the uplink flow shall be stopped"
key   i007_dc          int     -       "I018/007/DC: Downlink Command (Aircraft Data Link Command). 0 = the downlink flow shall be enabled, 1 = the downlink flow shall be stopped"
key   i008_uds         int     -       "I018/008/UDS: Uplink Default Status (Aircraft Data Link Status). 0 = The interrogator is enabled to uplink frames, 1 = The interrogator is disabled to uplink frames"
key   i008_dds         int     -       "I018/008/DDS: Downlink Default Status (Aircraft Data Link Status). 0 = The interrogator is enabled to extract frames, 1 = The interrogator is disabled to extract frames"
key   i008_ucs         int     -       "I018/008/UCS: Uplink Current Status (Aircraft Data Link Status). 0 = The interrogator is enabled to uplink frames, 1 = The interrogator is disabled to uplink frames"
key   i008_dcs         int     -       "I018/008/DCS: Downlink Current Status (Aircraft Data Link Status). 0 = The interrogator is enabled to extract frames, 1 = The interrogator is disabled to extract frames"
key   i008_ei          int     -       "I018/008/EI: Exit Indication (Aircraft Data Link Status). 0 = The aircraft is in the Datalink coverage map of the interrogator, 1 = The aircraft is not in the Datalink coverage map of the interrogator"
key   i008_ic          int     -       "I018/008/IC: Interrogator Control (Aircraft Data Link Status). 0 = The interrogators current ability to uplink/downlink frames (UCS/DCS) and the content of the Aircraft_report could be changed using D_Data_link_command, 1 = The interrogators current ability to uplink/downlink frames (UCS/DCS) and the content of the Aircraft_report cannot be changed using D_Data_link_command"
key   i009_sr          int     -       "I018/009/SR (Aircraft Data Link Report Request). 0 = The next Aircraft_report may not include D_Data_link_status, 1 = The next Aircraft_report shall include D_Data_link_status"
key   i009_ar          int     -       "I018/009/AR (Aircraft Data Link Report Request). 0 = The next Aircraft_report may not include D_COM, 1 = The next Aircraft_report shall include D_COM"
key   i009_er          int     -       "I018/009/ER (Aircraft Data Link Report Request). 0 = The next Aircraft_report may not include D_ECA, 1 = The next Aircraft_report shall include D_ECA"
key   i009_fr          int     -       "I018/009/FR (Aircraft Data Link Report Request). 0 = The next Aircraft_report may not include D_CQF, 1 = The next Aircraft_report shall include D_CQF"
key   i009_mr          int     -       "I018/009/MR (Aircraft Data Link Report Request). 0 = The next Aircraft_report may not include D_CQF_method, 1 = The next Aircraft_report shall include D_CQF_method"
key   i009_pr          int     -       "I018/009/PR (Aircraft Data Link Report Request). 0 = The next Aircraft_report may not include D_Polar_position, 1 = The next Aircraft_report shall include D_Polar_position"
key   i009_cr          int     -       "I018/009/CR (Aircraft Data Link Report Request). 0 = The next Aircraft_report may not include D_Cartesian_position, 1 = The next Aircraft_report shall include D_Cartesian_position"
key   i009_id          int     -       "I018/009/ID (Aircraft Data Link Report Request). 0 = The next Aircraft_report may not include Aircraft_ID, 1 = The next Aircraft_report shall include Aircraft_ID"
key   i009_ma          int     -       "I018/009/MA (Aircraft Data Link Report Request). 0 = The next Aircraft_report may not include Mode_A, 1 = The next Aircraft_report shall include Mode_A"
key   i009_sp          int     -       "I018/009/SP (Aircraft Data Link Report Request). 0 = The next Aircraft_report may not include Speed, 1 = The next Aircraft_report shall include Speed"
key   i009_hg          int     -       "I018/009/HG (Aircraft Data Link Report Request). 0 = The next Aircraft_report may not include Height, 1 = The next Aircraft_report shall include Height"
key   i009_hd          int     -       "I018/009/HD (Aircraft Data Link Report Request). 0 = The next Aircraft_report may not include Heading, 1 = The next Aircraft_report shall include Heading"
key   i010_com         int     -       "I018/010/COM: Communications Capability of the Transponder (Transponder Communications Capability). 0 = No communications capability (surveillance only), 1 = Comm. A and Comm. B capability, 2 = Comm. A, Comm. B and Uplink ELM, 3 = Comm. A, Comm. B and Uplink ELM and Downlink ELM, 4 = Level 5 Transponder capability"
key   i011             int     -       "I018/011: Capability Report"
key   i014_rho         float   NM      "I018/014/RHO (Aircraft Position in Polar Co-ordinates). LSB 1/256 NM"
key   i014_theta       float   deg     "I018/014/THETA (Aircraft Position in Polar Co-ordinates). LSB 45/8192 deg"
key   i015_x           float   NM      "I018/015/X: X-Component (Aircraft Position in Cartesian Co-ordinates). LSB 1/128 NM"
key   i015_y           float   NM      "I018/015/Y: Y-Component (Aircraft Position in Cartesian Co-ordinates). LSB 1/128 NM"
key   i020             int     -       "I018/020: Broadcast Number"
key   i021_priority    int     -       "I018/021/PRIORITY: Priority (Broadcast Properties)"
key   i021_power       int     -       "I018/021/POWER: Power (Broadcast Properties)"
key   i021_duration    float   s       "I018/021/DURATION: Duration (Broadcast Properties). LSB 1 s"
key   i021_coverage    int     -       "I018/021/COVERAGE: Coverage (Broadcast Properties)"
key   i022_prefix      int     -       "I018/022/PREFIX: Prefix Field (Broadcast Prefix)"
key   i023             int     -       "I018/023: Uplink or Downlink Broadcast"
key   i004_previousii  int     -       "I018/004/PREVIOUSII: Former II Code (II Code)"
key   i004_currentii   int     -       "I018/004/CURRENTII: Current II Code (II Code)"
key   i031             int     -       "I018/031: Aircraft Identity"
key   i032_v           int     -       "I018/032/V (Aircraft Mode A). 0 = Code validated, 1 = Code not validated"
key   i032_g           int     -       "I018/032/G (Aircraft Mode A). 0 = Default, 1 = Garbled code"
key   i032_l           int     -       "I018/032/L (Aircraft Mode A). 0 = Mode-3/A code derived from the reply of the transponder, 1 = Mode-3/A code not extracted during the last scan"
key   i032_mod3a       int     -       "I018/032/MOD3A (Aircraft Mode A). raw value: 4 octal digits of 3 bits each"
key   i033_v           int     -       "I018/033/V (Aircraft Height). 0 = Code validated, 1 = Code not validated"
key   i033_g           int     -       "I018/033/G (Aircraft Height). 0 = Default, 1 = Garbled code"
key   i033_fl          float   FL      "I018/033/FL: Flight Level (Aircraft Height). LSB 1/4 FL"
key   i034             float   NM/s    "I018/034: Aircraft Speed. LSB 1/16384 NM/s"
key   i035             float   deg     "I018/035: Aircraft Heading. LSB 45/8192 deg"
key   i012_fs          int     -       "I018/012/FS: Flight Status (Aircraft Coverage Quality Factor). 0 = Aircraft is airborne, 1 = Aircraft is on the ground"
key   i012_cqf         int     -       "I018/012/CQF: Aircraft CQF (Aircraft Coverage Quality Factor). 0 = The CQF calculation method is not supported, 1 = The CQF is minimum, 126 = The CQF is maximum, 127 = The CQF is undefined according to the calculation method"
key   i013             int     -       "I018/013: Aircraft CQF Calculation Method"
# Derived keys (engine-spec 0.6 and 0.8), applied by `convert` between decode and encode.
derive  cat018.i002  day_seconds  time_ms
