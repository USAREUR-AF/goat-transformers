# The sirf module: SiRF binary frame and Geodetic Navigation Data fields. Written by tools/gen/gnssbin-pack.py.
module        sirf
version       0.1.0
distribution  public
source        "gpsd, https://gitlab.com/gpsd/gpsd at commit edd38e78a875062f53add5c1ade745761240fffb, drivers/driver_sirf.c (BSD-2-Clause, compilation copyright the GPSD project); layout restated, no code copied; the SiRF protocol reference not used"
key   message_id        int     -     "message ID (41 Geodetic Navigation Data, 2 Measure Navigation Data, 4 tracker data ...)"
key   unread_1          string  -     "MID 41 octets 1-2, which the source does not read, as hexadecimal digits"
key   nav_type          int     -     "MID 41: navigation type (bits 2-0: 0 no fix, 4 and 6 a 3-D fix, 7 dead reckoning; bit 7 DGPS)"
key   extended_week     int     -     "MID 41: extended GPS week"
key   time_of_week      int     ms    "MID 41: time of week in the GPS week"
key   utc_year          int     -     "MID 41: UTC year"
key   utc_month         int     -     "MID 41: UTC month"
key   utc_day           int     -     "MID 41: UTC day"
key   utc_hour          int     -     "MID 41: UTC hour"
key   utc_minute        int     -     "MID 41: UTC minute"
key   utc_second_ms     int     ms    "MID 41: UTC seconds"
key   unread_19         string  -     "MID 41 octets 19-22 (not read by the source)"
key   altitude_msl      float   m     "MID 41: altitude above mean sea level"
key   map_datum         int     -     "MID 41: map datum code"
key   speed             float   m/s   "MID 41: speed over ground"
key   track             float   deg   "MID 41: course over ground (true)"
key   unread_44         string  -     "MID 41 octets 44-45 (magnetic variation, which the source skips)"
key   climb             float   m/s   "MID 41: climb rate"
key   unread_48         string  -     "MID 41 octets 48-49 (not read by the source)"
key   horizontal_error  float   m     "MID 41: horizontal position error estimate"
key   vertical_error    float   m     "MID 41: vertical position error estimate"
key   unread_58         string  -     "MID 41 octets 58-61 (not read by the source)"
key   speed_error       float   m/s   "MID 41: speed error estimate"
key   unread_64         string  -     "MID 41 octets 64-88 (not read by the source)"
key   hdop              float   -     "MID 41: HDOP"
key   unread_90         string  -     "MID 41 octet 90 (not read by the source)"
list  payload           "another message's payload after its ID, as octets"
key   checksum          int     -     "the 15-bit checksum, as sent (not computed)"
key   octet             int     -     "one octet"
