# The ogccovcis module: members of a coverage in the JSON encoding of the OGC Coverage
# Implementation Schema 1.1.1 (CIS), as the standard's text states them. Written by hand
# from the text; the JSON Schema files of CIS were not read (packs/ogcapi-coverages-coverage/pack.md).
module        ogccovcis
version       0.1.0
distribution  public
source        "OGC Coverage Implementation Schema (CIS) 1.1.1, OGC 09-146r8, https://docs.ogc.org/is/09-146r8/09-146r8.html (sha256 031d61c079c865a9b8b3957b9453f9660749729b85f067edd5e77092f3b48b4d), clauses 6 to 8 and 13; OGC standard document, free to implement"
key   type                         string -  "the coverage type token"
key   id                           string -  "identifier of the coverage"
key   envelope_type                string -  "type token of the envelope object"
key   envelope_srs_name            string -  "URL of the CRS of the envelope coordinates"
key   envelope_srs_dimension       int    -  "number of axes of the envelope"
list  envelope_axis_labels                   "axis labels of the envelope, in CRS axis order"
key   envelope_axis_labels_value   string -  "one axis label of the envelope"
list  envelope_axis_extent                   "extent of the envelope along each axis"
key   envelope_axis_extent_type    string -  "type token of an axis extent"
key   envelope_axis_extent_axis_label  string -  "label of the axis of this extent"
key   envelope_axis_extent_uom_label   string -  "text naming the unit in which this axis extent is measured"
key   envelope_axis_extent_lower_bound string -  "lowest coordinate along the axis, as text (the standard types it as a string)"
key   envelope_axis_extent_upper_bound string -  "highest coordinate along the axis, as text (the standard types it as a string)"
key   domain_set_type              string -  "type token of the domain set"
key   grid_type                    string -  "type token of the general grid"
key   grid_srs_name                string -  "URL of the CRS of the grid coordinates"
list  grid_axis_labels                       "axis labels of the general grid, in CRS axis order"
key   grid_axis_labels_value       string -  "one axis label of the grid"
list  grid_axis                              "the axes of the general grid"
key   grid_axis_type               string -  "axis type token (index, regular or irregular axis)"
key   grid_axis_axis_label         string -  "label of the axis"
key   grid_axis_uom_label          string -  "text naming the unit in which the axis is measured (regular and irregular axes)"
key   grid_axis_resolution         string -  "spacing of a regular axis, as text in the axis unit"
key   grid_limits_type             string -  "type token of the grid limits"
key   grid_limits_srs_name         string -  "URL of the Index CRS of the grid array"
list  grid_limits_index_axis                 "the index axes of the grid array"
key   grid_limits_index_axis_type  string -  "type token of an index axis"
key   grid_limits_index_axis_axis_label  string -  "label of the index axis"
key   grid_limits_index_axis_lower_bound int  -  "lowest array index along the axis"
key   grid_limits_index_axis_upper_bound int  -  "highest array index along the axis"
key   range_set_type               string -  "type token of the range set"
key   data_block_type              string -  "type token of the data block holding the range values"
key   range_type_type              string -  "type token of the range type record"
list  range_type_field                       "the components of each range value (SWE Common record fields)"
key   range_type_field_type        string -  "type token of the component (a SWE Common component type)"
key   range_type_field_name        string -  "name that identifies the component within the record"
key   range_type_field_definition  string -  "URI of the definition of the component's property or data type"
key   range_type_field_uom_type    string -  "type token of the unit reference"
key   range_type_field_uom_code    string -  "the code of the unit in which the range field is measured"
