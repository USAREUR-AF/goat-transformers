# The sctp module: the chunks of an SCTP packet, their parameters and error causes (RFC 9260).
# The common header is in the inet module. Written by tools/gen/telecom-pack.py; do not edit by hand.
module        sctp
version       0.1.0
distribution  public
source        "IETF RFC 9260, Stream Control Transmission Protocol; restated by goat-transformers"
list  chunks            "the chunks of the packet, in order"
key   chunk_type        int     -  "chunk type: 0 DATA, 1 INIT, 2 INIT ACK, 3 SACK, 4 HEARTBEAT, 5 HEARTBEAT ACK, 6 ABORT, 7 SHUTDOWN, 8 SHUTDOWN ACK, 9 ERROR, 10 COOKIE ECHO, 11 COOKIE ACK, 14 SHUTDOWN COMPLETE"
key   chunk_flags       int     -  "chunk flags as one octet: for DATA the bits I, U, B, E (the low four); for ABORT and SHUTDOWN COMPLETE the T bit (the lowest)"
key   tsn               int     -  "transmission sequence number (DATA; the No User Data cause)"
key   stream_id         int     -  "stream identifier (DATA; the Invalid Stream Identifier cause)"
key   stream_seq        int     -  "DATA: stream sequence number"
key   ppid              int     -  "DATA: payload protocol identifier"
list  user_data         "DATA: the user data, as octets"
key   initiate_tag      int     -  "INIT, INIT ACK: the tag the peer is to put in the packets it sends"
key   a_rwnd            int     -  "advertised receiver window credit, octets"
key   outbound_streams  int     -  "INIT, INIT ACK: outbound streams"
key   inbound_streams   int     -  "INIT, INIT ACK: the most inbound streams"
key   initial_tsn       int     -  "INIT, INIT ACK: the first TSN the sender will use"
list  parameters        "the parameters of an INIT, INIT ACK, HEARTBEAT or HEARTBEAT ACK, in order"
key   param_type        int     -  "parameter type: 1 heartbeat info, 5 IPv4 address, 6 IPv6 address, 7 state cookie, 8 unrecognized parameter, 9 cookie preservative, 11 host name, 12 supported address types"
key   ipv4_address      int     -  "IPv4 address parameter, as an unsigned 32-bit integer"
key   ipv6_address      string  -  "IPv6 address parameter, 32 hexadecimal digits"
key   cookie_increment  int     -  "cookie preservative: suggested lifespan increment, milliseconds"
list  address_types     "supported address types parameter: the types"
key   address_type      int     -  "one supported address type: 5 IPv4, 6 IPv6"
key   cum_tsn_ack       int     -  "SACK, SHUTDOWN: cumulative TSN acknowledgement"
list  gap_blocks        "SACK: gap acknowledgement blocks, in order"
key   gap_start         int     -  "SACK: start of a gap block, as an offset from the cumulative TSN"
key   gap_end           int     -  "SACK: end of a gap block, as an offset from the cumulative TSN"
list  duplicate_tsns    "SACK: the duplicate TSNs reported"
key   duplicate_tsn     int     -  "SACK: one duplicate TSN"
list  causes            "the error causes of an ABORT or ERROR, in order"
key   cause_code        int     -  "error cause code (section 3.3.10: 1 invalid stream identifier to 13 protocol violation)"
key   staleness         int     -  "stale cookie cause: measure of staleness, microseconds"
list  cookie            "COOKIE ECHO: the cookie, as octets"
list  value             "the value of a chunk, parameter or cause the pack does not lay out, as octets"
key   octet             int     -  "one octet"
