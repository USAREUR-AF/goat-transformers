# The wms module: the values of an OGC WMS 1.3.0 capabilities document (service
# metadata and layers). None has a shared-model key; packs/wms-capabilities/pack.md
# says why the geographic bounding boxes are not positions.
module        wms
version       0.1.0
distribution  public
source        "OGC Web Map Server Implementation Specification 1.3.0, OGC 06-042 (2006-03-15), https://docs.ogc.org/is/06-042/06-042.pdf, clause 7.2.4 and Annex E; OGC Document License Agreement"
key   update_sequence       string  -    "root attribute updateSequence: a value the server raises when the service metadata change"
key   title                 string  -    "Service Title: a human-readable name of the service"
key   abstract              string  -    "Service Abstract: a description of the service"
list  keywords                           "Service KeywordList: the keywords of the service"
key   keyword               string  -    "one Keyword of a KeywordList"
key   contact_person        string  -    "ContactPersonPrimary ContactPerson: the contact person"
key   contact_organization  string  -    "ContactPersonPrimary ContactOrganization: the contact organization"
key   contact_position      string  -    "ContactPosition: the role of the contact person"
key   contact_address_type  string  -    "ContactAddress AddressType: the kind of address, for example postal"
key   contact_address       string  -    "ContactAddress Address: street address"
key   contact_city          string  -    "ContactAddress City"
key   contact_state         string  -    "ContactAddress StateOrProvince"
key   contact_post_code     string  -    "ContactAddress PostCode"
key   contact_country       string  -    "ContactAddress Country"
key   contact_phone         string  -    "ContactVoiceTelephone"
key   contact_fax           string  -    "ContactFacsimileTelephone"
key   contact_email         string  -    "ContactElectronicMailAddress"
key   fees                  string  -    "Service Fees: fees for use of the service; the keyword none for none"
key   access_constraints    string  -    "Service AccessConstraints: constraints on use; the keyword none for none"
key   layer_limit           int     -    "Service LayerLimit: the largest number of layers one GetMap request may name"
key   max_width             int     px   "Service MaxWidth: the widest map, in pixels, a GetMap request may ask for"
key   max_height            int     px   "Service MaxHeight: the tallest map, in pixels, a GetMap request may ask for"
list  getmap_formats                     "Request GetMap Format: the output formats of GetMap"
list  featureinfo_formats                "Request GetFeatureInfo Format: the output formats of GetFeatureInfo"
list  exception_formats                  "Capability Exception Format: the formats the service reports errors in"
key   format                string  -    "one Format: a MIME type, or for exceptions XML, INIMAGE or BLANK"
key   layer_name            string  -    "top-level Layer Name: the name a GetMap request uses; absent for a layer that is only a category"
key   layer_title           string  -    "top-level Layer Title"
key   layer_abstract        string  -    "top-level Layer Abstract"
key   layer_queryable       string  -    "top-level Layer attribute queryable as written: 0, false, 1 or true"
list  layer_crs                          "top-level Layer CRS: the coordinate reference systems the layer can be drawn in"
key   crs                   string  -    "one CRS identifier, for example CRS:84 or EPSG:4326"
key   layer_west            float   deg  "top-level Layer EX_GeographicBoundingBox westBoundLongitude, decimal degrees of longitude or latitude, possibly approximate"
key   layer_east            float   deg  "top-level Layer EX_GeographicBoundingBox eastBoundLongitude, decimal degrees of longitude or latitude, possibly approximate"
key   layer_south           float   deg  "top-level Layer EX_GeographicBoundingBox southBoundLatitude, decimal degrees of longitude or latitude, possibly approximate"
key   layer_north           float   deg  "top-level Layer EX_GeographicBoundingBox northBoundLatitude, decimal degrees of longitude or latitude, possibly approximate"
key   layer_min_scale       float   -    "top-level Layer MinScaleDenominator"
key   layer_max_scale       float   -    "top-level Layer MaxScaleDenominator"
list  layers                             "the Layer elements directly inside the top-level Layer"
key   name                  string  -    "a layer's Name"
key   layer_item_title      string  -    "a layer's Title"
key   layer_item_abstract   string  -    "a layer's Abstract"
key   queryable             string  -    "a layer's attribute queryable as written: 0, false, 1 or true"
key   opaque                string  -    "a layer's attribute opaque as written: 0, false, 1 or true"
key   west                  float   deg  "a layer's EX_GeographicBoundingBox westBoundLongitude, decimal degrees"
key   east                  float   deg  "a layer's EX_GeographicBoundingBox eastBoundLongitude, decimal degrees"
key   south                 float   deg  "a layer's EX_GeographicBoundingBox southBoundLatitude, decimal degrees"
key   north                 float   deg  "a layer's EX_GeographicBoundingBox northBoundLatitude, decimal degrees"
key   min_scale             float   -    "a layer's MinScaleDenominator"
key   max_scale             float   -    "a layer's MaxScaleDenominator"
