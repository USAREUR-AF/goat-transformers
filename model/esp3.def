# The esp3 module: EnOcean ESP3 packet fields. Written by tools/gen/smarthome-pack.py.
module        esp3
version       0.1.0
distribution  public
source        "kipe/enocean, https://github.com/kipe/enocean at commit 80a253bcea1e3cb99295f53f04c0558190dca5f3, enocean/protocol/packet.py and constants.py (MIT License, Copyright (c) 2014-2016 Kimmo Huoman); layout restated, no code copied; the EnOcean ESP3 specification not used"
key   packet_type    int     -  "packet type: 1 radio ERP1, 2 response, 3 radio sub-telegram, 4 event, 5 common command, 6 smart acknowledge command, 7 remote management command, 9 radio message, 10 radio ERP2"
key   header_crc     int     -  "CRC8 over the data length, optional length and packet type, as sent (not computed)"
list  data           "the data (its length is written from the list): for ERP1 the RORG, payload, sender ID and status"
list  optional_data  "the optional data (its length is written from the list): for ERP1 the subtelegram count, destination ID, dBm and security level"
key   data_crc       int     -  "CRC8 over the data and optional data, as sent (not computed)"
key   octet          int     -  "one octet"
