# The icmpnd module: ICMPv6 Neighbor Discovery fields and options. Written by tools/gen/inet-more-pack.py.
module        icmpnd
version       0.1.0
distribution  public
source        "IETF RFC 4861, Neighbor Discovery for IP version 6, sections 4.1 to 4.6; RFC 8106 section 5 (RDNSS, DNSSL); https://www.rfc-editor.org/; layouts restated"
key   ns_reserved          int     -  "NS: the 32 reserved bits"
key   target               string  -  "NS, NA, Redirect: the target address, as hexadecimal digits"
key   router               int     -  "NA R flag: the sender is a router"
key   solicited            int     -  "NA S flag: sent in response to a solicitation"
key   override             int     -  "NA O flag: override an existing cache entry"
key   na_reserved          int     -  "NA: the 29 reserved bits"
key   redirect_reserved    int     -  "Redirect: the 32 reserved bits"
key   destination          string  -  "Redirect: the destination address, as hexadecimal digits"
list  options              "the options, in order"
key   option_type          int     -  "option type: 1 source link-layer address, 2 target link-layer address, 3 prefix information, 4 redirected header, 5 MTU, 25 RDNSS, 31 DNSSL"
key   option_length        int     -  "option length, in units of 8 octets, the type and length included"
key   link_layer_address   string  -  "link-layer address option: the address (and any padding), as hexadecimal digits"
key   prefix_length        int     -  "prefix information: prefix length"
key   on_link              int     -  "prefix information L flag: on-link"
key   autonomous           int     -  "prefix information A flag: usable for autonomous address configuration"
key   router_address       int     -  "prefix information: the bit after A, in the Reserved1 field of RFC 4861"
key   prefix_reserved1     int     -  "prefix information: the 5 reserved bits"
key   valid_lifetime       int     -  "prefix information: valid lifetime, seconds (0xFFFFFFFF infinity)"
key   preferred_lifetime   int     -  "prefix information: preferred lifetime, seconds"
key   prefix_reserved2     int     -  "prefix information: the 32 reserved bits"
key   prefix               string  -  "prefix information: the prefix, as hexadecimal digits"
key   redirected_reserved  int     -  "redirected header: the 48 reserved bits"
key   redirected_packet    string  -  "redirected header: the start of the redirected packet, as hexadecimal digits"
key   mtu_reserved         int     -  "MTU option: the 16 reserved bits"
key   mtu                  int     -  "MTU option: the link MTU"
key   rdnss_reserved       int     -  "RDNSS: the 16 reserved bits"
key   rdnss_lifetime       int     -  "RDNSS: lifetime, seconds"
key   rdnss_addresses      string  -  "RDNSS: the DNS server addresses, 16 octets each, as hexadecimal digits"
key   dnssl_reserved       int     -  "DNSSL: the 16 reserved bits"
key   dnssl_lifetime       int     -  "DNSSL: lifetime, seconds"
key   dnssl_names          string  -  "DNSSL: the search domain names (DNS name encoding, zero-padded), as hexadecimal digits"
key   option_data          string  -  "an option of another type: its body, as hexadecimal digits"
