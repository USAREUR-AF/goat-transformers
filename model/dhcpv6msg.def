# The dhcpv6msg module: DHCPv6 messages and options (RFC 9915). Written by tools/gen/inet-more-pack.py.
module        dhcpv6msg
version       0.1.0
distribution  public
source        "IETF RFC 9915, Dynamic Host Configuration Protocol for IPv6 (DHCPv6), sections 8, 9, 11 and 21 (it obsoletes RFC 8415), https://www.rfc-editor.org/rfc/rfc9915.txt; layouts restated"
key   msg_type            int     -  "message type: 1 SOLICIT, 2 ADVERTISE, 3 REQUEST, 4 CONFIRM, 5 RENEW, 6 REBIND, 7 REPLY, 8 RELEASE, 9 DECLINE, 10 RECONFIGURE, 11 INFORMATION-REQUEST, 12 RELAY-FORW, 13 RELAY-REPL"
key   transaction_id      int     -  "transaction ID, 24 bits"
key   hop_count           int     -  "relay: hop count"
key   link_address        string  -  "relay: link address, as hexadecimal digits"
key   peer_address        string  -  "relay: peer address, as hexadecimal digits"
list  options             "the options, in order"
key   option_code         int     -  "option code (1 client ID, 2 server ID, 3 IA_NA, 4 IA_TA, 6 ORO, 7 preference, 8 elapsed time, 13 status, 14 rapid commit, 23 DNS servers, 25 IA_PD ...)"
key   duid_type           int     -  "DUID type: 1 link-layer plus time, 2 enterprise number, 3 link-layer, 4 UUID"
key   hardware_type       int     -  "DUID: hardware type (1 Ethernet)"
key   duid_time           int     -  "DUID-LLT: time, seconds since 2000-01-01 UTC, modulo 2^32"
list  link_layer_address  "DUID: the link-layer address, as octets"
key   enterprise_number   int     -  "DUID-EN: the IANA enterprise number"
list  duid_identifier     "DUID-EN identifier, or a DUID of another type, as octets"
key   duid_uuid           string  -  "DUID-UUID: the UUID, as hexadecimal digits"
key   iaid                int     -  "IA: identity association ID"
key   t1                  int     -  "IA: T1, seconds"
key   t2                  int     -  "IA: T2, seconds"
list  ia_options          "IA: its options"
key   ia_option_code      int     -  "IA option code (5 IA address, 26 IA prefix, 13 status)"
key   ia_address          string  -  "IA address: the IPv6 address, as hexadecimal digits"
key   ia_prefix           string  -  "IA prefix: the prefix, as hexadecimal digits"
key   prefix_length       int     -  "IA prefix: prefix length"
key   preferred_lifetime  int     -  "preferred lifetime, seconds"
key   valid_lifetime      int     -  "valid lifetime, seconds"
list  addr_options        "IA address or prefix: its options"
key   addr_option_code    int     -  "IA address or prefix option code (13 status)"
list  addr_option_data    "an IA address or prefix option of another code, as octets"
list  ia_option_data      "an IA option of another code, as octets"
key   status_code         int     -  "status code (0 success, 1 unspecified failure, 2 no addresses available, 3 no binding, 4 not on link, 5 use multicast, 6 no prefix available)"
list  status_message      "status message, UTF-8 octets"
list  requested_options   "ORO: the requested option codes"
key   requested_option    int     -  "one requested option code"
key   preference          int     -  "server preference, 0-255"
key   elapsed_time        int     -  "elapsed time, hundredths of a second"
list  dns_servers         "DNS recursive name servers"
key   dns_server          string  -  "one DNS server address, as hexadecimal digits"
key   seconds_value       int     -  "information refresh time (32), SOL_MAX_RT (82) or INF_MAX_RT (83), seconds"
list  option_data         "an option of another code, as octets"
key   octet               int     -  "one octet"
