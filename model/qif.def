# The qif module: QIF record lines. Written by tools/gen/finance-pack.py.
module        qif
version       0.1.0
distribution  public
source        "quiffen, https://github.com/isaacharrisholt/quiffen at commit 29658502eb3823f2a50a3365e95bf809a4841bb4, quiffen/core/transaction.py and qif.py (MIT License, Copyright (c) 2023 Isaac Harris-Holt); codes restated, no code copied"
list  lines                 "the record's lines, in order"
key   code                  int     -  "a line's code character, its ASCII code (68 D, 84 T, 94 ^ ...)"
key   date                  string  -  "D: the date, as written (formats vary: 01/31/2025, 31/01'25 ...)"
key   amount                string  -  "T: the amount, as written"
key   amount_u              string  -  "U: the amount (a second form some exporters write), as written"
key   memo                  string  -  "M: the memo"
key   cleared               string  -  "C: the cleared status (*, c, X, R or empty)"
key   payee                 string  -  "P: the payee"
key   payee_address         string  -  "A: a line of the payee's address"
key   category              string  -  "L: the category, or [account] for a transfer"
key   number                string  -  "N: the check number or reference"
key   split_category        string  -  "S: a split's category or [account]"
key   split_memo            string  -  "E: a split's memo"
key   split_amount          string  -  "$: a split's amount"
key   split_percent         string  -  "%: a split's percentage"
key   reimbursable          string  -  "F: reimbursable business expense flag"
key   first_payment_date    string  -  "1: loan first payment date"
key   loan_length           string  -  "2: loan length"
key   num_payments          string  -  "3: number of payments"
key   periods_per_annum     string  -  "4: periods per annum"
key   interest_rate         string  -  "5: interest rate"
key   current_loan_balance  string  -  "6: current loan balance"
key   original_loan_amount  string  -  "7: original loan amount"
key   invoice               string  -  "X: an invoice line (Quicken business versions)"
key   header                string  -  "!: a header line (Type:Bank, Type:Cash, Account ...), after the '!'"
key   end                   string  -  "^: the end of the record (normally empty after the '^')"
key   other                 string  -  "a line with another code: its value"
