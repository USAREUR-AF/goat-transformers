#!/usr/bin/env python3
"""repo-stats: count what this repository holds.

Prints the numbers that README.md quotes, counted from the tree: formats,
message kinds, model keys, conversion vectors, load vectors, wire types and
engines, and the size of the WebAssembly module when one has been built.

Usage:
  python3 -I tools/repo-stats             the totals
  python3 -I tools/repo-stats --formats   one Markdown table row per format
  python3 -I tools/repo-stats --json      the totals as JSON

How each number is counted:
  format             a directory under packs/ that holds a pack.def
  synthetic format   a format whose name starts with `conformance` or `demo-`;
                     these exercise the rules of the specification
  message kind       a `kind` line at the start of a line of a pack.def; a pack
                     with no `kind` line describes one message layout and
                     counts as one
  model key, list    a `key` or `list` line of a model/<module>.def
  conversion vector  a .json file under packs/<format>/vectors/
  load vector        a .json file under packs/conformance/load-vectors/
  wire type          a distinct value of the `wire` line of a pack.def
  engine             a directory under engines/

What it guarantees: every number is counted from the files of the tree each
time it runs; nothing is cached and nothing is typed in. It reads files and
runs nothing. Standard library only.

tools/tests/test_repo_stats.py compares README.md with this output, so a count
in README.md that no longer matches the tree fails the tests.
"""
import argparse
import json
import os
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
REPO = os.path.dirname(HERE)

WASM_BUILDS = [
    ("small", "bindings/wasm/target/wasm32-unknown-unknown/small/goat_transformers_wasm.wasm"),
    ("release", "bindings/wasm/target/wasm32-unknown-unknown/release/goat_transformers_wasm.wasm"),
]


def is_synthetic(name):
    """A pack that exercises the specification and stands for no real format."""
    return name.startswith("conformance") or name.startswith("demo-")


def read_pack(path):
    """-> (format, wire, kinds, first source) from one pack.def. Only a line
    that starts in the first column is read; a pack with no `kind` line is one
    message layout and counts as one kind."""
    fmt, wire, kinds, source = None, None, 0, ""
    with open(path, encoding="utf-8") as fh:
        for line in fh:
            tok = line.split()
            if not tok or line[0] in " \t#":
                continue
            if tok[0] == "format" and len(tok) > 1:
                fmt = tok[1]
            elif tok[0] == "wire" and len(tok) > 1:
                wire = tok[1]
            elif tok[0] == "kind":
                kinds += 1
            elif tok[0] == "source" and not source and len(tok) > 1:
                source = line.split(None, 1)[1].strip().strip('"')
    return fmt, wire, max(kinds, 1), source


def count_json(directory):
    """The number of .json files directly in `directory`; 0 when it is absent."""
    if not os.path.isdir(directory):
        return 0
    return sum(1 for n in os.listdir(directory) if n.endswith(".json"))


def subdirectories(directory):
    """The names of the directories directly in `directory`, sorted."""
    if not os.path.isdir(directory):
        return []
    return sorted(n for n in os.listdir(directory) if os.path.isdir(os.path.join(directory, n)))


def read_formats(packs_dir):
    """One row for each directory of `packs_dir` that holds a pack.def."""
    formats = []
    for name in subdirectories(packs_dir):
        pdef = os.path.join(packs_dir, name, "pack.def")
        if not os.path.isfile(pdef):
            continue
        fmt, wire, kinds, source = read_pack(pdef)
        formats.append({
            "pack": name,
            "format": fmt or name,
            "wire": wire or "",
            "kinds": kinds,
            "vectors": count_json(os.path.join(packs_dir, name, "vectors")),
            "synthetic": is_synthetic(name),
            "source": source,
        })
    return formats


def count_model(model_dir):
    """-> (modules, keys, lists): the .def files of `model_dir` and their
    `key` and `list` lines."""
    modules, keys, lists = 0, 0, 0
    for name in sorted(os.listdir(model_dir)) if os.path.isdir(model_dir) else []:
        if not name.endswith(".def"):
            continue
        modules += 1
        with open(os.path.join(model_dir, name), encoding="utf-8") as fh:
            for line in fh:
                tok = line.split()
                if tok and tok[0] == "key":
                    keys += 1
                elif tok and tok[0] == "list":
                    lists += 1
    return modules, keys, lists


def collect(root=REPO):
    """Count the tree at `root`. -> (one row per pack, the totals)"""
    packs_dir = os.path.join(root, "packs")
    formats = read_formats(packs_dir)
    modules, keys, lists = count_model(os.path.join(root, "model"))
    real = [f for f in formats if not f["synthetic"]]
    totals = {
        "formats": len(real),
        "synthetic_formats": len(formats) - len(real),
        "packs": len(formats),
        "message_kinds": sum(f["kinds"] for f in real),
        "model_modules": modules,
        "model_keys": keys,
        "model_lists": lists,
        "conversion_vectors": sum(f["vectors"] for f in formats),
        "load_vectors": count_json(os.path.join(packs_dir, "conformance", "load-vectors")),
        "wire_types": sorted({f["wire"] for f in formats if f["wire"]}),
        "engines": subdirectories(os.path.join(root, "engines")),
    }
    for label, rel in WASM_BUILDS:
        path = os.path.join(root, *rel.split("/"))
        if os.path.isfile(path):
            totals["wasm_%s_bytes" % label] = os.path.getsize(path)
    return formats, totals


def print_format_rows(formats):
    """One Markdown table row for each format that is not synthetic."""
    print("| Pack | Wire | Message kinds | Vectors | Written from |")
    print("|---|---|---:|---:|---|")
    for f in formats:
        if not f["synthetic"]:
            print("| `%s` | `%s` | %s | %s | %s |" % (
                f["pack"], f["wire"], format(f["kinds"], ","), format(f["vectors"], ","), f["source"]))


def print_totals(t):
    rows = [
        ("formats", format(t["formats"], ",")),
        ("synthetic formats", format(t["synthetic_formats"], ",")),
        ("packs (both)", format(t["packs"], ",")),
        ("message kinds", format(t["message_kinds"], ",")),
        ("model modules", format(t["model_modules"], ",")),
        ("model keys", format(t["model_keys"], ",")),
        ("model lists", format(t["model_lists"], ",")),
        ("conversion vectors", format(t["conversion_vectors"], ",")),
        ("load vectors", format(t["load_vectors"], ",")),
        ("wire types", "%d (%s)" % (len(t["wire_types"]), ", ".join(t["wire_types"]))),
        ("engines", "%d (%s)" % (len(t["engines"]), ", ".join(t["engines"]))),
    ]
    built = [(label, "wasm_%s_bytes" % label) for label, _ in WASM_BUILDS if "wasm_%s_bytes" % label in t]
    for label, key in built:
        rows.append(("wasm module, %s build" % label, "%s bytes" % format(t[key], ",")))
    if not built:
        rows.append(("wasm module", "not built (bindings/README.md states how)"))
    width = max(len(label) for label, _ in rows)
    for label, value in rows:
        print("%-*s  %s" % (width, label, value))


def main(argv=None, root=REPO):
    """Print the counts of the tree at `root` (the tree this tool is in).
    -> the exit status"""
    ap = argparse.ArgumentParser(
        prog="repo-stats",
        description="Count what this repository holds: the numbers README.md quotes, counted from the tree.",
    )
    ap.add_argument("--formats", action="store_true",
                    help="print one Markdown table row per format that is not synthetic, instead of the totals")
    ap.add_argument("--json", action="store_true",
                    help="print the totals as JSON; with --formats too, this is what is printed")
    args = ap.parse_args(argv)
    formats, totals = collect(root)
    if args.json:
        print(json.dumps(totals, indent=2))
    elif args.formats:
        print_format_rows(formats)
    else:
        print_totals(totals)
    return 0


if __name__ == "__main__":
    sys.exit(main())
