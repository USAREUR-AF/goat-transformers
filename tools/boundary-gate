BUILD_DIRS = {".git", "target", "zig-out", ".zig-cache", "zig-cache", "__pycache__", "build", "_build", "ebin"}

ALLOW_TAG = "boundary-allow:"
MIN_NEEDLE_CHARS = 4

Finding = collections.namedtuple("Finding", "check path line message")


# --------------------------------------------------------------------------
# The patterns. Each is built by concatenation so this file does not match
# its own patterns. Every pattern is matched against case-folded text.
# --------------------------------------------------------------------------

# Between the words of a marking: spaces, line breaks, hyphens, underscores,
# and the mark that starts a wrapped line of a comment or a quotation.
_GAP = r"[\s_-]+(?:(?:#+|//+|\*+|>+|;+|%+|\|+)[\s_-]*)?"


def _words(*words):
    return _GAP.join(words)


def _word(first, rest):
    """A marking of one word, as a word of prose: inside an identifier
    (`x_<word>_y`) it is a name that a public schema may use, and is not
    matched. Written first-letter-first so the search skips to that letter."""
    return first + r"(?<!\w" + first + ")" + rest + r"\b"


# (a string every match contains, the pattern, what it is)
PHRASES = [
    ("statement", _words("distribution", "statement") + r"[\s_:-]*[b-f]\b", "restricted distribution statement"),
    ("c" + "ui", _word("c", "ui"), "controlled-unclassified banner"),
    ("it" + "ar", _word("i", "tar"), "arms-regulation marking"),
    ("controlled", _words("export", "controlled"), "export-control marking"),
    ("control", _words("arms", "export", "control", "act"), "export-control warning"),
    ("no" + "forn", _word("n", "oforn"), "release marking"),
    ("fo" + "uo", _word("f", "ouo"), "handling marking"),
    ("proprietary", _words("proprietary", "information"), "proprietary banner"),
    ("confidential", _words("company", "confidential"), "proprietary banner"),
]
PHRASES = [(hint, re.compile(p), why) for hint, p, why in PHRASES]

HYGIENE = [
    ("/" + "users/", "/" + "users/", "local absolute path"),
    ("/" + "home/", "/" + r"home/[a-z0-9_][a-z0-9_.-]*/", "local absolute path"),
    ("desert" + "goat", "desert" + "goat", "private organization name"),
    # The at-sign first, then a look back at the character before it, so the
    # search skips from one at-sign to the next.
    ("@", "@" + r"(?<=[a-z0-9._%+-]@)[a-z0-9-]+(?:\.[a-z0-9-]+)*\.[a-z]{2,}\b", "email address"),
]
HYGIENE = [(hint, re.compile(p), why) for hint, p, why in HYGIENE]

# What an .svg may not hold. A reference is checked separately: it must point
# inside the file.
SVG_REFUSED = [
    (re.compile(r"<\s*script"), "a script element"),
    (re.compile(r"<\s*foreignobject"), "a foreignObject element"),
    (re.compile(r"\son[a-z]+\s*=\s*[\"']"), "an event handler attribute"),
    (re.compile(r"@import"), "a style sheet import"),
    (re.compile(r"<\?xml-stylesheet"), "a style sheet reference"),
    (re.compile(r"<!entity"), "an entity declaration"),
    (re.compile(r"data:\s*[a-z]+/[a-z0-9.+-]+\s*[;,]"), "a data: URI"),
]
_SVG_REFERENCE = re.compile(r"""(?:href|src)\s*=\s*(?:"([^"]*)"|'([^']*)')|url\(\s*["']?([^)"']*)""")


# --------------------------------------------------------------------------
# Which files
# --------------------------------------------------------------------------

def _git_paths(root, *options):
    out = subprocess.run(
        ["git", "-C", root, "ls-files", "-z", *options], check=True, capture_output=True,
    ).stdout
    return {p for p in out.decode("utf-8", "surrogateescape").split("\0") if p}


def discover(root):
    """The files git would commit from `root`: tracked files and untracked
    files that are not ignored, less the files deleted from the working tree.
    Where `root` is not a git checkout (or git is absent), every file under it
    outside the build directories. Paths are relative, `/`-separated, sorted."""
    try:
        listed = _git_paths(root, "--cached", "--others", "--exclude-standard")
        return sorted(listed - _git_paths(root, "--deleted"))
    except (OSError, subprocess.CalledProcessError):
        pass
    files = []
    for folder, dirs, names in os.walk(root):
        dirs[:] = [d for d in dirs if d not in BUILD_DIRS]
        for name in names:
            files.append(os.path.relpath(os.path.join(folder, name), root).replace(os.sep, "/"))
    return sorted(files)


# --------------------------------------------------------------------------
# marking and closure
# --------------------------------------------------------------------------

_UNQUOTED_TOKEN = re.compile(r"[^ \t\r\n]+")


def tokens(line):
    """The pack.def and model .def tokenizer (spec/engine-spec.md): whitespace
    separates tokens, double quotes group, `#` at the start of a token begins
    a comment."""
    if '"' not in line:
        out = _UNQUOTED_TOKEN.findall(line)
        for i, token in enumerate(out):
            if token[0] == "#":
                return out[:i]
        return out
    out, cur, quoted, started = [], "", False, False
    for c in line:
        if quoted:
            if c == '"':
                quoted = False
            else:
                cur += c
        elif c == '"':
            quoted, started = True, True
        elif c in " \t\r\n":
            if started:
                out.append(cur)
                cur, started = "", False
        elif c == "#" and not started:
            break
        else:
            cur += c
            started = True
    if started:
        out.append(cur)
    return out


def directives(path):
    """-> [(line number, tokens)] for each line of a .def file that holds any."""
    rows = []
    with open(path, encoding="utf-8") as fh:
        for number, line in enumerate(fh, 1):
            toks = tokens(line)
            if toks:
                rows.append((number, toks))
    return rows


def _values(rows, keyword):
    """The first argument of every `keyword` line that has one."""
    return [toks[1] for _, toks in rows if toks[0] == keyword and len(toks) > 1]


def _read_directives(root, path, findings):
    try:
        return directives(os.path.join(root, path))
    except (OSError, UnicodeDecodeError) as e:
        findings.append(Finding("marking", path, 0, "unreadable: %s" % type(e).__name__))
        return None


# The public example of an overlay: its formats are invented, and it marks them
# as an overlay does to show the mechanics. prefix: what the name of each of its
# modules and formats begins with. core: the tree whose modules it may use.
ExampleOverlay = collections.namedtuple("ExampleOverlay", "prefix core")


def _marking(name, example):
    """The distribution a module or a format of this name must state."""
    if example and re.match(re.escape(example.prefix) + r"(?![a-z0-9])", name):
        return "controlled"
    return "public"


# Inputs of the tool vectors and of the generator tests: whole small trees, with
# .def files of any shape below them. Their marking is still read.
DEF_FIXTURES = ("packs/conformance/tool-fixtures/", FIXTURE_DIR)


def check_def_paths(root, files):
    """The marking check on every .def file that is not model/<name>.def or
    packs/<format>/pack.def: there is none, so that no marking is in a place
    the checks below do not read. A fixture states no marking but `public`."""
    findings = []
    for path in files:
        if extension(path) != "def" or re.fullmatch(r"model/[^/]+\.def|packs/[^/]+/pack\.def", path):
            continue
        if not path.startswith(DEF_FIXTURES):
            findings.append(Finding("marking", path, 0, "a .def file is model/<name>.def or packs/<format>/pack.def"))
            continue
        for number, toks in _read_directives(root, path, findings) or ():
            if toks[0] == "distribution" and toks[1:] != ["public"]:
                findings.append(Finding("marking", path, number, "a fixture states no distribution but `public`"))
    return findings


def check_modules(root, files, example=None):
    """The marking check on model/*.def. -> ({module name: its keys}, findings)"""
    modules, findings = {}, []
    for path in files:
        if os.path.dirname(path) != "model" or not path.endswith(".def"):
            continue
        rows = _read_directives(root, path, findings)
        if rows is None:
            continue
        names = _values(rows, "module")
        if not names:
            findings.append(Finding("marking", path, 0, "model module has no `module` line"))
            continue
        name = names[0]
        if len(names) > 1:
            findings.append(Finding("marking", path, 0, "more than one `module` line"))
        distribution = _values(rows, "distribution")
        # The file and the module must both carry the prefix.
        markings = {_marking(n, example) for n in names + [os.path.basename(path)[:-len(".def")]]}
        wanted = "controlled" if markings == {"controlled"} else "public"
        if distribution != [wanted]:
            findings.append(Finding(
                "marking", path, 0, "model module `%s` must say `distribution %s` exactly once (has %s)"
                % (name, wanted, distribution or "none")))
        if not _values(rows, "source"):
            findings.append(Finding("marking", path, 0, "model module `%s` has no `source` line" % name))
        modules[name] = set(_values(rows, "key"))
    return modules, findings


def check_packs(root, files, modules, example=None):
    """The marking and closure checks on packs/<format>/pack.def. -> findings"""
    findings = []
    for path in files:
        parts = path.split("/")
        if len(parts) != 3 or parts[0] != "packs" or parts[2] != "pack.def":
            continue
        rows = _read_directives(root, path, findings)
        if rows is None:
            continue
        distribution = _values(rows, "distribution")
        formats = _values(rows, "format")
        if len(formats) > 1:
            findings.append(Finding("marking", path, 0, "more than one `format` line"))
        # The format and the directory must both carry the prefix.
        markings = {_marking(name, example) for name in formats + [parts[1]]}
        wanted = "controlled" if markings == {"controlled"} else "public"
        if distribution != [wanted]:
            findings.append(Finding(
                "marking", path, 0, "pack must say `distribution %s` exactly once (has %s)"
                % (wanted, distribution or "none")))
        if not _values(rows, "source"):
            findings.append(Finding("marking", path, 0, "pack has no `source` line"))
        used = {"core"} | set(_values(rows, "uses"))
        for module in sorted(used - set(modules)):
            findings.append(Finding("closure", path, 0, "uses model module `%s`, which is not in model/" % module))
        for number, toks in rows:
            if toks[0] != "field" or len(toks) < 2:
                continue
            module, key = toks[1].split(".", 1) if "." in toks[1] else ("core", toks[1])
            if module not in used:
                findings.append(Finding("closure", path, number, "maps `%s` without `uses %s`" % (toks[1], module)))
            elif module in modules and key not in modules[module]:
                findings.append(Finding(
                    "closure", path, number, "maps `%s`, which model module `%s` does not declare" % (toks[1], module)))
    return findings


# --------------------------------------------------------------------------
# filetype
# --------------------------------------------------------------------------

def extension(path):
    """The lower-case extension of a path; a dot file with no other dot
    (`.gitignore`) has its name as its extension; "" when there is none."""
    base = os.path.basename(path)
    if base.startswith(".") and "." not in base[1:]:
        return base[1:].lower()
    return base.rsplit(".", 1)[1].lower() if "." in base.lstrip(".") else ""


def check_filetype(path):
    """-> findings: the file's name is not on the allowlist."""
    ext = extension(path)
    if os.path.basename(path) in ALLOWED_BARE or ext in ALLOWED_EXT:
        return []
    if ext in FIXTURE_EXT and path.startswith(FIXTURE_DIR):
        return []
    if ext in SITE_EXT and path.startswith(SITE_DIR):
        return []
    return [Finding("filetype", path, 0, "file type not on the allowlist (%s)" % (ext or "no extension"))]


def check_svg(path, view):
    """-> findings: an .svg that can run code, embed data or reach outside
    itself. `view` is the case-folded text of the file."""
    held = set()  # (line, what)
    for pattern, what in SVG_REFUSED:
        for m in pattern.finditer(view):
            held.add((view.line_of(m.start()), what))
    for m in _SVG_REFERENCE.finditer(view):
        target = next(g for g in m.groups() if g is not None).strip()
        if not target.startswith("#"):
            what = "a data: URI" if target.startswith("data:") else "a reference outside the file"
            held.add((view.line_of(m.start()), what))
    return [Finding("filetype", path, line, "svg holds %s" % what) for line, what in sorted(held)]


# --------------------------------------------------------------------------
# Text as it is matched
# --------------------------------------------------------------------------

_JSON_ESCAPE = re.compile(r"\\u(d[89ab][0-9a-f]{2})\\u(d[c-f][0-9a-f]{2})|\\u([0-9a-f]{4})", re.I)


def _decode_json_escape(m):
    if m.group(3) is None:  # a surrogate pair: one character outside the basic plane
        high, low = int(m.group(1), 16), int(m.group(2), 16)
        return chr(0x10000 + ((high - 0xD800) << 10) + (low - 0xDC00))
    code = int(m.group(3), 16)
    if code < 0x20 or 0xD800 <= code <= 0xDFFF:
        return " "  # a control character or half a pair: a separator, and never a new line
    return chr(code)


def plain(text):
    """`text` with JSON `\\uXXXX` escapes read as their characters and Unicode
    in one form (NFKC). Case and line breaks are kept."""
    if "\\u" in text or "\\U" in text:
        text = _JSON_ESCAPE.sub(_decode_json_escape, text)
    return text if text.isascii() else unicodedata.normalize("NFKC", text)


def fold(text):
    """Plain text with case folded, so that two spellings of one text are equal."""
    if text.isascii():
        return text.lower()
    return unicodedata.normalize("NFKC", text.casefold())


class View(str):
    """Plain text, case folded, that can name the line of a position in it."""

    _starts = None

    def line_of(self, position):
        """The 1-based number of the line that holds `position`."""
        if self._starts is None:
            self._starts = [m.end() for m in re.finditer("\n", self)]
        return bisect.bisect_right(self._starts, position) + 1


# --- words -----------------------------------------------------------------
# A word is a run of letters and digits. An identifier is read twice: whole
# (`trackNumber`), and as its parts (`track`, `Number`). A part ends before a
# capital that follows a small letter or a digit, and before the last capital
# of a run that a small letter follows (`XMLParser` is `XML`, `Parser`).

_ASCII_WHOLE = re.compile(r"[A-Za-z0-9]+")
_ASCII_PARTS = re.compile(r"[A-Z]?[a-z0-9]+|[A-Z]+(?![a-z])[a-z0-9]*")

# Scripts written without spaces between words: each character is a word.
_UNSPACED = (
    "฀-໿က-႟ក-៿぀-ヿㇰ-ㇿ"
    "㐀-䶿一-鿿가-힯豈-﫿\U00020000-\U0003134f"
)


@functools.lru_cache(maxsize=None)
def _unicode_tokenizers():
    """`_ASCII_WHOLE` and `_ASCII_PARTS` for every script."""
    letters = [chr(c) for c in range(0x80, 0x20000)]
    upper = "A-Z" + "".join(c for c in letters if c.isupper())
    lower = "a-z" + "".join(c for c in letters if c.islower())
    small = "(?:(?![%s%s])[^\\W_])" % (upper, _UNSPACED)  # a letter or digit that is not a capital
    whole = "[%s]|(?:(?![%s])[^\\W_])+" % (_UNSPACED, _UNSPACED)
    parts = "[%s]|[%s]?%s+|[%s]+(?![%s])%s*" % (_UNSPACED, upper, small, upper, lower, small)
    return re.compile(whole), re.compile(parts)


def tokenizers(text):
    """-> (whole, parts): the two compiled patterns that find the words of `text`."""
    return (_ASCII_WHOLE, _ASCII_PARTS) if text.isascii() else _unicode_tokenizers()


def fold_words(words):
    """Each word case folded, in one pass."""
    words = list(words)
    return fold("\n".join(words)).split("\n") if words else []


# --------------------------------------------------------------------------
# needle
# --------------------------------------------------------------------------

class Needles:
    """The needle list, indexed for matching. A needle is kept as its words;
    nothing here can print one."""

    def __init__(self):
        self.single = {}    # word -> needle line, for needles of one word
        self.phrases = {}   # longest word -> [(words, set of words, needle line)], for the others
        self.length = {}    # needle line -> characters in the needle
        self._owner = {}  # (form, the text between its words) -> the needle line it is indexed under
        # The keys of the two indexes as sets: a set meets a set in the time
        # of the smaller, and a file has far fewer distinct words than the list.
        self._single_words = set()
        self._phrase_keys = set()

    def __len__(self):
        return len(self.length)

    def add(self, number, needle):
        """Index the needle on line `number`. -> why it cannot be used, or None"""
        if len(needle) < MIN_NEEDLE_CHARS:
            return "needle is shorter than %d characters" % MIN_NEEDLE_CHARS
        gaps = self._gaps(needle)
        forms = set(gaps)
        if () in forms:
            return "needle holds no letter or digit"
        # Two needles are the same only when their words AND what stands between
        # the words agree: `a_b` and `a-b` are two needles, matched separately.
        new = {form: {g for g in gaps[form] if (form, g) not in self._owner} for form in forms}
        if not any(new.values()):
            return None  # the same needle as an earlier line
        self.length[number] = len(needle)
        for form in sorted(forms):
            if not new[form]:
                continue
            self._owner.update(((form, g), number) for g in new[form])
            if len(form) == 1:
                self.single[form[0]] = number
                self._single_words.add(form[0])
            else:
                # Filed under its longest word, the one fewest files hold.
                key = max(form, key=len)
                self.phrases.setdefault(key, []).append((list(form), frozenset(form), number, new[form]))
                self._phrase_keys.add(key)
        return None

    @staticmethod
    def _gaps(needle):
        """-> {form: {(the text between word i and word i + 1, ...)}}: the
        words of a needle, and what stands between them"""
        text, gaps = plain(needle), {}
        for tokenizer in tokenizers(text):
            found = list(tokenizer.finditer(text))
            form = tuple(fold_words(m.group(0) for m in found))
            gaps.setdefault(form, set()).add(
                tuple(text[found[i].end():found[i + 1].start()] for i in range(len(found) - 1)))
        return gaps

    def finds(self, needle):
        """True when `needle`, alone on a line of text, is matched as itself:
        as the needle it is indexed under, not by a shorter needle it holds."""
        owners = {self._owner.get((form, g)) for form, seen in self._gaps(needle).items() for g in seen}
        hits = set().union(*self.lines_matched(plain(needle)).values())
        return None not in owners and bool(hits & owners)

    def _candidates(self, text):
        """The needles that may occur in `text`, judged from the set of its
        words alone. -> (words that are needles, {first word: needles of
        several words whose every word is present})"""
        whole, parts = tokenizers(text)
        distinct = set(whole.findall(text))
        present = set(fold_words(distinct))
        present.update(fold_words(parts.findall("\n".join(distinct))))
        phrases = {}
        for key in present & self._phrase_keys:
            for candidate in self.phrases[key]:
                if candidate[1] <= present:
                    phrases.setdefault(candidate[0][0], []).append(candidate)
        return present & self._single_words, phrases

    def lines_matched(self, text):
        """-> {line of `text`: the needle lines that match on it}. `text` is
        plain text. A needle of several words is reported on the line of its
        first word."""
        single, phrases = self._candidates(text)
        matched = {}
        if not single and not phrases:
            return matched
        lines = text.split("\n")
        for tokenizer in tokenizers(text):
            words, line_of_word, spans = [], [], []
            offset = 0
            for number, line in enumerate(lines, 1):
                for m in tokenizer.finditer(line):
                    words.append(m.group(0))
                    line_of_word.append(number)
                    spans.append((offset + m.start(), offset + m.end()))
                offset += len(line) + 1
            words = fold_words(words)
            for i, word in enumerate(words):
                if word in single:
                    matched.setdefault(line_of_word[i], set()).add(self.single[word])
                for form, _, number, needle_gaps in phrases.get(word, ()):
                    if words[i:i + len(form)] == form and _gaps_join(text, spans, i, len(form), needle_gaps):
                        matched.setdefault(line_of_word[i], set()).add(number)
        return matched


# What may stand between two words of a needle in the text: spaces and tabs,
# at most one line break, and after it the comment or quote mark that starts
# a wrapped line. `_`, `-`, `.` and the like join words only where the needle
# itself has them in that place.
_NEEDLE_GAP = re.compile(r"[ \t]*(?:\r?\n[ \t]*(?:(?:#+|//+|\*+|>+|;+|%+|\|+)[ \t]*)?)?")


def _gaps_join(text, spans, i, n, needle_gaps):
    """True when every gap between the `n` words of `text` from word `i` on is
    one `_NEEDLE_GAP` allows, or is the needle's own separator at that place."""
    for j in range(n - 1):
        gap = text[spans[i + j][1]:spans[i + j + 1][0]]
        if gap and _NEEDLE_GAP.fullmatch(gap):
            continue
        if any(own[j] == gap for own in needle_gaps):
            continue
        return False
    return True


def load_needles(path):
    """Read the needle file. -> (Needles, findings). An unreadable file, a
    needle that cannot be used and a file with no needle are findings."""
    needles, findings = Needles(), []
    try:
        with open(path, encoding="utf-8") as fh:
            lines = fh.read().split("\n")
    except (OSError, UnicodeDecodeError) as e:
        return needles, [Finding("needle", path, 0, "cannot read needle file: %s" % type(e).__name__)]
    for number, line in enumerate(lines, 1):
        needle = line.strip()
        if needle:
            problem = needles.add(number, needle)
            if problem:
                findings.append(Finding("needle", path, number, problem))
    if not needles and not findings:
        findings.append(Finding("needle", path, 0, "needle file is empty: refusing to pass"))
    for number in unmatched(needles, lines):
        findings.append(Finding(
            "needle", path, number, "the matcher does not find this needle where it stands alone: refusing to pass"))
    return needles, findings


def unmatched(needles, lines):
    """The self-check of the matcher: each needle of the file, alone on a line
    of text, must be found as itself. -> the numbers of the lines that are
    not. A needle that cannot be used is a finding already."""
    missed = []
    for number, line in enumerate(lines, 1):
        needle = line.strip()
        if len(needle) >= MIN_NEEDLE_CHARS and () not in needles._gaps(needle) and not needles.finds(needle):
            missed.append(number)
    return missed


def check_needles(path, text, needles, in_text=True, waiver=None, waived=None):
    """-> findings: one for each line of plain `text` that holds a needle.
    With a `waiver`, each needle of a line that the waiver accepts is appended
    to `waived` instead, and the finding names only the needles left."""
    matched = needles.lines_matched(text)
    findings = []
    for line in sorted(matched):
        numbers, note = matched[line], ""
        if waiver is not None:
            kept, accepted, note = waiver.judge(path, numbers)
            for number in sorted(accepted):
                waived.append(Waived(path, line, number, needles.length[number], accepted[number]))
            numbers = kept
            if not numbers:
                continue
        first = min(numbers)
        more = len(numbers) - 1
        findings.append(Finding(
            "needle", path, line if in_text else 0,
            "%s matches the needle on line %d of the needle file (%d characters)%s%s" % (
                "text" if in_text else "file path", first, needles.length[first],
                "; %d more needles match here" % more if more else "", note)))
    return findings


# --------------------------------------------------------------------------
# The waiver for generated packs
# --------------------------------------------------------------------------
# A generated public pack restates the names of a public upstream schema, and
# such a name can be a needle. A hit is waived when the same needle matches,
# with the matcher above, in an upstream source file the pack's provenance
# cites and the file's SHA-256 is the recorded one. The source files are not
# in this repository; the gate looks for them under the directories of
# GOAT_GEN_SOURCES and under tools/gen/sources/ (ignored by git).

Waived = collections.namedtuple("Waived", "path line needle length pack")

GEN_SOURCES_ENV = "GOAT_GEN_SOURCES"
SOURCES_DIR = "tools/gen/sources"
# Packs of synthetic formats: no upstream source, never waived.
SYNTHETIC_PACKS = ("conformance", "demo-")

# The generator a header names: `Generated by tools/gen/x.py`, or, for a model
# module that several generated packs extend, `Last extended ... by tools/gen/x.py`.
_GENERATOR = re.compile(r"\b(?:generated|extended)\b[^.]*?\bby\s+`?(tools/gen/[A-Za-z0-9_.-]*[A-Za-z0-9_])", re.I)
# A run script of a generator that a pack's own files name.
_RUN_SCRIPT = re.compile(r"tools/gen/[A-Za-z0-9_.-]+-run\.(?:sh|py)\b")
_SHA256 = re.compile(r"(?<![0-9A-Fa-f])[0-9A-Fa-f]{64}(?![0-9A-Fa-f])")
# `<sha256> <path>`, as sha256sum writes it (a `*` marks binary mode).
_SUM_LINE = re.compile(r"\s*(?:[-*]\s+)?`?([0-9A-Fa-f]{64})`?[ \t]+\*?`?([^`\s]+)`?\s*")
_CODE_SPAN = re.compile(r"`([^`\n]+)`")
_URL = re.compile(r"https?://[^\s<>()`|\"']+")
_BAD_PATH = re.compile(r"[\x00-\x1f\\:*?\"<>|]|://")


def header_generator(path):
    """The `tools/gen/...` generator that the leading comment lines of a .def
    file name, or None. The header ends at the first line that is neither a
    comment nor blank; wrapped comment lines are read as one text."""
    words = []
    try:
        with open(path, encoding="utf-8") as fh:
            for line in fh:
                stripped = line.strip()
                if stripped.startswith("#"):
                    words.append(stripped.lstrip("#").strip())
                elif stripped:
                    break
    except (OSError, UnicodeDecodeError):
        return None
    m = _GENERATOR.search(" ".join(words))
    return m.group(1) if m else None


def _source_path(candidate):
    """A record's path as a relative path, or None when it cannot be one."""
    candidate = candidate.strip().strip("`").strip()
    if candidate.startswith("./"):
        candidate = candidate[2:]
    if not candidate or candidate.startswith("/") or _BAD_PATH.search(candidate):
        return None
    if any(part in ("", ".", "..") for part in candidate.split("/")):
        return None
    return candidate


def _names_in(text, cells=True):
    """The paths a line, a table row or a paragraph names: its code spans, the
    table cells of one word, and the last segment of each web address; less
    the hashes."""
    names = []
    for span in _CODE_SPAN.findall(text):
        if not _SHA256.fullmatch(span.strip()):
            names.append(span)
    for line in text.split("\n") if cells else ():
        if line.lstrip().startswith("|"):
            # A table cell of one word with no code span: `| LICENSE | ... |`.
            names += [c.strip() for c in line.strip().strip("|").split("|")
                      if c.strip() and "`" not in c and not re.search(r"\s", c.strip())
                      and not _SHA256.fullmatch(c.strip()) and not set(c.strip()) <= set("-:")]
    for url in _URL.findall(text):
        tail = url.rstrip(".,;:").split("?")[0].split("#")[0].rstrip("/")
        if tail.count("/") > 2:
            names.append(tail.rsplit("/", 1)[1])
    return [p for p in map(_source_path, names) if p]


def sha256_records(text):
    """-> [(sha256, [path])]: the SHA-256 records of a provenance file.

    A record is a SHA-256 written as 64 hexadecimal digits, with the paths
    that name it:
      - a line `<sha256> <path>` (sha256sum output, in a fenced block or in a
        plain list): the rest of the line;
      - a hash on a table row or another line: the code spans, the table
        cells of one word and the last segment of each web address on that
        row or line; when it has no code span and no web address, also
        those of the whole table, or of the paragraph, that holds it.
    A path that is absolute, holds `..`, a backslash or a drive letter, or is
    a web address is not a path and is dropped."""
    records = []
    lines = text.split("\n")
    i = 0
    while i < len(lines):
        table = lines[i].lstrip().startswith("|")
        if table:
            end = i
            while end < len(lines) and lines[end].lstrip().startswith("|"):
                end += 1
            block = lines[i:end]
        else:
            end = i
            while end < len(lines) and lines[end].strip() and not lines[end].lstrip().startswith("|"):
                end += 1
            end = max(end, i + 1)
            block = lines[i:end]
        whole = None
        for line in block:
            hashes = _SHA256.findall(line)
            if not hashes:
                continue
            m = _SUM_LINE.fullmatch(line)
            if m and not table:
                path = _source_path(m.group(2))
                if path:
                    records.append((m.group(1).lower(), [path]))
                continue
            names = _names_in(line)
            if not _names_in(line, cells=False):
                if whole is None:
                    whole = _names_in("\n".join(block))
                names = list(dict.fromkeys(names + whole))
            for digest in hashes:
                records.append((digest.lower(), list(names)))
        i = end
    return records


def source_roots(root):
    """The directories the cited source files are looked for under: those of
    GOAT_GEN_SOURCES (separated by os.pathsep), then tools/gen/sources/."""
    roots = [os.path.abspath(d) for d in os.environ.get(GEN_SOURCES_ENV, "").split(os.pathsep) if d]
    roots.append(os.path.join(root, *SOURCES_DIR.split("/")))
    return list(dict.fromkeys(roots))


class Waiver:
    """Decides, needle by needle, whether a hit in a generated public pack is
    waived. Everything is worked out on the first hit that needs it."""

    def __init__(self, root, files, needles):
        self.root = root
        self.files = set(files)
        self.needles = needles
        self.roots = source_roots(root)
        self._packs = {}        # pack name -> its generator, or None
        self._modules = None    # module file -> [pack names]
        self._cited = {}        # pack name -> Cited
        self._records = {}      # provenance file -> records
        self._hashes = {}       # full path -> sha256, or None
        self._held = {}         # full path -> needle lines its text holds
        self._texts = {}        # repository file -> its text
        # The provenance files kept beside the sources, as (path, family).
        self._family = []
        for path in sorted(self.files):
            folder, _, name = path.rpartition("/")
            if folder == SOURCES_DIR:
                family = name[:-len("-PROVENANCE.md")] if name.endswith("-PROVENANCE.md") else name.rsplit(".", 1)[0]
                self._family.append((path, name, family))

    # --- which files ---------------------------------------------------------

    def generator(self, pack):
        """The generator of packs/<pack>/pack.def when it is generated, else None."""
        if pack not in self._packs:
            gen = None
            path = "packs/%s/pack.def" % pack
            if path in self.files and not pack.startswith(SYNTHETIC_PACKS):
                gen = header_generator(os.path.join(self.root, path))
                if gen not in self.files:
                    gen = None
            self._packs[pack] = gen
        return self._packs[pack]

    def owners(self, path):
        """The generated packs whose cited sources may waive a hit in `path`:
        the pack itself for a file under packs/<pack>/; for model/<m>.def
        whose header names a generator, every generated pack of that same
        generator that `uses` the module. Empty for every other file."""
        parts = path.split("/")
        if len(parts) >= 3 and parts[0] == "packs":
            return [parts[1]] if self.generator(parts[1]) else []
        if len(parts) == 2 and parts[0] == "model" and path.endswith(".def"):
            if self._modules is None:
                self._modules = self._module_owners()
            return self._modules.get(path, [])
        return []

    def _module_owners(self):
        modules = {}  # module name -> (file, generator)
        for path in self.files:
            parts = path.split("/")
            if len(parts) != 2 or parts[0] != "model" or not path.endswith(".def"):
                continue
            gen = header_generator(os.path.join(self.root, path))
            if gen not in self.files:
                continue
            try:
                names = _values(directives(os.path.join(self.root, path)), "module")
            except (OSError, UnicodeDecodeError):
                continue
            if names:
                modules[names[0]] = (path, gen)
        owners = {}
        for path in sorted(self.files):
            parts = path.split("/")
            if len(parts) != 3 or parts[0] != "packs" or parts[2] != "pack.def":
                continue
            gen = self.generator(parts[1])
            if not gen:
                continue
            try:
                used = _values(directives(os.path.join(self.root, path)), "uses")
            except (OSError, UnicodeDecodeError):
                continue
            for name in used:
                if name in modules and modules[name][1] == gen:
                    owners.setdefault(modules[name][0], []).append(parts[1])
        return owners

    # --- which sources -------------------------------------------------------

    def cited(self, pack):
        """-> Cited: the provenance files of a generated pack, its records and
        the needle lines its verified sources hold."""
        if pack not in self._cited:
            self._cited[pack] = self._cite(pack)
        return self._cited[pack]

    def _read(self, path, keep=False):
        """The text of a repository file ("" when unreadable); kept when
        `keep`, for the generator scripts that many packs share."""
        if path in self._texts:
            return self._texts[path]
        try:
            with open(os.path.join(self.root, path), encoding="utf-8") as fh:
                text = fh.read()
        except (OSError, UnicodeDecodeError):
            text = ""
        if keep:
            self._texts[path] = text
        return text

    def _cite(self, pack):
        own = ["packs/%s/%s" % (pack, name) for name in ("pack.def", "pack.md", "PROVENANCE.md")]
        own_text = "\n".join(self._read(p) for p in own if p in self.files)
        # The generator, and the run scripts the pack's own files name.
        scripts = {self.generator(pack)} | {s for s in _RUN_SCRIPT.findall(own_text) if s in self.files}
        named_text = own_text + "\n" + "\n".join(self._read(s, keep=True) for s in sorted(scripts))
        provenance = []
        if "packs/%s/PROVENANCE.md" % pack in self.files:
            provenance.append(("packs/%s/PROVENANCE.md" % pack, pack))
        for path, name, family in self._family:
            if name in named_text and re.search(r"(?<![\w.-])%s(?![\w-])" % re.escape(name), named_text):
                provenance.append((path, family))
        records, verified, held = 0, 0, set()
        for path, family in provenance:
            for digest, names in self._records_of(path):
                records += 1
                found = self._locate(digest, names, ("", pack, family))
                if found:
                    verified += 1
                    held |= self._held_by(found)
        return Cited([p for p, _ in provenance], records, verified, held)

    def _records_of(self, path):
        if path not in self._records:
            self._records[path] = sha256_records(self._read(path, keep=False))
        return self._records[path]

    def _locate(self, digest, names, prefixes):
        """The full path of a file a record names whose SHA-256 is `digest`, or None."""
        for base in self.roots:
            for prefix in dict.fromkeys(prefixes):
                for name in names:
                    full = os.path.join(base, *(prefix.split("/") if prefix else []), *name.split("/"))
                    if self._sha256(full) == digest:
                        return full
        return None

    def _sha256(self, full):
        if full not in self._hashes:
            digest = None
            if os.path.isfile(full):
                try:
                    with open(full, "rb") as fh:
                        digest = hashlib.sha256(fh.read()).hexdigest()
                except OSError:
                    pass
            self._hashes[full] = digest
        return self._hashes[full]

    def _held_by(self, full):
        """The needle lines that match in a source file, read as public text is."""
        if full not in self._held:
            text, problem = read_text(full)
            held = set()
            if not problem:
                for numbers in self.needles.lines_matched(plain(text)).values():
                    held |= numbers
            self._held[full] = frozenset(held)
        return self._held[full]

    # --- the decision ----------------------------------------------------------

    def judge(self, path, numbers):
        """-> (needle lines kept as findings, {waived needle line: the pack
        whose source holds it}, a note for the finding)."""
        owners = self.owners(path)
        if not owners:
            return set(numbers), {}, ""
        accepted = {}
        for number in sorted(numbers):
            for pack in owners:
                if number in self.cited(pack).held:
                    accepted[number] = pack
                    break
        kept = set(numbers) - set(accepted)
        if not kept:
            return kept, accepted, ""
        cites = [self.cited(pack) for pack in owners]
        files = list(dict.fromkeys(p for c in cites for p in c.files))
        records = sum(c.records for c in cites)
        verified = sum(c.verified for c in cites)
        named = ", ".join(files[:3]) + (" and %d more" % (len(files) - 3) if len(files) > 3 else "")
        if not records:
            note = "; no hit in this generated pack is waived: %s" % (
                "%s records no SHA-256 of a source" % named if named else "it has no PROVENANCE.md")
        elif verified < records:
            note = ("; the waiver for this generated pack needs the source files cited in %s under %s "
                    "(%d of %d present with the recorded SHA-256)" % (named, GEN_SOURCES_ENV, verified, records))
        else:
            note = "; none of the %d cited sources present with the recorded SHA-256 holds it" % verified
        return kept, accepted, note


Cited = collections.namedtuple("Cited", "files records verified held")


# --------------------------------------------------------------------------
# phrase and hygiene
# --------------------------------------------------------------------------

def _pattern_hits(view, patterns):
    """-> {(first line, last line, what)} for every match of `patterns`."""
    hits = set()
    for hint, pattern, what in patterns:
        if hint in view:
            for m in pattern.finditer(view):
                hits.add((view.line_of(m.start()), view.line_of(max(m.start(), m.end() - 1)), what))
    return hits


def check_phrases(path, view, exempt=frozenset(), in_text=True):
    """-> findings: a handling marking, its words on one line or wrapped over
    several. `exempt` holds the numbers of the lines that carry the allow tag."""
    return [
        Finding("phrase", path, first if in_text else 0, what)
        for first, last, what in sorted(_pattern_hits(view, PHRASES))
        if not all(line in exempt for line in range(first, last + 1))
    ]


def check_hygiene(path, view, exempt=frozenset()):
    """-> findings: a local path, a private organization name, an email address."""
    return [
        Finding("hygiene", path, first, what)
        for first, _, what in sorted(_pattern_hits(view, HYGIENE))
        if first not in exempt
    ]


# --------------------------------------------------------------------------
# One file
# --------------------------------------------------------------------------

def read_text(full):
    """-> (text, None), or (None, why the file is not text)."""
    try:
        with open(full, "rb") as fh:
            data = fh.read()
    except OSError as e:
        return None, "not readable as UTF-8 text: %s" % type(e).__name__
    return decode_text(data)


def decode_text(data):
    """-> (text, None), or (None, why the bytes are not text)."""
    try:
        text = data.decode("utf-8")
    except UnicodeDecodeError as e:
        return None, "not readable as UTF-8 text: %s" % type(e).__name__
    if "\0" in text:
        return None, "binary content"
    return text, None


def is_utf8(path):
    """False for a file name whose bytes are not UTF-8 (git and the file
    system hand such a name over with surrogate escapes)."""
    try:
        path.encode("utf-8")
    except UnicodeEncodeError:
        return False
    return True


def check_path(path, needles):
    """The phrase and needle checks on the name of a file. -> findings"""
    text = plain(path)
    findings = check_phrases(path, View(fold(text)), in_text=False)
    if needles:
        findings += check_needles(path, text, needles, in_text=False)
    return findings


def check_content(root, path, needles, waiver=None, waived=None):
    """The checks on what a file holds. -> findings. With a `waiver`, the
    needle hits it accepts are appended to `waived` instead."""
    text, problem = read_text(os.path.join(root, path))
    if problem:
        return [Finding("filetype", path, 0, problem)]
    return check_text(path, text, needles, waiver, waived)


def check_data(path, data, needles, waiver=None, waived=None):
    """check_content on bytes that git holds. Bytes that are not text are a
    finding, and their needles are findings too."""
    text, problem = decode_text(data)
    if problem:
        return [Finding("filetype", path, 0, problem)] + (check_bytes(path, data, needles, waiver, waived) if needles else [])
    return check_text(path, text, needles, waiver, waived)


def check_text(path, text, needles, waiver=None, waived=None):
    """The checks on the text of a file. -> findings"""
    exempt = frozenset()
    if ALLOW_TAG in text:
        exempt = frozenset(n for n, line in enumerate(text.split("\n"), 1) if ALLOW_TAG in line)
    text = plain(text)
    view = View(fold(text))
    findings = check_phrases(path, view, exempt) + check_hygiene(path, view, exempt)
    if extension(path) == "svg":
        findings += check_svg(path, view)
    if needles:
        findings += check_needles(path, text, needles, waiver=waiver, waived=waived)
    return findings


# --------------------------------------------------------------------------
# Commits: what a push publishes besides the tree at its tip
# --------------------------------------------------------------------------

def _git(root, *args, stdin=None):
    # Replacement objects and grafts would show another history than the one pushed.
    env = dict(os.environ, GIT_NO_REPLACE_OBJECTS="1")
    return subprocess.run(["git", "-C", root, *args], check=True, capture_output=True, input=stdin, env=env).stdout


def _objects(root, ids):
    """-> an iterator of (id, type, bytes) for each object id."""
    data = _git(root, "cat-file", "--batch", stdin="".join(i + "\n" for i in ids).encode())
    at = 0
    for wanted in ids:
        end = data.index(b"\n", at)
        head = data[at:end].decode("ascii", "replace").split(" ")
        if len(head) != 3:
            raise ValueError("object %s is missing" % wanted)
        size = int(head[2])
        yield head[0], head[1], data[end + 1:end + 1 + size]
        at = end + 1 + size + 1


def commits_of(root, spec):
    """The commits of `spec`: `BASE..TIP`, or `TIP` for its whole history.
    -> (the rev-list arguments, [commit ids])"""
    base, dots, tip = spec.partition("..")
    revs = [tip, "^" + base] if dots else [spec]
    if any(not r.lstrip("^") or r.lstrip("^").startswith("-") or ".." in r for r in revs):
        raise ValueError("not BASE..TIP or a commit")
    for r in revs:
        _git(root, "rev-parse", "--verify", "--quiet", "--end-of-options", r.lstrip("^") + "^{commit}")
    if _git(root, "rev-parse", "--is-shallow-repository").strip() != b"false":
        raise ValueError("the repository is shallow, so its history is not all here")
    return revs, _git(root, "rev-list", *revs, "--").decode().split()


def tag_texts(root, rev):
    """-> [(name, bytes)]: the annotated tag `rev` names and the tags it
    points to, or [] when `rev` is no tag object"""
    texts = []
    while _git(root, "cat-file", "-t", "--end-of-options", rev).decode().strip() == "tag":
        data = _git(root, "cat-file", "tag", rev)
        texts.append(("tag %s" % _git(root, "rev-parse", rev).decode().strip()[:12], data))
        rev = data.split(b"\n", 1)[0].split(b" ")[1].decode()
    return texts


def check_object_texts(texts, needles, needles_only=False):
    """The phrase and needle checks on commit and tag objects. -> findings"""
    findings = []
    for where, data in texts:
        text = plain(data.decode("utf-8", "replace").replace("\0", " "))
        if not needles_only:
            findings += check_phrases(where, View(fold(text)))
        if needles:
            findings += check_needles(where, text, needles)
    return findings


def check_refs(root, tags, names, needles, needles_only=False):
    """The checks on what a push publishes besides commits: annotated tags
    (each of `tags` must name one) and the names of the refs. -> findings"""
    findings = []
    for tag in tags:
        try:
            texts = tag_texts(root, tag)
            if not texts:
                raise ValueError("not an annotated tag")
            findings += check_object_texts(texts, needles, needles_only)
        except (OSError, ValueError, subprocess.CalledProcessError) as e:
            why = str(e) if isinstance(e, ValueError) else type(e).__name__
            findings.append(Finding("commit", "tag %s" % tag[:12], 0, "cannot read the tag: %s" % why))
    # A ref name with a needle is not printed: the finding names its place in the arguments.
    for number, name in enumerate(names, 1):
        where = "ref name %d" % number
        text = plain(name.encode("utf-8", "surrogateescape").decode("utf-8", "replace"))
        if not needles_only:
            findings += check_phrases(where, View(fold(text)), in_text=False)
        if needles:
            findings += [f._replace(message=f.message.replace("file path", "ref name", 1))
                         for f in check_needles(where, text, needles, in_text=False)]
    return findings


def check_commits(root, spec, needles, waiver=None, waived=None, needles_only=False, unpacked=None):
    """The checks on every commit of `spec`: its message, author and committer
    and the header lines of the commit, the path of every file it changes, and
    the content of every file that is not in BASE's history. Also the message
    of an annotated tag that TIP names. -> (findings, number of commits). The
    working tree plays no part, except that a waiver reads it."""
    findings = []
    try:
        revs, commits = commits_of(root, spec)
        if not commits:
            return [Finding("commit", spec, 0, "no commits in the range: refusing to pass")], 0
        blobs, texts, paths = {}, [], {}
        for commit in commits:
            # -m: a merge is compared with each of its parents, so what the
            # merge itself brought in is seen. -c core.quotePath has no effect with -z.
            raw = _git(root, "diff-tree", "-r", "-m", "--root", "--no-commit-id", "--no-renames", "-z", commit)
            fields = raw.decode("utf-8", "surrogateescape").split("\0")
            for meta, path in zip(fields[0::2], fields[1::2]):
                _, mode, _, blob, status = meta.lstrip(":").split(" ")
                paths.setdefault(path, commit)
                if status != "D" and mode != "160000":
                    blobs.setdefault(blob, {}).setdefault(path, commit)
        # A blob already in BASE's history is published already.
        known = set()
        for line in _git(root, "rev-list", "--objects", "--no-object-names", *revs, "--").decode().split():
            known.add(line)
        fresh = {b: where for b, where in blobs.items() if b in known}
        for oid, kind, data in _objects(root, commits):
            texts.append(("commit %s" % oid[:12], data))
        texts += tag_texts(root, revs[0])
        findings += check_object_texts(texts, needles, needles_only)
        for path, commit in sorted(paths.items()):
            if not is_utf8(path):
                if not needles_only:
                    findings.append(Finding("filetype", path, 0, "file name is not UTF-8 (commit %s)" % commit[:12]))
                path = path.encode("utf-8", "surrogateescape").decode("utf-8", "replace")
            for f in check_path(path, needles):
                if f.check == "needle" or not needles_only:
                    findings.append(f._replace(message=f.message + " (commit %s)" % commit[:12]))
        order = sorted(fresh)
        for start in range(0, len(order), 500):
            for oid, kind, data in _objects(root, order[start:start + 500]):
                for path, commit in sorted(fresh[oid].items()):
                    if needles_only:
                        if unpacked is not None and is_binary(data):
                            unpacked.append("%s (commit %s)" % (path, commit[:12]))
                        found = check_bytes(path, data, needles, waiver, waived)
                    else:
                        found = check_filetype(path) + check_data(path, data, needles, waiver, waived)
                    findings += [f._replace(message=f.message + " (commit %s)" % commit[:12]) for f in found]
    except (OSError, ValueError, subprocess.CalledProcessError) as e:
        why = str(e) if isinstance(e, ValueError) else type(e).__name__
        findings.append(Finding("commit", spec, 0, "cannot read the commits: %s" % why))
        return findings, 0
    return findings, len(commits)


def is_binary(data):
    """True for content that is not plain text: an archive, an image, a
    document. Its bytes are searched; what is packed inside it is not."""
    return decode_text(data)[1] is not None or data.startswith(b"%PDF")


def check_bytes(path, data, needles, waiver=None, waived=None):
    """The needle check on content of any kind (needles-only mode). Bytes that
    are not UTF-8 are read with each wrong byte as a separator, and content
    with a NUL byte also as UTF-16, so a needle in either is seen. Compressed
    or encoded content (an archive, an image) is not unpacked."""
    texts = [data.decode("utf-8", "replace").replace("\0", " ")]
    if b"\0" in data:
        texts += [data[skip:].decode(codec, "replace") for codec in ("utf-16-le", "utf-16-be") for skip in (0, 1)]
    findings = []
    for text in texts:
        findings += check_needles(path, plain(text), needles, waiver=waiver, waived=waived)
    return list(dict.fromkeys(findings))


def run_needles_only(root, needle_file, commits=(), tags=(), ref_names=()):
    """The needle check alone, on a tree of any kind, such as a repository
    that uses this one -> as `run`, and the binary files, for a person: every file's content and path, and with `commits` the
    commits. Every finding is about needles: one that
    matches, a needle list that cannot be used, or content that could not be
    read and so was not checked."""
    files = discover(root)
    findings, waived, unpacked = [], [], []
    if not files:
        findings.append(Finding("needle", ".", 0, "no files found: refusing to pass an empty tree"))
    needles, needle_findings = load_needles(needle_file) if needle_file else (Needles(), [
        Finding("needle", "-", 0, "--needles-only set and no --needles given")])
    findings += needle_findings
    waiver = Waiver(root, files, needles) if needles else None
    for path in files if needles else ():
        name = path.encode("utf-8", "surrogateescape").decode("utf-8", "replace")
        findings += check_needles(name, plain(name), needles, in_text=False)
        full = os.path.join(root, path)
        try:
            if os.path.islink(full):
                data = os.fsencode(os.readlink(full))  # what git commits is the link's target
            elif os.path.isdir(full):
                continue  # a submodule: git commits its commit id only
            else:
                with open(full, "rb") as fh:
                    data = fh.read()
        except OSError as e:
            findings.append(Finding("needle", name, 0, "not checked, cannot be read: %s" % type(e).__name__))
            continue
        if is_binary(data):
            unpacked.append(name)
        findings += check_bytes(name, data, needles, waiver, waived)
    for spec in commits if needles else ():
        findings += check_commits(root, spec, needles, waiver, waived, needles_only=True, unpacked=unpacked)[0]
    if needles:
        findings += check_refs(root, tags, ref_names, needles, needles_only=True)
    return findings, files, {}, needles, waived, unpacked


# --------------------------------------------------------------------------
# The gate
# --------------------------------------------------------------------------

def run(root, needle_file=None, require_needles=False, commits=(), tags=(), ref_names=(), example=None):
    """Every check on the tree at `root`, and on the commits of each range in `commits`. -> (findings, files, modules,
    needles, waived needle hits)"""
    files = discover(root)
    findings = []
    if not files:
        findings.append(Finding("filetype", ".", 0, "no files found: refusing to pass an empty tree"))
    findings += check_def_paths(root, files)
    modules, module_findings = check_modules(root, files, example)
    findings += module_findings
    if example:
        core, core_findings = check_modules(example.core, discover(example.core))
        findings += core_findings
        if "core" not in core:
            findings.append(Finding("closure", "model/core.def", 0, "--core holds no model module `core`"))
        for name in sorted(set(core) & set(modules)):
            findings.append(Finding("closure", "model", 0, "module `%s` is in this tree and in --core" % name))
        modules = {**core, **modules}
    findings += check_packs(root, files, modules, example)
    for path in files:
        findings += check_filetype(path)
    needles = Needles()
    if needle_file:
        needles, needle_findings = load_needles(needle_file)
        findings += needle_findings
    elif require_needles:
        findings.append(Finding("needle", "-", 0, "--require-needles set and no --needles given"))
    waiver = Waiver(root, files, needles) if needles else None
    waived = []
    for path in files:
        if not is_utf8(path):
            findings.append(Finding("filetype", path, 0, "file name is not UTF-8"))
            continue
        findings += check_path(path, needles)
        findings += check_content(root, path, needles, waiver, waived)
    for spec in commits:
        findings += check_commits(root, spec, needles, waiver, waived)[0]
    findings += check_refs(root, tags, ref_names, needles)
    return findings, files, modules, needles, waived


def _where(path, line):
    path = path.encode("utf-8", "backslashreplace").decode("utf-8")
    return "%s:%d" % (path, line) if line else path


def report(findings, files, modules, needles, waived=(), unpacked=(), out=None):
    """Print one line for each finding, the waived needle hits and the
    verdict. -> the exit status, which waived hits do not change"""
    out = out or sys.stdout
    for f in findings:
        print("boundary-gate: %-8s %s: %s" % (f.check, _where(f.path, f.line), f.message), file=out)
    if waived:
        print("boundary-gate: %d needle hits waived in %d files of %d generated packs (each needle also "
              "appears in a cited upstream source whose SHA-256 matches)" % (
                  len(waived), len({w.path for w in waived}), len({w.pack for w in waived})), file=out)
        for w in waived:
            print("boundary-gate: %-8s %s: text matches the needle on line %d of the needle file "
                  "(%d characters)" % ("waived", _where(w.path, w.line), w.needle, w.length), file=out)
    if unpacked:
        print("boundary-gate: %d binary files: their bytes are searched, what is packed inside them is not; "
              "look at each" % len(unpacked), file=out)
        for path in unpacked:
            print("boundary-gate: binary   %s" % _where(path, 0), file=out)
    if findings:
        print("boundary-gate: FAIL, %d finding(s) in %d files" % (len(findings), len(files)), file=out)
        return 1
    supplied = "%d" % len(needles) if needles else "not supplied (structural checks only)"
    print("boundary-gate: ok, %d files, %d modules, needles: %s" % (len(files), len(modules), supplied), file=out)
    return 0


def main(argv=None):
    ap = argparse.ArgumentParser(
        prog="boundary-gate",
        description="Refuse content that is not public: exit 1 and name each finding, or print "
                    "`boundary-gate: ok` and exit 0.",
        epilog="docs/boundary.md states the checks. A line with `boundary-allow: <reason>` is exempt "
               "from the phrase and hygiene checks; no tag exempts a needle. A needle hit in a generated "
               "pack is waived when an upstream source its provenance cites, found under %s or "
               "tools/gen/sources/ with the recorded SHA-256, holds the same needle." % GEN_SOURCES_ENV,
    )
    ap.add_argument(
        "--root", default=os.path.dirname(os.path.dirname(os.path.abspath(__file__))), metavar="DIR",
        help="the tree to check (default: the repository this tool is in). In a git checkout the files "
             "git would commit are read; elsewhere every file outside the build directories")
    ap.add_argument(
        "--needles", metavar="FILE",
        help="a file of private terms, one per line, that must not occur in any text or file path. "
             "An empty file, or a needle shorter than %d characters or with no letter or digit, fails "
             "the gate. No needle is ever printed" % MIN_NEEDLE_CHARS)
    ap.add_argument(
        "--require-needles", action="store_true",
        help="fail when --needles is not given (the pre-push hook passes this)")
    ap.add_argument(
        "--commits", metavar="BASE..TIP", action="append", default=[],
        help="also check every commit of the range (or of TIP's whole history): its message, author and "
             "committer, the path of every file it changes and every content it brings in, also content a "
             "later commit removes. May be given more than once. An empty range, or a shallow repository, fails")
    ap.add_argument(
        "--tag", metavar="TAG", action="append", default=[],
        help="also check an annotated tag: its message and tagger. Given for a tag on a commit that is "
             "published already; --commits checks the tag its TIP names")
    ap.add_argument(
        "--ref-name", metavar="NAME", action="append", default=[],
        help="also check the name of a branch or tag that a push would publish")
    ap.add_argument(
        "--needles-only", action="store_true",
        help="the needle check alone, for a tree of another repository: the exit status depends on needles "
             "only (a match, a list that cannot be used, or a file that could not be read). Needs --needles")
    ap.add_argument(
        "--example-overlay", metavar="PREFIX",
        help="the tree is the public example of an overlay: a module or pack whose name is PREFIX, or PREFIX "
             "and a `-` or the like, must say `distribution controlled`, and every other one `distribution "
             "public`. Every other check is the same. Needs --core and --needles")
    ap.add_argument(
        "--core", metavar="DIR", help="with --example-overlay: the goat-transformers tree whose model modules may be used")
    args = ap.parse_args(argv)
    example = None
    if args.example_overlay is not None or args.core is not None:
        if not args.example_overlay or not args.core or not args.needles or args.needles_only:
            ap.error("--example-overlay needs a PREFIX, --core and --needles, and is not for --needles-only")
        if not re.fullmatch(r"[a-z][a-z0-9]{3,}", args.example_overlay):
            ap.error("--example-overlay: PREFIX is four or more small letters and digits")
        example = ExampleOverlay(args.example_overlay, os.path.abspath(args.core))
    if args.needles_only:
        return report(*run_needles_only(os.path.abspath(args.root), args.needles, args.commits, args.tag, args.ref_name))
    return report(*run(os.path.abspath(args.root), args.needles, args.require_needles, args.commits, args.tag, args.ref_name, example))


if __name__ == "__main__":
    sys.exit(main())
