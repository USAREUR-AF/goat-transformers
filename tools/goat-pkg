#!/usr/bin/env python3
"""goat-pkg: plan the minimum goat-transformers package for a set of constraints.

A caller brings their constraints — the message standards they need, the
language, the runtime, the OS and chip architecture, and static vs dynamic
linkage — and this computes the smallest package that meets them: which engine,
which packs (only the formats asked for), which wire codecs those packs use, the
build target and command, and whether the requested formats actually
inter-convert.

Run with -I (the repo ships it executable). It reads only data files; it never
imports anything from the packs it inspects.

Usage:
  tools/goat-pkg plan --formats cot-xml,sapient --language rust \
      --runtime native --linkage static --os linux --arch x86_64
  tools/goat-pkg formats        # list available formats and the wire each uses
  tools/goat-pkg bundle --formats cot-xml,geojson --out vendor/goat [--embed rust|go|python]
                                # write only those packs and the model modules they use
"""
import argparse
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
REPO = os.path.dirname(HERE)
PACKS = os.path.join(REPO, "packs")

LANGUAGES = ["rust", "go", "python", "java", "cpp", "erlang", "zig"]

# Which (language, runtime) pairs are supported, and how each builds for a given
# linkage. {arch},{os},{goarch} are filled from the constraints. "any" linkage
# means linkage does not apply to that runtime.
BUILD = {
    ("rust", "native"): {
        "static": "cargo build --release --target {arch}-unknown-{os}-musl",
        "dynamic": "cargo build --release --target {arch}-unknown-{os}-gnu",
    },
    ("rust", "wasm"): {"any": "cargo build --release --lib --target wasm32-unknown-unknown"},
    ("rust", "js"): {"any": "cargo build --release --lib --target wasm32-unknown-unknown  # wrap with a thin JS/WASM loader"},
    ("go", "native"): {
        "static": "CGO_ENABLED=0 GOOS={os} GOARCH={goarch} go build ./cmd/goat-xf",
        "dynamic": "GOOS={os} GOARCH={goarch} go build ./cmd/goat-xf",
    },
    ("go", "wasm"): {"any": "GOOS=wasip1 GOARCH=wasm go build ./cmd/goat-xf"},
    ("java", "jvm"): {"any": "./build.sh   # a portable jar; the JVM abstracts OS and arch"},
    ("cpp", "native"): {
        "static": "cmake -DCMAKE_EXE_LINKER_FLAGS=-static -S engines/cpp -B build && cmake --build build",
        "dynamic": "cmake -S engines/cpp -B build && cmake --build build",
    },
    ("cpp", "wasm"): {"any": "emcmake cmake -S engines/cpp -B build-wasm && cmake --build build-wasm"},
    ("python", "native"): {"any": "no build step; ship the package and a Python 3 runtime"},
    ("erlang", "native"): {"any": "./build.sh   # runs on the BEAM VM"},
    ("zig", "native"): {
        "static": "zig build -Dtarget={arch}-{os}-musl -Doptimize=ReleaseSmall",
        "dynamic": "zig build -Dtarget={arch}-{os}-gnu -Doptimize=ReleaseSmall",
    },
    ("zig", "wasm"): {"any": "zig build -Dtarget=wasm32-wasi -Doptimize=ReleaseSmall"},
}

GOARCH = {"x86_64": "amd64", "aarch64": "arm64", "arm64": "arm64", "amd64": "amd64"}


def load_formats():
    """Scan packs/ -> {format: {wire, fields:[model keys]}} from each pack.def."""
    out = {}
    if not os.path.isdir(PACKS):
        return out
    for name in sorted(os.listdir(PACKS)):
        pdef = os.path.join(PACKS, name, "pack.def")
        if not os.path.isfile(pdef):
            continue
        fmt, wire, fields = None, None, []
        with open(pdef, encoding="utf-8") as fh:
            for raw in fh:
                line = raw.split("#", 1)[0].strip()
                if not line:
                    continue
                tok = line.split()
                if tok[0] == "format" and len(tok) > 1:
                    fmt = tok[1]
                elif tok[0] == "wire" and len(tok) > 1:
                    wire = tok[1]
                elif tok[0] == "field" and len(tok) > 1:
                    fields.append(tok[1])
        if fmt:
            out[fmt] = {"wire": wire, "fields": fields, "dir": name}
    return out


def capability(a_fields, b_fields):
    """What carries A->B and what B cannot represent, from the field sets."""
    carried = [k for k in a_fields if k in b_fields]
    dropped = [k for k in a_fields if k not in b_fields]
    grade = "full" if carried and not dropped else ("partial" if carried else "none")
    return {"carried": carried, "dropped": dropped, "grade": grade}


def cmd_formats(_args):
    fmts = load_formats()
    if not fmts:
        print("no packs found under", PACKS)
        return 1
    width = max(len(f) for f in fmts)
    for f, info in fmts.items():
        print(f"{f:<{width}}  wire={info['wire']:<9} fields={', '.join(info['fields'])}")
    return 0


def cmd_plan(args):
    fmts = load_formats()
    want = [f.strip() for f in args.formats.split(",") if f.strip()]
    missing = [f for f in want if f not in fmts]
    if missing:
        print("error: formats not available:", ", ".join(missing), file=sys.stderr)
        print("available:", ", ".join(sorted(fmts)), file=sys.stderr)
        return 1

    wires = sorted({fmts[f]["wire"] for f in want})
    key = (args.language, args.runtime)
    if key not in BUILD:
        print(f"error: {args.language} has no {args.runtime} runtime target yet", file=sys.stderr)
        print("supported:", ", ".join(f"{l}/{r}" for (l, r) in sorted(BUILD)), file=sys.stderr)
        return 1
    builds = BUILD[key]
    linkage = "any" if "any" in builds else args.linkage
    if linkage not in builds:
        print(f"error: {args.language}/{args.runtime} supports linkage {sorted(builds)}", file=sys.stderr)
        return 1
    goarch = GOARCH.get(args.arch, args.arch)
    build_cmd = builds[linkage].format(arch=args.arch, os=args.os, goarch=goarch)

    # inter-convertibility among the requested formats (the "why not" per pair)
    pairs = []
    for a in want:
        for b in want:
            if a != b:
                cap = capability(fmts[a]["fields"], fmts[b]["fields"])
                pairs.append({"from": a, "to": b, **cap})

    manifest = {
        "constraints": {
            "formats": want,
            "language": args.language,
            "runtime": args.runtime,
            "linkage": linkage,
            "os": args.os,
            "arch": args.arch,
        },
        "package": {
            "engine": f"engines/{args.language}",
            "packs": [f"packs/{fmts[f]['dir']}" for f in want],
            "wires_used": wires,
            "build_command": build_cmd,
        },
        "convertibility": pairs,
    }

    if args.json:
        print(json.dumps(manifest, indent=2))
        return 0

    print(f"# Minimum package for: {', '.join(want)}")
    print(f"#   {args.language} / {args.runtime} / linkage={linkage} / {args.os} / {args.arch}\n")
    print(f"engine:      engines/{args.language}")
    print(f"packs:       {', '.join(fmts[f]['dir'] for f in want)}   (only these)")
    print(f"wires used:  {', '.join(wires)}   (a minimal engine build can exclude the rest)")
    print(f"build:       {build_cmd}\n")
    print("convertibility among the requested formats:")
    for p in pairs:
        why = "" if not p["dropped"] else f"  (drops {', '.join(p['dropped'])}: {p['to']} has no field for them)"
        print(f"  {p['from']:>12} -> {p['to']:<12} {p['grade'].upper():7} carries [{', '.join(p['carried'])}]{why}")
    return 0


def head(path):
    """-> (module name or None, [used modules]) of a model module or a pack."""
    name, uses = None, []
    with open(path, encoding="utf-8") as fh:
        for raw in fh:
            tok = raw.split("#", 1)[0].split()
            if len(tok) == 2 and tok[0] == "module" and name is None:
                name = tok[1]
            elif len(tok) == 2 and tok[0] == "uses" and tok[1] not in uses:
                uses.append(tok[1])
    return name, uses


def modules_for(pack_dirs):
    """The module files the packs need, in loading order: `core` first, then
    each module after the modules it uses. -> [(module, file name)]"""
    model = os.path.join(REPO, "model")
    heads = {}
    for fname in sorted(os.listdir(model)) if os.path.isdir(model) else []:
        if fname.endswith(".def"):
            name, uses = head(os.path.join(model, fname))
            if name is not None and name not in heads:
                heads[name] = (fname, uses)
    order, placing = [], []

    def place(name, wanted_by):
        if any(m == name for m, _ in order):
            return
        if name not in heads:
            raise SystemExit(f"error: {wanted_by} uses module {name}, and no file in model/ declares it")
        if name in placing:
            raise SystemExit(f"error: the uses lines of the model modules form a cycle through {name}")
        placing.append(name)
        for used in heads[name][1]:
            if used != name:
                place(used, f"module {name}")
        placing.pop()
        order.append((name, heads[name][0]))

    place("core", "every pack")
    for d in pack_dirs:
        for used in head(os.path.join(PACKS, d, "pack.def"))[1]:
            place(used, f"pack {d}")
    return order


def library_version():
    """The library version: the version of the reference engine's crate."""
    try:
        with open(os.path.join(REPO, "engines", "rust", "Cargo.toml"), encoding="utf-8") as fh:
            m = re.search(r'^version\s*=\s*"([^"]+)"', fh.read(), re.M)
            return m.group(1) if m else None
    except OSError:
        return None


def git(*args):
    try:
        out = subprocess.run(["git", "-C", REPO, *args], check=True, capture_output=True, text=True).stdout
        return out.strip()
    except (OSError, subprocess.CalledProcessError):
        return None


EMBED_RUST = """// Generated by tools/goat-pkg bundle. Do not edit; run the bundle again.
// The packs of this directory, compiled into the program: {formats}.
// Use: `#[path = "<this directory>/goat_packs.rs"] mod goat_packs;` then `goat_packs::engine()?`.

/// An engine holding the packs of this bundle. It reads no file.
pub fn engine() -> Result<goat_transformers::Engine, goat_transformers::Error> {{
    let mut engine = goat_transformers::Engine::new();
{loads}    Ok(engine)
}}
"""

EMBED_GO = """// Code generated by tools/goat-pkg bundle. DO NOT EDIT.

// Package {package} holds goat-transformers packs compiled into the program:
// {formats}.
package {package}

import (
	"embed"

	goatxf "github.com/USAREUR-AF/goat-transformers/engines/go"
)

// Tree is the bundle: model/ and packs/.
//
//go:embed model packs
var Tree embed.FS

// Packs names the packs of the bundle.
var Packs = []string{{{names}}}

// Engine returns an engine holding the packs of the bundle. It reads no file.
func Engine() (*goatxf.Engine, error) {{
	engine := goatxf.New()
	if err := engine.LoadFS(Tree, Packs); err != nil {{
		return nil, err
	}}
	return engine, nil
}}
"""

EMBED_PYTHON = '''"""goat-transformers packs as package data: {formats}.

Generated by tools/goat-pkg bundle. Do not edit; run the bundle again.
Ship the `.def` files with the package (setuptools: `package-data` with
`"model/*.def"` and `"packs/*/pack.def"`).
"""

import os
from importlib import resources

from goat_transformers import Engine

PACKS = [{names}]


def engine(max_distribution="controlled"):
    """An engine holding the packs of this bundle."""
    with resources.as_file(resources.files(__name__)) as root:
        return Engine.from_dir(
            os.path.join(root, "packs"), os.path.join(root, "model"), max_distribution, packs_only=PACKS
        )
'''


def cmd_bundle(args):
    fmts = load_formats()
    want = list(dict.fromkeys(f.strip() for f in args.formats.split(",") if f.strip()))
    missing = [f for f in want if f not in fmts]
    if missing or not want:
        print("error: formats not available:", ", ".join(missing) or "(none named)", file=sys.stderr)
        print("available:", ", ".join(sorted(fmts)), file=sys.stderr)
        return 1
    dirs = [fmts[f]["dir"] for f in want]
    modules = modules_for(dirs)
    out = args.out
    # Only what this command writes is replaced: model/, packs/ and its own files.
    for sub in ("model", "packs"):
        shutil.rmtree(os.path.join(out, sub), ignore_errors=True)
    files = []  # paths relative to the bundle, in loading order

    def copy(src, rel):
        dst = os.path.join(out, *rel.split("/"))
        os.makedirs(os.path.dirname(dst), exist_ok=True)
        shutil.copyfile(src, dst)
        files.append(rel)

    for _, fname in modules:
        copy(os.path.join(REPO, "model", fname), f"model/{fname}")
    for d in dirs:
        copy(os.path.join(PACKS, d, "pack.def"), f"packs/{d}/pack.def")
    for name in ("LICENSE", "NOTICE"):
        if os.path.isfile(os.path.join(REPO, name)):
            copy(os.path.join(REPO, name), name)

    def rust_source():
        loads = [f'    engine.load_model(include_str!("model/{fname}"))?;\n' for _, fname in modules]
        loads += [f'    engine.load_def(include_str!("packs/{d}/pack.def"))?;\n' for d in dirs]
        return EMBED_RUST.format(formats=", ".join(want), loads="".join(loads))

    names = ", ".join(json.dumps(d) for d in dirs)
    generated = {
        "rust": ("goat_packs.rs", rust_source),
        "go": ("goatpacks.go", lambda: EMBED_GO.format(package=args.package, formats=", ".join(want), names=names)),
        "python": ("__init__.py", lambda: EMBED_PYTHON.format(formats=", ".join(want), names=names)),
    }
    for lang in dict.fromkeys(args.embed or []):
        fname, text = generated[lang]
        with open(os.path.join(out, fname), "w", encoding="utf-8") as fh:
            fh.write(text())
        files.append(fname)

    sums = {}
    for rel in files:
        with open(os.path.join(out, *rel.split("/")), "rb") as fh:
            sums[rel] = hashlib.sha256(fh.read()).hexdigest()
    dirty = git("status", "--porcelain", "--", "model", "packs", "LICENSE", "NOTICE")
    manifest = {
        "library": "goat-transformers",
        "version": library_version(),
        "commit": git("rev-parse", "HEAD"),
        # true when model/, packs/, LICENSE or NOTICE differed from that commit when the bundle was written
        "modified": bool(dirty) if dirty is not None else None,
        "formats": want,
        "packs": dirs,
        "modules": [m for m, _ in modules],
        "sha256": sums,
    }
    with open(os.path.join(out, "manifest.json"), "w", encoding="utf-8") as fh:
        json.dump(manifest, fh, indent=2)
        fh.write("\n")
    total = sum(os.path.getsize(os.path.join(out, *rel.split("/"))) for rel in files)
    print(f"bundle: {out}")
    print(f"  packs:   {', '.join(dirs)}")
    print(f"  modules: {', '.join(m for m, _ in modules)}")
    print(f"  files:   {len(files)} ({total} bytes) and manifest.json")
    return 0


def cmd_archive(args):
    """Every model module and every pack as one .tar.gz, the same bytes for the
    same tree: sorted members, no owner, no times."""
    import gzip
    import tarfile

    members = []
    for top in ("LICENSE", "NOTICE"):
        if os.path.isfile(os.path.join(REPO, top)):
            members.append(top)
    for top in ("model", "packs"):
        for d, dirs, names in os.walk(os.path.join(REPO, top)):
            if not args.vectors:
                dirs[:] = [x for x in dirs if x not in ("vectors", "load-vectors")]
            for n in names:
                members.append(os.path.relpath(os.path.join(d, n), REPO).replace(os.sep, "/"))
    members.sort()
    prefix = args.prefix.strip("/")
    os.makedirs(os.path.dirname(os.path.abspath(args.out)), exist_ok=True)
    with open(args.out, "wb") as raw:
        with gzip.GzipFile(filename="", mode="wb", fileobj=raw, mtime=0) as gz:
            with tarfile.open(fileobj=gz, mode="w", format=tarfile.PAX_FORMAT) as tar:
                for rel in members:
                    info = tarfile.TarInfo(f"{prefix}/{rel}" if prefix else rel)
                    path = os.path.join(REPO, *rel.split("/"))
                    info.size = os.path.getsize(path)
                    info.mode = 0o644
                    with open(path, "rb") as fh:
                        tar.addfile(info, fh)
    print(f"archive: {args.out} ({len(members)} files, {os.path.getsize(args.out)} bytes)")
    return 0


def main():
    ap = argparse.ArgumentParser(prog="goat-pkg", description=__doc__)
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("formats", help="list available formats and their wire")
    p = sub.add_parser("plan", help="plan the minimum package for a set of constraints")
    p.add_argument("--formats", required=True, help="comma-separated message formats needed")
    p.add_argument("--language", default="rust", choices=LANGUAGES)
    p.add_argument("--runtime", default="native", help="native | wasm | js | jvm")
    p.add_argument("--linkage", default="static", choices=["static", "dynamic"])
    p.add_argument("--os", default="linux")
    p.add_argument("--arch", default="x86_64")
    p.add_argument("--json", action="store_true", help="emit the manifest as JSON")
    b = sub.add_parser(
        "bundle",
        help="write the packs for the named formats and the model modules they use to a directory, with a manifest",
    )
    b.add_argument("--formats", required=True, help="comma-separated message formats needed")
    b.add_argument("--out", required=True, help="directory to write: model/, packs/, LICENSE, NOTICE, manifest.json")
    b.add_argument(
        "--embed", action="append", choices=["rust", "go", "python"],
        help="also write a source file that compiles the bundle into a program of that language; repeatable",
    )
    b.add_argument("--package", default="goatpacks", help="with --embed go: the Go package name (default goatpacks)")
    a = sub.add_parser("archive", help="write every model module and every pack to one .tar.gz")
    a.add_argument("--out", required=True, help="the .tar.gz to write")
    a.add_argument("--vectors", action="store_true", help="include the conformance vectors (left out by default)")
    a.add_argument("--prefix", default="", help="a directory name every member is placed under")
    args = ap.parse_args()
    if args.cmd == "bundle":
        return cmd_bundle(args)
    if args.cmd == "archive":
        return cmd_archive(args)
    if args.cmd == "formats":
        return cmd_formats(args)
    if args.cmd == "plan":
        return cmd_plan(args)
    return 2


if __name__ == "__main__":
    sys.exit(main())
