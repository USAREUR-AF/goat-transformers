# ArduPilot log message FMT as the payload of a DataFlash log record.
# Generated by tools/gen/aplog2pack.py; do not edit by hand.
# The record without its 3-byte header (0xA3 0x95 type-id); fields packed, little-endian.
format        ardupilot-log-fmt
version       0.1.0
distribution  public
source        "ArduPilot log message definitions (log structure tables and Write calls), https://github.com/ArduPilot/ardupilot at tag Test-0.0.0, commit 0123456789abcdef0123456789abcdef01234567; message names, format strings, labels, units and multipliers only; GNU General Public License, version 3"
source        "ArduPilot libraries/AP_Logger/LogStructure.h: the format characters, units and multipliers of a log message, at the same commit"
uses          aplog
wire          bits
bit_order     lsb
word_bytes    1
field  aplog.fmt_type  0:0:8  uint
field  aplog.fmt_length  0:8:8  uint
field  aplog.fmt_name  0:16:32  ascii
field  aplog.fmt_format  0:48:128  ascii
field  aplog.fmt_columns  0:176:512  ascii
