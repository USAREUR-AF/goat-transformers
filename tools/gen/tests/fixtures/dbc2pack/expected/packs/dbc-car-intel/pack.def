# CAN frames of the DBC file car_intel, one kind per message.
# Generated by tools/gen/dbc2pack.py; do not edit by hand.
# The message is one SocketCAN struct can_frame of 16 bytes: identifier word
# (little-endian, flags in the top three bits), data length, three padding
# bytes, eight data bytes. Data bit 0 is bit 64 of the frame.
format        dbc-car-intel
version       0.1.0
distribution  public
source        "https://github.com/commaai/opendbc opendbc/dbc/car_intel.dbc at commit 0123456789abcdef0123456789abcdef01234567"
source        "Linux UAPI header include/uapi/linux/can.h, struct can_frame (GPL-2.0 WITH Linux-syscall-note)"
uses          dbccarintel
wire          bits
bit_order     lsb
word_bytes    1
map   t_speed_gear  0  "P"
map   t_speed_gear  1  "R"
map   t_speed_gear  2  "N"
map   t_speed_gear  3  "D"
map   t_speed_gear  4  "S"
map   t_speed_gear  5  "L"
map   t_speed_gear  6  "M"
map   t_speed_gear  7  "invalid"
map   t_speed_door_open  0  "closed"
map   t_speed_door_open  1  "open"

kind      speed
when      0:0:32 256
when      0:32:8 8
requires  dbccarintel.speed_vehicle_speed dbccarintel.speed_gear dbccarintel.speed_door_open
field     dbccarintel.speed_vehicle_speed 0:64:16 uscale:1/100
field     dbccarintel.speed_gear 0:80:3 uint via t_speed_gear
field     dbccarintel.speed_door_open 0:83:1 uint via t_speed_door_open
field     dbccarintel.speed_temp 0:88:8 sscale:1/2:-40
field     dbccarintel.speed_big_endian_word 0:96:16 uint swap
field     dbccarintel.speed_big_endian_nibble 0:120:4 uint

kind      modes_m0
when      0:0:32 257
when      0:32:8 2
when      0:64:2 0
requires  dbccarintel.modes_common dbccarintel.modes_page0_a
field     dbccarintel.modes_common 0:66:6 uint
field     dbccarintel.modes_page0_a 0:72:8 uint
const     0:120:8 0

kind      modes_m1
when      0:0:32 257
when      0:32:8 2
when      0:64:2 1
requires  dbccarintel.modes_common dbccarintel.modes_page1_b
field     dbccarintel.modes_common 0:66:6 uint
field     dbccarintel.modes_page1_b 0:72:8 twos
const     0:120:8 0

kind      extended
when      0:0:32 2147484160
when      0:32:8 4
requires  dbccarintel.extended_rate
field     dbccarintel.extended_rate 0:64:32 twos
const     0:120:8 0

kind      long_id_no_flag
when      0:0:32 2565864960
when      0:32:8 1
requires  dbccarintel.long_id_no_flag_counter dbccarintel.long_id_no_flag_counter_2
field     dbccarintel.long_id_no_flag_counter 0:64:4 uint
field     dbccarintel.long_id_no_flag_counter_2 0:68:4 uint
const     0:120:8 0

kind      gps
when      0:0:32 600
when      0:32:8 8
requires  dbccarintel.gps_gps_fix
field     lat 0:64:28 sscale:1/1000000
field     lon 0:92:29 sscale:1/1000000
field     dbccarintel.gps_gps_fix 0:121:3 uint

kind      floats
when      0:0:32 601
when      0:32:8 8
requires  dbccarintel.floats_angle
field     dbccarintel.floats_angle 0:64:32 f32
const     0:120:8 0
