# NMEA 2000 parameter groups with a repeating field set, from the CANboat PGN database.
# Public. Message = 3 bytes PGN (little-endian), then the reassembled payload, read in
# order (spec 0.8 sequential layout). The fixed-layout PGNs are in pack nmea2000.
# GENERATED by tools/gen/canboat2pack.py. Do not edit.
format        nmea2000-seq
version       0.2.0
distribution  public
source        "canboat/canboat docs/canboat.json at commit 1111111111111111111111111111111111111111 (CANboat 0.0.1, Apache License 2.0)"
source        "https://github.com/canboat/canboat/blob/1111111111111111111111111111111111111111/docs/canboat.json"
uses          n2k
wire          bits
layout        sequential
bit_order     lsb

# PGN 65304 labLogEntries: Lab: log entries
kind      pgn65304
when      24 65304
requires  n2k.pgn65304_entries
group     n2k.pgn65304_entries count 8
  field     n2k.entry_code   8   uint
  field     n2k.entry_value  16  sscale:1/100
end

# PGN 65309 labCalibrationPairs: Lab: calibration pairs
kind      pgn65309
when      24 65309
when      11 999
when      2 3
when      3 4
requires  n2k.pgn65309_pairs
group     n2k.pgn65309_pairs count 8
  field     n2k.input_frequency  16  uscale:1/10
  field     n2k.output_speed     16  uscale:1/100
end

# PGN 129029 gnssPositionData: GNSS Position Data
kind      pgn129029
when      24 129029
requires  n2k.sid n2k.time n2k.altitude n2k.pgn129029_reference_stations
field     n2k.sid       8   uint
field     n2k.time      32  uscale:1/10000 absent 4294967295,4294967294,4294967293
field     lat           64  sscale:1/10000000000000000 absent 9223372036854775807,9223372036854775806
field     lon           64  sscale:1/10000000000000000 absent 9223372036854775807,9223372036854775806
field     n2k.altitude  64  sscale:1/1000000 absent 9223372036854775807,9223372036854775806
group     n2k.pgn129029_reference_stations count 8
  field     n2k.reference_station_type    4   uint
  field     n2k.reference_station_id      12  uint
  field     n2k.age_of_dgnss_corrections  16  uscale:1/100
end
