# Message = 3 bytes PGN (little-endian), then the reassembled payload.
# Payload bit offsets are CANboat's BitOffset + 24. See pack.md.
# GENERATED by tools/gen/canboat2pack.py. Do not edit.
format        nmea2000
version       0.2.0
distribution  public
source        "canboat/canboat docs/canboat.json at commit 1111111111111111111111111111111111111111 (CANboat 0.0.1, Apache License 2.0)"
source        "https://github.com/canboat/canboat/blob/1111111111111111111111111111111111111111/docs/canboat.json"
uses          n2k
wire          bits
bit_order     lsb
word_bytes    1

# PGN 65300 labEngineSampleDetailed: Lab: engine sample, detailed mode
kind      pgn65300_lab_engine_sample_detailed
when      0:0:24 65300
when      0:24:11 1999
when      0:37:3 4
when      0:40:3 2
requires  n2k.engine_instance n2k.trim_angle n2k.coolant_temperature n2k.pgn65300_lab_engine_sample_detailed_fuel_rate
field     n2k.engine_instance                                0:43:5       uint
field     n2k.trim_angle                                     0:48:13      sscale:1/10000
field     n2k.coolant_temperature                            0:64:8       uscale:1/2:-40
field     n2k.pgn65300_lab_engine_sample_detailed_fuel_rate  0:72:16      uscale:1/10

# PGN 65300 labEngineSample: Lab: engine sample
kind      pgn65300_lab_engine_sample
when      0:0:24 65300
when      0:24:11 1999
when      0:37:3 4
requires  n2k.engine_instance n2k.pgn65300_lab_engine_sample_fuel_rate
field     n2k.engine_instance                       0:40:8       uint
field     n2k.pgn65300_lab_engine_sample_fuel_rate  0:48:20      uscale:1/100

# PGN 65301 labTankLevel: Lab: tank level
kind      pgn65301
when      0:0:24 65301
requires  n2k.sid n2k.tank_level n2k.pgn65301_pressure n2k.2nd_sensor n2k.alarm
field     n2k.sid                0:24:8       uint absent 255,254,253
field     n2k.tank_level         0:32:16      sscale:1/250
field     n2k.pgn65301_pressure  0:48:32      uscale:1/10
field     n2k.2nd_sensor         0:80:7       uint
field     n2k.alarm              0:87:1       uint

# PGN 65302 labPressure: Lab: pressure | signed [CANboat: incomplete]
kind      pgn65302
when      0:0:24 65302
requires  n2k.sid n2k.pgn65302_pressure n2k.tank_level n2k.status_bits
field     n2k.sid                0:24:8       uint
field     n2k.pgn65302_pressure  0:32:16      twos
field     n2k.tank_level         0:48:16      sscale:1/250
field     n2k.status_bits        0:64:12      uint

# PGN 65303 labStatusText: Lab: status text
kind      pgn65303
when      0:0:24 65303
requires  n2k.label n2k.gain n2k.date n2k.time
field     n2k.label  0:24:64      ascii
field     n2k.gain   0:88:32      f32
field     n2k.date   0:208:16     uint
field     n2k.time   0:224:32     uscale:1/10000

# PGN 65308 labTrueCourse: Lab: course and height
kind      pgn65308
when      0:0:24 65308
requires  n2k.unit_id
field     course       0:24:16      uscale:0.005729577951308233
field     hae          0:40:32      sscale:1/100
field     n2k.unit_id  0:72:16      uint

# PGN 129025 positionRapidUpdate: Position, Rapid Update
kind      pgn129025
when      0:0:24 129025
requires  lat lon
field     lat  0:24:32      sscale:1/10000000 absent 2147483647,2147483646,2147483645
field     lon  0:56:32      sscale:1/10000000 absent 2147483647,2147483646,2147483645

# PGN 129026 cogSogRapidUpdate: COG and SOG, Rapid Update
kind      pgn129026
when      0:0:24 129026
requires  n2k.sid n2k.cog_reference n2k.cog
field     n2k.sid            0:24:8       uint
field     n2k.cog_reference  0:32:2       uint
field     n2k.cog            0:40:16      uscale:1/10000
field     speed_ms           0:56:16      uscale:1/100

# PGN 129038 aisClassAPositionReport: AIS Class A Position Report
kind      pgn129038
when      0:0:24 129038
requires  n2k.message_id n2k.repeat_indicator n2k.user_id
field     n2k.message_id        0:24:6       uint
field     n2k.repeat_indicator  0:30:2       uint
field     n2k.user_id           0:32:32      uint absent 4294967295,4294967294,4294967293,0
field     lon                   0:64:32      sscale:1/10000000 absent 2147483647,2147483646,2147483645
field     lat                   0:96:32      sscale:1/10000000 absent 2147483647,2147483646,2147483645
field     speed_ms              0:128:16     uscale:1/100
