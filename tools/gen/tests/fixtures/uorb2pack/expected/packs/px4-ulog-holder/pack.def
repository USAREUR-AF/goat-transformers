# PX4 uORB topic holder (message Holder) as the data of a ULog D message.
# Generated by tools/gen/uorb2pack.py; do not edit by hand.
# The data after the msg_id of a 'D' message; layout of PX4's uORB struct, little-endian.
format        px4-ulog-holder
version       0.1.0
distribution  public
source        "PX4 uORB message definitions, https://github.com/PX4/PX4-Autopilot msg/ and msg/versioned/ at tag v0.0.0, commit 0123456789abcdef0123456789abcdef01234567; field names, types and array lengths; BSD 3-Clause License"
source        "PX4 ULog file format, https://github.com/PX4/PX4-Autopilot docs/en/dev_log/ulog_file_format.md at tag v0.0.0 (CC BY 4.0); the data of a D message and the treatment of padding fields"
source        "PX4 uORB generator, https://github.com/PX4/PX4-Autopilot Tools/msg/px_generate_uorb_topic_helper.py and templates/uorb/msg.json.em at tag v0.0.0 (BSD); the field order and padding rule, restated in tools/gen/uorb2pack.py"
uses          px4ulog
wire          bits
bit_order     lsb
word_bytes    1
field  px4ulog.holder_timestamp  0:0:64  uint
field  px4ulog.holder_total  0:64:64  f64
field  px4ulog.holder_code  0:128:16  uint
field  px4ulog.holder_count  0:144:8  uint
field  px4ulog.holder_label  0:152:64  ascii
group  px4ulog.holder_blob  0:216  item 8  count 70
  field  px4ulog.holder_blob_value  0:0:8  uint
end
field  px4ulog.holder_flags_0  0:776:8  uint
field  px4ulog.holder_flags_1  0:784:8  uint
field  px4ulog.holder_flags_2  0:792:8  uint
field  px4ulog.holder_items_0_timestamp  0:832:64  uint
field  px4ulog.holder_items_0_value  0:896:32  f32
field  px4ulog.holder_items_0_delta  0:928:16  twos
field  px4ulog.holder_items_0_mode  0:944:8  uint
field  px4ulog.holder_items_1_timestamp  0:960:64  uint
field  px4ulog.holder_items_1_value  0:1024:32  f32
field  px4ulog.holder_items_1_delta  0:1056:16  twos
field  px4ulog.holder_items_1_mode  0:1072:8  uint
field  px4ulog.holder_last_timestamp  0:1088:64  uint
field  px4ulog.holder_last_value  0:1152:32  f32
field  px4ulog.holder_last_delta  0:1184:16  twos
field  px4ulog.holder_last_mode  0:1200:8  uint
const  0:1208:8  0      # last padding byte of a nested type: the data is 152 bytes
