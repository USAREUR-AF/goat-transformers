{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/fieldnet/common.json",
  "title": "Shared definitions written for the jsonschema2pack tests",
  "$defs": {
    "Position": {
      "type": "object",
      "required": ["lat", "lon"],
      "properties": {
        "lat": {"type": "number", "minimum": -90, "maximum": 90, "description": "Latitude, WGS 84 degrees."},
        "lon": {"type": "number", "minimum": -180, "maximum": 180, "description": "Longitude, WGS 84 degrees."},
        "alt": {"type": ["number", "null"], "description": "Height above mean sea level, metres."}
      }
    },
    "StationRef": {"type": "string", "format": "uuid"}
  }
}
