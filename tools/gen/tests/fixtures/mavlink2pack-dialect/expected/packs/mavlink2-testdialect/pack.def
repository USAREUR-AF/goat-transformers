# MAVLink 2 frames, the messages the dialect testdialect.xml defines itself.
# The included files are read only to check that ids and names are unique.
# Generated by tools/gen/mavlink2pack.py; do not edit by hand.
# One byte-aligned frame addressed by bit offset from the STX byte:
# STX(8) LEN(8) INCOMPAT(8) COMPAT(8) SEQ(8) SYSID(8) COMPID(8) MSGID(24) PAYLOAD CRC(16).
# Payload starts at bit 80. CRC, INCOMPAT and COMPAT are not mapped.
format        mavlink2-testdialect
version       0.1.0
distribution  public
source        "https://github.com/mavlink/mavlink message_definitions/v1.0/testdialect.xml at commit 0123456789abcdef0123456789abcdef01234567"
source        "https://github.com/mavlink/mavlink message_definitions/v1.0/common.xml at commit 0123456789abcdef0123456789abcdef01234567"
source        "https://github.com/mavlink/mavlink message_definitions/v1.0/standard.xml at commit 0123456789abcdef0123456789abcdef01234567"
source        "https://github.com/mavlink/mavlink message_definitions/v1.0/minimal.xml at commit 0123456789abcdef0123456789abcdef01234567"
source        "MAVLink 2 packet format, https://mavlink.io/en/guide/serialization.html"
uses          mavlink
uses          mavlinktestdialect
wire          bits
bit_order     lsb
word_bytes    1
when   0:0:8 253
field  mavlink.seq 0:32:8 uint
field  mavlink.sysid 0:40:8 uint
field  mavlink.compid 0:48:8 uint

kind      test_fix
when      0:56:24 60100
when      0:8:8 16
requires  mavlinktestdialect.time_boot_ms mavlinktestdialect.alt_m
field     mavlinktestdialect.time_boot_ms 0:80:32 uint
field     lat 0:112:32 sscale:1/10000000
field     lon 0:144:32 sscale:1/10000000
field     mavlinktestdialect.alt_m 0:176:32 f32

kind      test_draft
when      0:56:24 60102
when      0:8:8 13
requires  mavlinktestdialect.count mavlinktestdialect.vec_cm_0 mavlinktestdialect.vec_cm_1 mavlinktestdialect.vec_cm_2 mavlinktestdialect.tag mavlinktestdialect.mode
field     mavlinktestdialect.count 0:80:16 uint
field     mavlinktestdialect.vec_cm_0 0:96:16 twos
field     mavlinktestdialect.vec_cm_1 0:112:16 twos
field     mavlinktestdialect.vec_cm_2 0:128:16 twos
field     mavlinktestdialect.tag 0:144:32 ascii
field     mavlinktestdialect.mode 0:176:8 uint

kind      test_half
when      0:56:24 60103
when      0:8:8 5
requires  mavlinktestdialect.lat_dege7 mavlinktestdialect.test_half_seq
field     mavlinktestdialect.lat_dege7 0:80:32 twos
field     mavlinktestdialect.test_half_seq 0:112:8 uint
