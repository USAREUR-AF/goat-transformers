# ASTERIX Category 250, Test Category for the Generator Tests, edition 1.10: one data block holding one record.
# Public. Generated by tools/gen/asterix2pack.py from the category definition of
# github.com/zoranbosnjak/asterix-specs (BSD-3-Clause); do not edit by hand. I/O is hex text.
# Needs engine version 0.8 (`layout sequential`). See pack.md.
#
#   octet 1       CAT = 250
#   octets 2-3    LEN, the length of the data block in octets, CAT and LEN included
#   FSPEC         octets of 7 presence bits and an extension bit; bit n is FRN n
#   then          the items whose FSPEC bit is 1, in FRN order
#
# An FRN with no `if` block is not mapped: a record with that FSPEC bit set fails
# with `malformed-wire` (ruling 1 of engine-spec 0.8), and encode never sets the bit.
format     asterix-cat250
version    0.1.0
distribution public
source  "ASTERIX Category 250, Test Category for the Generator Tests, edition 1.10 (2020-01-02), as transcribed in github.com/zoranbosnjak/asterix-specs (BSD-3-Clause), commit aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa, specs/cat250/cats/cat1.10/definition.json. The category is specified by EUROCONTROL"
uses       cat250
wire       bits
layout     sequential
bit_order  msb
kind    record
when    8  250                              # CAT
length  16 whole                         # LEN
presence f fx
if f.1                                   # FRN 1, I250/010 Data Source Identifier
  field  cat250.i010_sac  8  uint
  field  cat250.i010_sic  8  uint
end
if f.2                                   # FRN 2, I250/020 Position in WGS-84 Co-ordinates
  field  lat  24  sscale:45/2097152
  also   cat250.i020_lat
  field  lon  24  sscale:45/2097152
  also   cat250.i020_lon
end
if f.3                                   # FRN 3, I250/030 Time of Day
  field  cat250.i030  24  uscale:1/128
end
if f.4                                   # FRN 4, I250/040 Measured Movement
  field  speed_ms  16  uscale:463/4096
  pad    4
  field  cat250.i040_roc  12  sscale:25/4
end
if f.5                                   # FRN 5, I250/050 Geometric Height
  field  hae  16  sscale:381/200
end
if f.6                                   # FRN 6, I250/060 Target Status
  chain
    field  cat250.i060_typ  1  uint
    field  cat250.i060_src  2  uint
    pad    4
    fx
    field  cat250.i060_cnf  3  uint
    field  cat250.i060_age  4  uint
    fx
  end
end
if f.7                                   # FRN 7, I250/070 Plot Offsets
  group  cat250.i070  count 8
    field  cat250.i070_dx  8  twos
    field  cat250.i070_dy  8  twos
  end
end
# FRN 8: spare FRN
if f.9                                   # FRN 9, I250/080 Warning Codes
  group  cat250.i080  fx
    field  cat250.i080_val  7  uint
  end
end
if f.10                                  # FRN 10, I250/090 Sensor Data
  presence p090 fx
  if p090.1                       # subfield 1, AMP: Amplitude
    field  cat250.i090_amp  8  sscale:1
  end
  if p090.3                       # subfield 3, WIN: Window
    pad    4
    field  cat250.i090_win_num  4  uint
  end
end
if f.11                                  # FRN 11, I250/110 Target Name
  field  cat250.i110  48  ascii
end
if f.12                                  # FRN 12, I250/120 Codes
  pad    4
  field  cat250.i120_oct  12  uint
  field  cat250.i120_icao  48  uint
end
if f.13                                  # FRN 13, I250/130 Report Class
  field  cat250.report_class  8  uint
end
if f.14                                  # FRN 14, I250/140 Class Detail
  field  cat250.i140  8  uint
end
# FRN 15: I250/150 Wide Register, not mapped: an element of 72 bits (a field holds at most 64)
if f.16                                  # FRN 16, I250/160 Register
  field  cat250.i160  64  uint
end
if f.17                                  # FRN 17, I250/SP Special Purpose Field
  length 8 bytes plus 1                # the length octet counts itself; the content is not mapped
  end
end
# FRN 18: random field sequencing: the items that follow name themselves by FRN, in any order
