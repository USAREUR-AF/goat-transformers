# The cat250 module: the values of ASTERIX Category 250 (Test Category for the Generator Tests), edition 1.10,
# as the category holds them. Used by the pack `asterix-cat250`. Generated by
# tools/gen/asterix2pack.py; do not edit by hand. A key is named after its item
# and subitems; a repetitive item is a list and its keys are the keys of one
# repetition.
module        cat250
version       0.1.0
distribution  public
source        "ASTERIX Category 250, Test Category for the Generator Tests, edition 1.10 (2020-01-02), as transcribed in github.com/zoranbosnjak/asterix-specs (BSD-3-Clause), commit aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa, specs/cat250/cats/cat1.10/definition.json. The category is specified by EUROCONTROL"
key   i010_sac      int     -       "I250/010/SAC: System Area Code (Data Source Identifier)"
key   i010_sic      int     -       "I250/010/SIC: System Identification Code (Data Source Identifier)"
key   i020_lat      float   deg     "I250/020/LAT: Latitude (Position in WGS-84 Co-ordinates). LSB 45/2097152 deg"
key   i020_lon      float   deg     "I250/020/LON: Longitude (Position in WGS-84 Co-ordinates). LSB 45/2097152 deg"
key   i030          float   s       "I250/030: Time of Day. LSB 1/128 s"
key   i040_roc      float   ft/min  "I250/040/ROC: Rate of Climb (Measured Movement). LSB 25/4 ft/min"
key   i060_typ      int     -       "I250/060/TYP: Report Type (Target Status). 0 = Plot, 1 = Track"
key   i060_src      int     -       "I250/060/SRC: Source (Target Status)"
key   i060_cnf      int     -       "I250/060/CNF: Confidence (Target Status)"
key   i060_age      int     -       "I250/060/AGE: Age in Scans (Target Status)"
list  i070          "I250/070: Plot Offsets, one item per repetition"
key   i070_dx       int     -       "I250/070/DX: Offset East (Plot Offsets)"
key   i070_dy       int     -       "I250/070/DY: Offset North (Plot Offsets)"
list  i080          "I250/080: Warning Codes, one item per repetition"
key   i080_val      int     -       "I250/080: Warning Codes"
key   i090_amp      float   dBm     "I250/090/AMP: Amplitude (Sensor Data). LSB 1 dBm"
key   i090_win_num  int     -       "I250/090/WIN/NUM: Window; Window Number (Sensor Data)"
key   i110          string  -       "I250/110: Target Name. 6 ASCII characters"
key   i120_oct      int     -       "I250/120/OCT: Octal Code (Codes). raw value: 4 octal digits of 3 bits each"
key   i120_icao     int     -       "I250/120/ICAO: Short Name (Codes). raw value: 8 characters of 6 bits each in the ICAO character set (ICAO Annex 10)"
key   report_class  int     -       "I250/130: Report Class. 0 = Undetermined, 1 = Aircraft, 2 = Ground vehicle"
key   i140          int     -       "I250/140: Class Detail. raw value; its content depends on the value of 130"
key   i160          int     -       "I250/160: Register. raw value: a Mode S BDS register with its address"
# Derived keys (engine-spec 0.6 and 0.8), applied by `convert` between decode and encode.
derive  cat250.i030  day_seconds  time_ms
