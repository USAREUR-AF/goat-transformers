# The depot module: raw keys shared by the packs that name it in a `uses` line,
# one per schema field a pack maps. Extended, never rewritten: a key keeps
# its line once it has one. Last extended for the depot-link format by
# tools/gen/proto2pack.py from the sources below; edit the generator, not this file.
module        depot
version       0.2.0
distribution  public
source        "The depot test schema: three .proto files written for the proto2pack tests"
source        "No license applies: the schema is part of this repository"
source        "The depot test schema: four .proto files written for the proto2pack tests"
key  sender                            string  -  "Envelope.sender (string): name of the sending depot"
key  sent_ms                           int     -  "Envelope.sent_ms (uint64)"
key  receipt_parcel_id                 string  -  "Receipt.parcel_id (string)"
key  receipt_signed_by                 string  -  "Receipt.signed_by (string)"
key  receipt_signed_by_at_11_5         string  -  "Receipt.signedBy (string): sanitizes to the name of field 2"
key  receipt_amount_cents              int     -  "Receipt.amount_cents (int64)"
key  parcel_report_parcel_id           string  -  "ParcelReport.parcel_id (string)"
key  position_latitude                 float   -  "Position.latitude (double): degrees north"
key  position_longitude                float   -  "Position.longitude (double): degrees east"
key  position_height_m                 float   -  "Position.height_m (float)"
key  position_frame                    int     -  "Position.frame (uint32): 1 means degrees on the reference ellipsoid"
key  parcel_report_handling            int     -  "ParcelReport.handling (enum Handling: 0=HANDLING_UNSPECIFIED, 1=HANDLING_FRAGILE, 2=HANDLING_COLD, 2=HANDLING_CHILLED): the handling the sender asked for (a comment of two lines)"
key  parcel_report_weight_kg           float   -  "ParcelReport.weight_kg (double)"
key  parcel_report_weight_g            int     -  "ParcelReport.weight_g (sint64)"
key  dimensions_length                 int     -  "Dimensions.length (uint32)"
key  dimensions_width                  int     -  "Dimensions.width (uint32)"
key  dimensions_unit                   int     -  "Dimensions.unit (enum Unit: 0=UNIT_MM, 1=UNIT_INCH)"
key  parcel_report_insured             int     -  "ParcelReport.insured (bool)"
key  parcel_report_east_rate           float   -  "ParcelReport.east_rate (double)"
key  parcel_report_north_rate          float   -  "ParcelReport.north_rate (double)"
key  reported_seconds                  int     -  "Timestamp.seconds (int64): seconds of UTC time since the Unix epoch"
key  reported_nanos                    int     -  "Timestamp.nanos (int32): non-negative fractions of a second, in nanoseconds"
key  origin_latitude                   float   -  "Position.latitude (double): degrees north"
key  origin_longitude                  float   -  "Position.longitude (double): degrees east"
key  origin_height_m                   float   -  "Position.height_m (float)"
key  origin_frame                      int     -  "Position.frame (uint32): 1 means degrees on the reference ellipsoid"
key  stop_depot_code                   string  -  "Stop.depot_code (string)"
key  stop_arrived_seconds              int     -  "Timestamp.seconds (int64): seconds of UTC time since the Unix epoch"
key  stop_arrived_nanos                int     -  "Timestamp.nanos (int32): non-negative fractions of a second, in nanoseconds"
key  stop_at_latitude                  float   -  "Position.latitude (double): degrees north"
key  stop_at_longitude                 float   -  "Position.longitude (double): degrees east"
key  stop_at_height_m                  float   -  "Position.height_m (float)"
key  stop_at_frame                     int     -  "Position.frame (uint32): 1 means degrees on the reference ellipsoid"
key  stop_delays_s_item                int     -  "Stop.delays_s (sint32); one item of the repeated field"
key  stop_notes_item                   string  -  "Stop.notes (string); one item of the repeated field"
key  scan_gate                         int     -  "Scan.gate (uint32): number of the gate that read the label"
key  scan_temperature_c                float   -  "Scan.temperature_c (double)"
key  parcel_report_scan_codes_item     int     -  "ParcelReport.scan_codes (uint32); one item of the repeated field"
key  parcel_report_past_handling_item  int     -  "ParcelReport.past_handling (enum Handling: 0=HANDLING_UNSPECIFIED, 1=HANDLING_FRAGILE, 2=HANDLING_COLD, 2=HANDLING_CHILLED); one item of the repeated field"
list receipt_route                "Receipt.route (repeated Stop); each item is one Stop message"
list stop_delays_s                "Stop.delays_s (repeated sint32); each item holds depot.stop_delays_s_item"
list stop_notes                   "Stop.notes (repeated string); each item holds depot.stop_notes_item"
list stop_scans                   "Stop.scans (repeated Scan); each item is one Scan message"
list parcel_report_stops          "ParcelReport.stops (repeated Stop); each item is one Stop message"
list parcel_report_scan_codes     "ParcelReport.scan_codes (repeated uint32); each item holds depot.parcel_report_scan_codes_item"
list parcel_report_past_handling  "ParcelReport.past_handling (repeated Handling); each item holds depot.parcel_report_past_handling_item"
key  control_min_version        int     -  "Control.min_version (uint32)"
key  control_max_version        int     -  "Control.max_version (uint32)"
key  sequence                   int     -  "Frame.sequence (uint32)"
key  ack_sequence               int     -  "Ack.sequence (uint32)"
key  ack_note                   string  -  "Ack.note (string)"
key  frame_hops_item            string  -  "Frame.hops (string); one item of the repeated field"
key  classification_type        string  -  "Classification.type (string)"
key  classification_confidence  float   -  "Classification.confidence (float)"
list hops                          "Frame.hops (repeated string); each item holds depot.frame_hops_item"
list parcel_report_classification  "ParcelReport.classification (repeated Classification); each item is one Classification message"
