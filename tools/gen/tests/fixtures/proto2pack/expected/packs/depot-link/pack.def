  group  depot.stop_scans  6
    field  depot.scan_gate  1  pvarint
    field  depot.scan_temperature_c  2  pdouble
  end
end
group  depot.parcel_report_scan_codes  2.10.5
  field  depot.parcel_report_scan_codes_item  .  pvarint
end
