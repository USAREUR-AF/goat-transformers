format        depot-link
version       0.2.0
distribution  public
source        "The depot test schema: four .proto files written for the proto2pack tests"
uses          depot
wire          protobuf

# common: the fields of Frame.control, a member that may stand beside any other
field  depot.control_min_version        1.1        pvarint
field  depot.control_max_version        1.2        pvarint
field  depot.sequence                   5          pvarint
group  depot.hops  4
  field  depot.frame_hops_item  .  pstring
end

