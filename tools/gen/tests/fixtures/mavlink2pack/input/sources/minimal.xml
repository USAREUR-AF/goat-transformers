<?xml version="1.0"?>
<!-- Test input for tools/gen/mavlink2pack.py, written for the tests. It is not
     a copy of the MAVLink definitions. HEARTBEAT states the field names, types
     and order of the public protocol, because the generator refuses a source
     whose HEARTBEAT does not give CRC_EXTRA 50. The enum is synthetic. -->
<mavlink>
  <version>3</version>
  <dialect>0</dialect>
  <enums>
    <enum name="TEST_MODE">
      <entry value="0" name="TEST_MODE_IDLE"/>
      <entry value="1" name="TEST_MODE_ACTIVE"/>
    </enum>
  </enums>
  <messages>
    <message id="0" name="HEARTBEAT">
      <description>Sent at a fixed rate by every component.</description>
      <field type="uint8_t" name="type">kind of vehicle or component</field>
      <field type="uint8_t" name="autopilot">kind of flight controller</field>
      <field type="uint8_t" name="base_mode">mode flags</field>
      <field type="uint32_t" name="custom_mode">mode number of the flight controller</field>
      <field type="uint8_t" name="system_status">state of the system</field>
      <field type="uint8_t_mavlink_version" name="mavlink_version">protocol version</field>
    </message>
  </messages>
</mavlink>
