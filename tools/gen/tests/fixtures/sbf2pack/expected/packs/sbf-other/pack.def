# SBF blocks of the group SBF_OTHER_BLOCKS of pysbf2, one kind per block of fixed length.
# Generated by tools/gen/sbf2pack.py; do not edit by hand.
# The message is one SBF block without its sync characters and CRC: block ID
# (u16), length (u16), body. Body bit 0 is bit 32.
format        sbf-other
version       0.1.0
distribution  public
source        "https://github.com/semuconsulting/pysbf2 src/pysbf2/sbftypes_blocks.py at v0.0.0-fixture (commit 0123456789abcdef0123456789abcdef01234567)"
uses          sbf
uses          sbfother
wire          bits
bit_order     lsb
word_bytes    1
field  sbf.revision 0:13:3 uint

kind      quality
when      0:0:13 4001
when      0:16:16 16
requires  sbfother.quality_tow sbfother.quality_pdop
field     sbfother.quality_tow 0:32:32 uint
field     sbfother.quality_pdop 0:64:16 uscale:1/100
const     0:80:16 0
