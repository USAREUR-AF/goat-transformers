# The dis7 module: the PDU fields of DIS 7, as the open-dis PDU descriptions lay
# them out. Generated by tools/gen/dis2pack.py; do not edit by hand. A key is
# <pdu>_<field path> in lower case with underscores; a list holds the items of a
# counted list. Units are those of DIS: the module states none.
module        dis7
version       0.1.0
distribution  public
source        "https://github.com/open-dis/xmlpg DIS2012.xml at fixture (commit 0123456789abcdef0123456789abcdef01234567); PDU types from https://github.com/open-dis/open-dis-python opendis/dis7.py at fixture (commit 89abcdef0123456789abcdef0123456789abcdef)"
key   track_state_parts_kind  int  -  "TrackStatePdu parts[] kind"
key   track_state_parts_value  float  -  "TrackStatePdu parts[] value"
key   track_state_parts_extra  int  -  "TrackStatePdu parts[] extra"
key   track_state_parts_pad  int  -  "TrackStatePdu parts[] pad"
key   track_state_ident_site  int  -  "TrackStatePdu ident.site"
key   track_state_ident_app  int  -  "TrackStatePdu ident.app"
key   track_state_ident_num  int  -  "TrackStatePdu ident.num"
key   track_state_mark  string  -  "TrackStatePdu mark"
key   track_state_place_x  float  -  "TrackStatePdu place.x"
key   track_state_place_y  float  -  "TrackStatePdu place.y"
key   track_state_place_z  float  -  "TrackStatePdu place.z"
key   track_state_spin_01  int  -  "TrackStatePdu spin.01"
key   track_state_spin_02  int  -  "TrackStatePdu spin.02"
key   pdu_length  int  -  "PDU header field length, in bytes, of a PDU with a counted list"
key   ping_from_site  int  -  "PingPdu from.site"
key   ping_from_app  int  -  "PingPdu from.app"
key   ping_from_num  int  -  "PingPdu from.num"
key   ping_token  int  -  "PingPdu token"
key   ping_level  float  -  "PingPdu level"
key   ping_delta  int  -  "PingPdu delta"
key   ping_pad_01  int  -  "PingPdu pad.01"
key   ping_pad_02  int  -  "PingPdu pad.02"
key   ping_pad_03  int  -  "PingPdu pad.03"
key   header_exercise_id  int  -  "PDU header field exerciseID"
key   header_protocol_family  int  -  "PDU header field protocolFamily"
key   header_timestamp  int  -  "PDU header field timestamp"
key   header_pdu_status  int  -  "PDU header field pduStatus"
key   header_padding  int  -  "PDU header field padding"
list  track_state_parts  "TrackStatePdu parts: the items of the counted list, one Part record each"
