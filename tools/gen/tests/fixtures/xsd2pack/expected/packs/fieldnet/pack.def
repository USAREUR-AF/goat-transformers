source        "File header of fieldnet-types.xsd: Distribution Statement A. Approved for public release: distribution is unlimited."
source        "A second source line, given on the command line"
wire          xml
uses          fieldnet
uses          track

# Common: the 4 leading lines every message has at the same place.
field  fieldnet.schema_version  @schemaVersion  string
field  fieldnet.message_header_timestamp  MessageHeader/Timestamp/#text  iso8601_ms
field  fieldnet.message_header_mode  MessageHeader/Mode/#text  string
field  fieldnet.message_header_sequence  MessageHeader/Sequence/#text  int

kind      sensor_status
root      SensorStatus
requires  fieldnet.sensor_id_uuid
field  fieldnet.source  MessageData/@source  string
field  fieldnet.origin  MessageData/@origin  string
field  fieldnet.sensor_id_uuid  MessageData/SensorID/UUID/#text  string
