field  fieldnet.level_string  MessageData/Level/#text  string
field  fieldnet.site_name_attr  MessageData/Site/@Name  string
field  fieldnet.site_name  MessageData/Site/Name/#text  string
field  fieldnet.codes  MessageData/Codes/#text  string
field  fieldnet.remark_lang  MessageData/Remark/@lang  string
field  fieldnet.tree_name  MessageData/Tree/Name/#text  string
field  fieldnet.voltage  MessageData/Voltage/#text  float
field  fieldnet.on_battery  MessageData/OnBattery/#text  string
field  fieldnet.quality  MessageData/Quality/#text  string
field  fieldnet.extended_diagnostic_information_block_secondary_power_distribution_subsystem_temperatur_e45de435  MessageData/ExtendedDiagnosticInformationBlock/SecondaryPowerDistributionSubsystem/TemperatureCompensatedOscillatorDriftEstimate/#text  float
field  fieldnet.note  MessageData/Note/#text  string
group  fieldnet.reading  MessageData/Reading
  field  fieldnet.quantity  @quantity  string
  field  fieldnet.unit  @unit  string
  field  fieldnet.value  Value/#text  float
  group  fieldnet.flag  Flag
    field  fieldnet.item  "#text"  string
  end
  group  fieldnet.sample  Sample
    field  fieldnet.at  @at  iso8601_ms
    field  fieldnet.v  @v  float
  end
end

# The default kind: an entity from another format that has `uid` encodes as it.

