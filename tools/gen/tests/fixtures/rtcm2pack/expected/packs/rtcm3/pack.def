source        "https://github.com/semuconsulting/pyrtcm src/pyrtcm/rtcmtypes_core.py and rtcmtypes_get.py at v0.0.0-fixture (commit 0123456789abcdef0123456789abcdef01234567)"
uses          rtcm3
wire          bits
layout        sequential
bit_order     msb

kind      m2001
when      12 2001
requires  rtcm3.m2001_df003 rtcm3.m2001_df012 rtcm3.m2001_df015
field     rtcm3.m2001_df003 12 uint
field     rtcm3.m2001_df012 20 sscale:1/10000
field     rtcm3.m2001_df015 10 smscale:1/2147483648
field     rtcm3.m2001_df016 10 uiscale:16
field     rtcm3.m2001_df017 22 sscale:1/256
field     rtcm3.m2001_df018 16 siscale:25000000
field     rtcm3.m2001_df019 24 sscale:0.000000000000000000013552527156068805425093160010874271392822265625
field     rtcm3.m2001_df020 6 uint
field     rtcm3.m2001_df021 8 smag
field     rtcm3.m2001_res_01_df020 6 uint
field     rtcm3.m2001_res_02_df020 6 uint

kind      m2002
when      12 2002
requires  rtcm3.m2002_df003
group     rtcm3.m2002_chars count 8
  field     rtcm3.m2002_chars_df014 8 ascii
end
field     rtcm3.m2002_df003 12 uint
group     rtcm3.m2002_sats count 8
