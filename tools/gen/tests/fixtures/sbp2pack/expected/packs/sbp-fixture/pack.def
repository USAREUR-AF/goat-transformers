distribution  public
source        "https://github.com/swift-nav/libsbp spec/yaml/swiftnav/sbp/fixture.yaml at v0.0.0-fixture (commit 0123456789abcdef0123456789abcdef01234567)"
uses          sbp
uses          sbpfixture
