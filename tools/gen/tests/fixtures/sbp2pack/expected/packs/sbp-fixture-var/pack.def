# SBP frames of the package swiftnav.sbp.fixture whose payload length is not fixed,
# one kind per message. Generated by tools/gen/sbp2pack.py; do not edit by hand.
# The frame: preamble 0x55, message type (u16), sender (u16), length (u8),
# payload, without the CRC. The payload is a `length 8 bytes` extent; an array
# or text that runs to its end is a `rest` group (engine-spec 0.8, 0.21).
format        sbp-fixture-var
version       0.1.0
distribution  public
source        "https://github.com/swift-nav/libsbp spec/yaml/swiftnav/sbp/fixture.yaml at v0.0.0-fixture (commit 0123456789abcdef0123456789abcdef01234567)"
uses          sbp
uses          sbpfixture
wire          bits
layout        sequential
bit_order     lsb
when  8  85

kind  trailing
when  16  28674
requires  sbpfixture.trailing_seq
field  sbp.sender  16  uint
length  8  bytes
  field  sbpfixture.trailing_seq  32  uint
  group  sbpfixture.trailing_data  rest
    field  sbpfixture.trailing_data_item  8  uint
  end
end

kind  trailing_text
when  16  28675
requires  sbpfixture.trailing_text_index
field  sbp.sender  16  uint
length  8  bytes
  field  sbpfixture.trailing_text_index  16  uint
  group  sbpfixture.trailing_text_text  rest
    field  sbpfixture.trailing_text_text_byte  8  uint
  end
end

kind  counted
when  16  28676
requires  sbpfixture.counted_tail
field  sbp.sender  16  uint
length  8  bytes
  count  n_n  8
  group  sbpfixture.counted_items  count @n_n
    field  sbpfixture.counted_items_sat  8  uint
    field  sbpfixture.counted_items_code  8  uint
  end
  field  sbpfixture.counted_tail  8  uint
end
