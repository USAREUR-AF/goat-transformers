{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:goat-transformers:neows-1-objects",
 "title": "NASA NeoWs (Near Earth Object Web Service) v1 objects, restated by goat-transformers",
 "description": "Member names of the NeoWs v1 objects as the neows-ruby client of the service's maintainers models them (lib/neows/models), with the JSON type each has on the wire as that client's test fixtures and a response read on 2026-11-21 show (several numbers are sent as strings). Restated by this project; no text of the sources is copied.",
 "$defs": {
  "EstimatedDiameterMinMax": {
   "type": "object",
   "properties": {
    "estimated_diameter_min": {
     "type": "number"
    },
    "estimated_diameter_max": {
     "type": "number"
    }
   }
  },
  "EstimatedDiameter": {
   "type": "object",
   "properties": {
    "kilometers": {
     "$ref": "#/$defs/EstimatedDiameterMinMax"
    },
    "meters": {
     "$ref": "#/$defs/EstimatedDiameterMinMax"
    },
    "miles": {
     "$ref": "#/$defs/EstimatedDiameterMinMax"
    },
    "feet": {
     "$ref": "#/$defs/EstimatedDiameterMinMax"
    }
   }
  },
  "RelativeVelocity": {
   "type": "object",
   "properties": {
    "kilometers_per_second": {
     "type": "string"
    },
    "kilometers_per_hour": {
     "type": "string"
    },
    "miles_per_hour": {
     "type": "string"
    }
   }
  },
  "MissDistance": {
   "type": "object",
   "properties": {
    "astronomical": {
     "type": "string"
    },
    "lunar": {
     "type": "string"
    },
    "kilometers": {
     "type": "string"
    },
    "miles": {
     "type": "string"
    }
   }
  },
  "CloseApproachData": {
   "type": "object",
   "properties": {
    "close_approach_date": {
     "type": "string"
    },
    "epoch_date_close_approach": {
     "type": "integer"
    },
    "relative_velocity": {
     "$ref": "#/$defs/RelativeVelocity"
    },
    "miss_distance": {
     "$ref": "#/$defs/MissDistance"
    },
    "orbiting_body": {
     "type": "string"
    }
   }
  },
  "OrbitalData": {
   "type": "object",
   "properties": {
    "orbit_id": {
     "type": "string"
    },
    "orbit_determination_date": {
     "type": "string"
    },
    "orbit_uncertainty": {
     "type": "string"
    },
    "minimum_orbit_intersection": {
     "type": "string"
    },
    "jupiter_tisserand_invariant": {
     "type": "string"
    },
    "epoch_osculation": {
     "type": "string"
    },
    "eccentricity": {
     "type": "string"
    },
    "semi_major_axis": {
     "type": "string"
    },
    "inclination": {
     "type": "string"
    },
    "ascending_node_longitude": {
     "type": "string"
    },
    "orbital_period": {
     "type": "string"
    },
    "perihelion_distance": {
     "type": "string"
    },
    "perihelion_argument": {
     "type": "string"
    },
    "aphelion_distance": {
     "type": "string"
    },
    "perihelion_time": {
     "type": "string"
    },
    "mean_anomaly": {
     "type": "string"
    },
    "mean_motion": {
     "type": "string"
    },
    "equinox": {
     "type": "string"
    }
   }
  },
  "SelfLink": {
   "type": "object",
   "properties": {
    "self": {
     "type": "string"
    }
   }
  },
  "Links": {
   "type": "object",
   "properties": {
    "self": {
     "type": "string"
    },
    "next": {
     "type": "string"
    },
    "prev": {
     "type": "string"
    }
   }
  },
  "Page": {
   "type": "object",
   "properties": {
    "size": {
     "type": "integer"
    },
    "total_elements": {
     "type": "integer"
    },
    "total_pages": {
     "type": "integer"
    },
    "number": {
     "type": "integer"
    }
   }
  },
  "NearEarthObject": {
   "type": "object",
   "properties": {
    "links": {
     "$ref": "#/$defs/SelfLink"
    },
    "neo_reference_id": {
     "type": "string"
    },
    "name": {
     "type": "string"
    },
    "nasa_jpl_url": {
     "type": "string"
    },
    "absolute_magnitude_h": {
     "type": "number"
    },
    "estimated_diameter": {
     "$ref": "#/$defs/EstimatedDiameter"
    },
    "is_potentially_hazardous_asteroid": {
     "type": "boolean"
    },
    "close_approach_data": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/CloseApproachData"
     }
    },
    "orbital_data": {
     "$ref": "#/$defs/OrbitalData"
    }
   },
   "required": [
    "neo_reference_id"
   ]
  },
  "Browse": {
   "type": "object",
   "properties": {
    "links": {
     "$ref": "#/$defs/Links"
    },
    "page": {
     "$ref": "#/$defs/Page"
    },
    "near_earth_objects": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/NearEarthObject"
     }
    }
   }
  },
  "Feed": {
   "type": "object",
   "properties": {
    "links": {
     "$ref": "#/$defs/Links"
    },
    "element_count": {
     "type": "integer"
    },
    "near_earth_objects": {
     "type": "object",
     "additionalProperties": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/NearEarthObject"
      }
     }
    }
   }
  },
  "Stat": {
   "type": "object",
   "properties": {
    "near_earth_object_count": {
     "type": "integer"
    },
    "close_approach_count": {
     "type": "integer"
    }
   }
  }
 }
}
