    {"id": "sensors", "name": "Sensors"},
    {"id": "transport", "name": "Transport"},
    {"id": "iot", "name": "IoT"},
    {"id": "networks", "name": "Networks"},
    {"id": "maps", "name": "Maps, weather and alerts"}
  ],
