# ROS 2 septentrio_gnss_driver messages in the JSON form of a rosbridge `publish` operation.
# Generated by tools/gen/ros2msg2pack.py; do not edit by hand.
# One kind per .msg file, selected by the member `type` ("<package>/msg/<Name>").
# The ROS message is the object under `msg`; arrays are groups.
format        ros2-septentrio-gnss-driver
version       0.1.0
distribution  public
source        "ROS 2 interface package septentrio_gnss_driver, https://github.com/septentrio-gnss/septentrio_gnss_driver master (BSD 3-Clause License) at commit 459dd41ed54ffaa72c2f0c6b5af16059ed809005, directory msg; field names, types and array forms only"
