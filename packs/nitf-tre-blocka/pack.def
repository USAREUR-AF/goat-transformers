# NITF TRE BLOCKA: the CEDATA of the extension, 123 characters. Public.
# GENERATED by tools/gen/nitfspec2pack.py from GDAL's nitf_spec.xml; edit the generator,
# not this file. pack.md states what is mapped and what is not.
format        nitf-tre-blocka
version       0.1.0
distribution  public
source        "GDAL frmts/nitf/data/nitf_spec.xml at commit fedfd3ec89d6674de030db8f351233f2ee164c30 (MIT, Copyright (c) 2011 Even Rouault), sha256 a4c3c303e91f19543a872dd215ee9d36a30f5445b7f11901c2c0b0068d0eea2c: TRE field names, lengths and order"
source        "MIL-STD-2500C NITF 2.1 (Distribution Statement A per ASSIST): IGEOLO and its default WGS 84 reference, for the BLOCKA corner"
uses          nitftre
wire          text
delimiter     none

field     nitftre.blocka_block_instance                0:0:2        int
field     nitftre.blocka_n_gray                        0:2:5        int
field     nitftre.blocka_l_lines                       0:7:5        int
field     nitftre.blocka_layover_angle                 0:12:3       int
field     nitftre.blocka_shadow_angle                  0:15:3       int
field     nitftre.blocka_frlc_loc                      0:34:21      string
field     nitftre.blocka_lrlc_loc                      0:55:21      string
field     nitftre.blocka_lrfc_loc                      0:76:21      string
field     nitftre.blocka_frfc_loc                      0:97:21      string
const     0:118:5      010.0

# FRFC_LOC in decimal degrees (+-dd.dddddd+-ddd.dddddd) gives lat and lon. The raw
# key above is written first on encode, so the field keeps its own text.
kind      frfc-loc-decimal-north
when      0:97:1  +
requires  nitftre.blocka_frfc_loc
field     lat  0:97:10  float
field     lon  0:107:11  float

kind      frfc-loc-decimal-south
when      0:97:1  -
requires  nitftre.blocka_frfc_loc
field     lat  0:97:10  float
field     lon  0:107:11  float

kind      frfc-loc-other
requires  nitftre.blocka_frfc_loc
