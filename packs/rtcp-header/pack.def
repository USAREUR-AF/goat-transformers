# RTCP packet (RFC 3550 sections 6.4 to 6.7): the sender report and receiver
# report with their report blocks, the header of a source description, the
# goodbye packet with its source list, and the fixed part of an
# application-defined packet. Public. SDES chunks, the goodbye reason, the
# application data and profile-specific extensions are not mapped (pack.md).
#
# Addressing: word_bytes 1 and bit_order msb; multi-octet fields are big-endian.
# A list counted by the 5-bit count of octet 0 writes that count on encode,
# over the field mapped on the same bits (ruling 2 of 0.7).
format        rtcp-header
version       0.2.0
distribution  public
source        "IETF RFC 3550, RTP: A Transport Protocol for Real-Time Applications, July 2003, sections 6.4.1, 6.4.2, 6.5, 6.6 and 6.7, https://www.rfc-editor.org/rfc/rfc3550.txt; layout restated"
uses          inet
wire          bits
word_bytes    1
bit_order     msb

field  inet.rtcp_version            0:0:2      uint
field  inet.rtcp_padding            0:2:1      uint
field  inet.rtcp_length             0:16:16    uint

# Packet type 200: sender information (octets 8-27), then the report blocks.
kind      sender-report
when      0:8:8  200
requires  inet.rtcp_packet_count
field  inet.rtcp_report_count       0:3:5      uint
field  inet.rtcp_ssrc               0:32:32    uint
field  inet.rtcp_ntp_ts_sec         0:64:32    uint
field  inet.rtcp_ntp_ts_frac        0:96:32    uint
field  inet.rtcp_rtp_timestamp      0:128:32   uint
field  inet.rtcp_packet_count       0:160:32   uint
field  inet.rtcp_octet_count        0:192:32   uint
group  inet.rtcp_report_blocks  0:224  item 192  count 0:3:5
  field  inet.rtcp_rb_ssrc            0:0:32     uint
  field  inet.rtcp_rb_fraction_lost   0:32:8     uint
  field  inet.rtcp_rb_cumulative_lost 0:40:24    twos
  field  inet.rtcp_rb_ext_highest_seq 0:64:32    uint
  field  inet.rtcp_rb_jitter          0:96:32    uint
  field  inet.rtcp_rb_lsr             0:128:32   uint
  field  inet.rtcp_rb_dlsr            0:160:32   uint
end

# Packet type 201: the report blocks follow the SSRC.
kind      receiver-report
when      0:8:8  201
field  inet.rtcp_report_count       0:3:5      uint
field  inet.rtcp_ssrc               0:32:32    uint
group  inet.rtcp_report_blocks  0:64  item 192  count 0:3:5
  field  inet.rtcp_rb_ssrc            0:0:32     uint
  field  inet.rtcp_rb_fraction_lost   0:32:8     uint
  field  inet.rtcp_rb_cumulative_lost 0:40:24    twos
  field  inet.rtcp_rb_ext_highest_seq 0:64:32    uint
  field  inet.rtcp_rb_jitter          0:96:32    uint
  field  inet.rtcp_rb_lsr             0:128:32   uint
  field  inet.rtcp_rb_dlsr            0:160:32   uint
end

# Packet type 202: the header only; the chunks are not mapped.
kind      source-description
when      0:8:8  202
field  inet.rtcp_source_count       0:3:5      uint

# Packet type 203: the identifiers of the sources leaving.
kind      goodbye
when      0:8:8  203
field  inet.rtcp_source_count       0:3:5      uint
group  inet.rtcp_bye_sources  0:32  item 32  count 0:3:5
  field  inet.rtcp_bye_ssrc           0:0:32     uint
end

# Packet type 204: subtype, SSRC and name; the application data is not mapped.
kind      application
when      0:8:8  204
field  inet.rtcp_app_subtype        0:3:5      uint
field  inet.rtcp_ssrc               0:32:32    uint
field  inet.rtcp_app_name           0:64:32    ascii
