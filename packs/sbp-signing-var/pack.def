# SBP frames of the package swiftnav.sbp.signing whose payload length is not fixed,
# one kind per message. Generated by tools/gen/sbp2pack.py; do not edit by hand.
# The frame: preamble 0x55, message type (u16), sender (u16), length (u8),
# payload, without the CRC. The payload is a `length 8 bytes` extent; an array
# or text that runs to its end is a `rest` group (engine-spec 0.8, 0.21).
format        sbp-signing-var
version       0.1.0
distribution  public
source        "https://github.com/swift-nav/libsbp spec/yaml/swiftnav/sbp/signing.yaml at v6.5.2 (commit 925825dea5174f069b5d6e23548f213e09f0235c)"
uses          sbp
uses          sbpsigning
wire          bits
layout        sequential
bit_order     lsb
when  8  85

kind  ecdsa_certificate
when  16  3076
requires  sbpsigning.ecdsa_certificate_n_msg
field  sbp.sender  16  uint
length  8  bytes
  field  sbpsigning.ecdsa_certificate_n_msg  8  uint
  field  sbpsigning.ecdsa_certificate_certificate_id_0  8  uint
  field  sbpsigning.ecdsa_certificate_certificate_id_1  8  uint
  field  sbpsigning.ecdsa_certificate_certificate_id_2  8  uint
  field  sbpsigning.ecdsa_certificate_certificate_id_3  8  uint
  field  sbpsigning.ecdsa_certificate_flags  8  uint
  group  sbpsigning.ecdsa_certificate_certificate_bytes  rest
    field  sbpsigning.ecdsa_certificate_certificate_bytes_item  8  uint
  end
end

