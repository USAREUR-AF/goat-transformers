# Eddystone BLE beacon: one advertising payload, its AD structures, and the Eddystone frame
# (UID, URL, TLM plain and encrypted, EID) in the Service Data of UUID 0xFEAA. Public.
# Written by tools/gen/beacons-pack.py from google/eddystone (Apache-2.0). See pack.md.
format     eddystone
version    0.1.0
distribution public
source     "google/eddystone, https://github.com/google/eddystone commit bb8738d7ddac0ddd3dfa70e594d011a0475e763d: protocol-specification.md, eddystone-uid, eddystone-url, eddystone-tlm (tlm-plain, tlm-encrypted), eddystone-eid (Apache-2.0)"
uses       ble
uses       eddystone
wire       bits
layout     sequential
bit_order  msb

group  ble.ad_structures  rest
  length 8 bytes                       # the length counts the AD type and the data
    field  ble.ad_type  8  uint
    switch ble.ad_type
      case 1                               # Flags
        field  ble.flags  8  uint
      case 2,3                             # Incomplete and complete list of 16-bit service UUIDs
        group  ble.service_uuids16  rest
          field  ble.service_uuid16  16  uint  swap
        end
      case 10                              # Tx Power Level
        field  ble.tx_power_level  8  twos
      case 22                              # Service Data, 16-bit UUID
        field  ble.service_data_uuid16  16  uint  swap
        switch ble.service_data_uuid16
          case 65194                           # 0xFEAA, Eddystone
            field  eddystone.frame_type  8  uint
            switch eddystone.frame_type
              case 0                               # UID
                field  eddystone.tx_power_0m      8   twos
                field  eddystone.namespace_high   16  uint
                field  eddystone.namespace_low    64  uint
                field  eddystone.instance         48  uint
                field  eddystone.uid_rfu          16  uint   # absent when the frame omits it
              case 16                              # URL
                field  eddystone.tx_power_0m      8   twos
                field  eddystone.url_scheme       8   uint
                group  eddystone.url_octets  rest
                  field  eddystone.url_octet  8  uint
                end
              case 32                              # TLM
                field  eddystone.tlm_version  8  uint
                switch eddystone.tlm_version
                  case 0                               # unencrypted
                    field  eddystone.battery_voltage  16  uint
                    field  eddystone.temperature      16  sscale:1/256  absent 32768
                    field  eddystone.adv_count        32  uint
                    field  eddystone.sec_count        32  uint
                  case 1                               # encrypted
                    field  eddystone.etlm_high        64  uint
                    field  eddystone.etlm_low         32  uint
                    field  eddystone.salt             16  uint
                    field  eddystone.mic              16  uint
                  else
                    group  eddystone.tlm_octets  rest
                      field  eddystone.tlm_octet  8  uint
                    end
                end
              case 48                              # EID
                field  eddystone.tx_power_0m      8   twos
                field  eddystone.eid              64  uint
              else
                group  eddystone.frame_octets  rest
                  field  eddystone.frame_octet  8  uint
                end
            end
          else
            group  ble.service_data  rest
              field  ble.service_data_octet  8  uint
            end
        end
      case 255                             # Manufacturer Specific Data
        field  ble.company_id  16  uint  swap
        group  ble.manufacturer_data  rest
          field  ble.manufacturer_data_octet  8  uint
        end
      else
        group  ble.ad_data  rest
          field  ble.ad_data_octet  8  uint
        end
    end
  end
end
