# ROS 2 rmf_workcell_msgs messages in the JSON form of a rosbridge `publish` operation.
# Generated by tools/gen/ros2msg2pack.py; do not edit by hand.
# One kind per .msg file, selected by the member `type` ("<package>/msg/<Name>").
# The ROS message is the object under `msg`; arrays are groups.
format        ros2-rmf-workcell-msgs
version       0.1.0
distribution  public
source        "ROS 2 interface package rmf_workcell_msgs, https://github.com/open-rmf/rmf_internal_msgs jazzy (Apache License 2.0) at commit 04585f0e2b0da9f11327fb403d38bc547d648fa6, directory rmf_workcell_msgs/msg; field names, types and array forms only"
source        "ROS 2 interface package builtin_interfaces (messages rmf_workcell_msgs refers to), https://github.com/ros2/rcl_interfaces 2.0.4 at commit 7aa3caf43377ea6ad615bc1040832e2c7566bfbe, Apache License 2.0"
source        "rosbridge v2.1.0 Protocol Specification, ROSBRIDGE_PROTOCOL.md, https://github.com/RobotWebTools/rosbridge_suite jazzy at commit cb33a16b890e4b8d9def531326409f3ee6c12537, BSD 3-Clause License; JSON form of a message and of the publish operation"
uses          ros2rmfworkcell
wire          json
when   op  publish
field  ros2rmfworkcell.topic  topic  string

kind      asset
when      type  rmf_workcell_msgs/msg/Asset
requires  ros2rmfworkcell.asset_guid
field  ros2rmfworkcell.asset_guid  msg.guid  string
field  ros2rmfworkcell.asset_type  msg.type  string

kind      trait
when      type  rmf_workcell_msgs/msg/Trait
requires  ros2rmfworkcell.trait_key
field  ros2rmfworkcell.trait_key  msg.key  string
group  ros2rmfworkcell.trait_value  msg.value
  field  ros2rmfworkcell.trait_value_value  .  string
end

kind      workcell_configuration
when      type  rmf_workcell_msgs/msg/WorkcellConfiguration
requires  ros2rmfworkcell.workcell_configuration_time_sec
field  ros2rmfworkcell.workcell_configuration_time_sec  msg.time.sec  int
field  ros2rmfworkcell.workcell_configuration_time_nanosec  msg.time.nanosec  int
field  ros2rmfworkcell.workcell_configuration_guid  msg.guid  string
field  ros2rmfworkcell.workcell_configuration_type  msg.type  string
group  ros2rmfworkcell.workcell_configuration_assets  msg.assets
  field  ros2rmfworkcell.workcell_configuration_assets_guid  guid  string
  field  ros2rmfworkcell.workcell_configuration_assets_type  type  string
end
group  ros2rmfworkcell.workcell_configuration_traits  msg.traits
  field  ros2rmfworkcell.workcell_configuration_traits_key  key  string
  group  ros2rmfworkcell.workcell_configuration_traits_value  value
    field  ros2rmfworkcell.workcell_configuration_traits_value_value  .  string
  end
end

kind      workcell_request
when      type  rmf_workcell_msgs/msg/WorkcellRequest
requires  ros2rmfworkcell.workcell_request_time_sec
field  ros2rmfworkcell.workcell_request_time_sec  msg.time.sec  int
field  ros2rmfworkcell.workcell_request_time_nanosec  msg.time.nanosec  int
field  ros2rmfworkcell.workcell_request_request_guid  msg.request_guid  string
field  ros2rmfworkcell.workcell_request_target_guid  msg.target_guid  string

kind      workcell_result
when      type  rmf_workcell_msgs/msg/WorkcellResult
requires  ros2rmfworkcell.workcell_result_time_sec
field  ros2rmfworkcell.workcell_result_time_sec  msg.time.sec  int
field  ros2rmfworkcell.workcell_result_time_nanosec  msg.time.nanosec  int
field  ros2rmfworkcell.workcell_result_request_guid  msg.request_guid  string
field  ros2rmfworkcell.workcell_result_source_guid  msg.source_guid  string
field  ros2rmfworkcell.workcell_result_status  msg.status  int

kind      workcell_state
when      type  rmf_workcell_msgs/msg/WorkcellState
requires  ros2rmfworkcell.workcell_state_time_sec
field  ros2rmfworkcell.workcell_state_time_sec  msg.time.sec  int
field  ros2rmfworkcell.workcell_state_time_nanosec  msg.time.nanosec  int
field  ros2rmfworkcell.workcell_state_guid  msg.guid  string
field  ros2rmfworkcell.workcell_state_mode  msg.mode  int
group  ros2rmfworkcell.workcell_state_request_guid_queue  msg.request_guid_queue
  field  ros2rmfworkcell.workcell_state_request_guid_queue_value  .  string
end
