# ROS 2 rmf_scheduler_msgs messages in the JSON form of a rosbridge `publish` operation.
# Generated by tools/gen/ros2msg2pack.py; do not edit by hand.
# One kind per .msg file, selected by the member `type` ("<package>/msg/<Name>").
# The ROS message is the object under `msg`; arrays are groups.
format        ros2-rmf-scheduler-msgs
version       0.1.0
distribution  public
source        "ROS 2 interface package rmf_scheduler_msgs, https://github.com/open-rmf/rmf_internal_msgs jazzy (Apache License 2.0) at commit 04585f0e2b0da9f11327fb403d38bc547d648fa6, directory rmf_scheduler_msgs/msg; field names, types and array forms only"
source        "rosbridge v2.1.0 Protocol Specification, ROSBRIDGE_PROTOCOL.md, https://github.com/RobotWebTools/rosbridge_suite jazzy at commit cb33a16b890e4b8d9def531326409f3ee6c12537, BSD 3-Clause License; JSON form of a message and of the publish operation"
uses          ros2rmfscheduler
wire          json
when   op  publish
field  ros2rmfscheduler.topic  topic  string

kind      payload
when      type  rmf_scheduler_msgs/msg/Payload
requires  ros2rmfscheduler.payload_type
field  ros2rmfscheduler.payload_type  msg.type  int
field  ros2rmfscheduler.payload_topic  msg.topic  string
field  ros2rmfscheduler.payload_message_type  msg.message_type  string
field  ros2rmfscheduler.payload_data  msg.data  string

kind      schedule
when      type  rmf_scheduler_msgs/msg/Schedule
requires  ros2rmfscheduler.schedule_name
field  ros2rmfscheduler.schedule_name  msg.name  string
field  ros2rmfscheduler.schedule_created_at  msg.created_at  int
field  ros2rmfscheduler.schedule_schedule  msg.schedule  string
field  ros2rmfscheduler.schedule_start_at  msg.start_at  int
field  ros2rmfscheduler.schedule_finish_at  msg.finish_at  int
field  ros2rmfscheduler.schedule_group  msg.group  string
field  ros2rmfscheduler.schedule_payload_type  msg.payload.type  int
field  ros2rmfscheduler.schedule_payload_topic  msg.payload.topic  string
field  ros2rmfscheduler.schedule_payload_message_type  msg.payload.message_type  string
field  ros2rmfscheduler.schedule_payload_data  msg.payload.data  string

kind      schedule_state
when      type  rmf_scheduler_msgs/msg/ScheduleState
requires  ros2rmfscheduler.schedule_state_name
field  ros2rmfscheduler.schedule_state_name  msg.name  string
field  ros2rmfscheduler.schedule_state_last_modified  msg.last_modified  int
field  ros2rmfscheduler.schedule_state_last_ran  msg.last_ran  int
field  ros2rmfscheduler.schedule_state_next_run  msg.next_run  int
field  ros2rmfscheduler.schedule_state_status  msg.status  int

kind      trigger
when      type  rmf_scheduler_msgs/msg/Trigger
requires  ros2rmfscheduler.trigger_name
field  ros2rmfscheduler.trigger_name  msg.name  string
field  ros2rmfscheduler.trigger_created_at  msg.created_at  int
field  ros2rmfscheduler.trigger_at  msg.at  int
field  ros2rmfscheduler.trigger_group  msg.group  string
field  ros2rmfscheduler.trigger_payload_type  msg.payload.type  int
field  ros2rmfscheduler.trigger_payload_topic  msg.payload.topic  string
field  ros2rmfscheduler.trigger_payload_message_type  msg.payload.message_type  string
field  ros2rmfscheduler.trigger_payload_data  msg.payload.data  string

kind      trigger_state
when      type  rmf_scheduler_msgs/msg/TriggerState
requires  ros2rmfscheduler.trigger_state_name
field  ros2rmfscheduler.trigger_state_name  msg.name  string
field  ros2rmfscheduler.trigger_state_last_modified  msg.last_modified  int
field  ros2rmfscheduler.trigger_state_last_ran  msg.last_ran  int
field  ros2rmfscheduler.trigger_state_status  msg.status  int
