# ROS 2 velodyne_msgs messages in the JSON form of a rosbridge `publish` operation.
# Generated by tools/gen/ros2msg2pack.py; do not edit by hand.
# One kind per .msg file, selected by the member `type` ("<package>/msg/<Name>").
# The ROS message is the object under `msg`; arrays are groups.
format        ros2-velodyne-msgs
version       0.1.0
distribution  public
source        "ROS 2 interface package velodyne_msgs, https://github.com/ros-drivers/velodyne ros2 (BSD License) at commit 8cdc0f37c8d6df1614bdbc424dd09f40a3c29251, directory velodyne_msgs/msg; field names, types and array forms only"
source        "ROS 2 interface package builtin_interfaces (messages velodyne_msgs refers to), https://github.com/ros2/rcl_interfaces 2.0.4 at commit 7aa3caf43377ea6ad615bc1040832e2c7566bfbe, Apache License 2.0"
source        "ROS 2 interface package std_msgs (messages velodyne_msgs refers to), https://github.com/ros2/common_interfaces 5.3.8 at commit a941f14bb318d8d904505ed935ccbb97f24a70a4, Apache License 2.0"
source        "rosbridge v2.1.0 Protocol Specification, ROSBRIDGE_PROTOCOL.md, https://github.com/RobotWebTools/rosbridge_suite jazzy at commit cb33a16b890e4b8d9def531326409f3ee6c12537, BSD 3-Clause License; JSON form of a message and of the publish operation"
uses          ros2velodyne
wire          json
when   op  publish
field  ros2velodyne.topic  topic  string

kind      velodyne_packet
when      type  velodyne_msgs/msg/VelodynePacket
requires  ros2velodyne.velodyne_packet_stamp_sec
field  ros2velodyne.velodyne_packet_stamp_sec  msg.stamp.sec  int
field  ros2velodyne.velodyne_packet_stamp_nanosec  msg.stamp.nanosec  int
field  ros2velodyne.velodyne_packet_data  msg.data  string

kind      velodyne_scan
when      type  velodyne_msgs/msg/VelodyneScan
requires  ros2velodyne.velodyne_scan_header_stamp_sec
field  ros2velodyne.velodyne_scan_header_stamp_sec  msg.header.stamp.sec  int
field  ros2velodyne.velodyne_scan_header_stamp_nanosec  msg.header.stamp.nanosec  int
field  ros2velodyne.velodyne_scan_header_frame_id  msg.header.frame_id  string
group  ros2velodyne.velodyne_scan_packets  msg.packets
  field  ros2velodyne.velodyne_scan_packets_stamp_sec  stamp.sec  int
  field  ros2velodyne.velodyne_scan_packets_stamp_nanosec  stamp.nanosec  int
  field  ros2velodyne.velodyne_scan_packets_data  data  string
end
