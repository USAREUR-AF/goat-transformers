# RTZ route exchange file, schema revision 1.2 (CIRM; IEC PAS 61174-1:2021): the route information, the
# default waypoint, the waypoints with their legs, and the first schedule's manual and calculated elements.
# Written by tools/gen/maritime-pack.py; do not edit by hand.
format  rtz-route
version 0.1.0
distribution public
source        "CIRM, Route Exchange Format (RTZ) XML schema, revision 1.2 (IEC PAS 61174-1:2021), https://cirm.org/storage/documents/October2022/bWjrTyyfNGseK9ch3TKf.xsd from https://cirm.org/rtz-xml-schemas (sha256 ba5695107e2b559ea0594eb80f7407b7e4f1c10da8cf09b447b4b920f681ceff), no licence stated; structure restated"
uses    rtz
wire    xml
root    route
when    @xmlns    http://www.cirm.org/RTZ/1/2
when    @version  1.2

kind    route
field   rtz.route_name  routeInfo/@routeName  string
field   rtz.route_author  routeInfo/@routeAuthor  string
field   rtz.route_status  routeInfo/@routeStatus  string
field   rtz.validity_start  routeInfo/@validityPeriodStart  string
field   rtz.validity_stop  routeInfo/@validityPeriodStop  string
field   rtz.vessel_name  routeInfo/@vesselName  string
