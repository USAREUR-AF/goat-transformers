field   rtz.vessel_max_wind  routeInfo/@vesselMaxWind  float
field   rtz.vessel_speed_max  routeInfo/@vesselSpeedMax  float
field   rtz.vessel_service_min  routeInfo/@vesselServiceMin  float
field   rtz.vessel_service_max  routeInfo/@vesselServiceMax  float
field   rtz.route_changes_history  routeInfo/@routeChangesHistory  string
field   rtz.default_radius  waypoints/defaultWaypoint/@radius  float
field   rtz.default_starboard_xtd  waypoints/defaultWaypoint/leg/@starboardXTD  float
field   rtz.default_portside_xtd  waypoints/defaultWaypoint/leg/@portsideXTD  float
field   rtz.default_safety_contour  waypoints/defaultWaypoint/leg/@safetyContour  float
field   rtz.default_safety_depth  waypoints/defaultWaypoint/leg/@safetyDepth  float
field   rtz.default_geometry_type  waypoints/defaultWaypoint/leg/@geometryType  string
field   rtz.default_speed_min  waypoints/defaultWaypoint/leg/@speedMin  float
field   rtz.default_speed_max  waypoints/defaultWaypoint/leg/@speedMax  float
field   rtz.default_draught_forward  waypoints/defaultWaypoint/leg/@draughtForward  float
field   rtz.default_draught_aft  waypoints/defaultWaypoint/leg/@draughtAft  float
field   rtz.default_static_ukc  waypoints/defaultWaypoint/leg/@staticUKC  float
field   rtz.default_dynamic_ukc  waypoints/defaultWaypoint/leg/@dynamicUKC  float
field   rtz.default_masthead  waypoints/defaultWaypoint/leg/@masthead  float
field   rtz.default_leg_report  waypoints/defaultWaypoint/leg/@legReport  string
field   rtz.default_leg_info  waypoints/defaultWaypoint/leg/@legInfo  string
field   rtz.default_leg_note1  waypoints/defaultWaypoint/leg/@legNote1  string
field   rtz.default_leg_note2  waypoints/defaultWaypoint/leg/@legNote2  string
group   rtz.waypoints  waypoints/waypoint
  field  rtz.id  @id  int
  field  rtz.revision  @revision  int
  field  rtz.name  @name  string
  field  rtz.radius  @radius  float
  field  rtz.lat  position/@lat  float
  field  rtz.lon  position/@lon  float
  field  rtz.starboard_xtd  leg/@starboardXTD  float
  field  rtz.portside_xtd  leg/@portsideXTD  float
  field  rtz.safety_contour  leg/@safetyContour  float
  field  rtz.safety_depth  leg/@safetyDepth  float
  field  rtz.geometry_type  leg/@geometryType  string
  field  rtz.speed_min  leg/@speedMin  float
  field  rtz.speed_max  leg/@speedMax  float
  field  rtz.draught_forward  leg/@draughtForward  float
  field  rtz.draught_aft  leg/@draughtAft  float
  field  rtz.static_ukc  leg/@staticUKC  float
  field  rtz.dynamic_ukc  leg/@dynamicUKC  float
  field  rtz.masthead  leg/@masthead  float
  field  rtz.leg_report  leg/@legReport  string
  field  rtz.leg_info  leg/@legInfo  string
  field  rtz.leg_note1  leg/@legNote1  string
  field  rtz.leg_note2  leg/@legNote2  string
end
field   rtz.schedule_id  schedules/schedule/@id  int
field   rtz.schedule_name  schedules/schedule/@name  string
group   rtz.manual_elements  schedules/schedule/manual/scheduleElement
  field  rtz.waypoint_id  @waypointId  int
  field  rtz.etd  @etd  string
  field  rtz.etd_window_before  @etdWindowBefore  string
  field  rtz.etd_window_after  @etdWindowAfter  string
