  field  rtz.rel_fuel_save  @relFuelSave  float
  field  rtz.abs_fuel_save  @absFuelSave  float
  field  rtz.note  @Note  string
end
group   rtz.calculated_elements  schedules/schedule/calculated/scheduleElement
  field  rtz.waypoint_id  @waypointId  int
  field  rtz.etd  @etd  string
  field  rtz.etd_window_before  @etdWindowBefore  string
  field  rtz.etd_window_after  @etdWindowAfter  string
  field  rtz.eta  @eta  string
  field  rtz.eta_window_before  @etaWindowBefore  string
  field  rtz.eta_window_after  @etaWindowAfter  string
  field  rtz.stay  @stay  string
  field  rtz.speed  @speed  float
  field  rtz.speed_window  @speedWindow  float
  field  rtz.wind_speed  @windSpeed  float
  field  rtz.wind_direction  @windDirection  float
  field  rtz.current_speed  @currentSpeed  float
  field  rtz.current_direction  @currentDirection  float
  field  rtz.wind_loss  @windLoss  float
  field  rtz.wave_loss  @waveLoss  float
  field  rtz.total_loss  @totalLoss  float
  field  rtz.rpm  @rpm  int
  field  rtz.pitch  @pitch  int
  field  rtz.fuel  @fuel  float
  field  rtz.rel_fuel_save  @relFuelSave  float
  field  rtz.abs_fuel_save  @absFuelSave  float
