# ASTERIX Category 019, Multilateration System Status Messages, edition 1.3: one data block holding one record.
# Public. Generated by tools/gen/asterix2pack.py from the category definition of
# github.com/zoranbosnjak/asterix-specs (BSD-3-Clause); do not edit by hand. I/O is hex text.
# Needs engine version 0.8 (`layout sequential`). See pack.md.
#
#   octet 1       CAT = 19
#   octets 2-3    LEN, the length of the data block in octets, CAT and LEN included
#   FSPEC         octets of 7 presence bits and an extension bit; bit n is FRN n
#   then          the items whose FSPEC bit is 1, in FRN order
#
# An FRN with no `if` block is not mapped: a record with that FSPEC bit set fails
# with `malformed-wire` (ruling 1 of engine-spec 0.8), and encode never sets the bit.
format     asterix-cat019
version    0.1.0
distribution public
source  "ASTERIX Category 019, Multilateration System Status Messages, edition 1.3 (2010-12-01), as transcribed in github.com/zoranbosnjak/asterix-specs (BSD-3-Clause), commit 64e9ffba964b92a1af3157bc6bdf7852a63bf700, specs/cat019/cats/cat1.3/definition.json. The category is specified by EUROCONTROL"
uses       cat019
wire       bits
layout     sequential
bit_order  msb
kind    record
when    8  19                              # CAT
length  16 whole                         # LEN
presence f fx
if f.1                                   # FRN 1, I019/010 Data Source Identifier
  field  cat019.i010_sac  8  uint
  field  cat019.i010_sic  8  uint
end
if f.2                                   # FRN 2, I019/000 Message Type
  field  cat019.i000  8  uint
end
if f.3                                   # FRN 3, I019/140 Time of Day
  field  cat019.i140  24  uscale:1/128
end
if f.4                                   # FRN 4, I019/550 System Status
  field  cat019.i550_nogo  2  uint
  field  cat019.i550_ovl  1  uint
  field  cat019.i550_tsv  1  uint
  field  cat019.i550_ttf  1  uint
  pad    3
end
if f.5                                   # FRN 5, I019/551 Tracking Processor Detailed Status
  field  cat019.i551_tp1a  1  uint
  field  cat019.i551_tp1b  1  uint
  field  cat019.i551_tp2a  1  uint
  field  cat019.i551_tp2b  1  uint
  field  cat019.i551_tp3a  1  uint
  field  cat019.i551_tp3b  1  uint
  field  cat019.i551_tp4a  1  uint
  field  cat019.i551_tp4b  1  uint
end
if f.6                                   # FRN 6, I019/552 Remote Sensor Detailed Status
  group  cat019.i552  count 8
    field  cat019.i552_rsi  8  uint
    pad    1
    field  cat019.i552_rs1090  1  uint
    field  cat019.i552_tx1030  1  uint
    field  cat019.i552_tx1090  1  uint
    field  cat019.i552_rss  1  uint
    field  cat019.i552_rso  1  uint
    pad    2
  end
end
if f.7                                   # FRN 7, I019/553 Reference Transponder Detailed Status
  chain
    field  cat019.i553_reftr1  2  uint
    pad    2
    field  cat019.i553_reftr2  2  uint
    pad    1
    fx
    field  cat019.i553_reftr3  2  uint
    pad    2
    field  cat019.i553_reftr4  2  uint
    pad    1
    fx
  end
end
if f.8                                   # FRN 8, I019/600 Position of the MLT System Reference Point
  field  cat019.i600_lat  32  sscale:45/268435456
  field  cat019.i600_lon  32  sscale:45/268435456
end
if f.9                                   # FRN 9, I019/610 Height of the MLT System Reference Point
  field  cat019.i610  16  sscale:1/4
end
if f.10                                  # FRN 10, I019/620 WGS-84 Undulation
  field  cat019.i620  8  sscale:1
end
# FRN 11: spare FRN
# FRN 12: spare FRN
if f.13                                  # FRN 13, I019/RE Reserved Expansion Field
  length 8 bytes plus 1                # the length octet counts itself; the content is not mapped
  end
end
if f.14                                  # FRN 14, I019/SP Special Purpose Field
  length 8 bytes plus 1                # the length octet counts itself; the content is not mapped
  end
end
