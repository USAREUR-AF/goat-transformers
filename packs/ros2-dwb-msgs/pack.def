# ROS 2 dwb_msgs messages in the JSON form of a rosbridge `publish` operation.
# Generated by tools/gen/ros2msg2pack.py; do not edit by hand.
# One kind per .msg file, selected by the member `type` ("<package>/msg/<Name>").
# The ROS message is the object under `msg`; arrays are groups.
format        ros2-dwb-msgs
version       0.1.0
distribution  public
source        "ROS 2 interface package dwb_msgs, https://github.com/ros-navigation/navigation2 jazzy (Apache-2.0 or BSD-3-Clause per package.xml) at commit c7046550547d382a5186d106b0895eda02485d7c, directory nav2_dwb_controller/dwb_msgs/msg; field names, types and array forms only"
source        "ROS 2 interface package builtin_interfaces (messages dwb_msgs refers to), https://github.com/ros2/rcl_interfaces 2.0.4 at commit 7aa3caf43377ea6ad615bc1040832e2c7566bfbe, Apache License 2.0"
source        "ROS 2 interface package geometry_msgs (messages dwb_msgs refers to), https://github.com/ros2/common_interfaces 5.3.8 at commit a941f14bb318d8d904505ed935ccbb97f24a70a4, Apache License 2.0"
source        "ROS 2 interface package nav_2d_msgs (messages dwb_msgs refers to), https://github.com/ros-navigation/navigation2 jazzy at commit c7046550547d382a5186d106b0895eda02485d7c, Apache-2.0 or BSD-3-Clause per package.xml"
source        "ROS 2 interface package std_msgs (messages dwb_msgs refers to), https://github.com/ros2/common_interfaces 5.3.8 at commit a941f14bb318d8d904505ed935ccbb97f24a70a4, Apache License 2.0"
source        "rosbridge v2.1.0 Protocol Specification, ROSBRIDGE_PROTOCOL.md, https://github.com/RobotWebTools/rosbridge_suite jazzy at commit cb33a16b890e4b8d9def531326409f3ee6c12537, BSD 3-Clause License; JSON form of a message and of the publish operation"
uses          ros2dwb
wire          json
when   op  publish
field  ros2dwb.topic  topic  string

kind      critic_score
when      type  dwb_msgs/msg/CriticScore
requires  ros2dwb.critic_score_name
field  ros2dwb.critic_score_name  msg.name  string
field  ros2dwb.critic_score_raw_score  msg.raw_score  float
field  ros2dwb.critic_score_scale  msg.scale  float

kind      local_plan_evaluation
when      type  dwb_msgs/msg/LocalPlanEvaluation
requires  ros2dwb.local_plan_evaluation_header_stamp_sec
field  ros2dwb.local_plan_evaluation_header_stamp_sec  msg.header.stamp.sec  int
field  ros2dwb.local_plan_evaluation_header_stamp_nanosec  msg.header.stamp.nanosec  int
field  ros2dwb.local_plan_evaluation_header_frame_id  msg.header.frame_id  string
group  ros2dwb.local_plan_evaluation_twists  msg.twists
  field  ros2dwb.local_plan_evaluation_twists_traj_velocity_x  traj.velocity.x  float
  field  ros2dwb.local_plan_evaluation_twists_traj_velocity_y  traj.velocity.y  float
  field  ros2dwb.local_plan_evaluation_twists_traj_velocity_theta  traj.velocity.theta  float
  group  ros2dwb.local_plan_evaluation_twists_traj_time_offsets  traj.time_offsets
    field  ros2dwb.local_plan_evaluation_twists_traj_time_offsets_sec  sec  int
    field  ros2dwb.local_plan_evaluation_twists_traj_time_offsets_nanosec  nanosec  int
  end
  group  ros2dwb.local_plan_evaluation_twists_traj_poses  traj.poses
    field  ros2dwb.local_plan_evaluation_twists_traj_poses_x  x  float
    field  ros2dwb.local_plan_evaluation_twists_traj_poses_y  y  float
    field  ros2dwb.local_plan_evaluation_twists_traj_poses_theta  theta  float
  end
  group  ros2dwb.local_plan_evaluation_twists_scores  scores
    field  ros2dwb.local_plan_evaluation_twists_scores_name  name  string
    field  ros2dwb.local_plan_evaluation_twists_scores_raw_score  raw_score  float
    field  ros2dwb.local_plan_evaluation_twists_scores_scale  scale  float
  end
  field  ros2dwb.local_plan_evaluation_twists_total  total  float
end
field  ros2dwb.local_plan_evaluation_best_index  msg.best_index  int
field  ros2dwb.local_plan_evaluation_worst_index  msg.worst_index  int

kind      trajectory2d
when      type  dwb_msgs/msg/Trajectory2D
requires  ros2dwb.trajectory2d_velocity_x
field  ros2dwb.trajectory2d_velocity_x  msg.velocity.x  float
field  ros2dwb.trajectory2d_velocity_y  msg.velocity.y  float
field  ros2dwb.trajectory2d_velocity_theta  msg.velocity.theta  float
group  ros2dwb.trajectory2d_time_offsets  msg.time_offsets
  field  ros2dwb.trajectory2d_time_offsets_sec  sec  int
  field  ros2dwb.trajectory2d_time_offsets_nanosec  nanosec  int
end
group  ros2dwb.trajectory2d_poses  msg.poses
  field  ros2dwb.trajectory2d_poses_x  x  float
  field  ros2dwb.trajectory2d_poses_y  y  float
  field  ros2dwb.trajectory2d_poses_theta  theta  float
end

kind      trajectory_score
when      type  dwb_msgs/msg/TrajectoryScore
requires  ros2dwb.trajectory_score_traj_velocity_x
field  ros2dwb.trajectory_score_traj_velocity_x  msg.traj.velocity.x  float
field  ros2dwb.trajectory_score_traj_velocity_y  msg.traj.velocity.y  float
field  ros2dwb.trajectory_score_traj_velocity_theta  msg.traj.velocity.theta  float
group  ros2dwb.trajectory_score_traj_time_offsets  msg.traj.time_offsets
  field  ros2dwb.trajectory_score_traj_time_offsets_sec  sec  int
  field  ros2dwb.trajectory_score_traj_time_offsets_nanosec  nanosec  int
end
group  ros2dwb.trajectory_score_traj_poses  msg.traj.poses
  field  ros2dwb.trajectory_score_traj_poses_x  x  float
  field  ros2dwb.trajectory_score_traj_poses_y  y  float
  field  ros2dwb.trajectory_score_traj_poses_theta  theta  float
end
group  ros2dwb.trajectory_score_scores  msg.scores
  field  ros2dwb.trajectory_score_scores_name  name  string
  field  ros2dwb.trajectory_score_scores_raw_score  raw_score  float
  field  ros2dwb.trajectory_score_scores_scale  scale  float
end
field  ros2dwb.trajectory_score_total  msg.total  float
