# ROS 2 tier4_vehicle_msgs messages in the JSON form of a rosbridge `publish` operation.
# Generated by tools/gen/ros2msg2pack.py; do not edit by hand.
# One kind per .msg file, selected by the member `type` ("<package>/msg/<Name>").
# The ROS message is the object under `msg`; arrays are groups.
format        ros2-tier4-vehicle-msgs
version       0.1.0
distribution  public
source        "ROS 2 interface package tier4_vehicle_msgs, https://github.com/tier4/tier4_autoware_msgs tier4/universe (Apache License 2.0) at commit efa4129394ad0b83a1de6c6d90ad937d74e9e426, directory tier4_vehicle_msgs/msg; field names, types and array forms only"
source        "ROS 2 interface package builtin_interfaces (messages tier4_vehicle_msgs refers to), https://github.com/ros2/rcl_interfaces 2.0.4 at commit 7aa3caf43377ea6ad615bc1040832e2c7566bfbe, Apache License 2.0"
