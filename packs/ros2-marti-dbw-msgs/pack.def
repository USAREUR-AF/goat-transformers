# ROS 2 marti_dbw_msgs messages in the JSON form of a rosbridge `publish` operation.
# Generated by tools/gen/ros2msg2pack.py; do not edit by hand.
# One kind per .msg file, selected by the member `type` ("<package>/msg/<Name>").
# The ROS message is the object under `msg`; arrays are groups.
format        ros2-marti-dbw-msgs
version       0.1.0
distribution  public
source        "ROS 2 interface package marti_dbw_msgs, https://github.com/swri-robotics/marti_messages ros2-devel (BSD License) at commit 2c7215f88d1466b698f77b8020533ac5fc75a3da, directory marti_dbw_msgs/msg; field names, types and array forms only"
source        "ROS 2 interface package builtin_interfaces (messages marti_dbw_msgs refers to), https://github.com/ros2/rcl_interfaces 2.0.4 at commit 7aa3caf43377ea6ad615bc1040832e2c7566bfbe, Apache License 2.0"
source        "ROS 2 interface package std_msgs (messages marti_dbw_msgs refers to), https://github.com/ros2/common_interfaces 5.3.8 at commit a941f14bb318d8d904505ed935ccbb97f24a70a4, Apache License 2.0"
source        "rosbridge v2.1.0 Protocol Specification, ROSBRIDGE_PROTOCOL.md, https://github.com/RobotWebTools/rosbridge_suite jazzy at commit cb33a16b890e4b8d9def531326409f3ee6c12537, BSD 3-Clause License; JSON form of a message and of the publish operation"
uses          ros2martidbw
wire          json
when   op  publish
field  ros2martidbw.topic  topic  string

kind      primary_control
when      type  marti_dbw_msgs/msg/PrimaryControl
requires  ros2martidbw.primary_control_header_stamp_sec
field  ros2martidbw.primary_control_header_stamp_sec  msg.header.stamp.sec  int
field  ros2martidbw.primary_control_header_stamp_nanosec  msg.header.stamp.nanosec  int
field  ros2martidbw.primary_control_header_frame_id  msg.header.frame_id  string
field  ros2martidbw.primary_control_active  msg.active  bool
field  ros2martidbw.primary_control_estop  msg.estop  bool
field  ros2martidbw.primary_control_steering_command  msg.steering_command  float
field  ros2martidbw.primary_control_throttle_command  msg.throttle_command  float
field  ros2martidbw.primary_control_brake_command  msg.brake_command  float

kind      primary_feedback
when      type  marti_dbw_msgs/msg/PrimaryFeedback
requires  ros2martidbw.primary_feedback_header_stamp_sec
field  ros2martidbw.primary_feedback_header_stamp_sec  msg.header.stamp.sec  int
field  ros2martidbw.primary_feedback_header_stamp_nanosec  msg.header.stamp.nanosec  int
field  ros2martidbw.primary_feedback_header_frame_id  msg.header.frame_id  string
field  ros2martidbw.primary_feedback_present  msg.present  bool
field  ros2martidbw.primary_feedback_robotic_mode  msg.robotic_mode  bool
field  ros2martidbw.primary_feedback_steering_command  msg.steering_command  float
field  ros2martidbw.primary_feedback_steering_measure  msg.steering_measure  float
field  ros2martidbw.primary_feedback_throttle_command  msg.throttle_command  float
field  ros2martidbw.primary_feedback_throttle_measure  msg.throttle_measure  float
field  ros2martidbw.primary_feedback_brake_command  msg.brake_command  float
field  ros2martidbw.primary_feedback_brake_measure  msg.brake_measure  float
field  ros2martidbw.primary_feedback_estop_command  msg.estop_command  bool
field  ros2martidbw.primary_feedback_estop_measure  msg.estop_measure  bool
field  ros2martidbw.primary_feedback_error_steering  msg.error_steering  bool
field  ros2martidbw.primary_feedback_error_throttle  msg.error_throttle  bool
field  ros2martidbw.primary_feedback_error_brake  msg.error_brake  bool
field  ros2martidbw.primary_feedback_error_other  msg.error_other  bool

kind      transmission_feedback
when      type  marti_dbw_msgs/msg/TransmissionFeedback
requires  ros2martidbw.transmission_feedback_header_stamp_sec
field  ros2martidbw.transmission_feedback_header_stamp_sec  msg.header.stamp.sec  int
field  ros2martidbw.transmission_feedback_header_stamp_nanosec  msg.header.stamp.nanosec  int
field  ros2martidbw.transmission_feedback_header_frame_id  msg.header.frame_id  string
field  ros2martidbw.transmission_feedback_current_range  msg.current_range  string
field  ros2martidbw.transmission_feedback_stable  msg.stable  bool
field  ros2martidbw.transmission_feedback_reverse  msg.reverse  bool
field  ros2martidbw.transmission_feedback_forward  msg.forward  bool
