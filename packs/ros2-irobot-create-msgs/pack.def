# ROS 2 irobot_create_msgs messages in the JSON form of a rosbridge `publish` operation.
# Generated by tools/gen/ros2msg2pack.py; do not edit by hand.
# One kind per .msg file, selected by the member `type` ("<package>/msg/<Name>").
# The ROS message is the object under `msg`; arrays are groups.
format        ros2-irobot-create-msgs
version       0.1.0
distribution  public
source        "ROS 2 interface package irobot_create_msgs, https://github.com/iRobotEducation/irobot_create_msgs jazzy (BSD 3-Clause License) at commit b4986ef5dc2e07d8aa7471f29c56b617473352c5, directory msg; field names, types and array forms only"
source        "ROS 2 interface package builtin_interfaces (messages irobot_create_msgs refers to), https://github.com/ros2/rcl_interfaces 2.0.4 at commit 7aa3caf43377ea6ad615bc1040832e2c7566bfbe, Apache License 2.0"
