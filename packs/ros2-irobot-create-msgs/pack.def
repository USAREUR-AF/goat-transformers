field  ros2irobotcreate.audio_note_vector_header_frame_id  msg.header.frame_id  string
group  ros2irobotcreate.audio_note_vector_notes  msg.notes
  field  ros2irobotcreate.audio_note_vector_notes_frequency  frequency  int
  field  ros2irobotcreate.audio_note_vector_notes_max_runtime_sec  max_runtime.sec  int
  field  ros2irobotcreate.audio_note_vector_notes_max_runtime_nanosec  max_runtime.nanosec  int
end
