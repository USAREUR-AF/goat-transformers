# CCSDS File Delivery Protocol PDU, the fixed PDU header (727.0-B-5 section 5.1)
# with its three variable-length fields, and the directive code of a file
# directive PDU (5.2.1). Public (CCSDS Blue Book). Decode ignores the rest of the
# data field and the CRC; encode writes the mapped octets only (pack.md).
# Bits are numbered from 0 at the first transmitted bit, most significant bit first.
# Each entity ID takes (bits 25-27) + 1 octets and the transaction's count
# takes (bits 29-31) + 1 octets, from 1 up to 8. Their places follow from
# both lengths: gate blocks (engine-spec 0.17), one per source ID length, and
# within it one per sequence number length. The header is 4 + 2(a+1) + (b+1)
# octets for a = bits 25-27 and b = bits 29-31.
format     ccsds-cfdp-pdu
version    0.1.0
distribution public
source     "CCSDS 727.0-B-5 CCSDS File Delivery Protocol (CFDP), Blue Book, July 2020 (Editorial Change 1), https://ccsds.org/Pubs/727x0b5e1.pdf, sections 5.1 and 5.2.1; reuse with attribution under the CCSDS reproduction permission statement"
uses       ccsdscfdp
wire       bits
word_bytes 1
bit_order  msb
when   0:0:3  1                                       # version: 001 (the second version of the protocol)
field  ccsdscfdp.direction             0:4:1    uint
field  ccsdscfdp.transmission_mode     0:5:1    uint
field  ccsdscfdp.crc_flag              0:6:1    uint
field  ccsdscfdp.large_file_flag       0:7:1    uint
field  ccsdscfdp.data_field_length     0:8:16   uint
field  ccsdscfdp.segmentation_control  0:24:1   uint
field  ccsdscfdp.entity_id_length      0:25:3   uint
field  ccsdscfdp.segment_metadata_flag 0:28:1   uint
field  ccsdscfdp.tsn_length            0:29:3   uint
if  0:25:3  0
  field  ccsdscfdp.source_entity_id     0:32:8  uint
  if  0:29:3  0
    field  ccsdscfdp.transaction_seq_num  0:40:8  uint
    field  ccsdscfdp.dest_entity_id       0:48:8  uint
  end
  if  0:29:3  1
    field  ccsdscfdp.transaction_seq_num  0:40:16  uint
    field  ccsdscfdp.dest_entity_id       0:56:8  uint
  end
