# SBP frames of the package swiftnav.sbp.ndb, one kind per message.
# Generated by tools/gen/sbp2pack.py; do not edit by hand.
# The message is one SBP frame from the preamble through the payload:
# preamble 0x55, message type (u16), sender (u16), length (u8), payload.
# The message carries no CRC: a framer adds and checks it. Payload bit 0 is bit 48.
format        sbp-ndb
version       0.1.0
distribution  public
source        "https://github.com/swift-nav/libsbp spec/yaml/swiftnav/sbp/ndb.yaml at v6.5.2 (commit 925825dea5174f069b5d6e23548f213e09f0235c)"
uses          sbp
uses          sbpndb
wire          bits
bit_order     lsb
word_bytes    1
when   0:0:8 85
field  sbp.sender 0:24:16 uint

kind      ndb_event
when      0:8:16 1024
when      0:40:8 18
requires  sbpndb.ndb_event_recv_time sbpndb.ndb_event_event sbpndb.ndb_event_object_type
field     sbpndb.ndb_event_recv_time 0:48:64 uint
field     sbpndb.ndb_event_event 0:112:8 uint
field     sbpndb.ndb_event_object_type 0:120:8 uint
field     sbpndb.ndb_event_result 0:128:8 uint
field     sbpndb.ndb_event_data_source 0:136:8 uint
field     sbpndb.ndb_event_object_sid_sat 0:144:8 uint
field     sbpndb.ndb_event_object_sid_code 0:152:8 uint
field     sbpndb.ndb_event_src_sid_sat 0:160:8 uint
field     sbpndb.ndb_event_src_sid_code 0:168:8 uint
field     sbpndb.ndb_event_original_sender 0:176:16 uint
