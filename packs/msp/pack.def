# MSP v1 (MultiWii Serial Protocol, as INAV and Betaflight speak it): replies of the flight
# controller, one kind per message. Written by hand from INAV's message definitions;
# pack.md has the layout, the evidence for every shared key and what is not mapped.
# The message is one v1 reply frame without its checksum byte: '$', 'M', '>', payload
# size, command, payload. Little-endian. Size and command are each kind's when.
format        msp
version       0.1.0
distribution  public
source        "INAV MSP message definitions, https://github.com/iNavFlight/inav commit 21adf64440bb0d9f0bdc56569098fbaa0e39d24d, docs/development/msp/msp_messages.json (sha256 07bf2f771aea96c3c362dcd6493bad78607f3f52f4205317fb3d95985c483c77) and docs/development/msp/README.md (sha256 7d868df6a5202d7d1f8f8dd202755045e4993fd8e97322e1bb12e92d4549cee3); GPL-3.0-or-later, the INAV project"
source        "INAV MSP framing, https://github.com/iNavFlight/inav commit 21adf64440bb0d9f0bdc56569098fbaa0e39d24d, src/main/msp/msp_serial.c (sha256 e477c00add0bf86d6f2eed4fd7f9d304b1e621daa54eb2b133a7e70434a6fec8) and msp_serial.h (sha256 250b547dd7ddfce1a0d2242b37f45942344e313a52b531f3094e93799884c031); GPL-3.0-or-later, the INAV project"
uses          msp
wire          bits
bit_order     lsb
word_bytes    1
when      0:0:8 36
when      0:8:8 77
when      0:16:8 62

kind      raw_gps
when      0:24:8 18
when      0:32:8 106
requires  lat lon
field     msp.raw_gps_fix_type 0:40:8 uint
field     msp.raw_gps_num_sat 0:48:8 uint
field     lat 0:56:32 sscale:1/10000000
field     lon 0:88:32 sscale:1/10000000
field     msp.raw_gps_altitude 0:120:16 twos
field     speed_ms 0:136:16 sscale:1/100
field     course 0:152:16 sscale:1/10
field     msp.raw_gps_hdop 0:168:16 uint

kind      attitude
when      0:24:8 6
when      0:32:8 108
requires  msp.attitude_roll
field     msp.attitude_roll 0:40:16 twos
field     msp.attitude_pitch 0:56:16 twos
field     msp.attitude_yaw 0:72:16 twos

kind      altitude
when      0:24:8 10
when      0:32:8 109
requires  msp.altitude_estimated
field     msp.altitude_estimated 0:40:32 twos
field     msp.altitude_variometer 0:72:16 twos
field     msp.altitude_baro 0:88:32 twos

kind      analog
when      0:24:8 7
when      0:32:8 110
requires  msp.analog_vbat
field     msp.analog_vbat 0:40:8 uint
field     msp.analog_mah_drawn 0:48:16 uint
field     msp.analog_rssi 0:64:16 uint
field     msp.analog_amperage 0:80:16 twos
