when      0:8:8 189
when      0:48:8 2
requires  drip.ua_signature drip.wrapped
field     drip.vnb 0:56:32 uint
field     drip.vna 0:88:32 uint
group     drip.wrapped 0:120 item 200 count 4
  field   rid.proto_version 0:0:4 uint
  field   rid.msg_type 0:4:4 uint
  group   drip.message_data 0:8 item 8 count 24
    field drip.octet 0:0:8 uint
  end
end
group     drip.ua_det 0:920 item 8 count 16
  field   drip.octet 0:0:8 uint
end
group     drip.ua_signature 0:1048 item 8 count 64
  field   drip.octet 0:0:8 uint
end

# Wrapper with no message: the form for extended transports, which signs the messages of the
# Message Pack it travels in

kind      wrapper-0
when      0:8:8 89
when      0:48:8 2
requires  drip.ua_signature
field     drip.vnb 0:56:32 uint
field     drip.vna 0:88:32 uint
group     drip.ua_det 0:120 item 8 count 16
  field   drip.octet 0:0:8 uint
end
group     drip.ua_signature 0:248 item 8 count 64
  field   drip.octet 0:0:8 uint
end

# DRIP Manifest (SAM Type 3): three ledger hashes and 0 to 11 message hashes of 8 octets, then the
# aircraft's DET and signature; 113 + 8 n octets

kind      manifest-0
when      0:8:8 113
when      0:48:8 3
requires  drip.ua_signature drip.link_hash
field     drip.vnb 0:56:32 uint
field     drip.vna 0:88:32 uint
group     drip.previous_manifest_hash 0:120 item 8 count 8
  field   drip.octet 0:0:8 uint
end
group     drip.current_manifest_hash 0:184 item 8 count 8
  field   drip.octet 0:0:8 uint
end
group     drip.link_hash 0:248 item 8 count 8
  field   drip.octet 0:0:8 uint
end
group     drip.ua_det 0:312 item 8 count 16
  field   drip.octet 0:0:8 uint
end
group     drip.ua_signature 0:440 item 8 count 64
  field   drip.octet 0:0:8 uint
end

