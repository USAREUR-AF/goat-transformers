# DRIP authentication formats (IETF RFC 9575 section 4) carried in an ASTM F3411
# Authentication Message with Authentication Type 5 (Specific Authentication Method). Public.
#
# A message of this pack is the reassembled Authentication Payload: the 23 payload octets of
# every page, page 0 first, without the message type octet and the page header octet of each
# page. Octets 0-5 are the Authentication Headers: last page index, Length (the number of
# octets of authentication data), timestamp (4 octets, least significant first). Octet 6 on
# is the authentication data, starting with the SAM Type. What follows the authentication
# data (the ADL octet, FEC, null padding) is read over and not written. Integers are least
# significant octet first, as in F3411, so `bit_order lsb`. See pack.md.
format        drip
version       0.1.0
distribution  public
source        "IETF RFC 9575 sections 3.2 and 4 (DRIP Link, Wrapper, Manifest), June 2024, https://www.rfc-editor.org/rfc/rfc9575"
source        "IETF RFC 9434 (DRIP architecture) and RFC 9374 (DRIP Entity Tag), for context"
source        "Location message layout as in pack remote-id: opendroneid-core-c (Apache-2.0), https://github.com/opendroneid/opendroneid-core-c"
uses          rid
uses          drip
wire          bits
word_bytes    1
bit_order     lsb

field     rid.auth_last_page_index 0:0:8 uint
field     rid.auth_timestamp 0:16:32 uint
# DRIP Link (SAM Type 1): a Broadcast Endorsement, 137 octets of authentication data.

kind      link
when      0:8:8 137
when      0:48:8 1
requires  drip.parent_signature
field     drip.vnb 0:56:32 uint
field     drip.vna 0:88:32 uint
group     drip.child_det 0:120 item 8 count 16
  field   drip.octet 0:0:8 uint
end
group     drip.child_hi 0:248 item 8 count 32
  field   drip.octet 0:0:8 uint
end
group     drip.parent_det 0:504 item 8 count 16
  field   drip.octet 0:0:8 uint
end
group     drip.parent_signature 0:632 item 8 count 64
  field   drip.octet 0:0:8 uint
end

# DRIP Wrapper (SAM Type 2): 0 to 4 whole F3411 messages of 25 octets, then the aircraft's DET and
# signature; 89 + 25 n octets. A Location message among them is read as pack remote-id reads it.

# Wrapper of 1 messages, the Location message (type 1) in place 1

kind      wrapper-1-location-1
when      0:8:8 114
when      0:48:8 2
requires  drip.ua_signature lat lon
field     drip.vnb 0:56:32 uint
field     drip.vna 0:88:32 uint
when      0:124:4 1
field     rid.proto_version 0:120:4 uint
field     rid.speed_mult 0:128:1 uint
field     rid.ew_direction 0:129:1 uint
field     rid.height_type 0:130:1 uint
field     rid.status 0:132:4 uint
field     rid.direction_raw 0:136:8 uint
field     rid.speed_h_raw 0:144:8 uint
field     rid.speed_v 0:152:8 sscale:1/2
field     rid.lat_raw 0:160:32 twos
field     rid.lon_raw 0:192:32 twos
if        !0:160:64 0
  field     lat 0:160:32 sscale:1/10000000
  field     lon 0:192:32 sscale:1/10000000
end
field     rid.alt_baro 0:224:16 uscale:1/2:-1000  absent 0
field     hae 0:240:16 uscale:1/2:-1000  absent 0
field     rid.height 0:256:16 uscale:1/2:-1000  absent 0
field     rid.horiz_acc 0:272:4 uint
field     rid.vert_acc 0:276:4 uint
field     rid.speed_acc 0:280:4 uint
field     rid.baro_acc 0:284:4 uint
field     rid.timestamp_ds 0:288:16 uint
field     rid.ts_acc 0:304:4 uint
field     rid.reserved 0:312:8 uint
group     drip.ua_det 0:320 item 8 count 16
  field   drip.octet 0:0:8 uint
end
group     drip.ua_signature 0:448 item 8 count 64
  field   drip.octet 0:0:8 uint
end

# Wrapper of 1 messages, none of them a Location message in a place above

kind      wrapper-1
when      0:8:8 114
when      0:48:8 2
requires  drip.ua_signature drip.wrapped
field     drip.vnb 0:56:32 uint
field     drip.vna 0:88:32 uint
group     drip.wrapped 0:120 item 200 count 1
  field   rid.proto_version 0:0:4 uint
  field   rid.msg_type 0:4:4 uint
  group   drip.message_data 0:8 item 8 count 24
    field drip.octet 0:0:8 uint
  end
end
group     drip.ua_det 0:320 item 8 count 16
  field   drip.octet 0:0:8 uint
end
group     drip.ua_signature 0:448 item 8 count 64
  field   drip.octet 0:0:8 uint
end

