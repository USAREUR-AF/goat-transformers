# Conformance probe pack whose own counted list is read after the inner list of
# the same name (spec 0.34 ruling 22). Public. No kinds.
format     conformance-inner-countafter
version    0.34.0
distribution public
source  "goat-transformers spec/engine-spec.md (synthetic probe format, no external standard)"
uses       probe
wire       bits
layout     sequential
bit_order  msb
length 8
  inner  conformance-inner-restonly
end
group   probe.nums count 8
  field  probe.val  8  uint
end
