# SBP frames of the package swiftnav.sbp.telemetry whose payload length is not fixed,
# one kind per message. Generated by tools/gen/sbp2pack.py; do not edit by hand.
# The frame: preamble 0x55, message type (u16), sender (u16), length (u8),
# payload, without the CRC. The payload is a `length 8 bytes` extent; an array
# or text that runs to its end is a `rest` group (engine-spec 0.8, 0.21).
format        sbp-telemetry-var
version       0.1.0
distribution  public
source        "https://github.com/swift-nav/libsbp spec/yaml/swiftnav/sbp/telemetry.yaml at v6.5.2 (commit 925825dea5174f069b5d6e23548f213e09f0235c)"
uses          sbp
uses          sbptelemetry
wire          bits
layout        sequential
bit_order     lsb
when  8  85

kind  tel_sv
when  16  288
requires  sbptelemetry.tel_sv_wn
field  sbp.sender  16  uint
length  8  bytes
  field  sbptelemetry.tel_sv_wn  16  uint
  field  sbptelemetry.tel_sv_tow  32  uint
  field  sbptelemetry.tel_sv_n_obs  8  uint
  field  sbptelemetry.tel_sv_origin_flags  8  uint
  group  sbptelemetry.tel_sv_sv_tel  rest
    field  sbptelemetry.tel_sv_sv_tel_az  8  uscale:2
    field  sbptelemetry.tel_sv_sv_tel_el  8  twos
    field  sbptelemetry.tel_sv_sv_tel_availability_flags  8  uint
    field  sbptelemetry.tel_sv_sv_tel_pseudorange_residual  16  twos
    field  sbptelemetry.tel_sv_sv_tel_phase_residual  16  sscale:5
    field  sbptelemetry.tel_sv_sv_tel_outlier_flags  8  uint
    field  sbptelemetry.tel_sv_sv_tel_ephemeris_flags  8  uint
    field  sbptelemetry.tel_sv_sv_tel_correction_flags  8  uint
    field  sbptelemetry.tel_sv_sv_tel_sid_sat  8  uint
    field  sbptelemetry.tel_sv_sv_tel_sid_code  8  uint
  end
end
