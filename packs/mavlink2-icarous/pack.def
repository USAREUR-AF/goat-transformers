# MAVLink 2 frames, the messages the dialect icarous.xml defines itself.
# The included files are read only to check that ids and names are unique.
# Generated by tools/gen/mavlink2pack.py; do not edit by hand.
# One byte-aligned frame addressed by bit offset from the STX byte:
# STX(8) LEN(8) INCOMPAT(8) COMPAT(8) SEQ(8) SYSID(8) COMPID(8) MSGID(24) PAYLOAD CRC(16).
# Payload starts at bit 80. CRC, INCOMPAT and COMPAT are not mapped.
format        mavlink2-icarous
version       0.1.0
distribution  public
source        "https://github.com/mavlink/mavlink message_definitions/v1.0/icarous.xml at commit 12c898d88ce18d24e8caf6338596e98c5005bc97"
source        "MAVLink 2 packet format, https://mavlink.io/en/guide/serialization.html"
uses          mavlink
uses          mavlinkicarous
wire          bits
bit_order     lsb
word_bytes    1
when   0:0:8 253
field  mavlink.seq 0:32:8 uint
field  mavlink.sysid 0:40:8 uint
field  mavlink.compid 0:48:8 uint

kind      icarous_heartbeat
when      0:56:24 42000
when      0:8:8 1
requires  mavlinkicarous.status
field     mavlinkicarous.status 0:80:8 uint

kind      icarous_kinematic_bands
when      0:56:24 42001
when      0:8:8 46
requires  mavlinkicarous.min1_deg mavlinkicarous.max1_deg mavlinkicarous.min2_deg mavlinkicarous.max2_deg mavlinkicarous.min3_deg mavlinkicarous.max3_deg
field     mavlinkicarous.min1_deg 0:80:32 f32
field     mavlinkicarous.max1_deg 0:112:32 f32
field     mavlinkicarous.min2_deg 0:144:32 f32
field     mavlinkicarous.max2_deg 0:176:32 f32
field     mavlinkicarous.min3_deg 0:208:32 f32
field     mavlinkicarous.max3_deg 0:240:32 f32
field     mavlinkicarous.min4_deg 0:272:32 f32
field     mavlinkicarous.max4_deg 0:304:32 f32
field     mavlinkicarous.min5_deg 0:336:32 f32
field     mavlinkicarous.max5_deg 0:368:32 f32
field     mavlinkicarous.numbands 0:400:8 twos
field     mavlinkicarous.type1 0:408:8 uint
field     mavlinkicarous.type2 0:416:8 uint
field     mavlinkicarous.type3 0:424:8 uint
field     mavlinkicarous.type4 0:432:8 uint
field     mavlinkicarous.type5 0:440:8 uint
