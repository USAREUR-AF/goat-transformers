# Conformance probe pack for `rest` after `length ... whole` (spec 0.21 ruling
# 14), most significant bit first. Public. No kinds.
#
#   byte 0      the length of the whole message in bytes
#   nums        items to the end of the stated length, val in 8 bits each
format     conformance-extents-whole
version    0.21.0
distribution public
source  "goat-transformers spec/engine-spec.md (synthetic probe format, no external standard)"
uses       probe
wire       bits
layout     sequential
bit_order  msb
length 8 whole
group   probe.nums rest
  field  probe.val  8  uint
end
