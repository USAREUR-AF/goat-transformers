# ROS 2 ouster_msgs messages in the JSON form of a rosbridge `publish` operation.
# Generated by tools/gen/ros2msg2pack.py; do not edit by hand.
# One kind per .msg file, selected by the member `type` ("<package>/msg/<Name>").
# The ROS message is the object under `msg`; arrays are groups.
format        ros2-ouster-msgs
version       0.1.0
distribution  public
source        "ROS 2 interface package ouster_msgs, https://github.com/ros-drivers/ros2_ouster_drivers ros2 (Apache License 2.0) at commit 19c2523025e3e55a2fa803581e4e830e467a9d47, directory ouster_msgs/msg; field names, types and array forms only"
source        "rosbridge v2.1.0 Protocol Specification, ROSBRIDGE_PROTOCOL.md, https://github.com/RobotWebTools/rosbridge_suite jazzy at commit cb33a16b890e4b8d9def531326409f3ee6c12537, BSD 3-Clause License; JSON form of a message and of the publish operation"
uses          ros2ouster
wire          json
when   op  publish
field  ros2ouster.topic  topic  string

kind      metadata
when      type  ouster_msgs/msg/Metadata
requires  ros2ouster.metadata_hostname
field  ros2ouster.metadata_hostname  msg.hostname  string
field  ros2ouster.metadata_lidar_mode  msg.lidar_mode  string
field  ros2ouster.metadata_timestamp_mode  msg.timestamp_mode  string
group  ros2ouster.metadata_beam_azimuth_angles  msg.beam_azimuth_angles
  field  ros2ouster.metadata_beam_azimuth_angles_value  .  float
end
group  ros2ouster.metadata_beam_altitude_angles  msg.beam_altitude_angles
  field  ros2ouster.metadata_beam_altitude_angles_value  .  float
end
group  ros2ouster.metadata_imu_to_sensor_transform  msg.imu_to_sensor_transform
  field  ros2ouster.metadata_imu_to_sensor_transform_value  .  float
end
group  ros2ouster.metadata_lidar_to_sensor_transform  msg.lidar_to_sensor_transform
  field  ros2ouster.metadata_lidar_to_sensor_transform_value  .  float
end
field  ros2ouster.metadata_serial_no  msg.serial_no  string
field  ros2ouster.metadata_firmware_rev  msg.firmware_rev  string
field  ros2ouster.metadata_imu_port  msg.imu_port  int
field  ros2ouster.metadata_lidar_port  msg.lidar_port  int
