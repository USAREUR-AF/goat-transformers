# ROS 2 autoware_common_msgs messages in the JSON form of a rosbridge `publish` operation.
# Generated by tools/gen/ros2msg2pack.py; do not edit by hand.
# One kind per .msg file, selected by the member `type` ("<package>/msg/<Name>").
# The ROS message is the object under `msg`; arrays are groups.
format        ros2-autoware-common-msgs
version       0.1.0
distribution  public
source        "ROS 2 interface package autoware_common_msgs, https://github.com/autowarefoundation/autoware_msgs main (Apache License 2.0) at commit 26b4627ef08c55d8dee1103395594bfb803f7111, directory autoware_common_msgs/msg; field names, types and array forms only"
source        "rosbridge v2.1.0 Protocol Specification, ROSBRIDGE_PROTOCOL.md, https://github.com/RobotWebTools/rosbridge_suite jazzy at commit cb33a16b890e4b8d9def531326409f3ee6c12537, BSD 3-Clause License; JSON form of a message and of the publish operation"
uses          ros2autowarecommon
wire          json
when   op  publish
field  ros2autowarecommon.topic  topic  string

kind      response_status
when      type  autoware_common_msgs/msg/ResponseStatus
requires  ros2autowarecommon.response_status_success
field  ros2autowarecommon.response_status_success  msg.success  bool
field  ros2autowarecommon.response_status_code  msg.code  int
field  ros2autowarecommon.response_status_message  msg.message  string
