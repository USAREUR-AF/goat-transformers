# ROS 2 marti_sensor_msgs messages in the JSON form of a rosbridge `publish` operation.
# Generated by tools/gen/ros2msg2pack.py; do not edit by hand.
# One kind per .msg file, selected by the member `type` ("<package>/msg/<Name>").
# The ROS message is the object under `msg`; arrays are groups.
format        ros2-marti-sensor-msgs
version       0.1.0
distribution  public
source        "ROS 2 interface package marti_sensor_msgs, https://github.com/swri-robotics/marti_messages ros2-devel (BSD License) at commit 2c7215f88d1466b698f77b8020533ac5fc75a3da, directory marti_sensor_msgs/msg; field names, types and array forms only"
source        "ROS 2 interface package builtin_interfaces (messages marti_sensor_msgs refers to), https://github.com/ros2/rcl_interfaces 2.0.4 at commit 7aa3caf43377ea6ad615bc1040832e2c7566bfbe, Apache License 2.0"
source        "ROS 2 interface package geometry_msgs (messages marti_sensor_msgs refers to), https://github.com/ros2/common_interfaces 5.3.8 at commit a941f14bb318d8d904505ed935ccbb97f24a70a4, Apache License 2.0"
source        "ROS 2 interface package std_msgs (messages marti_sensor_msgs refers to), https://github.com/ros2/common_interfaces 5.3.8 at commit a941f14bb318d8d904505ed935ccbb97f24a70a4, Apache License 2.0"
source        "rosbridge v2.1.0 Protocol Specification, ROSBRIDGE_PROTOCOL.md, https://github.com/RobotWebTools/rosbridge_suite jazzy at commit cb33a16b890e4b8d9def531326409f3ee6c12537, BSD 3-Clause License; JSON form of a message and of the publish operation"
uses          ros2martisensor
wire          json
when   op  publish
field  ros2martisensor.topic  topic  string

kind      altitude
when      type  marti_sensor_msgs/msg/Altitude
requires  ros2martisensor.altitude_header_stamp_sec
field  ros2martisensor.altitude_header_stamp_sec  msg.header.stamp.sec  int
field  ros2martisensor.altitude_header_stamp_nanosec  msg.header.stamp.nanosec  int
field  ros2martisensor.altitude_header_frame_id  msg.header.frame_id  string
field  ros2martisensor.altitude_altitude  msg.altitude  float
field  ros2martisensor.altitude_sigma  msg.sigma  float

kind      differential_measurement
when      type  marti_sensor_msgs/msg/DifferentialMeasurement
requires  ros2martisensor.differential_measurement_header_stamp_sec
field  ros2martisensor.differential_measurement_header_stamp_sec  msg.header.stamp.sec  int
field  ros2martisensor.differential_measurement_header_stamp_nanosec  msg.header.stamp.nanosec  int
field  ros2martisensor.differential_measurement_header_frame_id  msg.header.frame_id  string
field  ros2martisensor.differential_measurement_base_frame_id  msg.base_frame_id  string
field  ros2martisensor.differential_measurement_baseline_length  msg.baseline_length  float
field  ros2martisensor.differential_measurement_baseline_length_variance  msg.baseline_length_variance  float
field  ros2martisensor.differential_measurement_heading  msg.heading  float
field  ros2martisensor.differential_measurement_heading_variance  msg.heading_variance  float
field  ros2martisensor.differential_measurement_pitch  msg.pitch  float
field  ros2martisensor.differential_measurement_pitch_variance  msg.pitch_variance  float
field  ros2martisensor.differential_measurement_roll  msg.roll  float
field  ros2martisensor.differential_measurement_roll_variance  msg.roll_variance  float
field  ros2martisensor.differential_measurement_position_x  msg.position.x  float
field  ros2martisensor.differential_measurement_position_y  msg.position.y  float
field  ros2martisensor.differential_measurement_position_z  msg.position.z  float
group  ros2martisensor.differential_measurement_position_covariance  msg.position_covariance
  field  ros2martisensor.differential_measurement_position_covariance_value  .  float
end

kind      dio_port_state
when      type  marti_sensor_msgs/msg/DioPortState
requires  ros2martisensor.dio_port_state_header_stamp_sec
field  ros2martisensor.dio_port_state_header_stamp_sec  msg.header.stamp.sec  int
field  ros2martisensor.dio_port_state_header_stamp_nanosec  msg.header.stamp.nanosec  int
field  ros2martisensor.dio_port_state_header_frame_id  msg.header.frame_id  string
field  ros2martisensor.dio_port_state_value  msg.value  int

kind      dio_real_time_data
when      type  marti_sensor_msgs/msg/DioRealTimeData
requires  ros2martisensor.dio_real_time_data_header_stamp_sec
field  ros2martisensor.dio_real_time_data_header_stamp_sec  msg.header.stamp.sec  int
field  ros2martisensor.dio_real_time_data_header_stamp_nanosec  msg.header.stamp.nanosec  int
field  ros2martisensor.dio_real_time_data_header_frame_id  msg.header.frame_id  string
field  ros2martisensor.dio_real_time_data_sample_frequency  msg.sample_frequency  float
field  ros2martisensor.dio_real_time_data_latest_sample_time  msg.latest_sample_time  int
group  ros2martisensor.dio_real_time_data_sample_states  msg.sample_states
  field  ros2martisensor.dio_real_time_data_sample_states_value  .  int
end
group  ros2martisensor.dio_real_time_data_sample_times  msg.sample_times
  field  ros2martisensor.dio_real_time_data_sample_times_value  .  int
end

kind      direction
when      type  marti_sensor_msgs/msg/Direction
requires  ros2martisensor.direction_header_stamp_sec
field  ros2martisensor.direction_header_stamp_sec  msg.header.stamp.sec  int
field  ros2martisensor.direction_header_stamp_nanosec  msg.header.stamp.nanosec  int
field  ros2martisensor.direction_header_frame_id  msg.header.frame_id  string
field  ros2martisensor.direction_direction  msg.direction  int

kind      exposure
when      type  marti_sensor_msgs/msg/Exposure
requires  ros2martisensor.exposure_header_stamp_sec
field  ros2martisensor.exposure_header_stamp_sec  msg.header.stamp.sec  int
field  ros2martisensor.exposure_header_stamp_nanosec  msg.header.stamp.nanosec  int
field  ros2martisensor.exposure_header_frame_id  msg.header.frame_id  string
field  ros2martisensor.exposure_value  msg.value  int

kind      gyro
when      type  marti_sensor_msgs/msg/Gyro
requires  ros2martisensor.gyro_header_stamp_sec
field  ros2martisensor.gyro_header_stamp_sec  msg.header.stamp.sec  int
field  ros2martisensor.gyro_header_stamp_nanosec  msg.header.stamp.nanosec  int
field  ros2martisensor.gyro_header_frame_id  msg.header.frame_id  string
field  ros2martisensor.gyro_angular_rate  msg.angular_rate  float
field  ros2martisensor.gyro_variance  msg.variance  float

kind      velocity
when      type  marti_sensor_msgs/msg/Velocity
requires  ros2martisensor.velocity_header_stamp_sec
field  ros2martisensor.velocity_header_stamp_sec  msg.header.stamp.sec  int
field  ros2martisensor.velocity_header_stamp_nanosec  msg.header.stamp.nanosec  int
field  ros2martisensor.velocity_header_frame_id  msg.header.frame_id  string
field  ros2martisensor.velocity_velocity  msg.velocity  float
field  ros2martisensor.velocity_variance  msg.variance  float

kind      wheel_encoder
when      type  marti_sensor_msgs/msg/WheelEncoder
requires  ros2martisensor.wheel_encoder_frequency
field  ros2martisensor.wheel_encoder_frequency  msg.frequency  float
field  ros2martisensor.wheel_encoder_directional  msg.directional  bool
field  ros2martisensor.wheel_encoder_id  msg.id  int

kind      wheel_encoder_set
when      type  marti_sensor_msgs/msg/WheelEncoderSet
requires  ros2martisensor.wheel_encoder_set_header_stamp_sec
field  ros2martisensor.wheel_encoder_set_header_stamp_sec  msg.header.stamp.sec  int
field  ros2martisensor.wheel_encoder_set_header_stamp_nanosec  msg.header.stamp.nanosec  int
field  ros2martisensor.wheel_encoder_set_header_frame_id  msg.header.frame_id  string
group  ros2martisensor.wheel_encoder_set_encoders  msg.encoders
  field  ros2martisensor.wheel_encoder_set_encoders_frequency  frequency  float
  field  ros2martisensor.wheel_encoder_set_encoders_directional  directional  bool
  field  ros2martisensor.wheel_encoder_set_encoders_id  id  int
end
