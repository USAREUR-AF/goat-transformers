# ArduPilot log message GUIP as the payload of a DataFlash log record.
# Generated by tools/gen/aplog2pack.py; do not edit by hand.
# The record without its 3-byte header (0xA3 0x95 type-id); fields packed, little-endian.
format        ardupilot-log-copter-guip
version       0.1.0
distribution  public
source        "ArduPilot log message definitions (log structure tables and Write calls), https://github.com/ArduPilot/ardupilot at tag Copter-4.6.2, commit 1ebd4d996e8b6bbeb1462a9655c00aa861d5beef; message names, format strings, labels, units and multipliers only; GNU General Public License, version 3"
source        "ArduPilot libraries/AP_Logger/LogStructure.h: the format characters, units and multipliers of a log message, at the same commit"
uses          aplog
wire          bits
bit_order     lsb
word_bytes    1
field  aplog.copter_guip_timeus  0:0:64  uint
field  aplog.copter_guip_type  0:64:8  uint
field  aplog.copter_guip_px  0:72:32  f32
field  aplog.copter_guip_py  0:104:32  f32
field  aplog.copter_guip_pz  0:136:32  f32
field  aplog.copter_guip_terrain  0:168:8  twos
field  aplog.copter_guip_vx  0:176:32  f32
field  aplog.copter_guip_vy  0:208:32  f32
field  aplog.copter_guip_vz  0:240:32  f32
field  aplog.copter_guip_ax  0:272:32  f32
field  aplog.copter_guip_ay  0:304:32  f32
field  aplog.copter_guip_az  0:336:32  f32
