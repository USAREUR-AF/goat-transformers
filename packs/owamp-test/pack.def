# OWAMP-Test packet, unauthenticated mode (also the TWAMP-Test packet of a Session-Sender). Public. Written by tools/gen/ippm-pack.py; do not edit by hand.
# Wire bits, layout sequential, msb; I/O is hex text. pack.md states what is mapped.
format        owamp-test
version       0.1.0
distribution  public
source        "IETF RFC 4656, A One-way Active Measurement Protocol (OWAMP), September 2006, section 4.1.2, https://www.rfc-editor.org/rfc/rfc4656.txt (sha256 768f1b2b193736c26c0271e2f9ea3e5cd0d05946a6ef5ea29c28378a4d4adbcf); layout restated"
uses          ippm
wire          bits
layout        sequential
bit_order     msb

field  ippm.sequence  32  uint
field  ippm.ts_sec  32  uint
field  ippm.ts_frac  32  uint
field  ippm.err_s  1  uint
field  ippm.err_z  1  uint
field  ippm.err_scale  6  uint
field  ippm.err_multiplier  8  uint
group  ippm.padding  rest
  field  ippm.octet  8  uint
end
