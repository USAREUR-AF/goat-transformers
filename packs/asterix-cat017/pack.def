# ASTERIX Category 017, Mode S Surveillance Coordination Function Messages, edition 1.3: one data block holding one record.
# Public. Generated by tools/gen/asterix2pack.py from the category definition of
# github.com/zoranbosnjak/asterix-specs (BSD-3-Clause); do not edit by hand. I/O is hex text.
# Needs engine version 0.8 (`layout sequential`). See pack.md.
#
#   octet 1       CAT = 17
#   octets 2-3    LEN, the length of the data block in octets, CAT and LEN included
#   FSPEC         octets of 7 presence bits and an extension bit; bit n is FRN n
#   then          the items whose FSPEC bit is 1, in FRN order
#
# An FRN with no `if` block is not mapped: a record with that FSPEC bit set fails
# with `malformed-wire` (ruling 1 of engine-spec 0.8), and encode never sets the bit.
format     asterix-cat017
version    0.1.0
distribution public
source  "ASTERIX Category 017, Mode S Surveillance Coordination Function Messages, edition 1.3 (2009-01-01), as transcribed in github.com/zoranbosnjak/asterix-specs (BSD-3-Clause), commit 64e9ffba964b92a1af3157bc6bdf7852a63bf700, specs/cat017/cats/cat1.3/definition.json. The category is specified by EUROCONTROL"
uses       cat017
wire       bits
layout     sequential
bit_order  msb
kind    record
when    8  17                              # CAT
length  16 whole                         # LEN
presence f fx
if f.1                                   # FRN 1, I017/010 Data Source Identifier
  field  cat017.i010_sac  8  uint
  field  cat017.i010_sic  8  uint
end
if f.2                                   # FRN 2, I017/012 Data Destination Identifier
  field  cat017.i012_sac  8  uint
  field  cat017.i012_sic  8  uint
end
if f.3                                   # FRN 3, I017/000 Message Type
  field  cat017.i000  8  uint
end
if f.4                                   # FRN 4, I017/350 Cluster Station/Node List
  group  cat017.i350  count 8
    field  cat017.i350_sac  8  uint
    field  cat017.i350_sic  8  uint
  end
end
if f.5                                   # FRN 5, I017/220 Aircraft Address
  field  cat017.i220  24  uint
end
if f.6                                   # FRN 6, I017/221 Duplicate Address Reference Number (DRN)
  field  cat017.i221  16  uint
end
if f.7                                   # FRN 7, I017/140 Time of Day
  field  cat017.i140  24  uscale:1/128
end
if f.8                                   # FRN 8, I017/045 Calculated Position in WGS-84 Coordinates
  field  lat  24  sscale:45/8388608
  also   cat017.i045_lat
  field  lon  24  sscale:45/8388608
  also   cat017.i045_lon
end
if f.9                                   # FRN 9, I017/070 Mode 3/A Code in Octal Representation
  field  cat017.i070_v  1  uint
  field  cat017.i070_g  1  uint
  field  cat017.i070_l  1  uint
  pad    1
  field  cat017.i070_mode3a  12  uint
end
if f.10                                  # FRN 10, I017/050 Flight Level in Binary Representation
  field  cat017.i050_v  1  uint
  field  cat017.i050_g  1  uint
  field  cat017.i050_alt  14  uscale:1/4
end
if f.11                                  # FRN 11, I017/200 Track Velocity in Polar Co-ordinates
  field  speed_ms  16  uscale:463/4096
  field  cat017.i200_hdg  16  uscale:45/8192
end
if f.12                                  # FRN 12, I017/230 Transponder Capability
  field  cat017.i230_ca  3  uint
  field  cat017.i230_si  1  uint
  pad    4
end
if f.13                                  # FRN 13, I017/240 Track Status
  field  cat017.i240_cst  1  uint
  field  cat017.i240_flt  1  uint
  pad    6
end
if f.14                                  # FRN 14, I017/210 Mode S Address List
  group  cat017.i210  count 8
    field  cat017.i210_val  24  uint
  end
end
if f.15                                  # FRN 15, I017/360 Cluster Controller Command State
  field  cat017.i360  8  uint
end
# FRN 16: spare FRN
# FRN 17: spare FRN
# FRN 18: spare FRN
# FRN 19: spare FRN
# FRN 20: spare FRN
if f.21                                  # FRN 21, I017/SP Special Purpose Field
  length 8 bytes plus 1                # the length octet counts itself; the content is not mapped
  end
end
