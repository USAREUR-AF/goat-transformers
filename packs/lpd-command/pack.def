# LPD daemon command (RFC 1179 section 5): a binary command code, the queue name and any operands, LF. Written by
# tools/gen/printing-pack.py; do not edit by hand.
format        lpd-command
version       0.1.0
distribution  public
source        "IETF RFC 1179, Line Printer Daemon Protocol, August 1990, sections 3.1 and 5-7, https://www.rfc-editor.org/rfc/rfc1179.txt; layout restated"
uses          lpd
wire          bits
layout        sequential
bit_order     msb

kind  print-waiting-jobs
when  8  1  as  lpd.command_code
requires  lpd.queue
field  lpd.queue  until:10  chars:ascii8

kind  receive-job
when  8  2  as  lpd.command_code
requires  lpd.queue
field  lpd.queue  until:10  chars:ascii8

kind  send-queue-state-short
when  8  3  as  lpd.command_code
requires  lpd.operands
field  lpd.operands  until:10  chars:ascii8

kind  send-queue-state-long
when  8  4  as  lpd.command_code
requires  lpd.operands
field  lpd.operands  until:10  chars:ascii8

kind  remove-jobs
when  8  5  as  lpd.command_code
requires  lpd.operands
field  lpd.operands  until:10  chars:ascii8
