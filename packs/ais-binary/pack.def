# AIS binary application messages: payloads of message types 6 (addressed)
# and 8 (broadcast) whose application layout, chosen by the designated area
# code (DAC) and function identifier (FI), has a fixed length. Public. Written
# from the gpsd document "AIVDM/AIVDO protocol decoding" v1.58; pack.md states
# what is mapped, the layouts that are not built and why.
#
# Same conventions as pack `ais`: the input is one whole payload, the armored
# text of an AIVDM or AIVDO sentence with its fragments joined; word_bytes 1 and
# bit_order msb, so 0:<bit>:<len> counts from the first bit of the payload, the
# numbering the source uses. Each kind is selected by the type, the DAC and the
# FI together (and by bit 56 for the two variants of DAC 1 FI 21).
format        ais-binary
version       0.1.0
distribution  public
source        "gpsd, AIVDM/AIVDO protocol decoding, v1.58 (24 June 2023), www/AIVDM.adoc at https://gitlab.com/gpsd/gpsd commit c59fc6de479d06620c8b2ba395b728e10a71527b, BSD-2-Clause (gpsd COPYING); binary application messages of types 6 and 8"
uses          ais
uses          aisbin
wire          bits
word_bytes    1
bit_order     msb
armor         sixbit

field  ais.msg_type        0:0:6      uint
field  ais.repeat          0:6:2      uint
field  ais.mmsi            0:8:30     uint

# Type 6, DAC 1, FI 12: 360 bits.
kind      dangerous-cargo-imo236
when      0:0:6  6
when      0:72:10  1
when      0:82:6  12
requires  ais.mmsi aisbin.dc236_lastport
field  aisbin.seqno             0:38:2     uint
field  ais.dest_mmsi            0:40:30    uint
field  aisbin.retransmit        0:70:1     uint
field  ais.spare                0:71:1     uint
field  aisbin.dac               0:72:10    uint
field  aisbin.fid               0:82:6     uint
field  aisbin.dc236_lastport    0:88:30    sixbit
field  aisbin.dc236_lmonth      0:118:4    uint
field  aisbin.dc236_lday        0:122:5    uint
field  aisbin.dc236_lhour       0:127:5    uint
field  aisbin.dc236_lminute     0:132:6    uint
field  aisbin.dc236_nextport    0:138:30   sixbit
field  aisbin.dc236_nmonth      0:168:4    uint
field  aisbin.dc236_nday        0:172:5    uint
field  aisbin.dc236_nhour       0:177:5    uint
field  aisbin.dc236_nminute     0:182:6    uint
field  aisbin.dc236_dangerous   0:188:120  sixbit
field  aisbin.dc236_imdcat      0:308:24   sixbit
field  aisbin.dc236_unid        0:332:13   uint
field  aisbin.dc236_amount      0:345:10   uint
field  aisbin.dc236_unit        0:355:2    uint
field  ais.spare2               0:357:3    uint

