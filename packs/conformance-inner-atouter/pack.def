# Conformance probe pack whose inner pack looks ahead (spec 0.34 ruling 12).
# Public. No kinds.
#
#   byte 0      n
#   block       an 8-bit length in bytes, then one conformance-inner-at message
#   byte        w, after the block: never read by the inner look-ahead
format     conformance-inner-atouter
version    0.34.0
distribution public
source  "goat-transformers spec/engine-spec.md (synthetic probe format, no external standard)"
uses       probe
wire       bits
layout     sequential
bit_order  msb
field   probe.n  8  uint
length 8
  inner  conformance-inner-at
end
field   probe.w  8  uint
