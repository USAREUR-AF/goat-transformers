# Conformance probe pack for `group <list> rest` at message level (spec 0.21),
# most significant bit first. Public. No kinds.
#
#   byte 0      z
#   recs        items to the end of the message, no count and no indicator:
#               x in 8 bits, y in 8 bits
format     conformance-extents-rest
version    0.21.0
distribution public
source  "goat-transformers spec/engine-spec.md (synthetic probe format, no external standard)"
uses       probe
wire       bits
layout     sequential
bit_order  msb
field   probe.z  8  uint
group   probe.recs rest
  field  probe.x  8  uint
  field  probe.y  8  uint
end
