# SBP frames of the package swiftnav.sbp.bootload whose payload length is not fixed,
# one kind per message. Generated by tools/gen/sbp2pack.py; do not edit by hand.
# The frame: preamble 0x55, message type (u16), sender (u16), length (u8),
# payload, without the CRC. The payload is a `length 8 bytes` extent; an array
# or text that runs to its end is a `rest` group (engine-spec 0.8, 0.21).
format        sbp-bootload-var
version       0.1.0
distribution  public
source        "https://github.com/swift-nav/libsbp spec/yaml/swiftnav/sbp/bootload.yaml at v6.5.2 (commit 925825dea5174f069b5d6e23548f213e09f0235c)"
uses          sbp
uses          sbpbootload
wire          bits
layout        sequential
bit_order     lsb
when  8  85

kind  bootloader_handshake_resp
when  16  180
requires  sbpbootload.bootloader_handshake_resp_flags
field  sbp.sender  16  uint
length  8  bytes
  field  sbpbootload.bootloader_handshake_resp_flags  32  uint
  group  sbpbootload.bootloader_handshake_resp_version  rest
    field  sbpbootload.bootloader_handshake_resp_version_byte  8  uint
  end
end

kind  bootloader_handshake_dep_a
when  16  176
requires  sbpbootload.bootloader_handshake_dep_a_handshake
field  sbp.sender  16  uint
length  8  bytes
  group  sbpbootload.bootloader_handshake_dep_a_handshake  rest
    field  sbpbootload.bootloader_handshake_dep_a_handshake_item  8  uint
  end
end
