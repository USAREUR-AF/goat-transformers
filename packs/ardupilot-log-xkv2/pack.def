# ArduPilot log message XKV2 as the payload of a DataFlash log record.
# Generated by tools/gen/aplog2pack.py; do not edit by hand.
# The record without its 3-byte header (0xA3 0x95 type-id); fields packed, little-endian.
format        ardupilot-log-xkv2
version       0.1.0
distribution  public
source        "ArduPilot log message definitions (log structure tables and Write calls), https://github.com/ArduPilot/ardupilot at tag Copter-4.6.2, commit 1ebd4d996e8b6bbeb1462a9655c00aa861d5beef; message names, format strings, labels, units and multipliers only; GNU General Public License, version 3"
source        "ArduPilot libraries/AP_Logger/LogStructure.h: the format characters, units and multipliers of a log message, at the same commit"
uses          aplog
wire          bits
bit_order     lsb
word_bytes    1
field  aplog.xkv2_timeus  0:0:64  uint
field  aplog.xkv2_c  0:64:8  uint
field  aplog.xkv2_v12  0:72:32  f32
field  aplog.xkv2_v13  0:104:32  f32
field  aplog.xkv2_v14  0:136:32  f32
field  aplog.xkv2_v15  0:168:32  f32
field  aplog.xkv2_v16  0:200:32  f32
field  aplog.xkv2_v17  0:232:32  f32
field  aplog.xkv2_v18  0:264:32  f32
field  aplog.xkv2_v19  0:296:32  f32
field  aplog.xkv2_v20  0:328:32  f32
field  aplog.xkv2_v21  0:360:32  f32
field  aplog.xkv2_v22  0:392:32  f32
field  aplog.xkv2_v23  0:424:32  f32
