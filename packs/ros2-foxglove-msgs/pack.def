field  ros2foxglove.arrow_primitive_pose_orientation_z  msg.pose.orientation.z  float
field  ros2foxglove.arrow_primitive_pose_orientation_w  msg.pose.orientation.w  float
field  ros2foxglove.arrow_primitive_shaft_length  msg.shaft_length  float
field  ros2foxglove.arrow_primitive_shaft_diameter  msg.shaft_diameter  float
field  ros2foxglove.arrow_primitive_head_length  msg.head_length  float
field  ros2foxglove.arrow_primitive_head_diameter  msg.head_diameter  float
field  ros2foxglove.arrow_primitive_color_r  msg.color.r  float
field  ros2foxglove.arrow_primitive_color_g  msg.color.g  float
field  ros2foxglove.arrow_primitive_color_b  msg.color.b  float
field  ros2foxglove.arrow_primitive_color_a  msg.color.a  float

