# ROS 2 foxglove_msgs messages in the JSON form of a rosbridge `publish` operation.
# Generated by tools/gen/ros2msg2pack.py; do not edit by hand.
# One kind per .msg file, selected by the member `type` ("<package>/msg/<Name>").
# The ROS message is the object under `msg`; arrays are groups.
format        ros2-foxglove-msgs
version       0.1.0
distribution  public
source        "ROS 2 interface package foxglove_msgs, https://github.com/foxglove/schemas main (MIT License) at commit 8cebcc575cea4a2dfb3622948936a8a2f2552820, directory ros/src/foxglove_msgs/ros2; field names, types and array forms only"
source        "ROS 2 interface package builtin_interfaces (messages foxglove_msgs refers to), https://github.com/ros2/rcl_interfaces 2.0.4 at commit 7aa3caf43377ea6ad615bc1040832e2c7566bfbe, Apache License 2.0"
source        "ROS 2 interface package geometry_msgs (messages foxglove_msgs refers to), https://github.com/ros2/common_interfaces 5.3.8 at commit a941f14bb318d8d904505ed935ccbb97f24a70a4, Apache License 2.0"
source        "rosbridge v2.1.0 Protocol Specification, ROSBRIDGE_PROTOCOL.md, https://github.com/RobotWebTools/rosbridge_suite jazzy at commit cb33a16b890e4b8d9def531326409f3ee6c12537, BSD 3-Clause License; JSON form of a message and of the publish operation"
uses          ros2foxglove
wire          json
when   op  publish
field  ros2foxglove.topic  topic  string

kind      arrow_primitive
when      type  foxglove_msgs/msg/ArrowPrimitive
requires  ros2foxglove.arrow_primitive_pose_position_x
