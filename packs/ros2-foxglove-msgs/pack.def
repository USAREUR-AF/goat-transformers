group  ros2foxglove.camera_calibration_d  msg.d
  field  ros2foxglove.camera_calibration_d_value  .  float
end
group  ros2foxglove.camera_calibration_k  msg.k
  field  ros2foxglove.camera_calibration_k_value  .  float
