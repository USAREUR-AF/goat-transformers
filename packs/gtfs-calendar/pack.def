# GTFS Schedule calendar.txt: one data row of the file. Public. Maintained by hand.
# The columns are in the order the reference lists them (pack.md, Column order);
# the header row is not a message of this pack.
format        gtfs-calendar
version       0.1.0
distribution  public
source        "GTFS Schedule Reference, gtfs/spec/en/reference.md of https://github.com/google/transit (Apache-2.0) at commit 2ce6aa79e3fa7bdbaf19d2a12765cee5b9fdd699; the column order of each file as the reference lists it; field names and types"
uses          gtfs
wire          text

field  gtfs.service_id                  0   string
field  gtfs.monday                      1   int
field  gtfs.tuesday                     2   int
field  gtfs.wednesday                   3   int
field  gtfs.thursday                    4   int
field  gtfs.friday                      5   int
field  gtfs.saturday                    6   int
field  gtfs.sunday                      7   int
field  gtfs.start_date                  8   string
field  gtfs.end_date                    9   string
