  field  ros2std.float32_multi_array_layout_dim_label  label  string
  field  ros2std.float32_multi_array_layout_dim_size  size  int
  field  ros2std.float32_multi_array_layout_dim_stride  stride  int
end
field  ros2std.float32_multi_array_layout_data_offset  msg.layout.data_offset  int
group  ros2std.float32_multi_array_data  msg.data
  field  ros2std.float32_multi_array_data_value  .  float
end

