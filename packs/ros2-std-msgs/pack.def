# ROS 2 std_msgs messages in the JSON form of a rosbridge `publish` operation.
# Generated by tools/gen/ros2msg2pack.py; do not edit by hand.
# One kind per .msg file, selected by the member `type` ("<package>/msg/<Name>").
# The ROS message is the object under `msg`; arrays are groups.
format        ros2-std-msgs
version       0.1.0
distribution  public
source        "ROS 2 interface package std_msgs, https://github.com/ros2/common_interfaces 5.3.8 (Apache License 2.0) at commit a941f14bb318d8d904505ed935ccbb97f24a70a4, directory std_msgs/msg; field names, types and array forms only"
source        "ROS 2 interface package builtin_interfaces (messages std_msgs refers to), https://github.com/ros2/rcl_interfaces 2.0.4 at commit 7aa3caf43377ea6ad615bc1040832e2c7566bfbe, Apache License 2.0"
source        "rosbridge v2.1.0 Protocol Specification, ROSBRIDGE_PROTOCOL.md, https://github.com/RobotWebTools/rosbridge_suite jazzy at commit cb33a16b890e4b8d9def531326409f3ee6c12537, BSD 3-Clause License; JSON form of a message and of the publish operation"
uses          ros2std
wire          json
when   op  publish
field  ros2std.topic  topic  string

kind      bool
when      type  std_msgs/msg/Bool
requires  ros2std.bool_data
field  ros2std.bool_data  msg.data  bool

kind      byte
when      type  std_msgs/msg/Byte
requires  ros2std.byte_data
field  ros2std.byte_data  msg.data  int

kind      byte_multi_array
when      type  std_msgs/msg/ByteMultiArray
requires  ros2std.byte_multi_array_layout_dim
group  ros2std.byte_multi_array_layout_dim  msg.layout.dim
  field  ros2std.byte_multi_array_layout_dim_label  label  string
  field  ros2std.byte_multi_array_layout_dim_size  size  int
  field  ros2std.byte_multi_array_layout_dim_stride  stride  int
end
field  ros2std.byte_multi_array_layout_data_offset  msg.layout.data_offset  int

kind      char
when      type  std_msgs/msg/Char
requires  ros2std.char_data
field  ros2std.char_data  msg.data  int

kind      color_rgba
when      type  std_msgs/msg/ColorRGBA
requires  ros2std.color_rgba_r
field  ros2std.color_rgba_r  msg.r  float
field  ros2std.color_rgba_g  msg.g  float
field  ros2std.color_rgba_b  msg.b  float
field  ros2std.color_rgba_a  msg.a  float

