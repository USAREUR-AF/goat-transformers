kind     basic
when     0:0:5  0
requires lat lon
# State vector, bytes 5-17 (bits 32-135)
if  !0:32:47  0                                # a position is present when latitude or longitude is not zero
  field    lat                                0:32:23  sscale:180/8388608
  field    lon                                0:55:24  sscale:180/8388608
end
field    uat.altitude_type                  0:79:1  uint
if  0:79:1  0
  field    uat.pressure_altitude_ft           0:80:12  siscale:25:-1025  absent 0
end
if  0:79:1  1
  field    uat.geometric_altitude_ft          0:80:12  siscale:25:-1025  absent 0
end
field    uat.nic                            0:92:4  uint
field    uat.air_ground_state               0:96:2  uint
field    uat.sv_reserved_98                 0:98:1  uint
if  0:96:2  0,1                               # airborne
  field    uat.north_south_sign               0:99:1  uint
  field    uat.north_south_velocity_raw       0:100:10  uint
  field    uat.east_west_sign                 0:110:1  uint
  field    uat.east_west_velocity_raw         0:111:10  uint
  field    uat.vertical_velocity_source       0:121:1  uint
  field    uat.vertical_velocity_sign         0:122:1  uint
  field    uat.vertical_velocity_raw          0:123:9  uint
end
if  0:96:2  2                                  # on the ground
  field    uat.ground_reserved_99             0:99:1  uint
  field    uat.ground_speed_raw               0:100:10  uint
  field    uat.track_heading_type             0:110:2  uint
  field    uat.track_heading_raw              0:112:9  uint
  field    uat.aircraft_size                  0:121:4  uint
  field    uat.ground_reserved_125            0:125:1  uint
  field    uat.gps_offset_longitudinal        0:126:1  uint
  field    uat.gps_offset_raw                 0:127:5  uint
  if  0:110:2  1                               # a true track
    field    course                             0:112:9  uscale:45/64
  end
end
if  0:96:2  3
  field    uat.air_ground_reserved_bits       0:99:33  uint
end
if  0:5:3  0,1,4,5                             # ADS-B, surface vehicle, fixed beacon
  field    uat.utc_coupled                    0:132:1  uint
  field    uat.uplink_feedback                0:133:3  uint
end
if  0:5:3  2,3,6                               # TIS-B and ADS-R
  field    uat.tisb_site_id                   0:132:4  uint
end
if  0:5:3  7
  field    uat.sv_aq_reserved                 0:132:4  uint
end
field    uat.reserved_bits_136_143          0:136:8  uint

kind     header-only
when     0:0:5  11..31
requires uat.reserved_bits_32_91
field    uat.reserved_bits_32_91            0:32:60  uint
field    uat.reserved_bits_92_151           0:92:60  uint
field    uat.reserved_bits_152_211          0:152:60  uint
field    uat.reserved_bits_212_271          0:212:60  uint
