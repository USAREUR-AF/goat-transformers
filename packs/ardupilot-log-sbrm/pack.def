# ArduPilot log message SBRM as the payload of a DataFlash log record.
# Generated by tools/gen/aplog2pack.py; do not edit by hand.
# The record without its 3-byte header (0xA3 0x95 type-id); fields packed, little-endian.
format        ardupilot-log-sbrm
version       0.1.0
distribution  public
source        "ArduPilot log message definitions (log structure tables and Write calls), https://github.com/ArduPilot/ardupilot at tag Copter-4.6.2, commit 1ebd4d996e8b6bbeb1462a9655c00aa861d5beef; message names, format strings, labels, units and multipliers only; GNU General Public License, version 3"
source        "ArduPilot libraries/AP_Logger/LogStructure.h: the format characters, units and multipliers of a log message, at the same commit"
uses          aplog
wire          bits
bit_order     lsb
word_bytes    1
field  aplog.sbrm_timeus  0:0:64  uint
field  aplog.sbrm_msg_flag  0:64:64  uint
field  aplog.sbrm_1  0:128:64  uint
field  aplog.sbrm_2  0:192:64  uint
field  aplog.sbrm_3  0:256:64  uint
field  aplog.sbrm_4  0:320:64  uint
field  aplog.sbrm_5  0:384:64  uint
field  aplog.sbrm_6  0:448:64  uint
field  aplog.sbrm_7  0:512:64  uint
field  aplog.sbrm_8  0:576:64  uint
field  aplog.sbrm_9  0:640:64  uint
field  aplog.sbrm_10  0:704:64  uint
field  aplog.sbrm_11  0:768:64  uint
field  aplog.sbrm_12  0:832:64  uint
field  aplog.sbrm_13  0:896:64  uint
