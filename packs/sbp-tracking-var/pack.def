# SBP frames of the package swiftnav.sbp.tracking whose payload length is not fixed,
# one kind per message. Generated by tools/gen/sbp2pack.py; do not edit by hand.
# The frame: preamble 0x55, message type (u16), sender (u16), length (u8),
# payload, without the CRC. The payload is a `length 8 bytes` extent; an array
# or text that runs to its end is a `rest` group (engine-spec 0.8, 0.21).
format        sbp-tracking-var
version       0.1.0
distribution  public
source        "https://github.com/swift-nav/libsbp spec/yaml/swiftnav/sbp/tracking.yaml at v6.5.2 (commit 925825dea5174f069b5d6e23548f213e09f0235c)"
uses          sbp
uses          sbptracking
wire          bits
layout        sequential
bit_order     lsb
when  8  85

kind  tracking_state
when  16  65
requires  sbptracking.tracking_state_states
field  sbp.sender  16  uint
length  8  bytes
  group  sbptracking.tracking_state_states  rest
    field  sbptracking.tracking_state_states_sid_sat  8  uint
    field  sbptracking.tracking_state_states_sid_code  8  uint
    field  sbptracking.tracking_state_states_fcn  8  uint
    field  sbptracking.tracking_state_states_cn0  8  uscale:1/4
  end
end

kind  measurement_state
when  16  97
requires  sbptracking.measurement_state_states
field  sbp.sender  16  uint
length  8  bytes
  group  sbptracking.measurement_state_states  rest
    field  sbptracking.measurement_state_states_mesid_sat  8  uint
    field  sbptracking.measurement_state_states_mesid_code  8  uint
    field  sbptracking.measurement_state_states_cn0  8  uscale:1/4
  end
end

kind  tracking_state_dep_a
when  16  22
requires  sbptracking.tracking_state_dep_a_states
field  sbp.sender  16  uint
length  8  bytes
  group  sbptracking.tracking_state_dep_a_states  rest
    field  sbptracking.tracking_state_dep_a_states_state  8  uint
    field  sbptracking.tracking_state_dep_a_states_prn  8  uint
    field  sbptracking.tracking_state_dep_a_states_cn0  32  f32
  end
end

kind  tracking_state_dep_b
when  16  19
requires  sbptracking.tracking_state_dep_b_states
field  sbp.sender  16  uint
length  8  bytes
  group  sbptracking.tracking_state_dep_b_states  rest
    field  sbptracking.tracking_state_dep_b_states_state  8  uint
    field  sbptracking.tracking_state_dep_b_states_sid_sat  16  uint
    field  sbptracking.tracking_state_dep_b_states_sid_code  8  uint
    field  sbptracking.tracking_state_dep_b_states_sid_reserved  8  uint
    field  sbptracking.tracking_state_dep_b_states_cn0  32  f32
  end
end
