# ROS 2 shape_msgs messages in the JSON form of a rosbridge `publish` operation.
# Generated by tools/gen/ros2msg2pack.py; do not edit by hand.
# One kind per .msg file, selected by the member `type` ("<package>/msg/<Name>").
# The ROS message is the object under `msg`; arrays are groups.
format        ros2-shape-msgs
version       0.1.0
distribution  public
source        "ROS 2 interface package shape_msgs, https://github.com/ros2/common_interfaces 5.3.8 (Apache License 2.0) at commit a941f14bb318d8d904505ed935ccbb97f24a70a4, directory shape_msgs/msg; field names, types and array forms only"
source        "ROS 2 interface package geometry_msgs (messages shape_msgs refers to), https://github.com/ros2/common_interfaces 5.3.8 at commit a941f14bb318d8d904505ed935ccbb97f24a70a4, Apache License 2.0"
source        "rosbridge v2.1.0 Protocol Specification, ROSBRIDGE_PROTOCOL.md, https://github.com/RobotWebTools/rosbridge_suite jazzy at commit cb33a16b890e4b8d9def531326409f3ee6c12537, BSD 3-Clause License; JSON form of a message and of the publish operation"
uses          ros2shape
wire          json
when   op  publish
field  ros2shape.topic  topic  string

kind      mesh
when      type  shape_msgs/msg/Mesh
requires  ros2shape.mesh_triangles
group  ros2shape.mesh_triangles  msg.triangles
  group  ros2shape.mesh_triangles_vertex_indices  vertex_indices
    field  ros2shape.mesh_triangles_vertex_indices_value  .  int
  end
end
group  ros2shape.mesh_vertices  msg.vertices
  field  ros2shape.mesh_vertices_x  x  float
  field  ros2shape.mesh_vertices_y  y  float
  field  ros2shape.mesh_vertices_z  z  float
end

kind      mesh_triangle
when      type  shape_msgs/msg/MeshTriangle
requires  ros2shape.mesh_triangle_vertex_indices
group  ros2shape.mesh_triangle_vertex_indices  msg.vertex_indices
  field  ros2shape.mesh_triangle_vertex_indices_value  .  int
end

kind      plane
when      type  shape_msgs/msg/Plane
requires  ros2shape.plane_coef
group  ros2shape.plane_coef  msg.coef
  field  ros2shape.plane_coef_value  .  float
end

kind      solid_primitive
when      type  shape_msgs/msg/SolidPrimitive
requires  ros2shape.solid_primitive_type
field  ros2shape.solid_primitive_type  msg.type  int
group  ros2shape.solid_primitive_dimensions  msg.dimensions
  field  ros2shape.solid_primitive_dimensions_value  .  float
end
group  ros2shape.solid_primitive_polygon_points  msg.polygon.points
  field  ros2shape.solid_primitive_polygon_points_x  x  float
  field  ros2shape.solid_primitive_polygon_points_y  y  float
  field  ros2shape.solid_primitive_polygon_points_z  z  float
end
