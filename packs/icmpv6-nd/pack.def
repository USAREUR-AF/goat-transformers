# ICMPv6 Neighbor Discovery messages (RFC 4861): Router Solicitation and Advertisement, Neighbor
# Solicitation and Advertisement, Redirect, with their options. Type, code, checksum and the RS and RA
# fields are the inet keys of icmpv6-header. Written by tools/gen/inet-more-pack.py; do not edit by hand.
format        icmpv6-nd
version       0.1.0
distribution  public
source        "IETF RFC 4861, Neighbor Discovery for IP version 6, sections 4.1 to 4.6; RFC 8106 section 5 (RDNSS, DNSSL); https://www.rfc-editor.org/; layouts restated"
uses          inet
uses          icmpnd
wire          bits
layout        sequential
bit_order     msb

field  inet.icmpv6_type  8  uint
field  inet.icmpv6_code  8  uint
field  inet.icmpv6_checksum  16  uint
switch  inet.icmpv6_type
  case  133
    field  inet.icmpv6_reserved  32  uint
  case  134
    field  inet.icmpv6_ra_cur_hop_limit  8  uint
    field  inet.icmpv6_ra_managed  1  uint
    field  inet.icmpv6_ra_other  1  uint
    field  inet.icmpv6_ra_reserved  6  uint
    field  inet.icmpv6_ra_router_lifetime  16  uint
    field  inet.icmpv6_ra_reachable_time  32  uint
    field  inet.icmpv6_ra_retrans_timer  32  uint
  case  135
    field  icmpnd.ns_reserved  32  uint
    field  icmpnd.target  128  hex
  case  136
    field  icmpnd.router  1  uint
    field  icmpnd.solicited  1  uint
    field  icmpnd.override  1  uint
    field  icmpnd.na_reserved  29  uint
    field  icmpnd.target  128  hex
  case  137
    field  icmpnd.redirect_reserved  32  uint
    field  icmpnd.target  128  hex
    field  icmpnd.destination  128  hex
end
group  icmpnd.options  rest
  field  icmpnd.option_type  8  uint
  field  icmpnd.option_length  8  uint
