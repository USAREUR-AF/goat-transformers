    case  1,2
      switch  icmpnd.option_length
        case  1
          field  icmpnd.link_layer_address  48  hex
        case  2
          field  icmpnd.link_layer_address  112  hex
        case  3
          field  icmpnd.link_layer_address  176  hex
        case  4
          field  icmpnd.link_layer_address  240  hex
      end
    case  3
      switch  icmpnd.option_length
        case  4
          field  icmpnd.prefix_length  8  uint
          field  icmpnd.on_link  1  uint
          field  icmpnd.autonomous  1  uint
          field  icmpnd.router_address  1  uint
          field  icmpnd.prefix_reserved1  5  uint
          field  icmpnd.valid_lifetime  32  uint
          field  icmpnd.preferred_lifetime  32  uint
          field  icmpnd.prefix_reserved2  32  uint
          field  icmpnd.prefix  128  hex
      end
    case  4
      field  icmpnd.redirected_reserved  48  uint
      switch  icmpnd.option_length
