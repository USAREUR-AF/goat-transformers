# ASTERIX Category 009, Composite Weather Reports, edition 2.1: one data block holding one record.
# Public. Generated by tools/gen/asterix2pack.py from the category definition of
# github.com/zoranbosnjak/asterix-specs (BSD-3-Clause); do not edit by hand. I/O is hex text.
# Needs engine version 0.8 (`layout sequential`). See pack.md.
#
#   octet 1       CAT = 9
#   octets 2-3    LEN, the length of the data block in octets, CAT and LEN included
#   FSPEC         octets of 7 presence bits and an extension bit; bit n is FRN n
#   then          the items whose FSPEC bit is 1, in FRN order
#
# An FRN with no `if` block is not mapped: a record with that FSPEC bit set fails
# with `malformed-wire` (ruling 1 of engine-spec 0.8), and encode never sets the bit.
format     asterix-cat009
version    0.1.0
distribution public
source  "ASTERIX Category 009, Composite Weather Reports, edition 2.1 (2014-10-22), as transcribed in github.com/zoranbosnjak/asterix-specs (BSD-3-Clause), commit 64e9ffba964b92a1af3157bc6bdf7852a63bf700, specs/cat009/cats/cat2.1/definition.json. The category is specified by EUROCONTROL"
uses       cat009
wire       bits
layout     sequential
bit_order  msb
kind    record
when    8  9                              # CAT
length  16 whole                         # LEN
presence f fx
if f.1                                   # FRN 1, I009/010 Data Source Identifier
  field  cat009.i010_sac  8  uint
  field  cat009.i010_sic  8  uint
end
if f.2                                   # FRN 2, I009/000 Message Type
  field  cat009.i000  8  uint
end
if f.3                                   # FRN 3, I009/020 Vector Qualifier
  chain
    field  cat009.i020_org  1  uint
    field  cat009.i020_i  3  uint
    field  cat009.i020_s  3  uint
    fx
  end
end
if f.4                                   # FRN 4, I009/030 Sequence of Cartesian Vectors
  group  cat009.i030  count 8
    field  cat009.i030_x  16  twos
    field  cat009.i030_y  16  twos
    field  cat009.i030_l  16  uint
  end
end
if f.5                                   # FRN 5, I009/060 Synchronisation/Control Signal
  chain
    field  cat009.i060_sn  6  uint
    pad    1
    fx
  end
end
if f.6                                   # FRN 6, I009/070 Time of Day
  field  cat009.i070  24  uscale:1/128
end
if f.7                                   # FRN 7, I009/080 Processing Status
  chain
    field  cat009.i080_f  5  twos
    field  cat009.i080_r  3  uint
    field  cat009.i080_q  15  uint
    fx
  end
end
if f.8                                   # FRN 8, I009/090 Radar Configuration and Status
  group  cat009.i090  count 8
    field  cat009.i090_sac  8  uint
    field  cat009.i090_sic  8  uint
    pad    3
    field  cat009.i090_cp  1  uint
    field  cat009.i090_wo  1  uint
    field  cat009.i090_r  3  uint
  end
end
if f.9                                   # FRN 9, I009/100 Vector Count
  field  cat009.i100  16  uint
end
