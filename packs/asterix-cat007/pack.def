    field  cat007.i020_poact_val  1  uint
    field  cat007.i020_dtfxpr_ep  1  uint
    field  cat007.i020_dtfxpr_val  1  uint
    field  cat007.i020_dtfact_ep  1  uint
    field  cat007.i020_dtfact_val  1  uint
