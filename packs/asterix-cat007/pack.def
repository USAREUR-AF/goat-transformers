  field  cat007.i100_v  1  uint
  field  cat007.i100_g  1  uint
  pad    2
  field  cat007.i100_modec  12  uint
  pad    4
  field  cat007.i100_qc1  1  uint
  field  cat007.i100_qa1  1  uint
  field  cat007.i100_qc2  1  uint
  field  cat007.i100_qa2  1  uint
  field  cat007.i100_qc4  1  uint
  field  cat007.i100_qa4  1  uint
  field  cat007.i100_qb1  1  uint
  field  cat007.i100_qd1  1  uint
  field  cat007.i100_qb2  1  uint
  field  cat007.i100_qd2  1  uint
  field  cat007.i100_qb4  1  uint
  field  cat007.i100_qd4  1  uint
end
if f.22                                  # FRN 22, I007/110 Height Measured by a 3D Radar
  pad    2
