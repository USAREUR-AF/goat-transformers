# Conformance probe pack that switches on a key its failed inner message gave
# (spec 0.34 ruling 19). Public. No kinds.
format     conformance-inner-failswitch
version    0.34.0
distribution public
source  "goat-transformers spec/engine-spec.md (synthetic probe format, no external standard)"
uses       probe
wire       bits
layout     sequential
bit_order  msb
length 8
  inner  conformance-inner-failjoin
end
field   probe.n  8  uint
switch  probe.n
  case  1
    field  probe.x  8  uint
end
