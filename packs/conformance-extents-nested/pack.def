# Conformance probe pack for `rest` inside an item, within a `length` block of
# the item's body (spec 0.21 rulings 3 and 10), most significant bit first.
# Public. No kinds.
#
#   items       an 8-bit count, then per item: a block with an 8-bit length in
#               bytes that holds subs to its end (val in 8 bits each), then
#               qty in 8 bits after the block
format     conformance-extents-nested
version    0.21.0
distribution public
source  "goat-transformers spec/engine-spec.md (synthetic probe format, no external standard)"
uses       probe
wire       bits
layout     sequential
bit_order  msb
group   probe.items count 8
  length 8
    group  probe.subs rest
      field  probe.val  8  uint
    end
  end
  field  probe.qty  8  uint
end
