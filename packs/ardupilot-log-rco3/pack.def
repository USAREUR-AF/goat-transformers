# ArduPilot log message RCO3 as the payload of a DataFlash log record.
# Generated by tools/gen/aplog2pack.py; do not edit by hand.
# The record without its 3-byte header (0xA3 0x95 type-id); fields packed, little-endian.
format        ardupilot-log-rco3
version       0.1.0
distribution  public
source        "ArduPilot log message definitions (log structure tables and Write calls), https://github.com/ArduPilot/ardupilot at tag Copter-4.6.2, commit 1ebd4d996e8b6bbeb1462a9655c00aa861d5beef; message names, format strings, labels, units and multipliers only; GNU General Public License, version 3"
source        "ArduPilot libraries/AP_Logger/LogStructure.h: the format characters, units and multipliers of a log message, at the same commit"
uses          aplog
wire          bits
bit_order     lsb
word_bytes    1
field  aplog.rco3_timeus  0:0:64  uint
field  aplog.rco3_c19  0:64:16  uint
field  aplog.rco3_c20  0:80:16  uint
field  aplog.rco3_c21  0:96:16  uint
field  aplog.rco3_c22  0:112:16  uint
field  aplog.rco3_c23  0:128:16  uint
field  aplog.rco3_c24  0:144:16  uint
field  aplog.rco3_c25  0:160:16  uint
field  aplog.rco3_c26  0:176:16  uint
field  aplog.rco3_c27  0:192:16  uint
field  aplog.rco3_c28  0:208:16  uint
field  aplog.rco3_c29  0:224:16  uint
field  aplog.rco3_c30  0:240:16  uint
field  aplog.rco3_c31  0:256:16  uint
field  aplog.rco3_c32  0:272:16  uint
