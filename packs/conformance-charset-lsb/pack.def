# Conformance probe pack for spec 0.46 ruling 6: the identifier of
# conformance-charset-bits in the default bit order (lsb). The 24 bits are
# read as one number, low bit first (so the bytes are little-endian), and the
# first position is at the number's most significant end. Public. No kinds.
format  conformance-charset-lsb
version 0.46.0
distribution public
source  "synthetic format, no external standard"
uses    probe
wire    bits
word_bytes 1
charset L  ABCDEFGHJKLMNPQRSTUVWXYZ  6
charset D  0123456789
field   probe.s1  0:0:24  code:L,L,D,D,D
