# Conformance probe pack used as an inner pack (spec 0.34):
# a rest group inside a length block, so not at message level. Public.
format     conformance-inner-lenrest
version    0.34.0
distribution public
source  "goat-transformers spec/engine-spec.md (synthetic probe format, no external standard)"
uses       probe
wire       bits
layout     sequential
bit_order  msb
length  8
  group  probe.nums rest
    field  probe.val  8  uint
  end
end
