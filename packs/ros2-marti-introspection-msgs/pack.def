uses          ros2martiintrospection
wire          json
when   op  publish
field  ros2martiintrospection.topic  topic  string

kind      node_info
when      type  marti_introspection_msgs/msg/NodeInfo
requires  ros2martiintrospection.node_info_name
field  ros2martiintrospection.node_info_name  msg.name  string
field  ros2martiintrospection.node_info_location  msg.location  string
field  ros2martiintrospection.node_info_nodelet_manager  msg.nodelet_manager  string
field  ros2martiintrospection.node_info_description  msg.description  string
group  ros2martiintrospection.node_info_topics  msg.topics
  field  ros2martiintrospection.node_info_topics_name  name  string
  field  ros2martiintrospection.node_info_topics_resolved_name  resolved_name  string
  field  ros2martiintrospection.node_info_topics_description  description  string
  field  ros2martiintrospection.node_info_topics_group  group  string
  field  ros2martiintrospection.node_info_topics_message_type  message_type  string
  field  ros2martiintrospection.node_info_topics_advertised  advertised  bool
end
group  ros2martiintrospection.node_info_parameters  msg.parameters
  field  ros2martiintrospection.node_info_parameters_name  name  string
  field  ros2martiintrospection.node_info_parameters_resolved_name  resolved_name  string
  field  ros2martiintrospection.node_info_parameters_description  description  string
  field  ros2martiintrospection.node_info_parameters_group  group  string
  field  ros2martiintrospection.node_info_parameters_type  type  int
  field  ros2martiintrospection.node_info_parameters_dynamic  dynamic  bool
  field  ros2martiintrospection.node_info_parameters_default_int  default_int  int
  field  ros2martiintrospection.node_info_parameters_default_float  default_float  float
  field  ros2martiintrospection.node_info_parameters_default_double  default_double  float
  field  ros2martiintrospection.node_info_parameters_default_string  default_string  string
  field  ros2martiintrospection.node_info_parameters_default_bool  default_bool  bool
  field  ros2martiintrospection.node_info_parameters_max_value  max_value  float
  field  ros2martiintrospection.node_info_parameters_min_value  min_value  float
end
group  ros2martiintrospection.node_info_services  msg.services
  field  ros2martiintrospection.node_info_services_name  name  string
  field  ros2martiintrospection.node_info_services_resolved_name  resolved_name  string
  field  ros2martiintrospection.node_info_services_description  description  string
  field  ros2martiintrospection.node_info_services_group  group  string
  field  ros2martiintrospection.node_info_services_message_type  message_type  string
  field  ros2martiintrospection.node_info_services_server  server  bool
  field  ros2martiintrospection.node_info_services_topic_service  topic_service  bool
end

kind      param_info
when      type  marti_introspection_msgs/msg/ParamInfo
requires  ros2martiintrospection.param_info_name
field  ros2martiintrospection.param_info_name  msg.name  string
