# ROS 2 marti_introspection_msgs messages in the JSON form of a rosbridge `publish` operation.
# Generated by tools/gen/ros2msg2pack.py; do not edit by hand.
# One kind per .msg file, selected by the member `type` ("<package>/msg/<Name>").
# The ROS message is the object under `msg`; arrays are groups.
format        ros2-marti-introspection-msgs
version       0.1.0
distribution  public
source        "ROS 2 interface package marti_introspection_msgs, https://github.com/swri-robotics/marti_messages ros2-devel (BSD License) at commit 2c7215f88d1466b698f77b8020533ac5fc75a3da, directory marti_introspection_msgs/msg; field names, types and array forms only"
