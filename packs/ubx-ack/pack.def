# UBX frames of the message class ACK (0x05), one kind per message definition.
# Generated by tools/gen/ubx2pack.py; do not edit by hand.
# The message is one UBX frame without its checksum: sync 0xB5 0x62, class,
# id, payload length (u16), payload. Payload bit 0 is bit 48.
format        ubx-ack
version       0.1.0
distribution  public
source        "https://github.com/semuconsulting/pyubx2 src/pyubx2/ubxtypes_get.py, ubxtypes_set.py, ubxtypes_poll.py at v1.4.1 (commit e5335f7285b24808fb62ccaf6666a6b954f27118)"
uses          ubxack
wire          bits
bit_order     lsb
word_bytes    1
when   0:0:8 181
when   0:8:8 98
when   0:16:8 5

kind      ack_ack
when      0:24:8 1
when      0:32:16 2
requires  ubxack.ack_ack_clsid ubxack.ack_ack_msgid
field     ubxack.ack_ack_clsid 0:48:8 uint
field     ubxack.ack_ack_msgid 0:56:8 uint

kind      ack_nak
when      0:24:8 0
when      0:32:16 2
