# ArduPilot log message RATE as the payload of a DataFlash log record.
# Generated by tools/gen/aplog2pack.py; do not edit by hand.
# The record without its 3-byte header (0xA3 0x95 type-id); fields packed, little-endian.
format        ardupilot-log-rate
version       0.1.0
distribution  public
source        "ArduPilot log message definitions (log structure tables and Write calls), https://github.com/ArduPilot/ardupilot at tag Copter-4.6.2, commit 1ebd4d996e8b6bbeb1462a9655c00aa861d5beef; message names, format strings, labels, units and multipliers only; GNU General Public License, version 3"
source        "ArduPilot libraries/AP_Logger/LogStructure.h: the format characters, units and multipliers of a log message, at the same commit"
uses          aplog
wire          bits
bit_order     lsb
word_bytes    1
field  aplog.rate_timeus  0:0:64  uint
field  aplog.rate_rdes  0:64:32  f32
field  aplog.rate_r  0:96:32  f32
field  aplog.rate_rout  0:128:32  f32
field  aplog.rate_pdes  0:160:32  f32
field  aplog.rate_p  0:192:32  f32
field  aplog.rate_pout  0:224:32  f32
field  aplog.rate_ydes  0:256:32  f32
field  aplog.rate_y  0:288:32  f32
field  aplog.rate_yout  0:320:32  f32
field  aplog.rate_ades  0:352:32  f32
field  aplog.rate_a  0:384:32  f32
field  aplog.rate_aout  0:416:32  f32
field  aplog.rate_aoutslew  0:448:32  f32
