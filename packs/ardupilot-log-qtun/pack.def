# ArduPilot log message QTUN as the payload of a DataFlash log record.
# Generated by tools/gen/aplog2pack.py; do not edit by hand.
# The record without its 3-byte header (0xA3 0x95 type-id); fields packed, little-endian.
format        ardupilot-log-qtun
version       0.1.0
distribution  public
source        "ArduPilot log message definitions (log structure tables and Write calls), https://github.com/ArduPilot/ardupilot at tag Copter-4.6.2, commit 1ebd4d996e8b6bbeb1462a9655c00aa861d5beef; message names, format strings, labels, units and multipliers only; GNU General Public License, version 3"
source        "ArduPilot libraries/AP_Logger/LogStructure.h: the format characters, units and multipliers of a log message, at the same commit"
uses          aplog
wire          bits
bit_order     lsb
word_bytes    1
field  aplog.qtun_timeus  0:0:64  uint
field  aplog.qtun_thi  0:64:32  f32
field  aplog.qtun_abst  0:96:32  f32
field  aplog.qtun_tho  0:128:32  f32
field  aplog.qtun_thh  0:160:32  f32
field  aplog.qtun_dalt  0:192:32  f32
field  aplog.qtun_alt  0:224:32  f32
field  aplog.qtun_balt  0:256:32  twos
field  aplog.qtun_dcrt  0:288:16  twos
field  aplog.qtun_crt  0:304:16  twos
field  aplog.qtun_tmix  0:320:32  f32
field  aplog.qtun_trn  0:352:8  uint
field  aplog.qtun_ast  0:360:8  uint
