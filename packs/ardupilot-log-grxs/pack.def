# ArduPilot log message GRXS as the payload of a DataFlash log record.
# Generated by tools/gen/aplog2pack.py; do not edit by hand.
# The record without its 3-byte header (0xA3 0x95 type-id); fields packed, little-endian.
format        ardupilot-log-grxs
version       0.1.0
distribution  public
source        "ArduPilot log message definitions (log structure tables and Write calls), https://github.com/ArduPilot/ardupilot at tag Copter-4.6.2, commit 1ebd4d996e8b6bbeb1462a9655c00aa861d5beef; message names, format strings, labels, units and multipliers only; GNU General Public License, version 3"
source        "ArduPilot libraries/AP_Logger/LogStructure.h: the format characters, units and multipliers of a log message, at the same commit"
uses          aplog
wire          bits
bit_order     lsb
word_bytes    1
field  aplog.grxs_timeus  0:0:64  uint
field  aplog.grxs_prmes  0:64:64  f64
field  aplog.grxs_cpmes  0:128:64  f64
field  aplog.grxs_domes  0:192:32  f32
field  aplog.grxs_gnss  0:224:8  uint
field  aplog.grxs_sv  0:232:8  uint
field  aplog.grxs_freq  0:240:8  uint
field  aplog.grxs_lock  0:248:16  uint
field  aplog.grxs_cno  0:264:8  uint
field  aplog.grxs_prd  0:272:8  uint
field  aplog.grxs_cpd  0:280:8  uint
field  aplog.grxs_dod  0:288:8  uint
field  aplog.grxs_trk  0:296:8  uint
