# SRT packet (draft-sharabayko-srt-01): the data packet and the control packets with the handshake
# and its extensions. Public. Written by tools/gen/media-pack.py; do not edit by hand.
format        srt-packet
version       0.1.0
distribution  public
source        "IETF Internet-Draft draft-sharabayko-srt-01, The SRT Protocol, September 2021, https://www.ietf.org/archive/id/draft-sharabayko-srt-01.txt (sha256 5a8dd79821c44c33b8292b5753213715b1b4293338f74684a01a8ccc57933e3b), IETF Trust (BCP 78); layout restated"
uses          srt
wire          bits
layout        sequential
bit_order     msb

kind    data
when    1  0
requires  srt.packet_seq  srt.position  srt.in_order  srt.key_flags  srt.retransmitted  srt.message_number  srt.timestamp  srt.dest_socket_id
field  srt.packet_seq  31  uint
field  srt.position  2  uint
field  srt.in_order  1  uint
field  srt.key_flags  2  uint
field  srt.retransmitted  1  uint
field  srt.message_number  26  uint
field  srt.timestamp  32  uint
field  srt.dest_socket_id  32  uint
group  srt.payload  rest
  field  srt.octet  8  uint
end

kind    control
when    1  1
requires  srt.control_type  srt.subtype  srt.type_specific  srt.timestamp  srt.dest_socket_id
field  srt.control_type  15  uint
field  srt.subtype  16  uint
field  srt.type_specific  32  uint
field  srt.timestamp  32  uint
field  srt.dest_socket_id  32  uint
switch  srt.control_type
  case  0                       # HANDSHAKE
    field  srt.hs_version  32  uint
    field  srt.encryption  16  uint
    field  srt.extension_field  16  uint
    field  srt.initial_seq  32  uint
    field  srt.mtu  32  uint
    field  srt.flow_window  32  uint
    field  srt.handshake_type  32  uint
    field  srt.srt_socket_id  32  uint
    field  srt.syn_cookie  32  uint
    field  srt.peer_ip  128  hex
    group  srt.extensions  rest
      field  srt.ext_type  16  uint
      switch  srt.ext_type
        case  1,2
          field  srt.ext_length  16  uint
          field  srt.srt_version  32  uint
          field  srt.srt_flags  32  uint
          field  srt.receiver_tsbpd_delay  16  uint
          field  srt.sender_tsbpd_delay  16  uint
        else
          count  ext_units  16
          length  @ext_units  units  32
            group  srt.ext_octets  rest
              field  srt.octet  8  uint
            end
          end
      end
    end
  case  2,3                     # ACK, NAK: 32-bit words
    group  srt.cif_words  rest
      field  srt.word  32  uint
    end
  case  7                       # DROPREQ
    field  srt.first_seq  32  uint
    field  srt.last_seq  32  uint
  case  6                       # ACKACK: no CIF
  else
    group  srt.cif  rest
      field  srt.octet  8  uint
    end
end
