# Conformance probe pack for `group <list> last` at message level (spec 0.21),
# most significant bit first. Public. No kinds.
#
#   nums        before each item one bit, 1 = this is the last item; val in 7
#               bits
format     conformance-extents-last
version    0.21.0
distribution public
source  "goat-transformers spec/engine-spec.md (synthetic probe format, no external standard)"
uses       probe
wire       bits
layout     sequential
bit_order  msb
group   probe.nums last
  field  probe.val  7  uint
end
