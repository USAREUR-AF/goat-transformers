uses          ros2autowareplanning
wire          json
when   op  publish
field  ros2autowareplanning.topic  topic  string

kind      lanelet_primitive
when      type  autoware_planning_msgs/msg/LaneletPrimitive
requires  ros2autowareplanning.lanelet_primitive_id
field  ros2autowareplanning.lanelet_primitive_id  msg.id  int
field  ros2autowareplanning.lanelet_primitive_primitive_type  msg.primitive_type  string

