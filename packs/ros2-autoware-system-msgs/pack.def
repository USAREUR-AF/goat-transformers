field  ros2autowaresystem.hazard_status_level  msg.level  int
field  ros2autowaresystem.hazard_status_emergency  msg.emergency  bool
field  ros2autowaresystem.hazard_status_emergency_holding  msg.emergency_holding  bool
group  ros2autowaresystem.hazard_status_diag_no_fault  msg.diag_no_fault
  field  ros2autowaresystem.hazard_status_diag_no_fault_level  level  int
  field  ros2autowaresystem.hazard_status_diag_no_fault_name  name  string
