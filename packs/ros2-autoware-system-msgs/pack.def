uses          ros2autowaresystem
wire          json
when   op  publish
field  ros2autowaresystem.topic  topic  string

kind      autoware_state
when      type  autoware_system_msgs/msg/AutowareState
requires  ros2autowaresystem.autoware_state_stamp_sec
