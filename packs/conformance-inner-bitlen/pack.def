# Conformance probe pack for an inner message in a length counted in bits
# (spec 0.34, Decode step 2), most significant bit first. Public. No kinds.
#
#   block       an 8-bit length in bits, then one conformance-inner-fixed
#               message to the end of the block
format     conformance-inner-bitlen
version    0.34.0
distribution public
source  "goat-transformers spec/engine-spec.md (synthetic probe format, no external standard)"
uses       probe
wire       bits
layout     sequential
bit_order  msb
length 8 bits
  inner  conformance-inner-fixed
end
