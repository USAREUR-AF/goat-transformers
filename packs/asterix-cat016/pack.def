# ASTERIX Category 016, Independent Non-Cooperative Surveillance System Configuration Reports, edition 1.0: one data block holding one record.
# Public. Generated by tools/gen/asterix2pack.py from the category definition of
# github.com/zoranbosnjak/asterix-specs (BSD-3-Clause); do not edit by hand. I/O is hex text.
# Needs engine version 0.8 (`layout sequential`). See pack.md.
#
#   octet 1       CAT = 16
#   octets 2-3    LEN, the length of the data block in octets, CAT and LEN included
#   FSPEC         octets of 7 presence bits and an extension bit; bit n is FRN n
#   then          the items whose FSPEC bit is 1, in FRN order
#
# An FRN with no `if` block is not mapped: a record with that FSPEC bit set fails
# with `malformed-wire` (ruling 1 of engine-spec 0.8), and encode never sets the bit.
format     asterix-cat016
version    0.1.0
distribution public
source  "ASTERIX Category 016, Independent Non-Cooperative Surveillance System Configuration Reports, edition 1.0 (2019-07-15), as transcribed in github.com/zoranbosnjak/asterix-specs (BSD-3-Clause), commit 64e9ffba964b92a1af3157bc6bdf7852a63bf700, specs/cat016/cats/cat1.0/definition.json. The category is specified by EUROCONTROL"
uses       cat016
wire       bits
layout     sequential
bit_order  msb
kind    record
when    8  16                              # CAT
length  16 whole                         # LEN
presence f fx
if f.1                                   # FRN 1, I016/010 Data Source Identifier
  field  cat016.i010_sac  8  uint
  field  cat016.i010_sic  8  uint
end
if f.2                                   # FRN 2, I016/015 Service Identification
  field  cat016.i015  8  uint
end
if f.3                                   # FRN 3, I016/000 Message Type
  field  cat016.i000  8  uint
end
if f.4                                   # FRN 4, I016/140 Time of Day
  field  cat016.i140  24  uscale:1/128
end
if f.5                                   # FRN 5, I016/200 System Configuration Reporting Period
  field  cat016.i200  8  uscale:1
end
if f.6                                   # FRN 6, I016/300 Pair Identification
  group  cat016.i300  count 8
    field  cat016.i300_pid  16  uint
    field  cat016.i300_tid  16  uint
    field  cat016.i300_rid  16  uint
  end
end
if f.7                                   # FRN 7, I016/400 Position of the System Reference Point
  field  cat016.i400_lat  32  sscale:45/536870912
  field  cat016.i400_lon  32  sscale:45/536870912
end
if f.8                                   # FRN 8, I016/405 Height of System Reference Point
  field  cat016.i405  16  sscale:1/4
end
if f.9                                   # FRN 9, I016/410 Transmitter Properties
  group  cat016.i410  count 8
    field  cat016.i410_tid  16  uint
    field  cat016.i410_lat  32  sscale:45/536870912
    field  cat016.i410_lon  32  sscale:45/536870912
    field  cat016.i410_alt  16  sscale:1/4
    field  cat016.i410_tto  32  sscale:2
    pad    4
    field  cat016.i410_ato  20  uscale:1
    field  cat016.i410_pci  16  uint
  end
end
if f.10                                  # FRN 10, I016/420 Receiver Properties
  group  cat016.i420  count 8
    field  cat016.i420_rid  16  uint
    field  cat016.i420_lat  32  sscale:45/536870912
    field  cat016.i420_lon  32  sscale:45/536870912
    field  cat016.i420_alt  16  sscale:1/4
  end
end
if f.11                                  # FRN 11, I016/SP Special Purpose Field
  length 8 bytes plus 1                # the length octet counts itself; the content is not mapped
  end
end
