# GTFS Schedule stop_times.txt: one data row of the file. Public. Maintained by hand.
# The columns are in the order the reference lists them (pack.md, Column order);
# the header row is not a message of this pack.
format        gtfs-stop-times
version       0.1.0
distribution  public
source        "GTFS Schedule Reference, gtfs/spec/en/reference.md of https://github.com/google/transit (Apache-2.0) at commit 2ce6aa79e3fa7bdbaf19d2a12765cee5b9fdd699; the column order of each file as the reference lists it; field names and types"
uses          gtfs
wire          text

field  gtfs.trip_id                     0   string
field  gtfs.arrival_time                1   string
field  gtfs.departure_time              2   string
field  gtfs.stop_id                     3   string
field  gtfs.location_group_id           4   string
field  gtfs.location_id                 5   string
field  gtfs.stop_sequence               6   int
field  gtfs.stop_headsign               7   string
field  gtfs.start_pickup_drop_off_window 8   string
field  gtfs.end_pickup_drop_off_window  9   string
field  gtfs.pickup_type                 10  int
field  gtfs.drop_off_type               11  int
field  gtfs.continuous_pickup           12  int
field  gtfs.continuous_drop_off         13  int
field  gtfs.shape_dist_traveled         14  float
field  gtfs.timepoint                   15  int
field  gtfs.pickup_booking_rule_id      16  string
field  gtfs.drop_off_booking_rule_id    17  string
