# SBP frames of the package swiftnav.sbp.system whose payload length is not fixed,
# one kind per message. Generated by tools/gen/sbp2pack.py; do not edit by hand.
# The frame: preamble 0x55, message type (u16), sender (u16), length (u8),
# payload, without the CRC. The payload is a `length 8 bytes` extent; an array
# or text that runs to its end is a `rest` group (engine-spec 0.8, 0.21).
format        sbp-system-var
version       0.1.0
distribution  public
source        "https://github.com/swift-nav/libsbp spec/yaml/swiftnav/sbp/system.yaml at v6.5.2 (commit 925825dea5174f069b5d6e23548f213e09f0235c)"
uses          sbp
uses          sbpsystem
wire          bits
layout        sequential
bit_order     lsb
when  8  85

kind  dgnss_status
when  16  65282
requires  sbpsystem.dgnss_status_flags
field  sbp.sender  16  uint
length  8  bytes
  field  sbpsystem.dgnss_status_flags  8  uint
  field  sbpsystem.dgnss_status_latency  16  uint
  field  sbpsystem.dgnss_status_num_signals  8  uint
  group  sbpsystem.dgnss_status_source  rest
    field  sbpsystem.dgnss_status_source_byte  8  uint
  end
end

kind  status_report
when  16  65534
requires  sbpsystem.status_report_reporting_system
field  sbp.sender  16  uint
length  8  bytes
  field  sbpsystem.status_report_reporting_system  16  uint
  field  sbpsystem.status_report_sbp_version  16  uint
  field  sbpsystem.status_report_sequence  32  uint
  field  sbpsystem.status_report_uptime  32  uint
  group  sbpsystem.status_report_status  rest
    field  sbpsystem.status_report_status_component  16  uint
    field  sbpsystem.status_report_status_generic  8  uint
    field  sbpsystem.status_report_status_specific  8  uint
  end
end

kind  status_journal
when  16  65533
requires  sbpsystem.status_journal_reporting_system
field  sbp.sender  16  uint
length  8  bytes
  field  sbpsystem.status_journal_reporting_system  16  uint
  field  sbpsystem.status_journal_sbp_version  16  uint
  field  sbpsystem.status_journal_total_status_reports  32  uint
  field  sbpsystem.status_journal_sequence_descriptor  8  uint
  group  sbpsystem.status_journal_journal  rest
    field  sbpsystem.status_journal_journal_uptime  32  uint
    field  sbpsystem.status_journal_journal_report_component  16  uint
    field  sbpsystem.status_journal_journal_report_generic  8  uint
    field  sbpsystem.status_journal_journal_report_specific  8  uint
  end
end

kind  csac_telemetry
when  16  65284
requires  sbpsystem.csac_telemetry_id
field  sbp.sender  16  uint
length  8  bytes
  field  sbpsystem.csac_telemetry_id  8  uint
  group  sbpsystem.csac_telemetry_telemetry  rest
    field  sbpsystem.csac_telemetry_telemetry_byte  8  uint
  end
end

kind  csac_telemetry_labels
when  16  65285
requires  sbpsystem.csac_telemetry_labels_id
field  sbp.sender  16  uint
length  8  bytes
  field  sbpsystem.csac_telemetry_labels_id  8  uint
  group  sbpsystem.csac_telemetry_labels_telemetry_labels  rest
    field  sbpsystem.csac_telemetry_labels_telemetry_labels_byte  8  uint
  end
end

kind  group_meta
when  16  65290
requires  sbpsystem.group_meta_group_id
field  sbp.sender  16  uint
length  8  bytes
  field  sbpsystem.group_meta_group_id  8  uint
  field  sbpsystem.group_meta_flags  8  uint
  count  n_group_msgs  8
  group  sbpsystem.group_meta_group_msgs  count @n_group_msgs
    field  sbpsystem.group_meta_group_msgs_item  16  uint
  end
end
