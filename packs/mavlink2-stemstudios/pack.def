# MAVLink 2 frames, the messages the dialect stemstudios.xml defines itself.
# The included files are read only to check that ids and names are unique.
# Generated by tools/gen/mavlink2pack.py; do not edit by hand.
# One byte-aligned frame addressed by bit offset from the STX byte:
# STX(8) LEN(8) INCOMPAT(8) COMPAT(8) SEQ(8) SYSID(8) COMPID(8) MSGID(24) PAYLOAD CRC(16).
# Payload starts at bit 80. CRC, INCOMPAT and COMPAT are not mapped.
format        mavlink2-stemstudios
version       0.1.0
distribution  public
source        "https://github.com/mavlink/mavlink message_definitions/v1.0/stemstudios.xml at commit 12c898d88ce18d24e8caf6338596e98c5005bc97"
source        "https://github.com/mavlink/mavlink message_definitions/v1.0/common.xml at commit 12c898d88ce18d24e8caf6338596e98c5005bc97"
source        "https://github.com/mavlink/mavlink message_definitions/v1.0/standard.xml at commit 12c898d88ce18d24e8caf6338596e98c5005bc97"
source        "https://github.com/mavlink/mavlink message_definitions/v1.0/minimal.xml at commit 12c898d88ce18d24e8caf6338596e98c5005bc97"
source        "MAVLink 2 packet format, https://mavlink.io/en/guide/serialization.html"
uses          mavlink
uses          mavlinkstemstudios
wire          bits
bit_order     lsb
word_bytes    1
when   0:0:8 253
field  mavlink.seq 0:32:8 uint
field  mavlink.sysid 0:40:8 uint
field  mavlink.compid 0:48:8 uint

kind      led_strip_config
when      0:56:24 52600
when      0:8:8 38
requires  mavlinkstemstudios.colors_0 mavlinkstemstudios.colors_1 mavlinkstemstudios.colors_2 mavlinkstemstudios.target_system mavlinkstemstudios.target_component mavlinkstemstudios.mode
field     mavlinkstemstudios.colors_0 0:80:32 uint
field     mavlinkstemstudios.colors_1 0:112:32 uint
field     mavlinkstemstudios.colors_2 0:144:32 uint
field     mavlinkstemstudios.colors_3 0:176:32 uint
field     mavlinkstemstudios.colors_4 0:208:32 uint
field     mavlinkstemstudios.colors_5 0:240:32 uint
field     mavlinkstemstudios.colors_6 0:272:32 uint
field     mavlinkstemstudios.colors_7 0:304:32 uint
field     mavlinkstemstudios.target_system 0:336:8 uint
field     mavlinkstemstudios.target_component 0:344:8 uint
field     mavlinkstemstudios.mode 0:352:8 uint
field     mavlinkstemstudios.index 0:360:8 uint
field     mavlinkstemstudios.length 0:368:8 uint
field     mavlinkstemstudios.id 0:376:8 uint

kind      led_strip_state
when      0:56:24 52601
when      0:8:8 36
requires  mavlinkstemstudios.colors_0 mavlinkstemstudios.colors_1 mavlinkstemstudios.colors_2 mavlinkstemstudios.colors_3 mavlinkstemstudios.colors_4 mavlinkstemstudios.following_flight_mode
field     mavlinkstemstudios.colors_0 0:80:32 uint
field     mavlinkstemstudios.colors_1 0:112:32 uint
field     mavlinkstemstudios.colors_2 0:144:32 uint
field     mavlinkstemstudios.colors_3 0:176:32 uint
field     mavlinkstemstudios.colors_4 0:208:32 uint
field     mavlinkstemstudios.colors_5 0:240:32 uint
field     mavlinkstemstudios.colors_6 0:272:32 uint
field     mavlinkstemstudios.colors_7 0:304:32 uint
field     mavlinkstemstudios.length 0:336:8 uint
field     mavlinkstemstudios.index 0:344:8 uint
field     mavlinkstemstudios.id 0:352:8 uint
field     mavlinkstemstudios.following_flight_mode 0:360:8 uint
