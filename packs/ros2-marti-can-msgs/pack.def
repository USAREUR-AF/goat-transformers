# ROS 2 marti_can_msgs messages in the JSON form of a rosbridge `publish` operation.
# Generated by tools/gen/ros2msg2pack.py; do not edit by hand.
# One kind per .msg file, selected by the member `type` ("<package>/msg/<Name>").
# The ROS message is the object under `msg`; arrays are groups.
format        ros2-marti-can-msgs
version       0.1.0
distribution  public
source        "ROS 2 interface package marti_can_msgs, https://github.com/swri-robotics/marti_messages ros2-devel (BSD License) at commit 2c7215f88d1466b698f77b8020533ac5fc75a3da, directory marti_can_msgs/msg; field names, types and array forms only"
source        "ROS 2 interface package builtin_interfaces (messages marti_can_msgs refers to), https://github.com/ros2/rcl_interfaces 2.0.4 at commit 7aa3caf43377ea6ad615bc1040832e2c7566bfbe, Apache License 2.0"
source        "ROS 2 interface package std_msgs (messages marti_can_msgs refers to), https://github.com/ros2/common_interfaces 5.3.8 at commit a941f14bb318d8d904505ed935ccbb97f24a70a4, Apache License 2.0"
source        "rosbridge v2.1.0 Protocol Specification, ROSBRIDGE_PROTOCOL.md, https://github.com/RobotWebTools/rosbridge_suite jazzy at commit cb33a16b890e4b8d9def531326409f3ee6c12537, BSD 3-Clause License; JSON form of a message and of the publish operation"
uses          ros2martican
wire          json
when   op  publish
field  ros2martican.topic  topic  string

kind      can_frame
when      type  marti_can_msgs/msg/CanFrame
requires  ros2martican.can_frame_header_stamp_sec
field  ros2martican.can_frame_header_stamp_sec  msg.header.stamp.sec  int
field  ros2martican.can_frame_header_stamp_nanosec  msg.header.stamp.nanosec  int
field  ros2martican.can_frame_header_frame_id  msg.header.frame_id  string
field  ros2martican.can_frame_id  msg.id  int
field  ros2martican.can_frame_msg_type  msg.msg_type  int
field  ros2martican.can_frame_data_length  msg.data_length  int
field  ros2martican.can_frame_data  msg.data  string
