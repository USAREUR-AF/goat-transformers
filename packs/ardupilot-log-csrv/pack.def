# ArduPilot log message CSRV as the payload of a DataFlash log record.
# Generated by tools/gen/aplog2pack.py; do not edit by hand.
# The record without its 3-byte header (0xA3 0x95 type-id); fields packed, little-endian.
format        ardupilot-log-csrv
version       0.1.0
distribution  public
source        "ArduPilot log message definitions (log structure tables and Write calls), https://github.com/ArduPilot/ardupilot at tag Copter-4.6.2, commit 1ebd4d996e8b6bbeb1462a9655c00aa861d5beef; message names, format strings, labels, units and multipliers only; GNU General Public License, version 3"
source        "ArduPilot libraries/AP_Logger/LogStructure.h: the format characters, units and multipliers of a log message, at the same commit"
uses          aplog
wire          bits
bit_order     lsb
word_bytes    1
field  aplog.csrv_timeus  0:0:64  uint
field  aplog.csrv_id  0:64:8  uint
field  aplog.csrv_pos  0:72:32  f32
field  aplog.csrv_force  0:104:32  f32
field  aplog.csrv_speed  0:136:32  f32
field  aplog.csrv_pow  0:168:8  uint
field  aplog.csrv_poscmd  0:176:32  f32
field  aplog.csrv_v  0:208:32  f32
field  aplog.csrv_a  0:240:32  f32
field  aplog.csrv_mott  0:272:32  f32
field  aplog.csrv_pcbt  0:304:32  f32
field  aplog.csrv_err  0:336:8  uint
