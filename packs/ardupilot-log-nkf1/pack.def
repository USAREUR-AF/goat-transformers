# ArduPilot log message NKF1 as the payload of a DataFlash log record.
# Generated by tools/gen/aplog2pack.py; do not edit by hand.
# The record without its 3-byte header (0xA3 0x95 type-id); fields packed, little-endian.
format        ardupilot-log-nkf1
version       0.1.0
distribution  public
source        "ArduPilot log message definitions (log structure tables and Write calls), https://github.com/ArduPilot/ardupilot at tag Copter-4.6.2, commit 1ebd4d996e8b6bbeb1462a9655c00aa861d5beef; message names, format strings, labels, units and multipliers only; GNU General Public License, version 3"
source        "ArduPilot libraries/AP_Logger/LogStructure.h: the format characters, units and multipliers of a log message, at the same commit"
uses          aplog
wire          bits
bit_order     lsb
word_bytes    1
field  aplog.nkf1_timeus  0:0:64  uint
field  aplog.nkf1_c  0:64:8  uint
field  aplog.nkf1_roll  0:72:16  twos
field  aplog.nkf1_pitch  0:88:16  twos
field  aplog.nkf1_yaw  0:104:16  uint
field  aplog.nkf1_vn  0:120:32  f32
field  aplog.nkf1_ve  0:152:32  f32
field  aplog.nkf1_vd  0:184:32  f32
field  aplog.nkf1_dpd  0:216:32  f32
field  aplog.nkf1_pn  0:248:32  f32
field  aplog.nkf1_pe  0:280:32  f32
field  aplog.nkf1_pd  0:312:32  f32
field  aplog.nkf1_gx  0:344:16  twos
field  aplog.nkf1_gy  0:360:16  twos
field  aplog.nkf1_gz  0:376:16  twos
field  aplog.nkf1_oh  0:392:32  twos
