# Synthetic binary bit-field format. Public, for proving the `bits` wire.
# One 9-byte word. Model-consistent field types: lat/lon are float (F64) via
# linscale; time_ms is integer (I64) via uint. No real standard.
format     demo-bits
version    0.2.0
distribution public
source  "synthetic format, no external standard"
wire       bits
word_bytes 9
field  lat       0:0:21    linscale:1048575:90
field  lon       0:21:22   linscale:2097151:180
field  time_ms   0:43:21   uint
