# ROS 2 nav_2d_msgs messages in the JSON form of a rosbridge `publish` operation.
# Generated by tools/gen/ros2msg2pack.py; do not edit by hand.
# One kind per .msg file, selected by the member `type` ("<package>/msg/<Name>").
# The ROS message is the object under `msg`; arrays are groups.
format        ros2-nav-2d-msgs
version       0.1.0
distribution  public
source        "ROS 2 interface package nav_2d_msgs, https://github.com/ros-navigation/navigation2 jazzy (Apache-2.0 or BSD-3-Clause per package.xml) at commit c7046550547d382a5186d106b0895eda02485d7c, directory nav2_dwb_controller/nav_2d_msgs/msg; field names, types and array forms only"
source        "ROS 2 interface package builtin_interfaces (messages nav_2d_msgs refers to), https://github.com/ros2/rcl_interfaces 2.0.4 at commit 7aa3caf43377ea6ad615bc1040832e2c7566bfbe, Apache License 2.0"
source        "ROS 2 interface package geometry_msgs (messages nav_2d_msgs refers to), https://github.com/ros2/common_interfaces 5.3.8 at commit a941f14bb318d8d904505ed935ccbb97f24a70a4, Apache License 2.0"
source        "ROS 2 interface package std_msgs (messages nav_2d_msgs refers to), https://github.com/ros2/common_interfaces 5.3.8 at commit a941f14bb318d8d904505ed935ccbb97f24a70a4, Apache License 2.0"
source        "rosbridge v2.1.0 Protocol Specification, ROSBRIDGE_PROTOCOL.md, https://github.com/RobotWebTools/rosbridge_suite jazzy at commit cb33a16b890e4b8d9def531326409f3ee6c12537, BSD 3-Clause License; JSON form of a message and of the publish operation"
uses          ros2nav2d
wire          json
when   op  publish
field  ros2nav2d.topic  topic  string

kind      path2d
when      type  nav_2d_msgs/msg/Path2D
requires  ros2nav2d.path2d_header_stamp_sec
field  ros2nav2d.path2d_header_stamp_sec  msg.header.stamp.sec  int
field  ros2nav2d.path2d_header_stamp_nanosec  msg.header.stamp.nanosec  int
field  ros2nav2d.path2d_header_frame_id  msg.header.frame_id  string
group  ros2nav2d.path2d_poses  msg.poses
  field  ros2nav2d.path2d_poses_x  x  float
  field  ros2nav2d.path2d_poses_y  y  float
  field  ros2nav2d.path2d_poses_theta  theta  float
end

kind      pose2d32
when      type  nav_2d_msgs/msg/Pose2D32
requires  ros2nav2d.pose2d32_x
field  ros2nav2d.pose2d32_x  msg.x  float
field  ros2nav2d.pose2d32_y  msg.y  float
field  ros2nav2d.pose2d32_theta  msg.theta  float

kind      pose2d_stamped
when      type  nav_2d_msgs/msg/Pose2DStamped
requires  ros2nav2d.pose2d_stamped_header_stamp_sec
field  ros2nav2d.pose2d_stamped_header_stamp_sec  msg.header.stamp.sec  int
field  ros2nav2d.pose2d_stamped_header_stamp_nanosec  msg.header.stamp.nanosec  int
field  ros2nav2d.pose2d_stamped_header_frame_id  msg.header.frame_id  string
field  ros2nav2d.pose2d_stamped_pose_x  msg.pose.x  float
field  ros2nav2d.pose2d_stamped_pose_y  msg.pose.y  float
field  ros2nav2d.pose2d_stamped_pose_theta  msg.pose.theta  float

kind      twist2d
when      type  nav_2d_msgs/msg/Twist2D
requires  ros2nav2d.twist2d_x
field  ros2nav2d.twist2d_x  msg.x  float
field  ros2nav2d.twist2d_y  msg.y  float
field  ros2nav2d.twist2d_theta  msg.theta  float

kind      twist2d32
when      type  nav_2d_msgs/msg/Twist2D32
requires  ros2nav2d.twist2d32_x
field  ros2nav2d.twist2d32_x  msg.x  float
field  ros2nav2d.twist2d32_y  msg.y  float
field  ros2nav2d.twist2d32_theta  msg.theta  float

kind      twist2d_stamped
when      type  nav_2d_msgs/msg/Twist2DStamped
requires  ros2nav2d.twist2d_stamped_header_stamp_sec
field  ros2nav2d.twist2d_stamped_header_stamp_sec  msg.header.stamp.sec  int
field  ros2nav2d.twist2d_stamped_header_stamp_nanosec  msg.header.stamp.nanosec  int
field  ros2nav2d.twist2d_stamped_header_frame_id  msg.header.frame_id  string
field  ros2nav2d.twist2d_stamped_velocity_x  msg.velocity.x  float
field  ros2nav2d.twist2d_stamped_velocity_y  msg.velocity.y  float
field  ros2nav2d.twist2d_stamped_velocity_theta  msg.velocity.theta  float
