# Conformance probe pack used as an inner pack (spec 0.34):
# common lines, two kinds and a trailing const. Public.
format     conformance-inner-kfix
version    0.34.0
distribution public
source  "goat-transformers spec/engine-spec.md (synthetic probe format, no external standard)"
uses       probe
wire       bits
word_bytes 1
bit_order  msb
field    probe.x  0:0:8  uint
kind a
when     0:8:8  1
requires probe.y
field    probe.y  0:16:8 uint
const    0:24:8  9
kind b
when     0:8:8  2
requires probe.x
