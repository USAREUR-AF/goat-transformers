# Conformance probe pack for the `cbor` wire (spec 0.28): an array at the
# top, enclosed in a tag, in the shape COSE_Sign1 (RFC 9052) uses: a byte
# string, a map with integer keys, a byte string, a byte string.
format        conformance-cbor-array
version       0.28.0
distribution  public
source        "goat-transformers spec/engine-spec.md (synthetic probe format, no external standard)"
uses          probe
wire          cbor
tag           18

field    probe.s1     [0]        bytes
field    probe.n      [1].1      int
field    uid          [1].4      bytes
field    probe.s2     [2]        bytes
field    probe.tag    [3]        bytes
