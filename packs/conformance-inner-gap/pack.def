# Conformance probe pack used as an inner pack (spec 0.34):
# a count at byte 1 that no field maps and a group from byte 4. Public.
format     conformance-inner-gap
version    0.34.0
distribution public
source  "goat-transformers spec/engine-spec.md (synthetic probe format, no external standard)"
uses       probe
wire       bits
word_bytes 1
bit_order  msb
field   probe.x  0:0:8  uint
group   probe.nums  0:32  item 8  count 0:8:8
  field probe.val  0:0:8  uint
end
