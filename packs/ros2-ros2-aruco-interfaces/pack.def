# ROS 2 ros2_aruco_interfaces messages in the JSON form of a rosbridge `publish` operation.
# Generated by tools/gen/ros2msg2pack.py; do not edit by hand.
# One kind per .msg file, selected by the member `type` ("<package>/msg/<Name>").
# The ROS message is the object under `msg`; arrays are groups.
format        ros2-ros2-aruco-interfaces
version       0.1.0
distribution  public
source        "ROS 2 interface package ros2_aruco_interfaces, https://github.com/JMU-ROBOTICS-VIVA/ros2_aruco main (MIT License (LICENSE)) at commit 91813cb3d9f899789d03811943c72d30fa7a8774, directory ros2_aruco_interfaces/msg; field names, types and array forms only"
source        "ROS 2 interface package builtin_interfaces (messages ros2_aruco_interfaces refers to), https://github.com/ros2/rcl_interfaces 2.0.4 at commit 7aa3caf43377ea6ad615bc1040832e2c7566bfbe, Apache License 2.0"
source        "ROS 2 interface package geometry_msgs (messages ros2_aruco_interfaces refers to), https://github.com/ros2/common_interfaces 5.3.8 at commit a941f14bb318d8d904505ed935ccbb97f24a70a4, Apache License 2.0"
source        "ROS 2 interface package std_msgs (messages ros2_aruco_interfaces refers to), https://github.com/ros2/common_interfaces 5.3.8 at commit a941f14bb318d8d904505ed935ccbb97f24a70a4, Apache License 2.0"
source        "rosbridge v2.1.0 Protocol Specification, ROSBRIDGE_PROTOCOL.md, https://github.com/RobotWebTools/rosbridge_suite jazzy at commit cb33a16b890e4b8d9def531326409f3ee6c12537, BSD 3-Clause License; JSON form of a message and of the publish operation"
uses          ros2aruco
wire          json
when   op  publish
field  ros2aruco.topic  topic  string

kind      aruco_markers
when      type  ros2_aruco_interfaces/msg/ArucoMarkers
requires  ros2aruco.aruco_markers_header_stamp_sec
field  ros2aruco.aruco_markers_header_stamp_sec  msg.header.stamp.sec  int
field  ros2aruco.aruco_markers_header_stamp_nanosec  msg.header.stamp.nanosec  int
field  ros2aruco.aruco_markers_header_frame_id  msg.header.frame_id  string
group  ros2aruco.aruco_markers_marker_ids  msg.marker_ids
  field  ros2aruco.aruco_markers_marker_ids_value  .  int
end
group  ros2aruco.aruco_markers_poses  msg.poses
  field  ros2aruco.aruco_markers_poses_position_x  position.x  float
  field  ros2aruco.aruco_markers_poses_position_y  position.y  float
  field  ros2aruco.aruco_markers_poses_position_z  position.z  float
  field  ros2aruco.aruco_markers_poses_orientation_x  orientation.x  float
  field  ros2aruco.aruco_markers_poses_orientation_y  orientation.y  float
  field  ros2aruco.aruco_markers_poses_orientation_z  orientation.z  float
  field  ros2aruco.aruco_markers_poses_orientation_w  orientation.w  float
end
