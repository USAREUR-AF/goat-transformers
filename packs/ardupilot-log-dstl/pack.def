# ArduPilot log message DSTL as the payload of a DataFlash log record.
# Generated by tools/gen/aplog2pack.py; do not edit by hand.
# The record without its 3-byte header (0xA3 0x95 type-id); fields packed, little-endian.
format        ardupilot-log-dstl
version       0.1.0
distribution  public
source        "ArduPilot log message definitions (log structure tables and Write calls), https://github.com/ArduPilot/ardupilot at tag Copter-4.6.2, commit 1ebd4d996e8b6bbeb1462a9655c00aa861d5beef; message names, format strings, labels, units and multipliers only; GNU General Public License, version 3"
source        "ArduPilot libraries/AP_Logger/LogStructure.h: the format characters, units and multipliers of a log message, at the same commit"
uses          aplog
wire          bits
bit_order     lsb
word_bytes    1
field  aplog.dstl_timeus  0:0:64  uint
field  aplog.dstl_stg  0:64:8  uint
field  aplog.dstl_thdg  0:72:32  f32
field  aplog.dstl_lat  0:104:32  twos
field  aplog.dstl_lng  0:136:32  twos
field  aplog.dstl_alt  0:168:32  twos
field  aplog.dstl_xt  0:200:16  twos
field  aplog.dstl_travel  0:216:16  twos
field  aplog.dstl_l1i  0:232:32  f32
field  aplog.dstl_loiter  0:264:32  twos
field  aplog.dstl_des  0:296:32  f32
field  aplog.dstl_p  0:328:32  f32
field  aplog.dstl_i  0:360:32  f32
field  aplog.dstl_d  0:392:32  f32
