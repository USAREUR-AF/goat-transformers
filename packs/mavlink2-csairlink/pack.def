# MAVLink 2 frames, the messages the dialect csAirLink.xml defines itself.
# The included files are read only to check that ids and names are unique.
# Generated by tools/gen/mavlink2pack.py; do not edit by hand.
# One byte-aligned frame addressed by bit offset from the STX byte:
# STX(8) LEN(8) INCOMPAT(8) COMPAT(8) SEQ(8) SYSID(8) COMPID(8) MSGID(24) PAYLOAD CRC(16).
# Payload starts at bit 80. The CRC and a signature are not mapped.
format        mavlink2-csairlink
version       0.1.0
distribution  public
source        "https://github.com/mavlink/mavlink message_definitions/v1.0/csAirLink.xml at commit 12c898d88ce18d24e8caf6338596e98c5005bc97"
source        "MAVLink 2 packet format, https://mavlink.io/en/guide/serialization.html"
uses          mavlink
uses          mavlinkcsairlink
wire          bits
bit_order     lsb
word_bytes    1
when   0:0:8 253
field  mavlink.seq 0:32:8 uint
field  mavlink.sysid 0:40:8 uint
field  mavlink.compid 0:48:8 uint
field  mavlink.incompat_flags 0:16:8 uint
field  mavlink.compat_flags 0:24:8 uint

kind      airlink_auth
when      0:56:24 52000
when      0:8:8 100
requires  mavlinkcsairlink.login mavlinkcsairlink.password
field     mavlinkcsairlink.login 0:80:400 ascii
field     mavlinkcsairlink.password 0:480:400 ascii

kind      airlink_auth_response
when      0:56:24 52001
when      0:8:8 1
requires  mavlinkcsairlink.resp_type
field     mavlinkcsairlink.resp_type 0:80:8 uint
