# ROS 2 novatel_gps_msgs messages in the JSON form of a rosbridge `publish` operation.
# Generated by tools/gen/ros2msg2pack.py; do not edit by hand.
# One kind per .msg file, selected by the member `type` ("<package>/msg/<Name>").
# The ROS message is the object under `msg`; arrays are groups.
format        ros2-novatel-gps-msgs
version       0.1.0
distribution  public
source        "ROS 2 interface package novatel_gps_msgs, https://github.com/swri-robotics/novatel_gps_driver ros2-devel (BSD 3-Clause License) at commit 500a635c72ed2d924aa5ba8675ac8e6d66301b64, directory novatel_gps_msgs/msg; field names, types and array forms only"
