# TLS 1.3 record (RFC 8446 section 5.1) with its handshake messages (section 4): the record header on the inet
# keys of tls-record-header, then by content type the handshake messages (ClientHello and ServerHello laid out),
# the alert, the change_cipher_spec, or the data. Written by tools/gen/webframes-pack.py; do not edit by hand.
format        tls-record
version       0.1.0
distribution  public
source        "IETF RFC 8446, The Transport Layer Security (TLS) Protocol Version 1.3, August 2018, sections 4, 4.1.2, 4.1.3, 4.2, 4.2.1, 5.1 and 6, https://www.rfc-editor.org/rfc/rfc8446.txt; IETF RFC 6066 section 3 (server_name); layout restated"
uses          inet
uses          tls13
wire          bits
layout        sequential
bit_order     msb

field  inet.tls_content_type  8  uint
field  inet.tls_legacy_version  16  uint
length  16  bytes
  switch  inet.tls_content_type
    case  22
      group  tls13.handshakes  rest
        field  tls13.handshake_type  8  uint
        length  24  bytes
          switch  tls13.handshake_type
            case  1
              field  tls13.legacy_version  16  uint
              field  tls13.random  256  hex
              count  session_id_length  8
              group  tls13.legacy_session_id  count  @session_id_length
                field  tls13.octet  8  uint
              end
              length  16  bytes
                group  tls13.cipher_suites  rest
                  field  tls13.cipher_suite  16  uint
                end
              end
              length  8  bytes
                group  tls13.compression_methods  rest
                  field  tls13.compression_method  8  uint
                end
              end
              length  16  bytes
                group  tls13.client_extensions  rest
                  field  tls13.extension_type  16  uint
                  length  16  bytes
                    switch  tls13.extension_type
                      case  0
                        length  16  bytes
                          group  tls13.server_names  rest
                            field  tls13.name_type  8  uint
                            length  16  bytes
                              group  tls13.host_name  rest
                                field  tls13.octet  8  uint
                              end
                            end
                          end
                        end
                      case  43
                        length  8  bytes
                          group  tls13.supported_versions  rest
                            field  tls13.version  16  uint
                          end
                        end
                      else
                        group  tls13.extension_data  rest
                          field  tls13.octet  8  uint
                        end
                    end
                  end
                end
              end
            case  2
              field  tls13.legacy_version  16  uint
              field  tls13.random  256  hex
              count  session_id_length  8
              group  tls13.legacy_session_id  count  @session_id_length
                field  tls13.octet  8  uint
              end
              field  tls13.selected_cipher_suite  16  uint
              field  tls13.selected_compression_method  8  uint
              length  16  bytes
                group  tls13.server_extensions  rest
                  field  tls13.extension_type  16  uint
                  length  16  bytes
                    switch  tls13.extension_type
                      case  43
                        field  tls13.selected_version  16  uint
                      else
                        group  tls13.extension_data  rest
                          field  tls13.octet  8  uint
                        end
                    end
                  end
                end
              end
            else
              group  tls13.handshake_body  rest
                field  tls13.octet  8  uint
              end
          end
        end
      end
    case  21
      field  inet.tls_alert_level  8  uint
      field  inet.tls_alert_description  8  uint
    case  20
      field  inet.tls_ccs_value  8  uint
    else
      group  tls13.record_data  rest
        field  tls13.octet  8  uint
      end
  end
end
