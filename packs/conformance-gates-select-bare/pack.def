# Conformance probe pack for gate blocks (spec 0.17): one bit chooses between
# two meanings of the same bits, with no raw key on that bit. Fixed `bits`
# layout, most significant bit first. Public. No kinds. One byte per word.
# No line stands outside a block. Exercises: one key (hae) in two blocks of
# opposite gates, where a round trip of the second meaning re-encodes in the
# first; two keys (x, y) on the same bits under a two-bit gate read most
# significant bit first, where an entity holding both cannot be encoded.
#
#   byte 0       bit 7 (the last bit of the byte): the selector of hae
#   byte 1       hae in units of 25 m when the selector is 0, of 100 m when 1
#   byte 2       bits 20-21 (the third and fourth bits of the byte, the first
#                most significant): 1 for x, 2 for y
#   byte 3       x or y
format     conformance-gates-select-bare
version    0.17.0
distribution public
source  "goat-transformers spec/engine-spec.md (synthetic probe format, no external standard)"
uses       probe
wire       bits
word_bytes 1
bit_order  msb
if      0:7:1  0
  field hae       0:8:8   uscale:25
end
if      0:7:1  1
  field hae       0:8:8   uscale:100
end
if      0:20:2 1
  field probe.x   0:24:8  uint
end
if      0:20:2 2
  field probe.y   0:24:8  uint
end
