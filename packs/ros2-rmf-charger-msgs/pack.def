# ROS 2 rmf_charger_msgs messages in the JSON form of a rosbridge `publish` operation.
# Generated by tools/gen/ros2msg2pack.py; do not edit by hand.
# One kind per .msg file, selected by the member `type` ("<package>/msg/<Name>").
# The ROS message is the object under `msg`; arrays are groups.
format        ros2-rmf-charger-msgs
version       0.1.0
distribution  public
source        "ROS 2 interface package rmf_charger_msgs, https://github.com/open-rmf/rmf_internal_msgs jazzy (Apache License 2.0) at commit 04585f0e2b0da9f11327fb403d38bc547d648fa6, directory rmf_charger_msgs/msg; field names, types and array forms only"
source        "ROS 2 interface package builtin_interfaces (messages rmf_charger_msgs refers to), https://github.com/ros2/rcl_interfaces 2.0.4 at commit 7aa3caf43377ea6ad615bc1040832e2c7566bfbe, Apache License 2.0"
source        "rosbridge v2.1.0 Protocol Specification, ROSBRIDGE_PROTOCOL.md, https://github.com/RobotWebTools/rosbridge_suite jazzy at commit cb33a16b890e4b8d9def531326409f3ee6c12537, BSD 3-Clause License; JSON form of a message and of the publish operation"
uses          ros2rmfcharger
wire          json
when   op  publish
field  ros2rmfcharger.topic  topic  string

kind      charger_cancel
when      type  rmf_charger_msgs/msg/ChargerCancel
requires  ros2rmfcharger.charger_cancel_charger_name
field  ros2rmfcharger.charger_cancel_charger_name  msg.charger_name  string
field  ros2rmfcharger.charger_cancel_request_id  msg.request_id  string

kind      charger_request
when      type  rmf_charger_msgs/msg/ChargerRequest
requires  ros2rmfcharger.charger_request_charger_name
field  ros2rmfcharger.charger_request_charger_name  msg.charger_name  string
field  ros2rmfcharger.charger_request_fleet_name  msg.fleet_name  string
field  ros2rmfcharger.charger_request_robot_name  msg.robot_name  string
field  ros2rmfcharger.charger_request_start_timeout_sec  msg.start_timeout.sec  int
field  ros2rmfcharger.charger_request_start_timeout_nanosec  msg.start_timeout.nanosec  int
field  ros2rmfcharger.charger_request_request_id  msg.request_id  string

kind      charger_state
when      type  rmf_charger_msgs/msg/ChargerState
requires  ros2rmfcharger.charger_state_charger_time_sec
field  ros2rmfcharger.charger_state_charger_time_sec  msg.charger_time.sec  int
field  ros2rmfcharger.charger_state_charger_time_nanosec  msg.charger_time.nanosec  int
field  ros2rmfcharger.charger_state_state  msg.state  int
field  ros2rmfcharger.charger_state_charger_name  msg.charger_name  string
field  ros2rmfcharger.charger_state_error_message  msg.error_message  string
field  ros2rmfcharger.charger_state_request_id  msg.request_id  string
field  ros2rmfcharger.charger_state_robot_fleet  msg.robot_fleet  string
field  ros2rmfcharger.charger_state_robot_name  msg.robot_name  string
field  ros2rmfcharger.charger_state_time_to_fully_charged_sec  msg.time_to_fully_charged.sec  int
field  ros2rmfcharger.charger_state_time_to_fully_charged_nanosec  msg.time_to_fully_charged.nanosec  int
