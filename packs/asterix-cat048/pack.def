# ASTERIX Category 048, Monoradar Target Reports, edition 1.32: one data block holding one record.
# Public. Generated by tools/gen/asterix2pack.py from the category definition of
# github.com/zoranbosnjak/asterix-specs (BSD-3-Clause); do not edit by hand. I/O is hex text.
# Needs engine version 0.8 (`layout sequential`). See pack.md.
#
#   octet 1       CAT = 48
#   octets 2-3    LEN, the length of the data block in octets, CAT and LEN included
#   FSPEC         octets of 7 presence bits and an extension bit; bit n is FRN n
#   then          the items whose FSPEC bit is 1, in FRN order
#
# An FRN with no `if` block is not mapped: a record with that FSPEC bit set fails
# with `malformed-wire` (ruling 1 of engine-spec 0.8), and encode never sets the bit.
format     asterix-cat048
version    0.1.0
distribution public
source  "ASTERIX Category 048, Monoradar Target Reports, edition 1.32 (2024-07-01), as transcribed in github.com/zoranbosnjak/asterix-specs (BSD-3-Clause), commit 64e9ffba964b92a1af3157bc6bdf7852a63bf700, specs/cat048/cats/cat1.32/definition.json. The category is specified by EUROCONTROL"
uses       cat048
wire       bits
layout     sequential
bit_order  msb
kind    record
when    8  48                              # CAT
length  16 whole                         # LEN
presence f fx
if f.1                                   # FRN 1, I048/010 Data Source Identifier
  field  cat048.i010_sac  8  uint
  field  cat048.i010_sic  8  uint
end
if f.2                                   # FRN 2, I048/140 Time of Day
  field  cat048.i140  24  uscale:1/128
end
if f.3                                   # FRN 3, I048/020 Target Report Descriptor
  chain
    field  cat048.i020_typ  3  uint
    field  cat048.i020_sim  1  uint
    field  cat048.i020_rdp  1  uint
    field  cat048.i020_spi  1  uint
    field  cat048.i020_rab  1  uint
    fx
    field  cat048.i020_tst  1  uint
    field  cat048.i020_err  1  uint
    field  cat048.i020_xpp  1  uint
    field  cat048.i020_me  1  uint
    field  cat048.i020_mi  1  uint
    field  cat048.i020_foefri  2  uint
    fx
    field  cat048.i020_adsb_ep  1  uint
    field  cat048.i020_adsb_val  1  uint
    field  cat048.i020_scn_ep  1  uint
    field  cat048.i020_scn_val  1  uint
    field  cat048.i020_pai_ep  1  uint
    field  cat048.i020_pai_val  1  uint
    pad    1
    fx
    field  cat048.i020_acasxv_ep  1  uint
    field  cat048.i020_acasxv_val  4  uint
    field  cat048.i020_poxpr_ep  1  uint
    field  cat048.i020_poxpr_val  1  uint
    fx
    field  cat048.i020_poact_ep  1  uint
    field  cat048.i020_poact_val  1  uint
    field  cat048.i020_dtfxpr_ep  1  uint
    field  cat048.i020_dtfxpr_val  1  uint
    field  cat048.i020_dtfact_ep  1  uint
    field  cat048.i020_dtfact_val  1  uint
    pad    1
    fx
    field  cat048.i020_irmxpr_ep  1  uint
    field  cat048.i020_irmxpr_val  1  uint
    field  cat048.i020_irmact_ep  1  uint
    field  cat048.i020_irmact_val  1  uint
    pad    3
    fx
  end
end
if f.4                                   # FRN 4, I048/040 Measured Position in Polar Co-ordinates
  field  cat048.i040_rho  16  uscale:1/256
  field  cat048.i040_theta  16  uscale:45/8192
end
if f.5                                   # FRN 5, I048/070 Mode-3/A Code in Octal Representation
  field  cat048.i070_v  1  uint
  field  cat048.i070_g  1  uint
  field  cat048.i070_l  1  uint
  pad    1
  field  cat048.i070_mode3a  12  uint
end
if f.6                                   # FRN 6, I048/090 Flight Level in Binary Representation
  field  cat048.i090_v  1  uint
  field  cat048.i090_g  1  uint
  field  cat048.i090_fl  14  sscale:1/4
end
if f.7                                   # FRN 7, I048/130 Radar Plot Characteristics
  presence p130 fx
  if p130.1                       # subfield 1, SRL: SSR Plot Runlength
    field  cat048.i130_srl  8  uscale:45/1024
  end
  if p130.2                       # subfield 2, SRR: Number of Received Replies for (M)SSR
    field  cat048.i130_srr  8  uint
  end
  if p130.3                       # subfield 3, SAM: Amplitude of (M)SSR Reply
    field  cat048.i130_sam  8  sscale:1
  end
  if p130.4                       # subfield 4, PRL: Primary Plot Runlength
    field  cat048.i130_prl  8  uscale:45/1024
  end
  if p130.5                       # subfield 5, PAM: Amplitude of Primary Plot
    field  cat048.i130_pam  8  sscale:1
  end
  if p130.6                       # subfield 6, RPD: Difference in Range Between PSR and SSR Plot
    field  cat048.i130_rpd  8  sscale:1/256
  end
  if p130.7                       # subfield 7, APD: Difference in Azimuth Between PSR and SSR Plot
    field  cat048.i130_apd  8  sscale:45/2048
  end
end
if f.8                                   # FRN 8, I048/220 Aircraft Address
  field  cat048.i220  24  uint
end
if f.9                                   # FRN 9, I048/240 Aircraft Identification
  field  cat048.i240  48  uint
end
if f.10                                  # FRN 10, I048/250 BDS Register Data
  group  cat048.i250  count 8
    field  cat048.i250_mbdata  56  uint
    field  cat048.i250_bds1  4  uint
    field  cat048.i250_bds2  4  uint
  end
end
if f.11                                  # FRN 11, I048/161 Track Number
  pad    4
  field  cat048.i161_trn  12  uint
end
if f.12                                  # FRN 12, I048/042 Calculated Position in Cartesian Co-ordinates
  field  cat048.i042_x  16  sscale:1/128
  field  cat048.i042_y  16  sscale:1/128
end
if f.13                                  # FRN 13, I048/200 Calculated Track Velocity in Polar Co-ordinates
  field  speed_ms  16  uscale:463/4096
  field  cat048.i200_hdg  16  uscale:45/8192
end
if f.14                                  # FRN 14, I048/170 Track Status
  chain
    field  cat048.i170_cnf  1  uint
    field  cat048.i170_rad  2  uint
    field  cat048.i170_dou  1  uint
    field  cat048.i170_mah  1  uint
    field  cat048.i170_cdm  2  uint
    fx
    field  cat048.i170_tre  1  uint
    field  cat048.i170_gho  1  uint
    field  cat048.i170_sup  1  uint
    field  cat048.i170_tcc  1  uint
    pad    3
    fx
  end
end
if f.15                                  # FRN 15, I048/210 Track Quality
  field  cat048.i210_sigx  8  uscale:1/128
  field  cat048.i210_sigy  8  uscale:1/128
  field  cat048.i210_sigv  8  uscale:1/16384
  field  cat048.i210_sigh  8  uscale:45/512
end
if f.16                                  # FRN 16, I048/030 Warning/Error Conditions and Target Classification
  group  cat048.i030  fx
    field  cat048.i030_val  7  uint
  end
end
if f.17                                  # FRN 17, I048/080 Mode-3/A Code Confidence Indicator
  pad    4
  field  cat048.i080_qa4  1  uint
  field  cat048.i080_qa2  1  uint
  field  cat048.i080_qa1  1  uint
  field  cat048.i080_qb4  1  uint
  field  cat048.i080_qb2  1  uint
  field  cat048.i080_qb1  1  uint
  field  cat048.i080_qc4  1  uint
  field  cat048.i080_qc2  1  uint
  field  cat048.i080_qc1  1  uint
  field  cat048.i080_qd4  1  uint
  field  cat048.i080_qd2  1  uint
  field  cat048.i080_qd1  1  uint
end
if f.18                                  # FRN 18, I048/100 Mode-C Code and Code Confidence Indicator
  field  cat048.i100_v  1  uint
  field  cat048.i100_g  1  uint
  pad    2
  field  cat048.i100_modec  12  uint
  pad    4
  field  cat048.i100_qc1  1  uint
  field  cat048.i100_qa1  1  uint
  field  cat048.i100_qc2  1  uint
  field  cat048.i100_qa2  1  uint
  field  cat048.i100_qc4  1  uint
  field  cat048.i100_qa4  1  uint
  field  cat048.i100_qb1  1  uint
  field  cat048.i100_qd1  1  uint
  field  cat048.i100_qb2  1  uint
  field  cat048.i100_qd2  1  uint
  field  cat048.i100_qb4  1  uint
  field  cat048.i100_qd4  1  uint
end
if f.19                                  # FRN 19, I048/110 Height Measured by a 3D Radar
  pad    2
  field  cat048.i110_3dh  14  sscale:25
end
if f.20                                  # FRN 20, I048/120 Radial Doppler Speed
  presence p120 fx
  if p120.1                       # subfield 1, CAL: Calculated Doppler Speed
    field  cat048.i120_cal_d  1  uint
    pad    5
    field  cat048.i120_cal_cal  10  sscale:1
  end
  if p120.2                       # subfield 2, RDS: Raw Doppler Speed
    group  cat048.i120_rds  count 8
      field  cat048.i120_rds_dop  16  uscale:1
      field  cat048.i120_rds_amb  16  uscale:1
      field  cat048.i120_rds_frq  16  uscale:1
    end
  end
end
if f.21                                  # FRN 21, I048/230 Communications/ACAS Capability and Flight Status
  field  cat048.i230_com  3  uint
  field  cat048.i230_stat  3  uint
  field  cat048.i230_si  1  uint
  pad    1
  field  cat048.i230_mssc  1  uint
  field  cat048.i230_arc  1  uint
  field  cat048.i230_aic  1  uint
  field  cat048.i230_b1a  1  uint
  field  cat048.i230_b1b  4  uint
end
if f.22                                  # FRN 22, I048/260 ACAS Resolution Advisory Report
  field  cat048.i260  56  uint
end
if f.23                                  # FRN 23, I048/055 Mode-1 Code in Octal Representation
  field  cat048.i055_v  1  uint
  field  cat048.i055_g  1  uint
  field  cat048.i055_l  1  uint
  field  cat048.i055_mode1  5  uint
end
if f.24                                  # FRN 24, I048/050 Mode-2 Code in Octal Representation
  field  cat048.i050_v  1  uint
  field  cat048.i050_g  1  uint
  field  cat048.i050_l  1  uint
  pad    1
  field  cat048.i050_mode2  12  uint
end
if f.25                                  # FRN 25, I048/065 Mode-1 Code Confidence Indicator
  pad    3
  field  cat048.i065_qa4  1  uint
  field  cat048.i065_qa2  1  uint
  field  cat048.i065_qa1  1  uint
  field  cat048.i065_qb2  1  uint
  field  cat048.i065_qb1  1  uint
end
if f.26                                  # FRN 26, I048/060 Mode-2 Code Confidence Indicator
  pad    4
  field  cat048.i060_qa4  1  uint
  field  cat048.i060_qa2  1  uint
  field  cat048.i060_qa1  1  uint
  field  cat048.i060_qb4  1  uint
  field  cat048.i060_qb2  1  uint
  field  cat048.i060_qb1  1  uint
  field  cat048.i060_qc4  1  uint
  field  cat048.i060_qc2  1  uint
  field  cat048.i060_qc1  1  uint
  field  cat048.i060_qd4  1  uint
  field  cat048.i060_qd2  1  uint
  field  cat048.i060_qd1  1  uint
end
if f.27                                  # FRN 27, I048/SP Special Purpose Field
  length 8 bytes plus 1                # the length octet counts itself; the content is not mapped
  end
end
if f.28                                  # FRN 28, I048/RE Reserved Expansion Field
  length 8 bytes plus 1                # the length octet counts itself; the content is not mapped
  end
end
