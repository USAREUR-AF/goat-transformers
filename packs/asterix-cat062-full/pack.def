    field  cat062full.i110_ga_ga  14  sscale:25
  end
  if p110.5                       # subfield 5, EM1: Extended Mode 1 Code in Octal Representation
    pad    4
    field  cat062full.i110_em1_em1  12  uint
  end
  if p110.6                       # subfield 6, TOS: Time Offset for POS and GA
    field  cat062full.i110_tos  8  sscale:1/128
  end
  if p110.7                       # subfield 7, XP: X Pulse Presence
    pad    3
    field  cat062full.i110_xp_x5  1  uint
    field  cat062full.i110_xp_xc  1  uint
    field  cat062full.i110_xp_x3  1  uint
    field  cat062full.i110_xp_x2  1  uint
    field  cat062full.i110_xp_x1  1  uint
  end
end
if f.25                                  # FRN 25, I062/120 Track Mode 2 Code
  pad    4
  field  cat062full.i120_mode2  12  uint
end
if f.26                                  # FRN 26, I062/510 Composed Track Number
  group  cat062full.i510  fx
    field  cat062full.i510_ident  8  uint
    field  cat062full.i510_track  15  uint
  end
end
if f.27                                  # FRN 27, I062/500 Estimated Accuracies
  presence p500 fx
  if p500.1                       # subfield 1, APC: Estimated Accuracy Of Track Position (Cartesian)
    field  cat062full.i500_apc_x  16  uscale:1/2
    field  cat062full.i500_apc_y  16  uscale:1/2
  end
  if p500.2                       # subfield 2, COV: XY Covariance Component
    field  cat062full.i500_cov  16  sscale:1/2
  end
  if p500.3                       # subfield 3, APW: Estimated Accuracy Of Track Position (WGS-84)
    field  cat062full.i500_apw_lat  16  uscale:45/8388608
    field  cat062full.i500_apw_lon  16  uscale:45/8388608
  end
  if p500.4                       # subfield 4, AGA: Estimated Accuracy Of Calculated Track Geometric Altitude
    field  cat062full.i500_aga  8  uscale:25/4
  end
  if p500.5                       # subfield 5, ABA: Estimated Accuracy Of Calculated Track Barometric Altitude
    field  cat062full.i500_aba  8  uscale:1/4
  end
  if p500.6                       # subfield 6, ATV: Estimated Accuracy Of Track Velocity (Cartesian)
    field  cat062full.i500_atv_x  8  uscale:1/4
    field  cat062full.i500_atv_y  8  uscale:1/4
  end
  if p500.7                       # subfield 7, AA: Estimated Accuracy Of Acceleration (Cartesian)
    field  cat062full.i500_aa_x  8  uscale:1/4
    field  cat062full.i500_aa_y  8  uscale:1/4
  end
  if p500.8                       # subfield 8, ARC: Estimated Accuracy Of Rate Of Climb/Descent
    field  cat062full.i500_arc  8  uscale:25/4
  end
end
if f.28                                  # FRN 28, I062/340 Measured Information
  presence p340 fx
  if p340.1                       # subfield 1, SID: Sensor Identification
    field  cat062full.i340_sid_sac  8  uint
    field  cat062full.i340_sid_sic  8  uint
  end
  if p340.2                       # subfield 2, POS: Measured Position
    field  cat062full.i340_pos_rho  16  uscale:1/256
    field  cat062full.i340_pos_theta  16  uscale:45/8192
  end
  if p340.3                       # subfield 3, HEIGHT: Measured 3-D Height
    field  cat062full.i340_height  16  sscale:25
  end
  if p340.4                       # subfield 4, MDC
    field  cat062full.i340_mdc_v  1  uint
    field  cat062full.i340_mdc_g  1  uint
    field  cat062full.i340_mdc_lmc  14  sscale:1/4
  end
  if p340.5                       # subfield 5, MDA
    field  cat062full.i340_mda_v  1  uint
    field  cat062full.i340_mda_g  1  uint
    field  cat062full.i340_mda_l  1  uint
    pad    1
    field  cat062full.i340_mda_mode3a  12  uint
  end
  if p340.6                       # subfield 6, TYP
    field  cat062full.i340_typ_typ  3  uint
    field  cat062full.i340_typ_sim  1  uint
    field  cat062full.i340_typ_rab  1  uint
    field  cat062full.i340_typ_tst  1  uint
    pad    2
  end
end
# FRN 29: spare FRN
# FRN 30: spare FRN
# FRN 31: spare FRN
# FRN 32: spare FRN
# FRN 33: spare FRN
if f.34                                  # FRN 34, I062/RE Reserved Expansion Field
  length 8 bytes plus 1                # the length octet counts itself; the content is not mapped
  end
end
if f.35                                  # FRN 35, I062/SP Special Purpose Field
  length 8 bytes plus 1                # the length octet counts itself; the content is not mapped
  end
end
