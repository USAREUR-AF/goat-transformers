# ASTERIX Category 062, SDPS Track Messages, edition 1.21: one data block holding one record.
# Public. Generated by tools/gen/asterix2pack.py from the category definition of
# github.com/zoranbosnjak/asterix-specs (BSD-3-Clause); do not edit by hand. I/O is hex text.
# Needs engine version 0.8 (`layout sequential`). See pack.md.
#
#   octet 1       CAT = 62
#   octets 2-3    LEN, the length of the data block in octets, CAT and LEN included
#   FSPEC         octets of 7 presence bits and an extension bit; bit n is FRN n
#   then          the items whose FSPEC bit is 1, in FRN order
#
# An FRN with no `if` block is not mapped: a record with that FSPEC bit set fails
# with `malformed-wire` (ruling 1 of engine-spec 0.8), and encode never sets the bit.
format     asterix-cat062-full
version    0.1.0
distribution public
source  "ASTERIX Category 062, SDPS Track Messages, edition 1.21 (2025-06-05), as transcribed in github.com/zoranbosnjak/asterix-specs (BSD-3-Clause), commit 64e9ffba964b92a1af3157bc6bdf7852a63bf700, specs/cat062/cats/cat1.21/definition.json. The category is specified by EUROCONTROL"
uses       track
uses       cat062full
wire       bits
layout     sequential
bit_order  msb
kind    record
when    8  62                              # CAT
length  16 whole                         # LEN
presence f fx
if f.1                                   # FRN 1, I062/010 Data Source Identifier
  field  cat062full.i010_sac  8  uint
  field  cat062full.i010_sic  8  uint
end
# FRN 2: spare FRN
if f.3                                   # FRN 3, I062/015 Service Identification
  field  cat062full.i015  8  uint
end
if f.4                                   # FRN 4, I062/070 Time Of Track Information
  field  cat062full.i070  24  uscale:1/128
end
if f.5                                   # FRN 5, I062/105 Calculated Position In WGS-84 Co-ordinates
  field  lat  32  sscale:45/8388608
  also   cat062full.i105_lat
  field  lon  32  sscale:45/8388608
  also   cat062full.i105_lon
end
if f.6                                   # FRN 6, I062/100 Calculated Track Position (Cartesian)
  field  cat062full.i100_x  24  sscale:1/2
  field  cat062full.i100_y  24  sscale:1/2
end
if f.7                                   # FRN 7, I062/185 Calculated Track Velocity (Cartesian)
  field  track.vel_east_ms  16  sscale:1/4
  also   cat062full.i185_vx
  field  track.vel_north_ms  16  sscale:1/4
  also   cat062full.i185_vy
end
if f.8                                   # FRN 8, I062/210 Calculated Acceleration (Cartesian)
  field  cat062full.i210_ax  8  sscale:1/4
  field  cat062full.i210_ay  8  sscale:1/4
end
if f.9                                   # FRN 9, I062/060 Track Mode 3/A Code
  field  cat062full.i060_v  1  uint
  field  cat062full.i060_g  1  uint
  field  cat062full.i060_ch  1  uint
  pad    1
  field  cat062full.i060_mode3a  12  uint
end
if f.10                                  # FRN 10, I062/245 Target Identification
  field  cat062full.i245_sti  2  uint
  pad    6
  field  callsign  48  chars:icao6
end
if f.11                                  # FRN 11, I062/380 Aircraft Derived Data
  presence p380 fx
  if p380.1                       # subfield 1, ADR: Target Address
    field  cat062full.i380_adr  24  uint
  end
  if p380.2                       # subfield 2, ID: Target Identification
    field  cat062full.i380_id  48  uint
  end
  if p380.3                       # subfield 3, MHG: Magnetic Heading
    field  cat062full.i380_mhg  16  uscale:45/8192
  end
  if p380.4                       # subfield 4, IAS: Indicated Airspeed/Mach No
    field  cat062full.i380_ias_im  1  uint
    field  cat062full.i380_ias_ias  15  uint
  end
  if p380.5                       # subfield 5, TAS: True Airspeed
    field  cat062full.i380_tas  16  uscale:1
  end
  if p380.6                       # subfield 6, SAL: Selected Altitude
    field  cat062full.i380_sal_sas  1  uint
    field  cat062full.i380_sal_src  2  uint
    field  cat062full.i380_sal_alt  13  sscale:25
  end
  if p380.7                       # subfield 7, FSS: Final State Selected Altitude
    field  cat062full.i380_fss_mv  1  uint
    field  cat062full.i380_fss_ah  1  uint
    field  cat062full.i380_fss_am  1  uint
    field  cat062full.i380_fss_alt  13  sscale:25
  end
  if p380.8                       # subfield 8, TIS: Trajectory Intent Status
    chain
      field  cat062full.i380_tis_nav  1  uint
      field  cat062full.i380_tis_nvb  1  uint
      pad    5
      fx
    end
  end
  if p380.9                       # subfield 9, TID: Trajectory Intent Data
    group  cat062full.i380_tid  count 8
      field  cat062full.i380_tid_tca  1  uint
      field  cat062full.i380_tid_nc  1  uint
      field  cat062full.i380_tid_tcpn  6  uint
      field  cat062full.i380_tid_alt  16  sscale:10
      field  cat062full.i380_tid_lat  24  sscale:45/2097152
      field  cat062full.i380_tid_lon  24  sscale:45/2097152
      field  cat062full.i380_tid_pt  4  uint
      field  cat062full.i380_tid_td  2  uint
      field  cat062full.i380_tid_tra  1  uint
      field  cat062full.i380_tid_toa  1  uint
      field  cat062full.i380_tid_tov  24  uscale:1
      field  cat062full.i380_tid_ttr  16  uscale:1/100
    end
  end
  if p380.10                      # subfield 10, COM: Communications/ACAS Capability and Flight Status
    field  cat062full.i380_com_com  3  uint
    field  cat062full.i380_com_stat  3  uint
    pad    2
    field  cat062full.i380_com_ssc  1  uint
    field  cat062full.i380_com_arc  1  uint
    field  cat062full.i380_com_aic  1  uint
    field  cat062full.i380_com_b1a  1  uint
    field  cat062full.i380_com_b1b  4  uint
  end
  if p380.11                      # subfield 11, SAB: Status Reported by ADS-B
    field  cat062full.i380_sab_ac  2  uint
    field  cat062full.i380_sab_mn  2  uint
    field  cat062full.i380_sab_dc  2  uint
    field  cat062full.i380_sab_gbs  1  uint
    pad    6
    field  cat062full.i380_sab_stat  3  uint
  end
  if p380.12                      # subfield 12, ACS: ACAS Resolution Advisory Report
    field  cat062full.i380_acs  56  uint
  end
  if p380.13                      # subfield 13, BVR: Barometric Vertical Rate
    field  cat062full.i380_bvr  16  sscale:25/4
  end
  if p380.14                      # subfield 14, GVR: Geometric Vertical Rate
    field  cat062full.i380_gvr  16  sscale:25/4
  end
  if p380.15                      # subfield 15, RAN: Roll Angle
    field  cat062full.i380_ran  16  sscale:1/100
  end
  if p380.16                      # subfield 16, TAR: Track Angle Rate
    field  cat062full.i380_tar_ti  2  uint
    pad    6
    field  cat062full.i380_tar_rot  7  sscale:1/4
    pad    1
  end
  if p380.17                      # subfield 17, TAN: Track Angle
    field  cat062full.i380_tan  16  uscale:45/8192
  end
  if p380.18                      # subfield 18, GS: Ground Speed
    field  cat062full.i380_gs  16  sscale:1/16384
  end
  if p380.19                      # subfield 19, VUN: Velocity Uncertainty
    field  cat062full.i380_vun  8  uint
  end
  if p380.20                      # subfield 20, MET: Meteorological Data
    field  cat062full.i380_met_ws  1  uint
    field  cat062full.i380_met_wd  1  uint
    field  cat062full.i380_met_tmp  1  uint
    field  cat062full.i380_met_trb  1  uint
    pad    4
    field  cat062full.i380_met_wsd  16  uscale:1
    field  cat062full.i380_met_wdd  16  uscale:1
    field  cat062full.i380_met_tmpd  16  sscale:1/4
    field  cat062full.i380_met_trbd  8  uint
  end
  if p380.21                      # subfield 21, EMC: Emitter Category
    field  cat062full.i380_emc  8  uint
  end
  if p380.22                      # subfield 22, POS: Position
    field  cat062full.i380_pos_lat  24  sscale:45/2097152
    field  cat062full.i380_pos_lon  24  sscale:45/2097152
  end
  if p380.23                      # subfield 23, GAL: Geometric Altitude
    field  cat062full.i380_gal  16  sscale:25/4
  end
  if p380.24                      # subfield 24, PUN: Position Uncertainty
    pad    4
    field  cat062full.i380_pun_pun  4  uint
  end
  if p380.25                      # subfield 25, BDSDATA: BDS Register DATA
    group  cat062full.i380_bdsdata  count 8
      field  cat062full.i380_bdsdata_val  64  uint
    end
  end
  if p380.26                      # subfield 26, IAR: Indicated Airspeed
    field  cat062full.i380_iar  16  uscale:1
  end
  if p380.27                      # subfield 27, MAC: Mach Number
    field  cat062full.i380_mac  16  uscale:1/125
  end
  if p380.28                      # subfield 28, BPS: Barometric Pressure Setting
    pad    4
    field  cat062full.i380_bps_bps  12  uscale:1/10
  end
end
if f.12                                  # FRN 12, I062/040 Track Number
  field  cat062full.i040  16  uint
end
if f.13                                  # FRN 13, I062/080 Track Status
  chain
    field  cat062full.i080_mon  1  uint
    field  cat062full.i080_spi  1  uint
    field  cat062full.i080_mrh  1  uint
    field  cat062full.i080_src  3  uint
    field  cat062full.i080_cnf  1  uint
    fx
    field  cat062full.i080_sim  1  uint
    field  cat062full.i080_tse  1  uint
    field  cat062full.i080_tsb  1  uint
    field  cat062full.i080_fpc  1  uint
    field  cat062full.i080_aff  1  uint
    field  cat062full.i080_stp  1  uint
    field  cat062full.i080_kos  1  uint
    fx
    field  cat062full.i080_ama  1  uint
    field  cat062full.i080_md4  2  uint
    field  cat062full.i080_me  1  uint
    field  cat062full.i080_mi  1  uint
    field  cat062full.i080_md5  2  uint
    fx
    field  cat062full.i080_cst  1  uint
    field  cat062full.i080_psr  1  uint
    field  cat062full.i080_ssr  1  uint
    field  cat062full.i080_mds  1  uint
    field  cat062full.i080_ads  1  uint
    field  cat062full.i080_suc  1  uint
    field  cat062full.i080_aac  1  uint
    fx
    field  cat062full.i080_sds  2  uint
    field  cat062full.i080_ems  3  uint
    field  cat062full.i080_pft  1  uint
    field  cat062full.i080_fplt  1  uint
    fx
    field  cat062full.i080_dupt  1  uint
    field  cat062full.i080_dupf  1  uint
    field  cat062full.i080_dupm  1  uint
    field  cat062full.i080_sfc  1  uint
    field  cat062full.i080_idd  1  uint
    field  cat062full.i080_iec  1  uint
    field  cat062full.i080_mlat  1  uint
