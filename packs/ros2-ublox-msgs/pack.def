# ROS 2 ublox_msgs messages in the JSON form of a rosbridge `publish` operation.
# Generated by tools/gen/ros2msg2pack.py; do not edit by hand.
# One kind per .msg file, selected by the member `type` ("<package>/msg/<Name>").
# The ROS message is the object under `msg`; arrays are groups.
format        ros2-ublox-msgs
version       0.1.0
distribution  public
source        "ROS 2 interface package ublox_msgs, https://github.com/KumarRobotics/ublox ros2 (BSD License (package.xml)) at commit 3a3e1c253722b68e350a60aee6ef399d8c2304cb, directory ublox_msgs/msg; field names, types and array forms only"
source        "rosbridge v2.1.0 Protocol Specification, ROSBRIDGE_PROTOCOL.md, https://github.com/RobotWebTools/rosbridge_suite jazzy at commit cb33a16b890e4b8d9def531326409f3ee6c12537, BSD 3-Clause License; JSON form of a message and of the publish operation"
uses          ros2ublox
wire          json
when   op  publish
field  ros2ublox.topic  topic  string

kind      ack
when      type  ublox_msgs/msg/Ack
requires  ros2ublox.ack_cls_id
field  ros2ublox.ack_cls_id  msg.cls_id  int
field  ros2ublox.ack_msg_id  msg.msg_id  int

