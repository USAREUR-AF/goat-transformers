{
  "name": "x-hnr_pvt-to-geojson",
  "from": "ros2-ublox-msgs",
  "to": "geojson",
  "source": "tools/gen/ros2msg2pack.py: a full sample message with the bound fields set to a point; latitude, longitude and altitude are core lat, lon, hae (pack.md); geojson writes [lon, lat, alt] (RFC 7946, engine-spec 0.1.1 ruling 4)",
  "input": "{\"op\":\"publish\",\"topic\":\"/geo\",\"type\":\"ublox_msgs/msg/HnrPVT\",\"msg\":{\"i_tow\":2147524158,\"year\":48245,\"month\":44,\"day\":99,\"hour\":154,\"min\":209,\"sec\":8,\"valid\":63,\"nano\":364534,\"gps_fix\":173,\"flags\":228,\"lon\":85312500,\"lat\":470625000,\"height\":431500,\"h_msl\":607552,\"g_speed\":648055,\"speed\":688558,\"head_mot\":729061,\"head_veh\":769564,\"h_acc\":2148293715,\"v_acc\":2148334218,\"s_acc\":2148374721,\"head_acc\":2148415224}}",
  "expect": "{\"type\":\"Feature\",\"geometry\":{\"type\":\"Point\",\"coordinates\":[8.53125,47.0625,431.5]},\"properties\":{}}",
  "model": {
    "@kind": "hnr_pvt",
    "lon": "8.53125",
    "lat": "47.0625",
    "hae": "431.5"
  }
