# ROS 2 ackermann_msgs messages in the JSON form of a rosbridge `publish` operation.
# Generated by tools/gen/ros2msg2pack.py; do not edit by hand.
# One kind per .msg file, selected by the member `type` ("<package>/msg/<Name>").
# The ROS message is the object under `msg`; arrays are groups.
format        ros2-ackermann-msgs
version       0.1.0
distribution  public
source        "ROS 2 interface package ackermann_msgs, https://github.com/ros-drivers/ackermann_msgs ros2 (BSD License) at commit 81a5f2d9ae1c1048216678b9dc3db6afc0cb815e, directory msg; field names, types and array forms only"
source        "ROS 2 interface package builtin_interfaces (messages ackermann_msgs refers to), https://github.com/ros2/rcl_interfaces 2.0.4 at commit 7aa3caf43377ea6ad615bc1040832e2c7566bfbe, Apache License 2.0"
source        "ROS 2 interface package std_msgs (messages ackermann_msgs refers to), https://github.com/ros2/common_interfaces 5.3.8 at commit a941f14bb318d8d904505ed935ccbb97f24a70a4, Apache License 2.0"
source        "rosbridge v2.1.0 Protocol Specification, ROSBRIDGE_PROTOCOL.md, https://github.com/RobotWebTools/rosbridge_suite jazzy at commit cb33a16b890e4b8d9def531326409f3ee6c12537, BSD 3-Clause License; JSON form of a message and of the publish operation"
uses          ros2ackermann
wire          json
when   op  publish
field  ros2ackermann.topic  topic  string

kind      ackermann_drive
when      type  ackermann_msgs/msg/AckermannDrive
requires  ros2ackermann.ackermann_drive_steering_angle
field  ros2ackermann.ackermann_drive_steering_angle  msg.steering_angle  float
field  ros2ackermann.ackermann_drive_steering_angle_velocity  msg.steering_angle_velocity  float
field  ros2ackermann.ackermann_drive_speed  msg.speed  float
field  ros2ackermann.ackermann_drive_acceleration  msg.acceleration  float
field  ros2ackermann.ackermann_drive_jerk  msg.jerk  float

kind      ackermann_drive_stamped
when      type  ackermann_msgs/msg/AckermannDriveStamped
requires  ros2ackermann.ackermann_drive_stamped_header_stamp_sec
field  ros2ackermann.ackermann_drive_stamped_header_stamp_sec  msg.header.stamp.sec  int
field  ros2ackermann.ackermann_drive_stamped_header_stamp_nanosec  msg.header.stamp.nanosec  int
field  ros2ackermann.ackermann_drive_stamped_header_frame_id  msg.header.frame_id  string
field  ros2ackermann.ackermann_drive_stamped_drive_steering_angle  msg.drive.steering_angle  float
field  ros2ackermann.ackermann_drive_stamped_drive_steering_angle_velocity  msg.drive.steering_angle_velocity  float
field  ros2ackermann.ackermann_drive_stamped_drive_speed  msg.drive.speed  float
field  ros2ackermann.ackermann_drive_stamped_drive_acceleration  msg.drive.acceleration  float
field  ros2ackermann.ackermann_drive_stamped_drive_jerk  msg.drive.jerk  float
