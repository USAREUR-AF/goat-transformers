# ArduPilot log message OABR as the payload of a DataFlash log record.
# Generated by tools/gen/aplog2pack.py; do not edit by hand.
# The record without its 3-byte header (0xA3 0x95 type-id); fields packed, little-endian.
format        ardupilot-log-oabr
version       0.1.0
distribution  public
source        "ArduPilot log message definitions (log structure tables and Write calls), https://github.com/ArduPilot/ardupilot at tag Copter-4.6.2, commit 1ebd4d996e8b6bbeb1462a9655c00aa861d5beef; message names, format strings, labels, units and multipliers only; GNU General Public License, version 3"
source        "ArduPilot libraries/AP_Logger/LogStructure.h: the format characters, units and multipliers of a log message, at the same commit"
uses          aplog
wire          bits
bit_order     lsb
word_bytes    1
field  aplog.oabr_timeus  0:0:64  uint
field  aplog.oabr_type  0:64:8  uint
field  aplog.oabr_act  0:72:8  uint
field  aplog.oabr_dyaw  0:80:16  uint
field  aplog.oabr_yaw  0:96:16  uint
field  aplog.oabr_dp  0:112:16  uint
field  aplog.oabr_rchg  0:128:8  uint
field  aplog.oabr_mar  0:136:32  f32
field  aplog.oabr_dlt  0:168:32  twos
field  aplog.oabr_dlg  0:200:32  twos
field  aplog.oabr_dalt  0:232:32  twos
field  aplog.oabr_olt  0:264:32  twos
field  aplog.oabr_olg  0:296:32  twos
field  aplog.oabr_oalt  0:328:32  twos
