# CCSDS Unsegmented Time Code (CUC, 301.0-B-4 section 3.2) with an explicit
# one-octet P-field: 1 to 4 octets of basic time units and 0 to 3 octets of binary
# fraction, as P-field bits 4-7 say. Public (CCSDS Blue Book). A message is the
# P-field and the T-field. An extended (two-octet) P-field is not mapped (pack.md).
# Bits are numbered from 0 at the first transmitted bit, most significant bit first.
# The places of the two T-field parts follow from bits 4-5 and 6-7: gate blocks
# (engine-spec 0.17).
format     ccsds-cuc-time
version    0.1.0
distribution public
source     "CCSDS 301.0-B-4 Time Code Formats, Blue Book, November 2010 (Editorial Change 1), https://ccsds.org/Pubs/301x0b4e1.pdf, sections 3.1 and 3.2; reuse with attribution under the CCSDS reproduction permission statement"
uses       ccsdstime
wire       bits
word_bytes 1
bit_order  msb
when   0:0:1  0                                       # P-field extension: none
field  ccsdstime.cuc_coarse_octets    0:4:2   uint
field  ccsdstime.cuc_fine_octets      0:6:2   uint
if  0:4:2  0
  field  ccsdstime.cuc_coarse  0:8:8  uint
  if  0:6:2  1
    field  ccsdstime.cuc_fine  0:16:8  uint
  end
  if  0:6:2  2
    field  ccsdstime.cuc_fine  0:16:16  uint
  end
  if  0:6:2  3
    field  ccsdstime.cuc_fine  0:16:24  uint
  end
end
if  0:4:2  1
  field  ccsdstime.cuc_coarse  0:8:16  uint
  if  0:6:2  1
    field  ccsdstime.cuc_fine  0:24:8  uint
  end
  if  0:6:2  2
    field  ccsdstime.cuc_fine  0:24:16  uint
  end
  if  0:6:2  3
    field  ccsdstime.cuc_fine  0:24:24  uint
  end
end
if  0:4:2  2
  field  ccsdstime.cuc_coarse  0:8:24  uint
  if  0:6:2  1
    field  ccsdstime.cuc_fine  0:32:8  uint
  end
  if  0:6:2  2
    field  ccsdstime.cuc_fine  0:32:16  uint
  end
  if  0:6:2  3
    field  ccsdstime.cuc_fine  0:32:24  uint
  end
end
if  0:4:2  3
  field  ccsdstime.cuc_coarse  0:8:32  uint
  if  0:6:2  1
    field  ccsdstime.cuc_fine  0:40:8  uint
  end
  if  0:6:2  2
    field  ccsdstime.cuc_fine  0:40:16  uint
  end
  if  0:6:2  3
    field  ccsdstime.cuc_fine  0:40:24  uint
  end
end

kind     level-1                                      # time code ID 001: epoch 1958 January 1, TAI
when     0:1:3  1
requires ccsdstime.cuc_coarse

kind     level-2                                      # time code ID 010: agency-defined epoch
when     0:1:3  2
requires ccsdstime.cuc_coarse
