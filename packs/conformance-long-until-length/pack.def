# Conformance probe pack for `until:` inside a `length` extent (spec 0.22,
# rulings 4 and 12). Public. No kinds. Most significant bit first.
#
#   8 bits        the length of the block in bytes
#     x           8 bits
#     label       8-bit characters up to NUL, within the block
#   y             8 bits after the block
format     conformance-long-until-length
version    0.22.0
distribution public
source  "goat-transformers spec/engine-spec.md (synthetic probe format, no external standard)"
uses       probe
wire       bits
layout     sequential
bit_order  msb
length  8
  field  probe.x      8        uint
  field  probe.label  until:0  chars:ascii8
end
field   probe.y      8        uint
