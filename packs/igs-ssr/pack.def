# IGS SSR format v1.00 messages: RTCM 3 message 4076 and its IGS sub-types, one kind per IGS
# message number (7 correction types for each of GPS, GLONASS, Galileo, QZSS, BDS and SBAS, and
# the VTEC header). Generated by tools/gen/igsssr2pack.py; do not edit by hand.
# The message is the body of one RTCM 3 frame: after the 3-octet frame header, before the
# CRC-24Q; most significant bit first, read in sequence.
# Licence: LicenseRef-unstated (the IGS document states no licence; layouts restated).
format        igs-ssr
version       0.1.0
distribution  public
source        "IGS State Space Representation (SSR) Format, Version 1.00, International GNSS Service, 2020-10-05, https://files.igs.org/pub/data/format/igs_ssr_v1.pdf (sha256 2077dde0c87ff45069fd93ba44ee71a50657bddfc003f74f72316af5088f5f6e), chapters 7 and 8; no licence stated: LicenseRef-unstated"
uses          igsssr
wire          bits
layout        sequential
bit_order     msb
# RTCM message number 4076 (IGS proprietary) and the IGS SSR version.
when          12 4076
field         igsssr.version 3 uint

kind          gps-orbit
when          8 21
requires      igsssr.orbit_sats
field         igsssr.epoch_s 20 uint
field         igsssr.update_interval 4 uint
field         igsssr.multiple_message 1 uint
field         igsssr.iod_ssr 4 uint
field         igsssr.provider_id 16 uint
field         igsssr.solution_id 4 uint
field         igsssr.regional_crs 1 uint
group         igsssr.orbit_sats count 6
  field       igsssr.sat_id 6 uint
  field       igsssr.iod 8 uint
  field       igsssr.radial_m 22 sscale:1/10000
  field       igsssr.along_m 20 sscale:1/2500
  field       igsssr.cross_m 20 sscale:1/2500
  field       igsssr.dot_radial_ms 21 sscale:1/1000000
  field       igsssr.dot_along_ms 19 sscale:1/250000
  field       igsssr.dot_cross_ms 19 sscale:1/250000
end

kind          gps-clock
when          8 22
requires      igsssr.clock_sats
field         igsssr.epoch_s 20 uint
field         igsssr.update_interval 4 uint
field         igsssr.multiple_message 1 uint
field         igsssr.iod_ssr 4 uint
field         igsssr.provider_id 16 uint
field         igsssr.solution_id 4 uint
group         igsssr.clock_sats count 6
  field       igsssr.sat_id 6 uint
  field       igsssr.clock_c0_m 22 sscale:1/10000
  field       igsssr.clock_c1_ms 21 sscale:1/1000000
  field       igsssr.clock_c2_mss 27 sscale:1/50000000
end

kind          gps-orbit-clock
when          8 23
