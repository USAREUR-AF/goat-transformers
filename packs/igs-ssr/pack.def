field         igsssr.multiple_message 1 uint
field         igsssr.iod_ssr 4 uint
field         igsssr.provider_id 16 uint
field         igsssr.solution_id 4 uint
group         igsssr.code_bias_sats count 6
  field       igsssr.sat_id 6 uint
  group       igsssr.biases count 5
    field     igsssr.signal_id 5 uint
    field     igsssr.code_bias_m 14 sscale:1/100
  end
end

kind          gps-phase-bias
when          8 26
requires      igsssr.phase_bias_sats
field         igsssr.epoch_s 20 uint
field         igsssr.update_interval 4 uint
field         igsssr.multiple_message 1 uint
field         igsssr.iod_ssr 4 uint
field         igsssr.provider_id 16 uint
field         igsssr.solution_id 4 uint
field         igsssr.dispersive_consistent 1 uint
field         igsssr.mw_consistent 1 uint
group         igsssr.phase_bias_sats count 6
  field       igsssr.sat_id 6 uint
  count       nbias 5
  field       igsssr.yaw_deg 9 uscale:45/64
  field       igsssr.yaw_rate_degs 8 sscale:45/2048
  group       igsssr.biases count @nbias
    field     igsssr.signal_id 5 uint
    field     igsssr.integer_indicator 1 uint
    field     igsssr.widelane_indicator 2 uint
    field     igsssr.discontinuity 4 uint
    field     igsssr.phase_bias_m 20 sscale:1/10000
  end
end

