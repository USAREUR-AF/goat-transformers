# ArduPilot log message FCN as the payload of a DataFlash log record.
# Generated by tools/gen/aplog2pack.py; do not edit by hand.
# The record without its 3-byte header (0xA3 0x95 type-id); fields packed, little-endian.
format        ardupilot-log-fcn
version       0.1.0
distribution  public
source        "ArduPilot log message definitions (log structure tables and Write calls), https://github.com/ArduPilot/ardupilot at tag Copter-4.6.2, commit 1ebd4d996e8b6bbeb1462a9655c00aa861d5beef; message names, format strings, labels, units and multipliers only; GNU General Public License, version 3"
source        "ArduPilot libraries/AP_Logger/LogStructure.h: the format characters, units and multipliers of a log message, at the same commit"
uses          aplog
wire          bits
bit_order     lsb
word_bytes    1
field  aplog.fcn_timeus  0:0:64  uint
field  aplog.fcn_i  0:64:8  uint
field  aplog.fcn_nf  0:72:16  uint
field  aplog.fcn_cf1  0:88:32  f32
field  aplog.fcn_cf2  0:120:32  f32
field  aplog.fcn_cf3  0:152:32  f32
field  aplog.fcn_cf4  0:184:32  f32
field  aplog.fcn_cf5  0:216:32  f32
field  aplog.fcn_cf6  0:248:32  f32
field  aplog.fcn_hf1  0:280:32  f32
field  aplog.fcn_hf2  0:312:32  f32
field  aplog.fcn_hf3  0:344:32  f32
field  aplog.fcn_hf4  0:376:32  f32
field  aplog.fcn_hf5  0:408:32  f32
field  aplog.fcn_hf6  0:440:32  f32
