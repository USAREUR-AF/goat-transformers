# ArduPilot log message CAM as the payload of a DataFlash log record.
# Generated by tools/gen/aplog2pack.py; do not edit by hand.
# The record without its 3-byte header (0xA3 0x95 type-id); fields packed, little-endian.
format        ardupilot-log-cam
version       0.1.0
distribution  public
source        "ArduPilot log message definitions (log structure tables and Write calls), https://github.com/ArduPilot/ardupilot at tag Copter-4.6.2, commit 1ebd4d996e8b6bbeb1462a9655c00aa861d5beef; message names, format strings, labels, units and multipliers only; GNU General Public License, version 3"
source        "ArduPilot libraries/AP_Logger/LogStructure.h: the format characters, units and multipliers of a log message, at the same commit"
uses          aplog
wire          bits
bit_order     lsb
word_bytes    1
field  aplog.cam_timeus  0:0:64  uint
field  aplog.cam_i  0:64:8  uint
field  aplog.cam_img  0:72:16  uint
field  aplog.cam_gpstime  0:88:32  uint
field  aplog.cam_gpsweek  0:120:16  uint
field  lat  0:136:32  sscale:1/10000000
field  lon  0:168:32  sscale:1/10000000
field  aplog.cam_alt  0:200:32  twos
field  aplog.cam_relalt  0:232:32  twos
field  aplog.cam_gpsalt  0:264:32  twos
field  aplog.cam_r  0:296:16  twos
field  aplog.cam_p  0:312:16  twos
field  aplog.cam_y  0:328:16  uint
