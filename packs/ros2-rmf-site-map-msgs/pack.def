# ROS 2 rmf_site_map_msgs messages in the JSON form of a rosbridge `publish` operation.
# Generated by tools/gen/ros2msg2pack.py; do not edit by hand.
# One kind per .msg file, selected by the member `type` ("<package>/msg/<Name>").
# The ROS message is the object under `msg`; arrays are groups.
format        ros2-rmf-site-map-msgs
version       0.1.0
distribution  public
source        "ROS 2 interface package rmf_site_map_msgs, https://github.com/open-rmf/rmf_internal_msgs jazzy (Apache License 2.0) at commit 04585f0e2b0da9f11327fb403d38bc547d648fa6, directory rmf_site_map_msgs/msg; field names, types and array forms only"
source        "rosbridge v2.1.0 Protocol Specification, ROSBRIDGE_PROTOCOL.md, https://github.com/RobotWebTools/rosbridge_suite jazzy at commit cb33a16b890e4b8d9def531326409f3ee6c12537, BSD 3-Clause License; JSON form of a message and of the publish operation"
uses          ros2rmfsitemap
wire          json
when   op  publish
field  ros2rmfsitemap.topic  topic  string

kind      site_map
when      type  rmf_site_map_msgs/msg/SiteMap
requires  ros2rmfsitemap.site_map_encoding
field  ros2rmfsitemap.site_map_encoding  msg.encoding  int
field  ros2rmfsitemap.site_map_data  msg.data  string
