# ArduPilot log message MAG as the payload of a DataFlash log record.
# Generated by tools/gen/aplog2pack.py; do not edit by hand.
# The record without its 3-byte header (0xA3 0x95 type-id); fields packed, little-endian.
format        ardupilot-log-mag
version       0.1.0
distribution  public
source        "ArduPilot log message definitions (log structure tables and Write calls), https://github.com/ArduPilot/ardupilot at tag Copter-4.6.2, commit 1ebd4d996e8b6bbeb1462a9655c00aa861d5beef; message names, format strings, labels, units and multipliers only; GNU General Public License, version 3"
source        "ArduPilot libraries/AP_Logger/LogStructure.h: the format characters, units and multipliers of a log message, at the same commit"
uses          aplog
wire          bits
bit_order     lsb
word_bytes    1
field  aplog.mag_timeus  0:0:64  uint
field  aplog.mag_i  0:64:8  uint
field  aplog.mag_magx  0:72:16  twos
field  aplog.mag_magy  0:88:16  twos
field  aplog.mag_magz  0:104:16  twos
field  aplog.mag_ofsx  0:120:16  twos
field  aplog.mag_ofsy  0:136:16  twos
field  aplog.mag_ofsz  0:152:16  twos
field  aplog.mag_mox  0:168:16  twos
field  aplog.mag_moy  0:184:16  twos
field  aplog.mag_moz  0:200:16  twos
field  aplog.mag_health  0:216:8  uint
field  aplog.mag_s  0:224:32  uint
