# Conformance probe pack used as an inner pack (spec 0.34):
# a kind that reads no bytes. Public.
format     conformance-inner-nonekind
version    0.34.0
distribution public
source  "goat-transformers spec/engine-spec.md (synthetic probe format, no external standard)"
uses       probe
wire       bits
layout     sequential
bit_order  msb
kind only
