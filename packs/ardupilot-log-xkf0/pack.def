# ArduPilot log message XKF0 as the payload of a DataFlash log record.
# Generated by tools/gen/aplog2pack.py; do not edit by hand.
# The record without its 3-byte header (0xA3 0x95 type-id); fields packed, little-endian.
format        ardupilot-log-xkf0
version       0.1.0
distribution  public
source        "ArduPilot log message definitions (log structure tables and Write calls), https://github.com/ArduPilot/ardupilot at tag Copter-4.6.2, commit 1ebd4d996e8b6bbeb1462a9655c00aa861d5beef; message names, format strings, labels, units and multipliers only; GNU General Public License, version 3"
source        "ArduPilot libraries/AP_Logger/LogStructure.h: the format characters, units and multipliers of a log message, at the same commit"
uses          aplog
wire          bits
bit_order     lsb
word_bytes    1
field  aplog.xkf0_timeus  0:0:64  uint
field  aplog.xkf0_c  0:64:8  uint
field  aplog.xkf0_id  0:72:8  uint
field  aplog.xkf0_rng  0:80:16  twos
field  aplog.xkf0_innov  0:96:16  twos
field  aplog.xkf0_siv  0:112:16  uint
field  aplog.xkf0_tr  0:128:16  uint
field  aplog.xkf0_bpn  0:144:16  twos
field  aplog.xkf0_bpe  0:160:16  twos
field  aplog.xkf0_bpd  0:176:16  twos
field  aplog.xkf0_ofh  0:192:16  twos
field  aplog.xkf0_ofl  0:208:16  twos
field  aplog.xkf0_ofn  0:224:16  twos
field  aplog.xkf0_ofe  0:240:16  twos
field  aplog.xkf0_ofd  0:256:16  twos
