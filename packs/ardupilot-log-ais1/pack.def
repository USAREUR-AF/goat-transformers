# ArduPilot log message AIS1 as the payload of a DataFlash log record.
# Generated by tools/gen/aplog2pack.py; do not edit by hand.
# The record without its 3-byte header (0xA3 0x95 type-id); fields packed, little-endian.
format        ardupilot-log-ais1
version       0.1.0
distribution  public
source        "ArduPilot log message definitions (log structure tables and Write calls), https://github.com/ArduPilot/ardupilot at tag Copter-4.6.2, commit 1ebd4d996e8b6bbeb1462a9655c00aa861d5beef; message names, format strings, labels, units and multipliers only; GNU General Public License, version 3"
source        "ArduPilot libraries/AP_Logger/LogStructure.h: the format characters, units and multipliers of a log message, at the same commit"
uses          aplog
wire          bits
bit_order     lsb
word_bytes    1
field  aplog.ais1_us  0:0:64  uint
field  aplog.ais1_typ  0:64:8  uint
field  aplog.ais1_rep  0:72:8  uint
field  aplog.ais1_mmsi  0:80:32  uint
field  aplog.ais1_nav  0:112:8  uint
field  aplog.ais1_rot  0:120:8  twos
field  aplog.ais1_sog  0:128:16  uint
field  aplog.ais1_pos  0:144:8  twos
field  aplog.ais1_lon  0:152:32  twos
field  aplog.ais1_lat  0:184:32  twos
field  aplog.ais1_cog  0:216:16  uint
field  aplog.ais1_hed  0:232:16  uint
field  aplog.ais1_sec  0:248:8  uint
field  aplog.ais1_man  0:256:8  uint
field  aplog.ais1_raim  0:264:8  twos
field  aplog.ais1_rad  0:272:32  uint
