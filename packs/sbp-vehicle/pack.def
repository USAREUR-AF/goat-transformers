# SBP frames of the package swiftnav.sbp.vehicle, one kind per message.
# Generated by tools/gen/sbp2pack.py; do not edit by hand.
# The message is one SBP frame from the preamble through the payload:
# preamble 0x55, message type (u16), sender (u16), length (u8), payload.
# The message carries no CRC: a framer adds and checks it. Payload bit 0 is bit 48.
format        sbp-vehicle
version       0.1.0
distribution  public
source        "https://github.com/swift-nav/libsbp spec/yaml/swiftnav/sbp/vehicle.yaml at v6.5.2 (commit 925825dea5174f069b5d6e23548f213e09f0235c)"
uses          sbp
uses          sbpvehicle
wire          bits
bit_order     lsb
word_bytes    1
when   0:0:8 85
field  sbp.sender 0:24:16 uint

kind      odometry
when      0:8:16 2307
when      0:40:8 9
requires  sbpvehicle.odometry_tow sbpvehicle.odometry_velocity sbpvehicle.odometry_flags
field     sbpvehicle.odometry_tow 0:48:32 uint
field     sbpvehicle.odometry_velocity 0:80:32 twos
field     sbpvehicle.odometry_flags 0:112:8 uint

kind      wheeltick
when      0:8:16 2308
when      0:40:8 14
requires  sbpvehicle.wheeltick_time sbpvehicle.wheeltick_flags sbpvehicle.wheeltick_source
field     sbpvehicle.wheeltick_time 0:48:64 uint
field     sbpvehicle.wheeltick_flags 0:112:8 uint
field     sbpvehicle.wheeltick_source 0:120:8 uint
field     sbpvehicle.wheeltick_ticks 0:128:32 twos
