# MAVLink 2 frames, the messages the dialect AVSSUAS.xml defines itself.
# The included files are read only to check that ids and names are unique.
# Generated by tools/gen/mavlink2pack.py; do not edit by hand.
# One byte-aligned frame addressed by bit offset from the STX byte:
# STX(8) LEN(8) INCOMPAT(8) COMPAT(8) SEQ(8) SYSID(8) COMPID(8) MSGID(24) PAYLOAD CRC(16).
# Payload starts at bit 80. The CRC and a signature are not mapped.
format        mavlink2-avssuas
version       0.1.0
distribution  public
source        "https://github.com/mavlink/mavlink message_definitions/v1.0/AVSSUAS.xml at commit 12c898d88ce18d24e8caf6338596e98c5005bc97"
source        "https://github.com/mavlink/mavlink message_definitions/v1.0/common.xml at commit 12c898d88ce18d24e8caf6338596e98c5005bc97"
source        "https://github.com/mavlink/mavlink message_definitions/v1.0/standard.xml at commit 12c898d88ce18d24e8caf6338596e98c5005bc97"
source        "https://github.com/mavlink/mavlink message_definitions/v1.0/minimal.xml at commit 12c898d88ce18d24e8caf6338596e98c5005bc97"
source        "MAVLink 2 packet format, https://mavlink.io/en/guide/serialization.html"
uses          mavlink
uses          mavlinkavssuas
wire          bits
bit_order     lsb
word_bytes    1
when   0:0:8 253
field  mavlink.seq 0:32:8 uint
field  mavlink.sysid 0:40:8 uint
field  mavlink.compid 0:48:8 uint
field  mavlink.incompat_flags 0:16:8 uint
field  mavlink.compat_flags 0:24:8 uint

kind      avss_prs_sys_status
when      0:56:24 60050
when      0:8:8 14
requires  mavlinkavssuas.time_boot_ms mavlinkavssuas.error_status mavlinkavssuas.battery_status mavlinkavssuas.arm_status mavlinkavssuas.charge_status
field     mavlinkavssuas.time_boot_ms 0:80:32 uint
field     mavlinkavssuas.error_status 0:112:32 uint
field     mavlinkavssuas.battery_status 0:144:32 uint
field     mavlinkavssuas.arm_status 0:176:8 uint
field     mavlinkavssuas.charge_status 0:184:8 uint

kind      avss_drone_position
when      0:56:24 60051
when      0:8:8 24
requires  mavlinkavssuas.time_boot_ms mavlinkavssuas.alt_mm mavlinkavssuas.ground_alt_m mavlinkavssuas.barometer_alt_m
field     mavlinkavssuas.time_boot_ms 0:80:32 uint
field     lat 0:112:32 sscale:1/10000000
field     lon 0:144:32 sscale:1/10000000
field     mavlinkavssuas.alt_mm 0:176:32 twos
field     mavlinkavssuas.ground_alt_m 0:208:32 f32
field     mavlinkavssuas.barometer_alt_m 0:240:32 f32

kind      avss_drone_imu
when      0:56:24 60052
when      0:8:8 44
requires  mavlinkavssuas.q1 mavlinkavssuas.q2 mavlinkavssuas.q3 mavlinkavssuas.q4 mavlinkavssuas.xacc_m_per_s_per_s mavlinkavssuas.yacc_m_per_s_per_s
field     mavlinkavssuas.time_boot_ms 0:80:32 uint
field     mavlinkavssuas.q1 0:112:32 f32
field     mavlinkavssuas.q2 0:144:32 f32
field     mavlinkavssuas.q3 0:176:32 f32
field     mavlinkavssuas.q4 0:208:32 f32
field     mavlinkavssuas.xacc_m_per_s_per_s 0:240:32 f32
field     mavlinkavssuas.yacc_m_per_s_per_s 0:272:32 f32
field     mavlinkavssuas.zacc_m_per_s_per_s 0:304:32 f32
field     mavlinkavssuas.xgyro_rad_per_s 0:336:32 f32
field     mavlinkavssuas.ygyro_rad_per_s 0:368:32 f32
field     mavlinkavssuas.zgyro_rad_per_s 0:400:32 f32

kind      avss_drone_operation_mode
when      0:56:24 60053
when      0:8:8 6
requires  mavlinkavssuas.time_boot_ms mavlinkavssuas.m300_operation_mode mavlinkavssuas.horsefly_operation_mode
field     mavlinkavssuas.time_boot_ms 0:80:32 uint
field     mavlinkavssuas.m300_operation_mode 0:112:8 uint
field     mavlinkavssuas.horsefly_operation_mode 0:120:8 uint
