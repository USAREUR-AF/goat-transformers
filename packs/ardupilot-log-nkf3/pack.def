# ArduPilot log message NKF3 as the payload of a DataFlash log record.
# Generated by tools/gen/aplog2pack.py; do not edit by hand.
# The record without its 3-byte header (0xA3 0x95 type-id); fields packed, little-endian.
format        ardupilot-log-nkf3
version       0.1.0
distribution  public
source        "ArduPilot log message definitions (log structure tables and Write calls), https://github.com/ArduPilot/ardupilot at tag Copter-4.6.2, commit 1ebd4d996e8b6bbeb1462a9655c00aa861d5beef; message names, format strings, labels, units and multipliers only; GNU General Public License, version 3"
source        "ArduPilot libraries/AP_Logger/LogStructure.h: the format characters, units and multipliers of a log message, at the same commit"
uses          aplog
wire          bits
bit_order     lsb
word_bytes    1
field  aplog.nkf3_timeus  0:0:64  uint
field  aplog.nkf3_c  0:64:8  uint
field  aplog.nkf3_ivn  0:72:16  twos
field  aplog.nkf3_ive  0:88:16  twos
field  aplog.nkf3_ivd  0:104:16  twos
field  aplog.nkf3_ipn  0:120:16  twos
field  aplog.nkf3_ipe  0:136:16  twos
field  aplog.nkf3_ipd  0:152:16  twos
field  aplog.nkf3_imx  0:168:16  twos
field  aplog.nkf3_imy  0:184:16  twos
field  aplog.nkf3_imz  0:200:16  twos
field  aplog.nkf3_iyaw  0:216:16  twos
field  aplog.nkf3_ivt  0:232:16  twos
field  aplog.nkf3_rerr  0:248:32  f32
field  aplog.nkf3_ersc  0:280:32  f32
