# ASTERIX Category 025, CNS/ATM Ground System Status Reports, edition 1.6: one data block holding one record.
# Public. Generated by tools/gen/asterix2pack.py from the category definition of
# github.com/zoranbosnjak/asterix-specs (BSD-3-Clause); do not edit by hand. I/O is hex text.
# Needs engine version 0.8 (`layout sequential`). See pack.md.
#
#   octet 1       CAT = 25
#   octets 2-3    LEN, the length of the data block in octets, CAT and LEN included
#   FSPEC         octets of 7 presence bits and an extension bit; bit n is FRN n
#   then          the items whose FSPEC bit is 1, in FRN order
#
# An FRN with no `if` block is not mapped: a record with that FSPEC bit set fails
# with `malformed-wire` (ruling 1 of engine-spec 0.8), and encode never sets the bit.
format     asterix-cat025
version    0.1.0
distribution public
source  "ASTERIX Category 025, CNS/ATM Ground System Status Reports, edition 1.6 (2025-10-22), as transcribed in github.com/zoranbosnjak/asterix-specs (BSD-3-Clause), commit 64e9ffba964b92a1af3157bc6bdf7852a63bf700, specs/cat025/cats/cat1.6/definition.json. The category is specified by EUROCONTROL"
uses       cat025
wire       bits
layout     sequential
bit_order  msb
kind    record
when    8  25                              # CAT
length  16 whole                         # LEN
presence f fx
if f.1                                   # FRN 1, I025/010 Data Source Identifier
  field  cat025.i010_sac  8  uint
  field  cat025.i010_sic  8  uint
end
if f.2                                   # FRN 2, I025/000 Report Type
  field  cat025.i000_rtyp  7  uint
  field  cat025.i000_rg  1  uint
end
if f.3                                   # FRN 3, I025/200 Message Identification
  field  cat025.i200  24  uint
end
if f.4                                   # FRN 4, I025/015 Service Identification
  field  cat025.i015  8  uint
end
if f.5                                   # FRN 5, I025/020 Service Designator
  field  cat025.i020  48  uint
end
if f.6                                   # FRN 6, I025/070 Time of Day
  field  cat025.i070  24  uscale:1/128
end
if f.7                                   # FRN 7, I025/100 System and Service Status
  chain
    field  cat025.i100_nogo  1  uint
    field  cat025.i100_ops  2  uint
    field  cat025.i100_sstat  4  uint
    fx
    pad    1
    field  cat025.i100_systat  3  uint
    field  cat025.i100_sestat  3  uint
    fx
  end
end
if f.8                                   # FRN 8, I025/105 System and Service Error Codes
  group  cat025.i105  count 8
    field  cat025.i105_val  8  uint
  end
end
if f.9                                   # FRN 9, I025/120 Component Status
  group  cat025.i120  count 8
    field  cat025.i120_cid  16  uint
    field  cat025.i120_errc  6  uint
    field  cat025.i120_cs  2  uint
  end
end
if f.10                                  # FRN 10, I025/140 Service Statistics
  group  cat025.i140  count 8
    field  cat025.i140_type  8  uint
    field  cat025.i140_ref  1  uint
    pad    7
    field  cat025.i140_count  32  uint
  end
end
if f.11                                  # FRN 11, I025/SP Special Purpose Field
  length 8 bytes plus 1                # the length octet counts itself; the content is not mapped
  end
end
if f.12                                  # FRN 12, I025/600 Position of the System Reference Point
  field  cat025.i600_lat  32  sscale:45/1073741824
  field  cat025.i600_lon  32  sscale:45/1073741824
end
if f.13                                  # FRN 13, I025/610 Height of the System Reference Point
  field  cat025.i610  16  sscale:1/4
end
