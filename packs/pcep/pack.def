# PCEP message (RFC 5440): the common header and every object, with the bodies of the object
# classes 1 to 15. Public. Written by tools/gen/pcep-pack.py; do not edit by hand. Wire bits,
# layout sequential, msb; I/O is hex text. pack.md states what is mapped.
format        pcep
version       0.1.0
distribution  public
source        "IETF RFC 5440, Path Computation Element (PCE) Communication Protocol (PCEP), March 2009, https://www.rfc-editor.org/rfc/rfc5440.txt (sha256 2b7b7c9d2980aecd8c46637ce5f562d320eb4bb9718f3428d5a582ea2c700ae2); layout restated"
source        "IETF RFC 3209, RSVP-TE, December 2001, section 4.3.3, the subobjects of the route objects, https://www.rfc-editor.org/rfc/rfc3209.txt (sha256 a2ebe64e44c276aa217589950f81c146d4f05a4016ac4a15b0fec7242e304159); layout restated"
uses          pcep
wire          bits
layout        sequential
bit_order     msb

kind    message
when    3  1
field  pcep.message_flags  5  uint
field  pcep.message_type  8  uint
length  16  whole
group  pcep.objects  rest
  field  pcep.object_class  8  uint
  field  pcep.object_type  4  uint
  field  pcep.object_reserved  2  uint
  field  pcep.object_p  1  uint
  field  pcep.object_i  1  uint
  length  16  bytes  plus  4
    switch  pcep.object_class
      case  1                     # OPEN
        field  pcep.open_version  3  uint
        field  pcep.open_flags  5  uint
        field  pcep.keepalive  8  uint
        field  pcep.deadtimer  8  uint
        field  pcep.sid  8  uint
        group  pcep.tlvs  rest
          field  pcep.tlv_type  16  uint
          length  16  bytes
            group  pcep.tlv_value  rest
              field  pcep.octet  8  uint
            end
          end
          align  32
        end
      case  2                     # RP
        field  pcep.rp_flags  26  uint
        field  pcep.rp_o  1  uint
        field  pcep.rp_b  1  uint
        field  pcep.rp_r  1  uint
        field  pcep.rp_priority  3  uint
        field  pcep.request_id  32  uint
        group  pcep.tlvs  rest
          field  pcep.tlv_type  16  uint
          length  16  bytes
            group  pcep.tlv_value  rest
              field  pcep.octet  8  uint
            end
          end
          align  32
        end
      case  3                     # NO-PATH
        field  pcep.nature_of_issue  8  uint
        field  pcep.no_path_c  1  uint
        field  pcep.no_path_flags  15  uint
        pad  8
        group  pcep.tlvs  rest
          field  pcep.tlv_type  16  uint
          length  16  bytes
            group  pcep.tlv_value  rest
              field  pcep.octet  8  uint
            end
          end
          align  32
        end
      case  4                     # END-POINTS
        switch  pcep.object_type
          case  1
            field  pcep.source_ipv4  32  uint
            field  pcep.destination_ipv4  32  uint
          case  2
            field  pcep.source_ipv6_high  64  uint
            field  pcep.source_ipv6_low  64  uint
            field  pcep.destination_ipv6_high  64  uint
            field  pcep.destination_ipv6_low  64  uint
          else
            group  pcep.body_octets  rest
              field  pcep.octet  8  uint
            end
        end
      case  5                     # BANDWIDTH
        field  pcep.bandwidth  32  f32
      case  6                     # METRIC
        pad  16
        field  pcep.metric_flags  6  uint
        field  pcep.metric_c  1  uint
        field  pcep.metric_b  1  uint
        field  pcep.metric_type  8  uint
        field  pcep.metric_value  32  f32
      case  7                     # ERO
        group  pcep.ero  rest
          field  pcep.sub_l  1  uint
          field  pcep.sub_type  7  uint
          length  8  bytes  plus  2
            switch  pcep.sub_type
              case  1
                field  pcep.sub_ipv4  32  uint
                field  pcep.sub_prefix_length  8  uint
                field  pcep.sub_flags  8  uint
              case  2
                field  pcep.sub_ipv6_high  64  uint
                field  pcep.sub_ipv6_low  64  uint
                field  pcep.sub_prefix_length  8  uint
                field  pcep.sub_flags  8  uint
              case  32
                field  pcep.sub_asn  16  uint
              else
                group  pcep.sub_value  rest
                  field  pcep.octet  8  uint
                end
            end
          end
        end
      case  8                     # RRO
        group  pcep.rro  rest
          field  pcep.sub_l  1  uint
          field  pcep.sub_type  7  uint
          length  8  bytes  plus  2
            switch  pcep.sub_type
              case  1
                field  pcep.sub_ipv4  32  uint
                field  pcep.sub_prefix_length  8  uint
                field  pcep.sub_flags  8  uint
              case  2
                field  pcep.sub_ipv6_high  64  uint
                field  pcep.sub_ipv6_low  64  uint
                field  pcep.sub_prefix_length  8  uint
                field  pcep.sub_flags  8  uint
              case  32
                field  pcep.sub_asn  16  uint
              else
                group  pcep.sub_value  rest
                  field  pcep.octet  8  uint
                end
            end
          end
        end
      case  9                     # LSPA
        field  pcep.exclude_any  32  uint
        field  pcep.include_any  32  uint
        field  pcep.include_all  32  uint
        field  pcep.setup_priority  8  uint
        field  pcep.holding_priority  8  uint
        field  pcep.lspa_flags  7  uint
        field  pcep.lspa_l  1  uint
        pad  8
        group  pcep.tlvs  rest
          field  pcep.tlv_type  16  uint
          length  16  bytes
            group  pcep.tlv_value  rest
              field  pcep.octet  8  uint
            end
          end
          align  32
        end
      case  10                    # IRO
        group  pcep.iro  rest
          field  pcep.sub_l  1  uint
          field  pcep.sub_type  7  uint
          length  8  bytes  plus  2
            switch  pcep.sub_type
              case  1
                field  pcep.sub_ipv4  32  uint
                field  pcep.sub_prefix_length  8  uint
                field  pcep.sub_flags  8  uint
              case  2
                field  pcep.sub_ipv6_high  64  uint
                field  pcep.sub_ipv6_low  64  uint
                field  pcep.sub_prefix_length  8  uint
                field  pcep.sub_flags  8  uint
              case  32
                field  pcep.sub_asn  16  uint
              else
                group  pcep.sub_value  rest
                  field  pcep.octet  8  uint
                end
            end
          end
        end
      case  11                    # SVEC
        pad  8
        field  pcep.svec_flags  21  uint
        field  pcep.svec_s  1  uint
        field  pcep.svec_n  1  uint
        field  pcep.svec_l  1  uint
        group  pcep.svec_request_ids  rest
          field  pcep.svec_request_id  32  uint
        end
      case  12                    # NOTIFICATION
        pad  8
        field  pcep.notification_flags  8  uint
        field  pcep.notification_type  8  uint
        field  pcep.notification_value  8  uint
        group  pcep.tlvs  rest
          field  pcep.tlv_type  16  uint
          length  16  bytes
            group  pcep.tlv_value  rest
              field  pcep.octet  8  uint
            end
          end
          align  32
        end
      case  13                    # PCEP-ERROR
        pad  8
        field  pcep.error_flags  8  uint
        field  pcep.error_type  8  uint
        field  pcep.error_value  8  uint
        group  pcep.tlvs  rest
          field  pcep.tlv_type  16  uint
          length  16  bytes
            group  pcep.tlv_value  rest
              field  pcep.octet  8  uint
            end
          end
          align  32
        end
      case  14                    # LOAD-BALANCING
        pad  16
        field  pcep.lb_flags  8  uint
        field  pcep.max_lsp  8  uint
        field  pcep.min_bandwidth  32  f32
      case  15                    # CLOSE
        pad  16
        field  pcep.close_flags  8  uint
        field  pcep.close_reason  8  uint
        group  pcep.tlvs  rest
          field  pcep.tlv_type  16  uint
          length  16  bytes
            group  pcep.tlv_value  rest
              field  pcep.octet  8  uint
            end
          end
          align  32
        end
      else
        group  pcep.body_octets  rest
          field  pcep.octet  8  uint
        end
    end
  end
end
