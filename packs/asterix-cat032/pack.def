# ASTERIX Category 032, Miniplan Reports to an SDPS, edition 1.2: one data block holding one record.
# Public. Generated by tools/gen/asterix2pack.py from the category definition of
# github.com/zoranbosnjak/asterix-specs (BSD-3-Clause); do not edit by hand. I/O is hex text.
# Needs engine version 0.8 (`layout sequential`). See pack.md.
#
#   octet 1       CAT = 32
#   octets 2-3    LEN, the length of the data block in octets, CAT and LEN included
#   FSPEC         octets of 7 presence bits and an extension bit; bit n is FRN n
#   then          the items whose FSPEC bit is 1, in FRN order
#
# An FRN with no `if` block is not mapped: a record with that FSPEC bit set fails
# with `malformed-wire` (ruling 1 of engine-spec 0.8), and encode never sets the bit.
format     asterix-cat032
version    0.1.0
distribution public
source  "ASTERIX Category 032, Miniplan Reports to an SDPS, edition 1.2 (2025-06-05), as transcribed in github.com/zoranbosnjak/asterix-specs (BSD-3-Clause), commit 64e9ffba964b92a1af3157bc6bdf7852a63bf700, specs/cat032/cats/cat1.2/definition.json. The category is specified by EUROCONTROL"
uses       cat032
wire       bits
layout     sequential
bit_order  msb
kind    record
when    8  32                              # CAT
length  16 whole                         # LEN
presence f fx
if f.1                                   # FRN 1, I032/010 Server Identification Tag
  field  cat032.i010_sac  8  uint
  field  cat032.i010_sic  8  uint
end
if f.2                                   # FRN 2, I032/015 User Number
  field  cat032.i015  16  uint
end
if f.3                                   # FRN 3, I032/018 Data Source Identification Tag
  field  cat032.i018_sac  8  uint
  field  cat032.i018_sic  8  uint
end
if f.4                                   # FRN 4, I032/035 Type of Message
  field  cat032.i035_family  4  uint
  field  cat032.i035_nature  4  uint
end
if f.5                                   # FRN 5, I032/020 Time of ASTERIX Report Generation
  field  cat032.i020  24  uscale:1/128
end
if f.6                                   # FRN 6, I032/040 Track Number
  field  cat032.i040  16  uint
end
if f.7                                   # FRN 7, I032/050 Composed Track Number
  chain
    field  cat032.i050_sui  8  uint
    field  cat032.i050_stn  15  uint
    fx
  end
end
if f.8                                   # FRN 8, I032/060 Track Mode 3/A
  pad    4
  field  cat032.i060_mode3a  12  uint
end
if f.9                                   # FRN 9, I032/400 Callsign
  field  cat032.i400  56  ascii
end
if f.10                                  # FRN 10, I032/410 Plan Number
  field  cat032.i410  16  uint
end
if f.11                                  # FRN 11, I032/420 Flight Category
  field  cat032.i420_gatoat  2  uint
  field  cat032.i420_fr1fr2  2  uint
  field  cat032.i420_sp3  1  uint
  field  cat032.i420_sp2  1  uint
  field  cat032.i420_sp1  1  uint
  pad    1
end
if f.12                                  # FRN 12, I032/440 Departure Aerodrome
  field  cat032.i440  32  ascii
end
if f.13                                  # FRN 13, I032/450 Destination Aerodrome
  field  cat032.i450  32  ascii
end
if f.14                                  # FRN 14, I032/480 Current Cleared Flight Level
  field  cat032.i480  16  uscale:1/4
end
if f.15                                  # FRN 15, I032/490 Current Control Position
  field  cat032.i490_cen  8  uint
  field  cat032.i490_pos  8  uint
end
if f.16                                  # FRN 16, I032/430 Type of Aircraft
  field  cat032.i430  32  ascii
end
if f.17                                  # FRN 17, I032/435 Wake Turbulence Category
  field  cat032.i435  8  uint
end
if f.18                                  # FRN 18, I032/460 Allocated SSR Codes
  group  cat032.i460  count 8
    pad    4
    field  cat032.i460_oct1  3  uint
    field  cat032.i460_oct2  3  uint
    field  cat032.i460_oct3  3  uint
    field  cat032.i460_oct4  3  uint
  end
end
if f.19                                  # FRN 19, I032/500 Supplementary Flight Data
  presence p500 fx
  if p500.1                       # subfield 1, IFI: IFPS FLIGHT ID
    field  cat032.i500_ifi_typ  2  uint
    pad    3
    field  cat032.i500_ifi_nbr  27  uint
  end
  if p500.2                       # subfield 2, RVP: RVSM & Flight Priority
    pad    5
    field  cat032.i500_rvp_rvsm  2  uint
    field  cat032.i500_rvp_hpr  1  uint
  end
  if p500.3                       # subfield 3, RDS: Runway Designation
    field  cat032.i500_rds_nu1  8  ascii
    field  cat032.i500_rds_nu2  8  ascii
    field  cat032.i500_rds_ltr  8  ascii
  end
  if p500.4                       # subfield 4, TOD: Time of Departure / Arrival
    group  cat032.i500_tod  count 8
      field  cat032.i500_tod_typ  5  uint
      field  cat032.i500_tod_day  2  uint
      pad    4
      field  cat032.i500_tod_hor  5  uint
      pad    2
      field  cat032.i500_tod_min  6  uint
      field  cat032.i500_tod_avs  1  uint
      pad    1
      field  cat032.i500_tod_sec  6  uint
    end
  end
  if p500.5                       # subfield 5, AST: Aircraft Stand
    field  cat032.i500_ast  48  ascii
  end
  if p500.6                       # subfield 6, STS: Stand Status
    field  cat032.i500_sts_emp  2  uint
    field  cat032.i500_sts_avl  2  uint
    pad    4
  end
  if p500.7                       # subfield 7, SID: Standard Instrument Departure
    field  cat032.i500_sid  56  ascii
  end
  if p500.8                       # subfield 8, STAR: Standard Instrument Arrival
    field  cat032.i500_star  56  ascii
  end
end
# FRN 20: spare FRN
if f.21                                  # FRN 21, I032/RE Reserved Expansion Field
  length 8 bytes plus 1                # the length octet counts itself; the content is not mapped
  end
end
