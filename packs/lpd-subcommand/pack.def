# LPD receive-job subcommand (RFC 1179 section 6): a binary code, the byte count and file name, LF. Written by
# tools/gen/printing-pack.py; do not edit by hand.
format        lpd-subcommand
version       0.1.0
distribution  public
source        "IETF RFC 1179, Line Printer Daemon Protocol, August 1990, sections 3.1 and 5-7, https://www.rfc-editor.org/rfc/rfc1179.txt; layout restated"
uses          lpd
wire          bits
layout        sequential
bit_order     msb

kind  receive-control-file
when  8  2  as  lpd.subcommand_code
requires  lpd.byte_count  lpd.file_name
field  lpd.byte_count  until:32  chars:ascii8
field  lpd.file_name  until:10  chars:ascii8

kind  receive-data-file
when  8  3  as  lpd.subcommand_code
requires  lpd.byte_count  lpd.file_name
field  lpd.byte_count  until:32  chars:ascii8
field  lpd.file_name  until:10  chars:ascii8

kind  abort-job
when  8  1  as  lpd.subcommand_code
const  8  10
