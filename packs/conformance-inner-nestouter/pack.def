# Conformance probe pack whose own nested list is also its inner pack's (spec
# 0.34 ruling 22). Public. No kinds.
format     conformance-inner-nestouter
version    0.34.0
distribution public
source  "goat-transformers spec/engine-spec.md (synthetic probe format, no external standard)"
uses       probe
wire       bits
layout     sequential
bit_order  msb
group   probe.items count 8
  group  probe.subs count 8
    field  probe.val  8  uint
  end
end
inner   conformance-inner-nest
