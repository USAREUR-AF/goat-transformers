# ArduPilot log message FTN1 as the payload of a DataFlash log record.
# Generated by tools/gen/aplog2pack.py; do not edit by hand.
# The record without its 3-byte header (0xA3 0x95 type-id); fields packed, little-endian.
format        ardupilot-log-ftn1
version       0.1.0
distribution  public
source        "ArduPilot log message definitions (log structure tables and Write calls), https://github.com/ArduPilot/ardupilot at tag Copter-4.6.2, commit 1ebd4d996e8b6bbeb1462a9655c00aa861d5beef; message names, format strings, labels, units and multipliers only; GNU General Public License, version 3"
source        "ArduPilot libraries/AP_Logger/LogStructure.h: the format characters, units and multipliers of a log message, at the same commit"
uses          aplog
wire          bits
bit_order     lsb
word_bytes    1
field  aplog.ftn1_timeus  0:0:64  uint
field  aplog.ftn1_pkavg  0:64:32  f32
field  aplog.ftn1_bwavg  0:96:32  f32
field  aplog.ftn1_snx  0:128:32  f32
field  aplog.ftn1_sny  0:160:32  f32
field  aplog.ftn1_snz  0:192:32  f32
field  aplog.ftn1_ftx  0:224:32  f32
field  aplog.ftn1_fty  0:256:32  f32
field  aplog.ftn1_ftz  0:288:32  f32
field  aplog.ftn1_fhx  0:320:8  uint
field  aplog.ftn1_fhy  0:328:8  uint
field  aplog.ftn1_fhz  0:336:8  uint
field  aplog.ftn1_tc  0:344:32  uint
