# Conformance probe pack whose own list is read after the inner list of the
# same name (spec 0.34 ruling 21). Public. No kinds.
format     conformance-inner-namesafter
version    0.34.0
distribution public
source  "goat-transformers spec/engine-spec.md (synthetic probe format, no external standard)"
uses       probe
wire       bits
layout     sequential
bit_order  msb
length 8
  inner  conformance-inner-names
end
group   probe.names rest
  field  probe.tag  8  ascii
end
