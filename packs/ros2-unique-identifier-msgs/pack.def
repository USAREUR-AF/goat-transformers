# ROS 2 unique_identifier_msgs messages in the JSON form of a rosbridge `publish` operation.
# Generated by tools/gen/ros2msg2pack.py; do not edit by hand.
# One kind per .msg file, selected by the member `type` ("<package>/msg/<Name>").
# The ROS message is the object under `msg`; arrays are groups.
format        ros2-unique-identifier-msgs
version       0.1.0
distribution  public
source        "ROS 2 interface package unique_identifier_msgs, https://github.com/ros2/unique_identifier_msgs jazzy (BSD 3-Clause License) at commit 901599ee92c2ee949f42a5c5d821c92b3e515d69, directory msg; field names, types and array forms only"
source        "rosbridge v2.1.0 Protocol Specification, ROSBRIDGE_PROTOCOL.md, https://github.com/RobotWebTools/rosbridge_suite jazzy at commit cb33a16b890e4b8d9def531326409f3ee6c12537, BSD 3-Clause License; JSON form of a message and of the publish operation"
uses          ros2uuid
wire          json
when   op  publish
field  ros2uuid.topic  topic  string

kind      uuid
when      type  unique_identifier_msgs/msg/UUID
requires  ros2uuid.uuid_uuid
field  ros2uuid.uuid_uuid  msg.uuid  string
