# ASTERIX Category 205, Radio Direction Finder Reports, edition 1.0: one data block holding one record.
# Public. Generated by tools/gen/asterix2pack.py from the category definition of
# github.com/zoranbosnjak/asterix-specs (BSD-3-Clause); do not edit by hand. I/O is hex text.
# Needs engine version 0.8 (`layout sequential`). See pack.md.
#
#   octet 1       CAT = 205
#   octets 2-3    LEN, the length of the data block in octets, CAT and LEN included
#   FSPEC         octets of 7 presence bits and an extension bit; bit n is FRN n
#   then          the items whose FSPEC bit is 1, in FRN order
#
# An FRN with no `if` block is not mapped: a record with that FSPEC bit set fails
# with `malformed-wire` (ruling 1 of engine-spec 0.8), and encode never sets the bit.
format     asterix-cat205
version    0.1.0
distribution public
source  "ASTERIX Category 205, Radio Direction Finder Reports, edition 1.0 (2020-03-17), as transcribed in github.com/zoranbosnjak/asterix-specs (BSD-3-Clause), commit 64e9ffba964b92a1af3157bc6bdf7852a63bf700, specs/cat205/cats/cat1.0/definition.json. The category is specified by EUROCONTROL"
uses       cat205
wire       bits
layout     sequential
bit_order  msb
kind    record
when    8  205                              # CAT
length  16 whole                         # LEN
presence f fx
if f.1                                   # FRN 1, I205/010 Data Source Identifier
  field  cat205.i010_sac  8  uint
  field  cat205.i010_sic  8  uint
end
if f.2                                   # FRN 2, I205/015 Service Identification
  field  cat205.i015  8  uint
end
if f.3                                   # FRN 3, I205/000 Message Type
  field  cat205.i000  8  uint
end
if f.4                                   # FRN 4, I205/030 Time of Day
  field  cat205.i030  24  uscale:1/128
end
if f.5                                   # FRN 5, I205/040 Report Number
  field  cat205.i040  8  uint
end
if f.6                                   # FRN 6, I205/090 Radio Channel Name
  field  cat205.i090  56  ascii
end
if f.7                                   # FRN 7, I205/050 Position in WGS-84 Coordinates
  field  cat205.i050_lat  32  sscale:45/8388608
  field  cat205.i050_lon  32  sscale:45/8388608
end
if f.8                                   # FRN 8, I205/060 Position in Cartesian Coordinates
  field  cat205.i060_x  24  sscale:1/2
  field  cat205.i060_y  24  sscale:1/2
end
if f.9                                   # FRN 9, I205/070 Local Bearing
  field  cat205.i070  16  uscale:1/100
end
if f.10                                  # FRN 10, I205/080 System Bearing
  field  cat205.i080  16  uscale:1/100
end
if f.11                                  # FRN 11, I205/100 Quality of Measurement
  field  cat205.i100  8  uint
end
if f.12                                  # FRN 12, I205/110 Estimated Uncertainty
  field  cat205.i110  8  uscale:100
end
if f.13                                  # FRN 13, I205/120 Contributing Sensors
  group  cat205.i120  count 8
    field  cat205.i120_val  8  uint
  end
end
if f.14                                  # FRN 14, I205/130 Conflicting Transmitter Position in WGS-84 Coordinates
  field  cat205.i130_lat  32  sscale:45/8388608
  field  cat205.i130_lon  32  sscale:45/8388608
end
if f.15                                  # FRN 15, I205/140 Conflicting Transmitter Position in Cartesian Coordinates
  field  cat205.i140_x  24  sscale:1/2
  field  cat205.i140_y  24  sscale:1/2
end
if f.16                                  # FRN 16, I205/150 Conflicting Transmitter Estimated Uncertainty
  field  cat205.i150  8  uscale:100
end
if f.17                                  # FRN 17, I205/160 Track Number
  field  cat205.i160  16  uint
end
if f.18                                  # FRN 18, I205/170 Sensor Identification
  field  cat205.i170  8  uint
end
if f.19                                  # FRN 19, I205/180 Signal Level
  field  cat205.i180  16  sscale:1/100
end
if f.20                                  # FRN 20, I205/190 Signal Quality
  field  cat205.i190  8  uint
end
if f.21                                  # FRN 21, I205/200 Signal Elevation
  field  cat205.i200  16  sscale:1/100
end
if f.22                                  # FRN 22, I205/SP Special Purpose Field
  length 8 bytes plus 1                # the length octet counts itself; the content is not mapped
  end
end
