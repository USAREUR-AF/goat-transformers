field  ros2autowarecontrol.control_longitudinal_acceleration  msg.longitudinal.acceleration  float
field  ros2autowarecontrol.control_longitudinal_jerk  msg.longitudinal.jerk  float
field  ros2autowarecontrol.control_longitudinal_is_defined_acceleration  msg.longitudinal.is_defined_acceleration  bool
field  ros2autowarecontrol.control_longitudinal_is_defined_jerk  msg.longitudinal.is_defined_jerk  bool

