field  ros2autowarecontrol.control_lateral_steering_tire_angle  msg.lateral.steering_tire_angle  float
field  ros2autowarecontrol.control_lateral_steering_tire_rotation_rate  msg.lateral.steering_tire_rotation_rate  float
