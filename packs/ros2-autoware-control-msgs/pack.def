# ROS 2 autoware_control_msgs messages in the JSON form of a rosbridge `publish` operation.
# Generated by tools/gen/ros2msg2pack.py; do not edit by hand.
# One kind per .msg file, selected by the member `type` ("<package>/msg/<Name>").
# The ROS message is the object under `msg`; arrays are groups.
format        ros2-autoware-control-msgs
version       0.1.0
distribution  public
source        "ROS 2 interface package autoware_control_msgs, https://github.com/autowarefoundation/autoware_msgs main (Apache License 2.0) at commit 26b4627ef08c55d8dee1103395594bfb803f7111, directory autoware_control_msgs/msg; field names, types and array forms only"
source        "ROS 2 interface package builtin_interfaces (messages autoware_control_msgs refers to), https://github.com/ros2/rcl_interfaces 2.0.4 at commit 7aa3caf43377ea6ad615bc1040832e2c7566bfbe, Apache License 2.0"
