# ASTERIX Category 008, Monoradar Derived Weather Information, edition 1.3: one data block holding one record.
# Public. Generated by tools/gen/asterix2pack.py from the category definition of
# github.com/zoranbosnjak/asterix-specs (BSD-3-Clause); do not edit by hand. I/O is hex text.
# Needs engine version 0.8 (`layout sequential`). See pack.md.
#
#   octet 1       CAT = 8
#   octets 2-3    LEN, the length of the data block in octets, CAT and LEN included
#   FSPEC         octets of 7 presence bits and an extension bit; bit n is FRN n
#   then          the items whose FSPEC bit is 1, in FRN order
#
# An FRN with no `if` block is not mapped: a record with that FSPEC bit set fails
# with `malformed-wire` (ruling 1 of engine-spec 0.8), and encode never sets the bit.
format     asterix-cat008
version    0.1.0
distribution public
source  "ASTERIX Category 008, Monoradar Derived Weather Information, edition 1.3 (2021-04-01), as transcribed in github.com/zoranbosnjak/asterix-specs (BSD-3-Clause), commit 64e9ffba964b92a1af3157bc6bdf7852a63bf700, specs/cat008/cats/cat1.3/definition.json. The category is specified by EUROCONTROL"
uses       cat008
wire       bits
layout     sequential
bit_order  msb
kind    record
when    8  8                              # CAT
length  16 whole                         # LEN
presence f fx
if f.1                                   # FRN 1, I008/010 Data Source Identifier
  field  cat008.i010_sac  8  uint
  field  cat008.i010_sic  8  uint
end
if f.2                                   # FRN 2, I008/000 Message Type
  field  cat008.i000  8  uint
end
if f.3                                   # FRN 3, I008/020 Vector Qualifier
  chain
    field  cat008.i020_org  1  uint
    field  cat008.i020_i  3  uint
    field  cat008.i020_s  3  uint
    fx
    pad    5
    field  cat008.i020_tst  1  uint
    field  cat008.i020_er  1  uint
    fx
  end
end
if f.4                                   # FRN 4, I008/036 Sequence of Cartesian Vectors in SPF Notation
  group  cat008.i036  count 8
    field  cat008.i036_x  8  twos
    field  cat008.i036_y  8  twos
    field  cat008.i036_length  8  uint
  end
end
if f.5                                   # FRN 5, I008/034 Sequence of Polar Vectors in SPF Notation
  group  cat008.i034  count 8
    field  cat008.i034_str  8  uint
    field  cat008.i034_endr  8  uint
    field  cat008.i034_az  16  uscale:45/8192
  end
end
if f.6                                   # FRN 6, I008/040 Contour Identifier
  field  cat008.i040_org  1  uint
  field  cat008.i040_i  3  uint
  pad    2
  field  cat008.i040_fstlst  2  uint
  field  cat008.i040_csn  8  uint
end
if f.7                                   # FRN 7, I008/050 Sequence of Contour Points in SPF Notation
  group  cat008.i050  count 8
    field  cat008.i050_x1  8  twos
    field  cat008.i050_y1  8  twos
  end
end
if f.8                                   # FRN 8, I008/090 Time of Day
  field  cat008.i090  24  uscale:1/128
end
if f.9                                   # FRN 9, I008/100 Processing Status
  chain
    field  cat008.i100_f  5  twos
    field  cat008.i100_r  3  uint
    field  cat008.i100_q  15  uint
    fx
  end
end
if f.10                                  # FRN 10, I008/110 Station Configuration Status
  group  cat008.i110  fx
    field  cat008.i110_val  7  uint
  end
end
if f.11                                  # FRN 11, I008/120 Total Number of Items Constituting One Weather Picture
  field  cat008.i120  16  uint
end
if f.12                                  # FRN 12, I008/038 Sequence of Weather Vectors in SPF Notation
  group  cat008.i038  count 8
    field  cat008.i038_x1  8  twos
    field  cat008.i038_y1  8  twos
    field  cat008.i038_x2  8  twos
    field  cat008.i038_y2  8  twos
  end
end
if f.13                                  # FRN 13, I008/SP Special Purpose Field
  length 8 bytes plus 1                # the length octet counts itself; the content is not mapped
  end
end
# FRN 14: random field sequencing: the items that follow name themselves by FRN, in any order
