# ROS 2 rtcm_msgs messages in the JSON form of a rosbridge `publish` operation.
# Generated by tools/gen/ros2msg2pack.py; do not edit by hand.
# One kind per .msg file, selected by the member `type` ("<package>/msg/<Name>").
# The ROS message is the object under `msg`; arrays are groups.
format        ros2-rtcm-msgs
version       0.1.0
distribution  public
source        "ROS 2 interface package rtcm_msgs, https://github.com/tilk/rtcm_msgs master (BSD 3-Clause License) at commit 8d27ab5f4d4a581e1bb9c87d572994c25197f6d4, directory msg; field names, types and array forms only"
source        "ROS 2 interface package builtin_interfaces (messages rtcm_msgs refers to), https://github.com/ros2/rcl_interfaces 2.0.4 at commit 7aa3caf43377ea6ad615bc1040832e2c7566bfbe, Apache License 2.0"
source        "ROS 2 interface package std_msgs (messages rtcm_msgs refers to), https://github.com/ros2/common_interfaces 5.3.8 at commit a941f14bb318d8d904505ed935ccbb97f24a70a4, Apache License 2.0"
source        "rosbridge v2.1.0 Protocol Specification, ROSBRIDGE_PROTOCOL.md, https://github.com/RobotWebTools/rosbridge_suite jazzy at commit cb33a16b890e4b8d9def531326409f3ee6c12537, BSD 3-Clause License; JSON form of a message and of the publish operation"
uses          ros2rtcm
wire          json
when   op  publish
field  ros2rtcm.topic  topic  string

kind      message
when      type  rtcm_msgs/msg/Message
requires  ros2rtcm.message_header_stamp_sec
field  ros2rtcm.message_header_stamp_sec  msg.header.stamp.sec  int
field  ros2rtcm.message_header_stamp_nanosec  msg.header.stamp.nanosec  int
field  ros2rtcm.message_header_frame_id  msg.header.frame_id  string
field  ros2rtcm.message_message  msg.message  string
