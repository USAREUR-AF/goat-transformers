  end
  if  dwell_mask.17
    field  gmti.sensor_track_unc_deg  8  uint
  end
  if  dwell_mask.18
    field  gmti.sensor_speed_unc_mms  16  uint
  end
  if  dwell_mask.19
    field  gmti.sensor_vvel_unc_cms  16  uint
  end
  if  dwell_mask.20
    field  gmti.platform_heading  16  uscale:360/65536
  end
  if  dwell_mask.21
    field  gmti.platform_pitch  16  sscale:180/65536
  end
  if  dwell_mask.22
    field  gmti.platform_roll  16  sscale:180/65536
  end
  if  dwell_mask.23
    field  gmti.dwell_center_lat  32  sscale:180/4294967296
  end
  if  dwell_mask.24
    field  gmti.dwell_center_lon  32  uscale:360/4294967296
  end
  if  dwell_mask.25
    field  gmti.dwell_range_half_km  16  uscale:1/128
  end
  if  dwell_mask.26
    field  gmti.dwell_angle_half  16  uscale:360/65536
  end
  if  dwell_mask.27
    field  gmti.sensor_heading  16  uscale:360/65536
  end
  if  dwell_mask.28
    field  gmti.sensor_pitch  16  sscale:180/65536
  end
  if  dwell_mask.29
    field  gmti.sensor_roll  16  sscale:180/65536
  end
  if  dwell_mask.30
    field  gmti.mdv_dms  8  uint
  end
  group  detection.items  rest
    if  dwell_mask.31
      field  gmti.mti_report_index  16  uint
    end
    if  dwell_mask.32
      field  lat  32  sscale:180/4294967296
    end
    if  dwell_mask.33
      field  lon  32  sscale:360/4294967296
    end
    if  dwell_mask.34
      field  gmti.target_delta_lat  16  twos
    end
    if  dwell_mask.35
      field  gmti.target_delta_lon  16  twos
    end
    if  dwell_mask.36
      field  hae  16  sscale:1
    end
    if  dwell_mask.37
      field  detection.radial_velocity_ms  16  sscale:1/100
    end
    if  dwell_mask.38
      field  gmti.target_wrap_vel_cms  16  uint
    end
    if  dwell_mask.39
      field  detection.snr_db  8  sscale:1
    end
    if  dwell_mask.40
      field  gmti.target_class  8  uint
      also  track.class via target_class
      also  track.simulated via target_simulated
      also  detection.classification via target_class
    end
    if  dwell_mask.41
      field  detection.classification_probability  8  uscale:1/100
    end
    if  dwell_mask.42
      field  detection.range_error_m  16  uscale:1/100
    end
    if  dwell_mask.43
      field  detection.cross_range_error_m  16  uscale:1/10
    end
    if  dwell_mask.44
      field  le  8  uscale:1
    end
    if  dwell_mask.45
      field  detection.radial_velocity_error_ms  16  uscale:1/100
    end
    if  dwell_mask.46
      field  gmti.truth_tag_app  8  uint
    end
    if  dwell_mask.47
