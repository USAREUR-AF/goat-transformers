  end
  if  dwell_mask.10
    field  gmti.lon_scale  32  uscale:360/4294967296
  end
  if  dwell_mask.11
    field  gmti.sensor_unc_along_cm  32  uint
  end
  if  dwell_mask.12
    field  gmti.sensor_unc_cross_cm  32  uint
  end
  if  dwell_mask.13
    field  gmti.sensor_unc_alt_cm  16  uint
  end
  if  dwell_mask.14
    field  gmti.sensor_track  16  uscale:360/65536
  end
  if  dwell_mask.15
    field  gmti.sensor_speed_mms  32  uint
  end
  if  dwell_mask.16
