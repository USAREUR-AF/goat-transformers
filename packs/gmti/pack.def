also  detection.sensor_id
field  gmti.mission_id  32  uint
field  gmti.job_id  32  uint
kind  mission
requires  gmti.mission_plan
when  8  1
length  32  plus  5
  field  gmti.mission_plan  96  ascii
  field  gmti.flight_plan  96  ascii
  field  gmti.platform_type  8  uint
  field  gmti.platform_config  80  ascii
  field  gmti.reference_year  16  uint
  field  gmti.reference_month  8  uint
  field  gmti.reference_day  8  uint
end
kind  dwell
requires  gmti.dwell_index
when  8  2
length  32  plus  5
  presence  dwell_mask  64
  if  dwell_mask.1
    field  gmti.dwell_revisit_index  16  uint
  end
  if  dwell_mask.2
    field  gmti.dwell_index  16  uint
  end
  if  dwell_mask.3
