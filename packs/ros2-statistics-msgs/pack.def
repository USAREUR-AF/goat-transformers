# ROS 2 statistics_msgs messages in the JSON form of a rosbridge `publish` operation.
# Generated by tools/gen/ros2msg2pack.py; do not edit by hand.
# One kind per .msg file, selected by the member `type` ("<package>/msg/<Name>").
# The ROS message is the object under `msg`; arrays are groups.
format        ros2-statistics-msgs
version       0.1.0
distribution  public
source        "ROS 2 interface package statistics_msgs, https://github.com/ros2/rcl_interfaces 2.0.4 (Apache License 2.0) at commit 7aa3caf43377ea6ad615bc1040832e2c7566bfbe, directory statistics_msgs/msg; field names, types and array forms only"
source        "ROS 2 interface package builtin_interfaces (messages statistics_msgs refers to), https://github.com/ros2/rcl_interfaces 2.0.4 at commit 7aa3caf43377ea6ad615bc1040832e2c7566bfbe, Apache License 2.0"
source        "rosbridge v2.1.0 Protocol Specification, ROSBRIDGE_PROTOCOL.md, https://github.com/RobotWebTools/rosbridge_suite jazzy at commit cb33a16b890e4b8d9def531326409f3ee6c12537, BSD 3-Clause License; JSON form of a message and of the publish operation"
uses          ros2statistics
wire          json
when   op  publish
field  ros2statistics.topic  topic  string

kind      metrics_message
when      type  statistics_msgs/msg/MetricsMessage
requires  ros2statistics.metrics_message_measurement_source_name
field  ros2statistics.metrics_message_measurement_source_name  msg.measurement_source_name  string
field  ros2statistics.metrics_message_metrics_source  msg.metrics_source  string
field  ros2statistics.metrics_message_unit  msg.unit  string
field  ros2statistics.metrics_message_window_start_sec  msg.window_start.sec  int
field  ros2statistics.metrics_message_window_start_nanosec  msg.window_start.nanosec  int
field  ros2statistics.metrics_message_window_stop_sec  msg.window_stop.sec  int
field  ros2statistics.metrics_message_window_stop_nanosec  msg.window_stop.nanosec  int
group  ros2statistics.metrics_message_statistics  msg.statistics
  field  ros2statistics.metrics_message_statistics_data_type  data_type  int
  field  ros2statistics.metrics_message_statistics_data  data  float
end

kind      statistic_data_point
when      type  statistics_msgs/msg/StatisticDataPoint
requires  ros2statistics.statistic_data_point_data_type
field  ros2statistics.statistic_data_point_data_type  msg.data_type  int
field  ros2statistics.statistic_data_point_data  msg.data  float

kind      statistic_data_type
when      type  statistics_msgs/msg/StatisticDataType
requires  ros2statistics.topic
