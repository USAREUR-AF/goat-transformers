field     sbfgnssattitude.att_euler_info 0:112:8 uint
field     sbfgnssattitude.att_euler_reserved 0:120:8 uint
field     sbfgnssattitude.att_euler_heading 0:128:32 f32
field     sbfgnssattitude.att_euler_pitch 0:160:32 f32
field     sbfgnssattitude.att_euler_roll 0:192:32 f32
field     sbfgnssattitude.att_euler_pitch_dot 0:224:32 f32
field     sbfgnssattitude.att_euler_roll_dot 0:256:32 f32
field     sbfgnssattitude.att_euler_heading_dot 0:288:32 f32

kind      att_cov_euler
when      0:0:13 5939
when      0:16:16 40
requires  sbfgnssattitude.att_cov_euler_tow sbfgnssattitude.att_cov_euler_wnc sbfgnssattitude.att_cov_euler_reserved
