uses          sbfgnssattitude
wire          bits
bit_order     lsb
word_bytes    1
field  sbf.revision 0:13:3 uint

kind      att_euler
when      0:0:13 5938
when      0:16:16 44
requires  sbfgnssattitude.att_euler_tow sbfgnssattitude.att_euler_wnc sbfgnssattitude.att_euler_nr_sv
