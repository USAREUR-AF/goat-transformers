# Conformance probe pack for ruling 7 of spec 0.17: an earlier line written
# from its `default`, a later line with a present key and a gate, all on the
# same bits. Fixed `bits` layout, least significant bit first. Public. No
# kinds. One byte per word. A bit that a line with a present key covers keeps
# the field lines' value (here the earlier default's), not the gate value.
#
#   bits 0-3     x (default 3), outside any block
#   bits 0-7     y, when bits 0-1 hold 1 or 3
format     conformance-gates-default-gate
version    0.17.0
distribution public
source  "goat-transformers spec/engine-spec.md (synthetic probe format, no external standard)"
uses       probe
wire       bits
word_bytes 1
field   probe.x   0:0:4    uint
default probe.x   3
if      0:0:2  1,3
  field probe.y   0:0:8    uint
end
