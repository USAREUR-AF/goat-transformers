# SBP frames of the package swiftnav.sbp.mag, one kind per message.
# Generated by tools/gen/sbp2pack.py; do not edit by hand.
# The message is one SBP frame from the preamble through the payload:
# preamble 0x55, message type (u16), sender (u16), length (u8), payload.
# The message carries no CRC: a framer adds and checks it. Payload bit 0 is bit 48.
format        sbp-mag
version       0.1.0
distribution  public
source        "https://github.com/swift-nav/libsbp spec/yaml/swiftnav/sbp/mag.yaml at v6.5.2 (commit 925825dea5174f069b5d6e23548f213e09f0235c)"
uses          sbp
uses          sbpmag
wire          bits
bit_order     lsb
word_bytes    1
when   0:0:8 85
field  sbp.sender 0:24:16 uint

kind      mag_raw
when      0:8:16 2306
when      0:40:8 11
requires  sbpmag.mag_raw_tow sbpmag.mag_raw_tow_f sbpmag.mag_raw_mag_x
field     sbpmag.mag_raw_tow 0:48:32 uint
field     sbpmag.mag_raw_tow_f 0:80:8 uscale:1/256
field     sbpmag.mag_raw_mag_x 0:88:16 twos
field     sbpmag.mag_raw_mag_y 0:104:16 twos
field     sbpmag.mag_raw_mag_z 0:120:16 twos
