# ASTERIX Category 002, Transmission of Monoradar Service Messages, edition 1.2: one data block holding one record.
# Public. Generated by tools/gen/asterix2pack.py from the category definition of
# github.com/zoranbosnjak/asterix-specs (BSD-3-Clause); do not edit by hand. I/O is hex text.
# Needs engine version 0.8 (`layout sequential`). See pack.md.
#
#   octet 1       CAT = 2
#   octets 2-3    LEN, the length of the data block in octets, CAT and LEN included
#   FSPEC         octets of 7 presence bits and an extension bit; bit n is FRN n
#   then          the items whose FSPEC bit is 1, in FRN order
#
# An FRN with no `if` block is not mapped: a record with that FSPEC bit set fails
# with `malformed-wire` (ruling 1 of engine-spec 0.8), and encode never sets the bit.
format     asterix-cat002
version    0.1.0
distribution public
source  "ASTERIX Category 002, Transmission of Monoradar Service Messages, edition 1.2 (2024-03-15), as transcribed in github.com/zoranbosnjak/asterix-specs (BSD-3-Clause), commit 64e9ffba964b92a1af3157bc6bdf7852a63bf700, specs/cat002/cats/cat1.2/definition.json. The category is specified by EUROCONTROL"
uses       cat002
wire       bits
layout     sequential
bit_order  msb
kind    record
when    8  2                              # CAT
length  16 whole                         # LEN
presence f fx
if f.1                                   # FRN 1, I002/010 Data Source Identifier
  field  cat002.i010_sac  8  uint
  field  cat002.i010_sic  8  uint
end
if f.2                                   # FRN 2, I002/000 Message Type
  field  cat002.i000  8  uint
end
if f.3                                   # FRN 3, I002/020 Sector Number
  field  cat002.i020  8  uscale:45/32
end
if f.4                                   # FRN 4, I002/030 Time of Day
  field  cat002.i030  24  uscale:1/128
end
if f.5                                   # FRN 5, I002/041 Antenna Rotation Speed
  field  cat002.i041  16  uscale:1/128
end
if f.6                                   # FRN 6, I002/050 Station Configuration Status
  group  cat002.i050  fx
    field  cat002.i050_val  7  uint
  end
end
if f.7                                   # FRN 7, I002/060 Station Processing Mode
  group  cat002.i060  fx
    field  cat002.i060_val  7  uint
  end
end
if f.8                                   # FRN 8, I002/070 Plot Count Values
  group  cat002.i070  count 8
    field  cat002.i070_a  1  uint
    field  cat002.i070_ident  5  uint
    field  cat002.i070_counter  10  uint
  end
end
if f.9                                   # FRN 9, I002/100 Dynamic Window Type 1
  field  cat002.i100_rs  16  uscale:1/128
  field  cat002.i100_re  16  uscale:1/128
  field  cat002.i100_ts  16  uscale:45/8192
  field  cat002.i100_te  16  uscale:45/8192
end
if f.10                                  # FRN 10, I002/090 Collimation Error
  field  cat002.i090_re  8  sscale:1/128
  field  cat002.i090_ae  8  sscale:45/2048
end
if f.11                                  # FRN 11, I002/080 Warning/Error Conditions
  group  cat002.i080  fx
    field  cat002.i080_val  7  uint
  end
end
# FRN 12: spare FRN
if f.13                                  # FRN 13, I002/SP Special Purpose Field
  length 8 bytes plus 1                # the length octet counts itself; the content is not mapped
  end
end
# FRN 14: random field sequencing: the items that follow name themselves by FRN, in any order
