# ArduPilot log message GPS as the payload of a DataFlash log record.
# Generated by tools/gen/aplog2pack.py; do not edit by hand.
# The record without its 3-byte header (0xA3 0x95 type-id); fields packed, little-endian.
format        ardupilot-log-gps
version       0.1.0
distribution  public
source        "ArduPilot log message definitions (log structure tables and Write calls), https://github.com/ArduPilot/ardupilot at tag Copter-4.6.2, commit 1ebd4d996e8b6bbeb1462a9655c00aa861d5beef; message names, format strings, labels, units and multipliers only; GNU General Public License, version 3"
source        "ArduPilot libraries/AP_Logger/LogStructure.h: the format characters, units and multipliers of a log message, at the same commit"
uses          aplog
wire          bits
bit_order     lsb
word_bytes    1
field  aplog.gps_timeus  0:0:64  uint
field  aplog.gps_i  0:64:8  uint
field  aplog.gps_status  0:72:8  uint
field  aplog.gps_gms  0:80:32  uint
field  aplog.gps_gwk  0:112:16  uint
field  aplog.gps_nsats  0:128:8  uint
field  aplog.gps_hdop  0:136:16  twos
field  lat  0:152:32  sscale:1/10000000
field  lon  0:184:32  sscale:1/10000000
field  aplog.gps_alt  0:216:32  twos
field  aplog.gps_spd  0:248:32  f32
field  aplog.gps_gcrs  0:280:32  f32
field  aplog.gps_vz  0:312:32  f32
field  aplog.gps_yaw  0:344:32  f32
field  aplog.gps_u  0:376:8  uint
