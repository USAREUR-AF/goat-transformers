# L2TPv3 over IP (RFC 3931 section 4.1.1): the session header, or, with session
# ID 0, the control message header (section 3.2.1) that follows it. Public. The
# cookie, the L2-specific sublayer, the payload and control message AVPs are not
# mapped (pack.md).
#
# Addressing: word_bytes 1 and bit_order msb; multi-octet fields are big-endian.
format        l2tpv3-ip
version       0.1.0
distribution  public
source        "IETF RFC 3931, Layer Two Tunneling Protocol - Version 3 (L2TPv3), March 2005, sections 3.2.1 and 4.1.1, https://www.rfc-editor.org/rfc/rfc3931.txt; layout restated"
uses          inet
wire          bits
word_bytes    1
bit_order     msb

kind      control                                     # session ID 0, then the T bit 1
when      0:0:32  0
when      0:32:1  1
requires  inet.l2tp_control_connection_id
field  inet.l2tp_length_bit       0:33:1      uint
field  inet.l2tp_sequence_bit     0:36:1      uint
field  inet.l2tp_version          0:44:4     uint
field  inet.l2tp_length           0:48:16    uint
field  inet.l2tp_control_connection_id 0:64:32 uint
field  inet.l2tp_ns               0:96:16    uint
field  inet.l2tp_nr               0:112:16    uint

kind      data
requires  inet.l2tp_session_id
field  inet.l2tp_session_id         0:0:32     uint
