# SBP frames of the package swiftnav.sbp.logging whose payload length is not fixed,
# one kind per message. Generated by tools/gen/sbp2pack.py; do not edit by hand.
# The frame: preamble 0x55, message type (u16), sender (u16), length (u8),
# payload, without the CRC. The payload is a `length 8 bytes` extent; an array
# or text that runs to its end is a `rest` group (engine-spec 0.8, 0.21).
format        sbp-logging-var
version       0.1.0
distribution  public
source        "https://github.com/swift-nav/libsbp spec/yaml/swiftnav/sbp/logging.yaml at v6.5.2 (commit 925825dea5174f069b5d6e23548f213e09f0235c)"
uses          sbp
uses          sbplogging
wire          bits
layout        sequential
bit_order     lsb
when  8  85

kind  log
when  16  1025
requires  sbplogging.log_level
field  sbp.sender  16  uint
length  8  bytes
  field  sbplogging.log_level  8  uint
  group  sbplogging.log_text  rest
    field  sbplogging.log_text_byte  8  uint
  end
end

kind  fwd
when  16  1026
requires  sbplogging.fwd_source
field  sbp.sender  16  uint
length  8  bytes
  field  sbplogging.fwd_source  8  uint
  field  sbplogging.fwd_protocol  8  uint
  group  sbplogging.fwd_fwd_payload  rest
    field  sbplogging.fwd_fwd_payload_item  8  uint
  end
end

kind  print_dep
when  16  16
requires  sbplogging.print_dep_text
field  sbp.sender  16  uint
length  8  bytes
  group  sbplogging.print_dep_text  rest
    field  sbplogging.print_dep_text_byte  8  uint
  end
end
