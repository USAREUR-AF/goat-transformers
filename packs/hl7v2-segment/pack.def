# One HL7 v2 segment line (MSH, PID or OBX), its fields split at '|'. Written by tools/gen/health-pack.py; do not edit by hand.
format        hl7v2-segment
version       0.1.0
distribution  public
source        "hl7apy, https://github.com/crs4/hl7apy at commit c57adca03c77e549031867b36a6d5703611af8cd, hl7apy/v2_5/fields.py and segments.py (MIT License, Copyright (c) 2012-2018 CRS4); field numbers and names restated, no code copied; the HL7 v2.5 standard not used"
uses          hl7v2
wire          text
delimiter     "|"

kind  pid
when  0  PID
requires  hl7v2.pid_1_set_id_pid
field  hl7v2.pid_1_set_id_pid  1  string  optional
field  hl7v2.pid_2_patient_id  2  string  optional
