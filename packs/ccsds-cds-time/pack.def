# CCSDS Day Segmented Time Code (CDS, 301.0-B-4 section 3.3) with an explicit
# P-field: a 16- or 24-bit day count, 32-bit milliseconds of day and a 0, 16 or
# 32-bit submillisecond segment, as P-field bits 5-7 say. Public (CCSDS Blue Book).
# Bits are numbered from 0 at the first transmitted bit, most significant bit first.
# The segment places follow from bits 5 and 6-7: gate blocks (engine-spec 0.17).
# The level 1 code counts days from 1958 January 1 and is UTC-based (3.3.1): its
# day count also gives ccsdstime.cds_day_unix_ms, and the module derives time_ms
# from that and the milliseconds of day (pack.md, Shared keys).
format     ccsds-cds-time
version    0.1.0
distribution public
source     "CCSDS 301.0-B-4 Time Code Formats, Blue Book, November 2010 (Editorial Change 1), https://ccsds.org/Pubs/301x0b4e1.pdf, sections 3.1 and 3.3; reuse with attribution under the CCSDS reproduction permission statement"
uses       ccsdstime
wire       bits
word_bytes 1
bit_order  msb
when   0:0:1  0                                       # P-field extension: none
when   0:1:3  4                                       # time code ID 100
field  ccsdstime.cds_day_segment_24        0:5:1   uint
field  ccsdstime.cds_submillisecond_length 0:6:2   uint
if  0:5:1  0
  field  ccsdstime.cds_day                 0:8:16  uint
  field  ccsdstime.cds_ms_of_day           0:24:32 uint
  if  0:6:2  1
    field  ccsdstime.cds_submillisecond    0:56:16 uint
  end
  if  0:6:2  2
    field  ccsdstime.cds_submillisecond    0:56:32 uint
  end
end
if  0:5:1  1
  field  ccsdstime.cds_day                 0:8:24  uint
  field  ccsdstime.cds_ms_of_day           0:32:32 uint
  if  0:6:2  1
    field  ccsdstime.cds_submillisecond    0:64:16 uint
  end
  if  0:6:2  2
    field  ccsdstime.cds_submillisecond    0:64:32 uint
  end
end

kind     level-1                                      # P-field bit 4 = 0: epoch 1958 January 1
when     0:4:1  0
requires ccsdstime.cds_day
if  0:5:1  0
  field  ccsdstime.cds_day_unix_ms         0:8:16  uiscale:86400000:-378691200000
end
if  0:5:1  1
  field  ccsdstime.cds_day_unix_ms         0:8:24  uiscale:86400000:-378691200000
end

kind     level-2                                      # P-field bit 4 = 1: agency-defined epoch
when     0:4:1  1
requires ccsdstime.cds_day
