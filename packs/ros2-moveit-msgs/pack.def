# ROS 2 moveit_msgs messages in the JSON form of a rosbridge `publish` operation.
# Generated by tools/gen/ros2msg2pack.py; do not edit by hand.
# One kind per .msg file, selected by the member `type` ("<package>/msg/<Name>").
# The ROS message is the object under `msg`; arrays are groups.
format        ros2-moveit-msgs
version       0.1.0
distribution  public
source        "ROS 2 interface package moveit_msgs, https://github.com/moveit/moveit_msgs ros2 (BSD License) at commit 6066314bc50472c23a0712f317396bd120a07227, directory msg; field names, types and array forms only"
