uses          ros2moveit
wire          json
when   op  publish
field  ros2moveit.topic  topic  string

kind      allowed_collision_entry
when      type  moveit_msgs/msg/AllowedCollisionEntry
requires  ros2moveit.allowed_collision_entry_enabled
group  ros2moveit.allowed_collision_entry_enabled  msg.enabled
  field  ros2moveit.allowed_collision_entry_enabled_value  .  bool
end

