# ArduPilot log message SLV2 as the payload of a DataFlash log record.
# Generated by tools/gen/aplog2pack.py; do not edit by hand.
# The record without its 3-byte header (0xA3 0x95 type-id); fields packed, little-endian.
format        ardupilot-log-slv2
version       0.1.0
distribution  public
source        "ArduPilot log message definitions (log structure tables and Write calls), https://github.com/ArduPilot/ardupilot at tag Copter-4.6.2, commit 1ebd4d996e8b6bbeb1462a9655c00aa861d5beef; message names, format strings, labels, units and multipliers only; GNU General Public License, version 3"
source        "ArduPilot libraries/AP_Logger/LogStructure.h: the format characters, units and multipliers of a log message, at the same commit"
uses          aplog
wire          bits
bit_order     lsb
word_bytes    1
field  aplog.slv2_timeus  0:0:64  uint
field  aplog.slv2_instance  0:64:8  uint
field  aplog.slv2_c1  0:72:16  uint
field  aplog.slv2_c2  0:88:16  uint
field  aplog.slv2_c3  0:104:16  uint
field  aplog.slv2_c4  0:120:16  uint
field  aplog.slv2_c5  0:136:16  uint
field  aplog.slv2_c6  0:152:16  uint
field  aplog.slv2_c7  0:168:16  uint
field  aplog.slv2_c8  0:184:16  uint
field  aplog.slv2_c9  0:200:16  uint
field  aplog.slv2_c10  0:216:16  uint
field  aplog.slv2_c11  0:232:16  uint
field  aplog.slv2_c12  0:248:16  uint
field  aplog.slv2_c13  0:264:16  uint
field  aplog.slv2_c14  0:280:16  uint
