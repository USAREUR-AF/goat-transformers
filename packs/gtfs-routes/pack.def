# GTFS Schedule routes.txt: one data row of the file. Public. Maintained by hand.
# The columns are in the order the reference lists them (pack.md, Column order);
# the header row is not a message of this pack.
format        gtfs-routes
version       0.1.0
distribution  public
source        "GTFS Schedule Reference, gtfs/spec/en/reference.md of https://github.com/google/transit (Apache-2.0) at commit 2ce6aa79e3fa7bdbaf19d2a12765cee5b9fdd699; the column order of each file as the reference lists it; field names and types"
uses          gtfs
wire          text

field  gtfs.route_id                    0   string
field  gtfs.agency_id                   1   string
field  gtfs.route_short_name            2   string
field  gtfs.route_long_name             3   string
field  gtfs.route_desc                  4   string
field  gtfs.route_type                  5   int
field  gtfs.route_url                   6   string
field  gtfs.route_color                 7   string
field  gtfs.route_text_color            8   string
field  gtfs.route_sort_order            9   int
field  gtfs.continuous_pickup           10  int
field  gtfs.continuous_drop_off         11  int
field  gtfs.network_id                  12  string
field  gtfs.cemv_support                13  int
