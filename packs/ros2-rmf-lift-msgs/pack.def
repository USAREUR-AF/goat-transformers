# ROS 2 rmf_lift_msgs messages in the JSON form of a rosbridge `publish` operation.
# Generated by tools/gen/ros2msg2pack.py; do not edit by hand.
# One kind per .msg file, selected by the member `type` ("<package>/msg/<Name>").
# The ROS message is the object under `msg`; arrays are groups.
format        ros2-rmf-lift-msgs
version       0.1.0
distribution  public
source        "ROS 2 interface package rmf_lift_msgs, https://github.com/open-rmf/rmf_internal_msgs jazzy (Apache License 2.0) at commit 04585f0e2b0da9f11327fb403d38bc547d648fa6, directory rmf_lift_msgs/msg; field names, types and array forms only"
source        "ROS 2 interface package builtin_interfaces (messages rmf_lift_msgs refers to), https://github.com/ros2/rcl_interfaces 2.0.4 at commit 7aa3caf43377ea6ad615bc1040832e2c7566bfbe, Apache License 2.0"
source        "rosbridge v2.1.0 Protocol Specification, ROSBRIDGE_PROTOCOL.md, https://github.com/RobotWebTools/rosbridge_suite jazzy at commit cb33a16b890e4b8d9def531326409f3ee6c12537, BSD 3-Clause License; JSON form of a message and of the publish operation"
uses          ros2rmflift
wire          json
when   op  publish
field  ros2rmflift.topic  topic  string

kind      lift_request
when      type  rmf_lift_msgs/msg/LiftRequest
requires  ros2rmflift.lift_request_lift_name
field  ros2rmflift.lift_request_lift_name  msg.lift_name  string
field  ros2rmflift.lift_request_request_time_sec  msg.request_time.sec  int
field  ros2rmflift.lift_request_request_time_nanosec  msg.request_time.nanosec  int
field  ros2rmflift.lift_request_session_id  msg.session_id  string
field  ros2rmflift.lift_request_request_type  msg.request_type  int
field  ros2rmflift.lift_request_destination_floor  msg.destination_floor  string
field  ros2rmflift.lift_request_door_state  msg.door_state  int

kind      lift_state
when      type  rmf_lift_msgs/msg/LiftState
requires  ros2rmflift.lift_state_lift_time_sec
field  ros2rmflift.lift_state_lift_time_sec  msg.lift_time.sec  int
field  ros2rmflift.lift_state_lift_time_nanosec  msg.lift_time.nanosec  int
field  ros2rmflift.lift_state_lift_name  msg.lift_name  string
group  ros2rmflift.lift_state_available_floors  msg.available_floors
  field  ros2rmflift.lift_state_available_floors_value  .  string
end
field  ros2rmflift.lift_state_current_floor  msg.current_floor  string
field  ros2rmflift.lift_state_destination_floor  msg.destination_floor  string
field  ros2rmflift.lift_state_door_state  msg.door_state  int
field  ros2rmflift.lift_state_motion_state  msg.motion_state  int
field  ros2rmflift.lift_state_available_modes  msg.available_modes  string
field  ros2rmflift.lift_state_current_mode  msg.current_mode  int
field  ros2rmflift.lift_state_session_id  msg.session_id  string
