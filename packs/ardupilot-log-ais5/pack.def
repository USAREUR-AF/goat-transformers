# ArduPilot log message AIS5 as the payload of a DataFlash log record.
# Generated by tools/gen/aplog2pack.py; do not edit by hand.
# The record without its 3-byte header (0xA3 0x95 type-id); fields packed, little-endian.
format        ardupilot-log-ais5
version       0.1.0
distribution  public
source        "ArduPilot log message definitions (log structure tables and Write calls), https://github.com/ArduPilot/ardupilot at tag Copter-4.6.2, commit 1ebd4d996e8b6bbeb1462a9655c00aa861d5beef; message names, format strings, labels, units and multipliers only; GNU General Public License, version 3"
source        "ArduPilot libraries/AP_Logger/LogStructure.h: the format characters, units and multipliers of a log message, at the same commit"
uses          aplog
wire          bits
bit_order     lsb
word_bytes    1
field  aplog.ais5_us  0:0:64  uint
field  aplog.ais5_rep  0:64:8  uint
field  aplog.ais5_mmsi  0:72:32  uint
field  aplog.ais5_ver  0:104:8  uint
field  aplog.ais5_imo  0:112:32  uint
field  aplog.ais5_cal  0:144:128  ascii
field  aplog.ais5_nam  0:272:512  ascii
field  aplog.ais5_typ  0:784:8  uint
field  aplog.ais5_bow  0:792:16  uint
field  aplog.ais5_stn  0:808:16  uint
field  aplog.ais5_prt  0:824:8  uint
field  aplog.ais5_str  0:832:8  uint
field  aplog.ais5_fix  0:840:8  uint
field  aplog.ais5_dght  0:848:8  uint
field  aplog.ais5_dst  0:856:512  ascii
field  aplog.ais5_dte  0:1368:8  uint
