# GTFS Schedule feed_info.txt: one data row of the file. Public. Maintained by hand.
# The columns are in the order the reference lists them (pack.md, Column order);
# the header row is not a message of this pack.
format        gtfs-feed-info
version       0.1.0
distribution  public
source        "GTFS Schedule Reference, gtfs/spec/en/reference.md of https://github.com/google/transit (Apache-2.0) at commit 2ce6aa79e3fa7bdbaf19d2a12765cee5b9fdd699; the column order of each file as the reference lists it; field names and types"
uses          gtfs
wire          text

field  gtfs.feed_publisher_name         0   string
field  gtfs.feed_publisher_url          1   string
field  gtfs.feed_lang                   2   string
field  gtfs.default_lang                3   string
field  gtfs.feed_start_date             4   string
field  gtfs.feed_end_date               5   string
field  gtfs.feed_version                6   string
field  gtfs.feed_contact_email          7   string
field  gtfs.feed_contact_url            8   string
