# One OFX 2 statement transaction element <STMTTRN> (XML). Written by tools/gen/finance-pack.py; do not edit by hand.
format        ofx-stmttrn
version       0.1.0
distribution  public
source        "ofxparse, https://github.com/jseutter/ofxparse at commit 25aa80072be71da9f4ea0924ae1d1aaea2d5820c, ofxparse/ofxparse.py and tests/fixtures/*.ofx (MIT License, Copyright (c) 2009 Jerry Seutter); element names and order restated, no code copied; the OFX specification not used"
uses          ofx
wire          xml
root          STMTTRN

field  ofx.trntype  TRNTYPE/#text  string
field  ofx.dtposted  DTPOSTED/#text  string
field  ofx.trnamt  TRNAMT/#text  string
field  ofx.fitid  FITID/#text  string
field  ofx.checknum  CHECKNUM/#text  string
field  ofx.name  NAME/#text  string
field  ofx.memo  MEMO/#text  string
