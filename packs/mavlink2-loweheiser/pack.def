source        "MAVLink 2 packet format, https://mavlink.io/en/guide/serialization.html"
uses          mavlink
uses          mavlinkloweheiser
wire          bits
bit_order     lsb
word_bytes    1
when   0:0:8 253
field  mavlink.seq 0:32:8 uint
field  mavlink.sysid 0:40:8 uint
field  mavlink.compid 0:48:8 uint

kind      loweheiser_gov_efi
when      0:56:24 10151
when      0:8:8 85
requires  mavlinkloweheiser.volt_batt_v mavlinkloweheiser.curr_batt_a mavlinkloweheiser.curr_gen_a mavlinkloweheiser.curr_rot_a mavlinkloweheiser.fuel_level_l mavlinkloweheiser.throttle_pct
