field  ros2rmfdispenser.dispenser_request_time_nanosec  msg.time.nanosec  int
field  ros2rmfdispenser.dispenser_request_request_guid  msg.request_guid  string
field  ros2rmfdispenser.dispenser_request_target_guid  msg.target_guid  string
field  ros2rmfdispenser.dispenser_request_transporter_type  msg.transporter_type  string
group  ros2rmfdispenser.dispenser_request_items  msg.items
  field  ros2rmfdispenser.dispenser_request_items_type_guid  type_guid  string
  field  ros2rmfdispenser.dispenser_request_items_quantity  quantity  int
  field  ros2rmfdispenser.dispenser_request_items_compartment_name  compartment_name  string
end

kind      dispenser_request_item
when      type  rmf_dispenser_msgs/msg/DispenserRequestItem
requires  ros2rmfdispenser.dispenser_request_item_type_guid
field  ros2rmfdispenser.dispenser_request_item_type_guid  msg.type_guid  string
field  ros2rmfdispenser.dispenser_request_item_quantity  msg.quantity  int
field  ros2rmfdispenser.dispenser_request_item_compartment_name  msg.compartment_name  string

kind      dispenser_result
when      type  rmf_dispenser_msgs/msg/DispenserResult
requires  ros2rmfdispenser.dispenser_result_time_sec
field  ros2rmfdispenser.dispenser_result_time_sec  msg.time.sec  int
field  ros2rmfdispenser.dispenser_result_time_nanosec  msg.time.nanosec  int
field  ros2rmfdispenser.dispenser_result_request_guid  msg.request_guid  string
field  ros2rmfdispenser.dispenser_result_source_guid  msg.source_guid  string
field  ros2rmfdispenser.dispenser_result_status  msg.status  int

kind      dispenser_state
when      type  rmf_dispenser_msgs/msg/DispenserState
requires  ros2rmfdispenser.dispenser_state_time_sec
field  ros2rmfdispenser.dispenser_state_time_sec  msg.time.sec  int
field  ros2rmfdispenser.dispenser_state_time_nanosec  msg.time.nanosec  int
field  ros2rmfdispenser.dispenser_state_guid  msg.guid  string
field  ros2rmfdispenser.dispenser_state_mode  msg.mode  int
group  ros2rmfdispenser.dispenser_state_request_guid_queue  msg.request_guid_queue
  field  ros2rmfdispenser.dispenser_state_request_guid_queue_value  .  string
end
field  ros2rmfdispenser.dispenser_state_seconds_remaining  msg.seconds_remaining  float
