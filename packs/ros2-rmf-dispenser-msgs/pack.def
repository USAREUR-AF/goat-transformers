# ROS 2 rmf_dispenser_msgs messages in the JSON form of a rosbridge `publish` operation.
# Generated by tools/gen/ros2msg2pack.py; do not edit by hand.
# One kind per .msg file, selected by the member `type` ("<package>/msg/<Name>").
# The ROS message is the object under `msg`; arrays are groups.
format        ros2-rmf-dispenser-msgs
version       0.1.0
distribution  public
source        "ROS 2 interface package rmf_dispenser_msgs, https://github.com/open-rmf/rmf_internal_msgs jazzy (Apache License 2.0) at commit 04585f0e2b0da9f11327fb403d38bc547d648fa6, directory rmf_dispenser_msgs/msg; field names, types and array forms only"
source        "ROS 2 interface package builtin_interfaces (messages rmf_dispenser_msgs refers to), https://github.com/ros2/rcl_interfaces 2.0.4 at commit 7aa3caf43377ea6ad615bc1040832e2c7566bfbe, Apache License 2.0"
