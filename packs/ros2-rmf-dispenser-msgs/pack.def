uses          ros2rmfdispenser
wire          json
when   op  publish
field  ros2rmfdispenser.topic  topic  string

kind      dispenser_request
when      type  rmf_dispenser_msgs/msg/DispenserRequest
requires  ros2rmfdispenser.dispenser_request_time_sec
