  field  sbpfileio.fileio_read_req_chunk_size  8  uint
  group  sbpfileio.fileio_read_req_filename  rest
    field  sbpfileio.fileio_read_req_filename_byte  8  uint
  end
end

kind  fileio_read_resp
when  16  163
requires  sbpfileio.fileio_read_resp_sequence
field  sbp.sender  16  uint
length  8  bytes
  field  sbpfileio.fileio_read_resp_sequence  32  uint
  group  sbpfileio.fileio_read_resp_contents  rest
    field  sbpfileio.fileio_read_resp_contents_item  8  uint
  end
end

