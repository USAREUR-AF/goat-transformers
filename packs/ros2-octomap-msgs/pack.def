# ROS 2 octomap_msgs messages in the JSON form of a rosbridge `publish` operation.
# Generated by tools/gen/ros2msg2pack.py; do not edit by hand.
# One kind per .msg file, selected by the member `type` ("<package>/msg/<Name>").
# The ROS message is the object under `msg`; arrays are groups.
format        ros2-octomap-msgs
version       0.1.0
distribution  public
source        "ROS 2 interface package octomap_msgs, https://github.com/OctoMap/octomap_msgs ros2 (BSD License (package.xml)) at commit 11a73b18b91002129dd686dedf971dcfac4ae601, directory msg; field names, types and array forms only"
source        "ROS 2 interface package builtin_interfaces (messages octomap_msgs refers to), https://github.com/ros2/rcl_interfaces 2.0.4 at commit 7aa3caf43377ea6ad615bc1040832e2c7566bfbe, Apache License 2.0"
source        "ROS 2 interface package geometry_msgs (messages octomap_msgs refers to), https://github.com/ros2/common_interfaces 5.3.8 at commit a941f14bb318d8d904505ed935ccbb97f24a70a4, Apache License 2.0"
source        "ROS 2 interface package std_msgs (messages octomap_msgs refers to), https://github.com/ros2/common_interfaces 5.3.8 at commit a941f14bb318d8d904505ed935ccbb97f24a70a4, Apache License 2.0"
source        "rosbridge v2.1.0 Protocol Specification, ROSBRIDGE_PROTOCOL.md, https://github.com/RobotWebTools/rosbridge_suite jazzy at commit cb33a16b890e4b8d9def531326409f3ee6c12537, BSD 3-Clause License; JSON form of a message and of the publish operation"
uses          ros2octomap
wire          json
when   op  publish
field  ros2octomap.topic  topic  string

kind      octomap
when      type  octomap_msgs/msg/Octomap
requires  ros2octomap.octomap_header_stamp_sec
field  ros2octomap.octomap_header_stamp_sec  msg.header.stamp.sec  int
field  ros2octomap.octomap_header_stamp_nanosec  msg.header.stamp.nanosec  int
field  ros2octomap.octomap_header_frame_id  msg.header.frame_id  string
field  ros2octomap.octomap_binary  msg.binary  bool
field  ros2octomap.octomap_id  msg.id  string
field  ros2octomap.octomap_resolution  msg.resolution  float
group  ros2octomap.octomap_data  msg.data
  field  ros2octomap.octomap_data_value  .  int
end

kind      octomap_with_pose
when      type  octomap_msgs/msg/OctomapWithPose
requires  ros2octomap.octomap_with_pose_header_stamp_sec
field  ros2octomap.octomap_with_pose_header_stamp_sec  msg.header.stamp.sec  int
field  ros2octomap.octomap_with_pose_header_stamp_nanosec  msg.header.stamp.nanosec  int
field  ros2octomap.octomap_with_pose_header_frame_id  msg.header.frame_id  string
field  ros2octomap.octomap_with_pose_origin_position_x  msg.origin.position.x  float
field  ros2octomap.octomap_with_pose_origin_position_y  msg.origin.position.y  float
field  ros2octomap.octomap_with_pose_origin_position_z  msg.origin.position.z  float
field  ros2octomap.octomap_with_pose_origin_orientation_x  msg.origin.orientation.x  float
field  ros2octomap.octomap_with_pose_origin_orientation_y  msg.origin.orientation.y  float
field  ros2octomap.octomap_with_pose_origin_orientation_z  msg.origin.orientation.z  float
field  ros2octomap.octomap_with_pose_origin_orientation_w  msg.origin.orientation.w  float
field  ros2octomap.octomap_with_pose_octomap_header_stamp_sec  msg.octomap.header.stamp.sec  int
field  ros2octomap.octomap_with_pose_octomap_header_stamp_nanosec  msg.octomap.header.stamp.nanosec  int
field  ros2octomap.octomap_with_pose_octomap_header_frame_id  msg.octomap.header.frame_id  string
field  ros2octomap.octomap_with_pose_octomap_binary  msg.octomap.binary  bool
field  ros2octomap.octomap_with_pose_octomap_id  msg.octomap.id  string
field  ros2octomap.octomap_with_pose_octomap_resolution  msg.octomap.resolution  float
group  ros2octomap.octomap_with_pose_octomap_data  msg.octomap.data
  field  ros2octomap.octomap_with_pose_octomap_data_value  .  int
end
