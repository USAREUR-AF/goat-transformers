# ArduPilot log message XKY0 as the payload of a DataFlash log record.
# Generated by tools/gen/aplog2pack.py; do not edit by hand.
# The record without its 3-byte header (0xA3 0x95 type-id); fields packed, little-endian.
format        ardupilot-log-xky0
version       0.1.0
distribution  public
source        "ArduPilot log message definitions (log structure tables and Write calls), https://github.com/ArduPilot/ardupilot at tag Copter-4.6.2, commit 1ebd4d996e8b6bbeb1462a9655c00aa861d5beef; message names, format strings, labels, units and multipliers only; GNU General Public License, version 3"
source        "ArduPilot libraries/AP_Logger/LogStructure.h: the format characters, units and multipliers of a log message, at the same commit"
uses          aplog
wire          bits
bit_order     lsb
word_bytes    1
field  aplog.xky0_timeus  0:0:64  uint
field  aplog.xky0_c  0:64:8  uint
field  aplog.xky0_yc  0:72:32  f32
field  aplog.xky0_ycs  0:104:32  f32
field  aplog.xky0_y0  0:136:32  f32
field  aplog.xky0_y1  0:168:32  f32
field  aplog.xky0_y2  0:200:32  f32
field  aplog.xky0_y3  0:232:32  f32
field  aplog.xky0_y4  0:264:32  f32
field  aplog.xky0_w0  0:296:32  f32
field  aplog.xky0_w1  0:328:32  f32
field  aplog.xky0_w2  0:360:32  f32
field  aplog.xky0_w3  0:392:32  f32
field  aplog.xky0_w4  0:424:32  f32
