# ROS 2 trajectory_msgs messages in the JSON form of a rosbridge `publish` operation.
# Generated by tools/gen/ros2msg2pack.py; do not edit by hand.
# One kind per .msg file, selected by the member `type` ("<package>/msg/<Name>").
# The ROS message is the object under `msg`; arrays are groups.
format        ros2-trajectory-msgs
version       0.1.0
distribution  public
source        "ROS 2 interface package trajectory_msgs, https://github.com/ros2/common_interfaces 5.3.8 (Apache License 2.0) at commit a941f14bb318d8d904505ed935ccbb97f24a70a4, directory trajectory_msgs/msg; field names, types and array forms only"
source        "ROS 2 interface package builtin_interfaces (messages trajectory_msgs refers to), https://github.com/ros2/rcl_interfaces 2.0.4 at commit 7aa3caf43377ea6ad615bc1040832e2c7566bfbe, Apache License 2.0"
source        "ROS 2 interface package geometry_msgs (messages trajectory_msgs refers to), https://github.com/ros2/common_interfaces 5.3.8 at commit a941f14bb318d8d904505ed935ccbb97f24a70a4, Apache License 2.0"
source        "ROS 2 interface package std_msgs (messages trajectory_msgs refers to), https://github.com/ros2/common_interfaces 5.3.8 at commit a941f14bb318d8d904505ed935ccbb97f24a70a4, Apache License 2.0"
source        "rosbridge v2.1.0 Protocol Specification, ROSBRIDGE_PROTOCOL.md, https://github.com/RobotWebTools/rosbridge_suite jazzy at commit cb33a16b890e4b8d9def531326409f3ee6c12537, BSD 3-Clause License; JSON form of a message and of the publish operation"
uses          ros2trajectory
wire          json
when   op  publish
field  ros2trajectory.topic  topic  string

kind      joint_trajectory
when      type  trajectory_msgs/msg/JointTrajectory
requires  ros2trajectory.joint_trajectory_header_stamp_sec
field  ros2trajectory.joint_trajectory_header_stamp_sec  msg.header.stamp.sec  int
field  ros2trajectory.joint_trajectory_header_stamp_nanosec  msg.header.stamp.nanosec  int
field  ros2trajectory.joint_trajectory_header_frame_id  msg.header.frame_id  string
group  ros2trajectory.joint_trajectory_joint_names  msg.joint_names
  field  ros2trajectory.joint_trajectory_joint_names_value  .  string
end
group  ros2trajectory.joint_trajectory_points  msg.points
  group  ros2trajectory.joint_trajectory_points_positions  positions
    field  ros2trajectory.joint_trajectory_points_positions_value  .  float
  end
  group  ros2trajectory.joint_trajectory_points_velocities  velocities
    field  ros2trajectory.joint_trajectory_points_velocities_value  .  float
  end
  group  ros2trajectory.joint_trajectory_points_accelerations  accelerations
    field  ros2trajectory.joint_trajectory_points_accelerations_value  .  float
  end
  group  ros2trajectory.joint_trajectory_points_effort  effort
    field  ros2trajectory.joint_trajectory_points_effort_value  .  float
  end
  field  ros2trajectory.joint_trajectory_points_time_from_start_sec  time_from_start.sec  int
  field  ros2trajectory.joint_trajectory_points_time_from_start_nanosec  time_from_start.nanosec  int
end

kind      joint_trajectory_point
when      type  trajectory_msgs/msg/JointTrajectoryPoint
requires  ros2trajectory.joint_trajectory_point_positions
group  ros2trajectory.joint_trajectory_point_positions  msg.positions
  field  ros2trajectory.joint_trajectory_point_positions_value  .  float
end
group  ros2trajectory.joint_trajectory_point_velocities  msg.velocities
  field  ros2trajectory.joint_trajectory_point_velocities_value  .  float
end
group  ros2trajectory.joint_trajectory_point_accelerations  msg.accelerations
  field  ros2trajectory.joint_trajectory_point_accelerations_value  .  float
end
group  ros2trajectory.joint_trajectory_point_effort  msg.effort
  field  ros2trajectory.joint_trajectory_point_effort_value  .  float
end
field  ros2trajectory.joint_trajectory_point_time_from_start_sec  msg.time_from_start.sec  int
field  ros2trajectory.joint_trajectory_point_time_from_start_nanosec  msg.time_from_start.nanosec  int

kind      multi_dof_joint_trajectory
when      type  trajectory_msgs/msg/MultiDOFJointTrajectory
requires  ros2trajectory.multi_dof_joint_trajectory_header_stamp_sec
field  ros2trajectory.multi_dof_joint_trajectory_header_stamp_sec  msg.header.stamp.sec  int
field  ros2trajectory.multi_dof_joint_trajectory_header_stamp_nanosec  msg.header.stamp.nanosec  int
field  ros2trajectory.multi_dof_joint_trajectory_header_frame_id  msg.header.frame_id  string
group  ros2trajectory.multi_dof_joint_trajectory_joint_names  msg.joint_names
  field  ros2trajectory.multi_dof_joint_trajectory_joint_names_value  .  string
end
group  ros2trajectory.multi_dof_joint_trajectory_points  msg.points
  group  ros2trajectory.multi_dof_joint_trajectory_points_transforms  transforms
    field  ros2trajectory.multi_dof_joint_trajectory_points_transforms_translation_x  translation.x  float
    field  ros2trajectory.multi_dof_joint_trajectory_points_transforms_translation_y  translation.y  float
    field  ros2trajectory.multi_dof_joint_trajectory_points_transforms_translation_z  translation.z  float
    field  ros2trajectory.multi_dof_joint_trajectory_points_transforms_rotation_x  rotation.x  float
    field  ros2trajectory.multi_dof_joint_trajectory_points_transforms_rotation_y  rotation.y  float
    field  ros2trajectory.multi_dof_joint_trajectory_points_transforms_rotation_z  rotation.z  float
    field  ros2trajectory.multi_dof_joint_trajectory_points_transforms_rotation_w  rotation.w  float
  end
  group  ros2trajectory.multi_dof_joint_trajectory_points_velocities  velocities
    field  ros2trajectory.multi_dof_joint_trajectory_points_velocities_linear_x  linear.x  float
    field  ros2trajectory.multi_dof_joint_trajectory_points_velocities_linear_y  linear.y  float
    field  ros2trajectory.multi_dof_joint_trajectory_points_velocities_linear_z  linear.z  float
    field  ros2trajectory.multi_dof_joint_trajectory_points_velocities_angular_x  angular.x  float
    field  ros2trajectory.multi_dof_joint_trajectory_points_velocities_angular_y  angular.y  float
    field  ros2trajectory.multi_dof_joint_trajectory_points_velocities_angular_z  angular.z  float
  end
  group  ros2trajectory.multi_dof_joint_trajectory_points_accelerations  accelerations
    field  ros2trajectory.multi_dof_joint_trajectory_points_accelerations_linear_x  linear.x  float
    field  ros2trajectory.multi_dof_joint_trajectory_points_accelerations_linear_y  linear.y  float
    field  ros2trajectory.multi_dof_joint_trajectory_points_accelerations_linear_z  linear.z  float
    field  ros2trajectory.multi_dof_joint_trajectory_points_accelerations_angular_x  angular.x  float
    field  ros2trajectory.multi_dof_joint_trajectory_points_accelerations_angular_y  angular.y  float
    field  ros2trajectory.multi_dof_joint_trajectory_points_accelerations_angular_z  angular.z  float
  end
  field  ros2trajectory.multi_dof_joint_trajectory_points_time_from_start_sec  time_from_start.sec  int
  field  ros2trajectory.multi_dof_joint_trajectory_points_time_from_start_nanosec  time_from_start.nanosec  int
end

kind      multi_dof_joint_trajectory_point
when      type  trajectory_msgs/msg/MultiDOFJointTrajectoryPoint
requires  ros2trajectory.multi_dof_joint_trajectory_point_transforms
group  ros2trajectory.multi_dof_joint_trajectory_point_transforms  msg.transforms
  field  ros2trajectory.multi_dof_joint_trajectory_point_transforms_translation_x  translation.x  float
