  field  ros2trajectory.multi_dof_joint_trajectory_point_velocities_linear_z  linear.z  float
  field  ros2trajectory.multi_dof_joint_trajectory_point_velocities_angular_x  angular.x  float
  field  ros2trajectory.multi_dof_joint_trajectory_point_velocities_angular_y  angular.y  float
  field  ros2trajectory.multi_dof_joint_trajectory_point_velocities_angular_z  angular.z  float
end
group  ros2trajectory.multi_dof_joint_trajectory_point_accelerations  msg.accelerations
  field  ros2trajectory.multi_dof_joint_trajectory_point_accelerations_linear_x  linear.x  float
  field  ros2trajectory.multi_dof_joint_trajectory_point_accelerations_linear_y  linear.y  float
  field  ros2trajectory.multi_dof_joint_trajectory_point_accelerations_linear_z  linear.z  float
  field  ros2trajectory.multi_dof_joint_trajectory_point_accelerations_angular_x  angular.x  float
