# ROS 2 builtin_interfaces messages in the JSON form of a rosbridge `publish` operation.
# Generated by tools/gen/ros2msg2pack.py; do not edit by hand.
# One kind per .msg file, selected by the member `type` ("<package>/msg/<Name>").
# The ROS message is the object under `msg`; arrays are groups.
format        ros2-builtin-interfaces
version       0.1.0
distribution  public
source        "ROS 2 interface package builtin_interfaces, https://github.com/ros2/rcl_interfaces 2.0.4 (Apache License 2.0) at commit 7aa3caf43377ea6ad615bc1040832e2c7566bfbe, directory builtin_interfaces/msg; field names, types and array forms only"
source        "rosbridge v2.1.0 Protocol Specification, ROSBRIDGE_PROTOCOL.md, https://github.com/RobotWebTools/rosbridge_suite jazzy at commit cb33a16b890e4b8d9def531326409f3ee6c12537, BSD 3-Clause License; JSON form of a message and of the publish operation"
uses          ros2builtin
wire          json
when   op  publish
field  ros2builtin.topic  topic  string

kind      duration
when      type  builtin_interfaces/msg/Duration
requires  ros2builtin.duration_sec
field  ros2builtin.duration_sec  msg.sec  int
field  ros2builtin.duration_nanosec  msg.nanosec  int

kind      time
when      type  builtin_interfaces/msg/Time
requires  ros2builtin.time_sec
field  ros2builtin.time_sec  msg.sec  int
field  ros2builtin.time_nanosec  msg.nanosec  int
