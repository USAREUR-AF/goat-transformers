# One kind per .msg file, selected by the member `type` ("<package>/msg/<Name>").
# The ROS message is the object under `msg`; arrays are groups.
format        ros2-sbg-driver
version       0.1.0
distribution  public
source        "ROS 2 interface package sbg_driver, https://github.com/SBG-Systems/sbg_ros2_driver master (MIT License) at commit 3efaf2982a3eacbbdcf6ff7ef40116a36fb3b2cc, directory msg; field names, types and array forms only"
