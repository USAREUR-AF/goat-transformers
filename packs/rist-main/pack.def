# RIST main profile tunnel packet (VSF TR-06-2:2024): the GRE header with the RIST version, the
# VSF protocol header, reduced overhead data, keep-alive messages and full datagrams. Public.
# Written by tools/gen/media-pack.py; do not edit by hand. pack.md states what is mapped.
format        rist-main
version       0.1.0
distribution  public
source        "Video Services Forum, VSF TR-06-2:2024, Reliable Internet Stream Transport (RIST) Protocol Specification, Main Profile, 2024-06-12, https://static.vsf.tv/download/technical_recommendations/VSF_TR-06-2_2024_06_12.pdf (sha256 ebfc6b470ade396e4be0f83b869f4a13e604b2c05f8934aac00211a4cd82fdab), CC BY-ND 4.0; layout restated, the document not modified"
source        "IETF RFC 2784 and RFC 2890 (GRE, key and sequence number); the GRE header fields on the inet keys of gre-header"
uses          inet
uses          rist
wire          bits
layout        sequential
bit_order     msb

presence  c  1
field  inet.gre_bit1  1  uint
presence  ks  2
field  rist.reserved0_high  5  uint
field  rist.h  1  uint
field  rist.rv  3  uint
field  inet.gre_version  3  uint
field  inet.gre_protocol_type  16  uint
if  c.1
  field  inet.gre_checksum   16  uint
  field  inet.gre_reserved1  16  uint
end
if  ks.1
  field  inet.gre_key  32  uint
end
if  ks.2
  field  inet.gre_sequence  32  uint
end
switch  inet.gre_protocol_type
  case  52448                   # 0xCCE0, the VSF EtherType
    field  rist.vsf_protocol_type  16  uint
    field  rist.vsf_protocol_subtype  16  uint
    switch  rist.vsf_protocol_subtype
      case  0                 # reduced overhead
        field  rist.udp_source_port  16  uint
        field  rist.udp_destination_port  16  uint
        group  rist.payload  rest
          field  rist.octet  8  uint
        end
      case  32768             # keep-alive
        field  rist.mac_address  48  hex
        field  rist.cap_x  1  uint
        field  rist.cap_r  1  uint
        field  rist.cap_b  1  uint
        field  rist.cap_a  1  uint
        field  rist.cap_p  1  uint
        field  rist.cap_e  1  uint
        field  rist.cap_l  1  uint
        field  rist.cap_n  1  uint
        field  rist.cap_d  1  uint
        field  rist.cap_t  1  uint
        field  rist.cap_v  1  uint
        field  rist.cap_j  1  uint
        field  rist.cap_f  1  uint
        field  rist.cap_reserved  3  uint
        group  rist.json  rest
          field  rist.octet  8  uint
        end
      else
        group  rist.vsf_payload  rest
          field  rist.octet  8  uint
        end
    end
  case  34998                   # 0x88B6, reduced overhead, legacy
    field  rist.udp_source_port  16  uint
    field  rist.udp_destination_port  16  uint
    group  rist.payload  rest
      field  rist.octet  8  uint
    end
  case  34997                   # 0x88B5, keep-alive, legacy
    field  rist.mac_address  48  hex
    field  rist.cap_x  1  uint
    field  rist.cap_r  1  uint
    field  rist.cap_b  1  uint
    field  rist.cap_a  1  uint
    field  rist.cap_p  1  uint
    field  rist.cap_e  1  uint
    field  rist.cap_l  1  uint
    field  rist.cap_n  1  uint
    field  rist.cap_d  1  uint
    field  rist.cap_t  1  uint
    field  rist.cap_v  1  uint
    field  rist.cap_j  1  uint
    field  rist.cap_f  1  uint
    field  rist.cap_reserved  3  uint
    group  rist.json  rest
      field  rist.octet  8  uint
    end
  else
    group  rist.datagram  rest
      field  rist.octet  8  uint
    end
end
