# ROS 2 clearpath_control_msgs messages in the JSON form of a rosbridge `publish` operation.
# Generated by tools/gen/ros2msg2pack.py; do not edit by hand.
# One kind per .msg file, selected by the member `type` ("<package>/msg/<Name>").
# The ROS message is the object under `msg`; arrays are groups.
format        ros2-clearpath-control-msgs
version       0.1.0
distribution  public
source        "ROS 2 interface package clearpath_control_msgs, https://github.com/clearpathrobotics/clearpath_msgs jazzy (BSD 3-Clause License) at commit 0014d0afafea2715d1336ff58f2562450b6debda, directory clearpath_control_msgs/msg; field names, types and array forms only"
source        "rosbridge v2.1.0 Protocol Specification, ROSBRIDGE_PROTOCOL.md, https://github.com/RobotWebTools/rosbridge_suite jazzy at commit cb33a16b890e4b8d9def531326409f3ee6c12537, BSD 3-Clause License; JSON form of a message and of the publish operation"
uses          ros2clearpathcontrol
wire          json
when   op  publish
field  ros2clearpathcontrol.topic  topic  string

kind      device_info
when      type  clearpath_control_msgs/msg/DeviceInfo
requires  ros2clearpathcontrol.device_info_device_id
field  ros2clearpathcontrol.device_info_device_id  msg.device_id  string
field  ros2clearpathcontrol.device_info_device_class  msg.device_class  string
field  ros2clearpathcontrol.device_info_model  msg.model  string
field  ros2clearpathcontrol.device_info_manufacturer  msg.manufacturer  string
field  ros2clearpathcontrol.device_info_firmware_version  msg.firmware_version  string
field  ros2clearpathcontrol.device_info_hardware_version  msg.hardware_version  string
field  ros2clearpathcontrol.device_info_serial_number  msg.serial_number  string

kind      stream_control
when      type  clearpath_control_msgs/msg/StreamControl
requires  ros2clearpathcontrol.stream_control_stream
field  ros2clearpathcontrol.stream_control_stream  msg.stream  string
field  ros2clearpathcontrol.stream_control_enabled  msg.enabled  bool
