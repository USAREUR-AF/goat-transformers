# SBP frames of the package swiftnav.sbp.user whose payload length is not fixed,
# one kind per message. Generated by tools/gen/sbp2pack.py; do not edit by hand.
# The frame: preamble 0x55, message type (u16), sender (u16), length (u8),
# payload, without the CRC. The payload is a `length 8 bytes` extent; an array
# or text that runs to its end is a `rest` group (engine-spec 0.8, 0.21).
format        sbp-user-var
version       0.1.0
distribution  public
source        "https://github.com/swift-nav/libsbp spec/yaml/swiftnav/sbp/user.yaml at v6.5.2 (commit 925825dea5174f069b5d6e23548f213e09f0235c)"
uses          sbp
uses          sbpuser
wire          bits
layout        sequential
bit_order     lsb
when  8  85

kind  user_data
when  16  2048
requires  sbpuser.user_data_contents
field  sbp.sender  16  uint
length  8  bytes
  group  sbpuser.user_data_contents  rest
    field  sbpuser.user_data_contents_item  8  uint
  end
end
