# SBP frames of the package swiftnav.sbp.imu, one kind per message.
# Generated by tools/gen/sbp2pack.py; do not edit by hand.
# The message is one SBP frame from the preamble through the payload:
# preamble 0x55, message type (u16), sender (u16), length (u8), payload.
# The message carries no CRC: a framer adds and checks it. Payload bit 0 is bit 48.
format        sbp-imu
version       0.1.0
distribution  public
source        "https://github.com/swift-nav/libsbp spec/yaml/swiftnav/sbp/imu.yaml at v6.5.2 (commit 925825dea5174f069b5d6e23548f213e09f0235c)"
uses          sbp
uses          sbpimu
wire          bits
bit_order     lsb
word_bytes    1
when   0:0:8 85
field  sbp.sender 0:24:16 uint

kind      imu_raw
when      0:8:16 2304
when      0:40:8 17
requires  sbpimu.imu_raw_tow sbpimu.imu_raw_tow_f sbpimu.imu_raw_acc_x
