field     sbpimu.imu_raw_tow_f 0:80:8 uscale:1/256
field     sbpimu.imu_raw_acc_x 0:88:16 twos
field     sbpimu.imu_raw_acc_y 0:104:16 twos
field     sbpimu.imu_raw_acc_z 0:120:16 twos
field     sbpimu.imu_raw_gyr_x 0:136:16 twos
field     sbpimu.imu_raw_gyr_y 0:152:16 twos
field     sbpimu.imu_raw_gyr_z 0:168:16 twos

kind      imu_aux
when      0:8:16 2305
when      0:40:8 4
requires  sbpimu.imu_aux_imu_type sbpimu.imu_aux_temp sbpimu.imu_aux_imu_conf
field     sbpimu.imu_aux_imu_type 0:48:8 uint
field     sbpimu.imu_aux_temp 0:56:16 twos
field     sbpimu.imu_aux_imu_conf 0:72:8 uint

kind      imu_comp
when      0:8:16 2309
when      0:40:8 34
requires  sbpimu.imu_comp_time sbpimu.imu_comp_flags sbpimu.imu_comp_acc_comp_x
field     sbpimu.imu_comp_time 0:48:64 uint
field     sbpimu.imu_comp_flags 0:112:16 uint
field     sbpimu.imu_comp_acc_comp_x 0:128:32 sscale:1/1000000
field     sbpimu.imu_comp_acc_comp_y 0:160:32 sscale:1/1000000
field     sbpimu.imu_comp_acc_comp_z 0:192:32 sscale:1/1000000
field     sbpimu.imu_comp_gyr_comp_x 0:224:32 sscale:1/1000000
field     sbpimu.imu_comp_gyr_comp_y 0:256:32 sscale:1/1000000
field     sbpimu.imu_comp_gyr_comp_z 0:288:32 sscale:1/1000000
