# ROS 2 nav2_msgs messages in the JSON form of a rosbridge `publish` operation.
# Generated by tools/gen/ros2msg2pack.py; do not edit by hand.
# One kind per .msg file, selected by the member `type` ("<package>/msg/<Name>").
# The ROS message is the object under `msg`; arrays are groups.
format        ros2-nav2-msgs
version       0.1.0
distribution  public
source        "ROS 2 interface package nav2_msgs, https://github.com/ros-navigation/navigation2 jazzy (Apache-2.0 or BSD-3-Clause per package.xml) at commit c7046550547d382a5186d106b0895eda02485d7c, directory nav2_msgs/msg; field names, types and array forms only"
