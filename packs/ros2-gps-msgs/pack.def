# One kind per .msg file, selected by the member `type` ("<package>/msg/<Name>").
# The ROS message is the object under `msg`; arrays are groups.
format        ros2-gps-msgs
version       0.1.0
distribution  public
source        "ROS 2 interface package gps_msgs, https://github.com/swri-robotics/gps_umd ros2-devel (BSD License) at commit 94d2b361be86198a8029def6677cee8e4a82189b, directory gps_msgs/msg; field names, types and array forms only"
