# Conformance probe pack for `length ... whole` (spec 0.8), most significant
# bit first. Public. No kinds.
#
#   byte 0      n
#   byte 1      the length of the whole message in bytes, minus 1 (`plus -1`)
#   byte 2      x
#   then        one bit that says whether y follows, y in 7 bits
#
# Decode ignores input beyond the stated length; input shorter than it is
# `malformed-wire`.
format     conformance-seq-whole
version    0.8.0
distribution public
source  "goat-transformers spec/engine-spec.md (synthetic probe format, no external standard)"
uses       probe
wire       bits
layout     sequential
bit_order  msb
field   probe.n  8  uint
length 8 whole plus -1
field   probe.x  8  uint
opt
  field  probe.y  7  uint
end
