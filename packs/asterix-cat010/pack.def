# ASTERIX Category 010, Transmission of Monosensor Surface Movement Data, edition 1.1: one data block holding one record.
# Public. Generated by tools/gen/asterix2pack.py from the category definition of
# github.com/zoranbosnjak/asterix-specs (BSD-3-Clause); do not edit by hand. I/O is hex text.
# Needs engine version 0.8 (`layout sequential`). See pack.md.
#
#   octet 1       CAT = 10
#   octets 2-3    LEN, the length of the data block in octets, CAT and LEN included
#   FSPEC         octets of 7 presence bits and an extension bit; bit n is FRN n
#   then          the items whose FSPEC bit is 1, in FRN order
#
# An FRN with no `if` block is not mapped: a record with that FSPEC bit set fails
# with `malformed-wire` (ruling 1 of engine-spec 0.8), and encode never sets the bit.
format     asterix-cat010
version    0.1.0
distribution public
source  "ASTERIX Category 010, Transmission of Monosensor Surface Movement Data, edition 1.1 (2007-03-01), as transcribed in github.com/zoranbosnjak/asterix-specs (BSD-3-Clause), commit 64e9ffba964b92a1af3157bc6bdf7852a63bf700, specs/cat010/cats/cat1.1/definition.json. The category is specified by EUROCONTROL"
uses       cat010
wire       bits
layout     sequential
bit_order  msb
kind    record
when    8  10                              # CAT
length  16 whole                         # LEN
presence f fx
if f.1                                   # FRN 1, I010/010 Data Source Identifier
  field  cat010.i010_sac  8  uint
  field  cat010.i010_sic  8  uint
end
if f.2                                   # FRN 2, I010/000 Message Type
  field  cat010.i000  8  uint
end
if f.3                                   # FRN 3, I010/020 Target Report Descriptor
  chain
    field  cat010.i020_typ  3  uint
    field  cat010.i020_dcr  1  uint
    field  cat010.i020_chn  1  uint
    field  cat010.i020_gbs  1  uint
    field  cat010.i020_crt  1  uint
    fx
    field  cat010.i020_sim  1  uint
    field  cat010.i020_tst  1  uint
    field  cat010.i020_rab  1  uint
    field  cat010.i020_lop  2  uint
    field  cat010.i020_tot  2  uint
    fx
    field  cat010.i020_spi  1  uint
    pad    6
    fx
  end
end
if f.4                                   # FRN 4, I010/140 Time of Day
  field  cat010.i140  24  uscale:1/128
end
if f.5                                   # FRN 5, I010/041 Position in WGS-84 Co-ordinates
  field  lat  32  sscale:45/536870912
  also   cat010.i041_lat
  field  lon  32  sscale:45/536870912
  also   cat010.i041_lon
end
if f.6                                   # FRN 6, I010/040 Measured Position in Polar Co-ordinates
  field  cat010.i040_rho  16  uscale:1
  field  cat010.i040_th  16  uscale:45/8192
end
if f.7                                   # FRN 7, I010/042 Position in Cartesian Co-ordinates
  field  cat010.i042_x  16  sscale:1
  field  cat010.i042_y  16  sscale:1
end
if f.8                                   # FRN 8, I010/200 Calculated Track Velocity in Polar Co-ordinates
  field  speed_ms  16  uscale:463/4096
  field  cat010.i200_tra  16  uscale:45/8192
end
if f.9                                   # FRN 9, I010/202 Calculated Track Velocity in Cartesian Co-ordinates
  field  cat010.i202_vx  16  sscale:1/16
  field  cat010.i202_vy  16  sscale:1/16
end
if f.10                                  # FRN 10, I010/161 Track Number
  pad    4
  field  cat010.i161_trk  12  uint
end
if f.11                                  # FRN 11, I010/170 Track Status
  chain
    field  cat010.i170_cnf  1  uint
    field  cat010.i170_tre  1  uint
    field  cat010.i170_cst  2  uint
    field  cat010.i170_mah  1  uint
    field  cat010.i170_tcc  1  uint
    field  cat010.i170_sth  1  uint
    fx
    field  cat010.i170_tom  2  uint
    field  cat010.i170_dou  3  uint
    field  cat010.i170_mrs  2  uint
    fx
    field  cat010.i170_gho  1  uint
    pad    6
    fx
  end
end
if f.12                                  # FRN 12, I010/060 Mode-3/A Code in Octal Representation
  field  cat010.i060_v  1  uint
  field  cat010.i060_g  1  uint
  field  cat010.i060_l  1  uint
  pad    1
  field  cat010.i060_mode3a  12  uint
end
if f.13                                  # FRN 13, I010/220 Target Address
  field  cat010.i220  24  uint
end
if f.14                                  # FRN 14, I010/245 Target Identification
  field  cat010.i245_sti  2  uint
  pad    6
  field  cat010.i245_chr  48  uint
end
if f.15                                  # FRN 15, I010/250 Mode S MB Data
  group  cat010.i250  count 8
    field  cat010.i250_mbdata  56  uint
    field  cat010.i250_bds1  4  uint
    field  cat010.i250_bds2  4  uint
  end
end
if f.16                                  # FRN 16, I010/300 Vehicle Fleet Identification
  field  cat010.i300  8  uint
end
if f.17                                  # FRN 17, I010/090 Flight Level in Binary Representation
  field  cat010.i090_v  1  uint
  field  cat010.i090_g  1  uint
  field  cat010.i090_fl  14  sscale:1/4
end
if f.18                                  # FRN 18, I010/091 Measured Height
  field  cat010.i091  16  sscale:25/4
end
if f.19                                  # FRN 19, I010/270 Target Size and Orientation
  chain
    field  cat010.i270_length  7  uscale:1
    fx
    field  cat010.i270_orientation  7  uscale:45/16
    fx
    field  cat010.i270_width  7  uscale:1
    fx
  end
end
if f.20                                  # FRN 20, I010/550 System Status
  field  cat010.i550_nogo  2  uint
  field  cat010.i550_ovl  1  uint
  field  cat010.i550_tsv  1  uint
  field  cat010.i550_div  1  uint
  field  cat010.i550_ttf  1  uint
  pad    2
end
if f.21                                  # FRN 21, I010/310 Pre-programmed Message
  field  cat010.i310_trb  1  uint
  field  cat010.i310_msg  7  uint
end
if f.22                                  # FRN 22, I010/500 Standard Deviation of Position
  field  cat010.i500_devx  8  uscale:1/4
  field  cat010.i500_devy  8  uscale:1/4
  field  cat010.i500_covxy  16  sscale:1/4
end
if f.23                                  # FRN 23, I010/280 Presence
  group  cat010.i280  count 8
    field  cat010.i280_drho  8  sscale:1
    field  cat010.i280_dtheta  8  sscale:3/20
  end
end
if f.24                                  # FRN 24, I010/131 Amplitude of Primary Plot
  field  cat010.i131  8  uint
end
if f.25                                  # FRN 25, I010/210 Calculated Acceleration
  field  cat010.i210_ax  8  sscale:1/16
  field  cat010.i210_ay  8  sscale:1/16
end
# FRN 26: spare FRN
if f.27                                  # FRN 27, I010/SP Special Purpose Field
  length 8 bytes plus 1                # the length octet counts itself; the content is not mapped
  end
end
if f.28                                  # FRN 28, I010/RE Reserved Expansion Field
  length 8 bytes plus 1                # the length octet counts itself; the content is not mapped
  end
end
