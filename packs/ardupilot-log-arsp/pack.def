# ArduPilot log message ARSP as the payload of a DataFlash log record.
# Generated by tools/gen/aplog2pack.py; do not edit by hand.
# The record without its 3-byte header (0xA3 0x95 type-id); fields packed, little-endian.
format        ardupilot-log-arsp
version       0.1.0
distribution  public
source        "ArduPilot log message definitions (log structure tables and Write calls), https://github.com/ArduPilot/ardupilot at tag Copter-4.6.2, commit 1ebd4d996e8b6bbeb1462a9655c00aa861d5beef; message names, format strings, labels, units and multipliers only; GNU General Public License, version 3"
source        "ArduPilot libraries/AP_Logger/LogStructure.h: the format characters, units and multipliers of a log message, at the same commit"
uses          aplog
wire          bits
bit_order     lsb
word_bytes    1
field  aplog.arsp_timeus  0:0:64  uint
field  aplog.arsp_i  0:64:8  uint
field  aplog.arsp_airspeed  0:72:32  f32
field  aplog.arsp_diffpress  0:104:32  f32
field  aplog.arsp_temp  0:136:16  twos
field  aplog.arsp_rawpress  0:152:32  f32
field  aplog.arsp_offset  0:184:32  f32
field  aplog.arsp_u  0:216:8  uint
field  aplog.arsp_h  0:224:8  uint
field  aplog.arsp_hp  0:232:32  f32
field  aplog.arsp_tr  0:264:32  f32
field  aplog.arsp_pri  0:296:8  uint
