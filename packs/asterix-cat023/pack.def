# ASTERIX Category 023, CNS/ATM Ground Station and Service Status Reports, edition 1.3: one data block holding one record.
# Public. Generated by tools/gen/asterix2pack.py from the category definition of
# github.com/zoranbosnjak/asterix-specs (BSD-3-Clause); do not edit by hand. I/O is hex text.
# Needs engine version 0.8 (`layout sequential`). See pack.md.
#
#   octet 1       CAT = 23
#   octets 2-3    LEN, the length of the data block in octets, CAT and LEN included
#   FSPEC         octets of 7 presence bits and an extension bit; bit n is FRN n
#   then          the items whose FSPEC bit is 1, in FRN order
#
# An FRN with no `if` block is not mapped: a record with that FSPEC bit set fails
# with `malformed-wire` (ruling 1 of engine-spec 0.8), and encode never sets the bit.
format     asterix-cat023
version    0.1.0
distribution public
source  "ASTERIX Category 023, CNS/ATM Ground Station and Service Status Reports, edition 1.3 (2021-09-27), as transcribed in github.com/zoranbosnjak/asterix-specs (BSD-3-Clause), commit 64e9ffba964b92a1af3157bc6bdf7852a63bf700, specs/cat023/cats/cat1.3/definition.json. The category is specified by EUROCONTROL"
uses       cat023
wire       bits
layout     sequential
bit_order  msb
kind    record
when    8  23                              # CAT
length  16 whole                         # LEN
presence f fx
if f.1                                   # FRN 1, I023/010 Data Source Identifier
  field  cat023.i010_sac  8  uint
  field  cat023.i010_sic  8  uint
end
if f.2                                   # FRN 2, I023/000 Report Type
  field  cat023.i000  8  uint
end
if f.3                                   # FRN 3, I023/015 Service Type and Identification
  field  cat023.i015_sid  4  uint
  field  cat023.i015_styp  4  uint
end
if f.4                                   # FRN 4, I023/070 Time of Day
  field  cat023.i070  24  uscale:1/128
end
if f.5                                   # FRN 5, I023/100 Ground Station Status
  chain
    field  cat023.i100_nogo  1  uint
    field  cat023.i100_odp  1  uint
    field  cat023.i100_oxt  1  uint
    field  cat023.i100_msc  1  uint
    field  cat023.i100_tsv  1  uint
    field  cat023.i100_spo  1  uint
    field  cat023.i100_rn  1  uint
    fx
    field  cat023.i100_gssp  7  uscale:1
    fx
  end
end
if f.6                                   # FRN 6, I023/101 Service Configuration
  chain
    field  cat023.i101_rp  8  uscale:1/2
    field  cat023.i101_sc  3  uint
    pad    4
    fx
    field  cat023.i101_ssrp  7  uscale:1
    fx
  end
end
if f.7                                   # FRN 7, I023/200 Operational Range
  field  cat023.i200  8  uscale:1
end
if f.8                                   # FRN 8, I023/110 Service Status
  chain
    pad    4
    field  cat023.i110_stat  3  uint
    fx
  end
end
if f.9                                   # FRN 9, I023/120 Service Statistics
  group  cat023.i120  count 8
    field  cat023.i120_type  8  uint
    field  cat023.i120_ref  1  uint
    pad    7
    field  cat023.i120_cv  32  uint
  end
end
# FRN 10: spare FRN
# FRN 11: spare FRN
# FRN 12: spare FRN
if f.13                                  # FRN 13, I023/RE Reserved Expansion Field
  length 8 bytes plus 1                # the length octet counts itself; the content is not mapped
  end
end
if f.14                                  # FRN 14, I023/SP Special Purpose Field
  length 8 bytes plus 1                # the length octet counts itself; the content is not mapped
  end
end
