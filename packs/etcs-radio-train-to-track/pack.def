    field  etcs.tp44_nid_xuser  9  uint
    group  etcs.tp44_data  rest
      field  etcs.tp44_data_bit  1  uint
    end
  end
  kind  tother
  field  etcs.train_nid_packet  8  uint
  length  13  bits  plus 21
    group  etcs.train_other_packet_bits  rest
      field  etcs.train_other_packet_bit  1  uint
    end
  end
end

