    field  etcs.tp11_v_maxtrain  7  uint
    field  etcs.tp11_m_loadinggauge  8  uint
    field  etcs.tp11_m_axleloadcat  7  uint
    field  etcs.tp11_m_airtight  2  uint
    field  etcs.tp11_n_axle  10  uint
