# An ERTMS/ETCS radio message from the train to the RBC. Public.
format        etcs-radio-train-to-track
version       0.1.0
distribution  public
source        "ERA SUBSET-026 (ERTMS/ETCS System Requirements Specification) issue 3.6.0, 13/05/2016, chapter 7 (ERTMS/ETCS language: packets and variables) and chapter 8 (messages), from the CCS TSI set of specifications 3 published by the European Union Agency for Railways (era.europa.eu); no licence stated; layouts restated"
uses          etcs
wire          bits
layout        sequential
bit_order     msb

kind  ma_request
when  8  132
requires  etcs.tm132_q_marqstreason
length  10  whole                    # L_MESSAGE, bytes of the whole message
field  etcs.train_t_train  32  uint
field  etcs.nid_engine  24  uint
field  etcs.tm132_q_marqstreason  5  uint
group  etcs.train_packets  rest
  kind  tp0
  when  8  0
  length  13  bits  plus 21           # L_PACKET counts NID_PACKET and itself (no Q_DIR train to track)
    field  etcs.tp0_q_scale  2  uint
    field  etcs.tp0_lrbg_nid_c  10  uint
    field  etcs.tp0_lrbg_nid_bg  14  uint
    field  etcs.tp0_d_lrbg  15  uint
    field  etcs.tp0_q_dirlrbg  2  uint
    field  etcs.tp0_q_dlrbg  2  uint
    field  etcs.tp0_l_doubtover  15  uint
    field  etcs.tp0_l_doubtunder  15  uint
    field  etcs.tp0_q_length  2  uint
    switch  etcs.tp0_q_length
      case  1,2
        field  etcs.tp0_l_trainint  15  uint
      else
    end
    field  etcs.tp0_v_train  7  uint
    field  etcs.tp0_q_dirtrain  2  uint
    field  etcs.tp0_m_mode  4  uint
    field  etcs.tp0_m_level  3  uint
    switch  etcs.tp0_m_level
      case  1
        field  etcs.tp0_nid_ntc  8  uint
      else
    end
  end
  kind  tp1
  when  8  1
  length  13  bits  plus 21           # L_PACKET counts NID_PACKET and itself (no Q_DIR train to track)
    field  etcs.tp1_q_scale  2  uint
    field  etcs.tp1_lrbg_nid_c  10  uint
    field  etcs.tp1_lrbg_nid_bg  14  uint
    field  etcs.tp1_prvlrbg_nid_c  10  uint
    field  etcs.tp1_prvlrbg_nid_bg  14  uint
    field  etcs.tp1_d_lrbg  15  uint
    field  etcs.tp1_q_dirlrbg  2  uint
    field  etcs.tp1_q_dlrbg  2  uint
    field  etcs.tp1_l_doubtover  15  uint
    field  etcs.tp1_l_doubtunder  15  uint
    field  etcs.tp1_q_length  2  uint
    switch  etcs.tp1_q_length
      case  1,2
        field  etcs.tp1_l_trainint  15  uint
      else
    end
    field  etcs.tp1_v_train  7  uint
    field  etcs.tp1_q_dirtrain  2  uint
    field  etcs.tp1_m_mode  4  uint
    field  etcs.tp1_m_level  3  uint
    switch  etcs.tp1_m_level
      case  1
        field  etcs.tp1_nid_ntc  8  uint
      else
    end
  end
  kind  tp2
  when  8  2
  length  13  bits  plus 21           # L_PACKET counts NID_PACKET and itself (no Q_DIR train to track)
    field  etcs.tp2_m_version  7  uint
    group  etcs.tp2_versions  count 5                 # N_ITER
      field  etcs.tp2_versions_m_version  7  uint
    end
  end
  kind  tp4
  when  8  4
  length  13  bits  plus 21           # L_PACKET counts NID_PACKET and itself (no Q_DIR train to track)
    field  etcs.tp4_m_error  8  uint
  end
  kind  tp5
