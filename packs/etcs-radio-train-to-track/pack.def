    field  etcs.tp9_ltrbg_nid_c  10  uint
    field  etcs.tp9_ltrbg_nid_bg  14  uint
  end
  kind  tp11
  when  8  11
  length  13  bits  plus 21           # L_PACKET counts NID_PACKET and itself (no Q_DIR train to track)
    field  etcs.tp11_nc_cdtrain  4  uint
    field  etcs.tp11_nc_train  15  uint
