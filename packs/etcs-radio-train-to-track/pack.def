      field  etcs.tp11_tractions_m_voltage  4  uint
      switch  etcs.tp11_tractions_m_voltage
        case  0
        else
          field  etcs.tp11_tractions_nid_ctraction  10  uint
      end
    end
    group  etcs.tp11_ntcs  count 5                 # N_ITER
      field  etcs.tp11_ntcs_nid_ntc  8  uint
    end
  end
  kind  tp44
  when  8  44
