# Conformance probe pack used as an inner pack (spec 0.34):
# x, a whole length plus -1, y. Public.
format     conformance-inner-whlminus
version    0.34.0
distribution public
source  "goat-transformers spec/engine-spec.md (synthetic probe format, no external standard)"
uses       probe
wire       bits
layout     sequential
bit_order  msb
field   probe.x  8  uint
length  8  whole  plus -1
field   probe.y  8  uint
