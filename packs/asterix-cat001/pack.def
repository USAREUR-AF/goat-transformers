# ASTERIX Category 001, Transmission of Monoradar Data Target Reports, edition 1.4: one data block holding one record.
# Public. Generated by tools/gen/asterix2pack.py from the category definition of
# github.com/zoranbosnjak/asterix-specs (BSD-3-Clause); do not edit by hand. I/O is hex text.
# Needs engine version 0.20 (`switch`). See pack.md.
#
#   octet 1       CAT = 1
#   octets 2-3    LEN, the length of the data block in octets, CAT and LEN included
#   FSPEC         octets of 7 presence bits and an extension bit; bit n is FRN n
#   then          the items whose FSPEC bit is 1, in FRN order
#
# An FRN with no `if` block is not mapped: a record with that FSPEC bit set fails
# with `malformed-wire` (ruling 1 of engine-spec 0.8), and encode never sets the bit.
# The category has 2 UAPs. The items up to I001/020 are the same in each; after them
# a `switch` on I001/020/TYP (engine-spec 0.20) reads the items of the UAP it selects, and
# only the `if` lines of that case name FSPEC bits.
format     asterix-cat001
version    0.1.0
distribution public
source  "ASTERIX Category 001, Transmission of Monoradar Data Target Reports, edition 1.4 (2022-08-18), as transcribed in github.com/zoranbosnjak/asterix-specs (BSD-3-Clause), commit 64e9ffba964b92a1af3157bc6bdf7852a63bf700, specs/cat001/cats/cat1.4/definition.json. The category is specified by EUROCONTROL"
uses       cat001
wire       bits
layout     sequential
bit_order  msb
kind    record
when    8  1                              # CAT
length  16 whole                         # LEN
presence f fx
if f.1                                   # FRN 1, I001/010 Data Source Identifier
  field  cat001.i010_sac  8  uint
  field  cat001.i010_sic  8  uint
end
if f.2                                   # FRN 2, I001/020 Target Report Descriptor
  chain
    field  cat001.i020_typ  1  uint
    field  cat001.i020_sim  1  uint
    field  cat001.i020_ssrpsr  2  uint
    field  cat001.i020_ant  1  uint
    field  cat001.i020_spi  1  uint
    field  cat001.i020_rab  1  uint
    fx
    field  cat001.i020_tst  1  uint
    field  cat001.i020_ds1ds2  2  uint
    field  cat001.i020_me  1  uint
    field  cat001.i020_mi  1  uint
    pad    2
    fx
  end
end
switch cat001.i020_typ                   # the UAP, chosen by I001/020/TYP (engine-spec 0.20)
  case 1                                 # UAP `track`
    if f.3                               # FRN 3, I001/161 Track Plot Number
      field  cat001.i161  16  uint
    end
    if f.4                               # FRN 4, I001/040 Measured Position in Polar Co-ordinates
      field  cat001.i040_rho  16  uscale:1/128
      field  cat001.i040_theta  16  uscale:45/8192
    end
    if f.5                               # FRN 5, I001/042 Calculated Position in Cartesian Co-ordinates
      field  cat001.i042_x  16  sscale:1/64
      field  cat001.i042_y  16  sscale:1/64
    end
    if f.6                               # FRN 6, I001/200 Calculated Track Velocity in Polar Co-ordinates
      field  speed_ms  16  uscale:463/4096
      field  cat001.i200_hdg  16  uscale:45/8192
    end
    if f.7                               # FRN 7, I001/070 Mode-3/A Code in Octal Representation
      field  cat001.i070_v  1  uint
      field  cat001.i070_g  1  uint
      field  cat001.i070_l  1  uint
      pad    1
      field  cat001.i070_mode3a  12  uint
    end
    if f.8                               # FRN 8, I001/090 Mode-C Code in Binary Representation
      field  cat001.i090_v  1  uint
      field  cat001.i090_g  1  uint
      field  cat001.i090_hgt  14  sscale:1/4
    end
    if f.9                               # FRN 9, I001/141 Truncated Time of Day
      field  cat001.i141  16  uscale:1/128
    end
    if f.10                              # FRN 10, I001/130 Radar Plot Characteristics
      group  cat001.i130  fx
        field  cat001.i130_val  7  uint
      end
    end
    if f.11                              # FRN 11, I001/131 Received Power
      field  cat001.i131  8  sscale:1
    end
    if f.12                              # FRN 12, I001/120 Measured Radial Doppler Speed
      field  cat001.i120  8  sscale:1/256
    end
    if f.13                              # FRN 13, I001/170 Track Status
      chain
        field  cat001.i170_con  1  uint
        field  cat001.i170_rad  1  uint
        field  cat001.i170_man  1  uint
        field  cat001.i170_dou  1  uint
        field  cat001.i170_rdpc  1  uint
        pad    1
        field  cat001.i170_gho  1  uint
        fx
        field  cat001.i170_tre  1  uint
        pad    6
        fx
      end
    end
    if f.14                              # FRN 14, I001/210 Track Quality
      group  cat001.i210  fx
        field  cat001.i210_val  7  uint
      end
    end
    if f.15                              # FRN 15, I001/050 Mode-2 Code in Octal Representation
      field  cat001.i050_v  1  uint
      field  cat001.i050_g  1  uint
      field  cat001.i050_l  1  uint
      pad    1
      field  cat001.i050_mode2  12  uint
    end
    if f.16                              # FRN 16, I001/080 Mode-3/A Code Confidence Indicator
      pad    4
      field  cat001.i080_qa4  1  uint
      field  cat001.i080_qa2  1  uint
      field  cat001.i080_qa1  1  uint
      field  cat001.i080_qb4  1  uint
      field  cat001.i080_qb2  1  uint
      field  cat001.i080_qb1  1  uint
      field  cat001.i080_qc4  1  uint
      field  cat001.i080_qc2  1  uint
      field  cat001.i080_qc1  1  uint
      field  cat001.i080_qd4  1  uint
      field  cat001.i080_qd2  1  uint
      field  cat001.i080_qd1  1  uint
    end
    if f.17                              # FRN 17, I001/100 Mode-C Code and Code Confidence Indicator
      field  cat001.i100_v  1  uint
      field  cat001.i100_g  1  uint
      pad    2
      field  cat001.i100_modec  12  uint
      pad    4
      field  cat001.i100_qc1  1  uint
      field  cat001.i100_qa1  1  uint
      field  cat001.i100_qc2  1  uint
      field  cat001.i100_qa2  1  uint
      field  cat001.i100_qc4  1  uint
      field  cat001.i100_qa4  1  uint
      field  cat001.i100_qb1  1  uint
      field  cat001.i100_qd1  1  uint
      field  cat001.i100_qb2  1  uint
      field  cat001.i100_qd2  1  uint
      field  cat001.i100_qb4  1  uint
      field  cat001.i100_qd4  1  uint
    end
    if f.18                              # FRN 18, I001/060 Mode-2 Code Confidence Indicator
      pad    4
      field  cat001.i060_qa4  1  uint
      field  cat001.i060_qa2  1  uint
      field  cat001.i060_qa1  1  uint
      field  cat001.i060_qb4  1  uint
      field  cat001.i060_qb2  1  uint
      field  cat001.i060_qb1  1  uint
      field  cat001.i060_qc4  1  uint
      field  cat001.i060_qc2  1  uint
      field  cat001.i060_qc1  1  uint
      field  cat001.i060_qd4  1  uint
      field  cat001.i060_qd2  1  uint
      field  cat001.i060_qd1  1  uint
    end
    if f.19                              # FRN 19, I001/030 Warning/Error Conditions
      group  cat001.i030  fx
        field  cat001.i030_val  7  uint
      end
    end
    if f.20                              # FRN 20, I001/SP Special Purpose Field
      length 8 bytes plus 1                # the length octet counts itself; the content is not mapped
      end
    end
    # FRN 21: random field sequencing: the items that follow name themselves by FRN, in any order
    if f.22                              # FRN 22, I001/150 Presence of X-Pulse
      field  cat001.i150_xa  1  uint
      pad    1
      field  cat001.i150_xc  1  uint
      pad    2
      field  cat001.i150_x2  1  uint
      pad    2
    end
  else                                   # UAP `plot`: I001/020/TYP = 0, or I001/020 absent
    if f.3                               # FRN 3, I001/040 Measured Position in Polar Co-ordinates
      field  cat001.i040_rho  16  uscale:1/128
      field  cat001.i040_theta  16  uscale:45/8192
    end
    if f.4                               # FRN 4, I001/070 Mode-3/A Code in Octal Representation
      field  cat001.i070_v  1  uint
      field  cat001.i070_g  1  uint
      field  cat001.i070_l  1  uint
      pad    1
      field  cat001.i070_mode3a  12  uint
    end
    if f.5                               # FRN 5, I001/090 Mode-C Code in Binary Representation
      field  cat001.i090_v  1  uint
      field  cat001.i090_g  1  uint
      field  cat001.i090_hgt  14  sscale:1/4
    end
    if f.6                               # FRN 6, I001/130 Radar Plot Characteristics
      group  cat001.i130  fx
        field  cat001.i130_val  7  uint
      end
    end
    if f.7                               # FRN 7, I001/141 Truncated Time of Day
      field  cat001.i141  16  uscale:1/128
    end
    if f.8                               # FRN 8, I001/050 Mode-2 Code in Octal Representation
      field  cat001.i050_v  1  uint
      field  cat001.i050_g  1  uint
      field  cat001.i050_l  1  uint
      pad    1
      field  cat001.i050_mode2  12  uint
    end
    if f.9                               # FRN 9, I001/120 Measured Radial Doppler Speed
      field  cat001.i120  8  sscale:1/256
    end
    if f.10                              # FRN 10, I001/131 Received Power
      field  cat001.i131  8  sscale:1
    end
    if f.11                              # FRN 11, I001/080 Mode-3/A Code Confidence Indicator
      pad    4
      field  cat001.i080_qa4  1  uint
      field  cat001.i080_qa2  1  uint
      field  cat001.i080_qa1  1  uint
      field  cat001.i080_qb4  1  uint
      field  cat001.i080_qb2  1  uint
      field  cat001.i080_qb1  1  uint
      field  cat001.i080_qc4  1  uint
      field  cat001.i080_qc2  1  uint
      field  cat001.i080_qc1  1  uint
      field  cat001.i080_qd4  1  uint
      field  cat001.i080_qd2  1  uint
      field  cat001.i080_qd1  1  uint
    end
    if f.12                              # FRN 12, I001/100 Mode-C Code and Code Confidence Indicator
      field  cat001.i100_v  1  uint
      field  cat001.i100_g  1  uint
      pad    2
      field  cat001.i100_modec  12  uint
      pad    4
      field  cat001.i100_qc1  1  uint
      field  cat001.i100_qa1  1  uint
      field  cat001.i100_qc2  1  uint
      field  cat001.i100_qa2  1  uint
      field  cat001.i100_qc4  1  uint
      field  cat001.i100_qa4  1  uint
      field  cat001.i100_qb1  1  uint
      field  cat001.i100_qd1  1  uint
      field  cat001.i100_qb2  1  uint
      field  cat001.i100_qd2  1  uint
      field  cat001.i100_qb4  1  uint
      field  cat001.i100_qd4  1  uint
    end
    if f.13                              # FRN 13, I001/060 Mode-2 Code Confidence Indicator
      pad    4
      field  cat001.i060_qa4  1  uint
      field  cat001.i060_qa2  1  uint
      field  cat001.i060_qa1  1  uint
      field  cat001.i060_qb4  1  uint
      field  cat001.i060_qb2  1  uint
      field  cat001.i060_qb1  1  uint
      field  cat001.i060_qc4  1  uint
      field  cat001.i060_qc2  1  uint
      field  cat001.i060_qc1  1  uint
      field  cat001.i060_qd4  1  uint
      field  cat001.i060_qd2  1  uint
      field  cat001.i060_qd1  1  uint
    end
    if f.14                              # FRN 14, I001/030 Warning/Error Conditions
      group  cat001.i030  fx
