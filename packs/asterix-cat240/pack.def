# ASTERIX Category 240, Radar Video Transmission, edition 1.3: one data block holding one record.
# Public. Generated by tools/gen/asterix2pack.py from the category definition of
# github.com/zoranbosnjak/asterix-specs (BSD-3-Clause); do not edit by hand. I/O is hex text.
# Needs engine version 0.8 (`layout sequential`). See pack.md.
#
#   octet 1       CAT = 240
#   octets 2-3    LEN, the length of the data block in octets, CAT and LEN included
#   FSPEC         octets of 7 presence bits and an extension bit; bit n is FRN n
#   then          the items whose FSPEC bit is 1, in FRN order
#
# An FRN with no `if` block is not mapped: a record with that FSPEC bit set fails
# with `malformed-wire` (ruling 1 of engine-spec 0.8), and encode never sets the bit.
format     asterix-cat240
version    0.1.0
distribution public
source  "ASTERIX Category 240, Radar Video Transmission, edition 1.3 (2015-05-13), as transcribed in github.com/zoranbosnjak/asterix-specs (BSD-3-Clause), commit 64e9ffba964b92a1af3157bc6bdf7852a63bf700, specs/cat240/cats/cat1.3/definition.json. The category is specified by EUROCONTROL"
uses       cat240
wire       bits
layout     sequential
bit_order  msb
kind    record
when    8  240                              # CAT
length  16 whole                         # LEN
presence f fx
if f.1                                   # FRN 1, I240/010 Data Source Identifier
  field  cat240.i010_sac  8  uint
  field  cat240.i010_sic  8  uint
end
if f.2                                   # FRN 2, I240/000 Message Type
  field  cat240.i000  8  uint
end
if f.3                                   # FRN 3, I240/020 Video Record Header
  field  cat240.i020  32  uint
end
if f.4                                   # FRN 4, I240/030 Video Summary
  group  cat240.i030  count 8
    field  cat240.i030_val  8  ascii
  end
end
if f.5                                   # FRN 5, I240/040 Video Header Nano
  field  cat240.i040_startaz  16  uscale:45/8192
  field  cat240.i040_endaz  16  uscale:45/8192
  field  cat240.i040_startrg  32  uint
  field  cat240.i040_celldur  32  uscale:1
end
if f.6                                   # FRN 6, I240/041 Video Header Femto
  field  cat240.i041_startaz  16  uscale:45/8192
  field  cat240.i041_endaz  16  uscale:45/8192
  field  cat240.i041_startrg  32  uint
  field  cat240.i041_celldur  32  uscale:1
end
if f.7                                   # FRN 7, I240/048 Video Cells Resolution & Data Compression Indicator
  field  cat240.i048_c  1  uint
  pad    7
  field  cat240.i048_res  8  uint
end
if f.8                                   # FRN 8, I240/049 Video Octets & Video Cells Counters
  field  cat240.i049_nbvb  16  uint
  field  cat240.i049_nbcells  24  uint
end
if f.9                                   # FRN 9, I240/050 Video Block Low Data Volume
  group  cat240.i050  count 8
    field  cat240.i050_val  32  uint
  end
end
# FRN 10: I240/051 Video Block Medium Data Volume, not mapped: an element of 512 bits (a field holds at most 64)
# FRN 11: I240/052 Video Block High Data Volume, not mapped: an element of 2048 bits (a field holds at most 64)
if f.12                                  # FRN 12, I240/140 Time of Day
  field  cat240.i140  24  uscale:1/128
end
if f.13                                  # FRN 13, I240/RE Reserved Expansion Field
  length 8 bytes plus 1                # the length octet counts itself; the content is not mapped
  end
end
if f.14                                  # FRN 14, I240/SP Special Purpose Field
  length 8 bytes plus 1                # the length octet counts itself; the content is not mapped
  end
end
