# NITF 2.1 (and NSIF 1.0) file header, its fixed part: FHDR through NUMI. Public.
# Maintained by hand. A message is the file's first bytes; the pack stops at NUMI,
# the first count (pack.md, Not mapped). Wire `text`, `delimiter none`: one field,
# each header field a column 0:<offset>:<size>.
format        nitf-file-header
version       0.1.0
distribution  public
source        "MIL-STD-2500C, National Imagery Transmission Format Version 2.1, 01 May 2006, appendix A tables A-1 (file header) and A-3 (image subheader); Distribution Statement A per the ASSIST listing; field order, sizes and types restated, no text copied"
uses          nitf
wire          text
delimiter     none

field     nitf.fh_fhdr                 0:0:4    string
field     nitf.fh_fver                 0:4:5    string
field     nitf.fh_clevel               0:9:2    int
field     nitf.fh_stype                0:11:4   string
field     nitf.fh_ostaid               0:15:10  string
field     nitf.fh_fdt                  0:25:14  string
field     nitf.fh_ftitle               0:39:80  string
field     nitf.fh_fsclas               0:119:1  string
field     nitf.fh_fsclsy               0:120:2  string
field     nitf.fh_fscode               0:122:11  string
field     nitf.fh_fsctlh               0:133:2  string
field     nitf.fh_fsrel                0:135:20  string
field     nitf.fh_fsdctp               0:155:2  string
field     nitf.fh_fsdcdt               0:157:8  string
field     nitf.fh_fsdcxm               0:165:4  string
field     nitf.fh_fsdg                 0:169:1  string
field     nitf.fh_fsdgdt               0:170:8  string
field     nitf.fh_fscltx               0:178:43  string
field     nitf.fh_fscatp               0:221:1  string
field     nitf.fh_fscaut               0:222:40  string
field     nitf.fh_fscrsn               0:262:1  string
field     nitf.fh_fssrdt               0:263:8  string
field     nitf.fh_fsctln               0:271:15  string
field     nitf.fh_fscop                0:286:5  int
field     nitf.fh_fscpys               0:291:5  int
field     nitf.fh_encryp               0:296:1  int
field     nitf.fh_fbkgc                0:297:3  string
field     nitf.fh_oname                0:300:24  string
field     nitf.fh_ophone               0:324:18  string
field     nitf.fh_fl                   0:342:12  int
field     nitf.fh_hl                   0:354:6  int
field     nitf.fh_numi                 0:360:3  int

# FHDR and FVER together select the profile.
kind      nitf-2-1
when      0:0:9  NITF02.10
requires  nitf.fh_fhdr

kind      nsif-1-0
when      0:0:9  NSIF01.00
requires  nitf.fh_fhdr
