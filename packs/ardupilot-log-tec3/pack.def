# ArduPilot log message TEC3 as the payload of a DataFlash log record.
# Generated by tools/gen/aplog2pack.py; do not edit by hand.
# The record without its 3-byte header (0xA3 0x95 type-id); fields packed, little-endian.
format        ardupilot-log-tec3
version       0.1.0
distribution  public
source        "ArduPilot log message definitions (log structure tables and Write calls), https://github.com/ArduPilot/ardupilot at tag Copter-4.6.2, commit 1ebd4d996e8b6bbeb1462a9655c00aa861d5beef; message names, format strings, labels, units and multipliers only; GNU General Public License, version 3"
source        "ArduPilot libraries/AP_Logger/LogStructure.h: the format characters, units and multipliers of a log message, at the same commit"
uses          aplog
wire          bits
bit_order     lsb
word_bytes    1
field  aplog.tec3_timeus  0:0:64  uint
field  aplog.tec3_ked  0:64:32  f32
field  aplog.tec3_ped  0:96:32  f32
field  aplog.tec3_kedd  0:128:32  f32
field  aplog.tec3_pedd  0:160:32  f32
field  aplog.tec3_tee  0:192:32  f32
field  aplog.tec3_tede  0:224:32  f32
field  aplog.tec3_fft  0:256:32  f32
field  aplog.tec3_imin  0:288:32  f32
field  aplog.tec3_imax  0:320:32  f32
field  aplog.tec3_i  0:352:32  f32
field  aplog.tec3_emin  0:384:32  f32
field  aplog.tec3_emax  0:416:32  f32
