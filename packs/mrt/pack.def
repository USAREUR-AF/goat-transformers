kind    bgp4mp-message
when    16  16  as  mrt.type
when    16  1  as  mrt.subtype
length 32 bytes
  field  mrt.peer_as  16  uint
  field  mrt.local_as  16  uint
  field  mrt.interface_index  16  uint
  field  mrt.address_family  16  uint
  switch mrt.address_family
    case 1
      field  mrt.peer_ipv4  32  uint
      field  mrt.local_ipv4  32  uint
    case 2
      field  mrt.peer_ipv6_high  64  uint
      field  mrt.peer_ipv6_low  64  uint
      field  mrt.local_ipv6_high  64  uint
      field  mrt.local_ipv6_low  64  uint
  end
  field  mrt.bgp_marker_high  64  uint
  field  mrt.bgp_marker_low  64  uint
  length 16 bytes plus 18                 # the BGP length counts its marker, itself and the type
    field  mrt.bgp_type  8  uint
    switch mrt.bgp_type
      case 1                                  # OPEN
        field  mrt.open_version  8  uint
        field  mrt.open_my_as  16  uint
        field  mrt.open_hold_time  16  uint
        field  mrt.open_bgp_identifier  32  uint
        length 8 bytes
          group  mrt.open_parameters  rest
            field  mrt.open_parameter_octet  8  uint
          end
        end
      case 2                                  # UPDATE
        length 16 bytes
          group  mrt.withdrawn_routes  rest
            field  mrt.prefix_length  8  uint
