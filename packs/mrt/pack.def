              field  mrt.prefix_octet_11  8  uint
              field  mrt.prefix_octet_12  8  uint
              field  mrt.prefix_octet_13  8  uint
              field  mrt.prefix_octet_14  8  uint
            case 113,114,115,116,117,118,119,120
              field  mrt.prefix_octet_1  8  uint
              field  mrt.prefix_octet_2  8  uint
              field  mrt.prefix_octet_3  8  uint
              field  mrt.prefix_octet_4  8  uint
              field  mrt.prefix_octet_5  8  uint
              field  mrt.prefix_octet_6  8  uint
              field  mrt.prefix_octet_7  8  uint
              field  mrt.prefix_octet_8  8  uint
              field  mrt.prefix_octet_9  8  uint
              field  mrt.prefix_octet_10  8  uint
              field  mrt.prefix_octet_11  8  uint
              field  mrt.prefix_octet_12  8  uint
              field  mrt.prefix_octet_13  8  uint
              field  mrt.prefix_octet_14  8  uint
              field  mrt.prefix_octet_15  8  uint
            case 121,122,123,124,125,126,127,128
              field  mrt.prefix_octet_1  8  uint
              field  mrt.prefix_octet_2  8  uint
              field  mrt.prefix_octet_3  8  uint
              field  mrt.prefix_octet_4  8  uint
              field  mrt.prefix_octet_5  8  uint
              field  mrt.prefix_octet_6  8  uint
              field  mrt.prefix_octet_7  8  uint
              field  mrt.prefix_octet_8  8  uint
              field  mrt.prefix_octet_9  8  uint
              field  mrt.prefix_octet_10  8  uint
              field  mrt.prefix_octet_11  8  uint
              field  mrt.prefix_octet_12  8  uint
              field  mrt.prefix_octet_13  8  uint
              field  mrt.prefix_octet_14  8  uint
              field  mrt.prefix_octet_15  8  uint
              field  mrt.prefix_octet_16  8  uint
          end
        end
      case 3                                  # NOTIFICATION
        field  mrt.error_code  8  uint
        field  mrt.error_subcode  8  uint
        group  mrt.notification_data  rest
          field  mrt.notification_octet  8  uint
        end
      case 4                                    # KEEPALIVE: no body
      else
        group  mrt.bgp_body  rest
          field  mrt.bgp_body_octet  8  uint
        end
    end
  end
end
