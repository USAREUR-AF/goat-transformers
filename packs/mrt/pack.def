      field  mrt.prefix_octet_15  8  uint
      field  mrt.prefix_octet_16  8  uint
  end
  group  mrt.rib_entries  count 16
    field  mrt.peer_index  16  uint
    field  mrt.originated_time  32  uint
    field  mrt.path_identifier  32  uint
    length 16 bytes
      group  mrt.attributes  rest
        field  mrt.attr_optional  1  uint
        field  mrt.attr_transitive  1  uint
        field  mrt.attr_partial  1  uint
        field  mrt.attr_extended_length  1  uint
        field  mrt.attr_flags_low  4  uint
        field  mrt.attr_type  8  uint
        switch mrt.attr_extended_length
          case 1
            length 16 bytes
              switch mrt.attr_type
                case 1
                  field  mrt.origin  8  uint
                case 2
                  group  mrt.as_path_segments  rest
                    field  mrt.segment_type  8  uint
                    count  asns  8
                    group  mrt.segment_asns  count @asns
                      field  mrt.asn  32  uint
                    end
                  end
                case 3
                  field  mrt.next_hop  32  uint
                case 4
                  field  mrt.multi_exit_disc  32  uint
                case 5
                  field  mrt.local_pref  32  uint
                else
                  group  mrt.attr_value  rest
                    field  mrt.attr_octet  8  uint
                  end
              end
            end
          else
            length 8 bytes
              switch mrt.attr_type
                case 1
                  field  mrt.origin  8  uint
                case 2
                  group  mrt.as_path_segments  rest
                    field  mrt.segment_type  8  uint
                    count  asns  8
                    group  mrt.segment_asns  count @asns
                      field  mrt.asn  32  uint
                    end
                  end
                case 3
                  field  mrt.next_hop  32  uint
                case 4
                  field  mrt.multi_exit_disc  32  uint
                case 5
                  field  mrt.local_pref  32  uint
                else
                  group  mrt.attr_value  rest
                    field  mrt.attr_octet  8  uint
                  end
              end
            end
        end
      end
    end
  end
end

