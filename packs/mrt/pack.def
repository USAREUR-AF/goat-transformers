# BGP MRT records (RFC 6396, with the add-path subtypes of RFC 8050): one record, the
# common header and the message, for TABLE_DUMP_V2 (13), BGP4MP (16) and BGP4MP_ET (17).
# Public. Written by tools/gen/mrt-pack.py from one statement of each layout; do not edit
# by hand. I/O is hex text. pack.md states what is mapped, what is not, and the time.
format     mrt
version    0.1.0
distribution public
source  "IETF RFC 6396, Multi-Threaded Routing Toolkit (MRT) Routing Information Export Format, https://www.rfc-editor.org/rfc/rfc6396.txt (sha256 415c96368320e94eaed7dd17d024a83c516beb0ac98653ec80ddcc1921d22ef7)"
source  "IETF RFC 8050, MRT Routing Information Export Format with BGP Additional Path Extensions, https://www.rfc-editor.org/rfc/rfc8050.txt (sha256 aa3ea773846495e292749a13a5306dfbc6da8e37d80ddbf92fddc827a71b5821)"
source  "IETF RFC 4271, A Border Gateway Protocol 4 (BGP-4), section 4, the BGP message a BGP4MP_MESSAGE carries"
uses       mrt
wire       bits
layout     sequential
bit_order  msb
field  time_ms  32  uiscale:1000      # Timestamp: seconds since 1970-01-01 UTC

kind    table-dump-v2-peer-index-table
when    16  13  as  mrt.type
when    16  1  as  mrt.subtype
length 32 bytes
  field  mrt.collector_bgp_id  32  uint
  length 16 bytes
    group  mrt.view_name  rest
      field  mrt.view_name_octet  8  uint
    end
  end
  group  mrt.peers  count 16
    field  mrt.peer_type  8  uint
    field  mrt.peer_bgp_id  32  uint
    switch mrt.peer_type
      case 0
        field  mrt.peer_ipv4  32  uint
        field  mrt.peer_as  16  uint
      case 1
        field  mrt.peer_ipv6_high  64  uint
        field  mrt.peer_ipv6_low  64  uint
        field  mrt.peer_as  16  uint
      case 2
        field  mrt.peer_ipv4  32  uint
        field  mrt.peer_as  32  uint
      case 3
        field  mrt.peer_ipv6_high  64  uint
        field  mrt.peer_ipv6_low  64  uint
        field  mrt.peer_as  32  uint
    end
  end
end

