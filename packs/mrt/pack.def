              field  mrt.prefix_octet_13  8  uint
              field  mrt.prefix_octet_14  8  uint
              field  mrt.prefix_octet_15  8  uint
              field  mrt.prefix_octet_16  8  uint
          end
        end
      case 3                                  # NOTIFICATION
        field  mrt.error_code  8  uint
        field  mrt.error_subcode  8  uint
        group  mrt.notification_data  rest
          field  mrt.notification_octet  8  uint
        end
      case 4                                    # KEEPALIVE: no body
      else
        group  mrt.bgp_body  rest
          field  mrt.bgp_body_octet  8  uint
        end
    end
  end
end

