# Conformance probe pack for a count line inside an `opt` block (spec 0.21
# ruling 18: a count line is never content), most significant bit first.
# Public. No kinds.
#
#   opt         one bit; when it is 1: n in 8 bits, then n nums (val in 8
#               bits each)
format     conformance-extents-optcount
version    0.21.0
distribution public
source  "goat-transformers spec/engine-spec.md (synthetic probe format, no external standard)"
uses       probe
wire       bits
layout     sequential
bit_order  msb
opt
  count n 8
  group  probe.nums count @n
    field  probe.val  8  uint
  end
end
