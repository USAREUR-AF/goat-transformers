# ArduPilot log message CAFD as the payload of a DataFlash log record.
# Generated by tools/gen/aplog2pack.py; do not edit by hand.
# The record without its 3-byte header (0xA3 0x95 type-id); fields packed, little-endian.
format        ardupilot-log-cafd
version       0.1.0
distribution  public
source        "ArduPilot log message definitions (log structure tables and Write calls), https://github.com/ArduPilot/ardupilot at tag Copter-4.6.2, commit 1ebd4d996e8b6bbeb1462a9655c00aa861d5beef; message names, format strings, labels, units and multipliers only; GNU General Public License, version 3"
source        "ArduPilot libraries/AP_Logger/LogStructure.h: the format characters, units and multipliers of a log message, at the same commit"
uses          aplog
wire          bits
bit_order     lsb
word_bytes    1
field  aplog.cafd_timeus  0:0:64  uint
field  aplog.cafd_bus  0:64:8  uint
field  aplog.cafd_id  0:72:32  uint
field  aplog.cafd_dlc  0:104:8  uint
field  aplog.cafd_d0  0:112:64  uint
field  aplog.cafd_d1  0:176:64  uint
field  aplog.cafd_d2  0:240:64  uint
field  aplog.cafd_d3  0:304:64  uint
field  aplog.cafd_d4  0:368:64  uint
field  aplog.cafd_d5  0:432:64  uint
field  aplog.cafd_d6  0:496:64  uint
field  aplog.cafd_d7  0:560:64  uint
