# ArduPilot log message NKF2 as the payload of a DataFlash log record.
# Generated by tools/gen/aplog2pack.py; do not edit by hand.
# The record without its 3-byte header (0xA3 0x95 type-id); fields packed, little-endian.
format        ardupilot-log-nkf2
version       0.1.0
distribution  public
source        "ArduPilot log message definitions (log structure tables and Write calls), https://github.com/ArduPilot/ardupilot at tag Copter-4.6.2, commit 1ebd4d996e8b6bbeb1462a9655c00aa861d5beef; message names, format strings, labels, units and multipliers only; GNU General Public License, version 3"
source        "ArduPilot libraries/AP_Logger/LogStructure.h: the format characters, units and multipliers of a log message, at the same commit"
uses          aplog
wire          bits
bit_order     lsb
word_bytes    1
field  aplog.nkf2_timeus  0:0:64  uint
field  aplog.nkf2_c  0:64:8  uint
field  aplog.nkf2_azbias  0:72:8  twos
field  aplog.nkf2_gsx  0:80:16  twos
field  aplog.nkf2_gsy  0:96:16  twos
field  aplog.nkf2_gsz  0:112:16  twos
field  aplog.nkf2_vwn  0:128:16  twos
field  aplog.nkf2_vwe  0:144:16  twos
field  aplog.nkf2_mn  0:160:16  twos
field  aplog.nkf2_me  0:176:16  twos
field  aplog.nkf2_md  0:192:16  twos
field  aplog.nkf2_mx  0:208:16  twos
field  aplog.nkf2_my  0:224:16  twos
field  aplog.nkf2_mz  0:240:16  twos
field  aplog.nkf2_mi  0:256:8  uint
