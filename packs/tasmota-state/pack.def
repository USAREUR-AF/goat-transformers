# Tasmota's tele/<topic>/STATE payload. Public.
format        tasmota-state
version       0.1.0
distribution  public
source        "Tasmota (https://github.com/arendst/Tasmota, GPL-3.0) release v16.0.0, commit 1c2173927cdf1be61759bcc3b064b9511a18e5d7: tasmota_support/support_tasmota.ino (MqttShowState), tasmota_xdrv_driver/xdrv_03_energy.ino, tasmota_xsns_sensor/xsns_05_ds18x20.ino, xsns_09_bmp.ino, xsns_06_dht_v6.ino, include/i18n.h (the JSON member names); member names restated, no code copied"
uses          tasmota
wire          json
field  tasmota.time_local  Time  string
field  tasmota.uptime  Uptime  string
field  tasmota.uptime_s  UptimeSec  int
field  tasmota.battery_percent  BatteryPercentage  int
field  tasmota.vcc_v  Vcc  float
field  tasmota.heap_kb  Heap  int
field  tasmota.sleep_mode  SleepMode  string
field  tasmota.sleep_ms  Sleep  int
field  tasmota.load_avg  LoadAvg  int
field  tasmota.mqtt_count  MqttCount  int
field  tasmota.power  POWER  string
field  tasmota.power1  POWER1  string
field  tasmota.power2  POWER2  string
field  tasmota.power3  POWER3  string
field  tasmota.power4  POWER4  string
field  tasmota.power5  POWER5  string
field  tasmota.power6  POWER6  string
field  tasmota.power7  POWER7  string
field  tasmota.power8  POWER8  string
field  tasmota.fan_speed  FanSpeed  int
field  tasmota.wifi_ap  Wifi.AP  int
field  tasmota.wifi_ssid  Wifi.SSId  string
field  tasmota.wifi_bssid  Wifi.BSSId  string
field  tasmota.wifi_channel  Wifi.Channel  int
field  tasmota.wifi_mode  Wifi.Mode  string
field  tasmota.wifi_rssi  Wifi.RSSI  int
field  tasmota.wifi_signal  Wifi.Signal  int
field  tasmota.wifi_linkcount  Wifi.LinkCount  int
field  tasmota.wifi_downtime  Wifi.Downtime  string
field  tasmota.hostname  Hostname  string
field  tasmota.ip_address  IPAddress  string
