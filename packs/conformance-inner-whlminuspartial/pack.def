# Conformance probe pack (spec 0.34, `inner … partial`: bytes after the inner
# message are ignored). Public. No kinds.
#
#   n, then one conformance-inner-whlminus message
format     conformance-inner-whlminuspartial
version    0.34.0
distribution public
source  "goat-transformers spec/engine-spec.md (synthetic probe format, no external standard)"
uses       probe
wire       bits
layout     sequential
bit_order  msb
field   probe.n  8  uint
inner   conformance-inner-whlminus  partial
