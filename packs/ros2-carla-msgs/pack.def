# ROS 2 carla_msgs messages in the JSON form of a rosbridge `publish` operation.
# Generated by tools/gen/ros2msg2pack.py; do not edit by hand.
# One kind per .msg file, selected by the member `type` ("<package>/msg/<Name>").
# The ROS message is the object under `msg`; arrays are groups.
format        ros2-carla-msgs
version       0.1.0
distribution  public
source        "ROS 2 interface package carla_msgs, https://github.com/carla-simulator/ros-carla-msgs master (MIT License) at commit 081fdcdc8a4f8d4ce936b792c4ef13aba3fd7478, directory msg; field names, types and array forms only"
source        "ROS 2 interface package builtin_interfaces (messages carla_msgs refers to), https://github.com/ros2/rcl_interfaces 2.0.4 at commit 7aa3caf43377ea6ad615bc1040832e2c7566bfbe, Apache License 2.0"
source        "ROS 2 interface package geometry_msgs (messages carla_msgs refers to), https://github.com/ros2/common_interfaces 5.3.8 at commit a941f14bb318d8d904505ed935ccbb97f24a70a4, Apache License 2.0"
source        "ROS 2 interface package std_msgs (messages carla_msgs refers to), https://github.com/ros2/common_interfaces 5.3.8 at commit a941f14bb318d8d904505ed935ccbb97f24a70a4, Apache License 2.0"
source        "rosbridge v2.1.0 Protocol Specification, ROSBRIDGE_PROTOCOL.md, https://github.com/RobotWebTools/rosbridge_suite jazzy at commit cb33a16b890e4b8d9def531326409f3ee6c12537, BSD 3-Clause License; JSON form of a message and of the publish operation"
uses          ros2carla
wire          json
when   op  publish
field  ros2carla.topic  topic  string

kind      carla_actor_info
when      type  carla_msgs/msg/CarlaActorInfo
requires  ros2carla.carla_actor_info_id
field  ros2carla.carla_actor_info_id  msg.id  int
field  ros2carla.carla_actor_info_parent_id  msg.parent_id  int
field  ros2carla.carla_actor_info_type  msg.type  string
field  ros2carla.carla_actor_info_rolename  msg.rolename  string

kind      carla_actor_list
when      type  carla_msgs/msg/CarlaActorList
requires  ros2carla.carla_actor_list_actors
group  ros2carla.carla_actor_list_actors  msg.actors
  field  ros2carla.carla_actor_list_actors_id  id  int
  field  ros2carla.carla_actor_list_actors_parent_id  parent_id  int
  field  ros2carla.carla_actor_list_actors_type  type  string
  field  ros2carla.carla_actor_list_actors_rolename  rolename  string
end

kind      carla_bounding_box
when      type  carla_msgs/msg/CarlaBoundingBox
requires  ros2carla.carla_bounding_box_center_x
field  ros2carla.carla_bounding_box_center_x  msg.center.x  float
field  ros2carla.carla_bounding_box_center_y  msg.center.y  float
field  ros2carla.carla_bounding_box_center_z  msg.center.z  float
field  ros2carla.carla_bounding_box_size_x  msg.size.x  float
field  ros2carla.carla_bounding_box_size_y  msg.size.y  float
field  ros2carla.carla_bounding_box_size_z  msg.size.z  float

kind      carla_collision_event
when      type  carla_msgs/msg/CarlaCollisionEvent
requires  ros2carla.carla_collision_event_header_stamp_sec
field  ros2carla.carla_collision_event_header_stamp_sec  msg.header.stamp.sec  int
field  ros2carla.carla_collision_event_header_stamp_nanosec  msg.header.stamp.nanosec  int
field  ros2carla.carla_collision_event_header_frame_id  msg.header.frame_id  string
field  ros2carla.carla_collision_event_other_actor_id  msg.other_actor_id  int
field  ros2carla.carla_collision_event_normal_impulse_x  msg.normal_impulse.x  float
