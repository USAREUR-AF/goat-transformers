  field  ros2clearpathplatform.pinout_state_rails_value  .  bool
end
group  ros2clearpathplatform.pinout_state_inputs  msg.inputs
  field  ros2clearpathplatform.pinout_state_inputs_value  .  bool
end
group  ros2clearpathplatform.pinout_state_outputs  msg.outputs
  field  ros2clearpathplatform.pinout_state_outputs_value  .  bool
end
group  ros2clearpathplatform.pinout_state_output_periods  msg.output_periods
  field  ros2clearpathplatform.pinout_state_output_periods_value  .  int
end

