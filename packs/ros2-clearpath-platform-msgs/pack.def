# ROS 2 clearpath_platform_msgs messages in the JSON form of a rosbridge `publish` operation.
# Generated by tools/gen/ros2msg2pack.py; do not edit by hand.
# One kind per .msg file, selected by the member `type` ("<package>/msg/<Name>").
# The ROS message is the object under `msg`; arrays are groups.
format        ros2-clearpath-platform-msgs
version       0.1.0
distribution  public
source        "ROS 2 interface package clearpath_platform_msgs, https://github.com/clearpathrobotics/clearpath_msgs jazzy (BSD 3-Clause License) at commit 0014d0afafea2715d1336ff58f2562450b6debda, directory clearpath_platform_msgs/msg; field names, types and array forms only"
source        "ROS 2 interface package builtin_interfaces (messages clearpath_platform_msgs refers to), https://github.com/ros2/rcl_interfaces 2.0.4 at commit 7aa3caf43377ea6ad615bc1040832e2c7566bfbe, Apache License 2.0"
source        "ROS 2 interface package std_msgs (messages clearpath_platform_msgs refers to), https://github.com/ros2/common_interfaces 5.3.8 at commit a941f14bb318d8d904505ed935ccbb97f24a70a4, Apache License 2.0"
source        "rosbridge v2.1.0 Protocol Specification, ROSBRIDGE_PROTOCOL.md, https://github.com/RobotWebTools/rosbridge_suite jazzy at commit cb33a16b890e4b8d9def531326409f3ee6c12537, BSD 3-Clause License; JSON form of a message and of the publish operation"
uses          ros2clearpathplatform
wire          json
when   op  publish
field  ros2clearpathplatform.topic  topic  string

kind      display_status
when      type  clearpath_platform_msgs/msg/DisplayStatus
requires  ros2clearpathplatform.display_status_string1
field  ros2clearpathplatform.display_status_string1  msg.string1  string
field  ros2clearpathplatform.display_status_string2  msg.string2  string

kind      drive
when      type  clearpath_platform_msgs/msg/Drive
requires  ros2clearpathplatform.drive_mode
field  ros2clearpathplatform.drive_mode  msg.mode  int
group  ros2clearpathplatform.drive_drivers  msg.drivers
  field  ros2clearpathplatform.drive_drivers_value  .  float
end

kind      drive_feedback
when      type  clearpath_platform_msgs/msg/DriveFeedback
requires  ros2clearpathplatform.drive_feedback_current
field  ros2clearpathplatform.drive_feedback_current  msg.current  float
field  ros2clearpathplatform.drive_feedback_duty_cycle  msg.duty_cycle  float
field  ros2clearpathplatform.drive_feedback_bridge_temperature  msg.bridge_temperature  float
field  ros2clearpathplatform.drive_feedback_motor_temperature  msg.motor_temperature  float
field  ros2clearpathplatform.drive_feedback_measured_velocity  msg.measured_velocity  float
field  ros2clearpathplatform.drive_feedback_measured_travel  msg.measured_travel  float
field  ros2clearpathplatform.drive_feedback_driver_fault  msg.driver_fault  bool

kind      fans
when      type  clearpath_platform_msgs/msg/Fans
requires  ros2clearpathplatform.fans_fans
field  ros2clearpathplatform.fans_fans  msg.fans  string

kind      feedback
when      type  clearpath_platform_msgs/msg/Feedback
requires  ros2clearpathplatform.feedback_header_stamp_sec
field  ros2clearpathplatform.feedback_header_stamp_sec  msg.header.stamp.sec  int
field  ros2clearpathplatform.feedback_header_stamp_nanosec  msg.header.stamp.nanosec  int
field  ros2clearpathplatform.feedback_header_frame_id  msg.header.frame_id  string
group  ros2clearpathplatform.feedback_drivers  msg.drivers
  field  ros2clearpathplatform.feedback_drivers_current  current  float
  field  ros2clearpathplatform.feedback_drivers_duty_cycle  duty_cycle  float
  field  ros2clearpathplatform.feedback_drivers_bridge_temperature  bridge_temperature  float
  field  ros2clearpathplatform.feedback_drivers_motor_temperature  motor_temperature  float
  field  ros2clearpathplatform.feedback_drivers_measured_velocity  measured_velocity  float
  field  ros2clearpathplatform.feedback_drivers_measured_travel  measured_travel  float
  field  ros2clearpathplatform.feedback_drivers_driver_fault  driver_fault  bool
end
field  ros2clearpathplatform.feedback_commanded_mode  msg.commanded_mode  int
field  ros2clearpathplatform.feedback_actual_mode  msg.actual_mode  int

kind      lights
when      type  clearpath_platform_msgs/msg/Lights
requires  ros2clearpathplatform.lights_lights
group  ros2clearpathplatform.lights_lights  msg.lights
  field  ros2clearpathplatform.lights_lights_red  red  int
  field  ros2clearpathplatform.lights_lights_green  green  int
  field  ros2clearpathplatform.lights_lights_blue  blue  int
end

kind      pinout_command
when      type  clearpath_platform_msgs/msg/PinoutCommand
requires  ros2clearpathplatform.pinout_command_rails
group  ros2clearpathplatform.pinout_command_rails  msg.rails
  field  ros2clearpathplatform.pinout_command_rails_value  .  bool
end
group  ros2clearpathplatform.pinout_command_outputs  msg.outputs
  field  ros2clearpathplatform.pinout_command_outputs_value  .  int
end

