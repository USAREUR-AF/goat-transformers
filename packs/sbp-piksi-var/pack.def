# SBP frames of the package swiftnav.sbp.piksi whose payload length is not fixed,
# one kind per message. Generated by tools/gen/sbp2pack.py; do not edit by hand.
# The frame: preamble 0x55, message type (u16), sender (u16), length (u8),
# payload, without the CRC. The payload is a `length 8 bytes` extent; an array
# or text that runs to its end is a `rest` group (engine-spec 0.8, 0.21).
format        sbp-piksi-var
version       0.1.0
distribution  public
source        "https://github.com/swift-nav/libsbp spec/yaml/swiftnav/sbp/piksi.yaml at v6.5.2 (commit 925825dea5174f069b5d6e23548f213e09f0235c)"
uses          sbp
uses          sbppiksi
wire          bits
layout        sequential
bit_order     lsb
when  8  85

kind  command_req
when  16  184
requires  sbppiksi.command_req_sequence
field  sbp.sender  16  uint
length  8  bytes
  field  sbppiksi.command_req_sequence  32  uint
  group  sbppiksi.command_req_command  rest
    field  sbppiksi.command_req_command_byte  8  uint
  end
end

kind  command_output
when  16  188
requires  sbppiksi.command_output_sequence
field  sbp.sender  16  uint
length  8  bytes
  field  sbppiksi.command_output_sequence  32  uint
  group  sbppiksi.command_output_line  rest
    field  sbppiksi.command_output_line_byte  8  uint
  end
end

kind  network_bandwidth_usage
when  16  189
requires  sbppiksi.network_bandwidth_usage_interfaces
field  sbp.sender  16  uint
length  8  bytes
  group  sbppiksi.network_bandwidth_usage_interfaces  rest
    field  sbppiksi.network_bandwidth_usage_interfaces_duration  64  uint
    field  sbppiksi.network_bandwidth_usage_interfaces_total_bytes  64  uint
    field  sbppiksi.network_bandwidth_usage_interfaces_rx_bytes  32  uint
    field  sbppiksi.network_bandwidth_usage_interfaces_tx_bytes  32  uint
    field  sbppiksi.network_bandwidth_usage_interfaces_interface_name  128  ascii
  end
end

kind  cell_modem_status
when  16  190
requires  sbppiksi.cell_modem_status_signal_strength
field  sbp.sender  16  uint
length  8  bytes
  field  sbppiksi.cell_modem_status_signal_strength  8  twos
  field  sbppiksi.cell_modem_status_signal_error_rate  32  f32
  group  sbppiksi.cell_modem_status_reserved  rest
    field  sbppiksi.cell_modem_status_reserved_item  8  uint
  end
end

kind  specan_dep
when  16  80
requires  sbppiksi.specan_dep_channel_tag
field  sbp.sender  16  uint
length  8  bytes
  field  sbppiksi.specan_dep_channel_tag  16  uint
  field  sbppiksi.specan_dep_t_tow  32  uint
  field  sbppiksi.specan_dep_t_wn  16  uint
  field  sbppiksi.specan_dep_freq_ref  32  f32
  field  sbppiksi.specan_dep_freq_step  32  f32
  field  sbppiksi.specan_dep_amplitude_ref  32  f32
  field  sbppiksi.specan_dep_amplitude_unit  32  f32
  group  sbppiksi.specan_dep_amplitude_value  rest
    field  sbppiksi.specan_dep_amplitude_value_item  8  uint
  end
end

kind  specan
when  16  81
requires  sbppiksi.specan_channel_tag
field  sbp.sender  16  uint
length  8  bytes
  field  sbppiksi.specan_channel_tag  16  uint
  field  sbppiksi.specan_t_tow  32  uint
  field  sbppiksi.specan_t_ns_residual  32  twos
  field  sbppiksi.specan_t_wn  16  uint
  field  sbppiksi.specan_freq_ref  32  f32
  field  sbppiksi.specan_freq_step  32  f32
  field  sbppiksi.specan_amplitude_ref  32  f32
  field  sbppiksi.specan_amplitude_unit  32  f32
  group  sbppiksi.specan_amplitude_value  rest
    field  sbppiksi.specan_amplitude_value_item  8  uint
  end
end
