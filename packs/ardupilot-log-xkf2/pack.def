# ArduPilot log message XKF2 as the payload of a DataFlash log record.
# Generated by tools/gen/aplog2pack.py; do not edit by hand.
# The record without its 3-byte header (0xA3 0x95 type-id); fields packed, little-endian.
format        ardupilot-log-xkf2
version       0.1.0
distribution  public
source        "ArduPilot log message definitions (log structure tables and Write calls), https://github.com/ArduPilot/ardupilot at tag Copter-4.6.2, commit 1ebd4d996e8b6bbeb1462a9655c00aa861d5beef; message names, format strings, labels, units and multipliers only; GNU General Public License, version 3"
source        "ArduPilot libraries/AP_Logger/LogStructure.h: the format characters, units and multipliers of a log message, at the same commit"
uses          aplog
wire          bits
bit_order     lsb
word_bytes    1
field  aplog.xkf2_timeus  0:0:64  uint
field  aplog.xkf2_c  0:64:8  uint
field  aplog.xkf2_ax  0:72:16  twos
field  aplog.xkf2_ay  0:88:16  twos
field  aplog.xkf2_az  0:104:16  twos
field  aplog.xkf2_vwn  0:120:16  twos
field  aplog.xkf2_vwe  0:136:16  twos
field  aplog.xkf2_mn  0:152:16  twos
field  aplog.xkf2_me  0:168:16  twos
field  aplog.xkf2_md  0:184:16  twos
field  aplog.xkf2_mx  0:200:16  twos
field  aplog.xkf2_my  0:216:16  twos
field  aplog.xkf2_mz  0:232:16  twos
field  aplog.xkf2_idx  0:248:32  f32
field  aplog.xkf2_idy  0:280:32  f32
field  aplog.xkf2_is  0:312:32  f32
