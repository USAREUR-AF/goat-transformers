# ArduPilot log message VNIM as the payload of a DataFlash log record.
# Generated by tools/gen/aplog2pack.py; do not edit by hand.
# The record without its 3-byte header (0xA3 0x95 type-id); fields packed, little-endian.
format        ardupilot-log-vnim
version       0.1.0
distribution  public
source        "ArduPilot log message definitions (log structure tables and Write calls), https://github.com/ArduPilot/ardupilot at tag Copter-4.6.2, commit 1ebd4d996e8b6bbeb1462a9655c00aa861d5beef; message names, format strings, labels, units and multipliers only; GNU General Public License, version 3"
source        "ArduPilot libraries/AP_Logger/LogStructure.h: the format characters, units and multipliers of a log message, at the same commit"
uses          aplog
wire          bits
bit_order     lsb
word_bytes    1
field  aplog.vnim_timeus  0:0:64  uint
field  aplog.vnim_temp  0:64:32  f32
field  aplog.vnim_pres  0:96:32  f32
field  aplog.vnim_mx  0:128:32  f32
field  aplog.vnim_my  0:160:32  f32
field  aplog.vnim_mz  0:192:32  f32
field  aplog.vnim_ax  0:224:32  f32
field  aplog.vnim_ay  0:256:32  f32
field  aplog.vnim_az  0:288:32  f32
field  aplog.vnim_gx  0:320:32  f32
field  aplog.vnim_gy  0:352:32  f32
field  aplog.vnim_gz  0:384:32  f32
