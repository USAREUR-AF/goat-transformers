# GTFS Schedule booking_rules.txt: one data row of the file. Public. Maintained by hand.
# The columns are in the order the reference lists them (pack.md, Column order);
# the header row is not a message of this pack.
format        gtfs-booking-rules
version       0.1.0
distribution  public
source        "GTFS Schedule Reference, gtfs/spec/en/reference.md of https://github.com/google/transit (Apache-2.0) at commit 2ce6aa79e3fa7bdbaf19d2a12765cee5b9fdd699; the column order of each file as the reference lists it; field names and types"
uses          gtfs
wire          text

field  gtfs.booking_rule_id             0   string
field  gtfs.booking_type                1   int
field  gtfs.prior_notice_duration_min   2   int
field  gtfs.prior_notice_duration_max   3   int
field  gtfs.prior_notice_last_day       4   int
field  gtfs.prior_notice_last_time      5   string
field  gtfs.prior_notice_start_day      6   int
field  gtfs.prior_notice_start_time     7   string
field  gtfs.prior_notice_service_id     8   string
field  gtfs.message                     9   string
field  gtfs.pickup_message              10  string
field  gtfs.drop_off_message            11  string
field  gtfs.phone_number                12  string
field  gtfs.info_url                    13  string
field  gtfs.booking_url                 14  string
