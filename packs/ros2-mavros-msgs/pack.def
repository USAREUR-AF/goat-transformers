requires  ros2mavros.waypoint_reached_header_stamp_sec
field  ros2mavros.waypoint_reached_header_stamp_sec  msg.header.stamp.sec  int
field  ros2mavros.waypoint_reached_header_stamp_nanosec  msg.header.stamp.nanosec  int
field  ros2mavros.waypoint_reached_header_frame_id  msg.header.frame_id  string
field  ros2mavros.waypoint_reached_wp_seq  msg.wp_seq  int

kind      wheel_odom_stamped
when      type  mavros_msgs/msg/WheelOdomStamped
requires  ros2mavros.wheel_odom_stamped_header_stamp_sec
field  ros2mavros.wheel_odom_stamped_header_stamp_sec  msg.header.stamp.sec  int
field  ros2mavros.wheel_odom_stamped_header_stamp_nanosec  msg.header.stamp.nanosec  int
field  ros2mavros.wheel_odom_stamped_header_frame_id  msg.header.frame_id  string
group  ros2mavros.wheel_odom_stamped_data  msg.data
  field  ros2mavros.wheel_odom_stamped_data_value  .  float
end

kind      command_code
when      type  mavros_msgs/msg/CommandCode
requires  ros2mavros.topic
