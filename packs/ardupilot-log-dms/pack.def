# ArduPilot log message DMS as the payload of a DataFlash log record.
# Generated by tools/gen/aplog2pack.py; do not edit by hand.
# The record without its 3-byte header (0xA3 0x95 type-id); fields packed, little-endian.
format        ardupilot-log-dms
version       0.1.0
distribution  public
source        "ArduPilot log message definitions (log structure tables and Write calls), https://github.com/ArduPilot/ardupilot at tag Copter-4.6.2, commit 1ebd4d996e8b6bbeb1462a9655c00aa861d5beef; message names, format strings, labels, units and multipliers only; GNU General Public License, version 3"
source        "ArduPilot libraries/AP_Logger/LogStructure.h: the format characters, units and multipliers of a log message, at the same commit"
uses          aplog
wire          bits
bit_order     lsb
word_bytes    1
field  aplog.dms_timeus  0:0:64  uint
field  aplog.dms_n  0:64:32  uint
field  aplog.dms_dp  0:96:32  uint
field  aplog.dms_rt  0:128:32  uint
field  aplog.dms_rs  0:160:32  uint
field  aplog.dms_fa  0:192:8  uint
field  aplog.dms_fmn  0:200:8  uint
field  aplog.dms_fmx  0:208:8  uint
field  aplog.dms_pa  0:216:8  uint
field  aplog.dms_pmn  0:224:8  uint
field  aplog.dms_pmx  0:232:8  uint
field  aplog.dms_sa  0:240:8  uint
field  aplog.dms_smn  0:248:8  uint
field  aplog.dms_smx  0:256:8  uint
