# ROS 2 rmf_door_msgs messages in the JSON form of a rosbridge `publish` operation.
# Generated by tools/gen/ros2msg2pack.py; do not edit by hand.
# One kind per .msg file, selected by the member `type` ("<package>/msg/<Name>").
# The ROS message is the object under `msg`; arrays are groups.
format        ros2-rmf-door-msgs
version       0.1.0
distribution  public
source        "ROS 2 interface package rmf_door_msgs, https://github.com/open-rmf/rmf_internal_msgs jazzy (Apache License 2.0) at commit 04585f0e2b0da9f11327fb403d38bc547d648fa6, directory rmf_door_msgs/msg; field names, types and array forms only"
source        "ROS 2 interface package builtin_interfaces (messages rmf_door_msgs refers to), https://github.com/ros2/rcl_interfaces 2.0.4 at commit 7aa3caf43377ea6ad615bc1040832e2c7566bfbe, Apache License 2.0"
source        "rosbridge v2.1.0 Protocol Specification, ROSBRIDGE_PROTOCOL.md, https://github.com/RobotWebTools/rosbridge_suite jazzy at commit cb33a16b890e4b8d9def531326409f3ee6c12537, BSD 3-Clause License; JSON form of a message and of the publish operation"
uses          ros2rmfdoor
wire          json
when   op  publish
field  ros2rmfdoor.topic  topic  string

kind      door_mode
when      type  rmf_door_msgs/msg/DoorMode
requires  ros2rmfdoor.door_mode_value
field  ros2rmfdoor.door_mode_value  msg.value  int

kind      door_request
when      type  rmf_door_msgs/msg/DoorRequest
requires  ros2rmfdoor.door_request_request_time_sec
field  ros2rmfdoor.door_request_request_time_sec  msg.request_time.sec  int
field  ros2rmfdoor.door_request_request_time_nanosec  msg.request_time.nanosec  int
field  ros2rmfdoor.door_request_requester_id  msg.requester_id  string
field  ros2rmfdoor.door_request_door_name  msg.door_name  string
field  ros2rmfdoor.door_request_requested_mode_value  msg.requested_mode.value  int

kind      door_sessions
when      type  rmf_door_msgs/msg/DoorSessions
requires  ros2rmfdoor.door_sessions_door_name
field  ros2rmfdoor.door_sessions_door_name  msg.door_name  string
group  ros2rmfdoor.door_sessions_sessions  msg.sessions
  field  ros2rmfdoor.door_sessions_sessions_request_time_sec  request_time.sec  int
  field  ros2rmfdoor.door_sessions_sessions_request_time_nanosec  request_time.nanosec  int
  field  ros2rmfdoor.door_sessions_sessions_requester_id  requester_id  string
end

kind      door_state
when      type  rmf_door_msgs/msg/DoorState
requires  ros2rmfdoor.door_state_door_time_sec
field  ros2rmfdoor.door_state_door_time_sec  msg.door_time.sec  int
field  ros2rmfdoor.door_state_door_time_nanosec  msg.door_time.nanosec  int
field  ros2rmfdoor.door_state_door_name  msg.door_name  string
field  ros2rmfdoor.door_state_current_mode_value  msg.current_mode.value  int

kind      session
when      type  rmf_door_msgs/msg/Session
requires  ros2rmfdoor.session_request_time_sec
field  ros2rmfdoor.session_request_time_sec  msg.request_time.sec  int
field  ros2rmfdoor.session_request_time_nanosec  msg.request_time.nanosec  int
field  ros2rmfdoor.session_requester_id  msg.requester_id  string

kind      supervisor_heartbeat
when      type  rmf_door_msgs/msg/SupervisorHeartbeat
requires  ros2rmfdoor.supervisor_heartbeat_all_sessions
group  ros2rmfdoor.supervisor_heartbeat_all_sessions  msg.all_sessions
  field  ros2rmfdoor.supervisor_heartbeat_all_sessions_door_name  door_name  string
  group  ros2rmfdoor.supervisor_heartbeat_all_sessions_sessions  sessions
    field  ros2rmfdoor.supervisor_heartbeat_all_sessions_sessions_request_time_sec  request_time.sec  int
    field  ros2rmfdoor.supervisor_heartbeat_all_sessions_sessions_request_time_nanosec  request_time.nanosec  int
    field  ros2rmfdoor.supervisor_heartbeat_all_sessions_sessions_requester_id  requester_id  string
  end
end
