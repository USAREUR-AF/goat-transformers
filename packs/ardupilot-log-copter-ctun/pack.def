# ArduPilot log message CTUN as the payload of a DataFlash log record.
# Generated by tools/gen/aplog2pack.py; do not edit by hand.
# The record without its 3-byte header (0xA3 0x95 type-id); fields packed, little-endian.
format        ardupilot-log-copter-ctun
version       0.1.0
distribution  public
source        "ArduPilot log message definitions (log structure tables and Write calls), https://github.com/ArduPilot/ardupilot at tag Copter-4.6.2, commit 1ebd4d996e8b6bbeb1462a9655c00aa861d5beef; message names, format strings, labels, units and multipliers only; GNU General Public License, version 3"
source        "ArduPilot libraries/AP_Logger/LogStructure.h: the format characters, units and multipliers of a log message, at the same commit"
uses          aplog
wire          bits
bit_order     lsb
word_bytes    1
field  aplog.copter_ctun_timeus  0:0:64  uint
field  aplog.copter_ctun_thi  0:64:32  f32
field  aplog.copter_ctun_abst  0:96:32  f32
field  aplog.copter_ctun_tho  0:128:32  f32
field  aplog.copter_ctun_thh  0:160:32  f32
field  aplog.copter_ctun_dalt  0:192:32  f32
field  aplog.copter_ctun_alt  0:224:32  f32
field  aplog.copter_ctun_balt  0:256:32  twos
field  aplog.copter_ctun_dsalt  0:288:32  f32
field  aplog.copter_ctun_salt  0:320:32  f32
field  aplog.copter_ctun_talt  0:352:32  f32
field  aplog.copter_ctun_dcrt  0:384:16  twos
field  aplog.copter_ctun_crt  0:400:16  twos
