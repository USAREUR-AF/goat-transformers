# ArduPilot log message GPA as the payload of a DataFlash log record.
# Generated by tools/gen/aplog2pack.py; do not edit by hand.
# The record without its 3-byte header (0xA3 0x95 type-id); fields packed, little-endian.
format        ardupilot-log-gpa
version       0.1.0
distribution  public
source        "ArduPilot log message definitions (log structure tables and Write calls), https://github.com/ArduPilot/ardupilot at tag Copter-4.6.2, commit 1ebd4d996e8b6bbeb1462a9655c00aa861d5beef; message names, format strings, labels, units and multipliers only; GNU General Public License, version 3"
source        "ArduPilot libraries/AP_Logger/LogStructure.h: the format characters, units and multipliers of a log message, at the same commit"
uses          aplog
wire          bits
bit_order     lsb
word_bytes    1
field  aplog.gpa_timeus  0:0:64  uint
field  aplog.gpa_i  0:64:8  uint
field  aplog.gpa_vdop  0:72:16  uint
field  aplog.gpa_hacc  0:88:16  uint
field  aplog.gpa_vacc  0:104:16  uint
field  aplog.gpa_sacc  0:120:16  uint
field  aplog.gpa_yacc  0:136:32  f32
field  aplog.gpa_vv  0:168:8  uint
field  aplog.gpa_sms  0:176:32  uint
field  aplog.gpa_delta  0:208:16  uint
field  aplog.gpa_ael  0:224:32  twos
field  aplog.gpa_rtcmfu  0:256:16  uint
field  aplog.gpa_rtcmfd  0:272:16  uint
