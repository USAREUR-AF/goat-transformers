# ROS 2 actionlib_msgs messages in the JSON form of a rosbridge `publish` operation.
# Generated by tools/gen/ros2msg2pack.py; do not edit by hand.
# One kind per .msg file, selected by the member `type` ("<package>/msg/<Name>").
# The ROS message is the object under `msg`; arrays are groups.
format        ros2-actionlib-msgs
version       0.1.0
distribution  public
source        "ROS 2 interface package actionlib_msgs, https://github.com/ros2/common_interfaces 5.3.8 (Apache License 2.0) at commit a941f14bb318d8d904505ed935ccbb97f24a70a4, directory actionlib_msgs/msg; field names, types and array forms only"
source        "ROS 2 interface package builtin_interfaces (messages actionlib_msgs refers to), https://github.com/ros2/rcl_interfaces 2.0.4 at commit 7aa3caf43377ea6ad615bc1040832e2c7566bfbe, Apache License 2.0"
source        "ROS 2 interface package std_msgs (messages actionlib_msgs refers to), https://github.com/ros2/common_interfaces 5.3.8 at commit a941f14bb318d8d904505ed935ccbb97f24a70a4, Apache License 2.0"
source        "rosbridge v2.1.0 Protocol Specification, ROSBRIDGE_PROTOCOL.md, https://github.com/RobotWebTools/rosbridge_suite jazzy at commit cb33a16b890e4b8d9def531326409f3ee6c12537, BSD 3-Clause License; JSON form of a message and of the publish operation"
uses          ros2actionlib
wire          json
when   op  publish
field  ros2actionlib.topic  topic  string

kind      goal_id
when      type  actionlib_msgs/msg/GoalID
requires  ros2actionlib.goal_id_stamp_sec
field  ros2actionlib.goal_id_stamp_sec  msg.stamp.sec  int
field  ros2actionlib.goal_id_stamp_nanosec  msg.stamp.nanosec  int
field  ros2actionlib.goal_id_id  msg.id  string

kind      goal_status
when      type  actionlib_msgs/msg/GoalStatus
requires  ros2actionlib.goal_status_goal_id_stamp_sec
field  ros2actionlib.goal_status_goal_id_stamp_sec  msg.goal_id.stamp.sec  int
field  ros2actionlib.goal_status_goal_id_stamp_nanosec  msg.goal_id.stamp.nanosec  int
field  ros2actionlib.goal_status_goal_id_id  msg.goal_id.id  string
field  ros2actionlib.goal_status_status  msg.status  int
field  ros2actionlib.goal_status_text  msg.text  string

kind      goal_status_array
when      type  actionlib_msgs/msg/GoalStatusArray
requires  ros2actionlib.goal_status_array_header_stamp_sec
field  ros2actionlib.goal_status_array_header_stamp_sec  msg.header.stamp.sec  int
field  ros2actionlib.goal_status_array_header_stamp_nanosec  msg.header.stamp.nanosec  int
field  ros2actionlib.goal_status_array_header_frame_id  msg.header.frame_id  string
group  ros2actionlib.goal_status_array_status_list  msg.status_list
  field  ros2actionlib.goal_status_array_status_list_goal_id_stamp_sec  goal_id.stamp.sec  int
  field  ros2actionlib.goal_status_array_status_list_goal_id_stamp_nanosec  goal_id.stamp.nanosec  int
  field  ros2actionlib.goal_status_array_status_list_goal_id_id  goal_id.id  string
  field  ros2actionlib.goal_status_array_status_list_status  status  int
  field  ros2actionlib.goal_status_array_status_list_text  text  string
end
