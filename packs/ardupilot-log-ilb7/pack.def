# ArduPilot log message ILB7 as the payload of a DataFlash log record.
# Generated by tools/gen/aplog2pack.py; do not edit by hand.
# The record without its 3-byte header (0xA3 0x95 type-id); fields packed, little-endian.
format        ardupilot-log-ilb7
version       0.1.0
distribution  public
source        "ArduPilot log message definitions (log structure tables and Write calls), https://github.com/ArduPilot/ardupilot at tag Copter-4.6.2, commit 1ebd4d996e8b6bbeb1462a9655c00aa861d5beef; message names, format strings, labels, units and multipliers only; GNU General Public License, version 3"
source        "ArduPilot libraries/AP_Logger/LogStructure.h: the format characters, units and multipliers of a log message, at the same commit"
uses          aplog
wire          bits
bit_order     lsb
word_bytes    1
field  aplog.ilb7_timeus  0:0:64  uint
field  aplog.ilb7_gms  0:64:32  uint
field  aplog.ilb7_roll  0:96:32  f32
field  aplog.ilb7_pitch  0:128:32  f32
field  aplog.ilb7_yaw  0:160:32  f32
field  aplog.ilb7_vn  0:192:32  f32
field  aplog.ilb7_ve  0:224:32  f32
field  aplog.ilb7_vd  0:256:32  f32
field  aplog.ilb7_lat  0:288:32  f32
field  aplog.ilb7_lng  0:320:32  f32
field  aplog.ilb7_alt  0:352:32  f32
field  aplog.ilb7_usw  0:384:16  uint
field  aplog.ilb7_usw2  0:400:16  uint
field  aplog.ilb7_vdc  0:416:32  f32
