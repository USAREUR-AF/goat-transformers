# IGMP version 3 membership query and report (RFC 3376 sections 4.1 and 4.2),
# with their counted source lists and group records. Public. Auxiliary data in
# a group record, and octets after the described fields, are not mapped
# (pack.md).
#
# Addressing: word_bytes 1 and bit_order msb; multi-octet fields are big-endian.
# A counted list writes its count on encode, over the field mapped on the same
# bits (ruling 2 of 0.7).
format        igmpv3
version       0.1.0
distribution  public
source        "IETF RFC 3376, Internet Group Management Protocol, Version 3, October 2002, sections 4.1 and 4.2, https://www.rfc-editor.org/rfc/rfc3376.txt; layout restated"
uses          inet
wire          bits
word_bytes    1
bit_order     msb

field  inet.igmp_checksum           0:16:16    uint

kind      v3-membership-report
when      0:0:8  34
requires  inet.igmp3_group_records
field  inet.igmp3_report_reserved1  0:8:8      uint
field  inet.igmp3_report_reserved2  0:32:16    uint
field  inet.igmp3_num_records       0:48:16    uint
group  inet.igmp3_group_records  0:64  item 64  count 0:48:16
  field  inet.igmp3_record_type       0:0:8      uint
  field  inet.igmp3_aux_data_len      0:8:8      uint
  field  inet.igmp3_num_sources       0:16:16    uint
  field  inet.igmp3_multicast_addr    0:32:32    uint
  group  inet.igmp3_record_sources  0:64  item 32  count 0:16:16
    field  inet.igmp3_source_addr     0:0:32     uint
  end
end

kind      membership-query
when      0:0:8  17
field  inet.igmp3_max_resp_code     0:8:8      uint
field  inet.igmp_group_addr         0:32:32    uint
field  inet.igmp3_reserved          0:64:4     uint
field  inet.igmp3_suppress          0:68:1     uint
field  inet.igmp3_qrv               0:69:3     uint
field  inet.igmp3_qqic              0:72:8     uint
field  inet.igmp3_num_sources       0:80:16    uint
group  inet.igmp3_query_sources  0:96  item 32  count 0:80:16
  field  inet.igmp3_source_addr       0:0:32     uint
end
