# Conformance probe pack for `const` and `when` under `bit_order msb-lsb`
# (spec 0.22, ruling 2). Public. Bit order msb-lsb (spec 0.22): positions count from the high bit of
# each byte, a value is assembled from its first bit up.
#
#   4 bits        const 1
#   kind a        when 4 1, then x in 8 bits
#   kind b        when 4 2, then y in 8 bits
format     conformance-long-mlsb-kinds
version    0.22.0
distribution public
source  "goat-transformers spec/engine-spec.md (synthetic probe format, no external standard)"
uses       probe
wire       bits
layout     sequential
bit_order  msb-lsb
const   4  1
kind    a
when    4  1
requires probe.x
field   probe.x  8  uint
kind    b
when    4  2
requires probe.y
field   probe.y  8  uint
