        group  zcl.discover_rsp_records  rest
          field  zcl.discover_rsp_attribute_id  16  uint
          field  zcl.discover_rsp_data_type  8  uint
        end
    end
  case  1
    switch  zcl.direction
      case  0
        switch  zcl.command_id
          case  0
            field  zclssiaszone.enroll_rsp_enrollrspcode  8  uint
            field  zclssiaszone.enroll_rsp_zoneid  8  uint
          case  1
          case  2
            field  zclssiaszone.init_test_mode_test_mode_duration  8  uint
            field  zclssiaszone.init_test_mode_current_zone_sensitivity_level  8  uint
        end
      case  1
        switch  zcl.command_id
          case  0
            field  zclssiaszone.status_change_notification_zonestatus  16  uint
            field  zclssiaszone.status_change_notification_extendedstatus  8  uint
            field  zclssiaszone.status_change_notification_zone_id  8  uint
            field  zclssiaszone.status_change_notification_delay  16  uint
          case  1
            field  zclssiaszone.enroll_req_zonetype  16  uint
            field  zclssiaszone.enroll_req_manucode  16  uint
        end
    end
end
