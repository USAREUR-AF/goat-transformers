# ASTERIX Category 150, MADAP Plan Server - Flight Data Message, edition 3.0: one data block holding one record.
# Public. Generated by tools/gen/asterix2pack.py from the category definition of
# github.com/zoranbosnjak/asterix-specs (BSD-3-Clause); do not edit by hand. I/O is hex text.
# Needs engine version 0.8 (`layout sequential`). See pack.md.
#
#   octet 1       CAT = 150
#   octets 2-3    LEN, the length of the data block in octets, CAT and LEN included
#   FSPEC         octets of 7 presence bits and an extension bit; bit n is FRN n
#   then          the items whose FSPEC bit is 1, in FRN order
#
# An FRN with no `if` block is not mapped: a record with that FSPEC bit set fails
# with `malformed-wire` (ruling 1 of engine-spec 0.8), and encode never sets the bit.
format     asterix-cat150
version    0.1.0
distribution public
source  "ASTERIX Category 150, MADAP Plan Server - Flight Data Message, edition 3.0 (2004-08-20), as transcribed in github.com/zoranbosnjak/asterix-specs (BSD-3-Clause), commit 64e9ffba964b92a1af3157bc6bdf7852a63bf700, specs/cat150/cats/cat3.0/definition.json. The category is specified by EUROCONTROL"
uses       cat150
wire       bits
layout     sequential
bit_order  msb
kind    record
when    8  150                              # CAT
length  16 whole                         # LEN
presence f fx
if f.1                                   # FRN 1, I150/010 Destination ID
  field  cat150.i010_cen  8  uint
  field  cat150.i010_pos  8  uint
end
if f.2                                   # FRN 2, I150/020 Source ID
  field  cat150.i020_cen  8  uint
  field  cat150.i020_pos  8  uint
end
if f.3                                   # FRN 3, I150/030 Message Type
  field  cat150.i030  8  uint
end
if f.4                                   # FRN 4, I150/040 Plan Reference Number
  field  cat150.i040  16  uint
end
if f.5                                   # FRN 5, I150/050 Callsign
  field  cat150.i050  56  ascii
end
if f.6                                   # FRN 6, I150/060 Present Mode 3A
  field  cat150.i060  32  ascii
end
if f.7                                   # FRN 7, I150/070 Next Mode 3A
  field  cat150.i070  32  ascii
end
if f.8                                   # FRN 8, I150/080 Departure Aerodrome
  field  cat150.i080  32  ascii
end
if f.9                                   # FRN 9, I150/090 Destination Aerodrome
  field  cat150.i090  32  ascii
end
if f.10                                  # FRN 10, I150/100 Type Flags
  field  cat150.i100_gat  1  uint
  field  cat150.i100_oat  1  uint
  pad    3
  field  cat150.i100_cpl  1  uint
  field  cat150.i100_spn  1  uint
  pad    1
end
if f.11                                  # FRN 11, I150/110 Status Flags
  pad    1
  field  cat150.i110_hld  1  uint
  field  cat150.i110_rvq  1  uint
  field  cat150.i110_rvc  1  uint
  field  cat150.i110_rvx  1  uint
  pad    3
end
if f.12                                  # FRN 12, I150/120 Aircraft Type
  field  cat150.i120_noa  16  ascii
  field  cat150.i120_toa  32  ascii
  field  cat150.i120_wt  8  ascii
end
if f.13                                  # FRN 13, I150/130 Cleared Flight Level
  field  cat150.i130  24  ascii
end
if f.14                                  # FRN 14, I150/140 Route Points, Description
  group  cat150.i140  count 8
    field  cat150.i140_t  8  uint
    field  cat150.i140_e  88  ascii
  end
end
if f.15                                  # FRN 15, I150/150 Route Points, Coordinates
  group  cat150.i150  count 8
    field  cat150.i150_x  16  sscale:1/64
    field  cat150.i150_y  16  sscale:1/64
  end
end
if f.16                                  # FRN 16, I150/160 Route Points, Time
  group  cat150.i160  count 8
    field  cat150.i160_hh  16  ascii
    field  cat150.i160_mm  16  ascii
  end
end
if f.17                                  # FRN 17, I150/170 Route Points, Flight Level
  group  cat150.i170  count 8
    field  cat150.i170_val  24  ascii
  end
end
if f.18                                  # FRN 18, I150/180 Route Points, Speed
  group  cat150.i180  count 8
    field  cat150.i180_val  32  ascii
  end
end
if f.19                                  # FRN 19, I150/190 Controller ID
  field  cat150.i190  16  ascii
end
if f.20                                  # FRN 20, I150/200 Field 18
  group  cat150.i200  count 8
    field  cat150.i200_val  8  ascii
  end
end
if f.21                                  # FRN 21, I150/210 Correlated Track Number
  field  cat150.i210  16  uint
end
if f.22                                  # FRN 22, I150/220 Maximum Plan Count
  field  cat150.i220  16  uint
end
if f.23                                  # FRN 23, I150/230 Number of Plans
  field  cat150.i230  16  uint
end
if f.24                                  # FRN 24, I150/240 Newly Correlated Plans
  group  cat150.i240  count 8
    field  cat150.i240_plan  16  uint
    field  cat150.i240_track  16  uint
  end
end
if f.25                                  # FRN 25, I150/250 Newly De-correlated Plans
  group  cat150.i250  count 8
    field  cat150.i250_val  16  uint
  end
end
if f.26                                  # FRN 26, I150/251 Tracks in Conflict
  group  cat150.i251  count 8
    field  cat150.i251_track1  16  uint
    field  cat150.i251_track2  16  uint
  end
end
if f.27                                  # FRN 27, I150/171 Route Points, Requested Flight Level
  group  cat150.i171  count 8
    field  cat150.i171_val  24  ascii
  end
end
if f.28                                  # FRN 28, I150/151 Route Points, Geographic Position
  group  cat150.i151  count 8
    field  cat150.i151_lat  24  sscale:45/2097152
    field  cat150.i151_lon  24  sscale:45/2097152
  end
end
