# ROS 2 marti_perception_msgs messages in the JSON form of a rosbridge `publish` operation.
# Generated by tools/gen/ros2msg2pack.py; do not edit by hand.
# One kind per .msg file, selected by the member `type` ("<package>/msg/<Name>").
# The ROS message is the object under `msg`; arrays are groups.
format        ros2-marti-perception-msgs
version       0.1.0
distribution  public
source        "ROS 2 interface package marti_perception_msgs, https://github.com/swri-robotics/marti_messages ros2-devel (BSD License) at commit 2c7215f88d1466b698f77b8020533ac5fc75a3da, directory marti_perception_msgs/msg; field names, types and array forms only"
source        "ROS 2 interface package builtin_interfaces (messages marti_perception_msgs refers to), https://github.com/ros2/rcl_interfaces 2.0.4 at commit 7aa3caf43377ea6ad615bc1040832e2c7566bfbe, Apache License 2.0"
source        "ROS 2 interface package std_msgs (messages marti_perception_msgs refers to), https://github.com/ros2/common_interfaces 5.3.8 at commit a941f14bb318d8d904505ed935ccbb97f24a70a4, Apache License 2.0"
source        "rosbridge v2.1.0 Protocol Specification, ROSBRIDGE_PROTOCOL.md, https://github.com/RobotWebTools/rosbridge_suite jazzy at commit cb33a16b890e4b8d9def531326409f3ee6c12537, BSD 3-Clause License; JSON form of a message and of the publish operation"
uses          ros2martiperception
wire          json
when   op  publish
field  ros2martiperception.topic  topic  string

kind      pedestrian_image_id
when      type  marti_perception_msgs/msg/PedestrianImageID
requires  ros2martiperception.pedestrian_image_id_header_stamp_sec
field  ros2martiperception.pedestrian_image_id_header_stamp_sec  msg.header.stamp.sec  int
field  ros2martiperception.pedestrian_image_id_header_stamp_nanosec  msg.header.stamp.nanosec  int
field  ros2martiperception.pedestrian_image_id_header_frame_id  msg.header.frame_id  string
field  ros2martiperception.pedestrian_image_id_pixel_x  msg.pixel_x  int
field  ros2martiperception.pedestrian_image_id_pixel_y  msg.pixel_y  int
field  ros2martiperception.pedestrian_image_id_image_width  msg.image_width  int
field  ros2martiperception.pedestrian_image_id_image_height  msg.image_height  int
