# ArduPilot log message AIS4 as the payload of a DataFlash log record.
# Generated by tools/gen/aplog2pack.py; do not edit by hand.
# The record without its 3-byte header (0xA3 0x95 type-id); fields packed, little-endian.
format        ardupilot-log-ais4
version       0.1.0
distribution  public
source        "ArduPilot log message definitions (log structure tables and Write calls), https://github.com/ArduPilot/ardupilot at tag Copter-4.6.2, commit 1ebd4d996e8b6bbeb1462a9655c00aa861d5beef; message names, format strings, labels, units and multipliers only; GNU General Public License, version 3"
source        "ArduPilot libraries/AP_Logger/LogStructure.h: the format characters, units and multipliers of a log message, at the same commit"
uses          aplog
wire          bits
bit_order     lsb
word_bytes    1
field  aplog.ais4_us  0:0:64  uint
field  aplog.ais4_rep  0:64:8  uint
field  aplog.ais4_mmsi  0:72:32  uint
field  aplog.ais4_year  0:104:16  uint
field  aplog.ais4_mth  0:120:8  uint
field  aplog.ais4_day  0:128:8  uint
field  aplog.ais4_h  0:136:8  uint
field  aplog.ais4_m  0:144:8  uint
field  aplog.ais4_s  0:152:8  uint
field  aplog.ais4_fix  0:160:8  uint
field  aplog.ais4_lon  0:168:32  twos
field  aplog.ais4_lat  0:200:32  twos
field  aplog.ais4_epfd  0:232:8  uint
field  aplog.ais4_raim  0:240:8  uint
field  aplog.ais4_rad  0:248:32  uint
