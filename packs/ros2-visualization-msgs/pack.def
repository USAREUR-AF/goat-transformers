# ROS 2 visualization_msgs messages in the JSON form of a rosbridge `publish` operation.
# Generated by tools/gen/ros2msg2pack.py; do not edit by hand.
# One kind per .msg file, selected by the member `type` ("<package>/msg/<Name>").
# The ROS message is the object under `msg`; arrays are groups.
format        ros2-visualization-msgs
version       0.1.0
distribution  public
source        "ROS 2 interface package visualization_msgs, https://github.com/ros2/common_interfaces 5.3.8 (Apache License 2.0) at commit a941f14bb318d8d904505ed935ccbb97f24a70a4, directory visualization_msgs/msg; field names, types and array forms only"
