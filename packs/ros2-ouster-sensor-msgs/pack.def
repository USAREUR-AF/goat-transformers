# ROS 2 ouster_sensor_msgs messages in the JSON form of a rosbridge `publish` operation.
# Generated by tools/gen/ros2msg2pack.py; do not edit by hand.
# One kind per .msg file, selected by the member `type` ("<package>/msg/<Name>").
# The ROS message is the object under `msg`; arrays are groups.
format        ros2-ouster-sensor-msgs
version       0.1.0
distribution  public
source        "ROS 2 interface package ouster_sensor_msgs, https://github.com/ouster-lidar/ouster-ros ros2 (BSD 3-Clause License) at commit bbe9a890012226f7d9354250bbe212852b2443f2, directory ouster-sensor-msgs/msg; field names, types and array forms only"
source        "ROS 2 interface package builtin_interfaces (messages ouster_sensor_msgs refers to), https://github.com/ros2/rcl_interfaces 2.0.4 at commit 7aa3caf43377ea6ad615bc1040832e2c7566bfbe, Apache License 2.0"
source        "ROS 2 interface package std_msgs (messages ouster_sensor_msgs refers to), https://github.com/ros2/common_interfaces 5.3.8 at commit a941f14bb318d8d904505ed935ccbb97f24a70a4, Apache License 2.0"
source        "rosbridge v2.1.0 Protocol Specification, ROSBRIDGE_PROTOCOL.md, https://github.com/RobotWebTools/rosbridge_suite jazzy at commit cb33a16b890e4b8d9def531326409f3ee6c12537, BSD 3-Clause License; JSON form of a message and of the publish operation"
uses          ros2oustersensor
wire          json
when   op  publish
field  ros2oustersensor.topic  topic  string

kind      packet_msg
when      type  ouster_sensor_msgs/msg/PacketMsg
requires  ros2oustersensor.packet_msg_buf
field  ros2oustersensor.packet_msg_buf  msg.buf  string

kind      telemetry
when      type  ouster_sensor_msgs/msg/Telemetry
requires  ros2oustersensor.telemetry_header_stamp_sec
field  ros2oustersensor.telemetry_header_stamp_sec  msg.header.stamp.sec  int
field  ros2oustersensor.telemetry_header_stamp_nanosec  msg.header.stamp.nanosec  int
field  ros2oustersensor.telemetry_header_frame_id  msg.header.frame_id  string
field  ros2oustersensor.telemetry_countdown_thermal_shutdown  msg.countdown_thermal_shutdown  int
field  ros2oustersensor.telemetry_countdown_shot_limiting  msg.countdown_shot_limiting  int
field  ros2oustersensor.telemetry_thermal_shutdown  msg.thermal_shutdown  int
field  ros2oustersensor.telemetry_shot_limiting  msg.shot_limiting  int
