# ROS 2 radar_msgs messages in the JSON form of a rosbridge `publish` operation.
# Generated by tools/gen/ros2msg2pack.py; do not edit by hand.
# One kind per .msg file, selected by the member `type` ("<package>/msg/<Name>").
# The ROS message is the object under `msg`; arrays are groups.
format        ros2-radar-msgs
version       0.1.0
distribution  public
source        "ROS 2 interface package radar_msgs, https://github.com/ros-perception/radar_msgs ros2 (Apache License 2.0) at commit 47d2f26906ef38fa15ada352aea6b5aad547781d, directory msg; field names, types and array forms only"
source        "ROS 2 interface package builtin_interfaces (messages radar_msgs refers to), https://github.com/ros2/rcl_interfaces 2.0.4 at commit 7aa3caf43377ea6ad615bc1040832e2c7566bfbe, Apache License 2.0"
source        "ROS 2 interface package geometry_msgs (messages radar_msgs refers to), https://github.com/ros2/common_interfaces 5.3.8 at commit a941f14bb318d8d904505ed935ccbb97f24a70a4, Apache License 2.0"
source        "ROS 2 interface package std_msgs (messages radar_msgs refers to), https://github.com/ros2/common_interfaces 5.3.8 at commit a941f14bb318d8d904505ed935ccbb97f24a70a4, Apache License 2.0"
source        "ROS 2 interface package unique_identifier_msgs (messages radar_msgs refers to), https://github.com/ros2/unique_identifier_msgs jazzy at commit 901599ee92c2ee949f42a5c5d821c92b3e515d69, BSD 3-Clause License"
source        "rosbridge v2.1.0 Protocol Specification, ROSBRIDGE_PROTOCOL.md, https://github.com/RobotWebTools/rosbridge_suite jazzy at commit cb33a16b890e4b8d9def531326409f3ee6c12537, BSD 3-Clause License; JSON form of a message and of the publish operation"
uses          ros2radar
wire          json
when   op  publish
field  ros2radar.topic  topic  string

kind      radar_return
when      type  radar_msgs/msg/RadarReturn
requires  ros2radar.radar_return_range
field  ros2radar.radar_return_range  msg.range  float
field  ros2radar.radar_return_azimuth  msg.azimuth  float
field  ros2radar.radar_return_elevation  msg.elevation  float
field  ros2radar.radar_return_doppler_velocity  msg.doppler_velocity  float
field  ros2radar.radar_return_amplitude  msg.amplitude  float

kind      radar_scan
when      type  radar_msgs/msg/RadarScan
requires  ros2radar.radar_scan_header_stamp_sec
field  ros2radar.radar_scan_header_stamp_sec  msg.header.stamp.sec  int
field  ros2radar.radar_scan_header_stamp_nanosec  msg.header.stamp.nanosec  int
field  ros2radar.radar_scan_header_frame_id  msg.header.frame_id  string
group  ros2radar.radar_scan_returns  msg.returns
  field  ros2radar.radar_scan_returns_range  range  float
  field  ros2radar.radar_scan_returns_azimuth  azimuth  float
  field  ros2radar.radar_scan_returns_elevation  elevation  float
  field  ros2radar.radar_scan_returns_doppler_velocity  doppler_velocity  float
  field  ros2radar.radar_scan_returns_amplitude  amplitude  float
end

kind      radar_track
when      type  radar_msgs/msg/RadarTrack
requires  ros2radar.radar_track_uuid_uuid
field  ros2radar.radar_track_uuid_uuid  msg.uuid.uuid  string
field  ros2radar.radar_track_position_x  msg.position.x  float
field  ros2radar.radar_track_position_y  msg.position.y  float
field  ros2radar.radar_track_position_z  msg.position.z  float
field  ros2radar.radar_track_velocity_x  msg.velocity.x  float
field  ros2radar.radar_track_velocity_y  msg.velocity.y  float
field  ros2radar.radar_track_velocity_z  msg.velocity.z  float
field  ros2radar.radar_track_acceleration_x  msg.acceleration.x  float
field  ros2radar.radar_track_acceleration_y  msg.acceleration.y  float
field  ros2radar.radar_track_acceleration_z  msg.acceleration.z  float
field  ros2radar.radar_track_size_x  msg.size.x  float
field  ros2radar.radar_track_size_y  msg.size.y  float
field  ros2radar.radar_track_size_z  msg.size.z  float
field  ros2radar.radar_track_classification  msg.classification  int
group  ros2radar.radar_track_position_covariance  msg.position_covariance
  field  ros2radar.radar_track_position_covariance_value  .  float
end
group  ros2radar.radar_track_velocity_covariance  msg.velocity_covariance
  field  ros2radar.radar_track_velocity_covariance_value  .  float
end
group  ros2radar.radar_track_acceleration_covariance  msg.acceleration_covariance
  field  ros2radar.radar_track_acceleration_covariance_value  .  float
end
group  ros2radar.radar_track_size_covariance  msg.size_covariance
  field  ros2radar.radar_track_size_covariance_value  .  float
end

kind      radar_tracks
when      type  radar_msgs/msg/RadarTracks
requires  ros2radar.radar_tracks_header_stamp_sec
field  ros2radar.radar_tracks_header_stamp_sec  msg.header.stamp.sec  int
field  ros2radar.radar_tracks_header_stamp_nanosec  msg.header.stamp.nanosec  int
field  ros2radar.radar_tracks_header_frame_id  msg.header.frame_id  string
group  ros2radar.radar_tracks_tracks  msg.tracks
  field  ros2radar.radar_tracks_tracks_uuid_uuid  uuid.uuid  string
  field  ros2radar.radar_tracks_tracks_position_x  position.x  float
  field  ros2radar.radar_tracks_tracks_position_y  position.y  float
  field  ros2radar.radar_tracks_tracks_position_z  position.z  float
  field  ros2radar.radar_tracks_tracks_velocity_x  velocity.x  float
  field  ros2radar.radar_tracks_tracks_velocity_y  velocity.y  float
  field  ros2radar.radar_tracks_tracks_velocity_z  velocity.z  float
  field  ros2radar.radar_tracks_tracks_acceleration_x  acceleration.x  float
  field  ros2radar.radar_tracks_tracks_acceleration_y  acceleration.y  float
  field  ros2radar.radar_tracks_tracks_acceleration_z  acceleration.z  float
  field  ros2radar.radar_tracks_tracks_size_x  size.x  float
  field  ros2radar.radar_tracks_tracks_size_y  size.y  float
  field  ros2radar.radar_tracks_tracks_size_z  size.z  float
  field  ros2radar.radar_tracks_tracks_classification  classification  int
  group  ros2radar.radar_tracks_tracks_position_covariance  position_covariance
    field  ros2radar.radar_tracks_tracks_position_covariance_value  .  float
  end
  group  ros2radar.radar_tracks_tracks_velocity_covariance  velocity_covariance
    field  ros2radar.radar_tracks_tracks_velocity_covariance_value  .  float
  end
  group  ros2radar.radar_tracks_tracks_acceleration_covariance  acceleration_covariance
    field  ros2radar.radar_tracks_tracks_acceleration_covariance_value  .  float
  end
  group  ros2radar.radar_tracks_tracks_size_covariance  size_covariance
    field  ros2radar.radar_tracks_tracks_size_covariance_value  .  float
  end
end
