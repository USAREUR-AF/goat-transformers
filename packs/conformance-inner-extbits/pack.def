# Conformance probe pack used as an inner pack (spec 0.34):
# a length block counted in bits at the end of the message. Public.
format     conformance-inner-extbits
version    0.34.0
distribution public
source  "goat-transformers spec/engine-spec.md (synthetic probe format, no external standard)"
uses       probe
wire       bits
layout     sequential
bit_order  msb
length  8  bits
  field  probe.x  8  uint
end
