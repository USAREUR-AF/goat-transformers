# ArduPilot log message WINC as the payload of a DataFlash log record.
# Generated by tools/gen/aplog2pack.py; do not edit by hand.
# The record without its 3-byte header (0xA3 0x95 type-id); fields packed, little-endian.
format        ardupilot-log-winc
version       0.1.0
distribution  public
source        "ArduPilot log message definitions (log structure tables and Write calls), https://github.com/ArduPilot/ardupilot at tag Copter-4.6.2, commit 1ebd4d996e8b6bbeb1462a9655c00aa861d5beef; message names, format strings, labels, units and multipliers only; GNU General Public License, version 3"
source        "ArduPilot libraries/AP_Logger/LogStructure.h: the format characters, units and multipliers of a log message, at the same commit"
uses          aplog
wire          bits
bit_order     lsb
word_bytes    1
field  aplog.winc_timeus  0:0:64  uint
field  aplog.winc_heal  0:64:8  uint
field  aplog.winc_thend  0:72:8  uint
field  aplog.winc_mov  0:80:8  uint
field  aplog.winc_clut  0:88:8  uint
field  aplog.winc_mode  0:96:8  uint
field  aplog.winc_dlen  0:104:32  f32
field  aplog.winc_len  0:136:32  f32
field  aplog.winc_drate  0:168:32  f32
field  aplog.winc_tens  0:200:16  uint
field  aplog.winc_vcc  0:216:32  f32
field  aplog.winc_temp  0:248:8  twos
