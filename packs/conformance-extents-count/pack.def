# Conformance probe pack for a count before other fields (spec 0.21), most
# significant bit first. Public. No kinds.
#
#   n           a 2-bit count of nums
#   x           6 bits
#   nums        n items, val in 8 bits each
#   y           8 bits
format     conformance-extents-count
version    0.21.0
distribution public
source  "goat-transformers spec/engine-spec.md (synthetic probe format, no external standard)"
uses       probe
wire       bits
layout     sequential
bit_order  msb
count n 2
field   probe.x  6  uint
group   probe.nums count @n
  field  probe.val  8  uint
end
field   probe.y  8  uint
