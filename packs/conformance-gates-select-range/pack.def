# Conformance probe pack for gate blocks (spec 0.17, ruling 10): one key in
# two blocks of a selector whose transforms have different ranges. Fixed
# `bits` layout, least significant bit first. Public. No kinds. One byte per
# word. No raw key on the selector, so an entity's hae is encoded through the
# first block; a value that fits it but not the second block's transform is
# not an error, because the second block is not held.
#
#   byte 0       bit 0: the selector
#   byte 1       hae in units of 100 m when the selector is 0, of 25 m when 1
format     conformance-gates-select-range
version    0.17.0
distribution public
source  "goat-transformers spec/engine-spec.md (synthetic probe format, no external standard)"
uses       probe
wire       bits
word_bytes 1
if      0:0:1  0
  field hae       0:8:8   uscale:100
end
if      0:0:1  1
  field hae       0:8:8   uscale:25
end
