# SBP frames of the package swiftnav.sbp.profiling whose payload length is not fixed,
# one kind per message. Generated by tools/gen/sbp2pack.py; do not edit by hand.
# The frame: preamble 0x55, message type (u16), sender (u16), length (u8),
# payload, without the CRC. The payload is a `length 8 bytes` extent; an array
# or text that runs to its end is a `rest` group (engine-spec 0.8, 0.21).
format        sbp-profiling-var
version       0.1.0
distribution  public
source        "https://github.com/swift-nav/libsbp spec/yaml/swiftnav/sbp/profiling.yaml at v6.5.2 (commit 925825dea5174f069b5d6e23548f213e09f0235c)"
uses          sbp
uses          sbpprofiling
wire          bits
layout        sequential
bit_order     lsb
when  8  85

kind  measurement_point
when  16  52992
requires  sbpprofiling.measurement_point_total_time
field  sbp.sender  16  uint
length  8  bytes
  field  sbpprofiling.measurement_point_total_time  32  uint
  field  sbpprofiling.measurement_point_num_executions  16  uint
  field  sbpprofiling.measurement_point_min  32  uint
  field  sbpprofiling.measurement_point_max  32  uint
  field  sbpprofiling.measurement_point_return_addr  64  uint
  field  sbpprofiling.measurement_point_id  64  uint
  field  sbpprofiling.measurement_point_slice_time  64  uint
  field  sbpprofiling.measurement_point_line  16  uint
  group  sbpprofiling.measurement_point_func  rest
    field  sbpprofiling.measurement_point_func_byte  8  uint
  end
end

kind  profiling_thread_info
when  16  52994
requires  sbpprofiling.profiling_thread_info_total_cpu_time
field  sbp.sender  16  uint
length  8  bytes
  field  sbpprofiling.profiling_thread_info_total_cpu_time  64  uint
  field  sbpprofiling.profiling_thread_info_age  64  uint
  field  sbpprofiling.profiling_thread_info_state  8  uint
  field  sbpprofiling.profiling_thread_info_stack_size  32  uint
  field  sbpprofiling.profiling_thread_info_stack_usage  32  uint
  group  sbpprofiling.profiling_thread_info_name  rest
    field  sbpprofiling.profiling_thread_info_name_byte  8  uint
  end
end

kind  profiling_resource_counter
when  16  52995
requires  sbpprofiling.profiling_resource_counter_seq_no
field  sbp.sender  16  uint
length  8  bytes
  field  sbpprofiling.profiling_resource_counter_seq_no  8  uint
  field  sbpprofiling.profiling_resource_counter_seq_len  8  uint
  group  sbpprofiling.profiling_resource_counter_buckets  rest
    field  sbpprofiling.profiling_resource_counter_buckets_name  168  ascii
    field  sbpprofiling.profiling_resource_counter_buckets_thread  8  uint
    field  sbpprofiling.profiling_resource_counter_buckets_mutex  8  uint
    field  sbpprofiling.profiling_resource_counter_buckets_cv  8  uint
    field  sbpprofiling.profiling_resource_counter_buckets_io  8  uint
    field  sbpprofiling.profiling_resource_counter_buckets_heap_bytes_alloc  32  uint
    field  sbpprofiling.profiling_resource_counter_buckets_heap_bytes_free  32  uint
    field  sbpprofiling.profiling_resource_counter_buckets_io_write  32  uint
    field  sbpprofiling.profiling_resource_counter_buckets_io_read  32  uint
  end
end

kind  profiling_queue_info
when  16  52996
requires  sbpprofiling.profiling_queue_info_seq_no
field  sbp.sender  16  uint
length  8  bytes
  field  sbpprofiling.profiling_queue_info_seq_no  8  uint
  field  sbpprofiling.profiling_queue_info_seq_len  8  uint
  group  sbpprofiling.profiling_queue_info_queues  rest
    field  sbpprofiling.profiling_queue_info_queues_timestamp  64  uint
    field  sbpprofiling.profiling_queue_info_queues_name  320  ascii
    field  sbpprofiling.profiling_queue_info_queues_size  16  uint
    field  sbpprofiling.profiling_queue_info_queues_current_fill  16  uint
    field  sbpprofiling.profiling_queue_info_queues_peak_fill  16  uint
    field  sbpprofiling.profiling_queue_info_queues_drop_count  16  uint
  end
end
