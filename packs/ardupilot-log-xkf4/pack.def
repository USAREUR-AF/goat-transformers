# ArduPilot log message XKF4 as the payload of a DataFlash log record.
# Generated by tools/gen/aplog2pack.py; do not edit by hand.
# The record without its 3-byte header (0xA3 0x95 type-id); fields packed, little-endian.
format        ardupilot-log-xkf4
version       0.1.0
distribution  public
source        "ArduPilot log message definitions (log structure tables and Write calls), https://github.com/ArduPilot/ardupilot at tag Copter-4.6.2, commit 1ebd4d996e8b6bbeb1462a9655c00aa861d5beef; message names, format strings, labels, units and multipliers only; GNU General Public License, version 3"
source        "ArduPilot libraries/AP_Logger/LogStructure.h: the format characters, units and multipliers of a log message, at the same commit"
uses          aplog
wire          bits
bit_order     lsb
word_bytes    1
field  aplog.xkf4_timeus  0:0:64  uint
field  aplog.xkf4_c  0:64:8  uint
field  aplog.xkf4_sv  0:72:16  twos
field  aplog.xkf4_sp  0:88:16  twos
field  aplog.xkf4_sh  0:104:16  twos
field  aplog.xkf4_sm  0:120:16  twos
field  aplog.xkf4_svt  0:136:16  twos
field  aplog.xkf4_errrp  0:152:32  f32
field  aplog.xkf4_ofn  0:184:32  f32
field  aplog.xkf4_ofe  0:216:32  f32
field  aplog.xkf4_fs  0:248:16  uint
field  aplog.xkf4_ts  0:264:8  uint
field  aplog.xkf4_ss  0:272:32  uint
field  aplog.xkf4_gps  0:304:16  uint
field  aplog.xkf4_pi  0:320:8  twos
