# M17 Link Setup Frame (Type 1 bits): DST, SRC, TYPE, META by type, CRC. Written by tools/gen/hamdig-pack.py;
# do not edit by hand.
format        m17-lsf
version       0.1.0
distribution  public
source        "M17 Protocol Specification, https://github.com/M17-Project/M17_spec at commit 9ae2874d8bd44e2d32fae85f7650a23f6bcee5d3, M17_spec.tex, chapters Data Link Layer (Link Setup, CRC, Stream Frames, Packet Frames) and Application Layer (LSF TYPE and META) (GNU FDL 1.3 or later, Copyright 2023-2026 M17 Project); layouts restated, no text copied"
uses          m17
wire          bits
layout        sequential
bit_order     msb

field  m17.destination  48  hex
field  m17.source  48  hex
field  m17.type_reserved  4  uint
field  m17.signed_stream  1  uint
field  m17.channel_access_number  4  uint
field  m17.encryption_subtype  2  uint
field  m17.encryption_type  2  uint
field  m17.data_type  2  uint
field  m17.packet_stream  1  uint
switch  m17.encryption_type
  case  0
    switch  m17.encryption_subtype
      case  0
        field  m17.text_control  8  uint
        field  m17.text_block  104  hex
      case  1
        field  m17.gnss_data_source  4  uint
        field  m17.gnss_station_type  4  uint
        field  m17.gnss_validity  4  uint
        field  m17.gnss_radius  3  uint
        field  m17.gnss_bearing  9  uint
        field  m17.gnss_latitude  24  sscale:90/8388607
        field  m17.gnss_longitude  24  sscale:180/8388607
        field  m17.gnss_altitude  16  uscale:1/2:-500
        field  m17.gnss_speed  12  uscale:1/2
        field  m17.gnss_reserved  12  uint
      case  2
        field  m17.extended_callsign_1  48  hex
        field  m17.extended_callsign_2  48  hex
        field  m17.extended_unused  16  hex
      else
        field  m17.meta  112  hex
    end
  else
    field  m17.meta  112  hex
end
field  m17.crc  16  hex
