field  ros2lifecycle.transition_description_transition_id  msg.transition.id  int
field  ros2lifecycle.transition_description_transition_label  msg.transition.label  string
field  ros2lifecycle.transition_description_start_state_id  msg.start_state.id  int
field  ros2lifecycle.transition_description_start_state_label  msg.start_state.label  string
field  ros2lifecycle.transition_description_goal_state_id  msg.goal_state.id  int
