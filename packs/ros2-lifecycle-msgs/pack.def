# ROS 2 lifecycle_msgs messages in the JSON form of a rosbridge `publish` operation.
# Generated by tools/gen/ros2msg2pack.py; do not edit by hand.
# One kind per .msg file, selected by the member `type` ("<package>/msg/<Name>").
# The ROS message is the object under `msg`; arrays are groups.
format        ros2-lifecycle-msgs
version       0.1.0
distribution  public
source        "ROS 2 interface package lifecycle_msgs, https://github.com/ros2/rcl_interfaces 2.0.4 (Apache License 2.0) at commit 7aa3caf43377ea6ad615bc1040832e2c7566bfbe, directory lifecycle_msgs/msg; field names, types and array forms only"
