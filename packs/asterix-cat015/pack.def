  end
  if p603.3                       # subfield 3, COHAHP: Correlation of Horizontal Acceleration and Horizontal Position
    field  cat015.i603_cohahp_cohaxhpx  8  sscale:1/128
    field  cat015.i603_cohahp_cohaxhpy  8  sscale:1/128
