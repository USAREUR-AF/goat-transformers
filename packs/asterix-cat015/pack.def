    field  cat015.i603_cohahp_coayhpy  8  sscale:1/128
  end
  if p603.4                       # subfield 4, COHAHV: Correlation of Horizontal Acceleration and Horizontal Velocity
    field  cat015.i603_cohahv_cohaxhvx  8  sscale:1/128
    field  cat015.i603_cohahv_cohaxhvy  8  sscale:1/128
    field  cat015.i603_cohahv_cohayhvx  8  sscale:1/128
    field  cat015.i603_cohahv_cohayhvy  8  sscale:1/128
