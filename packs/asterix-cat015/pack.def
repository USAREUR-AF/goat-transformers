end
if f.10                                  # FRN 10, I015/270 Target Size & Orientation
  presence p270 fx
  if p270.1                       # subfield 1, LEN: Target Length
    field  cat015.i270_len  16  uscale:1/100
  end
  if p270.2                       # subfield 2, WDT: Target Width
    field  cat015.i270_wdt  16  uscale:1/100
  end
  if p270.3                       # subfield 3, HGT: Target Height
    field  cat015.i270_hgt  16  uscale:1/100
  end
  if p270.4                       # subfield 4, ORT: Target Orientation
    field  cat015.i270_ort  16  uscale:45/8192
  end
end
if f.11                                  # FRN 11, I015/300 Object Classification
