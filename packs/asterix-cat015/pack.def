end
if f.5                                   # FRN 5, I015/030 Warning/Error Conditions
  group  cat015.i030  fx
    field  cat015.i030_val  7  uint
  end
end
if f.6                                   # FRN 6, I015/145 Time of Applicability
  field  cat015.i145  24  uscale:1/128
end
if f.7                                   # FRN 7, I015/161 Track/Plot Number
