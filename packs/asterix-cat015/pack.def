# Needs engine version 0.8 (`layout sequential`). See pack.md.
#
#   octet 1       CAT = 15
#   octets 2-3    LEN, the length of the data block in octets, CAT and LEN included
#   FSPEC         octets of 7 presence bits and an extension bit; bit n is FRN n
#   then          the items whose FSPEC bit is 1, in FRN order
#
# An FRN with no `if` block is not mapped: a record with that FSPEC bit set fails
# with `malformed-wire` (ruling 1 of engine-spec 0.8), and encode never sets the bit.
format     asterix-cat015
version    0.1.0
distribution public
source  "ASTERIX Category 015, Independent Non-Cooperative Surveillance System Target Reports, edition 1.2 (2024-05-01), as transcribed in github.com/zoranbosnjak/asterix-specs (BSD-3-Clause), commit 64e9ffba964b92a1af3157bc6bdf7852a63bf700, specs/cat015/cats/cat1.2/definition.json. The category is specified by EUROCONTROL"
uses       cat015
wire       bits
layout     sequential
bit_order  msb
kind    record
when    8  15                              # CAT
length  16 whole                         # LEN
presence f fx
if f.1                                   # FRN 1, I015/010 Data Source Identifier
  field  cat015.i010_sac  8  uint
