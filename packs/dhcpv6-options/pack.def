# DHCPv6 options area (RFC 9915 section 21). Public. Maintained by hand.
# A message is the options area only: one option after another, each a 2-octet
# code, a 2-octet length and that many octets. pack.md states what is mapped.
format        dhcpv6-options
version       0.1.0
distribution  public
source        "RFC 9915, Dynamic Host Configuration Protocol for IPv6 (DHCPv6), section 21 (option format; sizes of options 7, 8, 19, 32, 82, 83); IETF Trust, BCP 78; layouts restated, no text copied"
source        "IANA registry Dynamic Host Configuration Protocol for IPv6 (DHCPv6), Option Codes (https://www.iana.org/assignments/dhcpv6-parameters), CC0 1.0 per the IANA and IETF joint statement of 10 November 2021: option codes and names"
uses          dhcpv6
wire          tlv
tag           2
length        2

field  dhcpv6.opt1_clientid                                1        hex
field  dhcpv6.opt2_serverid                                2        hex
field  dhcpv6.opt3_ia_na                                   3        hex
field  dhcpv6.opt4_ia_ta                                   4        hex
field  dhcpv6.opt5_iaaddr                                  5        hex
field  dhcpv6.opt6_oro                                     6        hex
field  dhcpv6.opt7_preference                              7:1      uint
field  dhcpv6.opt8_elapsed_time                            8:2      uint
field  dhcpv6.opt9_relay_msg                               9        hex
field  dhcpv6.opt11_auth                                   11       hex
field  dhcpv6.opt12_unicast                                12       hex
field  dhcpv6.opt13_status_code                            13       hex
field  dhcpv6.opt14_rapid_commit                           14       hex
field  dhcpv6.opt15_user_class                             15       hex
field  dhcpv6.opt16_vendor_class                           16       hex
field  dhcpv6.opt17_vendor_opts                            17       hex
field  dhcpv6.opt18_interface_id                           18       hex
field  dhcpv6.opt19_reconf_msg                             19:1     uint
field  dhcpv6.opt20_reconf_accept                          20       hex
field  dhcpv6.opt21_sip_server_d                           21       hex
field  dhcpv6.opt22_sip_server_a                           22       hex
field  dhcpv6.opt23_dns_servers                            23       hex
field  dhcpv6.opt24_domain_list                            24       hex
field  dhcpv6.opt25_ia_pd                                  25       hex
field  dhcpv6.opt26_iaprefix                               26       hex
field  dhcpv6.opt27_nis_servers                            27       hex
field  dhcpv6.opt28_nisp_servers                           28       hex
field  dhcpv6.opt29_nis_domain_name                        29       hex
field  dhcpv6.opt30_nisp_domain_name                       30       hex
field  dhcpv6.opt31_sntp_servers                           31       hex
field  dhcpv6.opt32_information_refresh_time               32:4     uint
field  dhcpv6.opt33_bcmcs_server_d                         33       hex
field  dhcpv6.opt34_bcmcs_server_a                         34       hex
field  dhcpv6.opt36_geoconf_civic                          36       hex
field  dhcpv6.opt37_remote_id                              37       hex
