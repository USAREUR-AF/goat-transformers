# ROS 2 tf2_msgs messages in the JSON form of a rosbridge `publish` operation.
# Generated by tools/gen/ros2msg2pack.py; do not edit by hand.
# One kind per .msg file, selected by the member `type` ("<package>/msg/<Name>").
# The ROS message is the object under `msg`; arrays are groups.
format        ros2-tf2-msgs
version       0.1.0
distribution  public
source        "ROS 2 interface package tf2_msgs, https://github.com/ros2/geometry2 jazzy (BSD 3-Clause License) at commit f702874b1c8535d6a038230ab2cda0ba5d521ebd, directory tf2_msgs/msg; field names, types and array forms only"
source        "ROS 2 interface package builtin_interfaces (messages tf2_msgs refers to), https://github.com/ros2/rcl_interfaces 2.0.4 at commit 7aa3caf43377ea6ad615bc1040832e2c7566bfbe, Apache License 2.0"
source        "ROS 2 interface package geometry_msgs (messages tf2_msgs refers to), https://github.com/ros2/common_interfaces 5.3.8 at commit a941f14bb318d8d904505ed935ccbb97f24a70a4, Apache License 2.0"
source        "ROS 2 interface package std_msgs (messages tf2_msgs refers to), https://github.com/ros2/common_interfaces 5.3.8 at commit a941f14bb318d8d904505ed935ccbb97f24a70a4, Apache License 2.0"
source        "rosbridge v2.1.0 Protocol Specification, ROSBRIDGE_PROTOCOL.md, https://github.com/RobotWebTools/rosbridge_suite jazzy at commit cb33a16b890e4b8d9def531326409f3ee6c12537, BSD 3-Clause License; JSON form of a message and of the publish operation"
uses          ros2tf2
wire          json
when   op  publish
field  ros2tf2.topic  topic  string

kind      tf2_error
when      type  tf2_msgs/msg/TF2Error
requires  ros2tf2.tf2_error_error
field  ros2tf2.tf2_error_error  msg.error  int
field  ros2tf2.tf2_error_error_string  msg.error_string  string

kind      tf_message
when      type  tf2_msgs/msg/TFMessage
requires  ros2tf2.tf_message_transforms
group  ros2tf2.tf_message_transforms  msg.transforms
  field  ros2tf2.tf_message_transforms_header_stamp_sec  header.stamp.sec  int
  field  ros2tf2.tf_message_transforms_header_stamp_nanosec  header.stamp.nanosec  int
  field  ros2tf2.tf_message_transforms_header_frame_id  header.frame_id  string
  field  ros2tf2.tf_message_transforms_child_frame_id  child_frame_id  string
  field  ros2tf2.tf_message_transforms_transform_translation_x  transform.translation.x  float
  field  ros2tf2.tf_message_transforms_transform_translation_y  transform.translation.y  float
  field  ros2tf2.tf_message_transforms_transform_translation_z  transform.translation.z  float
  field  ros2tf2.tf_message_transforms_transform_rotation_x  transform.rotation.x  float
  field  ros2tf2.tf_message_transforms_transform_rotation_y  transform.rotation.y  float
  field  ros2tf2.tf_message_transforms_transform_rotation_z  transform.rotation.z  float
  field  ros2tf2.tf_message_transforms_transform_rotation_w  transform.rotation.w  float
end
