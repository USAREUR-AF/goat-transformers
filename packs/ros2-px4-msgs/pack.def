# ROS 2 px4_msgs messages in the JSON form of a rosbridge `publish` operation.
# Generated by tools/gen/ros2msg2pack.py; do not edit by hand.
# One kind per .msg file, selected by the member `type` ("<package>/msg/<Name>").
# The ROS message is the object under `msg`; arrays are groups.
format        ros2-px4-msgs
version       0.1.0
distribution  public
source        "ROS 2 interface package px4_msgs, https://github.com/PX4/px4_msgs main (BSD 3-Clause License) at commit 9b095a412c38b4d03a88670a1c81a1a958180986, directory msg; field names, types and array forms only"
