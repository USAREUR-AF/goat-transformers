{
  "name": "x-target_gnss-to-geojson",
  "from": "ros2-px4-msgs",
  "to": "geojson",
  "source": "tools/gen/ros2msg2pack.py: a full sample message with the bound fields set to a point; latitude, longitude and altitude are core lat, lon, hae (pack.md); geojson writes [lon, lat, alt] (RFC 7946, engine-spec 0.1.1 ruling 4)",
  "input": "{\"op\":\"publish\",\"topic\":\"/geo\",\"type\":\"px4_msgs/msg/TargetGnss\",\"msg\":{\"timestamp\":123456789013,\"timestamp_sample\":246913578026,\"latitude_deg\":47.0625,\"longitude_deg\":8.53125,\"altitude_msl_m\":-3.875,\"eph\":-3.625,\"epv\":-3.375,\"abs_pos_updated\":false,\"vel_n_m_s\":-2.875,\"vel_e_m_s\":-2.625,\"vel_d_m_s\":-2.375,\"s_acc_m_s\":-2.125,\"vel_ned_updated\":true}}",
  "expect": "{\"type\":\"Feature\",\"geometry\":{\"type\":\"Point\",\"coordinates\":[8.53125,47.0625]},\"properties\":{}}",
  "model": {
    "@kind": "target_gnss",
    "lat": "47.0625",
    "lon": "8.53125"
  }
}
