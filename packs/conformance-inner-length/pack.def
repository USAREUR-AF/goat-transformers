# Conformance probe pack for an inner message inside a length block
# (spec 0.34), most significant bit first. Public. No kinds.
#
#   byte 0      n
#   block       an 8-bit length in bytes, then one conformance-inner-seq message
#               to the end of the block
#   byte        w, after the block
format     conformance-inner-length
version    0.34.0
distribution public
source  "goat-transformers spec/engine-spec.md (synthetic probe format, no external standard)"
uses       probe
wire       bits
layout     sequential
bit_order  msb
field   probe.n  8  uint
length 8
  inner  conformance-inner-seq
end
field   probe.w  8  uint
