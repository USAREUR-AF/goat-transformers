# Conformance probe pack for the field option `implicit` (spec 0.56) on
# `protobuf`. Public. Two kinds: `sub` holds a submessage at field 9 whose
# only field is implicit, so an entity with probe.y 0 writes the empty
# submessage of ruling 14 of 0.5.
format  conformance-implicit
version 0.56.0
distribution public
source  "goat-transformers spec/engine-spec.md (synthetic probe format, no external standard)"
uses    probe
wire    protobuf
field   probe.n      1  pvarint  implicit
field   probe.x      2  psint    implicit
field   probe.a      3  pdouble  implicit
field   probe.ratio  4  pfloat   implicit
field   probe.label  5  pstring  implicit
field   probe.qty    6  pvarint  implicit
default probe.qty    0
field   probe.w      7  pvarint
kind     sub
when     9  present
requires probe.y
field    probe.y  9.1  pvarint  implicit
kind     plain
