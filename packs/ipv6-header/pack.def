# IPv6 header (RFC 8200 section 3): the fixed 40 octets. Public.
# Extension headers and the payload are not mapped (pack.md).
#
# Addressing: word_bytes 1 and bit_order msb, so a locator is 0:<bit>:<len>
# with bit 0 the most significant bit of the first octet, and a multi-octet
# field is a big-endian (network order) integer. Each 128-bit address is held
# as eight 16-bit groups, first group first, as the text form writes them.
format        ipv6-header
version       0.1.0
distribution  public
source        "IETF RFC 8200, Internet Protocol, Version 6 (IPv6) Specification, July 2017, section 3, https://www.rfc-editor.org/rfc/rfc8200.txt; layout restated"
uses          inet
wire          bits
word_bytes    1
bit_order     msb

# One kind, so that the version nibble selects it: a version-4 packet is no-kind.
kind      ipv6
when      0:0:4  6
requires  inet.ipv6_src_g0 inet.ipv6_dst_g0
field  inet.ipv6_version            0:0:4      uint
field  inet.ipv6_traffic_class      0:4:8      uint
field  inet.ipv6_flow_label         0:12:20    uint
field  inet.ipv6_payload_length     0:32:16    uint
field  inet.ip_protocol             0:48:8     uint
field  inet.ipv6_hop_limit          0:56:8     uint
field  inet.ipv6_src_g0            0:64:16    uint
field  inet.ipv6_src_g1            0:80:16    uint
field  inet.ipv6_src_g2            0:96:16    uint
field  inet.ipv6_src_g3            0:112:16    uint
field  inet.ipv6_src_g4            0:128:16    uint
field  inet.ipv6_src_g5            0:144:16    uint
field  inet.ipv6_src_g6            0:160:16    uint
field  inet.ipv6_src_g7            0:176:16    uint
field  inet.ipv6_dst_g0            0:192:16    uint
field  inet.ipv6_dst_g1            0:208:16    uint
field  inet.ipv6_dst_g2            0:224:16    uint
field  inet.ipv6_dst_g3            0:240:16    uint
field  inet.ipv6_dst_g4            0:256:16    uint
field  inet.ipv6_dst_g5            0:272:16    uint
field  inet.ipv6_dst_g6            0:288:16    uint
field  inet.ipv6_dst_g7            0:304:16    uint
