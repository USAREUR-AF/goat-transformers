# ArduPilot log message PRX as the payload of a DataFlash log record.
# Generated by tools/gen/aplog2pack.py; do not edit by hand.
# The record without its 3-byte header (0xA3 0x95 type-id); fields packed, little-endian.
format        ardupilot-log-prx
version       0.1.0
distribution  public
source        "ArduPilot log message definitions (log structure tables and Write calls), https://github.com/ArduPilot/ardupilot at tag Copter-4.6.2, commit 1ebd4d996e8b6bbeb1462a9655c00aa861d5beef; message names, format strings, labels, units and multipliers only; GNU General Public License, version 3"
source        "ArduPilot libraries/AP_Logger/LogStructure.h: the format characters, units and multipliers of a log message, at the same commit"
uses          aplog
wire          bits
bit_order     lsb
word_bytes    1
field  aplog.prx_timeus  0:0:64  uint
field  aplog.prx_layer  0:64:8  uint
field  aplog.prx_he  0:72:8  uint
field  aplog.prx_d0  0:80:32  f32
field  aplog.prx_d45  0:112:32  f32
field  aplog.prx_d90  0:144:32  f32
field  aplog.prx_d135  0:176:32  f32
field  aplog.prx_d180  0:208:32  f32
field  aplog.prx_d225  0:240:32  f32
field  aplog.prx_d270  0:272:32  f32
field  aplog.prx_d315  0:304:32  f32
field  aplog.prx_dup  0:336:32  f32
field  aplog.prx_can  0:368:32  f32
field  aplog.prx_cdis  0:400:32  f32
