# ArduPilot log message RCDA as the payload of a DataFlash log record.
# Generated by tools/gen/aplog2pack.py; do not edit by hand.
# The record without its 3-byte header (0xA3 0x95 type-id); fields packed, little-endian.
format        ardupilot-log-rcda
version       0.1.0
distribution  public
source        "ArduPilot log message definitions (log structure tables and Write calls), https://github.com/ArduPilot/ardupilot at tag Copter-4.6.2, commit 1ebd4d996e8b6bbeb1462a9655c00aa861d5beef; message names, format strings, labels, units and multipliers only; GNU General Public License, version 3"
source        "ArduPilot libraries/AP_Logger/LogStructure.h: the format characters, units and multipliers of a log message, at the same commit"
uses          aplog
wire          bits
bit_order     lsb
word_bytes    1
field  aplog.rcda_timeus  0:0:64  uint
field  aplog.rcda_ts  0:64:32  uint
field  aplog.rcda_prot  0:96:8  uint
field  aplog.rcda_len  0:104:8  uint
field  aplog.rcda_u0  0:112:32  uint
field  aplog.rcda_u1  0:144:32  uint
field  aplog.rcda_u2  0:176:32  uint
field  aplog.rcda_u3  0:208:32  uint
field  aplog.rcda_u4  0:240:32  uint
field  aplog.rcda_u5  0:272:32  uint
field  aplog.rcda_u6  0:304:32  uint
field  aplog.rcda_u7  0:336:32  uint
field  aplog.rcda_u8  0:368:32  uint
field  aplog.rcda_u9  0:400:32  uint
