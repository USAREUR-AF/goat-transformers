# ROS 2 diagnostic_msgs messages in the JSON form of a rosbridge `publish` operation.
# Generated by tools/gen/ros2msg2pack.py; do not edit by hand.
# One kind per .msg file, selected by the member `type` ("<package>/msg/<Name>").
# The ROS message is the object under `msg`; arrays are groups.
format        ros2-diagnostic-msgs
version       0.1.0
distribution  public
source        "ROS 2 interface package diagnostic_msgs, https://github.com/ros2/common_interfaces 5.3.8 (Apache License 2.0) at commit a941f14bb318d8d904505ed935ccbb97f24a70a4, directory diagnostic_msgs/msg; field names, types and array forms only"
source        "ROS 2 interface package builtin_interfaces (messages diagnostic_msgs refers to), https://github.com/ros2/rcl_interfaces 2.0.4 at commit 7aa3caf43377ea6ad615bc1040832e2c7566bfbe, Apache License 2.0"
source        "ROS 2 interface package std_msgs (messages diagnostic_msgs refers to), https://github.com/ros2/common_interfaces 5.3.8 at commit a941f14bb318d8d904505ed935ccbb97f24a70a4, Apache License 2.0"
source        "rosbridge v2.1.0 Protocol Specification, ROSBRIDGE_PROTOCOL.md, https://github.com/RobotWebTools/rosbridge_suite jazzy at commit cb33a16b890e4b8d9def531326409f3ee6c12537, BSD 3-Clause License; JSON form of a message and of the publish operation"
uses          ros2diagnostic
wire          json
when   op  publish
field  ros2diagnostic.topic  topic  string

kind      diagnostic_array
when      type  diagnostic_msgs/msg/DiagnosticArray
requires  ros2diagnostic.diagnostic_array_header_stamp_sec
field  ros2diagnostic.diagnostic_array_header_stamp_sec  msg.header.stamp.sec  int
field  ros2diagnostic.diagnostic_array_header_stamp_nanosec  msg.header.stamp.nanosec  int
field  ros2diagnostic.diagnostic_array_header_frame_id  msg.header.frame_id  string
group  ros2diagnostic.diagnostic_array_status  msg.status
  field  ros2diagnostic.diagnostic_array_status_level  level  int
  field  ros2diagnostic.diagnostic_array_status_name  name  string
  field  ros2diagnostic.diagnostic_array_status_message  message  string
  field  ros2diagnostic.diagnostic_array_status_hardware_id  hardware_id  string
  group  ros2diagnostic.diagnostic_array_status_values  values
    field  ros2diagnostic.diagnostic_array_status_values_key  key  string
    field  ros2diagnostic.diagnostic_array_status_values_value  value  string
  end
end

kind      diagnostic_status
when      type  diagnostic_msgs/msg/DiagnosticStatus
requires  ros2diagnostic.diagnostic_status_level
field  ros2diagnostic.diagnostic_status_level  msg.level  int
field  ros2diagnostic.diagnostic_status_name  msg.name  string
field  ros2diagnostic.diagnostic_status_message  msg.message  string
field  ros2diagnostic.diagnostic_status_hardware_id  msg.hardware_id  string
group  ros2diagnostic.diagnostic_status_values  msg.values
  field  ros2diagnostic.diagnostic_status_values_key  key  string
  field  ros2diagnostic.diagnostic_status_values_value  value  string
end

kind      key_value
when      type  diagnostic_msgs/msg/KeyValue
requires  ros2diagnostic.key_value_key
field  ros2diagnostic.key_value_key  msg.key  string
field  ros2diagnostic.key_value_value  msg.value  string
