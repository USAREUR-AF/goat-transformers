# ROS 2 geographic_msgs messages in the JSON form of a rosbridge `publish` operation.
# Generated by tools/gen/ros2msg2pack.py; do not edit by hand.
# One kind per .msg file, selected by the member `type` ("<package>/msg/<Name>").
# The ROS message is the object under `msg`; arrays are groups.
format        ros2-geographic-msgs
version       0.1.0
distribution  public
source        "ROS 2 interface package geographic_msgs, https://github.com/ros-geographic-info/geographic_info jazzy (BSD License (package.xml)) at commit 24806adc767414eb3a34a58aefeb648ee415b09a, directory geographic_msgs/msg; field names, types and array forms only"
