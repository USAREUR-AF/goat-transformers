  field  ros2geographic.geo_path_poses_header_frame_id  header.frame_id  string
  field  ros2geographic.geo_path_poses_pose_position_latitude  pose.position.latitude  float
  field  ros2geographic.geo_path_poses_pose_position_longitude  pose.position.longitude  float
  field  ros2geographic.geo_path_poses_pose_position_altitude  pose.position.altitude  float
