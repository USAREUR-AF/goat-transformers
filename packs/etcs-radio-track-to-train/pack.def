# An ERTMS/ETCS radio message from the RBC to the train. Public.
format        etcs-radio-track-to-train
version       0.1.0
distribution  public
source        "ERA SUBSET-026 (ERTMS/ETCS System Requirements Specification) issue 3.6.0, 13/05/2016, chapter 7 (ERTMS/ETCS language: packets and variables) and chapter 8 (messages), from the CCS TSI set of specifications 3 published by the European Union Agency for Railways (era.europa.eu); no licence stated; layouts restated"
uses          etcs
wire          bits
layout        sequential
bit_order     msb

kind  sr_authorisation
when  8  2  as  etcs.nid_message
requires  etcs.t_train  etcs.m_ack  etcs.lrbg_nid_c  etcs.lrbg_nid_bg  etcs.m2_q_scale  etcs.m2_d_sr
length  10  whole                    # L_MESSAGE, bytes of the whole message
field  etcs.t_train  32  uint
field  etcs.m_ack  1  uint
field  etcs.lrbg_nid_c  10  uint
field  etcs.lrbg_nid_bg  14  uint
field  etcs.m2_q_scale  2  uint
field  etcs.m2_d_sr  15  uint
group  etcs.optional_packets  rest
  kind  p5
  when  8  5
  field  etcs.q_dir  2  uint
  length  13  bits  plus 23           # L_PACKET counts NID_PACKET, Q_DIR and itself
    field  etcs.p5_q_scale  2  uint
    field  etcs.p5_d_link  15  uint
    presence  q13  1                       # Q_NEWCOUNTRY
    if  q13.1
      field  etcs.p5_nid_c  10  uint
    end
    field  etcs.p5_nid_bg  14  uint
    field  etcs.p5_q_linkorientation  1  uint
    field  etcs.p5_q_linkreaction  2  uint
    field  etcs.p5_q_locacc  6  uint
    group  etcs.p5_links  count 5
      field  etcs.p5_link_d_link  15  uint
      presence  q14  1                       # Q_NEWCOUNTRY
      if  q14.1
        field  etcs.p5_link_nid_c  10  uint
      end
      field  etcs.p5_link_nid_bg  14  uint
      field  etcs.p5_link_q_linkorientation  1  uint
      field  etcs.p5_link_q_linkreaction  2  uint
      field  etcs.p5_link_q_locacc  6  uint
    end
  end
  kind  p12
  when  8  12
  field  etcs.q_dir  2  uint
  length  13  bits  plus 23           # L_PACKET counts NID_PACKET, Q_DIR and itself
    field  etcs.p12_q_scale  2  uint
    field  etcs.p12_v_main  7  uint
    field  etcs.p12_v_ema  7  uint
    field  etcs.p12_t_ema  10  uint
    group  etcs.p12_sections  count 5                 # N_ITER
      field  etcs.p12_l_section  15  uint
      presence  q15  1                       # Q_SECTIONTIMER(k)
      if  q15.1
        field  etcs.p12_t_sectiontimer  10  uint
        field  etcs.p12_d_sectiontimerstoploc  15  uint
      end
    end
    field  etcs.p12_l_endsection  15  uint
    presence  q16  1                       # Q_SECTIONTIMER
    if  q16.1
      field  etcs.p12_end_t_sectiontimer  10  uint
      field  etcs.p12_end_d_sectiontimerstoploc  15  uint
    end
    presence  q17  1                       # Q_ENDTIMER
    if  q17.1
      field  etcs.p12_t_endtimer  10  uint
      field  etcs.p12_d_endtimerstartloc  15  uint
    end
    presence  q18  1                       # Q_DANGERPOINT
    if  q18.1
      field  etcs.p12_d_dp  15  uint
      field  etcs.p12_v_releasedp  7  uint
    end
    presence  q19  1                       # Q_OVERLAP
    if  q19.1
      field  etcs.p12_d_startol  15  uint
      field  etcs.p12_t_ol  10  uint
      field  etcs.p12_d_ol  15  uint
      field  etcs.p12_v_releaseol  7  uint
    end
  end
  kind  p21
  when  8  21
  field  etcs.q_dir  2  uint
