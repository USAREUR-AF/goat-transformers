# ROS 2 tier4_control_msgs messages in the JSON form of a rosbridge `publish` operation.
# Generated by tools/gen/ros2msg2pack.py; do not edit by hand.
# One kind per .msg file, selected by the member `type` ("<package>/msg/<Name>").
# The ROS message is the object under `msg`; arrays are groups.
format        ros2-tier4-control-msgs
version       0.1.0
distribution  public
source        "ROS 2 interface package tier4_control_msgs, https://github.com/tier4/tier4_autoware_msgs tier4/universe (Apache License 2.0) at commit efa4129394ad0b83a1de6c6d90ad937d74e9e426, directory tier4_control_msgs/msg; field names, types and array forms only"
source        "ROS 2 interface package builtin_interfaces (messages tier4_control_msgs refers to), https://github.com/ros2/rcl_interfaces 2.0.4 at commit 7aa3caf43377ea6ad615bc1040832e2c7566bfbe, Apache License 2.0"
source        "rosbridge v2.1.0 Protocol Specification, ROSBRIDGE_PROTOCOL.md, https://github.com/RobotWebTools/rosbridge_suite jazzy at commit cb33a16b890e4b8d9def531326409f3ee6c12537, BSD 3-Clause License; JSON form of a message and of the publish operation"
uses          ros2tier4control
wire          json
when   op  publish
field  ros2tier4control.topic  topic  string

kind      external_command_selector_mode
when      type  tier4_control_msgs/msg/ExternalCommandSelectorMode
requires  ros2tier4control.external_command_selector_mode_data
field  ros2tier4control.external_command_selector_mode_data  msg.data  int

kind      gate_mode
when      type  tier4_control_msgs/msg/GateMode
requires  ros2tier4control.gate_mode_data
field  ros2tier4control.gate_mode_data  msg.data  int

kind      is_paused
when      type  tier4_control_msgs/msg/IsPaused
requires  ros2tier4control.is_paused_stamp_sec
field  ros2tier4control.is_paused_stamp_sec  msg.stamp.sec  int
field  ros2tier4control.is_paused_stamp_nanosec  msg.stamp.nanosec  int
field  ros2tier4control.is_paused_data  msg.data  bool

kind      is_start_requested
when      type  tier4_control_msgs/msg/IsStartRequested
requires  ros2tier4control.is_start_requested_stamp_sec
field  ros2tier4control.is_start_requested_stamp_sec  msg.stamp.sec  int
field  ros2tier4control.is_start_requested_stamp_nanosec  msg.stamp.nanosec  int
field  ros2tier4control.is_start_requested_data  msg.data  bool

kind      is_stopped
when      type  tier4_control_msgs/msg/IsStopped
requires  ros2tier4control.is_stopped_stamp_sec
field  ros2tier4control.is_stopped_stamp_sec  msg.stamp.sec  int
field  ros2tier4control.is_stopped_stamp_nanosec  msg.stamp.nanosec  int
field  ros2tier4control.is_stopped_data  msg.data  bool
group  ros2tier4control.is_stopped_requested_sources  msg.requested_sources
  field  ros2tier4control.is_stopped_requested_sources_value  .  string
end
