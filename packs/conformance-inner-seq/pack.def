# Conformance probe pack used as an inner pack (spec 0.34): a sequential
# layout with two kinds, most significant bit first. Public.
#
#   byte 0      the kind: 1 = a, 2 = b
#   kind a      x in 8 bits, y in 8 bits
#   kind b      z in 16 bits
format     conformance-inner-seq
version    0.34.0
distribution public
source  "goat-transformers spec/engine-spec.md (synthetic probe format, no external standard)"
uses       probe
wire       bits
layout     sequential
bit_order  msb
kind a
when     8  1
requires probe.x
field    probe.x  8  uint
field    probe.y  8  uint
kind b
when     8  2
requires probe.z
field    probe.z  16  uint
