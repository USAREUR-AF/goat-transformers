field     mavlinkuavionix.emittertype 0:200:8 uint
field     mavlinkuavionix.aircraftsize 0:208:8 uint
field     mavlinkuavionix.gpsoffsetlat 0:216:8 uint
field     mavlinkuavionix.gpsoffsetlon 0:224:8 uint
field     mavlinkuavionix.rfselect 0:232:8 uint

