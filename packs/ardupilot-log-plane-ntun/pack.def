# ArduPilot log message NTUN as the payload of a DataFlash log record.
# Generated by tools/gen/aplog2pack.py; do not edit by hand.
# The record without its 3-byte header (0xA3 0x95 type-id); fields packed, little-endian.
format        ardupilot-log-plane-ntun
version       0.1.0
distribution  public
source        "ArduPilot log message definitions (log structure tables and Write calls), https://github.com/ArduPilot/ardupilot at tag Copter-4.6.2, commit 1ebd4d996e8b6bbeb1462a9655c00aa861d5beef; message names, format strings, labels, units and multipliers only; GNU General Public License, version 3"
source        "ArduPilot libraries/AP_Logger/LogStructure.h: the format characters, units and multipliers of a log message, at the same commit"
uses          aplog
wire          bits
bit_order     lsb
word_bytes    1
field  aplog.plane_ntun_timeus  0:0:64  uint
field  aplog.plane_ntun_dist  0:64:32  f32
field  aplog.plane_ntun_tbrg  0:96:16  twos
field  aplog.plane_ntun_navbrg  0:112:16  twos
field  aplog.plane_ntun_alte  0:128:16  twos
field  aplog.plane_ntun_xt  0:144:32  f32
field  aplog.plane_ntun_xti  0:176:32  f32
field  aplog.plane_ntun_ase  0:208:32  f32
field  aplog.plane_ntun_tlat  0:240:32  twos
field  aplog.plane_ntun_tlng  0:272:32  twos
field  aplog.plane_ntun_taw  0:304:32  twos
field  aplog.plane_ntun_tat  0:336:32  twos
field  aplog.plane_ntun_tasp  0:368:32  twos
