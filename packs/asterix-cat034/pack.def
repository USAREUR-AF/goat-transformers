# ASTERIX Category 034, Transmission of Monoradar Service Messages, edition 1.29: one data block holding one record.
# Public. Generated by tools/gen/asterix2pack.py from the category definition of
# github.com/zoranbosnjak/asterix-specs (BSD-3-Clause); do not edit by hand. I/O is hex text.
# Needs engine version 0.8 (`layout sequential`). See pack.md.
#
#   octet 1       CAT = 34
#   octets 2-3    LEN, the length of the data block in octets, CAT and LEN included
#   FSPEC         octets of 7 presence bits and an extension bit; bit n is FRN n
#   then          the items whose FSPEC bit is 1, in FRN order
#
# An FRN with no `if` block is not mapped: a record with that FSPEC bit set fails
# with `malformed-wire` (ruling 1 of engine-spec 0.8), and encode never sets the bit.
format     asterix-cat034
version    0.1.0
distribution public
source  "ASTERIX Category 034, Transmission of Monoradar Service Messages, edition 1.29 (2021-03-15), as transcribed in github.com/zoranbosnjak/asterix-specs (BSD-3-Clause), commit 64e9ffba964b92a1af3157bc6bdf7852a63bf700, specs/cat034/cats/cat1.29/definition.json. The category is specified by EUROCONTROL"
uses       cat034
wire       bits
layout     sequential
bit_order  msb
kind    record
when    8  34                              # CAT
length  16 whole                         # LEN
presence f fx
if f.1                                   # FRN 1, I034/010 Data Source Identifier
  field  cat034.i010_sac  8  uint
  field  cat034.i010_sic  8  uint
end
if f.2                                   # FRN 2, I034/000 Message Type
  field  cat034.i000  8  uint
end
if f.3                                   # FRN 3, I034/030 Time of Day
  field  cat034.i030  24  uscale:1/128
end
if f.4                                   # FRN 4, I034/020 Sector Number
  field  cat034.i020  8  uscale:45/32
end
if f.5                                   # FRN 5, I034/041 Antenna Rotation Speed
  field  cat034.i041  16  uscale:1/128
end
if f.6                                   # FRN 6, I034/050 System Configuration and Status
  presence p050 fx
  if p050.1                       # subfield 1, COM: Common Part
    field  cat034.i050_com_nogo  1  uint
    field  cat034.i050_com_rdpc  1  uint
    field  cat034.i050_com_rdpr  1  uint
    field  cat034.i050_com_ovlrdp  1  uint
    field  cat034.i050_com_ovlxmt  1  uint
    field  cat034.i050_com_msc  1  uint
    field  cat034.i050_com_tsv  1  uint
    pad    1
  end
  if p050.4                       # subfield 4, PSR: Specific Status Information for a PSR Sensor
    field  cat034.i050_psr_ant  1  uint
    field  cat034.i050_psr_chab  2  uint
    field  cat034.i050_psr_ovl  1  uint
    field  cat034.i050_psr_msc  1  uint
    pad    3
  end
  if p050.5                       # subfield 5, SSR: Specific Status Information for a SSR Sensor
    field  cat034.i050_ssr_ant  1  uint
    field  cat034.i050_ssr_chab  2  uint
    field  cat034.i050_ssr_ovl  1  uint
    field  cat034.i050_ssr_msc  1  uint
    pad    3
  end
  if p050.6                       # subfield 6, MDS: Specific Status Information for a Mode S Sensor
    field  cat034.i050_mds_ant  1  uint
    field  cat034.i050_mds_chab  2  uint
    field  cat034.i050_mds_ovlsur  1  uint
    field  cat034.i050_mds_msc  1  uint
    field  cat034.i050_mds_scf  1  uint
    field  cat034.i050_mds_dlf  1  uint
    field  cat034.i050_mds_ovlscf  1  uint
    field  cat034.i050_mds_ovldlf  1  uint
    pad    7
  end
end
if f.7                                   # FRN 7, I034/060 System Processing Mode
  presence p060 fx
  if p060.1                       # subfield 1, COM: Common Part
    pad    1
    field  cat034.i060_com_redrdp  3  uint
    field  cat034.i060_com_redxmt  3  uint
    pad    1
  end
  if p060.4                       # subfield 4, PSR: Specific Processing Mode Information for a PSR Sensor
    field  cat034.i060_psr_pol  1  uint
    field  cat034.i060_psr_redrad  3  uint
    field  cat034.i060_psr_stc  2  uint
    pad    2
  end
  if p060.5                       # subfield 5, SSR: Specific Processing Mode Information for a SSR Sensor
    field  cat034.i060_ssr_redrad  3  uint
    pad    5
  end
  if p060.6                       # subfield 6, MDS: Specific Processing Mode Information for a Mode S Sensor
    field  cat034.i060_mds_redrad  3  uint
    field  cat034.i060_mds_clu  1  uint
    pad    4
  end
end
if f.8                                   # FRN 8, I034/070 Message Count Values
  group  cat034.i070  count 8
    field  cat034.i070_typ  5  uint
    field  cat034.i070_count  11  uint
  end
end
if f.9                                   # FRN 9, I034/100 Generic Polar Window
  field  cat034.i100_rhost  16  uscale:1/256
  field  cat034.i100_rhoend  16  uscale:1/256
  field  cat034.i100_thetast  16  uscale:45/8192
  field  cat034.i100_thetaend  16  uscale:45/8192
end
if f.10                                  # FRN 10, I034/110 Data Filter
  field  cat034.i110  8  uint
end
if f.11                                  # FRN 11, I034/120 3D-Position Of Data Source
  field  cat034.i120_hgt  16  sscale:1
  field  cat034.i120_lat  24  sscale:45/2097152
  field  cat034.i120_lon  24  sscale:45/2097152
end
if f.12                                  # FRN 12, I034/090 Collimation Error
  field  cat034.i090_rng  8  sscale:1/128
