# ArduPilot log message XKF5 as the payload of a DataFlash log record.
# Generated by tools/gen/aplog2pack.py; do not edit by hand.
# The record without its 3-byte header (0xA3 0x95 type-id); fields packed, little-endian.
format        ardupilot-log-xkf5
version       0.1.0
distribution  public
source        "ArduPilot log message definitions (log structure tables and Write calls), https://github.com/ArduPilot/ardupilot at tag Copter-4.6.2, commit 1ebd4d996e8b6bbeb1462a9655c00aa861d5beef; message names, format strings, labels, units and multipliers only; GNU General Public License, version 3"
source        "ArduPilot libraries/AP_Logger/LogStructure.h: the format characters, units and multipliers of a log message, at the same commit"
uses          aplog
wire          bits
bit_order     lsb
word_bytes    1
field  aplog.xkf5_timeus  0:0:64  uint
field  aplog.xkf5_c  0:64:8  uint
field  aplog.xkf5_ni  0:72:8  uint
field  aplog.xkf5_fix  0:80:16  twos
field  aplog.xkf5_fiy  0:96:16  twos
field  aplog.xkf5_afi  0:112:16  twos
field  aplog.xkf5_hagl  0:128:16  twos
field  aplog.xkf5_offset  0:144:16  twos
field  aplog.xkf5_ri  0:160:16  twos
field  aplog.xkf5_rng  0:176:16  uint
field  aplog.xkf5_herr  0:192:16  uint
field  aplog.xkf5_eang  0:208:32  f32
field  aplog.xkf5_evel  0:240:32  f32
field  aplog.xkf5_epos  0:272:32  f32
