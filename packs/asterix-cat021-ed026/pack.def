  field  lon  32  sscale:45/8388608
  also   cat021ed026.i130_lon
end
if f.5                                   # FRN 5, I021/080 Target Address
  field  cat021ed026.i080  24  uint
end
if f.6                                   # FRN 6, I021/140 Geometric Altitude
  field  hae  16  sscale:381/200
end
if f.7                                   # FRN 7, I021/090 Figure of Merit
  field  cat021ed026.i090_ac  2  uint
  field  cat021ed026.i090_mn  2  uint
  field  cat021ed026.i090_dc  2  uint
  pad    6
  field  cat021ed026.i090_pa  4  sscale:1
end
if f.8                                   # FRN 8, I021/210 Link Technology Indicator
  pad    3
  field  cat021ed026.i210_dti  1  uint
  field  cat021ed026.i210_mds  1  uint
  field  cat021ed026.i210_uat  1  uint
  field  cat021ed026.i210_vdl  1  uint
  field  cat021ed026.i210_otr  1  uint
end
if f.9                                   # FRN 9, I021/230 Roll Angle
  field  cat021ed026.i230  16  sscale:1/100
end
if f.10                                  # FRN 10, I021/145 Flight Level
  field  cat021ed026.i145  16  sscale:1/4
end
if f.11                                  # FRN 11, I021/150 Air Speed
  field  cat021ed026.i150_im  1  uint
  field  cat021ed026.i150_as  15  uint
end
if f.12                                  # FRN 12, I021/151 True Airspeed
  field  cat021ed026.i151  16  uscale:1
end
if f.13                                  # FRN 13, I021/152 Magnetic Heading
  field  cat021ed026.i152  16  uscale:45/8192
end
if f.14                                  # FRN 14, I021/155 Barometric Vertical Rate
  field  cat021ed026.i155  16  sscale:25/4
end
if f.15                                  # FRN 15, I021/157 Geometric Vertical Rate
  field  cat021ed026.i157  16  sscale:25/4
end
if f.16                                  # FRN 16, I021/160 Ground Vector
  field  cat021ed026.i160_gs  16  sscale:1/16384
  field  cat021ed026.i160_ta  16  uscale:45/8192
end
if f.17                                  # FRN 17, I021/165 Rate Of Turn
  chain
    field  cat021ed026.i165_ti  2  uint
    pad    5
    fx
    field  cat021ed026.i165_rot  7  sscale:1/4
    fx
  end
end
if f.18                                  # FRN 18, I021/170 Target Identification
  field  callsign  48  chars:icao6
end
if f.19                                  # FRN 19, I021/095 Velocity Accuracy
  field  cat021ed026.i095  8  uint
end
if f.20                                  # FRN 20, I021/032 Time of Day Accuracy
  field  cat021ed026.i032  8  uscale:1/256
end
if f.21                                  # FRN 21, I021/200 Target Status
  field  cat021ed026.i200  8  uint
end
if f.22                                  # FRN 22, I021/020 Emitter Category
  field  cat021ed026.i020  8  uint
end
if f.23                                  # FRN 23, I021/220 Met Information
  presence p220 fx
  if p220.1                       # subfield 1, WS: Wind Speed
    field  cat021ed026.i220_ws  16  uscale:1
  end
  if p220.2                       # subfield 2, WD: Wind Direction
    field  cat021ed026.i220_wd  16  uscale:1
  end
  if p220.3                       # subfield 3, TMP: Temperature
    field  cat021ed026.i220_tmp  16  sscale:1/4
  end
  if p220.4                       # subfield 4, TRB: Turbulence
    field  cat021ed026.i220_trb  8  uint
  end
end
if f.24                                  # FRN 24, I021/146 Intermediate State Selected Altitude
  field  cat021ed026.i146_sas  1  uint
  field  cat021ed026.i146_src  2  uint
