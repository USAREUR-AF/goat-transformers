end
if f.25                                  # FRN 25, I021/148 Final State Selected Altitude
  field  cat021ed026.i148_mv  1  uint
  field  cat021ed026.i148_ah  1  uint
  field  cat021ed026.i148_am  1  uint
  field  cat021ed026.i148_alt  13  sscale:25
end
if f.26                                  # FRN 26, I021/110 Trajectory Intent
  presence p110 fx
  if p110.1                       # subfield 1, TIS: Trajectory Intent Status
    chain
      field  cat021ed026.i110_tis_nav  1  uint
      field  cat021ed026.i110_tis_nvb  1  uint
      pad    5
      fx
    end
  end
  if p110.2                       # subfield 2, TID: Trajectory Intent Data
    group  cat021ed026.i110_tid  count 8
      field  cat021ed026.i110_tid_tca  1  uint
      field  cat021ed026.i110_tid_nc  1  uint
      field  cat021ed026.i110_tid_tcpn  6  uint
      field  cat021ed026.i110_tid_alt  16  sscale:10
      field  cat021ed026.i110_tid_lat  24  sscale:45/2097152
      field  cat021ed026.i110_tid_lon  24  sscale:45/2097152
      field  cat021ed026.i110_tid_pt  4  uint
      field  cat021ed026.i110_tid_td  2  uint
      field  cat021ed026.i110_tid_tra  1  uint
      field  cat021ed026.i110_tid_toa  1  uint
      field  cat021ed026.i110_tid_tov  24  uscale:1
      field  cat021ed026.i110_tid_ttr  16  uscale:1/100
    end
  end
end
if f.27                                  # FRN 27, I021/070 Mode 3/A Code in Octal Representation
  field  cat021ed026.i070_v  1  uint
  field  cat021ed026.i070_g  1  uint
  field  cat021ed026.i070_l  1  uint
  pad    1
  field  cat021ed026.i070_mode3a  12  uint
end
if f.28                                  # FRN 28, I021/131 Signal Amplitude
  field  cat021ed026.i131  8  uint
end
# FRN 29: spare FRN
# FRN 30: spare FRN
# FRN 31: spare FRN
# FRN 32: spare FRN
# FRN 33: spare FRN
if f.34                                  # FRN 34, I021/RE Reserved Expansion Field
  length 8 bytes plus 1                # the length octet counts itself; the content is not mapped
  end
end
if f.35                                  # FRN 35, I021/SP Special Purpose Field
  length 8 bytes plus 1                # the length octet counts itself; the content is not mapped
  end
end
