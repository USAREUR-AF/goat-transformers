  field  cat021ed026.i040_tst  1  uint
  field  cat021ed026.i040_rab  1  uint
  field  cat021ed026.i040_saa  1  uint
  field  cat021ed026.i040_spi  1  uint
  pad    1
  field  cat021ed026.i040_atp  3  uint
  field  cat021ed026.i040_arc  2  uint
  pad    3
end
if f.3                                   # FRN 3, I021/030 Time of Day
  field  cat021ed026.i030  24  uscale:1/128
end
if f.4                                   # FRN 4, I021/130 Position in WGS-84 Co-ordinates
  field  lat  32  sscale:45/8388608
