# LTM (Lightweight Telemetry), as INAV sends it: G (GPS), A (attitude), S (status) and
# O (origin) frames, one kind per frame. Written by hand from INAV's LTM telemetry code;
# pack.md has the layout, the evidence for every shared key and what is not mapped.
# The message is one frame without its checksum byte: '$', 'T', the frame letter and the
# payload. Little-endian. The frame letter is each kind's when.
format        ltm
version       0.1.0
distribution  public
source        "INAV LTM telemetry, https://github.com/iNavFlight/inav commit 21adf64440bb0d9f0bdc56569098fbaa0e39d24d, src/main/telemetry/ltm.c (sha256 d5bc43754709f522e7a03ab52762c3123b9c7661e80c0171eb817fe593a315e1); GPL-3.0-or-later, the INAV project"
uses          ltm
wire          bits
bit_order     lsb
word_bytes    1
when      0:0:8 36
when      0:8:8 84

kind      g
when      0:16:8 71
requires  lat lon
field     lat 0:24:32 sscale:1/10000000
field     lon 0:56:32 sscale:1/10000000
field     speed_ms 0:88:8 uscale:1
field     ltm.g_altitude 0:96:32 twos
field     ltm.g_fix_type 0:128:2 uint
field     ltm.g_satellites 0:130:6 uint

kind      a
when      0:16:8 65
requires  ltm.a_heading
field     ltm.a_pitch 0:24:16 twos
field     ltm.a_roll 0:40:16 twos
field     ltm.a_heading 0:56:16 twos

kind      s
when      0:16:8 83
requires  ltm.s_vbat
field     ltm.s_vbat 0:24:16 uint
field     ltm.s_mah_drawn 0:40:16 uint
field     ltm.s_rssi 0:56:8 uint
field     ltm.s_airspeed 0:64:8 uint
field     ltm.s_armed 0:72:1 uint
field     ltm.s_failsafe 0:73:1 uint
field     ltm.s_flight_mode 0:74:6 uint

kind      o
when      0:16:8 79
requires  ltm.o_home_lat
field     ltm.o_home_lat 0:24:32 twos
field     ltm.o_home_lon 0:56:32 twos
field     ltm.o_home_alt 0:88:32 twos
field     ltm.o_osd_on 0:120:8 uint
field     ltm.o_home_fix 0:128:8 uint
