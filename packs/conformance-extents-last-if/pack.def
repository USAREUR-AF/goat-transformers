# Conformance probe pack for a `last` group in an `if` block that another
# line writes (spec 0.21 ruling 28), most significant bit first. Public. No
# kinds.
#
#   p           one presence bit
#   if p.1      x in 7 bits, then nums: a last-item bit before each item, val
#               in 7 bits
format     conformance-extents-last-if
version    0.21.0
distribution public
source  "goat-transformers spec/engine-spec.md (synthetic probe format, no external standard)"
uses       probe
wire       bits
layout     sequential
bit_order  msb
presence p 1
if p.1
  field  probe.x  7  uint
  group  probe.nums last
    field  probe.val  7  uint
  end
end
