# GTFS Schedule attributions.txt: one data row of the file. Public. Maintained by hand.
# The columns are in the order the reference lists them (pack.md, Column order);
# the header row is not a message of this pack.
format        gtfs-attributions
version       0.1.0
distribution  public
source        "GTFS Schedule Reference, gtfs/spec/en/reference.md of https://github.com/google/transit (Apache-2.0) at commit 2ce6aa79e3fa7bdbaf19d2a12765cee5b9fdd699; the column order of each file as the reference lists it; field names and types"
uses          gtfs
wire          text

field  gtfs.attribution_id              0   string
field  gtfs.agency_id                   1   string
field  gtfs.route_id                    2   string
field  gtfs.trip_id                     3   string
field  gtfs.organization_name           4   string
field  gtfs.is_producer                 5   int
field  gtfs.is_operator                 6   int
field  gtfs.is_authority                7   int
field  gtfs.attribution_url             8   string
field  gtfs.attribution_email           9   string
field  gtfs.attribution_phone           10  string
