field     mavlinkpaparazzi.target_system 0:96:8 uint
field     mavlinkpaparazzi.target_component 0:104:8 uint
field     mavlinkpaparazzi.name 0:112:400 ascii

kind      script_request
when      0:56:24 181
when      0:8:8 4
requires  mavlinkpaparazzi.script_request_seq mavlinkpaparazzi.target_system mavlinkpaparazzi.target_component
