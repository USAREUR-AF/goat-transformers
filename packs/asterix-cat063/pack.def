# ASTERIX Category 063, Sensor Status Reports, edition 1.7: one data block holding one record.
# Public. Generated by tools/gen/asterix2pack.py from the category definition of
# github.com/zoranbosnjak/asterix-specs (BSD-3-Clause); do not edit by hand. I/O is hex text.
# Needs engine version 0.8 (`layout sequential`). See pack.md.
#
#   octet 1       CAT = 63
#   octets 2-3    LEN, the length of the data block in octets, CAT and LEN included
#   FSPEC         octets of 7 presence bits and an extension bit; bit n is FRN n
#   then          the items whose FSPEC bit is 1, in FRN order
#
# An FRN with no `if` block is not mapped: a record with that FSPEC bit set fails
# with `malformed-wire` (ruling 1 of engine-spec 0.8), and encode never sets the bit.
format     asterix-cat063
version    0.1.0
distribution public
source  "ASTERIX Category 063, Sensor Status Reports, edition 1.7 (2025-06-05), as transcribed in github.com/zoranbosnjak/asterix-specs (BSD-3-Clause), commit 64e9ffba964b92a1af3157bc6bdf7852a63bf700, specs/cat063/cats/cat1.7/definition.json. The category is specified by EUROCONTROL"
uses       cat063
wire       bits
layout     sequential
bit_order  msb
kind    record
when    8  63                              # CAT
length  16 whole                         # LEN
presence f fx
if f.1                                   # FRN 1, I063/010 Data Source Identifier
  field  cat063.i010_sac  8  uint
  field  cat063.i010_sic  8  uint
end
if f.2                                   # FRN 2, I063/015 Service Identification
  field  cat063.i015  8  uint
end
if f.3                                   # FRN 3, I063/030 Time of Message
  field  cat063.i030  24  uscale:1/128
end
if f.4                                   # FRN 4, I063/050 Sensor Identifier
  field  cat063.i050_sac  8  uint
  field  cat063.i050_sic  8  uint
end
if f.5                                   # FRN 5, I063/060 Sensor Configuration and Status
  chain
    field  cat063.i060_con  2  uint
    field  cat063.i060_psr  1  uint
    field  cat063.i060_ssr  1  uint
    field  cat063.i060_mds  1  uint
    field  cat063.i060_ads  1  uint
    field  cat063.i060_mlt  1  uint
    fx
    field  cat063.i060_ops  1  uint
    field  cat063.i060_odp  1  uint
    field  cat063.i060_oxt  1  uint
    field  cat063.i060_msc  1  uint
    field  cat063.i060_tsv  1  uint
    field  cat063.i060_npw  1  uint
    pad    1
    fx
    field  cat063.i060_ttf_ep  1  uint
    field  cat063.i060_ttf_val  1  uint
    field  cat063.i060_spo_ep  1  uint
    field  cat063.i060_spo_val  1  uint
    pad    3
    fx
  end
end
if f.6                                   # FRN 6, I063/070 Time Stamping Bias
  field  cat063.i070  16  sscale:1
end
if f.7                                   # FRN 7, I063/080 SSR / Mode S Range Gain and Bias
  field  cat063.i080_srg  16  sscale:1/100000
  field  cat063.i080_srb  16  sscale:1/128
end
if f.8                                   # FRN 8, I063/081 SSR Mode S Azimuth Bias
  field  cat063.i081  16  sscale:45/8192
end
if f.9                                   # FRN 9, I063/090 PSR Range Gain and Bias
  field  cat063.i090_prg  16  sscale:1/100000
  field  cat063.i090_prb  16  sscale:1/128
end
if f.10                                  # FRN 10, I063/091 PSR Azimuth Bias
  field  cat063.i091  16  sscale:45/8192
end
if f.11                                  # FRN 11, I063/092 PSR Elevation Bias
  field  cat063.i092  16  sscale:45/8192
end
# FRN 12: spare FRN
if f.13                                  # FRN 13, I063/RE Reserved Expansion Field
  length 8 bytes plus 1                # the length octet counts itself; the content is not mapped
  end
end
if f.14                                  # FRN 14, I063/SP Special Purpose Field
  length 8 bytes plus 1                # the length octet counts itself; the content is not mapped
  end
end
