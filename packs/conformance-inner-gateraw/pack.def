# Conformance probe pack used as an inner pack (spec 0.34):
# two gates on one byte that a field outside any block maps. Public.
format     conformance-inner-gateraw
version    0.34.0
distribution public
source  "goat-transformers spec/engine-spec.md (synthetic probe format, no external standard)"
uses       probe
wire       bits
word_bytes 1
bit_order  msb
field   probe.x  0:0:8   uint
field   probe.w  0:8:8   uint
if      0:8:8  1
  field probe.y  0:16:8  uint
end
if      0:8:8  2
  field probe.z  0:16:16 uint
end
