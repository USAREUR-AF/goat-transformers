# Conformance probe pack used as an inner pack whose first field can fail
# (spec 0.34 ruling 19). Public. No kinds.
format     conformance-inner-failjoin
version    0.34.0
distribution public
source  "goat-transformers spec/engine-spec.md (synthetic probe format, no external standard)"
uses       probe
wire       bits
layout     sequential
bit_order  msb
field   probe.s1  8  ascii
field   probe.n   8  uint
