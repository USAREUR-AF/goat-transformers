# ASTERIX Category 020, Multilateration Target Reports, edition 1.11: one data block holding one record.
# Public. Generated by tools/gen/asterix2pack.py from the category definition of
# github.com/zoranbosnjak/asterix-specs (BSD-3-Clause); do not edit by hand. I/O is hex text.
# Needs engine version 0.8 (`layout sequential`). See pack.md.
#
#   octet 1       CAT = 20
#   octets 2-3    LEN, the length of the data block in octets, CAT and LEN included
#   FSPEC         octets of 7 presence bits and an extension bit; bit n is FRN n
#   then          the items whose FSPEC bit is 1, in FRN order
#
# An FRN with no `if` block is not mapped: a record with that FSPEC bit set fails
# with `malformed-wire` (ruling 1 of engine-spec 0.8), and encode never sets the bit.
format     asterix-cat020
version    0.1.0
distribution public
source  "ASTERIX Category 020, Multilateration Target Reports, edition 1.11 (2025-07-02), as transcribed in github.com/zoranbosnjak/asterix-specs (BSD-3-Clause), commit 64e9ffba964b92a1af3157bc6bdf7852a63bf700, specs/cat020/cats/cat1.11/definition.json. The category is specified by EUROCONTROL"
uses       cat020
wire       bits
layout     sequential
bit_order  msb
kind    record
when    8  20                              # CAT
length  16 whole                         # LEN
presence f fx
if f.1                                   # FRN 1, I020/010 Data Source Identifier
  field  cat020.i010_sac  8  uint
  field  cat020.i010_sic  8  uint
end
if f.2                                   # FRN 2, I020/020 Target Report Descriptor
  chain
    field  cat020.i020_ssr  1  uint
    field  cat020.i020_ms  1  uint
    field  cat020.i020_hf  1  uint
    field  cat020.i020_vdl4  1  uint
    field  cat020.i020_uat  1  uint
    field  cat020.i020_dme  1  uint
    field  cat020.i020_ot  1  uint
    fx
    field  cat020.i020_rab  1  uint
    field  cat020.i020_spi  1  uint
    field  cat020.i020_chn  1  uint
    field  cat020.i020_gbs  1  uint
    field  cat020.i020_crt  1  uint
    field  cat020.i020_sim  1  uint
    field  cat020.i020_tst  1  uint
    fx
    field  cat020.i020_cf  2  uint
    pad    5
    fx
  end
end
if f.3                                   # FRN 3, I020/140 Time of Day
  field  cat020.i140  24  uscale:1/128
end
if f.4                                   # FRN 4, I020/041 Position In WGS-84 Coordinates
  field  lat  32  sscale:45/8388608
  also   cat020.i041_lat
  field  lon  32  sscale:45/8388608
  also   cat020.i041_lon
end
if f.5                                   # FRN 5, I020/042 Position in Cartesian Coordinates
  field  cat020.i042_x  24  sscale:1/2
  field  cat020.i042_y  24  sscale:1/2
end
if f.6                                   # FRN 6, I020/161 Track Number
  pad    4
  field  cat020.i161_trn  12  uint
end
if f.7                                   # FRN 7, I020/170 Track Status
  chain
    field  cat020.i170_cnf  1  uint
    field  cat020.i170_tre  1  uint
    field  cat020.i170_cst  1  uint
    field  cat020.i170_cdm  2  uint
    field  cat020.i170_mah  1  uint
    field  cat020.i170_sth  1  uint
    fx
    field  cat020.i170_gho  1  uint
    pad    6
    fx
  end
end
if f.8                                   # FRN 8, I020/070 Mode-3/A Code in Octal Representation
  field  cat020.i070_v  1  uint
  field  cat020.i070_g  1  uint
  field  cat020.i070_l  1  uint
  pad    1
  field  cat020.i070_mode3a  12  uint
end
if f.9                                   # FRN 9, I020/202 Calculated Track Velocity in Cartesian Coordinates
  field  cat020.i202_vx  16  sscale:1/4
  field  cat020.i202_vy  16  sscale:1/4
end
if f.10                                  # FRN 10, I020/090 Flight Level in Binary Representation
  field  cat020.i090_v  1  uint
  field  cat020.i090_g  1  uint
  field  cat020.i090_fl  14  sscale:1/4
end
if f.11                                  # FRN 11, I020/100 Mode C Code
  field  cat020.i100_v  1  uint
  field  cat020.i100_g  1  uint
  pad    2
  field  cat020.i100_modec  12  uint
  pad    4
  field  cat020.i100_qc1  1  uint
  field  cat020.i100_qa1  1  uint
  field  cat020.i100_qc2  1  uint
  field  cat020.i100_qa2  1  uint
  field  cat020.i100_qc4  1  uint
  field  cat020.i100_qa4  1  uint
  field  cat020.i100_qb1  1  uint
  field  cat020.i100_qd1  1  uint
  field  cat020.i100_qb2  1  uint
  field  cat020.i100_qd2  1  uint
  field  cat020.i100_qb4  1  uint
  field  cat020.i100_qd4  1  uint
end
if f.12                                  # FRN 12, I020/220 Target Address
  field  cat020.i220  24  uint
end
if f.13                                  # FRN 13, I020/245 Target Identification
  field  cat020.i245_sti  2  uint
  pad    6
  field  cat020.i245_chr  48  uint
end
if f.14                                  # FRN 14, I020/110 Measured Height (Local Cartesian Coordinates)
  field  cat020.i110  16  sscale:25/4
end
if f.15                                  # FRN 15, I020/105 Geometric Height (WGS-84)
  field  hae  16  sscale:381/200
end
if f.16                                  # FRN 16, I020/210 Calculated Acceleration
  field  cat020.i210_ax  8  sscale:1/4
  field  cat020.i210_ay  8  sscale:1/4
end
if f.17                                  # FRN 17, I020/300 Vehicle Fleet Identification
  field  cat020.i300  8  uint
end
if f.18                                  # FRN 18, I020/310 Pre-programmed Message
  field  cat020.i310_trb  1  uint
  field  cat020.i310_msg  7  uint
end
if f.19                                  # FRN 19, I020/500 Position Accuracy
  presence p500 fx
  if p500.1                       # subfield 1, DOP: DOP of Position
    field  cat020.i500_dop_x  16  uscale:1/4
    field  cat020.i500_dop_y  16  uscale:1/4
    field  cat020.i500_dop_xy  16  uscale:1/4
  end
  if p500.2                       # subfield 2, SDP: Standard Deviation of Position
    field  cat020.i500_sdp_x  16  uscale:1/4
    field  cat020.i500_sdp_y  16  uscale:1/4
    field  cat020.i500_sdp_xy  16  uscale:1/4
  end
  if p500.3                       # subfield 3, SDH: Standard Deviation of Geometric Height (WGS 84)
    field  cat020.i500_sdh  16  uscale:1/2
  end
end
if f.20                                  # FRN 20, I020/400 Contributing Devices
  group  cat020.i400  count 8
    field  cat020.i400_bit1  1  uint
    field  cat020.i400_bit2  1  uint
    field  cat020.i400_bit3  1  uint
    field  cat020.i400_bit4  1  uint
    field  cat020.i400_bit5  1  uint
    field  cat020.i400_bit6  1  uint
    field  cat020.i400_bit7  1  uint
    field  cat020.i400_bit8  1  uint
  end
end
if f.21                                  # FRN 21, I020/250 BDS Register Data
  group  cat020.i250  count 8
    field  cat020.i250_bdsdata  56  uint
    field  cat020.i250_bds1  4  uint
    field  cat020.i250_bds2  4  uint
  end
end
if f.22                                  # FRN 22, I020/230 Communications/ACAS Capability and Flight Status
  field  cat020.i230_com  3  uint
  field  cat020.i230_stat  3  uint
  field  cat020.i230_casevn  2  uint
  field  cat020.i230_mssc  1  uint
  field  cat020.i230_arc  1  uint
  field  cat020.i230_aic  1  uint
  field  cat020.i230_b1a  1  uint
  field  cat020.i230_b1b  4  uint
end
if f.23                                  # FRN 23, I020/260 ACAS Resolution Advisory Report
  field  cat020.i260  56  uint
end
if f.24                                  # FRN 24, I020/030 Warning/Error Conditions
  group  cat020.i030  fx
    field  cat020.i030_val  7  uint
  end
end
if f.25                                  # FRN 25, I020/055 Mode-1 Code in Octal Representation
  field  cat020.i055_v  1  uint
  field  cat020.i055_g  1  uint
  field  cat020.i055_l  1  uint
  field  cat020.i055_mode1  5  uint
end
if f.26                                  # FRN 26, I020/050 Mode-2 Code in Octal Representation
  field  cat020.i050_v  1  uint
  field  cat020.i050_g  1  uint
  field  cat020.i050_l  1  uint
  pad    1
  field  cat020.i050_mode2  12  uint
end
if f.27                                  # FRN 27, I020/RE Reserved Expansion Field
  length 8 bytes plus 1                # the length octet counts itself; the content is not mapped
  end
end
if f.28                                  # FRN 28, I020/SP Special Purpose Field
  length 8 bytes plus 1                # the length octet counts itself; the content is not mapped
  end
end
