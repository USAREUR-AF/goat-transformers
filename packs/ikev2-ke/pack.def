# IKEv2 Key Exchange payload (type 34, section 3.4). The message is one payload, its generic header included, as
# ikev2-message holds it. Public. Written by tools/gen/tunnels-pack.py; do not edit by hand.
format        ikev2-ke
version       0.1.0
distribution  public
source        "IETF RFC 7296, Internet Key Exchange Protocol Version 2 (IKEv2), October 2014, section 3, https://www.rfc-editor.org/rfc/rfc7296.txt (sha256 b6c1bf3921e85dd3674f427ffcaded0209e1f9718e8d601e2f918371f46329a1); layout restated"
uses          ikev2
wire          bits
layout        sequential
bit_order     msb

field  ikev2.next_payload  8  uint
field  ikev2.critical  1  uint
field  ikev2.payload_reserved  7  uint
length  16  bytes  plus  4
  field  ikev2.dh_group  16  uint
  field  ikev2.ke_reserved  16  uint
  group  ikev2.ke_data  rest
    field  ikev2.octet  8  uint
  end
end
