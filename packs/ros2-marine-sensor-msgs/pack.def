# ROS 2 marine_sensor_msgs messages in the JSON form of a rosbridge `publish` operation.
# Generated by tools/gen/ros2msg2pack.py; do not edit by hand.
# One kind per .msg file, selected by the member `type` ("<package>/msg/<Name>").
# The ROS message is the object under `msg`; arrays are groups.
format        ros2-marine-sensor-msgs
version       0.1.0
distribution  public
source        "ROS 2 interface package marine_sensor_msgs, https://github.com/apl-ocean-engineering/marine_msgs ros2 (BSD 3-Clause License) at commit 14bddb417a51767600e3feada3bc7fc378d0e6f9, directory marine_sensor_msgs/msg; field names, types and array forms only"
source        "ROS 2 interface package builtin_interfaces (messages marine_sensor_msgs refers to), https://github.com/ros2/rcl_interfaces 2.0.4 at commit 7aa3caf43377ea6ad615bc1040832e2c7566bfbe, Apache License 2.0"
source        "ROS 2 interface package std_msgs (messages marine_sensor_msgs refers to), https://github.com/ros2/common_interfaces 5.3.8 at commit a941f14bb318d8d904505ed935ccbb97f24a70a4, Apache License 2.0"
source        "rosbridge v2.1.0 Protocol Specification, ROSBRIDGE_PROTOCOL.md, https://github.com/RobotWebTools/rosbridge_suite jazzy at commit cb33a16b890e4b8d9def531326409f3ee6c12537, BSD 3-Clause License; JSON form of a message and of the publish operation"
uses          ros2marinesensor
wire          json
when   op  publish
field  ros2marinesensor.topic  topic  string

kind      radar_echo
when      type  marine_sensor_msgs/msg/RadarEcho
requires  ros2marinesensor.radar_echo_echoes
group  ros2marinesensor.radar_echo_echoes  msg.echoes
  field  ros2marinesensor.radar_echo_echoes_value  .  float
end

kind      radar_sector
when      type  marine_sensor_msgs/msg/RadarSector
requires  ros2marinesensor.radar_sector_header_stamp_sec
field  ros2marinesensor.radar_sector_header_stamp_sec  msg.header.stamp.sec  int
field  ros2marinesensor.radar_sector_header_stamp_nanosec  msg.header.stamp.nanosec  int
field  ros2marinesensor.radar_sector_header_frame_id  msg.header.frame_id  string
field  ros2marinesensor.radar_sector_angle_start  msg.angle_start  float
field  ros2marinesensor.radar_sector_angle_increment  msg.angle_increment  float
field  ros2marinesensor.radar_sector_time_increment_sec  msg.time_increment.sec  int
field  ros2marinesensor.radar_sector_time_increment_nanosec  msg.time_increment.nanosec  int
field  ros2marinesensor.radar_sector_scan_time_sec  msg.scan_time.sec  int
field  ros2marinesensor.radar_sector_scan_time_nanosec  msg.scan_time.nanosec  int
field  ros2marinesensor.radar_sector_range_min  msg.range_min  float
field  ros2marinesensor.radar_sector_range_max  msg.range_max  float
group  ros2marinesensor.radar_sector_intensities  msg.intensities
  group  ros2marinesensor.radar_sector_intensities_echoes  echoes
    field  ros2marinesensor.radar_sector_intensities_echoes_value  .  float
  end
end

kind      turbidity_ntu
when      type  marine_sensor_msgs/msg/TurbidityNTU
requires  ros2marinesensor.turbidity_ntu_header_stamp_sec
field  ros2marinesensor.turbidity_ntu_header_stamp_sec  msg.header.stamp.sec  int
field  ros2marinesensor.turbidity_ntu_header_stamp_nanosec  msg.header.stamp.nanosec  int
field  ros2marinesensor.turbidity_ntu_header_frame_id  msg.header.frame_id  string
field  ros2marinesensor.turbidity_ntu_ntu  msg.ntu  float
