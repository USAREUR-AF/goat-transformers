# Conformance probe pack (spec 0.34, `inner … partial`: bytes after the inner
# message are ignored). Public. No kinds.
#
#   n, then one conformance-inner-fixedone message
format     conformance-inner-fixedonepartial
version    0.34.0
distribution public
source  "goat-transformers spec/engine-spec.md (synthetic probe format, no external standard)"
uses       probe
wire       bits
layout     sequential
bit_order  msb
group   probe.nums  count 8
  field  probe.val  8  uint
end
inner   conformance-inner-fixedone  partial
