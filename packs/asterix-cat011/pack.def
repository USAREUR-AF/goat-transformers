# ASTERIX Category 011, Transmission of A-SMGCS Data, edition 1.3: one data block holding one record.
# Public. Generated by tools/gen/asterix2pack.py from the category definition of
# github.com/zoranbosnjak/asterix-specs (BSD-3-Clause); do not edit by hand. I/O is hex text.
# Needs engine version 0.8 (`layout sequential`). See pack.md.
#
#   octet 1       CAT = 11
#   octets 2-3    LEN, the length of the data block in octets, CAT and LEN included
#   FSPEC         octets of 7 presence bits and an extension bit; bit n is FRN n
#   then          the items whose FSPEC bit is 1, in FRN order
#
# An FRN with no `if` block is not mapped: a record with that FSPEC bit set fails
# with `malformed-wire` (ruling 1 of engine-spec 0.8), and encode never sets the bit.
format     asterix-cat011
version    0.1.0
distribution public
source  "ASTERIX Category 011, Transmission of A-SMGCS Data, edition 1.3 (2020-05-11), as transcribed in github.com/zoranbosnjak/asterix-specs (BSD-3-Clause), commit 64e9ffba964b92a1af3157bc6bdf7852a63bf700, specs/cat011/cats/cat1.3/definition.json. The category is specified by EUROCONTROL"
uses       cat011
wire       bits
layout     sequential
bit_order  msb
kind    record
when    8  11                              # CAT
length  16 whole                         # LEN
presence f fx
if f.1                                   # FRN 1, I011/010 Data Source Identifier
  field  cat011.i010_sac  8  uint
  field  cat011.i010_sic  8  uint
end
if f.2                                   # FRN 2, I011/000 Message Type
  field  cat011.i000  8  uint
end
if f.3                                   # FRN 3, I011/015 Service Identification
  field  cat011.i015  8  uint
end
if f.4                                   # FRN 4, I011/140 Time of Track Information
  field  cat011.i140  24  uscale:1/128
end
if f.5                                   # FRN 5, I011/041 Position in WGS-84 Coordinates
  field  lat  32  sscale:45/536870912
  also   cat011.i041_lat
  field  lon  32  sscale:45/536870912
  also   cat011.i041_lon
end
if f.6                                   # FRN 6, I011/042 Calculated Position in Cartesian Co-ordinates
  field  cat011.i042_x  16  sscale:1
  field  cat011.i042_y  16  sscale:1
end
if f.7                                   # FRN 7, I011/202 Calculated Track Velocity in Cartesian Coordinates
  field  cat011.i202_vx  16  sscale:1/4
  field  cat011.i202_vy  16  sscale:1/4
end
if f.8                                   # FRN 8, I011/210 Calculated Acceleration
  field  cat011.i210_ax  8  sscale:1/4
  field  cat011.i210_ay  8  sscale:1/4
end
if f.9                                   # FRN 9, I011/060 Mode-3/A Code in Octal Representation
  pad    4
  field  cat011.i060_mod3a  12  uint
end
if f.10                                  # FRN 10, I011/245 Target Identification
  field  cat011.i245_sti  2  uint
  pad    6
  field  callsign  48  chars:icao6
end
if f.11                                  # FRN 11, I011/380 Mode-S / ADS-B Related Data
  presence p380 fx
  if p380.1                       # subfield 1, MB: BDS
    group  cat011.i380_mb  count 8
      field  cat011.i380_mb_val  64  uint
    end
  end
  if p380.2                       # subfield 2, ADR: 24 Bits Aircraft Address
    field  cat011.i380_adr  24  uint
  end
  if p380.4                       # subfield 4, COMACAS: Communications/ACAS Capability and Flight Status
    field  cat011.i380_comacas_com  3  uint
    field  cat011.i380_comacas_stat  4  uint
    pad    1
    field  cat011.i380_comacas_ssc  1  uint
    field  cat011.i380_comacas_arc  1  uint
    field  cat011.i380_comacas_aic  1  uint
    field  cat011.i380_comacas_b1a  1  uint
    field  cat011.i380_comacas_b1b  4  uint
    field  cat011.i380_comacas_ac  1  uint
    field  cat011.i380_comacas_mn  1  uint
    field  cat011.i380_comacas_dc  1  uint
    pad    5
  end
  if p380.8                       # subfield 8, ACT: Aircraft Derived Aircraft Type
    field  cat011.i380_act  32  ascii
  end
  if p380.9                       # subfield 9, ECAT: Emitter Category
    field  cat011.i380_ecat  8  uint
  end
  if p380.11                      # subfield 11, AVTECH: Available Technologies
    field  cat011.i380_avtech_vdl  1  uint
    field  cat011.i380_avtech_mds  1  uint
    field  cat011.i380_avtech_uat  1  uint
    pad    5
  end
end
if f.12                                  # FRN 12, I011/161 Track Number
  pad    1
  field  cat011.i161_ftn  15  uint
end
if f.13                                  # FRN 13, I011/170 Track Status
  chain
    field  cat011.i170_mon  1  uint
    field  cat011.i170_gbs  1  uint
    field  cat011.i170_mrh  1  uint
    field  cat011.i170_src  3  uint
    field  cat011.i170_cnf  1  uint
    fx
    field  cat011.i170_sim  1  uint
    field  cat011.i170_tse  1  uint
    field  cat011.i170_tsb  1  uint
    field  cat011.i170_frifoe  2  uint
    field  cat011.i170_me  1  uint
    field  cat011.i170_mi  1  uint
    fx
    field  cat011.i170_ama  1  uint
    field  cat011.i170_spi  1  uint
    field  cat011.i170_cst  1  uint
    field  cat011.i170_fpc  1  uint
    field  cat011.i170_aff  1  uint
    pad    2
    fx
    pad    1
    field  cat011.i170_psr  1  uint
    field  cat011.i170_ssr  1  uint
    field  cat011.i170_mds  1  uint
    field  cat011.i170_ads  1  uint
    field  cat011.i170_suc  1  uint
    field  cat011.i170_aac  1  uint
    fx
  end
end
if f.14                                  # FRN 14, I011/290 System Track Update Ages
  presence p290 fx
  if p290.1                       # subfield 1, PSR: Age of the Last Primary Report Used to Update the Track
    field  cat011.i290_psr  8  uscale:1/4
  end
  if p290.2                       # subfield 2, SSR: Age of the Last Secondary Report Used to Update the Track
    field  cat011.i290_ssr  8  uscale:1/4
  end
  if p290.3                       # subfield 3, MDA: Age of the Last Valid Mode A Report Used to Update the Track
    field  cat011.i290_mda  8  uscale:1/4
  end
  if p290.4                       # subfield 4, MFL: Age of the Last Valid and Credible Mode C Used to Update the Track
    field  cat011.i290_mfl  8  uscale:1/4
  end
  if p290.5                       # subfield 5, MDS: Age of the Last Mode S Report Used to Update the Track
    field  cat011.i290_mds  8  uscale:1/4
  end
  if p290.6                       # subfield 6, ADS: Age of the Last ADS Report Used to Update the Track
    field  cat011.i290_ads  16  uscale:1/4
  end
  if p290.7                       # subfield 7, ADB: Age of the Last ADS-B Report Used to Update the Track
    field  cat011.i290_adb  8  uscale:1/4
  end
  if p290.8                       # subfield 8, MD1: Age of the Last Valid Mode 1 Used to Update the Track
    field  cat011.i290_md1  8  uscale:1/4
  end
  if p290.9                       # subfield 9, MD2: Age of the Last Valid Mode 2 Used to Update the Track
    field  cat011.i290_md2  8  uscale:1/4
  end
  if p290.10                      # subfield 10, LOP: Age of the Last Magentic Loop Detection
    field  cat011.i290_lop  8  uscale:1/4
  end
  if p290.11                      # subfield 11, TRK: Actual Track Age Since First Occurrence
    field  cat011.i290_trk  8  uscale:1/4
  end
  if p290.12                      # subfield 12, MUL: Age of the Last Multilateration Detection
    field  cat011.i290_mul  8  uscale:1/4
  end
end
if f.15                                  # FRN 15, I011/430 Phase of Flight
  field  cat011.i430  8  uint
end
if f.16                                  # FRN 16, I011/090 Measured Flight Level
  field  cat011.i090  16  sscale:1/4
end
if f.17                                  # FRN 17, I011/093 Calculated Track Barometric Altitude
  field  cat011.i093_qnh  1  uint
  field  cat011.i093_ctba  15  sscale:1/4
end
if f.18                                  # FRN 18, I011/092 Calculated Track Geometric Altitude
  field  cat011.i092  16  sscale:25/4
end
if f.19                                  # FRN 19, I011/215 Calculated Rate Of Climb/Descent
  field  cat011.i215  16  sscale:25/4
end
if f.20                                  # FRN 20, I011/270 Target Size and Orientation
  chain
    field  cat011.i270_length  7  uscale:1
    fx
    field  cat011.i270_orientation  7  uscale:45/16
    fx
    field  cat011.i270_width  7  uscale:1
    fx
  end
end
if f.21                                  # FRN 21, I011/390 Flight Plan Related Data
  presence p390 fx
  if p390.1                       # subfield 1, FPPSID: FPPS Identification Tag
    field  cat011.i390_fppsid_sac  8  uint
    field  cat011.i390_fppsid_sic  8  uint
  end
  if p390.2                       # subfield 2, CSN: Callsign
    field  cat011.i390_csn  56  ascii
  end
  if p390.3                       # subfield 3, IFPSFLIGHTID: IFPS_FLIGHT_ID
    field  cat011.i390_ifpsflightid_typ  2  uint
    pad    3
    field  cat011.i390_ifpsflightid_nbr  27  uint
  end
  if p390.4                       # subfield 4, FLIGHTCAT: Flight Category
    field  cat011.i390_flightcat_gatoat  2  uint
    field  cat011.i390_flightcat_fr1fr2  2  uint
    field  cat011.i390_flightcat_rvsm  2  uint
    field  cat011.i390_flightcat_hpr  1  uint
    pad    1
  end
  if p390.5                       # subfield 5, TOA: Type of Aircraft
    field  cat011.i390_toa  32  ascii
  end
  if p390.6                       # subfield 6, WTC: Wake Turbulence Category
    field  cat011.i390_wtc  8  uint
  end
  if p390.7                       # subfield 7, ADEP: Departure Airport
    field  cat011.i390_adep  32  ascii
  end
  if p390.8                       # subfield 8, ADES: Destination Airport
    field  cat011.i390_ades  32  ascii
  end
  if p390.9                       # subfield 9, RWY: Runway Designation
    field  cat011.i390_rwy  24  ascii
  end
  if p390.10                      # subfield 10, CFL: Current Cleared Flight Level
    field  cat011.i390_cfl  16  uscale:1/4
  end
  if p390.11                      # subfield 11, CCP: Current Control Position
    field  cat011.i390_ccp_centre  8  uint
    field  cat011.i390_ccp_position  8  uint
  end
  if p390.12                      # subfield 12, TOD: Time of Departure
    group  cat011.i390_tod  count 8
      field  cat011.i390_tod_typ  5  uint
      field  cat011.i390_tod_day  2  uint
      pad    4
      field  cat011.i390_tod_hor  5  uint
      pad    2
      field  cat011.i390_tod_min  6  uint
      field  cat011.i390_tod_avs  1  uint
      pad    1
      field  cat011.i390_tod_sec  6  uint
    end
  end
  if p390.13                      # subfield 13, AST: Aircraft Stand
    field  cat011.i390_ast  48  ascii
  end
  if p390.14                      # subfield 14, STS: Stand Status
    field  cat011.i390_sts_emp  2  uint
    field  cat011.i390_sts_avl  2  uint
    pad    4
  end
end
if f.22                                  # FRN 22, I011/300 Vehicle Fleet Identification
  field  cat011.i300  8  uint
end
if f.23                                  # FRN 23, I011/310 Pre-programmed Message
  field  cat011.i310_trb  1  uint
  field  cat011.i310_msg  7  uint
end
if f.24                                  # FRN 24, I011/500 Estimated Accuracies
  presence p500 fx
  if p500.1                       # subfield 1, APC: Estimated Accuracy Of Track Position (Cartesian)
    field  cat011.i500_apc_x  8  uscale:1/4
    field  cat011.i500_apc_y  8  uscale:1/4
  end
  if p500.2                       # subfield 2, APW: Estimated Accuracy Of Track Position (WGS84)
    field  cat011.i500_apw_lat  16  sscale:45/536870912
    field  cat011.i500_apw_lon  16  sscale:45/536870912
  end
  if p500.3                       # subfield 3, ATH: Estimated Accuracy Of Track Height
    field  cat011.i500_ath  16  sscale:1/2
  end
  if p500.4                       # subfield 4, AVC: Estimated Accuracy Of Track Velocity (Cartesian)
    field  cat011.i500_avc_x  8  uscale:1/10
    field  cat011.i500_avc_y  8  uscale:1/10
  end
  if p500.5                       # subfield 5, ARC: Estimated Accuracy Of Rate Of Climb / Descent
    field  cat011.i500_arc  16  sscale:1/10
  end
  if p500.6                       # subfield 6, AAC: Estimated Accuracy Of Acceleration (Cartesian)
    field  cat011.i500_aac_x  8  uscale:1/100
    field  cat011.i500_aac_y  8  uscale:1/100
  end
end
if f.25                                  # FRN 25, I011/600 Alert Messages
  field  cat011.i600_ack  1  uint
  field  cat011.i600_svr  2  uint
  pad    5
  field  cat011.i600_at  8  uint
  field  cat011.i600_an  8  uint
end
if f.26                                  # FRN 26, I011/605 Tracks in Alert
  group  cat011.i605  count 8
    pad    4
    field  cat011.i605_ftn  12  uint
  end
end
if f.27                                  # FRN 27, I011/610 Holdbar Status
  group  cat011.i610  count 8
    field  cat011.i610_bkn  4  uint
    field  cat011.i610_i1  1  uint
    field  cat011.i610_i2  1  uint
    field  cat011.i610_i3  1  uint
    field  cat011.i610_i4  1  uint
    field  cat011.i610_i5  1  uint
    field  cat011.i610_i6  1  uint
    field  cat011.i610_i7  1  uint
    field  cat011.i610_i8  1  uint
    field  cat011.i610_i9  1  uint
    field  cat011.i610_i10  1  uint
    field  cat011.i610_i11  1  uint
    field  cat011.i610_i12  1  uint
  end
end
if f.28                                  # FRN 28, I011/SP Special Purpose Field
  length 8 bytes plus 1                # the length octet counts itself; the content is not mapped
  end
end
if f.29                                  # FRN 29, I011/RE Reserved Expansion Field
  length 8 bytes plus 1                # the length octet counts itself; the content is not mapped
  end
end
