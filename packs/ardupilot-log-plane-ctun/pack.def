# ArduPilot log message CTUN as the payload of a DataFlash log record.
# Generated by tools/gen/aplog2pack.py; do not edit by hand.
# The record without its 3-byte header (0xA3 0x95 type-id); fields packed, little-endian.
format        ardupilot-log-plane-ctun
version       0.1.0
distribution  public
source        "ArduPilot log message definitions (log structure tables and Write calls), https://github.com/ArduPilot/ardupilot at tag Copter-4.6.2, commit 1ebd4d996e8b6bbeb1462a9655c00aa861d5beef; message names, format strings, labels, units and multipliers only; GNU General Public License, version 3"
source        "ArduPilot libraries/AP_Logger/LogStructure.h: the format characters, units and multipliers of a log message, at the same commit"
uses          aplog
wire          bits
bit_order     lsb
word_bytes    1
field  aplog.plane_ctun_timeus  0:0:64  uint
field  aplog.plane_ctun_navroll  0:64:16  twos
field  aplog.plane_ctun_roll  0:80:16  twos
field  aplog.plane_ctun_navpitch  0:96:16  twos
field  aplog.plane_ctun_pitch  0:112:16  twos
field  aplog.plane_ctun_tho  0:128:32  f32
field  aplog.plane_ctun_rdo  0:160:32  f32
field  aplog.plane_ctun_thd  0:192:32  f32
field  aplog.plane_ctun_as  0:224:32  f32
field  aplog.plane_ctun_ast  0:256:8  uint
field  aplog.plane_ctun_sas  0:264:32  f32
field  aplog.plane_ctun_e2t  0:296:32  f32
field  aplog.plane_ctun_gu  0:328:32  twos
