# ArduPilot log message CANF as the payload of a DataFlash log record.
# Generated by tools/gen/aplog2pack.py; do not edit by hand.
# The record without its 3-byte header (0xA3 0x95 type-id); fields packed, little-endian.
format        ardupilot-log-canf
version       0.1.0
distribution  public
source        "ArduPilot log message definitions (log structure tables and Write calls), https://github.com/ArduPilot/ardupilot at tag Copter-4.6.2, commit 1ebd4d996e8b6bbeb1462a9655c00aa861d5beef; message names, format strings, labels, units and multipliers only; GNU General Public License, version 3"
source        "ArduPilot libraries/AP_Logger/LogStructure.h: the format characters, units and multipliers of a log message, at the same commit"
uses          aplog
wire          bits
bit_order     lsb
word_bytes    1
field  aplog.canf_timeus  0:0:64  uint
field  aplog.canf_bus  0:64:8  uint
field  aplog.canf_id  0:72:32  uint
field  aplog.canf_dlc  0:104:8  uint
field  aplog.canf_b0  0:112:8  uint
field  aplog.canf_b1  0:120:8  uint
field  aplog.canf_b2  0:128:8  uint
field  aplog.canf_b3  0:136:8  uint
field  aplog.canf_b4  0:144:8  uint
field  aplog.canf_b5  0:152:8  uint
field  aplog.canf_b6  0:160:8  uint
field  aplog.canf_b7  0:168:8  uint
