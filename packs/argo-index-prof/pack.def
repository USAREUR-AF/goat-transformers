# Argo GDAC profile directory file (format version 2.0): one data line. Written by hand from the
# file's column header line. Wire `text`, delimiter `,`; the comment lines (`#`) and the header
# line are not records. pack.md says what is mapped and what is not.
format        argo-index-prof
version       0.1.0
distribution  public
source        "Argo Global Data Assembly Center directory files ar_index_global_prof.txt and ar_index_global_meta.txt (https://data-argo.ifremer.fr/), format version 2.0, their column header lines; Argo data are freely available without restriction (International Argo Program)"
uses          argoidxprof
wire          text
delimiter     ","
field  argoidxprof.file           0  string
field  argoidxprof.date           1  string
field  argoidxprof.latitude       2  float
field  argoidxprof.longitude      3  float
field  argoidxprof.ocean          4  string
field  argoidxprof.profiler_type  5  int
field  argoidxprof.institution    6  string
field  argoidxprof.date_update    7  string
