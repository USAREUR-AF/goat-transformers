field  ros2nmea.gpgga_utc_seconds  msg.utc_seconds  float
field  ros2nmea.gpgga_lat  msg.lat  float
field  ros2nmea.gpgga_lon  msg.lon  float
field  ros2nmea.gpgga_lat_dir  msg.lat_dir  string
field  ros2nmea.gpgga_lon_dir  msg.lon_dir  string
