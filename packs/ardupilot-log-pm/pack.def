# ArduPilot log message PM as the payload of a DataFlash log record.
# Generated by tools/gen/aplog2pack.py; do not edit by hand.
# The record without its 3-byte header (0xA3 0x95 type-id); fields packed, little-endian.
format        ardupilot-log-pm
version       0.1.0
distribution  public
source        "ArduPilot log message definitions (log structure tables and Write calls), https://github.com/ArduPilot/ardupilot at tag Copter-4.6.2, commit 1ebd4d996e8b6bbeb1462a9655c00aa861d5beef; message names, format strings, labels, units and multipliers only; GNU General Public License, version 3"
source        "ArduPilot libraries/AP_Logger/LogStructure.h: the format characters, units and multipliers of a log message, at the same commit"
uses          aplog
wire          bits
bit_order     lsb
word_bytes    1
field  aplog.pm_timeus  0:0:64  uint
field  aplog.pm_lr  0:64:16  uint
field  aplog.pm_nlon  0:80:16  uint
field  aplog.pm_nl  0:96:16  uint
field  aplog.pm_maxt  0:112:32  uint
field  aplog.pm_mem  0:144:32  uint
field  aplog.pm_load  0:176:16  uint
field  aplog.pm_errl  0:192:16  uint
field  aplog.pm_ine  0:208:32  uint
field  aplog.pm_erc  0:240:32  uint
field  aplog.pm_spic  0:272:32  uint
field  aplog.pm_i2cc  0:304:32  uint
field  aplog.pm_i2ci  0:336:32  uint
field  aplog.pm_ex  0:368:32  uint
field  aplog.pm_r  0:400:64  uint
