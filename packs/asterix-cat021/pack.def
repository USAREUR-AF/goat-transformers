# Needs engine version 0.8 (`layout sequential`). See pack.md.
#
#   octet 1       CAT = 21
#   octets 2-3    LEN, the length of the data block in octets, CAT and LEN included
#   FSPEC         octets of 7 presence bits and an extension bit; bit n is FRN n
#   then          the items whose FSPEC bit is 1, in FRN order
#
# An FRN with no `if` block is not mapped: a record with that FSPEC bit set fails
# with `malformed-wire` (ruling 1 of engine-spec 0.8), and encode never sets the bit.
format     asterix-cat021
version    0.1.0
distribution public
source  "ASTERIX Category 021, ADS-B Target Reports, edition 2.7 (2025-07-02), as transcribed in github.com/zoranbosnjak/asterix-specs (BSD-3-Clause), commit 64e9ffba964b92a1af3157bc6bdf7852a63bf700, specs/cat021/cats/cat2.7/definition.json. The category is specified by EUROCONTROL"
uses       cat021
wire       bits
layout     sequential
bit_order  msb
kind    record
when    8  21                              # CAT
length  16 whole                         # LEN
presence f fx
