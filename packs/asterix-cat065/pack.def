# ASTERIX Category 065, SDPS Service Status Reports, edition 1.6: one data block holding one record.
# Public. Generated by tools/gen/asterix2pack.py from the category definition of
# github.com/zoranbosnjak/asterix-specs (BSD-3-Clause); do not edit by hand. I/O is hex text.
# Needs engine version 0.8 (`layout sequential`). See pack.md.
#
#   octet 1       CAT = 65
#   octets 2-3    LEN, the length of the data block in octets, CAT and LEN included
#   FSPEC         octets of 7 presence bits and an extension bit; bit n is FRN n
#   then          the items whose FSPEC bit is 1, in FRN order
#
# An FRN with no `if` block is not mapped: a record with that FSPEC bit set fails
# with `malformed-wire` (ruling 1 of engine-spec 0.8), and encode never sets the bit.
format     asterix-cat065
version    0.1.0
distribution public
source  "ASTERIX Category 065, SDPS Service Status Reports, edition 1.6 (2023-03-21), as transcribed in github.com/zoranbosnjak/asterix-specs (BSD-3-Clause), commit 64e9ffba964b92a1af3157bc6bdf7852a63bf700, specs/cat065/cats/cat1.6/definition.json. The category is specified by EUROCONTROL"
uses       cat065
wire       bits
layout     sequential
bit_order  msb
kind    record
when    8  65                              # CAT
length  16 whole                         # LEN
presence f fx
if f.1                                   # FRN 1, I065/010 Data Source Identifier
  field  cat065.i010_sac  8  uint
  field  cat065.i010_sic  8  uint
end
if f.2                                   # FRN 2, I065/000 Message Type
  field  cat065.i000  8  uint
end
if f.3                                   # FRN 3, I065/015 Service Identification
  field  cat065.i015  8  uint
end
if f.4                                   # FRN 4, I065/030 Time of Message
  field  cat065.i030  24  uscale:1/128
end
if f.5                                   # FRN 5, I065/020 Batch Number
  field  cat065.i020  8  uint
end
if f.6                                   # FRN 6, I065/040 SDPS Configuration and Status
  field  cat065.i040_nogo  2  uint
  field  cat065.i040_ovl  1  uint
  field  cat065.i040_tsv  1  uint
  field  cat065.i040_pss  2  uint
  field  cat065.i040_sttn  1  uint
  pad    1
end
if f.7                                   # FRN 7, I065/050 Service Status Report
  field  cat065.i050  8  uint
end
# FRN 8: spare FRN
# FRN 9: spare FRN
# FRN 10: spare FRN
# FRN 11: spare FRN
# FRN 12: spare FRN
if f.13                                  # FRN 13, I065/RE Reserved Expansion Field
  length 8 bytes plus 1                # the length octet counts itself; the content is not mapped
  end
end
if f.14                                  # FRN 14, I065/SP Special Purpose Field
  length 8 bytes plus 1                # the length octet counts itself; the content is not mapped
  end
end
