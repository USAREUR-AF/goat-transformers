# CCSDS AOS Transfer Frame, the 6-octet primary header. Public (CCSDS Blue Book).
# A message of this pack is a whole frame. Decode ignores the optional frame header
# error control, the insert zone, the data field and the trailer; encode writes the
# 6 header octets (pack.md, "Not mapped").
# Bits are numbered from 0 at the first transmitted bit, most significant bit first.
format     ccsds-aos-frame
version    0.1.0
distribution public
source     "CCSDS 732.0-B-4 AOS Space Data Link Protocol, Blue Book, October 2021, https://ccsds.org/Pubs/732x0b4.pdf, section 4.1.2; reuse with attribution under the CCSDS reproduction permission statement"
uses       ccsdsaos
wire       bits
word_bytes 1
bit_order  msb
when   0:0:2  1                                       # transfer frame version number: 01 (version 2)
field  ccsdsaos.spacecraft_id            0:2:8    uint
field  ccsdsaos.virtual_channel_id       0:10:6   uint
field  ccsdsaos.vc_frame_count           0:16:24  uint
field  ccsdsaos.replay_flag              0:40:1   uint
field  ccsdsaos.vc_count_cycle_use_flag  0:41:1   uint
field  ccsdsaos.vc_count_cycle           0:44:4   uint

kind   frame                                          # the one layout; a kind so that the version is checked
