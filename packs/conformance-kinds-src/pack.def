# Conformance probe pack for spec 0.20: the source of the entities that the
# encode vectors of the `conformance-kinds-*` packs write. Public. `json`,
# no kinds: one member per key, and the lists items, recs and nums.
format     conformance-kinds-src
version    0.20.0
distribution public
source  "goat-transformers spec/engine-spec.md (synthetic probe format, no external standard)"
uses       probe
wire       json
field  probe.x      x      int
field  probe.y      y      int
field  probe.z      z      int
field  probe.w      w      int
field  probe.c1     c1     int
field  probe.c2     c2     int
field  probe.n      n      int
field  probe.qty    qty    int
field  probe.val    val    int
field  probe.v1     v1     int
field  probe.v2     v2     int
field  probe.v3     v3     int
field  probe.v4     v4     int
field  probe.label  label  string
field  probe.s1     s1     string
field  probe.a      a      float
group  probe.items  items
  field  probe.qty    qty    int
  field  probe.val    val    int
  field  probe.label  label  string
end
group  probe.recs  recs
  field  probe.x  x  int
  field  probe.y  y  int
  field  probe.z  z  int
end
group  probe.nums  nums
  field  probe.val  val  int
end
