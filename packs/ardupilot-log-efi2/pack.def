# ArduPilot log message EFI2 as the payload of a DataFlash log record.
# Generated by tools/gen/aplog2pack.py; do not edit by hand.
# The record without its 3-byte header (0xA3 0x95 type-id); fields packed, little-endian.
format        ardupilot-log-efi2
version       0.1.0
distribution  public
source        "ArduPilot log message definitions (log structure tables and Write calls), https://github.com/ArduPilot/ardupilot at tag Copter-4.6.2, commit 1ebd4d996e8b6bbeb1462a9655c00aa861d5beef; message names, format strings, labels, units and multipliers only; GNU General Public License, version 3"
source        "ArduPilot libraries/AP_Logger/LogStructure.h: the format characters, units and multipliers of a log message, at the same commit"
uses          aplog
wire          bits
bit_order     lsb
word_bytes    1
field  aplog.efi2_timeus  0:0:64  uint
field  aplog.efi2_healthy  0:64:8  uint
field  aplog.efi2_es  0:72:8  uint
field  aplog.efi2_ge  0:80:8  uint
field  aplog.efi2_cse  0:88:8  uint
field  aplog.efi2_ts  0:96:8  uint
field  aplog.efi2_fps  0:104:8  uint
field  aplog.efi2_ops  0:112:8  uint
field  aplog.efi2_ds  0:120:8  uint
field  aplog.efi2_ms  0:128:8  uint
field  aplog.efi2_debs  0:136:8  uint
field  aplog.efi2_spu  0:144:8  uint
field  aplog.efi2_idx  0:152:8  uint
