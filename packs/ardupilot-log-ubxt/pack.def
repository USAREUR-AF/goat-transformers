# ArduPilot log message UBXT as the payload of a DataFlash log record.
# Generated by tools/gen/aplog2pack.py; do not edit by hand.
# The record without its 3-byte header (0xA3 0x95 type-id); fields packed, little-endian.
format        ardupilot-log-ubxt
version       0.1.0
distribution  public
source        "ArduPilot log message definitions (log structure tables and Write calls), https://github.com/ArduPilot/ardupilot at tag Copter-4.6.2, commit 1ebd4d996e8b6bbeb1462a9655c00aa861d5beef; message names, format strings, labels, units and multipliers only; GNU General Public License, version 3"
source        "ArduPilot libraries/AP_Logger/LogStructure.h: the format characters, units and multipliers of a log message, at the same commit"
uses          aplog
wire          bits
bit_order     lsb
word_bytes    1
field  aplog.ubxt_timeus  0:0:64  uint
field  aplog.ubxt_i  0:64:8  uint
field  aplog.ubxt_ch  0:72:8  uint
field  aplog.ubxt_flags  0:80:8  uint
field  aplog.ubxt_count  0:88:16  uint
field  aplog.ubxt_wnr  0:104:16  uint
field  aplog.ubxt_msr  0:120:32  uint
field  aplog.ubxt_submsr  0:152:32  uint
field  aplog.ubxt_wnf  0:184:16  uint
field  aplog.ubxt_msf  0:200:32  uint
field  aplog.ubxt_submsf  0:232:32  uint
field  aplog.ubxt_accest  0:264:32  uint
