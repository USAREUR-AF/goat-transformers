# ArduPilot log message TRST as the payload of a DataFlash log record.
# Generated by tools/gen/aplog2pack.py; do not edit by hand.
# The record without its 3-byte header (0xA3 0x95 type-id); fields packed, little-endian.
format        ardupilot-log-trst
version       0.1.0
distribution  public
source        "ArduPilot log message definitions (log structure tables and Write calls), https://github.com/ArduPilot/ardupilot at tag Copter-4.6.2, commit 1ebd4d996e8b6bbeb1462a9655c00aa861d5beef; message names, format strings, labels, units and multipliers only; GNU General Public License, version 3"
source        "ArduPilot libraries/AP_Logger/LogStructure.h: the format characters, units and multipliers of a log message, at the same commit"
uses          aplog
wire          bits
bit_order     lsb
word_bytes    1
field  aplog.trst_timeus  0:0:64  uint
field  aplog.trst_i  0:64:8  uint
field  aplog.trst_f  0:72:16  uint
field  aplog.trst_err  0:88:8  uint
field  aplog.trst_mvolt  0:96:32  f32
field  aplog.trst_mcur  0:128:32  f32
field  aplog.trst_pow  0:160:16  uint
field  aplog.trst_rpm  0:176:16  twos
field  aplog.trst_mtemp  0:192:8  uint
field  aplog.trst_bpct  0:200:8  uint
field  aplog.trst_bvolt  0:208:32  f32
field  aplog.trst_bcur  0:240:32  f32
