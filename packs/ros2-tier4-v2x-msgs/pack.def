# ROS 2 tier4_v2x_msgs messages in the JSON form of a rosbridge `publish` operation.
# Generated by tools/gen/ros2msg2pack.py; do not edit by hand.
# One kind per .msg file, selected by the member `type` ("<package>/msg/<Name>").
# The ROS message is the object under `msg`; arrays are groups.
format        ros2-tier4-v2x-msgs
version       0.1.0
distribution  public
source        "ROS 2 interface package tier4_v2x_msgs, https://github.com/tier4/tier4_autoware_msgs tier4/universe (Apache License 2.0) at commit efa4129394ad0b83a1de6c6d90ad937d74e9e426, directory tier4_v2x_msgs/msg; field names, types and array forms only"
source        "ROS 2 interface package builtin_interfaces (messages tier4_v2x_msgs refers to), https://github.com/ros2/rcl_interfaces 2.0.4 at commit 7aa3caf43377ea6ad615bc1040832e2c7566bfbe, Apache License 2.0"
source        "rosbridge v2.1.0 Protocol Specification, ROSBRIDGE_PROTOCOL.md, https://github.com/RobotWebTools/rosbridge_suite jazzy at commit cb33a16b890e4b8d9def531326409f3ee6c12537, BSD 3-Clause License; JSON form of a message and of the publish operation"
uses          ros2tier4v2x
wire          json
when   op  publish
field  ros2tier4v2x.topic  topic  string

kind      infrastructure_command
when      type  tier4_v2x_msgs/msg/InfrastructureCommand
requires  ros2tier4v2x.infrastructure_command_stamp_sec
field  ros2tier4v2x.infrastructure_command_stamp_sec  msg.stamp.sec  int
field  ros2tier4v2x.infrastructure_command_stamp_nanosec  msg.stamp.nanosec  int
field  ros2tier4v2x.infrastructure_command_type  msg.type  string
field  ros2tier4v2x.infrastructure_command_id  msg.id  string
group  ros2tier4v2x.infrastructure_command_custom_tags  msg.custom_tags
  field  ros2tier4v2x.infrastructure_command_custom_tags_key  key  string
  field  ros2tier4v2x.infrastructure_command_custom_tags_value  value  string
end
field  ros2tier4v2x.infrastructure_command_state  msg.state  int

kind      infrastructure_command_array
when      type  tier4_v2x_msgs/msg/InfrastructureCommandArray
requires  ros2tier4v2x.infrastructure_command_array_stamp_sec
field  ros2tier4v2x.infrastructure_command_array_stamp_sec  msg.stamp.sec  int
field  ros2tier4v2x.infrastructure_command_array_stamp_nanosec  msg.stamp.nanosec  int
group  ros2tier4v2x.infrastructure_command_array_commands  msg.commands
  field  ros2tier4v2x.infrastructure_command_array_commands_stamp_sec  stamp.sec  int
  field  ros2tier4v2x.infrastructure_command_array_commands_stamp_nanosec  stamp.nanosec  int
  field  ros2tier4v2x.infrastructure_command_array_commands_type  type  string
  field  ros2tier4v2x.infrastructure_command_array_commands_id  id  string
  group  ros2tier4v2x.infrastructure_command_array_commands_custom_tags  custom_tags
    field  ros2tier4v2x.infrastructure_command_array_commands_custom_tags_key  key  string
    field  ros2tier4v2x.infrastructure_command_array_commands_custom_tags_value  value  string
  end
  field  ros2tier4v2x.infrastructure_command_array_commands_state  state  int
end

kind      key_value
when      type  tier4_v2x_msgs/msg/KeyValue
requires  ros2tier4v2x.key_value_key
field  ros2tier4v2x.key_value_key  msg.key  string
field  ros2tier4v2x.key_value_value  msg.value  string

kind      virtual_traffic_light_state
when      type  tier4_v2x_msgs/msg/VirtualTrafficLightState
requires  ros2tier4v2x.virtual_traffic_light_state_stamp_sec
field  ros2tier4v2x.virtual_traffic_light_state_stamp_sec  msg.stamp.sec  int
field  ros2tier4v2x.virtual_traffic_light_state_stamp_nanosec  msg.stamp.nanosec  int
field  ros2tier4v2x.virtual_traffic_light_state_type  msg.type  string
field  ros2tier4v2x.virtual_traffic_light_state_id  msg.id  string
field  ros2tier4v2x.virtual_traffic_light_state_approval  msg.approval  bool
field  ros2tier4v2x.virtual_traffic_light_state_is_finalized  msg.is_finalized  bool

kind      virtual_traffic_light_state_array
when      type  tier4_v2x_msgs/msg/VirtualTrafficLightStateArray
requires  ros2tier4v2x.virtual_traffic_light_state_array_stamp_sec
field  ros2tier4v2x.virtual_traffic_light_state_array_stamp_sec  msg.stamp.sec  int
field  ros2tier4v2x.virtual_traffic_light_state_array_stamp_nanosec  msg.stamp.nanosec  int
group  ros2tier4v2x.virtual_traffic_light_state_array_states  msg.states
  field  ros2tier4v2x.virtual_traffic_light_state_array_states_stamp_sec  stamp.sec  int
  field  ros2tier4v2x.virtual_traffic_light_state_array_states_stamp_nanosec  stamp.nanosec  int
  field  ros2tier4v2x.virtual_traffic_light_state_array_states_type  type  string
  field  ros2tier4v2x.virtual_traffic_light_state_array_states_id  id  string
  field  ros2tier4v2x.virtual_traffic_light_state_array_states_approval  approval  bool
  field  ros2tier4v2x.virtual_traffic_light_state_array_states_is_finalized  is_finalized  bool
end
