# Conformance probe pack for the rulings of spec 0.6 on the `bits` wire.
# Public. Two bytes per word. A `const` counts toward the length decode
# requires (ruling 3), and decode requires whole words up to the furthest bit
# that is not optional (ruling 14): the `const` ends at bit 20, so decode needs
# two words, four bytes.
format     conformance-rulings-bits
version    0.6.0
distribution public
source  "goat-transformers spec/engine-spec.md (synthetic probe format, no external standard)"
uses       probe
wire       bits
word_bytes 2
field  probe.n    0:0:8   uint
const  1:0:4      9
field  probe.qty  1:8:8   uint  optional            # inside the second word
field  probe.val  2:0:8   uint  optional            # the third word
