# ArduPilot log message CANS as the payload of a DataFlash log record.
# Generated by tools/gen/aplog2pack.py; do not edit by hand.
# The record without its 3-byte header (0xA3 0x95 type-id); fields packed, little-endian.
format        ardupilot-log-cans
version       0.1.0
distribution  public
source        "ArduPilot log message definitions (log structure tables and Write calls), https://github.com/ArduPilot/ardupilot at tag Copter-4.6.2, commit 1ebd4d996e8b6bbeb1462a9655c00aa861d5beef; message names, format strings, labels, units and multipliers only; GNU General Public License, version 3"
source        "ArduPilot libraries/AP_Logger/LogStructure.h: the format characters, units and multipliers of a log message, at the same commit"
uses          aplog
wire          bits
bit_order     lsb
word_bytes    1
field  aplog.cans_timeus  0:0:64  uint
field  aplog.cans_i  0:64:8  uint
field  aplog.cans_t  0:72:32  uint
field  aplog.cans_trq  0:104:32  uint
field  aplog.cans_trej  0:136:32  uint
field  aplog.cans_tov  0:168:32  uint
field  aplog.cans_tto  0:200:32  uint
field  aplog.cans_tab  0:232:32  uint
field  aplog.cans_r  0:264:32  uint
field  aplog.cans_rov  0:296:32  uint
field  aplog.cans_rer  0:328:32  uint
field  aplog.cans_bo  0:360:32  uint
field  aplog.cans_etx  0:392:32  uint
field  aplog.cans_stx  0:424:32  uint
field  aplog.cans_ftx  0:456:32  uint
