# Conformance probe pack used as an inner pack (spec 0.34):
# a trailing counted group; its count byte is also the field w. Public.
format     conformance-inner-group
version    0.34.0
distribution public
source  "goat-transformers spec/engine-spec.md (synthetic probe format, no external standard)"
uses       probe
wire       bits
word_bytes 1
bit_order  msb
field   probe.x  0:0:8  uint
field   probe.w  0:8:8  uint
group   probe.nums  0:16  item 16  count 0:8:8
  field probe.val  0:0:8  uint
end
