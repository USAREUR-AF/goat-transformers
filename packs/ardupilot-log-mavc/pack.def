# ArduPilot log message MAVC as the payload of a DataFlash log record.
# Generated by tools/gen/aplog2pack.py; do not edit by hand.
# The record without its 3-byte header (0xA3 0x95 type-id); fields packed, little-endian.
format        ardupilot-log-mavc
version       0.1.0
distribution  public
source        "ArduPilot log message definitions (log structure tables and Write calls), https://github.com/ArduPilot/ardupilot at tag Copter-4.6.2, commit 1ebd4d996e8b6bbeb1462a9655c00aa861d5beef; message names, format strings, labels, units and multipliers only; GNU General Public License, version 3"
source        "ArduPilot libraries/AP_Logger/LogStructure.h: the format characters, units and multipliers of a log message, at the same commit"
uses          aplog
wire          bits
bit_order     lsb
word_bytes    1
field  aplog.mavc_timeus  0:0:64  uint
field  aplog.mavc_ts  0:64:8  uint
field  aplog.mavc_tc  0:72:8  uint
field  aplog.mavc_ss  0:80:8  uint
field  aplog.mavc_sc  0:88:8  uint
field  aplog.mavc_fr  0:96:8  uint
field  aplog.mavc_cmd  0:104:16  uint
field  aplog.mavc_p1  0:120:32  f32
field  aplog.mavc_p2  0:152:32  f32
field  aplog.mavc_p3  0:184:32  f32
field  aplog.mavc_p4  0:216:32  f32
field  aplog.mavc_x  0:248:32  twos
field  aplog.mavc_y  0:280:32  twos
field  aplog.mavc_z  0:312:32  f32
field  aplog.mavc_res  0:344:8  uint
field  aplog.mavc_wl  0:352:8  uint
