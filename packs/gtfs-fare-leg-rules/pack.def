# GTFS Schedule fare_leg_rules.txt: one data row of the file. Public. Maintained by hand.
# The columns are in the order the reference lists them (pack.md, Column order);
# the header row is not a message of this pack.
format        gtfs-fare-leg-rules
version       0.1.0
distribution  public
source        "GTFS Schedule Reference, gtfs/spec/en/reference.md of https://github.com/google/transit (Apache-2.0) at commit 2ce6aa79e3fa7bdbaf19d2a12765cee5b9fdd699; the column order of each file as the reference lists it; field names and types"
uses          gtfs
wire          text

field  gtfs.leg_group_id                0   string
field  gtfs.network_id                  1   string
field  gtfs.from_area_id                2   string
field  gtfs.to_area_id                  3   string
field  gtfs.from_timeframe_group_id     4   string
field  gtfs.to_timeframe_group_id       5   string
field  gtfs.fare_product_id             6   string
field  gtfs.rule_priority               7   int
